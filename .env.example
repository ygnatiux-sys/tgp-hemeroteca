# ──────────────────────────────────────────────────────────────────────────────
# GEMINI / GOOGLE AI — Motores de Generación de Contenido TGP
# ──────────────────────────────────────────────────────────────────────────────

# API Key principal para Gemini Pro y Gemini Flash
GEMINI_API_KEY=

# (Legacy) claves anteriores por si aún las usan componentes heredados
GOOGLE_API_KEY_TGP=
GEMINI_3_FLASH_API_KEY=
OPENROUTER_API_KEY=
GEMINI_3_1_PRO_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# KEYSTATIC CMS — GitHub OAuth App (necesario para el panel en producción)
# Guía de creación: https://keystatic.com/docs/github-app
# Crear en: https://github.com/settings/developers > OAuth Apps > New OAuth App
#   Homepage URL:       https://tgp-hemeroteca.pages.dev
#   Authorization callback URL: https://tgp-hemeroteca.pages.dev/api/keystatic/github/oauth/callback
# ──────────────────────────────────────────────────────────────────────────────

# Client ID de la GitHub OAuth App (NO es un secreto — puede ir al repo)
KEYSTATIC_GITHUB_CLIENT_ID=

# Client Secret de la GitHub OAuth App (SECRETO — solo en Cloudflare Pages > Variables)
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Token secreto para firmar sesiones CSRF (genera uno con: openssl rand -hex 32)
KEYSTATIC_SECRET=
CLOUDFLARE_D1_DATABASE_ID= 

# ──────────────────────────────────────────────────────────────────────────────
# TGP MIND — Sidebar IA local (solo usado en desarrollo)
# ──────────────────────────────────────────────────────────────────────────────

# URL del backend TGP Mind (local: http://localhost:3001/api/mind)
# En producción deja en blanco (sidebar no aparece)
PUBLIC_TGP_MIND_ENDPOINT=http://localhost:3001/api/mind

# API Key interna que coincide con la del backend tgp-mind/.env
PUBLIC_TGP_MIND_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# TELEGRAM BOTS — Credenciales y Webhooks (Producción y Desarrollo Aislado)
# ──────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_DEV_BOT_TOKEN=""
TELEGRAM_DEV_BOT_NAME=""