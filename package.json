{
  "name": "tgp-hemeroteca",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -c \"cyan,magenta\" -n \"WEB,MIND\" \"npm run optimize:remote && astro dev\" \"npm --prefix tgp-mind run dev\"",
    "start": "astro dev",
    "build": "astro build",
    "build:cloud": "node scripts/build-cloud.mjs",
    "start:cloud": "node dist/cloud/server.js",
    "preview": "astro preview",
    "astro": "astro",
    "//1": "--- 1. DIAGNÓSTICO ---",
    "doctor": "node scripts/tgp-doctor-universal.mjs && node scripts/buscar-sin-hero.mjs && node scripts/tgp-morph-audit.mjs",
    "doctor:sanitizer": "node scripts/doctor-sanitizer.mjs",
    "archive:orphans": "node scripts/doctor-sanitizer.mjs --archive",
    "//2": "--- 2. CURACIÓN ---",
    "sanear": "node scripts/sanear-esquemas-keystatic.mjs && node scripts/limpiar-urls-contenido.mjs",
    "curar:visual": "node scripts/curador-visual.mjs",
    "curar:batch": "node scripts/curar-batch-segundo.mjs",
    "//3": "--- 3. DESPLIEGUE ---",
    "sync": "node check-images.mjs && npm run optimize:remote && npm run upload:assets && git pull origin main && git add . && git commit -m \"TGP Sync: Cierre de jornada y subida de assets\" && git push origin main",
    "//4": "--- EL CIERRE MAESTRO ---",
    "eod": "npm run doctor && npm run sanear && npm run sync",
    "//5": "--- BASE DE DATOS (Uso Manual) ---",
    "db:query": "node scripts/db-tools/query_d1.js",
    "db:batch": "node scripts/db-tools/generate_d1_batches.js",
    "generar": "node scripts/generar-post.js",
    "content:alt": "node scripts/generate-alternative-post.mjs",
    "audit": "node scripts/audit-content.mjs",
    "audit:todo": "node scripts/auditar-todo.mjs",
    "audit:r2": "node scripts/auditar-imagenes-r2.mjs",
    "audit:hero": "node scripts/buscar-sin-hero.mjs",
    "audit:hero:fix": "node scripts/buscar-sin-hero.mjs --auto-fix",
    "check-images": "node check-images.mjs",
    "generate-types": "wrangler types",
    "upload:assets": "node scripts/sync-assets-r2.mjs",
    "upload:assets:force": "node scripts/sync-assets-r2.mjs --force",
    "upload:assets:dry": "node scripts/sync-assets-r2.mjs --dry-run",
    "optimize:r2": "node scripts/optimizar-r2.mjs",
    "optimize:r2:dry": "node scripts/optimizar-r2.mjs --dry-run",
    "clean:urls": "node scripts/limpiar-urls-contenido.mjs",
    "optimize:remote": "node scripts/optimizar-remotas.mjs",
    "analisis": "node scripts/analisis-distribucion.mjs",
    "sanear:preview": "node scripts/sanear-hemeroteca.mjs --dry-run",
    "sanear:keystatic": "node scripts/sanear-esquemas-keystatic.mjs",
    "wikimedia": "node scripts/asignar-wikimedia.mjs",
    "wikimedia:preview": "node scripts/asignar-wikimedia.mjs --dry-run",
    "audit:orphans": "node scripts/audit-orphans.mjs",
    "clean:orphans": "node scripts/audit-orphans.mjs --archive",
    "audit:morph": "node scripts/tgp-morph-audit.mjs",
    "quarantine:morph": "node scripts/tgp-morph-audit.mjs --mode=quarantine",
    "prepare": "husky"
  },
  "dependencies": {
    "@0no-co/graphql.web": "^1.2.0",
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/markdoc": "^2.0.8",
    "@astrojs/node": "^11.1.4",
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@google/genai": "^1.50.1",
    "@google/generative-ai": "^0.24.1",
    "@imgly/background-removal-node": "^1.4.5",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.8",
    "@panzoom/panzoom": "^4.5.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.4.2",
    "dotenv": "^17.4.2",
    "googleapis": "^188.0.0",
    "gsap": "^3.15.0",
    "marked": "^18.0.2",
    "pdfkit": "^0.20.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.35.4",
    "split-type": "^0.3.4",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-pattern": "^13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^25.6.0",
    "concurrently": "^9.0.1",
    "husky": "^9.1.7",
    "secretlint": "^13.0.5",
    "ts-morph": "^28.0.0"
  },
  "overrides": {
    "@keystatic/astro": {
      "astro": "$astro"
    }
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.6": true,
    "workerd@1.20260911.1": true
  }
}
