{
  "name": "tgp-hemeroteca",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generar": "node scripts/generar-post.js",
    "audit": "node scripts/audit-content.mjs",
    "check-images": "node check-images.mjs",
    "generate-types": "wrangler types",
    "upload:assets": "node scripts/sync-assets-r2.mjs",
    "upload:assets:force": "node scripts/sync-assets-r2.mjs --force",
    "upload:assets:dry": "node scripts/sync-assets-r2.mjs --dry-run",
    "optimize:r2": "node scripts/optimizar-r2.mjs",
    "optimize:r2:dry": "node scripts/optimizar-r2.mjs --dry-run",
    "clean:urls": "node scripts/limpiar-urls-contenido.mjs",
    "sync": "git pull origin main && git add . && git commit -m \"TGP Sync: Actualización unificada de arquitectura y contenido\" && git push origin main"
  },
  "dependencies": {
    "@0no-co/graphql.web": "^1.2.0",
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.2.3",
    "@astrojs/markdoc": "^2.0.8",
    "@astrojs/node": "^11.1.4",
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@google/genai": "^1.50.1",
    "@google/generative-ai": "^0.24.1",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.2.4",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "marked": "^18.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.35.4",
    "split-type": "^0.3.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  },
  "overrides": {
    "@keystatic/astro": {
      "astro": "$astro"
    }
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "workerd@1.20260820.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.6": true
  }
}
