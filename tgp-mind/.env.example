# -----------------------------------------------------------------------------
# TGP MIND — Variables de entorno
# -----------------------------------------------------------------------------

# Telegram Bot Token (obtenido de @BotFather)
TELEGRAM_TOKEN=

# API Key de Google Gemini
GEMINI_API_KEY=

# API Key interna para proteger /api/mind (generá una con: openssl rand -hex 32)
TGP_MIND_API_KEY=

# GCP Project ID
DIALOGFLOW_PROJECT=

# Región del agente Dialogflow CX (ej: us-central1)
DIALOGFLOW_LOCATION=us-central1

# ID del agente Dialogflow CX
DIALOGFLOW_AGENT_ID=

# Puerto local (Cloud Run usa 8080 automáticamente)
PORT=3001
