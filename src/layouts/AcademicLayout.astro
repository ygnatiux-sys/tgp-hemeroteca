---
/**
 * AcademicLayout.astro — TGP Papers & Dossiers
 *
 * Navbar: Brand centrado tipo Medium (TGP · Papers & Dossiers | Scriptorium Epistémico)
 * Menú de íconos: centrado, aparece al hover sobre la zona del brand
 * Ítem hover: nombre en inglés + color dorado destacado
 * Google Translate: inyectado como widget flotante en el body
 */

interface Props {
  title?: string;
  description?: string;
  slug?: string;
}

const {
  title = "TGP Papers & Dossiers",
  description = "Scriptorium Epistémico. Lectura profunda de dossieres y ensayos de investigación.",
  slug,
} = Astro.props;
---

<!doctype html>
<html lang="es" data-env="academic">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- Tipografías: Cormorant (brand) + Lora (cuerpo) + Inter (UI/meta) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Gloock&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      /* ─── Reset base ─── */
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        --bg-main:       #151718;
        --rust-orange:   #C8A98B;

        /* Escala de blancos */
        --white-page:    #FAFAF9;
        --white-broken:  #F5F2ED;
        --white-bone:    #EDE9E1;
        --white-silver:  #E4E1DB;
        --white-ice:     #F8F8F7;

        /* Paleta TGP Papers */
        --ac-bg:          var(--white-page);
        --ac-surface:     var(--white-broken);
        --ac-border:      var(--white-silver);
        --ac-text:        #191918;
        --ac-text-muted:  #575043;
        --ac-text-soft:   #8A8278;
        --ac-accent:      #3B2A14;
        --ac-gold:        #8C6D2F;
        --ac-gold-light:  #C9A86C;
        --ac-rule:        rgba(60,50,30,0.12);

        --font-brand:     'Cormorant Garamond', Georgia, serif;
        --font-body:      'Lora', Georgia, serif;
        --font-ui:        'Inter', system-ui, sans-serif;
      }

      html {
        background-color: var(--ac-bg);
        color: var(--ac-text);
        font-family: var(--font-body);
        font-size: clamp(17px, 1.05vw + 14px, 21px);
        line-height: 1.9;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      ::selection { background-color: var(--ac-gold); color: #FFF; }

      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        margin: 0;
        padding: 0;
        background-color: var(--ac-bg);
      }

      /* ════════════════════════════════════════════════════
         NAVBAR — Brand centrado, menú bajo hover
      ════════════════════════════════════════════════════ */
      .ac-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background-color: rgba(250,250,249,0.97);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--ac-rule);
      }

      /* Zona superior: brand centrado */
      .ac-nav__top {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.85rem 1.5rem;
        position: relative;
        cursor: default;
      }

      /* Botón de retorno (izquierda absoluta) */
      .ac-nav__back {
        position: absolute;
        left: 1.5rem;
        font-family: var(--font-ui);
        font-size: 0.75rem;
        font-weight: 400;
        color: var(--ac-text-soft);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        transition: color 0.15s ease;
        letter-spacing: 0.01em;
      }
      .ac-nav__back:hover { color: var(--ac-gold); }

      /* Bloque brand centrado */
      .ac-nav__brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.1rem;
        text-align: center;
        text-decoration: none;
      }

      /* Wordmark principal: Cormorant ExtraBold estilo Medium */
      .ac-nav__wordmark {
        font-family: var(--font-brand);
        font-size: clamp(1.3rem, 2.5vw, 1.7rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1;
        color: var(--ac-text);
        white-space: nowrap;
      }
      .ac-nav__wordmark em {
        font-style: normal;
        color: var(--ac-gold);
      }

      /* Subtítulo metadata: Inter 300 espaciado */
      .ac-nav__sub {
        font-family: var(--font-ui);
        font-size: 0.62rem;
        font-weight: 300;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--ac-text-soft);
      }

      /* Google Translate widget (derecha absoluta) */
      .ac-nav__translate {
        position: absolute;
        right: 1.5rem;
        display: flex;
        align-items: center;
      }

      /* ── MENÚ DESPLEGABLE BAJO EL BRAND ───────────────────
         Invisible por defecto, visible al hover en ac-nav__top
      ──────────────────────────────────────────────────── */
      .ac-nav__menu {
        max-height: 0;
        overflow: hidden;
        border-top: 0px solid transparent;
        transition: max-height 0.28s ease, border-top 0.28s ease;
      }

      .ac-nav__top:hover ~ .ac-nav__menu,
      .ac-nav__menu:hover {
        max-height: 80px;
        border-top: 1px solid var(--ac-rule);
      }

      .ac-nav__menu-inner {
        display: flex;
        justify-content: center;
        gap: 0.25rem;
        padding: 0.6rem 1.5rem;
      }

      /* Ítem del menú */
      .nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        text-decoration: none;
        color: var(--ac-text-muted);
        transition: all 0.18s ease;
        min-width: 70px;
      }

      .nav-item:hover {
        color: var(--ac-gold);
        background-color: var(--white-ice);
      }

      .nav-item svg {
        width: 1.2rem;
        height: 1.2rem;
        stroke: currentColor;
        stroke-width: 1.5;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex-shrink: 0;
      }

      /* Nombre en español — se oculta en hover */
      .nav-item__label-es {
        font-family: var(--font-ui);
        font-size: 0.62rem;
        letter-spacing: 0.04em;
        display: block;
      }

      /* Nombre en inglés — se muestra en hover */
      .nav-item__label-en {
        font-family: var(--font-ui);
        font-size: 0.62rem;
        letter-spacing: 0.04em;
        display: none;
        color: var(--ac-gold);
        font-weight: 600;
      }

      .nav-item:hover .nav-item__label-es { display: none; }
      .nav-item:hover .nav-item__label-en { display: block; }

      /* ════════════════════════════════════════════════════
         FOOTER INFERIOR — Franja delgada, simple y elegante
      ════════════════════════════════════════════════════ */
      main { flex: 1; width: 100%; }

      .ac-site-footer {
        background-color: var(--white-broken);
        border-top: 1px solid var(--white-silver);
        padding: 1.2rem 1.5rem;
        margin-top: 4rem;
        width: 100%;
      }

      .ac-site-footer__inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      @media (min-width: 768px) {
        .ac-site-footer__inner {
          flex-direction: row;
          gap: 1.5rem;
        }
      }

      /* Brand / Sello */
      .ac-site-footer__brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--ac-text);
        transition: opacity 0.2s ease;
      }
      .ac-site-footer__brand:hover { opacity: 0.85; }

      .ac-site-footer__seal {
        position: relative;
        width: 2.2rem;
        height: 2.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .seal-spin {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        animation: spin-seal 40s linear infinite;
        opacity: 0.6;
      }
      @keyframes spin-seal { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
      .seal-icon {
        width: 0.9rem;
        height: 0.9rem;
        color: var(--ac-gold);
      }

      .ac-site-footer__title-group {
        display: flex;
        flex-direction: column;
        text-align: left;
      }

      .ac-site-footer__name {
        font-family: 'Gloock', var(--font-brand), serif;
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        color: var(--ac-text);
        line-height: 1.1;
      }
      .ac-site-footer__dir {
        font-family: var(--font-ui);
        font-size: 0.58rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ac-text-soft);
      }

      /* Nav Central */
      .ac-site-footer__nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        font-family: var(--font-ui);
        font-size: 0.68rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      .ac-site-footer__nav a {
        color: var(--ac-text-muted);
        text-decoration: none;
        transition: color 0.15s ease;
      }
      .ac-site-footer__nav a:hover {
        color: var(--ac-gold);
      }
      .ac-site-footer__nav .dot, .ac-site-footer__meta .dot {
        color: var(--ac-text-soft);
        opacity: 0.4;
      }

      /* Meta derechas */
      .ac-site-footer__meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-ui);
        font-size: 0.68rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--ac-text-soft);
      }
      .ac-site-footer__share {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-family: var(--font-ui);
        font-size: 0.68rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--ac-text-soft);
        transition: color 0.15s ease;
      }
      .ac-site-footer__share:hover {
        color: var(--ac-gold);
      }
      .ac-site-footer__share svg {
        width: 0.8rem;
        height: 0.8rem;
      }

      /* Google Translate widget overrides */
      .goog-te-gadget {
        font-family: var(--font-ui) !important;
        font-size: 0.72rem !important;
      }
      .goog-te-gadget .goog-te-combo {
        border: 1px solid var(--ac-border, #E4E1DB);
        border-radius: 6px;
        padding: 0.25rem 0.4rem;
        background: var(--white-ice);
        color: var(--ac-text-muted);
        font-size: 0.7rem;
        cursor: pointer;
      }
      /* Ocultar el logo de Google del widget */
      .goog-logo-link, .goog-te-gadget > span { display: none !important; }
    </style>
  </head>

  <body>
    <!-- ══════════════════════════════════════════
         NAVBAR PRINCIPAL
    ══════════════════════════════════════════ -->
    <nav class="ac-nav" aria-label="Navegación TGP Papers">
      <!-- Franja superior: brand centrado -->
      <div class="ac-nav__top" role="banner">
        <!-- Retorno (izquierda) -->
        <a href="/papers" class="ac-nav__back" aria-label="Índice de Papers">← Índice</a>

        <!-- Brand central -->
        <a href="/papers" class="ac-nav__brand">
          <span class="ac-nav__wordmark">
            TGP <em>·</em> Papers <em>&</em> Dossiers
          </span>
          <span class="ac-nav__sub">Scriptorium Epistémico</span>
        </a>

        <!-- Google Translate (derecha) -->
        <div class="ac-nav__translate">
          <div id="google_translate_element"></div>
        </div>
      </div>

      <!-- Menú desplegable de íconos (hover bajo el brand) -->
      <div class="ac-nav__menu" role="navigation" aria-label="Menú de secciones">
        <div class="ac-nav__menu-inner">

          <!-- Home / Inicio -->
          <a href="/papers/home" class="nav-item" aria-label="Inicio — Home">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 9.5L12 3l9 6.5V20a1 1 0 01-1 1H4a1 1 0 01-1-1V9.5z"/>
              <path d="M9 21V12h6v9"/>
            </svg>
            <span class="nav-item__label-es">Inicio</span>
            <span class="nav-item__label-en">Home</span>
          </a>

          <!-- Biblioteca / Library -->
          <a href="/papers/biblioteca" class="nav-item" aria-label="Biblioteca — Library">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 016.5 17H20"/>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>
            </svg>
            <span class="nav-item__label-es">Biblioteca</span>
            <span class="nav-item__label-en">Library</span>
          </a>

          <!-- Perfil / Profile -->
          <a href="/papers/perfil" class="nav-item" aria-label="Perfil — Profile">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            <span class="nav-item__label-es">Perfil</span>
            <span class="nav-item__label-en">Profile</span>
          </a>

          <!-- Historias / Stories -->
          <a href="/papers/historias" class="nav-item" aria-label="Historias — Stories">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
            <span class="nav-item__label-es">Historias</span>
            <span class="nav-item__label-en">Stories</span>
          </a>

        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <!-- Footer inferior nativo -->
    <footer class="ac-site-footer">
      <div class="ac-site-footer__inner">
        
        <!-- Brand / Sello -->
        <a href="/" class="ac-site-footer__brand" title="The Great Puzzle Project">
          <div class="ac-site-footer__seal" aria-hidden="true">
            <svg viewBox="0 0 100 100" class="seal-spin">
              <path id="ac-seal-curve" d="M 50,50 m -42,0 a 42,42 0 1,1 84,0 a 42,42 0 1,1 -84,0" fill="transparent" />
              <text>
                <textPath href="#ac-seal-curve" startOffset="0%"><tspan font-family="monospace" font-size="8" fill="var(--ac-gold)">TGP • ARCHIVO • TGP • ARCHIVO • </tspan></textPath>
              </text>
            </svg>
            <svg class="seal-icon" viewBox="0 0 100 100" fill="none">
              <path d="M 34 28 H 42 C 41.5 21, 37 10, 50 10 C 63 10, 58.5 21, 58 28 H 66 A 6 6 0 0 1 72 34 V 66 A 6 6 0 0 1 66 72 H 58 C 58.5 79, 63 90, 50 90 C 37 90, 41.5 79, 42 72 H 34 A 6 6 0 0 1 28 66 V 58 C 35 58.5, 45 63, 45 50 C 45 37, 35 41.5, 28 42 V 34 A 6 6 0 0 1 34 28 Z" stroke="currentColor" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <div class="ac-site-footer__title-group">
            <span class="ac-site-footer__name">THE GREAT PUZZLE PROJECT</span>
            <span class="ac-site-footer__dir">Dir. Xavier Benítez</span>
          </div>
        </a>

        <!-- Enlaces centrales -->
        <nav class="ac-site-footer__nav" aria-label="Navegación pie de página">
          <a href="/">Inicio</a>
          <span class="dot">·</span>
          <a href="/papers">Papers</a>
          <span class="dot">·</span>
          <a href="/colecciones">Colecciones</a>
          <span class="dot">·</span>
          <a href="/archivo">Archivo</a>
          <span class="dot">·</span>
          <a href="/about">About</a>
        </nav>

        <!-- Acciones y Copyright -->
        <div class="ac-site-footer__meta" style="flex-wrap: wrap; justify-content: center;">
          <button type="button" id="ac-share-btn" class="ac-site-footer__share">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            <span>Compartir</span>
          </button>
          <span class="dot">·</span>
          <span>© 2026 TGP</span>
          <span class="dot">·</span>
          <a href="https://about.thegreatpuzzleproject.com/" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none; font-weight: 700; transition: color 0.2s;" onmouseover="this.style.color='var(--ac-gold)'" onmouseout="this.style.color='inherit'">ABOUT ME</a>
        </div>

      </div>
    </footer>

    <script>
      const setupShareBtn = () => {
        const btn = document.getElementById('ac-share-btn');
        if (!btn) return;
        btn.addEventListener('click', async () => {
          if (navigator.share && /mobile|android|iphone/i.test(navigator.userAgent)) {
            try { await navigator.share({ title: document.title, url: window.location.href }); } catch {}
          } else {
            try {
              await navigator.clipboard.writeText(window.location.href);
              const label = btn.querySelector('span');
              if (label) {
                const orig = label.innerText;
                label.innerText = '¡COPIADO!';
                setTimeout(() => { label.innerText = orig; }, 2000);
              }
            } catch {}
          }
        });
      };
      document.addEventListener('DOMContentLoaded', setupShareBtn);
      document.addEventListener('astro:page-load', setupShareBtn);
    </script>

    <!-- Google Translate Widget -->
    <script>
      // @ts-ignore
      function googleTranslateElementInit() {
        // @ts-ignore
        new google.translate.TranslateElement(
          {
            pageLanguage: 'es',
            includedLanguages: 'en,es,fr,de,it,pt,la',
            layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
            autoDisplay: false,
          },
          'google_translate_element'
        );
      }
    </script>
    <script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" async defer></script>
  </body>
</html>
