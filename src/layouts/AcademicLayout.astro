---
/**
 * AcademicLayout.astro — TGP Papers & Dossiers
 *
 * Navbar: Brand centrado + faja editorial fija de secciones
 * Ítem hover: acento dorado (sin show/hide del menú)
 * Google Translate: widget flotante a la derecha
 */

import "../styles/global.css";
import Header from '../components/Header.astro';
import BackSlideButton from '../components/BackSlideButton.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  slug?: string;
}

const {
  title = "TGP Papers & Dossiers — The Great Puzzle Project",
  description = "Scriptorium Epistémico. Lectura profunda de dossieres y ensayos de investigación.",
  image = "/images/favicon.TGP.webp",
  slug,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const imageURL = new URL(image, Astro.site ?? Astro.url.origin);

const officialSocialLinks = [
  "https://linktr.ee/thegreatpuzzleproject",
  "https://open.spotify.com/show/3zFq9ab980MamMHW48Sqxy",
  "https://www.youtube.com/@thegreatpuzzleproject",
  "https://www.instagram.com/thegreatpuzzleproject",
  "https://x.com/TheTGPProject",
  "https://thegreatpuzzleproject.substack.com",
  "https://www.threads.net/@thegreatpuzzleproject",
  "https://www.tiktok.com/@thegreatpuzzleproject",
  "https://bsky.app/profile/thegreatpuzzleproject.bsky.social",
  "https://www.facebook.com/thegreatpuzzleproject",
  "https://linkedin.com/in/xavierbenitez",
  "https://www.pinterest.com/thegreatpuzzleproject",
  "https://ygnatiux.tumblr.com",
  "https://gravatar.com/xavierbeniteztgp"
];

const globalSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${canonicalURL.origin}/#website`,
      "url": canonicalURL.origin,
      "name": "The Great Puzzle Project",
      "description": description,
      "publisher": {
        "@id": "https://thegreatpuzzleproject.com/#organization"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://thegreatpuzzleproject.com/#organization",
      "name": "The Great Puzzle Project",
      "url": "https://thegreatpuzzleproject.com",
      "logo": {
        "@type": "ImageObject",
        "url": new URL("/favicon.png", canonicalURL).href
      },
      "sameAs": officialSocialLinks
    },
    {
      "@type": "Person",
      "@id": "https://thegreatpuzzleproject.com/#author",
      "name": "Xavier Benítez",
      "url": "https://linktr.ee/thegreatpuzzleproject",
      "jobTitle": "Investigador & Editor General",
      "sameAs": officialSocialLinks
    }
  ]
};
---

<!doctype html>
<html lang="es" data-env="academic">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- URL Canónica y Sitemap -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Metadatos Primarios SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Xavier Benítez" />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:site_name" content="The Great Puzzle Project" />
    <meta property="og:locale" content="es_LA" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@TheTGPProject" />
    <meta name="twitter:creator" content="@TheTGPProject" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL.href} />

    <!-- Datos Estructurados JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(globalSchema)} />
    <slot name="head" />

    <!-- Tipografías: Cormorant (brand) + Lora (cuerpo) + Inter (UI/meta) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Gloock&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      /* ─── Reset base ─── */
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        --bg-main:       #211A16;
        --rust-orange:   #EFEBE3;

        /* Escala tonal base (Old Leather & Parchment) */
        --white-page:    #211A16;
        --white-broken:  #28201B;
        --white-bone:    #2E2520;
        --white-silver:  rgba(239, 235, 227, 0.12);
        --white-ice:     #1B1512;

        /* Paleta TGP Papers — Dark Old Leather #211A16 */
        --ac-bg:          #211A16;
        --ac-surface:     #28201B;
        --ac-border:      rgba(239, 235, 227, 0.12);
        --ac-text:        #EFEBE3;
        --ac-text-muted:  #C5BFB5;
        --ac-text-soft:   #9E9689;
        --ac-accent:      #C9A86C;
        --ac-gold:        #C9A86C;
        --ac-gold-light:  #DFCA9D;
        --ac-rule:        rgba(239, 235, 227, 0.12);

        --font-brand:     'Cormorant Garamond', Georgia, serif;
        --font-body:      'Lora', Georgia, serif;
        --font-ui:        'Inter', system-ui, sans-serif;
      }

      html {
        background-color: var(--ac-bg);
        color: var(--ac-text);
        font-family: var(--font-body);
        font-size: clamp(17px, 1.05vw + 14px, 21px);
        line-height: 1.9;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      ::selection { background-color: var(--ac-gold); color: #211A16; }

      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        margin: 0;
        padding: 0;
        background-color: var(--ac-bg);
        color: var(--ac-text);
      }

      /* ════════════════════════════════════════════════════
         FOOTER INFERIOR — Franja delgada, simple y elegante
      ════════════════════════════════════════════════════ */
      main { flex: 1; width: 100%; }

      .ac-site-footer {
        background-color: #1A1411;
        border-top: 1px solid var(--ac-rule);
        padding: 1.2rem 1.5rem;
        margin-top: 4rem;
        width: 100%;
      }

      .ac-site-footer__inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      @media (min-width: 768px) {
        .ac-site-footer__inner {
          flex-direction: row;
          gap: 1.5rem;
        }
      }

      /* Brand / Sello */
      .ac-site-footer__brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--ac-text);
        transition: opacity 0.2s ease;
      }
      .ac-site-footer__brand:hover { opacity: 0.85; }

      .ac-site-footer__seal {
        position: relative;
        width: 1.8rem;
        height: 1.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .seal-icon {
        width: 1.3rem;
        height: 1.3rem;
        color: var(--ac-gold);
      }

      .ac-site-footer__title-group {
        display: flex;
        flex-direction: column;
        text-align: left;
      }

      .ac-site-footer__name {
        font-family: 'Gloock', var(--font-brand), serif;
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        color: var(--ac-text);
        line-height: 1.1;
      }
      .ac-site-footer__dir {
        font-family: var(--font-ui);
        font-size: 0.58rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ac-text-soft);
      }

      /* Nav Central */
      .ac-site-footer__nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        font-family: var(--font-ui);
        font-size: 0.68rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      .ac-site-footer__nav a {
        color: var(--ac-text-muted);
        text-decoration: none;
        transition: color 0.15s ease;
      }
      .ac-site-footer__nav a:hover {
        color: var(--ac-gold);
      }
      .ac-site-footer__nav .dot, .ac-site-footer__meta .dot {
        color: var(--ac-text-soft);
        opacity: 0.4;
      }

      /* Meta derechas */
      .ac-site-footer__meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-ui);
        font-size: 0.68rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--ac-text-soft);
      }
      .ac-site-footer__share {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-family: var(--font-ui);
        font-size: 0.68rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--ac-text-soft);
        transition: color 0.15s ease;
      }
      .ac-site-footer__share:hover {
        color: var(--ac-gold);
      }
      .ac-site-footer__share svg {
        width: 0.8rem;
        height: 0.8rem;
      }

      /* Google Translate widget overrides */
      .goog-te-gadget {
        font-family: var(--font-ui) !important;
        font-size: 0.72rem !important;
      }
      .goog-te-gadget .goog-te-combo {
        border: 1px solid var(--ac-border, #E4E1DB);
        border-radius: 6px;
        padding: 0.25rem 0.4rem;
        background: var(--white-ice);
        color: var(--ac-text-muted);
        font-size: 0.7rem;
        cursor: pointer;
      }
      /* Ocultar el logo de Google del widget */
      .goog-logo-link, .goog-te-gadget > span { display: none !important; }
    </style>
  </head>

  <body>
    <!-- Navbar Global Estándar -->
    <Header transparentUntilScroll={false} />

    <!-- Botón de Retroceso Inteligente Lateral -->
    <BackSlideButton fallbackUrl="/papers" />

    <main class="pt-20 md:pt-24">
      <slot />
    </main>

    <!-- Footer inferior nativo -->
    <footer class="ac-site-footer">
      <div class="ac-site-footer__inner">
        
        <!-- Brand / Sello -->
        <a href="/" class="ac-site-footer__brand" title="The Great Puzzle Project">
          <div class="ac-site-footer__seal" aria-hidden="true">
            <svg class="seal-icon" viewBox="0 0 100 100" fill="none">
              <path d="M 34 28 H 42 C 41.5 21, 37 10, 50 10 C 63 10, 58.5 21, 58 28 H 66 A 6 6 0 0 1 72 34 V 66 A 6 6 0 0 1 66 72 H 58 C 58.5 79, 63 90, 50 90 C 37 90, 41.5 79, 42 72 H 34 A 6 6 0 0 1 28 66 V 58 C 35 58.5, 45 63, 45 50 C 45 37, 35 41.5, 28 42 V 34 A 6 6 0 0 1 34 28 Z" stroke="currentColor" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <div class="ac-site-footer__title-group">
            <span class="ac-site-footer__name">THE GREAT PUZZLE PROJECT</span>
            <span class="ac-site-footer__dir">Dir. Xavier Benítez</span>
          </div>
        </a>

        <!-- Enlaces centrales -->
        <nav class="ac-site-footer__nav" aria-label="Navegación pie de página">
          <a href="/">Inicio</a>
          <span class="dot">·</span>
          <a href="/papers/">Papers</a>
          <span class="dot">·</span>
          <a href="/colecciones/">Colecciones</a>
          <span class="dot">·</span>
          <a href="/archivo/">Archivo</a>
          <span class="dot">·</span>
          <a href="/about/">About</a>
        </nav>

        <!-- Acciones y Copyright -->
        <div class="ac-site-footer__meta" style="flex-wrap: wrap; justify-content: center;">
          <button type="button" id="ac-share-btn" class="ac-site-footer__share">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            <span>Compartir</span>
          </button>
          <span class="dot">·</span>
          <span>© 2026 TGP</span>
          <span class="dot">·</span>
          <a href="https://about.thegreatpuzzleproject.com/" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none; font-weight: 700; transition: color 0.2s;" onmouseover="this.style.color='var(--ac-gold)'" onmouseout="this.style.color='inherit'">ABOUT ME</a>
        </div>

      </div>
    </footer>

    <script>
      const setupShareBtn = () => {
        const btn = document.getElementById('ac-share-btn');
        if (!btn) return;
        btn.addEventListener('click', async () => {
          if (navigator.share && /mobile|android|iphone/i.test(navigator.userAgent)) {
            try { await navigator.share({ title: document.title, url: window.location.href }); } catch {}
          } else {
            try {
              await navigator.clipboard.writeText(window.location.href);
              const label = btn.querySelector('span');
              if (label) {
                const orig = label.innerText;
                label.innerText = '¡COPIADO!';
                setTimeout(() => { label.innerText = orig; }, 2000);
              }
            } catch {}
          }
        });
      };
      document.addEventListener('DOMContentLoaded', setupShareBtn);
      document.addEventListener('astro:page-load', setupShareBtn);
    </script>

    <!-- Google Translate Widget -->
    <script>
      // @ts-ignore
      declare var google: any;

      // @ts-ignore
      function googleTranslateElementInit() {
        // @ts-ignore
        new google.translate.TranslateElement(
          {
            pageLanguage: 'es',
            includedLanguages: 'en,es,fr,de,it,pt,la',
            layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
            autoDisplay: false,
          },
          'google_translate_element'
        );
      }
    </script>
    <script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" async defer></script>
  </body>
</html>
