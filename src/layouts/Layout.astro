---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LightboxGlobal from "../components/LightboxGlobal.astro";
import BackSlideButton from "../components/BackSlideButton.astro";

interface Props {
  description?: string;
  title?: string;
  image?: string;
  hideHeader?: boolean;
  footerVariant?: "full" | "minimal";
  /** Home cinematográfico: nav transparente al tope, sólido tras 50px de scroll */
  headerTransparentUntilScroll?: boolean;
  bodyStyle?: string;
}

const {
  title = "Hemeroteca TGP — The Great Puzzle Project",
  description: customDescription,
  image: customImage,
  hideHeader = false,
  footerVariant = "full",
  headerTransparentUntilScroll = true,
  bodyStyle = "",
} = Astro.props;

const defaultDescription = "Hemeroteca digital, archivo epistémico, ensayos cinemáticos, arqueosemiótica e investigaciones profundas de The Great Puzzle Project.";
const defaultImage = "/images/favicon.TGP.webp";

const siteDescription = customDescription || defaultDescription;
const siteImage = customImage || defaultImage;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const imageURL = new URL(siteImage, Astro.site ?? Astro.url.origin);

const officialSocialLinks = [
  "https://linktr.ee/thegreatpuzzleproject",
  "https://open.spotify.com/show/3zFq9ab980MamMHW48Sqxy",
  "https://www.youtube.com/@thegreatpuzzleproject",
  "https://www.instagram.com/thegreatpuzzleproject",
  "https://x.com/TheTGPProject",
  "https://thegreatpuzzleproject.substack.com",
  "https://www.threads.net/@thegreatpuzzleproject",
  "https://www.tiktok.com/@thegreatpuzzleproject",
  "https://bsky.app/profile/thegreatpuzzleproject.bsky.social",
  "https://www.facebook.com/thegreatpuzzleproject",
  "https://linkedin.com/in/xavierbenitez",
  "https://www.pinterest.com/thegreatpuzzleproject",
  "https://ygnatiux.tumblr.com",
  "https://gravatar.com/xavierbeniteztgp"
];

const globalSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${canonicalURL.origin}/#website`,
      "url": canonicalURL.origin,
      "name": "The Great Puzzle Project",
      "description": siteDescription,
      "publisher": {
        "@id": "https://thegreatpuzzleproject.com/#organization"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://thegreatpuzzleproject.com/#organization",
      "name": "The Great Puzzle Project",
      "url": "https://thegreatpuzzleproject.com",
      "logo": {
        "@type": "ImageObject",
        "url": new URL("/favicon.png", canonicalURL).href
      },
      "sameAs": officialSocialLinks
    },
    {
      "@type": "Person",
      "@id": "https://thegreatpuzzleproject.com/#author",
      "name": "Xavier Benítez",
      "url": "https://linktr.ee/thegreatpuzzleproject",
      "jobTitle": "Investigador & Editor General",
      "sameAs": officialSocialLinks
    }
  ]
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    
    <!-- URL Canónica y Sitemap -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Metadatos Primarios SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={siteDescription} />
    <meta name="author" content="Xavier Benítez" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:site_name" content="The Great Puzzle Project" />
    <meta property="og:locale" content="es_LA" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@TheTGPProject" />
    <meta name="twitter:creator" content="@TheTGPProject" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={imageURL.href} />

    <!-- Datos Estructurados JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(globalSchema)} />
    <slot name="head" />

    {
      /* Script Antiflash (FOUC): Inicializa el tema inmediatamente antes de renderizar */
    }
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("tgp-theme");
        const prefersLight = window.matchMedia(
          "(prefers-color-scheme: light)",
        ).matches;
        if (savedTheme === "light" || (!savedTheme && prefersLight)) {
          document.documentElement.setAttribute("data-theme", "light");
        } else {
          document.documentElement.removeAttribute("data-theme");
        }
      })();
    </script>

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Import Gloock, Newsreader, Space Mono, Plus Jakarta Sans, Cinzel, Outfit and Inter -->
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800;900&family=Gloock&family=Inter:wght@400;500;600;700;800;900&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,400&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-(--bg-main) text-(--text-body) antialiased transition-colors duration-400 flex flex-col min-h-screen"
    style={bodyStyle || undefined}
  >
    {
      !hideHeader && (
        <>
          <Header transparentUntilScroll={headerTransparentUntilScroll} />
          <BackSlideButton fallbackUrl="/" />
        </>
      )
    }

    <main class="grow relative">
      {/* F4: Único H1 semántico del sitio — sr-only para screen readers y crawlers (AOM/SEO) */}
      {/* El logotipo visual en Header actúa como identidad; este H1 provee jerarquía accesible */}
      <h1 class="sr-only">{title}</h1>
      <slot />
    </main>

    <Footer variant={footerVariant} />

    {/* Visor Inmersivo Global */}
    <LightboxGlobal />

    <script>
      const setupGlobalReveal = () => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("revealed");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: "0px 0px -10% 0px", // Se activa un poco antes de llegar
          },
        );

        document
          .querySelectorAll("h1, h2, .reveal-item")
          .forEach((el) => observer.observe(el));
      };

      document.addEventListener("DOMContentLoaded", setupGlobalReveal);
      document.addEventListener("astro:page-load", setupGlobalReveal);
    </script>
  </body>
</html>
