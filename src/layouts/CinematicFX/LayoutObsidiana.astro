---
import { Image } from 'astro:assets';
import TypeMagyk from '../../components/TypeMagyk.astro';

interface Props {
  frontmatter: any;
  isCustom?: boolean;
  atmosfera?: string;
  config?: any;
}

const { frontmatter, config } = Astro.props;
const images: string[] = frontmatter.images || frontmatter.gallery || frontmatter.galeria || (frontmatter.coverImage ? [frontmatter.coverImage] : []);
const title = frontmatter.title || 'Dossier — Obsidiana';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-[#0b0c0d] text-[#e3ddd3] min-h-screen relative overflow-x-hidden selection:bg-[#c9a86c]/30 selection:text-white">
    
    <!-- Contenedor Ambiental Fijo (Fondo Eje Y) -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden" id="obsidiana-bg-root">
      <div class="absolute inset-0 bg-black/45 z-10"></div>
      <div class="absolute inset-0 bg-radial from-transparent via-[#0b0c0d]/60 to-[#0b0c0d] z-10"></div>

      <!-- Capa de Polvo Ambiental / Ruido Estático -->
      <div 
        class="absolute inset-0 pointer-events-none opacity-[0.07] mix-blend-screen bg-repeat z-20"
        style="background-image: url('data:image/svg+xml;utf8,<svg viewBox=\'0 0 200 200\' xmlns=\'http://www.w3.org/2000/svg\'><filter id=\'dustNoise\'><feTurbulence type=\'fractalNoise\' baseFrequency=\'0.85\' numOctaves=\'3\' stitchTiles=\'stitch\'/></filter><rect width=\'100%\' height=\'100%\' filter=\'url(%23dustNoise)\'/></svg>');"
        aria-hidden="true"
      ></div>
      
      {images.map((img, i) => (
        typeof img === 'object' && img ? (
          <Image
            src={img}
            alt=""
            format="webp"
            quality={80}
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
            class="obsidiana-img absolute inset-0 w-full h-full object-cover object-center opacity-0 will-change-[opacity,transform]"
            data-index={i}
          />
        ) : typeof img === 'string' && img.trim().length > 0 ? (
          <img
            src={img}
            alt=""
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
            class="obsidiana-img absolute inset-0 w-full h-full object-cover object-center opacity-0 will-change-[opacity,transform]"
            data-index={i}
          />
        ) : null
      ))}
    </div>

    <!-- Contenedor de Contenido y Lectura -->
    <main class="relative z-30 max-w-4xl mx-auto px-6 py-32 md:py-48 min-h-[300vh]" id="obsidiana-content">
      <TypeMagyk frontmatter={frontmatter} config={config}>
        <slot />
      </TypeMagyk>
    </main>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      function initObsidiana() {
        const images = gsap.utils.toArray<HTMLElement>('.obsidiana-img');
        if (!images.length) return;

        // Estado inicial de la primera imagen
        gsap.set(images[0], { opacity: 0.85, scale: 1 });

        if (images.length === 1) return;

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: '#obsidiana-content',
            start: 'top top',
            end: 'bottom bottom',
            scrub: 1,
          }
        });

        images.forEach((img, i) => {
          if (i > 0) {
            tl.to(images[i - 1], { opacity: 0, scale: 1.04, ease: 'power1.inOut' }, i)
              .to(img, { opacity: 0.85, scale: 1, ease: 'power1.inOut' }, i);
          }
        });
      }

      document.addEventListener('astro:page-load', initObsidiana);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initObsidiana);
      } else {
        initObsidiana();
      }
    </script>
  </body>
</html>
