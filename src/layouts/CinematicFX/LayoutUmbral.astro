---
import { Image } from 'astro:assets';
import TypeMagyk from '../../components/TypeMagyk.astro';

interface Props {
  frontmatter: any;
  isCustom?: boolean;
  atmosfera?: string;
  config?: any;
}

const { frontmatter, config } = Astro.props;
const images: string[] = frontmatter.images || frontmatter.gallery || frontmatter.galeria || (frontmatter.coverImage ? [frontmatter.coverImage] : []);
const title = frontmatter.title || 'Dossier — Umbral';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-[#0b0c0d] text-[#e3ddd3] min-h-screen relative overflow-x-hidden selection:bg-[#c9a86c]/30 selection:text-white">
    
    <!-- Contenedor Ambiental Fijo (Fondo Eje Z - Profundidad / Zoom Scale: 4) -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden perspective-[1000px]" id="umbral-bg-root">
      <div class="absolute inset-0 bg-black/40 z-20"></div>
      <div class="absolute inset-0 bg-radial from-transparent via-[#0b0c0d]/50 to-[#0b0c0d] z-20"></div>

      <!-- Capa de Polvo Ambiental / Ruido Estático -->
      <div 
        class="absolute inset-0 pointer-events-none opacity-[0.07] mix-blend-screen bg-repeat z-30"
        style="background-image: url('data:image/svg+xml;utf8,<svg viewBox=\'0 0 200 200\' xmlns=\'http://www.w3.org/2000/svg\'><filter id=\'dustNoise\'><feTurbulence type=\'fractalNoise\' baseFrequency=\'0.85\' numOctaves=\'3\' stitchTiles=\'stitch\'/></filter><rect width=\'100%\' height=\'100%\' filter=\'url(%23dustNoise)\'/></svg>');"
        aria-hidden="true"
      ></div>

      {images.map((img, i) => (
        <div 
          class="umbral-layer absolute inset-0 w-full h-full will-change-[transform,opacity] transform-gpu"
          style={`z-index: ${images.length - i};`}
        >
          {typeof img === 'object' && img ? (
            <Image
              src={img}
              alt=""
              format="webp"
              quality={80}
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
              class="w-full h-full object-cover object-center brightness-75"
            />
          ) : typeof img === 'string' && img.trim().length > 0 ? (
            <img
              src={img}
              alt=""
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
              class="w-full h-full object-cover object-center brightness-75"
            />
          ) : null}
        </div>
      ))}
    </div>

    <!-- Contenedor de Contenido y Lectura -->
    <main class="relative z-40 max-w-4xl mx-auto px-6 py-32 md:py-48 min-h-[300vh]" id="umbral-content">
      <TypeMagyk frontmatter={frontmatter} config={config}>
        <slot />
      </TypeMagyk>
    </main>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      function initUmbral() {
        const layers = gsap.utils.toArray<HTMLElement>('.umbral-layer');
        if (!layers.length || layers.length <= 1) return;

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: '#umbral-content',
            start: 'top top',
            end: 'bottom bottom',
            scrub: 1,
          }
        });

        layers.forEach((layer, i) => {
          // Todas excepto la capa base del fondo escalan a 4 y se desvanecen
          if (i < layers.length - 1) {
            tl.to(layer, {
              scale: 4,
              opacity: 0,
              ease: 'power2.inOut',
            }, i);
          }
        });
      }

      document.addEventListener('astro:page-load', initUmbral);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initUmbral);
      } else {
        initUmbral();
      }
    </script>
  </body>
</html>
