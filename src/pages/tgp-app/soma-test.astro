---
// src/pages/tgp-app/soma-test.astro
// Vista de prueba cruda y aislada para SOMA Wiki Engine en Cloud Run / Local
export const prerender = false;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TGP SOMA Engine · Cloud Test Lab</title>
  <style>
    :root {
      --bg: #090c0a;
      --card-bg: #111613;
      --card-border: #1e2621;
      --accent: #22c55e;
      --accent-dim: #15803d;
      --text: #e5e7eb;
      --text-muted: #9ca3af;
      --hero-accent: #f59e0b;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      padding: 2rem 1.5rem;
      line-height: 1.5;
    }
    .container {
      max-width: 1400px;
      margin: 0 auto;
    }
    header {
      border-bottom: 1px solid var(--card-border);
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
    }
    h1 {
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .badge {
      font-size: 0.75rem;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      background: #1e293b;
      color: #94a3b8;
      font-family: monospace;
      text-transform: uppercase;
    }
    .control-panel {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 1.25rem;
      margin-bottom: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .input-row {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .field-group {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      flex: 1;
      min-width: 260px;
    }
    label {
      font-size: 0.8rem;
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    input[type="text"] {
      background: #060907;
      border: 1px solid #2a352e;
      color: #fff;
      padding: 0.75rem 1rem;
      border-radius: 6px;
      font-size: 0.95rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s;
    }
    input[type="text"]:focus {
      border-color: var(--accent);
    }
    .btn-search {
      background: var(--accent);
      color: #052e16;
      border: none;
      font-weight: 700;
      padding: 0.75rem 1.75rem;
      border-radius: 6px;
      cursor: pointer;
      align-self: flex-end;
      font-size: 0.95rem;
      transition: background 0.15s, transform 0.05s;
    }
    .btn-search:hover {
      background: #4ade80;
    }
    .btn-search:active {
      transform: scale(0.98);
    }
    .btn-search:disabled {
      background: #27272a;
      color: #71717a;
      cursor: not-allowed;
    }
    .preset-btn {
      background: #18221b;
      border: 1px solid #28372d;
      color: #9ca3af;
      padding: 0.25rem 0.6rem;
      border-radius: 4px;
      font-size: 0.78rem;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.15s;
    }
    .preset-btn:hover {
      background: #233428;
      color: #e5e7eb;
    }
    .preset-btn.active {
      background: #064e3b;
      border-color: var(--accent);
      color: #a7f3d0;
      font-weight: 600;
    }
    .status-bar {
      font-family: monospace;
      font-size: 0.85rem;
      color: var(--text-muted);
      padding: 0.5rem 0.75rem;
      background: #060907;
      border-radius: 4px;
      border: 1px solid #1a221c;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .section-title {
      font-size: 1.2rem;
      margin: 2rem 0 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.25rem;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 1.25rem;
    }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .card.is-hero {
      border: 1px solid var(--hero-accent);
      box-shadow: 0 0 15px rgba(245, 158, 11, 0.1);
    }
    .hero-tag {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      background: var(--hero-accent);
      color: #451a03;
      font-weight: 800;
      font-size: 0.7rem;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      z-index: 10;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .img-wrap {
      width: 100%;
      height: 230px;
      background: #040605;
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.2s ease;
    }
    .img-wrap img:hover {
      transform: scale(1.03);
    }
    .card-body {
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      flex: 1;
    }
    .item-title {
      font-size: 0.95rem;
      font-weight: 600;
      line-height: 1.3;
      color: #f3f4f6;
    }
    .specs-table {
      font-family: monospace;
      font-size: 0.78rem;
      color: #94a3b8;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.2rem 0.6rem;
      margin-top: 0.25rem;
      border-top: 1px solid #1a221c;
      padding-top: 0.5rem;
    }
    .spec-key {
      color: #64748b;
    }
    .spec-val {
      color: #cbd5e1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .spec-val.highlight {
      color: var(--accent);
      font-weight: 700;
    }
    .link-row {
      margin-top: auto;
      padding-top: 0.5rem;
      display: flex;
      gap: 0.5rem;
    }
    .link-btn {
      font-size: 0.75rem;
      text-decoration: none;
      color: #38bdf8;
      background: #082f49;
      padding: 0.25rem 0.6rem;
      border-radius: 4px;
      display: inline-block;
    }
    .link-btn:hover {
      background: #0284c7;
      color: #fff;
    }
    .empty-state {
      padding: 3rem;
      text-align: center;
      color: var(--text-muted);
      border: 1px dashed var(--card-border);
      border-radius: 8px;
      font-size: 0.95rem;
    }
    .error-box {
      background: #450a0a;
      border: 1px solid #991b1b;
      color: #fca5a5;
      padding: 1rem;
      border-radius: 6px;
      font-family: monospace;
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
      display: none;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>
        SOMA Engine · Cloud Test Lab
        <span class="badge">Isolated Test Bench</span>
      </h1>
      <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.25rem;">
        Banco de pruebas para validar respuestas en vivo de Cloud Run (Wikimedia Commons + Europeana + Hero Top 3).
      </p>
    </header>

    <div class="control-panel">
      <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap;">
        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">PRESETS DE CONEXIÓN:</span>
        <button type="button" id="btnPresetLocal" class="preset-btn active">🟢 Local (/api/soma/search)</button>
        <button type="button" id="btnPresetCloudRun" class="preset-btn">☁️ Cloud Run (tgp-app)</button>
        <button type="button" id="btnPresetCustom" class="preset-btn">✏️ URL Manual</button>
      </div>

      <div class="input-row">
        <div class="field-group" style="flex: 2;">
          <label for="endpointUrl">Endpoint URL a consultar</label>
          <input
            type="text"
            id="endpointUrl"
            value="/api/soma/search"
            placeholder="/api/soma/search o https://tu-servicio-uc.a.run.app/api/soma/search"
          />
        </div>
        <div class="field-group" style="flex: 2;">
          <label for="queryInput">Consulta Arqueológica / Patrimonial</label>
          <input
            type="text"
            id="queryInput"
            value="Pyramid of Giza"
            placeholder="Ej: Pyramid of Giza, Saqqara, Ollantaytambo..."
          />
        </div>
        <button id="searchBtn" class="btn-search">Buscar en SOMA</button>
      </div>

      <div class="status-bar" id="statusBar">
        <span id="statusText">Listo para consultar</span>
        <span id="statsText">Esperando solicitud</span>
      </div>
    </div>

    <div id="errorBox" class="error-box"></div>

    <section id="heroSection" style="display: none;">
      <h2 class="section-title">
        <span style="color: var(--hero-accent);">★</span> Hero Top 3 (Curaduría Editorial Panorámica)
      </h2>
      <div class="hero-grid" id="heroGrid"></div>
    </section>

    <section id="batchSection" style="display: none;">
      <h2 class="section-title">
        <span style="color: var(--accent);">●</span> Curated Batch (Lote Completo)
      </h2>
      <div class="grid" id="batchGrid"></div>
    </section>

    <div id="emptyState" class="empty-state">
      Introduce un término de búsqueda patrimonial o modifica el Endpoint de Cloud Run para comenzar la prueba.
    </div>
  </div>

  <script>
    const searchBtn = document.getElementById('searchBtn');
    const endpointInput = document.getElementById('endpointUrl');
    const queryInput = document.getElementById('queryInput');
    const statusText = document.getElementById('statusText');
    const statsText = document.getElementById('statsText');
    const errorBox = document.getElementById('errorBox');
    const heroSection = document.getElementById('heroSection');
    const heroGrid = document.getElementById('heroGrid');
    const batchSection = document.getElementById('batchSection');
    const batchGrid = document.getElementById('batchGrid');
    const emptyState = document.getElementById('emptyState');

    function renderCard(item, isHero = false) {
      const card = document.createElement('div');
      card.className = `card ${isHero ? 'is-hero' : ''}`;

      const heroTag = isHero ? `<div class="hero-tag">★ HERO ${item.score ? '(' + item.score + ' pts)' : ''}</div>` : '';
      const displayUrl = item.thumbUrl || item.url;

      card.innerHTML = `
        ${heroTag}
        <div class="img-wrap">
          <img src="${displayUrl}" alt="${item.cleanTitle}" loading="lazy" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22100%22 height=%22100%22><rect width=%22100%22 height=%22100%22 fill=%22%23222%22/><text x=%2250%%22 y=%2250%%22 fill=%22%23666%22 font-size=%2210%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22>Img No Disp</text></svg>'" />
        </div>
        <div class="card-body">
          <h3 class="item-title" title="${item.title}">${item.cleanTitle}</h3>
          <div class="specs-table">
            <span class="spec-key">Resolución:</span>
            <span class="spec-val highlight">${item.width} × ${item.height} px</span>

            <span class="spec-key">Aspect Ratio:</span>
            <span class="spec-val">${item.aspectRatio} (${item.isLandscape ? 'Landscape' : 'Portrait'}${item.is16x9Plus ? ' · 16:9+' : ''})</span>

            <span class="spec-key">Fuente:</span>
            <span class="spec-val">${item.source} (${item.id})</span>

            <span class="spec-key">Licencia:</span>
            <span class="spec-val">${item.licenseShortName || item.license} ${item.isCC0OrPublicDomain ? '✓ [PD/CC0]' : ''}</span>

            <span class="spec-key">Autor:</span>
            <span class="spec-val" title="${item.author}">${item.author}</span>
          </div>
          <div class="link-row">
            <a href="${item.url}" target="_blank" rel="noopener noreferrer" class="link-btn">Ver Original ↗</a>
            <a href="${item.thumbUrl}" target="_blank" rel="noopener noreferrer" class="link-btn" style="background:#1e293b; color:#94a3b8;">Ver Thumb ↗</a>
          </div>
        </div>
      `;
      return card;
    }

    async function doSearch() {
      const endpoint = endpointInput.value.trim();
      const query = queryInput.value.trim();

      if (!query) {
        alert('Por favor escribe un término de búsqueda.');
        return;
      }

      searchBtn.disabled = true;
      searchBtn.textContent = 'Buscando...';
      errorBox.style.display = 'none';
      errorBox.textContent = '';
      statusText.textContent = `Consultando "${query}" en ${endpoint}...`;
      statsText.textContent = 'Esperando respuesta...';

      try {
        const startTime = performance.now();
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            query,
            options: {
              limit: 20,
              useGeminiAgent: true,
            },
          }),
        });

        const elapsed = Math.round(performance.now() - startTime);

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(`HTTP ${res.status}: ${errData.error || res.statusText || 'Error en respuesta del servidor'}`);
        }

        const data = await res.json();

        // Renderizado
        heroGrid.innerHTML = '';
        batchGrid.innerHTML = '';

        const heroTop3 = data.heroTop3 || [];
        const curatedBatch = data.curatedBatch || [];

        if (heroTop3.length > 0) {
          heroSection.style.display = 'block';
          heroTop3.forEach((item) => heroGrid.appendChild(renderCard(item, true)));
        } else {
          heroSection.style.display = 'none';
        }

        if (curatedBatch.length > 0) {
          batchSection.style.display = 'block';
          curatedBatch.forEach((item) => batchGrid.appendChild(renderCard(item, false)));
        } else {
          batchSection.style.display = 'none';
        }

        emptyState.style.display = (heroTop3.length === 0 && curatedBatch.length === 0) ? 'block' : 'none';

        const stats = data.stats || {};
        statusText.textContent = `✓ OK (${elapsed}ms) · Canónico: "${data.queryCanonical || data.queryOriginal}"`;
        statsText.textContent = `Total: ${stats.total || curatedBatch.length} | Wikimedia: ${stats.wikimediaCount || 0} | Europeana: ${stats.europeanaCount || 0} | Landscape: ${stats.landscapeCount || 0} | PD/CC0: ${stats.cc0OrPdCount || 0}`;

      } catch (err) {
        errorBox.style.display = 'block';
        errorBox.innerHTML = `<strong>Error de conexión o ejecución:</strong><br/>${err.message}<br/><br/>
        <em>Tip:</em> Si estás probando localmente antes de Cloud Run, cambia el Endpoint a <code>/api/soma/search</code>.<br/>
        Si Cloud Run está desplegado, asegúrate de que la URL termine en <code>/api/soma/search</code> y que permita invocaciones públicas o tenga CORS habilitado.`;
        statusText.textContent = '✕ Error en la consulta';
        statsText.textContent = 'Falló la conexión';
      } finally {
        searchBtn.disabled = false;
        searchBtn.textContent = 'Buscar en SOMA';
      }
    }

    const btnPresetLocal = document.getElementById('btnPresetLocal');
    const btnPresetCloudRun = document.getElementById('btnPresetCloudRun');
    const btnPresetCustom = document.getElementById('btnPresetCustom');

    btnPresetLocal.addEventListener('click', () => {
      endpointInput.value = '/api/soma/search';
      btnPresetLocal.classList.add('active');
      btnPresetCloudRun.classList.remove('active');
      btnPresetCustom.classList.remove('active');
    });

    btnPresetCloudRun.addEventListener('click', () => {
      endpointInput.value = 'https://tgp-app-uzhmxe53dq-uc.a.run.app/api/soma/search';
      btnPresetCloudRun.classList.add('active');
      btnPresetLocal.classList.remove('active');
      btnPresetCustom.classList.remove('active');
    });

    btnPresetCustom.addEventListener('click', () => {
      endpointInput.focus();
      endpointInput.select();
      btnPresetCustom.classList.add('active');
      btnPresetLocal.classList.remove('active');
      btnPresetCloudRun.classList.remove('active');
    });

    searchBtn.addEventListener('click', doSearch);
    queryInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') doSearch();
    });
  </script>
</body>
</html>
