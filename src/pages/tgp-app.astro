---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import ScriptoriumCapture from '../components/ScriptoriumCapture.svelte';
---

<Layout title="TGP Scriptorium | Panel de Control">
  <main class="min-h-screen bg-[#0b0f0e] text-[#d4d4d2] flex flex-col items-center justify-center p-6">
    <div class="max-w-4xl w-full border border-[#263231] bg-[#111716] p-6 sm:p-8 rounded-xl shadow-2xl backdrop-blur-md">
      <header class="mb-8 text-center border-b border-[#263231] pb-6">
        <span class="text-xs uppercase tracking-widest text-[#8a9a98] font-mono">Cartografía Epistémica & Ediciones</span>
        <h1 class="text-3xl font-serif font-light text-[#f0f2f1] mt-2">TGP Scriptorium</h1>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a 
          href="/keystatic" 
          class="block p-4 border border-[#263231] hover:border-[#4a5a58] bg-[#161d1c] hover:bg-[#1c2423] transition-all rounded group"
        >
          <h2 class="text-lg font-serif text-[#f0f2f1] group-hover:text-white">Hemeroteca (Main Web)</h2>
          <p class="text-sm text-[#8a9a98] mt-1">Gestionar ensayos, arquetipos y sitios arqueohistóricos.</p>
        </a>

        <a 
          href="https://ediciones.thegreatpuzzleproject.com/keystatic" 
          target="_blank" 
          rel="noopener noreferrer"
          class="block p-4 border border-[#263231] hover:border-[#4a5a58] bg-[#161d1c] hover:bg-[#1c2423] transition-all rounded group"
        >
          <h2 class="text-lg font-serif text-[#f0f2f1] group-hover:text-white">Ediciones & Ebooks</h2>
          <p class="text-sm text-[#8a9a98] mt-1">Gestionar publicaciones, dossiers y magazines.</p>
        </a>

        <a 
          href="https://tgp-webfinal2026.pages.dev/tgp-vault" 
          target="_blank" 
          rel="noopener noreferrer"
          class="block p-4 border border-[#263231] hover:border-[#4a5a58] bg-[#161d1c] hover:bg-[#1c2423] transition-all rounded group"
        >
          <h2 class="text-lg font-serif text-[#f0f2f1] group-hover:text-white">TGP-Vault / Atanor</h2>
          <p class="text-sm text-[#8a9a98] mt-1">Centro de operaciones. Ingesta masiva, limpieza HTML y transmutación a D1/R2.</p>
        </a>

        <a 
          href="https://alternative.thegreatpuzzleproject.com/keystatic" 
          target="_blank" 
          rel="noopener noreferrer"
          class="block p-4 border border-[#263231] hover:border-[#4a5a58] bg-[#161d1c] hover:bg-[#1c2423] transition-all rounded group"
        >
          <h2 class="text-lg font-serif text-[#f0f2f1] group-hover:text-white">TGP Alternative</h2>
          <p class="text-sm text-[#8a9a98] mt-1">Gestionar ensayos, narrativas liminales y arquitectura visual.</p>
        </a>

        <a 
          href="/laboratorio-visual" 
          class="block p-4 border border-[#263231] hover:border-[#4a5a58] bg-[#161d1c] hover:bg-[#1c2423] transition-all rounded group"
        >
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-serif text-[#f0f2f1] group-hover:text-white">Laboratorio Visual (R2 + Cloud Run)</h2>
            <span class="text-[10px] uppercase font-mono tracking-widest text-emerald-400 bg-emerald-950/60 border border-emerald-800/60 px-2 py-0.5 rounded-full">Activo</span>
          </div>
          <p class="text-sm text-[#8a9a98] mt-1">Transformaciones con OpenCV/Cloud Run y subida a Cloudflare R2 con Google Picker integrado.</p>
        </a>

        <a 
          href="/scriptorium" 
          class="block p-4 border border-[#263231] hover:border-[#4a5a58] bg-[#161d1c] hover:bg-[#1c2423] transition-all rounded group"
        >
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-serif text-[#f0f2f1] group-hover:text-white">TGP Scriptorium (Página Oficial)</h2>
            <span class="text-[10px] uppercase font-mono tracking-widest text-emerald-400 bg-emerald-950/60 border border-emerald-800/60 px-2 py-0.5 rounded-full">Multimodal</span>
          </div>
          <p class="text-sm text-[#8a9a98] mt-1">Análisis iconográfico con Gemini Vision, extracción desde Google Drive / Fotos y vista dedicada.</p>
        </a>

        <a
          href="/scriptorium-forense"
          class="block p-4 border border-[#263231] hover:border-[#4ade80]/40 bg-[#161d1c] hover:bg-[#1a2420] transition-all rounded group"
        >
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-serif text-[#f0f2f1] group-hover:text-white">Visor Forense Notion-Style</h2>
            <span class="text-[10px] uppercase font-mono tracking-widest text-emerald-400 bg-emerald-950/60 border border-emerald-800/60 px-2 py-0.5 rounded-full">Nuevo</span>
          </div>
          <p class="text-sm text-[#8a9a98] mt-1">Visor inmersivo 3 columnas de registros GAS. Hero carousel, pills de metadata, bloques Notion.</p>
        </a>

        <div class="md:col-span-2">
          <ScriptoriumCapture client:load />
        </div>
      </div>

      <footer class="mt-8 text-center text-xs text-[#62706e] font-mono">
        Acceso restringido — Autorizado exclusivamente para Xavier Benítez.
      </footer>
    </div>
  </main>
</Layout>
