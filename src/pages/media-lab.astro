---
/**
 * src/pages/media-lab.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Media Lab · Laboratorio de Bento Cards Cinemascope & Ambient Glow
 * Tamaño monumental Widescreen con espaciado generoso y esculturas completas de cabeza a base.
 * ─────────────────────────────────────────────────────────────────────────────
 */

import Layout from '../layouts/Layout.astro';
import BentoCinemascopeAmbient from '../components/BentoCinemascopeAmbient.astro';

export const prerender = false;
---

<Layout
  title="Media Lab · Bento Cinemascope Monumental | TGP"
  description="Laboratorio cinemático de Bento Cards Widescreen 21:9 con iluminación geométrica ambiental reactiva y esculturas completas."
  hideHeader={false}
  headerTransparentUntilScroll={false}
  footerVariant="minimal"
>
  <main class="min-h-screen bg-[#060709] text-white pt-24 pb-32 px-4 sm:px-6 md:px-10 lg:px-16">
    <!-- CABECERA DEL LABORATORIO -->
    <header class="max-w-7xl mx-auto mb-16 text-center sm:text-left border-b border-white/10 pb-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-400 font-mono text-xs uppercase tracking-widest mb-4">
        <span>⚡ Media Lab · Cinemascope Monumental</span>
      </div>
      <h1 class="font-serif font-black text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-white tracking-tight leading-[1.05]">
        Bento Cinemascope <span class="text-amber-400">· Ambient Glow</span>
      </h1>
      <p class="font-sans text-sm sm:text-base md:text-lg text-stone-300/80 mt-3 max-w-3xl font-light leading-relaxed">
        Composición widescreen con proporción ampliada, resguardo vertical de contención (100% de la escultura visible de pies a cabeza) y separación generosa entre unidades.
      </p>
    </header>

    <!-- CONTENEDOR CON PADDING GENEROSO ENTRE CARDS (space-y-28 md:space-y-36) -->
    <div class="max-w-7xl mx-auto space-y-24 sm:space-y-32 md:space-y-40">
      
      <!-- 01. HERMES PSICOPOMPO (PRESET SOLAR & PURPLE — IDÉNTICO AL SAMPLE DE REFERENCIA) -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono text-stone-400 px-2 gap-1">
          <span class="text-white font-semibold">01 / PRESET SOLAR &amp; PURPLE (EMULACIÓN DIRECTA DEL SAMPLE)</span>
          <span class="text-amber-400">H1: Fraunces Black 900 · Sub: Plus Jakarta Sans</span>
        </div>

        <BentoCinemascopeAmbient
          kicker="ARCHIVOS DEL MEDITERRÁNEO · SERIE E"
          kickerIcon="✦"
          title="Hermes y el Dios de las Encrucijadas"
          subtitle="La frontera no se custodia: se constituye. Autopsia conceptual sobre el psicopompo y el nacimiento del espacio liminal."
          imageSrc="/images/museum/statue-hermes.webp"
          imageAlt="Hermes Psicopompo completo de pies a cabeza"
          aspectRatio="21/9"
          primaryGlowColor="#facc15"
          secondaryGlowColor="#581c87"
          fontH1="font-['Fraunces',serif] font-black"
          fontSans="font-['Plus_Jakarta_Sans',sans-serif]"
          href="/ensayos/mercurio-hermes-arquetipo-liminal"
          ctaText="Explorar Ensayo"
        />
      </section>

      <!-- 02. ATENEA PARTENOS (PRESET ORO PULIDO & OBSIDIANA) -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono text-stone-400 px-2 gap-1">
          <span class="text-white font-semibold">02 / PRESET ORO PULIDO &amp; OBSIDIANA (ESCULTURA CRESTADA)</span>
          <span class="text-amber-300">H1: Cinzel Bold 700 · Sub: Inter Clean</span>
        </div>

        <BentoCinemascopeAmbient
          kicker="SABIDURÍA MARCIAL · ARCHIVO CLÁSICO"
          kickerIcon="⟡"
          title="Atenea y la Razón como Baluarte"
          subtitle="La lanza de bronce que divide el caos de la polis. Dialéctica entre la guerra sacrificial y la inteligencia legislativa."
          imageSrc="/images/museum/statue-athena.webp"
          imageAlt="Atenea Partenos completa con escudo y lanza"
          aspectRatio="21/9"
          primaryGlowColor="#fbbf24"
          secondaryGlowColor="#1c1917"
          fontH1="font-['Cinzel',serif] font-bold tracking-tight"
          fontSans="font-['Inter',sans-serif]"
          href="/archivo"
          ctaText="Examinar Código"
        />
      </section>

      <!-- 03. VICTORIA DE SAMOTRACIA (PRESET CIAN HELÉNICO & COBALTO PROFUNDO) -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono text-stone-400 px-2 gap-1">
          <span class="text-white font-semibold">03 / PRESET CIAN HELÉNICO &amp; COBALTO PROFUNDO</span>
          <span class="text-cyan-400">H1: Bodoni Moda Black · Sub: Space Grotesk</span>
        </div>

        <BentoCinemascopeAmbient
          kicker="DINÁMICA HELÉNICA · SANTUARIO DE SAMOTRACIA"
          kickerIcon="◈"
          title="La Victoria Alada sin Rostro"
          subtitle="El viento marino esculpido en mármol de Paros. La proa de guerra que desafió el naufragio y la amnesia del tiempo."
          imageSrc="/images/museum/statue-nike.webp"
          imageAlt="Victoria de Samotracia con alas completas"
          aspectRatio="21/9"
          primaryGlowColor="#38bdf8"
          secondaryGlowColor="#1e1b4b"
          fontH1="font-['Bodoni_Moda',serif] font-black"
          fontSans="font-['Space_Grotesk',sans-serif]"
          href="/ensayos/amnesia-programada"
          ctaText="Ver Expediente"
        />
      </section>

      <!-- 04. JÚPITER SEDENTE (PRESET ESMERALDA & COBRE IMPERIAL) -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono text-stone-400 px-2 gap-1">
          <span class="text-white font-semibold">04 / PRESET ESMERALDA &amp; COBRE IMPERIAL</span>
          <span class="text-emerald-400">H1: Syne ExtraBold 800 · Sub: IBM Plex Mono</span>
        </div>

        <BentoCinemascopeAmbient
          kicker="SOBERANÍA LÍTICA · ARCHIVO IMPERIAL"
          kickerIcon="✦"
          title="Júpiter y la Arquitectura del Rayo"
          subtitle="El monolito como decreto ontológico. Anatomía del poder que transmuta la fuerza bruta en canon legislativo."
          imageSrc="/images/museum/statue-jupiter.webp"
          imageAlt="Júpiter sedente completo con águila y rayo"
          aspectRatio="21/9"
          primaryGlowColor="#34d399"
          secondaryGlowColor="#78350f"
          fontH1="font-['Syne',sans-serif] font-extrabold"
          fontSans="font-['IBM_Plex_Mono',monospace]"
          href="/archivo"
          ctaText="Acceder a la Bóveda"
        />
      </section>

    </div>
  </main>
</Layout>
