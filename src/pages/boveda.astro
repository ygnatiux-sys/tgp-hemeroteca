---
/**
 * src/pages/boveda.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * BÓVEDA DE ARCHIVO: EXPEDIENTES MONUMENTALES
 * Proyección Monumental en 2 Visores Apple Cinema Showcase IMAX MAX (GSAP Timeline)
 *
 * Contiene los ensayos y expedientes rescatados del pozo de Cloudflare D1
 * y archivos no enlazados, rigurosamente desduplicados frente a las páginas activas.
 * ─────────────────────────────────────────────────────────────────────────────
 */

export const prerender = true;

import Layout from '../layouts/Layout.astro';
import PolvoDorado from '../components/PolvoDorado.astro';
import AppleCinemaShowcase, { type CinemaShowcaseItem } from '../components/AppleCinemaShowcase.astro';
import curatedData from '../data/lost-posts-curated.json';

const rawReel1 = (curatedData.reel1_arqueologia_litica || []).slice(0, 6);
const rawReel2 = (curatedData.reel2_filosofia_gnosis || []).slice(0, 6);

// PRESETS TIPOGRÁFICOS DE ALTO IMPACTO (CERO GLOOCK / CERO CINZEL)
const REEL1_PRESETS = [
  {
    fontH1: "font-['Unbounded',sans-serif] font-black tracking-[-0.02em] uppercase",
    fontH2: "font-['Inter',sans-serif]",
    serviceColor: "#0284c7",
    serviceIcon: "⟡",
    ratingScore: "98%",
    ratingIcon: "🍅",
    techSpecs: ["4K", "IMAX 70MM", "PALIMPSESTO D1", "CC", "AD"]
  },
  {
    fontH1: "font-['Fraunces',serif] font-black italic tracking-[-0.03em] uppercase",
    fontH2: "font-['Space_Mono',monospace]",
    serviceColor: "#e11d48",
    serviceIcon: "✦",
    ratingScore: "97%",
    ratingIcon: "🍅",
    techSpecs: ["4K", "RESTITUCIÓN D1", "POMPEYA RAW", "SDH"]
  },
  {
    fontH1: "font-['Syne',sans-serif] font-black tracking-[0.06em] uppercase",
    fontH2: "font-['IBM_Plex_Mono',monospace]",
    serviceColor: "#9333ea",
    serviceIcon: "◈",
    ratingScore: "95%",
    ratingIcon: "✳️",
    techSpecs: ["4K", "DOLBY VISION", "ISMAILÍSMO", "CC"]
  },
  {
    fontH1: "font-['Bodoni_Moda',serif] font-black tracking-[0.04em] uppercase",
    fontH2: "font-['Plus_Jakarta_Sans',sans-serif]",
    serviceColor: "#d97706",
    serviceIcon: "",
    ratingScore: "96%",
    ratingIcon: "🍅",
    techSpecs: ["4K", "IMAX 70MM", "ARCHIVOS 1307", "AD"]
  },
  {
    fontH1: "font-['Clash_Display',sans-serif] font-bold tracking-tight uppercase",
    fontH2: "font-['Space_Mono',monospace]",
    serviceColor: "#059669",
    serviceIcon: "⟡",
    ratingScore: "99%",
    ratingIcon: "🍅",
    techSpecs: ["4K", "TEBAS RAW", "DINASTÍA XVIII", "CC"]
  },
  {
    fontH1: "font-['League_Spartan',sans-serif] font-black tracking-[-0.03em] uppercase",
    fontH2: "font-['Inter',sans-serif]",
    serviceColor: "#4f46e5",
    serviceIcon: "✦",
    ratingScore: "94%",
    ratingIcon: "✳️",
    techSpecs: ["4K", "IMAX 70MM", "MEGALITO FLOTANTE", "SDH"]
  }
];

const REEL2_PRESETS = [
  {
    fontH1: "font-['Fraunces',serif] font-black tracking-[-0.025em] uppercase",
    fontH2: "font-['Inter',sans-serif]",
    serviceColor: "#f59e0b",
    serviceIcon: "◈",
    ratingScore: "98%",
    ratingIcon: "🍅",
    techSpecs: ["4K", "GNOSIS ARCAICA", "NAG HAMMADI", "CC"]
  },
  {
    fontH1: "font-['Syne',sans-serif] font-black tracking-[0.08em] uppercase",
    fontH2: "font-['Space_Mono',monospace]",
    serviceColor: "#8b5cf6",
    serviceIcon: "⟡",
    ratingScore: "96%",
    ratingIcon: "🍅",
    techSpecs: ["4K", "DOLBY ATMOS", "RESONANCIA MENTAL", "AD"]
  },
  {
    fontH1: "font-['Unbounded',sans-serif] font-black tracking-[-0.01em] uppercase",
    fontH2: "font-['IBM_Plex_Mono',monospace]",
    serviceColor: "#06b6d4",
    serviceIcon: "",
    ratingScore: "95%",
    ratingIcon: "✳️",
    techSpecs: ["4K", "IMAX 70MM", "ANAMNESIS", "SDH"]
  },
  {
    fontH1: "font-['Bodoni_Moda',serif] font-black italic tracking-[0.02em] uppercase",
    fontH2: "font-['Plus_Jakarta_Sans',sans-serif]",
    serviceColor: "#ec4899",
    serviceIcon: "✦",
    ratingScore: "97%",
    ratingIcon: "🍅",
    techSpecs: ["4K", "LABERINTO BORGES", "TIEMPO CIRCULAR", "CC"]
  },
  {
    fontH1: "font-['Space_Grotesk',sans-serif] font-bold tracking-tight uppercase",
    fontH2: "font-['Space_Mono',monospace]",
    serviceColor: "#10b981",
    serviceIcon: "◈",
    ratingScore: "93%",
    ratingIcon: "🍅",
    techSpecs: ["4K", "FILOSOFÍA DEL VACÍO", "SHUNYATA", "AD"]
  },
  {
    fontH1: "font-['League_Spartan',sans-serif] font-black tracking-[-0.03em] uppercase",
    fontH2: "font-['Inter',sans-serif]",
    serviceColor: "#3b82f6",
    serviceIcon: "⟡",
    ratingScore: "97%",
    ratingIcon: "🍅",
    techSpecs: ["4K", "IMAX 70MM", "ESCATOLOGÍA", "CC", "SDH"]
  }
];

const showcaseReel1: CinemaShowcaseItem[] = rawReel1.map((p, idx) => {
  const preset = REEL1_PRESETS[idx % REEL1_PRESETS.length];
  return {
    title: p.title.toUpperCase(),
    subtitle: p.excerpt,
    category: p.category || "Hemeroteca Clásica",
    image: p.coverImage || "/images/placeholder-cover.png",
    href: `#modal-${p.id}`,
    fontH1: preset.fontH1,
    fontH2: preset.fontH2,
    accentBadge: `Expediente 0${idx + 1} · Arqueología Lítica`,
    serviceColor: preset.serviceColor,
    serviceIcon: preset.serviceIcon,
    categoryLabel: `Expediente 0${idx + 1} · Arqueología Lítica`,
    samRating: "SAM 13",
    ratingScore: preset.ratingScore,
    ratingIcon: preset.ratingIcon,
    techSpecs: preset.techSpecs,
    duration: "22 min lectura",
    author: "Xavier Benítez",
    director: "The Great Puzzle Project",
    modalId: p.id,
    actionLabel: "Leer Ensayo Rescatado"
  };
});

const showcaseReel2: CinemaShowcaseItem[] = rawReel2.map((p, idx) => {
  const preset = REEL2_PRESETS[idx % REEL2_PRESETS.length];
  return {
    title: p.title.toUpperCase(),
    subtitle: p.excerpt,
    category: p.category || "Gnosis & Tiempo",
    image: p.coverImage || "/images/placeholder-cover.png",
    href: `#modal-${p.id}`,
    fontH1: preset.fontH1,
    fontH2: preset.fontH2,
    accentBadge: `Expediente 0${idx + 1} · Gnosis & Tiempo`,
    serviceColor: preset.serviceColor,
    serviceIcon: preset.serviceIcon,
    categoryLabel: `Expediente 0${idx + 1} · Gnosis & Tiempo`,
    samRating: "SAM 16",
    ratingScore: preset.ratingScore,
    ratingIcon: preset.ratingIcon,
    techSpecs: preset.techSpecs,
    duration: "26 min lectura",
    author: "Xavier Benítez",
    director: "The Great Puzzle Project",
    modalId: p.id,
    actionLabel: "Leer Ensayo Rescatado"
  };
});

const allRecoveredPosts = [...rawReel1, ...rawReel2];
---

<Layout
  title="Bóveda de Archivo · Posteos Recuperados | The Great Puzzle Project"
  description="Restitución monumental de ensayos históricos y filosóficos rescatados del archivo profundo en dos visores Apple TV IMAX MAX."
>
  <PolvoDorado />

  <main class="min-h-screen bg-[#050706] text-[#EFEBE3] pt-24 sm:pt-28 pb-32 px-4 sm:px-6 md:px-10 lg:px-14 overflow-hidden relative">
    
    <!-- EFECTO AMBIENTAL DE FONDO -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[90vw] max-w-[1200px] h-[450px] bg-[radial-gradient(ellipse_at_center,rgba(78,242,210,0.08)_0%,rgba(6,10,8,0)_70%)] blur-3xl"></div>
      <div class="absolute top-[45%] right-0 w-[60vw] max-w-[800px] h-[500px] bg-[radial-gradient(ellipse_at_center,rgba(230,154,70,0.06)_0%,rgba(6,10,8,0)_70%)] blur-3xl"></div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════════
         HERO PRINCIPAL: EL POZO DE LA MEMORIA RECUPERADA
         ══════════════════════════════════════════════════════════════════════════ -->
    <header class="relative z-10 max-w-6xl mx-auto text-center pt-8 pb-14 sm:pb-20">
      
      <!-- Badge de Bóveda -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-md mb-6 shadow-xl">
        <span class="w-2 h-2 rounded-full bg-[#4ef2d2] shadow-[0_0_8px_#4ef2d2] animate-pulse"></span>
        <span class="font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.35em] text-[#4ef2d2] font-bold">
          EXPEDIENTES INÉDITOS Y RESTAURADOS
        </span>
      </div>

      <!-- Título Monumental en Fraunces -->
      <h1 class="font-fraunces font-black uppercase text-[clamp(2.5rem,7vw,5.8rem)] leading-[0.88] tracking-[-0.03em] text-[#F3EFE6] drop-shadow-[0_4px_30px_rgba(0,0,0,0.8)] mb-6">
        BÓVEDA DE ARCHIVO
      </h1>

      <!-- Bajada Doctrinal Xavier Benítez -->
      <p class="font-sans text-base sm:text-lg md:text-xl text-white/80 max-w-3xl mx-auto leading-relaxed mb-10 font-normal">
        El archivo no es una acumulación de datos muertos, sino una tecnología somática contra el olvido. 
        En esta bóveda restituimos los <span class="text-[#4ef2d2] font-semibold">expedientes fundamentales</span> que permanecían 
        dormidos en las capas profundas de Cloudflare D1. 
        Filtrados rigurosamente para <strong class="text-white">cero duplicidad</strong> y proyectados en formato monumental IMAX 70mm con tipografías de impacto.
      </p>

      <!-- Métricas Forenses de Restauración -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-4xl mx-auto">
        <div class="p-3.5 sm:p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md text-center">
          <div class="font-mono text-2xl sm:text-3xl font-black text-[#4ef2d2]">12</div>
          <div class="font-mono text-[10px] sm:text-[11px] uppercase tracking-wider text-white/50 mt-1">Posts en Proyección</div>
        </div>
        <div class="p-3.5 sm:p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md text-center">
          <div class="font-mono text-2xl sm:text-3xl font-black text-[#E69A46]">0</div>
          <div class="font-mono text-[10px] sm:text-[11px] uppercase tracking-wider text-white/50 mt-1">Duplicados Activos</div>
        </div>
        <div class="p-3.5 sm:p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md text-center">
          <div class="font-mono text-2xl sm:text-3xl font-black text-white">2</div>
          <div class="font-mono text-[10px] sm:text-[11px] uppercase tracking-wider text-white/50 mt-1">Visores IMAX 70mm</div>
        </div>
        <div class="p-3.5 sm:p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md text-center">
          <div class="font-mono text-2xl sm:text-3xl font-black text-emerald-400">100%</div>
          <div class="font-mono text-[10px] sm:text-[11px] uppercase tracking-wider text-white/50 mt-1">Matriz Benítez</div>
        </div>
      </div>

    </header>

    <!-- ══════════════════════════════════════════════════════════════════════════
         SECCIÓN 1: VISOR APPLE TV IMAX MAX (REEL 1 — LÍTICA & HEREJÍAS)
         ══════════════════════════════════════════════════════════════════════════ -->
    <section class="relative z-10 max-w-7xl mx-auto">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-4 px-2">
        <div>
          <div class="inline-flex items-center gap-2 mb-2 font-mono text-[11px] tracking-[0.3em] uppercase text-[#4ef2d2]">
            <span>REEL I</span>
            <span>•</span>
            <span>ARQUEOLOGÍA FORENSE</span>
          </div>
          <h2 class="font-fraunces font-black uppercase text-2xl sm:text-3xl md:text-4xl text-[#F3EFE6] leading-none">
            Estratigrafía Lítica & Herejías Arcaicas
          </h2>
        </div>
        <p class="font-mono text-xs text-white/50 max-w-md sm:text-right">
          De los falos apotropaicos en Pompeya a la fortaleza de Alamut y la red sacra de los templarios.
        </p>
      </div>

      <!-- VISOR 1 (IMAX MAX APPLE TV) -->
      <AppleCinemaShowcase
        items={showcaseReel1}
        isImax={true}
        showBottomSection={false}
        minimalist={true}
        actionLabel="Leer Ensayo Rescatado"
        collectionTitle="Arqueología Lítica & Herejías"
      />

    </section>

    <!-- ══════════════════════════════════════════════════════════════════════════
         INTERSTICIO FILOSÓFICO: CITA DE XAVIER BENÍTEZ (1 SCROLL COMPLETO DE DISTANCIA)
         ══════════════════════════════════════════════════════════════════════════ -->
    <div class="relative z-10 min-h-[75vh] flex flex-col justify-center items-center py-24 sm:py-32 my-12 text-center px-4 max-w-4xl mx-auto">
      <div class="w-16 h-px bg-[#d4af37]/40 mx-auto mb-8"></div>
      <blockquote class="font-fraunces italic font-medium text-xl sm:text-3xl text-white/90 leading-snug mb-4 max-w-3xl drop-shadow-md">
        “Atribuirle un sentido a la llaga o al monolito fue el artilugio trágico mediante el cual el ser humano intentó resistir al abismo de la contingencia.”
      </blockquote>
      <cite class="font-mono text-xs uppercase tracking-[0.3em] text-[#d4af37] not-italic block mt-2">
        — Xavier Benítez · De la Cueva al Cosmos
      </cite>
      <div class="w-16 h-px bg-[#d4af37]/40 mx-auto mt-8"></div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════════
         SECCIÓN 2: VISOR APPLE TV IMAX MAX (REEL 2 — GNOSIS & CONCIENCIA)
         ══════════════════════════════════════════════════════════════════════════ -->
    <section class="relative z-10 max-w-7xl mx-auto">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-4 px-2">
        <div>
          <div class="inline-flex items-center gap-2 mb-2 font-mono text-[11px] tracking-[0.3em] uppercase text-[#E69A46]">
            <span>REEL II</span>
            <span>•</span>
            <span>HERMENÉUTICA & FILOSOFÍA</span>
          </div>
          <h2 class="font-fraunces font-black uppercase text-2xl sm:text-3xl md:text-4xl text-[#F3EFE6] leading-none">
            Gnosis, Conciencia & Tiempo Sagrado
          </h2>
        </div>
        <p class="font-mono text-xs text-white/50 max-w-md sm:text-right">
          De la transgresión gnóstica de Cárpocrates al silencio del cine y los laberintos circulares de Jorge Luis Borges.
        </p>
      </div>

      <!-- VISOR 2 (IMAX MAX APPLE TV) -->
      <AppleCinemaShowcase
        items={showcaseReel2}
        isImax={true}
        showBottomSection={false}
        minimalist={true}
        actionLabel="Leer Ensayo Rescatado"
        collectionTitle="Gnosis, Conciencia & Tiempo"
      />

    </section>

    <!-- ══════════════════════════════════════════════════════════════════════════
         CALL TO ACTION: CONTINUAR LA INDAGACIÓN EN LA HEMEROTECA
         ══════════════════════════════════════════════════════════════════════════ -->
    <footer class="relative z-10 max-w-4xl mx-auto text-center pt-24 border-t border-white/10 mt-20">
      <h3 class="font-fraunces font-black uppercase text-xl sm:text-2xl text-[#F3EFE6] mb-3">
        ¿Deseas profundizar en las colecciones maestras?
      </h3>
      <p class="font-sans text-sm sm:text-base text-white/60 mb-6 max-w-xl mx-auto">
        Explora los dossiers cinemáticos interactivos, mapas arqueológicos y ensayos de gran porte en nuestras salas activas.
      </p>
      <div class="flex items-center justify-center gap-4 flex-wrap">
        <a
          href="/colecciones/"
          class="px-5 py-2.5 rounded-xl font-mono text-xs uppercase tracking-wider font-bold bg-[#4ef2d2] text-black hover:scale-105 active:scale-95 transition-all shadow-[0_0_20px_rgba(78,242,210,0.3)]"
        >
          Ver Colecciones
        </a>
        <a
          href="/archivo/"
          class="px-5 py-2.5 rounded-xl font-mono text-xs uppercase tracking-wider font-semibold text-white/80 hover:text-white bg-white/5 hover:bg-white/10 border border-white/15 backdrop-blur-md transition-all"
        >
          Archivo General
        </a>
      </div>
    </footer>

    <!-- ══════════════════════════════════════════════════════════════════════════
         MODAL LECTOR MINIMALISTA DE ENSAYOS RESCATADOS
         ══════════════════════════════════════════════════════════════════════════ -->
    <dialog id="boveda-reader-dialog" class="fixed inset-0 z-50 w-full h-full bg-black/90 backdrop-blur-2xl p-4 sm:p-8 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
      <div class="relative w-full max-w-4xl max-h-[90vh] bg-[#0c100d] rounded-2xl sm:rounded-3xl border border-white/15 p-6 sm:p-10 md:p-12 overflow-y-auto shadow-2xl text-white">
        
        <!-- Botón de Cierre Minimalista -->
        <button
          type="button"
          id="btn-close-boveda-modal"
          class="absolute top-5 right-5 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white/70 hover:text-white cursor-pointer transition-all"
          aria-label="Cerrar lectura"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>

        <!-- Cabecera del Lector -->
        <div class="flex items-center gap-3 mb-4">
          <span id="modal-category-badge" class="font-mono text-xs uppercase tracking-widest px-3 py-1 rounded bg-white/10 border border-white/15 text-[#4ef2d2]">
            Categoría
          </span>
          <span id="modal-date-text" class="font-mono text-xs text-white/50">2026</span>
        </div>

        <!-- Título -->
        <h3 id="modal-title-text" class="font-fraunces font-black uppercase text-2xl sm:text-4xl text-[#F3EFE6] leading-tight mb-6">
          Título del Ensayo
        </h3>

        <div class="w-full h-px bg-white/10 mb-6"></div>

        <!-- Cuerpo del Ensayo Formateado -->
        <div id="modal-content-body" class="font-sans text-sm sm:text-base text-zinc-300 leading-relaxed space-y-4 whitespace-pre-line max-w-3xl">
          Contenido del ensayo...
        </div>

        <!-- Pie de Autoría -->
        <footer class="mt-10 pt-6 border-t border-white/10 flex items-center justify-between text-xs text-white/50 font-mono">
          <span>THE GREAT PUZZLE PROJECT · ARCHIVO RECUPERADO</span>
          <span>AUTOR: XAVIER BENÍTEZ</span>
        </footer>

      </div>
    </dialog>

  </main>

  <!-- DATA RESGUARDADA PARA EL MODAL LECTOR (SERIALIZADA DE FORMA SEGURA) -->
  <script type="application/json" id="boveda-posts-json" set:html={JSON.stringify(allRecoveredPosts)}></script>

  <script>
    function setupBovedaReader() {
      const dialog = document.getElementById('boveda-reader-dialog') as HTMLDialogElement | null;
      const closeBtn = document.getElementById('btn-close-boveda-modal');
      const titleEl = document.getElementById('modal-title-text');
      const catEl = document.getElementById('modal-category-badge');
      const dateEl = document.getElementById('modal-date-text');
      const bodyEl = document.getElementById('modal-content-body');
      const jsonEl = document.getElementById('boveda-posts-json');

      if (!dialog) return;

      let posts: any[] = [];
      try {
        if (jsonEl && jsonEl.textContent) {
          posts = JSON.parse(jsonEl.textContent);
        }
      } catch (err) {
        console.error('Error parseando datos de boveda:', err);
      }

      function openReader(postId: string) {
        const found = posts.find((p: any) => p.id === postId);
        if (!found) return;

        if (titleEl) titleEl.textContent = found.title;
        if (catEl) catEl.textContent = found.category || 'Archivo Recuperado';
        if (dateEl) dateEl.textContent = found.date ? String(found.date) : '2026';
        if (bodyEl) bodyEl.textContent = found.fullText || found.excerpt || '';

        dialog?.classList.remove('opacity-0', 'pointer-events-none');
        dialog?.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
      }

      function closeReader() {
        dialog?.classList.add('opacity-0', 'pointer-events-none');
        dialog?.classList.remove('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = '';
      }

      closeBtn?.addEventListener('click', closeReader);
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) closeReader();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeReader();
      });

      // Delegación de clics en botones de acción con data-open-modal
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('[data-open-modal]');
        if (!target) return;
        const modalId = target.getAttribute('data-open-modal');
        if (modalId) {
          e.preventDefault();
          openReader(modalId);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupBovedaReader);
    } else {
      setupBovedaReader();
    }
    document.addEventListener('astro:page-load', setupBovedaReader);
  </script>
</Layout>
