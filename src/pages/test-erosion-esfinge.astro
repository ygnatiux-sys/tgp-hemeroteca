---
import Layout from "../layouts/Layout.astro";
import PluvialHero from "../components/PluvialHero.astro";
import img from "../assets/alternativa/esfinge-erosion.jpg";

export const prerender = true;
---

<Layout
  title="Laboratorio: Erosión Pluvial (La Cicatriz del Agua) — GIZA | TGP"
  description="Prueba cinemática de la erosión por agua en el recinto de la Esfinge de Giza con cascada vertical GSAP, polvo de caliza y paleta Ocre Atardecer."
  headerTransparentUntilScroll={true}
  footerVariant="minimal"
  bodyClass="bg-[#141210]"
>
  <PluvialHero
    image={img}
    word="LA CICATRIZ DEL AGUA"
    subtitle="La geología que reescribe la cronología humana"
    speed={1}
    showHud={true}
    hudLabel="Erosión Pluvial · Giza"
  />
</Layout>
