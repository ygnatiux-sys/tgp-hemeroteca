    <title>TGP R2 Staging · Conversor & Subida R2</title>
    <link rel="icon" type="image/webp" href="/images/favicon.TGP.webp" />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="antialiased overflow-x-hidden min-h-screen">
    <VisualLaboratory client:only="svelte" />
  </body>
</html>

<style is:global>
  .picker-dialog-bg {
    z-index: 99998 !important;
    position: fixed !important;
  }
  .picker-dialog {
    z-index: 99999 !important;
    position: fixed !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
  }
</style>
