---
/**
 * src/pages/papers/[slug].astro — Entorno de lectura tipo Medium (TGP)
 *
 * Layout 3-columnas Desktop:
 *   TOC archipiélago (izq.) | Contenido max-w-2xl (centro) | Contexto sticky (der.)
 *
 * Zonas de blancos:
 *   - Página principal:   --white-page  (#FAFAF9)
 *   - Cabecera del paper: --white-broken (#F5F2ED) con borde inferior sutil
 *   - Sección "Autor":    --white-bone  (#EDE9E1)
 *   - Tags/TOC:           --white-ice   (#F8F8F7) al hover
 */

import { getCollection, getEntry, render } from "astro:content";
import { marked } from "marked";
import AcademicLayout from "../../layouts/AcademicLayout.astro";
import {
  resolveEssayImage,
  essayImages,
  formatCategory,
  formatDate,
  getPublishableEssays,
} from "../../lib/content-filter";

export const prerender = true;

export async function getStaticPaths() {
  const essays     = await getCollection("ensayos").catch(() => []);
  const georefs    = await getCollection("georreferencias").catch(() => []);
  const arquetipos = await getCollection("arquetiposGlobales").catch(() => []);
  const combined   = [...essays, ...georefs, ...arquetipos];

  return combined.map((item) => ({
    params: { slug: item.id.replace(/\/index$/, "") },
    props:  { data: item.data, collectionId: item.id },
  }));
}

// ─── DATOS DE LA RUTA ────────────────────────────────────────────────────────
const { slug }  = Astro.params;
const { data }  = Astro.props;
const doc       = data as any;

// ─── CONTENIDO MARKDOC (.mdoc) ───────────────────────────────────────────────
const rawMdocs = import.meta.glob<string>(
  [
    "/src/content/ensayos/**/content.mdoc",
    "/src/content/georreferencias/**/content.mdoc",
    "/src/content/arquetipos-globales/**/content.mdoc",
  ],
  { query: "?raw", import: "default", eager: true }
);

const mdocKey          = `/src/content/ensayos/${slug}/content.mdoc`;
const georefMdocKey    = `/src/content/georreferencias/${slug}/content.mdoc`;
const arquetipoMdocKey = `/src/content/arquetipos-globales/${slug}/content.mdoc`;

const rawMdocText =
  rawMdocs[mdocKey] ||
  rawMdocs[georefMdocKey] ||
  rawMdocs[arquetipoMdocKey] ||
  "";

let Content: any = null;
const hasRealMdoc = rawMdocText && rawMdocText.trim().length > 10;

if (hasRealMdoc) {
  try {
    const col =
      mdocKey in rawMdocs ? "ensayosContent" :
      georefMdocKey in rawMdocs ? "georreferenciasContent" :
      "arquetiposGlobalesContent";
    const entry = await getEntry(col as any, `${slug}/content`);
    if (entry) { const r = await render(entry); Content = r.Content; }
  } catch (_) {}
}

// ─── FALLBACK: marked ────────────────────────────────────────────────────────
let renderedHtml = "";
if (!Content) {
  let raw = hasRealMdoc ? rawMdocText.trim()
    : doc.generadorGeoref?.trim() || doc.generadorTexto?.trim() || doc.generador?.trim() || "";

  if (raw.startsWith("{") && (raw.includes('"informeMarkdown"') || raw.includes('"content"'))) {
    try {
      const p = JSON.parse(raw);
      raw = p.informeMarkdown || p.content || raw;
    } catch {
      const m = raw.match(/"(?:informeMarkdown|content)"\s*:\s*"([\s\S]*?)"(?=\s*,\s*"|\s*})/);
      if (m) raw = m[1].replace(/\\n/g, "\n").replace(/\\"/g, '"');
    }
  }
  if (raw) {
    renderedHtml = marked.parse(raw) as string;
    for (const [k, mod] of Object.entries(essayImages)) {
      if (renderedHtml.includes(k)) renderedHtml = renderedHtml.replaceAll(k, (mod as any).default.src);
    }
  }
}

// ─── METADATOS ───────────────────────────────────────────────────────────────
const title        = doc.title || slug?.replace(/-/g, " ") || "Paper";
const category     = formatCategory(doc.category);
const dateStr      = doc.date ? formatDate(doc.date) : null;
const excerpt      = doc.excerpt || null;
const optimizedImg = resolveEssayImage(doc.coverImage, slug);
const hasContent   = !!Content || !!renderedHtml;

// ─── POSTS RELACIONADOS (misma categoría del autor) ──────────────────────────
const allEssaysRaw = await getCollection("ensayos").catch(() => []);
const publishable  = getPublishableEssays(allEssaysRaw, import.meta.env.PROD);
const relatedPosts = publishable
  .filter(p => p.slug !== slug)
  .filter(p => {
    if (doc.category) {
      return (p.entry.category || "").toLowerCase().trim() ===
             (doc.category || "").toLowerCase().trim();
    }
    return true;
  })
  .slice(0, 4);

const pageTitle = `${title} — Papers · TGP`;
---

<AcademicLayout title={pageTitle} description={excerpt ?? undefined} slug={slug}>

  <!-- ═══════════════════════════════════════════════════════════════
       ZONA 1: CABECERA DEL PAPER — fondo roto (#F5F2ED)
       Separación muy sutil de la zona de lectura
  ══════════════════════════════════════════════════════════════════ -->
  <section class="paper-hero-zone">
    <div class="paper-hero-inner">
      {category && <p class="paper-kicker">{category}</p>}
      <h1 class="paper-title">{title}</h1>
      {excerpt && <p class="paper-deck">{excerpt}</p>}
      
      <!-- Firma del autor e Interacciones — estilo Medium -->
      <div class="paper-author-and-actions">
        <div class="paper-author-row">
          <a href="/papers/perfil" class="paper-author-avatar-link" aria-label="Perfil de Xavier Benítez">
            <img src="/perfil.webp" alt="Xavier Benítez" class="paper-author-avatar" />
          </a>
          <div class="paper-author-info">
            <a href="/papers/perfil" class="paper-author-name-link">
              <span class="paper-author-name">Xavier Benítez | TGP Project</span>
            </a>
            <div class="paper-author-meta">
              {dateStr && <time datetime={doc.date ?? ""}>{dateStr}</time>}
              {dateStr && <span class="meta-sep" aria-hidden="true">·</span>}
              <span id="reading-time-inline">Calculando...</span>
            </div>
          </div>
        </div>

        <div class="paper-action-bar">
          <div class="action-left">
            <button class="action-btn" aria-label="Claps">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 20H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h5"/><path d="M10 11.5a1.5 1.5 0 0 0 1.5-1.5 2 2 0 0 1 2-2h1.5a1 1 0 0 0 1-1V5.5a2 2 0 0 1 2-2h.5a2 2 0 0 1 2 2v10.5a6 6 0 0 1-6 6h-1.5a2 2 0 0 1-2-2v-4.5Z"/></svg>
              <span>135</span>
            </button>
            <button class="action-btn" aria-label="Comentarios">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              <span>1</span>
            </button>
          </div>
          <div class="action-right">
            <button class="action-btn" aria-label="Añadir a la biblioteca">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
            </button>
            <button class="action-btn" aria-label="Compartir">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
            </button>
            <button class="action-btn" aria-label="Más opciones">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       ZONA 2: IMAGEN DE PORTADA — span completo al ancho del contenido
  ══════════════════════════════════════════════════════════════════ -->
  {optimizedImg && (
    <div class="paper-cover-zone">
      <figure class="paper-cover-figure">
        <img
          src={optimizedImg.src}
          width={optimizedImg.width}
          height={optimizedImg.height}
          alt={`Imagen de portada: ${title}`}
          class="paper-cover-img"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  )}

  <!-- ═══════════════════════════════════════════════════════════════
       ZONA 3: ÁREA DE LECTURA — Grid 3 columnas
  ══════════════════════════════════════════════════════════════════ -->
  <div class="paper-reading-zone">
    
    <!-- ═══ COLUMNA TOC (Izquierda — "Archipiélago") ═══ -->
    <aside class="paper-sidebar-toc" aria-label="Tabla de Contenidos">
      <div class="toc-wrapper">
        <p class="toc-label">En este paper</p>
        <!-- Tags tipo archipiélago: generados dinámicamente por JS -->
        <nav id="toc-archipelago" class="toc-archipelago" role="navigation" aria-label="Secciones"></nav>
      </div>
    </aside>

    <!-- ═══ CUERPO DEL ENSAYO (Centro) ═══ -->
    <article class="academic-prose paper-main-col" id="paper-content">
      <div class="paper-body prose" id="paper-body">
        {hasContent ? (
          Content ? <Content /> : <Fragment set:html={renderedHtml} />
        ) : (
          <p class="paper-empty">Este ensayo no tiene contenido disponible todavía.</p>
        )}
      </div>
    </article>

    <!-- ═══ COLUMNA CONTEXTO (Derecha) ═══ -->
    <aside class="paper-sidebar-context" aria-label="Metadatos del paper">
      <div class="context-wrapper">
        <h4 class="context-section-label">Sobre este archivo</h4>
        <dl class="context-meta-list">
          <div class="meta-item">
            <dt>Categoría</dt>
            <dd>{category}</dd>
          </div>
          {dateStr && (
            <div class="meta-item">
              <dt>Publicación</dt>
              <dd><time datetime={doc.date ?? ""}>{dateStr}</time></dd>
            </div>
          )}
          <div class="meta-item">
            <dt>Autoría</dt>
            <dd>TGP · Archivo Epistémico</dd>
          </div>
          <div class="meta-item">
            <dt>Lectura est.</dt>
            <dd id="reading-time-sidebar">—</dd>
          </div>
        </dl>

        <hr class="context-divider" />

        <a href={`/hemeroteca/${slug}`} class="context-hemeroteca-link">
          Ver en Hemeroteca ↗
        </a>
      </div>
    </aside>

  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       ZONA 4: TAGS (archipiélago de categorías) — fondo hueso medio
  ══════════════════════════════════════════════════════════════════ -->
  {category && (
    <section class="paper-tags-zone">
      <div class="paper-tags-inner">
        <span class="tag-pill tag-pill--primary">{category}</span>
        <span class="tag-pill">Epistémica</span>
        <span class="tag-pill">The Great Puzzle Project</span>
        <span class="tag-pill">Archivo</span>
      </div>
    </section>
  )}

  <!-- ZONA 5: BLOQUE AUTOR — Xavier Benítez | TGP Project -->
  <section class="paper-author-zone">
    <div class="paper-author-card">
      <a href="/papers/perfil" class="author-card-avatar-link">
        <img src="/perfil.webp" alt="Xavier Benítez" class="author-card-avatar" />
      </a>
      <div class="author-card-body">
        <p class="author-card-written-by">Escrito por</p>
        <a href="/papers/perfil" class="author-card-name-link">
          <h3 class="author-card-name">Xavier Benítez | TGP Project</h3>
        </a>
        <div class="author-card-stats">
          <span>0 seguidores</span>
          <span class="meta-sep">·</span>
          <span>1 seguido</span>
        </div>
        <p class="author-card-bio">
          Profesor &amp; Historiador. Investigando las piezas ocultas de nuestro pasado
          para comprender la condición humana. Arqueología del sentido en TGP Project.
        </p>
        <div class="author-card-actions">
          <a href="/papers/perfil" class="btn-follow">Ver perfil</a>
          <a href="/papers/historias" class="btn-follow btn-follow--ghost">Historias</a>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════
       ZONA 6: MÁS PAPERS DEL MISMO AUTOR / CATEGORÍA
       Fondo blanco-página para no romper el ritmo
  ══════════════════════════════════════════════════════════════════ -->
  {relatedPosts.length > 0 && (
    <section class="paper-more-zone">
      <div class="paper-more-inner">
        <h2 class="more-section-title">Más del archivo epistémico</h2>
        <div class="more-grid">
          {relatedPosts.map((post) => {
            const postImg = resolveEssayImage(post.entry.coverImage, post.slug);
            const postDate = post.entry.date ? formatDate(post.entry.date) : null;
            return (
              <a href={`/papers/${post.slug}`} class="more-card">
                {postImg && (
                  <div class="more-card-img-wrap">
                    <img
                      src={postImg.src}
                      alt={post.entry.title || post.slug}
                      class="more-card-img"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="more-card-body">
                  <p class="more-card-meta">
                    TGP
                    {postDate && <span class="meta-sep">·</span>}
                    {postDate && <time>{postDate}</time>}
                  </p>
                  <h3 class="more-card-title">{post.entry.title}</h3>
                  {post.entry.excerpt && (
                    <p class="more-card-excerpt">{post.entry.excerpt}</p>
                  )}
                  <span class="more-card-cta">Leer paper →</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Nav pie de artículo enriquecido -->
  <nav class="paper-footer-rich-nav" aria-label="Navegación de artículo">
    <div class="footer-rich-inner">
      <a href="/papers" class="btn-rich-ghost">
        ← Volver al Índice
      </a>
      <a href="/archivo" class="btn-rich-primary">
        Explorar Archivo Completo →
      </a>
    </div>
  </nav>

</AcademicLayout>

<!-- ──────────────────────────────────────────────────────────────────
  Script cliente: TOC Archipiélago + Scrollspy + Tiempo de lectura
  Vanilla JS — sin dependencias externas.
────────────────────────────────────────────────────────────────── -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const body  = document.getElementById("paper-body");
    const rtInline  = document.getElementById("reading-time-inline");
    const rtSidebar = document.getElementById("reading-time-sidebar");
    const tocEl     = document.getElementById("toc-archipelago");

    if (!body) return;

    // 1. Tiempo de lectura
    const wordCount = (body.textContent || "").trim().split(/\s+/).length;
    const mins      = Math.max(1, Math.ceil(wordCount / 225));
    const rtText    = `${mins} min de lectura`;
    if (rtInline)  rtInline.textContent  = rtText;
    if (rtSidebar) rtSidebar.textContent = rtText;

    // 2. TOC Archipiélago
    if (tocEl) {
      const headings = Array.from(body.querySelectorAll("h2, h3"));

      if (headings.length === 0) {
        tocEl.innerHTML = '<span class="toc-empty">Sin secciones</span>';
      } else {
        // Asignar IDs semánticos si no los tienen
        headings.forEach((h, i) => {
          if (!h.id) {
            h.id = `s${i}-${(h.textContent || "")
              .trim()
              .toLowerCase()
              .replace(/\s+/g, "-")
              .replace(/[^a-z0-9-]/g, "")
              .slice(0, 40)}`;
          }
        });

        // Crear botones-píldora tipo archipiélago
        const fragment = document.createDocumentFragment();
        headings.forEach((h) => {
          const btn = document.createElement("a");
          btn.href        = `#${h.id}`;
          btn.className   = `toc-pill toc-${h.tagName.toLowerCase()}`;
          btn.textContent = h.textContent || "";
          btn.setAttribute("data-heading-id", h.id);

          // Smooth scroll
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            document.getElementById(h.id)?.scrollIntoView({
              behavior: "smooth",
              block: "start"
            });
          });

          fragment.appendChild(btn);
        });
        tocEl.appendChild(fragment);

        // 3. Scrollspy con IntersectionObserver
        const pills: NodeListOf<HTMLElement> = document.querySelectorAll(".toc-pill");

        const markActive = (id: string) => {
          pills.forEach(p => {
            p.classList.toggle("active", p.dataset.headingId === id);
          });
        };

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) markActive(entry.target.id);
            });
          },
          { rootMargin: "-5% 0px -80% 0px", threshold: 0 }
        );

        headings.forEach(h => observer.observe(h));
      }
    }
  });
</script>

<style is:global>

  /* ═══════════════════════════════════════════════════════════════════
     ZONA 1 — CABECERA DEL PAPER
     Fondo ligeramente roto para separación visual suave
  ═══════════════════════════════════════════════════════════════════ */
  .paper-hero-zone {
    background-color: var(--white-broken, #F5F2ED);
    border-bottom: 1px solid var(--white-silver, #E4E1DB);
    padding: 4rem 1.5rem 3rem;
  }

  .paper-hero-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .paper-kicker {
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ac-gold, #8C6D2F);
    margin: 0 0 1.1rem;
  }

  .paper-title {
    font-family: var(--font-editorial, 'Cormorant Garamond', serif);
    font-size: clamp(2rem, 5vw + 0.8rem, 3.6rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ac-text, #191918);
    margin: 0 0 1.2rem;
    background: none;
    -webkit-text-fill-color: unset;
  }

  .paper-deck {
    font-family: var(--font-editorial, 'Cormorant Garamond', serif);
    font-size: clamp(1.05rem, 1.8vw + 0.5rem, 1.3rem);
    font-style: italic;
    color: var(--ac-text-muted, #575043);
    line-height: 1.55;
    margin: 0 0 2rem;
  }

  /* Fila del autor (estilo Medium) */
  .paper-author-and-actions {
    display: flex;
    flex-direction: column;
    padding-top: 0.25rem;
  }
  .paper-author-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
  }

  .paper-author-avatar {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background-color: var(--ac-accent, #3B2A14);
    color: var(--white-page, #FAFAF9);
    font-family: var(--font-editorial, serif);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    object-fit: cover;
  }

  /* Barra de interacciones (Medium) */
  .paper-action-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 0;
    border-top: 1px solid var(--white-silver, #E4E1DB);
    border-bottom: 1px solid var(--white-silver, #E4E1DB);
    margin-bottom: 0.5rem;
  }
  .action-left, .action-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .action-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--ac-text-soft, #8A8278);
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.8rem;
    transition: color 0.15s ease;
  }
  .action-btn:hover {
    color: var(--ac-text, #191918);
  }
  .action-btn svg {
    stroke-width: 1.2;
    transition: stroke 0.15s ease;
  }

  .paper-author-name {
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ac-text, #191918);
    display: block;
  }

  .paper-author-meta {
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.78rem;
    color: var(--ac-text-soft, #8A8278);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta-sep { opacity: 0.5; }

  /* ═══════════════════════════════════════════════════════════════════
     ZONA 2 — IMAGEN DE PORTADA
     Sangre controlada al ancho máximo del contenido central
  ═══════════════════════════════════════════════════════════════════ */
  .paper-cover-zone {
    padding: 2rem 1.5rem;
    background-color: var(--white-page, #FAFAF9);
    max-width: calc(680px + 3rem);
    margin: 0 auto;
  }

  .paper-cover-figure {
    margin: 0;
    padding: 0;
  }

  .paper-cover-img {
    width: 100%;
    height: auto;
    max-height: 26rem;
    object-fit: cover;
    border-radius: 3px;
    display: block;
    /* Sombra editorial sobria — sin efectos cinemáticos */
    box-shadow: 0 1px 8px rgba(30,25,15,0.08);
  }

  /* ═══════════════════════════════════════════════════════════════════
     ZONA 3 — ÁREA DE LECTURA (Grid 3 columnas)
  ═══════════════════════════════════════════════════════════════════ */
  .paper-reading-zone {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 680px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;
    gap: 0;
  }

  /* En desktop, 3 columnas: TOC | Contenido | Contexto */
  @media (min-width: 1100px) {
    .paper-reading-zone {
      grid-template-columns: 200px minmax(auto, 680px) 200px;
      max-width: 1200px;
      padding: 3.5rem 2rem 0;
