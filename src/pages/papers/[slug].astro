<!-- ──────────────────────────────────────────────────────────────────
  Script cliente: TOC Archipiélago + Scrollspy + Tiempo de lectura
  Vanilla JS — sin dependencias externas.
────────────────────────────────────────────────────────────────── -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const body  = document.getElementById("paper-body");
    const rtInline  = document.getElementById("reading-time-inline");
    const rtSidebar = document.getElementById("reading-time-sidebar");
    const tocEl     = document.getElementById("toc-archipelago");

    if (!body) return;

    // 1. Tiempo de lectura
    const wordCount = (body.textContent || "").trim().split(/\s+/).length;
    const mins      = Math.max(1, Math.ceil(wordCount / 225));
    const rtText    = `${mins} min de lectura`;
    if (rtInline)  rtInline.textContent  = rtText;
    if (rtSidebar) rtSidebar.textContent = rtText;

    // 2. TOC Archipiélago
    if (tocEl) {
      const headings = Array.from(body.querySelectorAll("h2, h3"));

      if (headings.length === 0) {
        tocEl.innerHTML = '<span class="toc-empty">Sin secciones</span>';
      } else {
        // Asignar IDs semánticos si no los tienen
        headings.forEach((h, i) => {
          if (!h.id) {
            h.id = `s${i}-${(h.textContent || "")
              .trim()
              .toLowerCase()
              .replace(/\s+/g, "-")
              .replace(/[^a-z0-9-]/g, "")
              .slice(0, 40)}`;
          }
        });

        // Crear botones-píldora tipo archipiélago
        const fragment = document.createDocumentFragment();
        headings.forEach((h) => {
          const btn = document.createElement("a");
          btn.href        = `#${h.id}`;
          btn.className   = `toc-pill toc-${h.tagName.toLowerCase()}`;
          btn.textContent = h.textContent || "";
          btn.setAttribute("data-heading-id", h.id);

          // Smooth scroll
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            document.getElementById(h.id)?.scrollIntoView({
              behavior: "smooth",
              block: "start"
            });
          });

          fragment.appendChild(btn);
        });
        tocEl.appendChild(fragment);

        // 3. Scrollspy con IntersectionObserver
        const pills: NodeListOf<HTMLElement> = document.querySelectorAll(".toc-pill");

        const markActive = (id: string) => {
          pills.forEach(p => {
            p.classList.toggle("active", p.dataset.headingId === id);
          });
        };

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) markActive(entry.target.id);
            });
          },
          { rootMargin: "-5% 0px -80% 0px", threshold: 0 }
        );

        headings.forEach(h => observer.observe(h));
      }
    }

    // 4. Interacciones de la barra de acciones (Claps, Bookmark, Popover ... y Modal)
    const likeBtns = document.querySelectorAll(".btn-like");
    const bookmarkBtns = document.querySelectorAll(".btn-bookmark");
    const moreBtns = document.querySelectorAll(".btn-more");
    const subscribeTriggers = document.querySelectorAll(".trigger-subscribe");
    const modal = document.getElementById("tgp-subscribe-modal");
    const modalClose = modal?.querySelector(".tgp-modal-close");

    // Like / Claps toggle con localStorage
    likeBtns.forEach(btn => {
      const slug = btn.getAttribute("data-slug");
      if (!slug) return;
      const countEl = btn.querySelector(".like-count");
      const baseLikes = parseInt(countEl?.textContent || "135", 10);
      const isLiked = localStorage.getItem(`tgp_like_${slug}`) === "true";

      if (isLiked) {
        btn.classList.add("active");
        if (countEl) countEl.textContent = String(baseLikes + 1);
      }

      btn.addEventListener("click", () => {
        const currentlyLiked = btn.classList.contains("active");
        if (currentlyLiked) {
          btn.classList.remove("active");
          localStorage.setItem(`tgp_like_${slug}`, "false");
          if (countEl) countEl.textContent = String(baseLikes);
        } else {
          btn.classList.add("active");
          localStorage.setItem(`tgp_like_${slug}`, "true");
          if (countEl) countEl.textContent = String(baseLikes + 1);
        }
      });
    });

    // Bookmark toggle con localStorage
    bookmarkBtns.forEach(btn => {
      const slug = btn.getAttribute("data-slug");
      if (!slug) return;
      const isBookmarked = localStorage.getItem(`tgp_bookmark_${slug}`) === "true";
      if (isBookmarked) btn.classList.add("active");

      btn.addEventListener("click", () => {
        const currentlyBookmarked = btn.classList.contains("active");
        if (currentlyBookmarked) {
          btn.classList.remove("active");
          localStorage.setItem(`tgp_bookmark_${slug}`, "false");
        } else {
          btn.classList.add("active");
          localStorage.setItem(`tgp_bookmark_${slug}`, "true");
        }
      });
    });

    // Menú desplegable ...
    moreBtns.forEach(btn => {
      const wrapper = btn.closest(".action-more-wrapper");
      const menu = wrapper?.querySelector(".paper-more-menu");
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        menu?.classList.toggle("open");
      });
    });

    document.addEventListener("click", () => {
      document.querySelectorAll(".paper-more-menu").forEach(m => m.classList.remove("open"));
    });

    // Modal de suscripción / reacción con transición de 4s
    let sliderInterval: ReturnType<typeof setInterval> | undefined;
    const openModal = () => {
      modal?.classList.add("open");
      modal?.setAttribute("aria-hidden", "false");
      
      const box = modal?.querySelector(".tgp-modal-box");
      const slideEs = modal?.querySelector(".slide-es");
      const slideEn = modal?.querySelector(".slide-en");
      let isEs = true;
      
      clearInterval(sliderInterval);
      
      // Estado inicial (ES Grafito)
      box?.classList.remove("tgp-modal-box--english");
      slideEs?.classList.add("active");
      slideEn?.classList.remove("active");
      
      sliderInterval = setInterval(() => {
        isEs = !isEs;
        if (isEs) {
          box?.classList.remove("tgp-modal-box--english");
          slideEn?.classList.remove("active");
          slideEs?.classList.add("active");
        } else {
          box?.classList.add("tgp-modal-box--english");
          slideEs?.classList.remove("active");
          slideEn?.classList.add("active");
        }
      }, 4000);
    };
    
    const closeModal = () => {
      modal?.classList.remove("open");
      modal?.setAttribute("aria-hidden", "true");
      clearInterval(sliderInterval);
    };

    subscribeTriggers.forEach(trigger => {
      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        openModal();
      });
    });

    modalClose?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
  });
</script>

