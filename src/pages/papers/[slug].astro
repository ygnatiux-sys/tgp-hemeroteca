---
/**
 * src/pages/papers/[slug].astro — Entorno de lectura tipo Medium (TGP)
 *
 * Layout 3-columnas Desktop:
 *   TOC archipiélago (izq.) | Contenido max-w-2xl (centro) | Contexto sticky (der.)
 *
 * Zonas de blancos:
 *   - Página principal:   --white-page  (#FAFAF9)
 *   - Cabecera del paper: --white-broken (#F5F2ED) con borde inferior sutil
 *   - Sección "Autor":    --white-bone  (#EDE9E1)
 *   - Tags/TOC:           --white-ice   (#F8F8F7) al hover
 */

import { getCollection, getEntry, render } from "astro:content";
import { marked } from "marked";
import AcademicLayout from "../../layouts/AcademicLayout.astro";
import { QuickReturnButton } from "../../components/QuickReturnButton";
import {
  resolveEssayImage,
  essayImages,
  formatCategory,
  formatDate,
  getPublishableEssays,
} from "../../lib/content-filter";

export const prerender = true;

export async function getStaticPaths() {
  const essays     = await getCollection("ensayos").catch(() => []);
  const georefs    = await getCollection("georreferencias").catch(() => []);
  const arquetipos = await getCollection("arquetiposGlobales").catch(() => []);
  const combined   = [...essays, ...georefs, ...arquetipos];

  return combined.map((item) => ({
    params: { slug: item.id.replace(/\/index$/, "") },
    props:  { data: item.data, collectionId: item.id },
  }));
}

// ─── DATOS DE LA RUTA ────────────────────────────────────────────────────────
const { slug }  = Astro.params;
const { data }  = Astro.props;
const doc       = data as any;

// ─── CONTENIDO MARKDOC (.mdoc) ───────────────────────────────────────────────
const rawMdocs = import.meta.glob<string>(
  [
    "/src/content/ensayos/**/content.mdoc",
    "/src/content/georreferencias/**/content.mdoc",
    "/src/content/arquetipos-globales/**/content.mdoc",
  ],
  { query: "?raw", import: "default", eager: true }
);

const mdocKey          = `/src/content/ensayos/${slug}/content.mdoc`;
const georefMdocKey    = `/src/content/georreferencias/${slug}/content.mdoc`;
const arquetipoMdocKey = `/src/content/arquetipos-globales/${slug}/content.mdoc`;

const rawMdocText =
  rawMdocs[mdocKey] ||
  rawMdocs[georefMdocKey] ||
  rawMdocs[arquetipoMdocKey] ||
  "";

let Content: any = null;
const hasRealMdoc = rawMdocText && rawMdocText.trim().length > 10;

if (hasRealMdoc) {
  try {
    const col =
      mdocKey in rawMdocs ? "ensayosContent" :
      georefMdocKey in rawMdocs ? "georreferenciasContent" :
      "arquetiposGlobalesContent";
    const entry = await getEntry(col as any, `${slug}/content`);
    if (entry) { const r = await render(entry); Content = r.Content; }
  } catch (_) {}
}

// ─── FALLBACK: marked ────────────────────────────────────────────────────────
let renderedHtml = "";
if (!Content) {
  let raw = hasRealMdoc ? rawMdocText.trim()
    : doc.generadorGeoref?.trim() || doc.generadorTexto?.trim() || doc.generador?.trim() || "";

  if (raw.startsWith("{") && (raw.includes('"informeMarkdown"') || raw.includes('"content"'))) {
    try {
      const p = JSON.parse(raw);
      raw = p.informeMarkdown || p.content || raw;
    } catch {
      const m = raw.match(/"(?:informeMarkdown|content)"\s*:\s*"([\s\S]*?)"(?=\s*,\s*"|\s*})/);
      if (m) raw = m[1].replace(/\\n/g, "\n").replace(/\\"/g, '"');
    }
  }
  if (raw) {
    renderedHtml = marked.parse(raw) as string;
    for (const [k, mod] of Object.entries(essayImages)) {
      if (renderedHtml.includes(k)) renderedHtml = renderedHtml.replaceAll(k, (mod as any).default.src);
    }
  }
}

// ─── METADATOS ───────────────────────────────────────────────────────────────
const title        = doc.title || slug?.replace(/-/g, " ") || "Paper";
const category     = formatCategory(doc.category);
const dateStr      = doc.date ? formatDate(doc.date) : null;
const excerpt      = doc.excerpt || null;
const optimizedImg = resolveEssayImage(doc.coverImage, slug);
const hasContent   = !!Content || !!renderedHtml;

// ─── POSTS RELACIONADOS (misma categoría del autor) ──────────────────────────
const allEssaysRaw = await getCollection("ensayos").catch(() => []);
const publishable  = getPublishableEssays(allEssaysRaw, import.meta.env.PROD);
const relatedPosts = publishable
  .filter(p => p.slug !== slug)
  .filter(p => {
    if (doc.category) {
      return (p.entry.category || "").toLowerCase().trim() ===
             (doc.category || "").toLowerCase().trim();
    }
    return true;
  })
  .slice(0, 4);

const pageTitle = `${title} — Papers · TGP`;
---

<AcademicLayout title={pageTitle} description={excerpt ?? undefined} slug={slug}>
  <QuickReturnButton client:only="react" variant="papers" accentColor="#EFEBE3" fallbackUrl="/papers" />

  <!-- ═══════════════════════════════════════════════════════════════
       ZONA 1: CABECERA DEL PAPER — fondo roto (#F5F2ED)
       Separación muy sutil de la zona de lectura
  ══════════════════════════════════════════════════════════════════ -->
  <section class="paper-hero-zone">
    <div class="paper-hero-inner">
      {category && <p class="paper-kicker">{category}</p>}
      <h1 class="paper-title">{title}</h1>
      {excerpt && <p class="paper-deck">{excerpt}</p>}
      
      <!-- Firma del autor e Interacciones — estilo Medium -->
      <div class="paper-author-and-actions">
        <div class="paper-author-row">
          <a href="/papers/perfil" class="paper-author-avatar-link" aria-label="Perfil de Xavier Benítez">
            <img src="/perfil.webp" alt="Xavier Benítez" class="paper-author-avatar" />
          </a>
          <div class="paper-author-info">
            <a href="/papers/perfil" class="paper-author-name-link">
              <span class="paper-author-name">Xavier Benítez | TGP Project</span>
            </a>
            <div class="paper-author-meta">
              {dateStr && <time datetime={doc.date ?? ""}>{dateStr}</time>}
              {dateStr && <span class="meta-sep" aria-hidden="true">·</span>}
              <span id="reading-time-inline">Calculando...</span>
            </div>
          </div>
        </div>

        <div class="paper-action-bar">
          <div class="action-left">
            <!-- Claps / Me gusta -->
            <button class="action-btn btn-like" data-slug={slug} aria-label="Claps">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="action-icon icon-clap"><path d="M10 20H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h5"/><path d="M10 11.5a1.5 1.5 0 0 0 1.5-1.5 2 2 0 0 1 2-2h1.5a1 1 0 0 0 1-1V5.5a2 2 0 0 1 2-2h.5a2 2 0 0 1 2 2v10.5a6 6 0 0 1-6 6h-1.5a2 2 0 0 1-2-2v-4.5Z"/></svg>
              <span class="like-count">135</span>
            </button>
            <!-- Comentarios -->
            <button class="action-btn btn-comment trigger-subscribe" aria-label="Comentarios">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              <span>1</span>
            </button>
            <!-- Repost -->
            <button class="action-btn btn-repost trigger-subscribe" aria-label="Republicar">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/></svg>
            </button>
          </div>
          <div class="action-right">
            <!-- Bookmark / Biblioteca -->
            <button class="action-btn btn-bookmark" data-slug={slug} aria-label="Añadir a la biblioteca">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="action-icon icon-bookmark"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
            </button>
            <!-- Audio -->
            <button class="action-btn btn-audio trigger-subscribe" aria-label="Escuchar artículo">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            </button>
            <!-- Compartir -->
            <button class="action-btn btn-share" aria-label="Compartir">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            </button>
            <!-- Menú desplegable ... -->
            <div class="action-more-wrapper">
              <button class="action-btn btn-more" aria-label="Más opciones" aria-expanded="false">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
              </button>
              <div class="paper-more-menu" role="menu">
                <button class="menu-item trigger-subscribe" role="menuitem">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h2.67A2.31 2.31 0 0 1 22 4.3v7a2.31 2.31 0 0 1-2.33 2.3H17"/></svg>
                  <span>Mostrar menos como esto</span>
                </button>
                <div class="menu-divider"></div>
                <button class="menu-item trigger-subscribe" role="menuitem">
                  <span>Seguir autor (Xavier Benítez)</span>
                </button>
                <button class="menu-item trigger-subscribe" role="menuitem">
                  <span>Seguir publicación (TGP Papers)</span>
                </button>
                <div class="menu-divider"></div>
                <button class="menu-item trigger-subscribe" role="menuitem">
                  <span>Silenciar autor</span>
                </button>
                <button class="menu-item trigger-subscribe" role="menuitem">
                  <span>Silenciar publicación</span>
                </button>
                <button class="menu-item trigger-subscribe danger" role="menuitem">
                  <span>Reportar paper...</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       ZONA 2: IMAGEN DE PORTADA — span completo al ancho del contenido
  ══════════════════════════════════════════════════════════════════ -->
  {optimizedImg && (
    <div class="paper-cover-zone">
      <figure class="paper-cover-figure">
        <img
          src={optimizedImg.src}
          width={optimizedImg.width}
          height={optimizedImg.height}
          alt={`Imagen de portada: ${title}`}
          class="paper-cover-img"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  )}

  <!-- ═══════════════════════════════════════════════════════════════
       ZONA 3: ÁREA DE LECTURA — Grid 3 columnas
  ══════════════════════════════════════════════════════════════════ -->
  <div class="paper-reading-zone">
    
    <!-- ═══ COLUMNA TOC (Izquierda — "Archipiélago") ═══ -->
    <aside class="paper-sidebar-toc" aria-label="Tabla de Contenidos">
      <div class="toc-wrapper">
        <p class="toc-label">En este paper</p>
        <!-- Tags tipo archipiélago: generados dinámicamente por JS -->
        <nav id="toc-archipelago" class="toc-archipelago" role="navigation" aria-label="Secciones"></nav>
      </div>
    </aside>

    <!-- ═══ CUERPO DEL ENSAYO (Centro) ═══ -->
    <article class="academic-prose paper-main-col" id="paper-content">
      <div class="paper-body prose" id="paper-body">
        {hasContent ? (
          Content ? <Content /> : <Fragment set:html={renderedHtml} />
        ) : (
          <p class="paper-empty">Este ensayo no tiene contenido disponible todavía.</p>
        )}
      </div>
    </article>

    <!-- ═══ COLUMNA CONTEXTO (Derecha) ═══ -->
    <aside class="paper-sidebar-context" aria-label="Metadatos del paper">
      <div class="context-wrapper">
        <h4 class="context-section-label">Sobre este archivo</h4>
        <dl class="context-meta-list">
          <div class="meta-item">
            <dt>Categoría</dt>
            <dd>{category}</dd>
          </div>
          {dateStr && (
            <div class="meta-item">
              <dt>Publicación</dt>
              <dd><time datetime={doc.date ?? ""}>{dateStr}</time></dd>
            </div>
          )}
          <div class="meta-item">
            <dt>Autoría</dt>
            <dd>TGP · Archivo Epistémico</dd>
          </div>
          <div class="meta-item">
            <dt>Lectura est.</dt>
            <dd id="reading-time-sidebar">—</dd>
          </div>
        </dl>

        <hr class="context-divider" />

        <a href={`/hemeroteca/${slug}`} class="context-hemeroteca-link">
          Ver en Hemeroteca ↗
        </a>
      </div>
    </aside>

  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       ZONA 4: TAGS (archipiélago de categorías) — fondo hueso medio
  ══════════════════════════════════════════════════════════════════ -->
  {category && (
    <section class="paper-tags-zone">
      <div class="paper-tags-inner">
        <span class="tag-pill tag-pill--primary">{category}</span>
        <span class="tag-pill">Epistémica</span>
        <span class="tag-pill">The Great Puzzle Project</span>
        <span class="tag-pill">Archivo</span>
      </div>
    </section>
  )}

  <!-- ZONA 5: BLOQUE AUTOR — Xavier Benítez | TGP Project -->
  <section class="paper-author-zone">
    <div class="paper-author-card">
      <a href="/papers/perfil" class="author-card-avatar-link">
        <img src="/perfil.webp" alt="Xavier Benítez" class="author-card-avatar" />
      </a>
      <div class="author-card-body">
        <p class="author-card-written-by">Escrito por</p>
        <a href="/papers/perfil" class="author-card-name-link">
          <h3 class="author-card-name">Xavier Benítez | TGP Project</h3>
        </a>
        <div class="author-card-stats">
          <span>0 seguidores</span>
          <span class="meta-sep">·</span>
          <span>1 seguido</span>
        </div>
        <p class="author-card-bio">
          Profesor &amp; Historiador. Investigando las piezas ocultas de nuestro pasado
          para comprender la condición humana. Arqueología del sentido en TGP Project.
        </p>
        <div class="author-card-actions">
          <button type="button" class="btn-follow trigger-subscribe">Seguir autor</button>
          <a href="/papers/historias" class="btn-follow btn-follow--ghost">Historias</a>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════
       ZONA 6: MÁS PAPERS DEL MISMO AUTOR / CATEGORÍA (Explore More style)
  ══════════════════════════════════════════════════════════════════ -->
  {relatedPosts.length > 0 && (
    <section class="paper-more-zone">
      <div class="paper-more-inner">
        <div class="more-header">
          <span class="more-kicker">[ Sigue Explorando ]</span>
          <div class="more-header-row">
            <h2 class="more-section-title">Continuar la lectura</h2>
            <a href="/archivo" class="more-archive-link">Ver todo el Archivo →</a>
          </div>
        </div>
        
        <div class="more-explore-layout">
          {/* Lead Post (Grande) */}
          {relatedPosts[0] && (() => {
            const lead = relatedPosts[0];
            const leadImg = resolveEssayImage(lead.entry.coverImage, lead.slug);
            const leadCat = formatCategory(lead.entry.category);
            const leadDate = lead.entry.date ? formatDate(lead.entry.date) : null;
            return (
              <article class="explore-lead-card">
                <div class="explore-lead-inner">
                  {leadImg ? (
                    <div class="explore-lead-img-wrap">
                      <img src={leadImg.src} alt="" class="explore-lead-img" loading="lazy" />
                    </div>
                  ) : (
                    <div class="explore-lead-img-wrap explore-lead-fallback flex items-center justify-center bg-linear-to-br from-[#8C6D2F]/15 via-[#242424] to-[#151718] p-6 text-center">
                      <span class="font-mono text-[9px] uppercase tracking-[0.4em] text-[#C9A86C]/50">[ TGP Archivo ]</span>
                    </div>
                  )}
                  <div class="explore-lead-body">
                    <div class="explore-lead-content">
                      {leadCat && <span class="explore-cat">{leadCat}</span>}
                      <h3 class="explore-lead-title">
                        <a href={`/papers/${lead.slug}`}>{lead.entry.title}</a>
                      </h3>
                      {lead.entry.excerpt && (
                        <p class="explore-lead-excerpt">"{lead.entry.excerpt}"</p>
                      )}
                    </div>
                    <div class="explore-lead-footer flex items-center flex-wrap gap-3">
                      <a href={`/papers/${lead.slug}`} class="explore-read-btn"><span>Leer Dossier</span> <span class="arrow">▸</span></a>
                      <a href={`/hemeroteca/${lead.slug}`} class="explore-read-btn explore-read-btn-ghost"><span>Ver Hemeroteca</span> <span class="arrow">▸</span></a>
                      {leadDate && <span class="explore-date ml-auto hidden sm:inline">{leadDate}</span>}
                    </div>
                  </div>
                </div>
              </article>
            );
          })()}

          {/* Grid secundario: 2 menores + Substack */}
          <div class="explore-secondary-grid">
            {relatedPosts.slice(1, 3).map(post => {
              const secImg = resolveEssayImage(post.entry.coverImage, post.slug);
              const secCat = formatCategory(post.entry.category);
              return (
                <article class="explore-secondary-card">
                  <a href={`/papers/${post.slug}`} class="explore-sec-link">
                    {secImg ? (
                      <div class="explore-sec-img-wrap">
                        <img src={secImg.src} alt="" class="explore-sec-img" loading="lazy" />
                      </div>
                    ) : (
                      <div class="explore-sec-img-wrap flex items-center justify-center bg-linear-to-br from-[#8C6D2F]/10 via-[#1e1e1e] to-[#151718]">
                        <span class="font-mono text-[8px] uppercase tracking-[0.3em] text-[#C9A86C]/40">[ TGP ]</span>
                      </div>
                    )}
                    <div class="explore-sec-body">
                      <div class="explore-sec-content">
                        {secCat && <span class="explore-cat">{secCat}</span>}
                        <h4 class="explore-sec-title">{post.entry.title}</h4>
                      </div>
                      <div class="explore-sec-footer flex items-center justify-between gap-2">
                        <a href={`/papers/${post.slug}`} class="explore-sec-read hover:text-rust-orange transition-colors">Dossier ▸</a>
                        <a href={`/hemeroteca/${post.slug}`} class="explore-sec-read opacity-60 hover:opacity-100 hover:text-rust-orange transition-colors">Hemeroteca ▸</a>
                      </div>
                    </div>
                  </a>
                </article>
              );
            })}

            <!-- Medium CTA Card — Transición Estacional a Medium en Grafito -->
            <div class="explore-medium-card">
              <div class="medium-header">
                <div class="medium-icon-wrap">
                  <svg viewBox="0 0 1043.63 592.71" class="medium-icon" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M588.67 296.36c0 163.67-131.78 296.35-294.33 296.35S0 460.03 0 296.36 131.78 0 294.34 0s294.33 132.69 294.33 296.36M911.56 296.36c0 154.06-65.89 279-147.17 279s-147.17-124.94-147.17-279 65.88-279 147.17-279 147.17 124.94 147.17 279M1043.63 296.36c0 138-20.88 249.88-46.64 249.88s-46.64-111.88-46.64-249.88 20.88-249.88 46.64-249.88 46.64 111.88 46.64 249.88"/>
                  </svg>
                </div>
                <span class="medium-label">Edición Medium · TGP</span>
              </div>
              <div class="medium-body">
                <p class="medium-quote">"Apoya la investigación epistémica en Medium"</p>
                <p class="medium-desc">Dossieres exclusivos &amp; publicaciones directas</p>
              </div>
              <a
                href="https://medium.com"
                target="_blank"
                rel="noopener noreferrer"
                class="medium-submit-btn"
              >
                Apoyar / Suscribirse en Medium ↗
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Nav pie de artículo enriquecido -->
  <nav class="paper-footer-rich-nav" aria-label="Navegación de artículo" style="position: relative; z-index: 20;">
    <div class="footer-rich-inner">
      <a href="/papers" class="btn-rich-ghost">
        ← Volver al Índice
      </a>
      <a href="/archivo" class="btn-rich-primary">
        Explorar Archivo Completo →
      </a>
    </div>
  </nav>
  <!-- Modal Dual de Suscripción TGP Papers & Dossiers (Slider de 4s: ES Grafito <-> EN Welcome Offer) -->
  <div id="tgp-subscribe-modal" class="tgp-modal-backdrop" aria-hidden="true">
    <div class="tgp-modal-box" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <button type="button" class="tgp-modal-close" aria-label="Cerrar modal">&times;</button>
      
      <div class="tgp-modal-slider">
        <!-- Slide 1: Español (Grafito Dual) -->
        <div class="tgp-modal-slide slide-es active">
          <div class="tgp-modal-header">
            <img src="/perfil.webp" alt="Xavier Benítez" class="tgp-modal-avatar" />
            <div class="tgp-modal-header-text">
              <span class="tgp-modal-badge">TGP · Medium &amp; Substack</span>
              <span class="tgp-modal-author-name">Xavier Benítez | TGP Project</span>
            </div>
          </div>

          <h3 id="modal-title" class="tgp-modal-title">Únete y Apoya TGP Papers</h3>
          <p class="tgp-modal-desc">
            Recibe los últimos ensayos de investigación profunda, cartografía epistémica y publicaciones de <strong>Xavier Benítez</strong> en tu correo o en tu feed preferido.
          </p>

          <!-- Opción 1: Formulario Substack -->
          <div class="modal-section-block">
            <span class="modal-section-label">Suscripción por Correo (Substack)</span>
            <form action="https://thegreatpuzzleproject.substack.com/subscribe" method="get" target="_blank" class="tgp-modal-form">
              <div class="tgp-input-group">
