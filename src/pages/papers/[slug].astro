    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1.25rem 0;
    position: relative;
    width: 100%;
  }
  .modal-divider-or::before {
    content: "";
    position: absolute;
    inset: 0;
    top: 50%;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.15);
  }
  .modal-divider-or span {
    position: relative;
    background-color: var(--color-medium-graphite, #242424);
    padding: 0 0.8rem;
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: rgba(250, 250, 249, 0.45);
  }

  .tgp-modal-actions-group {
    width: 100%;
  }

  .tgp-modal-btn-graphite {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    background-color: #FAFAF9;
    color: #191919;
    border: none;
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }
  .tgp-modal-btn-graphite:hover {
    background-color: var(--ac-gold-light, #C9A86C);
    color: #191919;
    transform: translateY(-1px);
  }
  .btn-medium-svg {
    width: 1.2rem;
    height: 0.7rem;
  }

  .tgp-modal-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 1.25rem;
    margin-top: 1.25rem;
    width: 100%;
    text-align: center;
  }
  .tgp-modal-links {
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.75rem;
    display: flex;
    justify-content: center;
    gap: 0.6rem;
  }
  .tgp-modal-link {
    color: var(--ac-gold-light, #C9A86C);
    text-decoration: none;
    font-weight: 500;
  }
  .tgp-modal-link:hover {
    text-decoration: underline;
  }

  /* English Medium Welcome Style */
  .medium-en-badge {
    background-color: #F5C518;
    color: #000;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    margin-bottom: 1.25rem;
  }
  .medium-en-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.2rem;
    font-weight: 500;
    color: #191919;
    line-height: 1.1;
    margin: 0 0 1.5rem;
    letter-spacing: -0.02em;
    text-align: center;
  }
  .medium-en-title span {
    display: block;
    font-size: 1.8rem;
  }
  .medium-en-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    text-align: left;
  }
  .medium-en-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.95rem;
    color: #191919;
    line-height: 1.4;
  }
  .check-icon {
    width: 1.1rem;
    height: 1.1rem;
    color: #191919;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
  .medium-en-btn {
    box-sizing: border-box;
    width: 100%;
    background-color: #191919;
    color: #FFFFFF;
    border: none;
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .medium-en-btn:hover {
    background-color: #000000;
  }

  .paper-author-name {
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ac-text, #191918);
    display: block;
  }

  .paper-author-meta {
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.78rem;
    color: var(--ac-text-soft, #8A8278);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta-sep { opacity: 0.5; }

  /* ═══════════════════════════════════════════════════════════════════
     ZONA 2 — IMAGEN DE PORTADA
     Sangre controlada al ancho máximo del contenido central
  ═══════════════════════════════════════════════════════════════════ */
  .paper-cover-zone {
    padding: 2rem 1.5rem;
    background-color: var(--white-page, #FAFAF9);
    max-width: calc(75ch + 3rem);
    margin: 0 auto;
  }

  .paper-cover-figure {
    margin: 0;
    padding: 0;
  }

  .paper-cover-img {
    width: 100%;
    height: auto;
    max-height: 26rem;
    object-fit: cover;
    border-radius: 3px;
    display: block;
    /* Sombra editorial sobria — sin efectos cinemáticos */
    box-shadow: 0 1px 8px rgba(30,25,15,0.08);
  }

  /* ═══════════════════════════════════════════════════════════════════
     ZONA 3 — ÁREA DE LECTURA (Grid 3 columnas)
  ═══════════════════════════════════════════════════════════════════ */
  .paper-reading-zone {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: "body";
    max-width: 75ch;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;
    gap: 0;
  }

  /* En desktop, 3 columnas: TOC | Contenido | Contexto */
  @media (min-width: 1100px) {
    .paper-reading-zone {
      grid-template-columns: 256px minmax(0, 75ch) 288px;
      grid-template-areas: "toc body context";
      max-width: 80rem; /* max-w-7xl */
      justify-content: center;
      padding: 3.5rem 2rem 0;
      gap: 0 3rem;
      align-items: start;
    }
  }

  @media (min-width: 1400px) {
    .paper-reading-zone {
      grid-template-columns: 256px minmax(0, 75ch) 320px;
      gap: 0 4rem;
      padding: 3.5rem 3rem 0;
    }
  }

  /* TOC sidebar: oculto en móvil */
  .paper-sidebar-toc {
    display: none;
  }
  @media (min-width: 1100px) {
    .paper-sidebar-toc { display: block; }
  }

  /* Contexto sidebar: oculto en móvil */
  .paper-sidebar-context {
    display: none;
  }
  @media (min-width: 1100px) {
    .paper-sidebar-context { display: block; }
  }

  /* ─── TOC Archipiélago ─── */
  .toc-wrapper {
    position: sticky;
    top: 5.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    scrollbar-width: none;
    width: 100%;
    box-sizing: border-box;
  }
  .toc-wrapper > * {
    flex-shrink: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .toc-label {
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ac-text-soft, #8A8278);
    margin: 0 0 0.25rem;
  }

  /* "Archipiélago": botones-píldora apilados — no grid, sino flujo natural */
  .toc-archipelago {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    align-items: flex-start;
  }

  .toc-pill {
    display: inline-block;
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--ac-text-muted, #575043);
    background-color: var(--white-bone, #EDE9E1);
    border: 1px solid transparent;
    border-radius: 999px; /* píldora */
    padding: 0.3rem 0.85rem;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.18s ease;
    max-width: 200px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .toc-pill:hover {
    background-color: var(--white-ice, #F8F8F7);
    border-color: var(--ac-gold-light, #C9A86C);
    color: var(--ac-accent, #3B2A14);
  }

  /* H3: más pequeños y desplazados para crear el efecto de "profundidad" */
  .toc-pill.toc-h3 {
    font-size: 0.7rem;
    background-color: var(--white-page, #FAFAF9);
    border-color: var(--white-silver, #E4E1DB);
    padding: 0.22rem 0.7rem;
    max-width: 185px;
  }

  /* Archipiélago activo: píldora iluminada con dorado TGP */
  .toc-pill.active {
    background-color: var(--ac-accent, #3B2A14);
    border-color: var(--ac-accent, #3B2A14);
    color: #FAFAF9;
    font-weight: 500;
  }

  .toc-empty {
    font-size: 0.8rem;
    font-style: italic;
    color: var(--ac-text-soft, #8A8278);
  }

  /* ─── Cuerpo del ensayo ─── */
  .academic-prose.paper-main-col {
    width: 100%;
  }

  .paper-body {
    width: 100%;
    padding-bottom: 4rem;
    font-family: var(--font-body, 'Lora', serif);
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--ac-text, #191918);
    /* Borde irregular (ragged right) */
    text-align: left !important;
  }

  /* Prose tailwind overrides */
  .paper-body.prose {
    --tw-prose-body:          var(--ac-text, #191918);
    --tw-prose-headings:      var(--ac-text, #191918);
    --tw-prose-lead:          var(--ac-text-muted, #575043);
    --tw-prose-links:         var(--ac-accent, #3B2A14);
    --tw-prose-bold:          var(--ac-text, #191918);
    --tw-prose-counters:      var(--ac-text-muted, #575043);
    --tw-prose-bullets:       var(--ac-gold, #8C6D2F);
    --tw-prose-hr:            var(--white-silver, #E4E1DB);
    --tw-prose-quotes:        var(--ac-accent, #3B2A14);
    --tw-prose-quote-borders: var(--ac-gold, #8C6D2F);
    --tw-prose-captions:      var(--ac-text-soft, #8A8278);
    --tw-prose-code:          var(--ac-accent, #3B2A14);
    --tw-prose-pre-code:      var(--white-page, #FAFAF9);
    --tw-prose-pre-bg:        var(--ac-accent, #3B2A14);
    --tw-prose-th-borders:    var(--white-silver, #E4E1DB);
    --tw-prose-td-borders:    var(--white-bone, #EDE9E1);
    max-width: none;
  }

  /* Headings editoriales */
  .paper-body.prose h1,
  .paper-body.prose h2,
  .paper-body.prose h3,
  .paper-body.prose h4 {
    font-family: var(--font-editorial, 'Cormorant Garamond', serif);
    font-weight: 700;
    letter-spacing: -0.015em;
    background: none !important;
    -webkit-background-clip: unset !important;
    background-clip: unset !important;
    color: var(--ac-text, #191918) !important;
    -webkit-text-fill-color: var(--ac-text, #191918) !important;
    filter: none !important;
    scroll-margin-top: 6rem; /* espacio para nav sticky */
  }

  .paper-body.prose h2 { margin-top: 2.5em; margin-bottom: 0.75em; font-size: 1.85rem; }
  .paper-body.prose h3 { margin-top: 2em;   margin-bottom: 0.5em;  font-size: 1.45rem; }
  .paper-body.prose h4 { margin-top: 1.5em; margin-bottom: 0.25em; font-size: 1.15rem; }

  /* Blockquote editorial */
  .paper-body.prose blockquote {
    border-left: 2.5px solid var(--ac-gold, #8C6D2F);
    font-style: italic;
    color: var(--ac-text-muted, #575043);
    background-color: var(--white-broken, #F5F2ED);
    padding: 1rem 1.5rem;
    border-radius: 0 4px 4px 0;
    margin: 2rem 0;
  }

  /* Links */
  .paper-body.prose a {
    color: var(--ac-accent, #3B2A14);
    text-decoration: underline;
    text-decoration-color: var(--ac-gold-light, #C9A86C);
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }
  .paper-body.prose a:hover { color: var(--ac-gold, #8C6D2F); }

  /* Drop Cap */
  .paper-body.prose > p:first-of-type::first-letter {
    font-family: var(--font-editorial, 'Cormorant Garamond', serif);
    font-size: 4em;
    font-weight: 700;
    line-height: 0.85;
    float: left;
    margin-right: 0.07em;
    margin-top: 0.05em;
    color: var(--ac-gold, #8C6D2F);
    padding-bottom: 0.05em;
    font-feature-settings: "liga" 1, "kern" 1;
  }
  .paper-body.prose > p:first-of-type::after {
    content: ''; display: table; clear: both;
  }

  /* Versalitas */
  .paper-body .versalitas {
    font-variant-caps: small-caps;
    font-variant-numeric: oldstyle-nums;
    letter-spacing: 0.06em;
  }

  /* Vacío */
  .paper-empty {
    font-style: italic;
    color: var(--ac-text-soft, #8A8278);
    text-align: center;
    padding: 3rem 0;
    font-family: var(--font-editorial, serif);
    font-size: 1.2rem;
  }

  /* ─── Contexto sidebar ─── */
  .context-wrapper {
    position: sticky;
    top: 5.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    scrollbar-width: none;
    width: 100%;
    box-sizing: border-box;
  }
  .context-wrapper > * {
    flex-shrink: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .context-section-label {
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ac-text-soft, #8A8278);
    margin: 0 0 0.5rem;
  }

  .context-meta-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
  }

  .meta-item { margin: 0; }

  .meta-item dt {
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ac-text-soft, #8A8278);
    margin-bottom: 0.15rem;
  }

  .meta-item dd {
    font-family: var(--font-body, 'Lora', serif);
    font-size: 0.88rem;
    color: var(--ac-text, #191918);
    margin: 0;
  }

  .context-divider {
    border: none;
    border-top: 1px solid var(--white-silver, #E4E1DB);
    margin: 0.5rem 0;
  }

  .context-hemeroteca-link {
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.78rem;
    color: var(--ac-gold, #8C6D2F);
    text-decoration: none;
    transition: color 0.15s ease;
    display: inline-block;
  }
  .context-hemeroteca-link:hover { color: var(--ac-accent, #3B2A14); }

  /* ═══════════════════════════════════════════════════════════════════
     ZONA 4 — TAGS (Archipiélago de etiquetas)
     Fondo hueso medio — separación visual suave
  ═══════════════════════════════════════════════════════════════════ */
  .paper-tags-zone {
    background-color: var(--white-bone, #EDE9E1);
    border-top: 1px solid var(--white-silver, #E4E1DB);
    border-bottom: 1px solid var(--white-silver, #E4E1DB);
    padding: 1.5rem;
    margin-top: 3rem;
  }

  .paper-tags-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Píldoras de tags — mismo sistema visual que el TOC */
  .tag-pill {
    display: inline-block;
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--ac-text-muted, #575043);
    background-color: var(--white-page, #FAFAF9);
    border: 1px solid var(--white-silver, #E4E1DB);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    cursor: default;
    transition: all 0.18s ease;
    user-select: none;
  }
  .tag-pill:hover {
    background-color: var(--white-ice, #F8F8F7);
    border-color: var(--ac-gold-light, #C9A86C);
    color: var(--ac-accent, #3B2A14);
  }

  /* Tag primario: resaltado dorado */
  .tag-pill--primary {
    background-color: var(--white-page, #FAFAF9);
    border-color: var(--ac-gold, #8C6D2F);
    color: var(--ac-gold, #8C6D2F);
    font-weight: 500;
  }

  /* ═══════════════════════════════════════════════════════════════════
     ZONA 5 — BLOQUE AUTOR (estilo Medium)
     Fondo roto sutil — diferencia discreta de tono
  ═══════════════════════════════════════════════════════════════════ */
  .paper-author-zone {
    background-color: var(--white-broken, #F5F2ED);
    border-top: 1px solid var(--white-silver, #E4E1DB);
    padding: 3rem 1.5rem;
  }

  .paper-author-card {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .author-card-avatar {
    width: 3.5rem;
    height: 3.5rem;
    min-width: 3.5rem;
    border-radius: 50%;
    background-color: var(--ac-accent, #3B2A14);
    color: var(--white-page, #FAFAF9);
    font-family: var(--font-editorial, serif);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    justify-content: center;
    object-fit: cover;
  }

  .author-card-body { flex: 1; }

  .author-card-written-by {
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ac-text-soft, #8A8278);
    margin: 0 0 0.25rem;
  }

  .author-card-name {
    font-family: var(--font-editorial, 'Cormorant Garamond', serif);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--ac-text, #191918);
    margin: 0 0 0.6rem;
  }

  .author-card-bio {
    font-family: var(--font-body, 'Lora', serif);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--ac-text-muted, #575043);
    margin: 0 0 1rem;
  }

  .author-card-actions { display: flex; gap: 0.75rem; align-items: center; }

  .btn-follow {
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--white-page, #FAFAF9);
    background-color: var(--ac-accent, #3B2A14);
    border: none;
    border-radius: 999px;
    padding: 0.5rem 1.2rem;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .btn-follow:hover { background-color: var(--ac-gold, #8C6D2F); }

  /* Variante ghost (borde, sin fondo) */
  .btn-follow--ghost {
    background-color: transparent;
    color: var(--ac-accent, #3B2A14);
    border: 1.5px solid var(--ac-accent, #3B2A14);
  }
  .btn-follow--ghost:hover {
    background-color: var(--white-bone, #EDE9E1);
    border-color: var(--ac-gold, #8C6D2F);
    color: var(--ac-gold, #8C6D2F);
  }

  /* Avatar con link */
  .author-card-avatar-link {
    display: block;
    flex-shrink: 0;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .author-card-avatar-link:hover { opacity: 0.85; }

  /* Nombre del autor como link */
  .author-card-name-link {
    text-decoration: none;
  }
  .author-card-name-link:hover .author-card-name {
    color: var(--ac-gold, #8C6D2F);
  }

  /* Stats de seguidores */
  .author-card-stats {
    font-family: var(--font-ui, 'Inter', sans-serif);
    font-size: 0.78rem;
    color: var(--ac-text-soft, #8A8278);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  /* Link del avatar inline (en la firma del título) */
  .paper-author-avatar-link {
    display: block;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.15s ease;
  }
  .paper-author-avatar-link:hover { opacity: 0.8; }

  .paper-author-name-link {
    text-decoration: none;
  }
  .paper-author-name-link:hover .paper-author-name {
    color: var(--ac-gold, #8C6D2F);
  }



  /* ═══════════════════════════════════════════════════════════════════
     ZONA 6 — MÁS PAPERS (Explore More local style)
  ═══════════════════════════════════════════════════════════════════ */
  .paper-more-zone {
    padding: 5rem 1.5rem;
    border-top: 1px solid var(--white-silver, #E4E1DB);
    background-color: var(--white-page, #FAFAF9);
  }

  .paper-more-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* Encabezado del Explore More */
  .more-header {
    display: flex;
    flex-direction: column;
  }
