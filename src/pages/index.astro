<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const setupHomeScrollytelling = () => {
    const hero = document.getElementById('hero-cinematic');
    const bg = hero?.querySelector('img');
    if (!hero || !bg) return;

    ScrollTrigger.getAll().forEach((t) => {
      if (t.trigger === hero) t.kill();
    });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    gsap.to(bg, {
      scale: 0.95,
      opacity: 0,
      y: 50,
      ease: 'none',
      scrollTrigger: {
        trigger: hero,
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
    });

    const content = hero.querySelector('.content-layer');
    if (content) {
      gsap.to(content, {
        opacity: 0,
        y: 40,
        ease: 'none',
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
    }
  };

  document.addEventListener('DOMContentLoaded', setupHomeScrollytelling);
  document.addEventListener('astro:page-load', setupHomeScrollytelling);
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    .reveal-item { transition: none !important; opacity: 1 !important; transform: none !important; }
  }
</style>
