---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import SpotifyIcon from '../components/icons/Spotify.astro';
import YouTubeIcon from '../components/icons/YouTube.astro';
import CinematicArchiveCard from '../components/CinematicArchiveCard.astro';
import CinematicCardStorybook from '../components/CinematicCardStorybook.astro';
import CinematicPostEngine from '../components/CinematicPostEngine.astro';
import {
  getPublishableEssays,
  groupByCategory,
  formatCategory,
  formatDate,
  resolveEssayImage,
  sortEssaysByVisualFirst,
} from '../lib/content-filter';

// ─── CARGA Y FILTRADO CENTRALIZADO ───────────────────────────────────────────
const allEssaysRaw = await getCollection('ensayos').catch(err => {
  console.error("[INDEX] Falló carga de ensayos:", err);
  return [];
});

const allGeorefsRaw = await getCollection('georreferencias').catch(err => {
  console.error("[INDEX] Falló carga de georreferencias:", err);
  return [];
});

const allArquetiposRaw = await getCollection('arquetiposGlobales').catch(() => []);

const isProd = import.meta.env.PROD;
const publishableEssays = getPublishableEssays(allEssaysRaw, isProd);
const publishableGeorefs = getPublishableEssays(allGeorefsRaw, isProd);
const publishableArquetipos = getPublishableEssays(allArquetiposRaw, isProd);

const publishable = [...publishableEssays, ...publishableGeorefs, ...publishableArquetipos].sort(sortEssaysByVisualFirst);

// ─── SEGMENTACIÓN EDITORIAL ───────────────────────────────────────────────────
// Los primeros 30 posts (o los disponibles) alimentan el Motor Cinemático Hero (slider).
// Se eligen preferentemente los que tienen imágenes gracias a sortEssaysByVisualFirst.
// El resto del array mantiene la grilla Bento existente (sin repeticiones).

const HERO_COUNT   = Math.min(30, publishable.length);
const heroSlides   = publishable.slice(0, HERO_COUNT).map(e => ({
  id: e.slug,
  title: e.entry.title || '',
  subtitle: e.entry.excerpt || undefined,
  category: formatCategory(e.entry.category),
  date: formatDate(e.entry.date),
  readTime: undefined as string | undefined,
  image: resolveEssayImage(e.entry.coverImage, e.slug) || '',
  imagePosition: (e.entry as any).coverImagePosition || (e.entry as any).imagePosition || 'center center',
  link: `/hemeroteca/${e.slug}`,
  papersLink: (e.entry as any).papersSlug ? `/papers/${(e.entry as any).papersSlug}` : undefined,
}));

// Bloques editoriales a continuación del Hero (offset 5)
const leadStory    = publishable[HERO_COUNT]     ?? null;
const secondaryA   = publishable[HERO_COUNT + 1] ?? null;
const secondaryB   = publishable[HERO_COUNT + 2] ?? null;
const recentEssays = publishable.slice(HERO_COUNT + 3, HERO_COUNT + 9);   // hasta 6
const archiveRows  = publishable.slice(HERO_COUNT + 9, HERO_COUNT + 19);  // hasta 10

// ─── COLECCIONES DESTACADAS (§5.4) ────────────────────────────────────────────
const categoryGroups = groupByCategory(publishable, 2);
const collections = Array.from(categoryGroups.entries())
  .map(([key, essays]) => ({
    key,
    label: formatCategory(essays[0].entry.category),
    count: essays.length,
    coverEssay: essays[0],
  }))
  .slice(0, 4);

// ─── CARGA DE IMÁGENES EDITORIAL ──────────────────────────────────────────────
const leadImage  = resolveEssayImage(leadStory?.entry.coverImage, leadStory?.slug);
const secAImage  = resolveEssayImage(secondaryA?.entry.coverImage, secondaryA?.slug);
const secBImage  = resolveEssayImage(secondaryB?.entry.coverImage, secondaryB?.slug);

const resolvedRecent = recentEssays.map(e => ({
  ...e,
  img: resolveEssayImage(e.entry.coverImage, e.slug),
}));

const resolvedArchiveRows = archiveRows.map(e => ({
  ...e,
  img: resolveEssayImage(e.entry.coverImage, e.slug),
}));

const resolvedCollections = collections.map(c => ({
  ...c,
  img: resolveEssayImage(c.coverEssay.entry.coverImage, c.coverEssay.slug),
}));

// ─── SECUENCIAS CINE PREMIER PARA ZONA ARCHIVOS (1 HERO FULL + DÚO 60/40) ────
function createPremierSequences(essays: typeof resolvedArchiveRows) {
  const sequences: Array<{
    hero: typeof resolvedArchiveRows[0];
    duo: typeof resolvedArchiveRows;
  }> = [];
  for (let i = 0; i < essays.length; i += 3) {
    sequences.push({ hero: essays[i], duo: essays.slice(i + 1, i + 3) });
  }
  return sequences;
}
const archiveSequences = createPremierSequences(resolvedArchiveRows);
---

<Layout
  title="Hemeroteca TGP - Editorial & Cartografía Epistémica"
  headerTransparentUntilScroll={true}
>
  <div class="w-full pb-20">

    {/* ═══════════════════════════════════════════════════════════════════════
        BLOQUE 1: MOTOR CINEMÁTICO HERO — Slider multi-post tipo Netflix
    ═══════════════════════════════════════════════════════════════════════ */}
    {heroSlides.length > 0 && (
      <div id="hero-cinematic" class="sticky top-0 w-full h-dvh overflow-hidden">
        <CinematicPostEngine slides={heroSlides} />
      </div>
    )}

    {/* Lienzo / grilla: se desliza sobre el Hero ya oscurecido */}
    <div id="home-canvas" class="relative z-20 bg-(--bg-main) shadow-[0_-24px_60px_rgba(0,0,0,0.85)]">
    <div class="container-editorial max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-20 md:gap-28 pt-16 md:pt-24">

      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE 2A: DOSSIER DESTACADO — SECCIÓN AUTÓNOMA CON SOLAPA CINEMÁTICA
          El post más reciente ocupa su propia franja editorial, separado del resto
      ═══════════════════════════════════════════════════════════════════ */}
      {leadStory && (
        <section class="flex flex-col gap-0 reveal-item">

          {/* ── SOLAPA / TAB CINEMÁTICA ── */}
          <div class="relative flex items-end gap-6 pb-0 z-10">
            <div class="flex items-center gap-3 bg-(--bg-main) border border-white/8 border-b-0 rounded-t-2xl px-6 py-3.5 shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-rust-orange shadow-[0_0_8px_#EFEBE3] shrink-0"></span>
              <span class="font-metadata text-[9px] uppercase tracking-[0.45em] text-rust-orange font-bold whitespace-nowrap">Último Dossier</span>
            </div>
            <div class="flex-1 border-b border-white/8 mb-px"></div>
            <span class="font-metadata text-[9px] uppercase tracking-[0.3em] text-white/30 pb-3.5 pr-1 shrink-0">{formatDate(leadStory.entry.date)}</span>
          </div>

          {/* ── CARD DESTACADA FULL-WIDTH CINEMÁTICA ── */}
          <article class="card-hover-cinematic group w-full relative overflow-hidden rounded-b-2xl rounded-tr-2xl border border-white/8 border-t-0 bg-white/3 transition-all duration-700">
            <div class="flex flex-col lg:flex-row lg:min-h-105 xl:min-h-120">

              {/* Imagen lateral / superior en mobile */}
              {leadImage && (
                <div class="relative overflow-hidden lg:w-[55%] xl:w-[58%] aspect-video lg:aspect-auto shrink-0">
                  <Image
                    src={leadImage}
                    alt={leadStory.entry.title || "Dossier Destacado"}
                    loading="eager"
                    quality={80}
                    class="w-full h-full object-cover object-center transition-transform duration-700 delay-75 group-hover:scale-[1.018] brightness-80"
                  />
                  <div class="absolute inset-0 shadow-[inset_0_0_80px_rgba(0,0,0,0.85)] pointer-events-none" />
                  <div class="absolute inset-0 bg-linear-to-r from-transparent via-transparent to-(--bg-main) hidden lg:block pointer-events-none" />
                  <div class="absolute inset-0 bg-linear-to-t from-(--bg-main)/85 via-transparent to-transparent lg:hidden pointer-events-none" />
                </div>
              )}

              {/* Contenido Editorial */}
              <div class={`flex flex-col justify-between p-6 md:p-10 lg:p-12 xl:p-14 ${leadImage ? 'lg:flex-1' : 'w-full'}`}>
                <div class="flex flex-col gap-4 md:gap-6">
                  <div class="flex items-center gap-3 font-metadata text-[9px] text-rust-orange/80 tracking-[0.25em] uppercase">
                    <span>{formatCategory(leadStory.entry.category)}</span>
                  </div>
                  <h2 class="font-cinzel font-extrabold text-2xl sm:text-3xl md:text-4xl xl:text-5xl leading-[1.08] tracking-tight bg-linear-to-br from-white via-[#E2E8F0] to-[#94A3B8] bg-clip-text text-transparent">
                    <a href={`/hemeroteca/${leadStory.slug}`} class="hover:opacity-80 transition-opacity">
                      {leadStory.entry.title}
                    </a>
                  </h2>
                  {leadStory.entry.excerpt && (
                    <p class="font-serif text-white/70 text-base leading-relaxed line-clamp-3 italic max-w-prose">
                      "{leadStory.entry.excerpt}"
                    </p>
                  )}
                </div>

                <div class="flex items-center justify-between gap-4 mt-8 pt-5 border-t border-white/5">
                  <a
                    href={`/hemeroteca/${leadStory.slug}`}
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#151718]/90 backdrop-blur-sm border border-white/10 text-[#E0E0E0]/75 font-metadata font-bold text-[9px] tracking-[0.25em] uppercase rounded-lg hover:bg-rust-orange/10 hover:border-rust-orange/50 hover:text-rust-orange transition-all duration-400"
                  >
                    <span>Leer Dossier</span>
                    <span class="opacity-60 group-hover:translate-x-0.5 transition-transform">▸</span>
                  </a>
                  {(leadStory.entry.spotifyLink || leadStory.entry.youtubeLink) && (
                    <div class="flex items-center gap-3 text-white/30">
                      {leadStory.entry.spotifyLink && <a href={leadStory.entry.spotifyLink} target="_blank" rel="noopener noreferrer" class="hover:text-rust-orange transition-colors"><SpotifyIcon class="w-4 h-4" /></a>}
                      {leadStory.entry.youtubeLink && <a href={leadStory.entry.youtubeLink} target="_blank" rel="noopener noreferrer" class="hover:text-rust-orange transition-colors"><YouTubeIcon class="w-4 h-4" /></a>}
                    </div>
                  )}
                </div>
              </div>
            </div>
          </article>
        </section>
      )}

      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE 2B: GRID EDITORIAL 1+2 — TIPO COLECCIONES
          1 card central principal + 2 más pequeñas debajo
      ═══════════════════════════════════════════════════════════════════ */}
      {(secondaryA || secondaryB) && (
        <section class="flex flex-col gap-6 reveal-item">

          {/* ENCABEZADO */}
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 pb-4">
            <div>
              <span class="font-metadata text-[10px] uppercase tracking-[0.4em] text-rust-orange block mb-1">Archivo Editorial</span>
              <h2 class="text-2xl sm:text-3xl md:text-4xl font-cinzel font-extrabold tracking-tight bg-linear-to-b from-[#FFFFFF] via-[#8E8E93] to-[#1C1C1E] bg-clip-text text-transparent drop-shadow-md">
                Dossieres Recientes
              </h2>
            </div>
            <a href="/archivo" class="font-metadata text-[10px] uppercase tracking-[0.3em] text-white/40 hover:text-rust-orange transition-colors shrink-0 pb-1">
              Ver todo el Archivo →
            </a>
          </div>

          {/* ──────────────────────────────────────────────────────────
              GRID FATHER: 12 cols / auto-rows-min
              secondaryA: fila completa (col-span-12)
              Duo secondaryB: col-span-6 c/u, h-full (altura igualada)
          ────────────────────────────────────────────────────────── */}
          <div class="grid grid-cols-1 md:grid-cols-12 auto-rows-min gap-6 md:gap-8 w-full">

            {/* CARD PRINCIPAL — col-span-12 (fila completa) */}
            {secondaryA && (
              <article class="col-span-1 md:col-span-12 card-hover-cinematic group w-full relative overflow-hidden rounded-2xl border border-white/8 bg-white/3 transition-all duration-500">
                <div class="flex flex-col md:flex-row md:min-h-70">
                  {secAImage && (
                    <div class="relative overflow-hidden md:w-[45%] shrink-0 aspect-video md:aspect-auto">
                      <Image
                        src={secAImage}
                        alt={secondaryA.entry.title || "Dossier"}
                        loading="lazy"
                        decoding="async"
                        quality={80}
                        class="w-full h-full object-cover object-center transition-transform duration-700 delay-75 group-hover:scale-[1.018] brightness-85"
                      />
                      <div class="absolute inset-0 bg-linear-to-r from-transparent to-(--bg-main)/70 hidden md:block pointer-events-none" />
                      <div class="absolute inset-0 bg-linear-to-t from-(--bg-main)/60 via-transparent to-transparent md:hidden pointer-events-none" />
                    </div>
                  )}
                  <div class="flex flex-col justify-between p-6 md:p-8 flex-1">
                    <div class="flex flex-col gap-3">
                      <span class="font-metadata text-xs uppercase tracking-[0.3em] text-rust-orange/70">{formatCategory(secondaryA.entry.category)}</span>
                      <h3 class="font-cinzel font-bold text-xl sm:text-2xl md:text-3xl leading-tight group-hover:text-rust-orange transition-colors duration-300">
                        <a href={`/hemeroteca/${secondaryA.slug}`}>{secondaryA.entry.title}</a>
                      </h3>
                      {secondaryA.entry.excerpt && (
                        <p class="font-serif text-white/70 text-base leading-relaxed line-clamp-2 italic">{secondaryA.entry.excerpt}</p>
                      )}
                    </div>
                    <div class="mt-5 pt-4 border-t border-white/5 font-metadata text-xs uppercase tracking-[0.3em]">
                      <a href={`/hemeroteca/${secondaryA.slug}`} class="text-white/40 hover:text-rust-orange transition-colors inline-flex items-center gap-1.5">Ver Dossier ▸</a>
                    </div>
                  </div>
                </div>
              </article>
            )}

            {/* DUO CARDS MENORES — md:col-span-6 c/u, h-full para igualar alturas */}
            {secondaryB && (
              <>
                <article class="col-span-1 md:col-span-6 w-full h-full card-hover-cinematic group relative overflow-hidden rounded-xl border border-white/8 bg-white/3 transition-all duration-500 flex flex-col">
                  {secBImage && (
                    <div class="relative overflow-hidden aspect-video">
                      <Image
                        src={secBImage}
                        alt={secondaryB.entry.title || "Dossier"}
                        loading="lazy"
                        decoding="async"
                        quality={80}
                        class="w-full h-full object-cover transition-transform duration-700 delay-75 group-hover:scale-[1.018] brightness-80"
                      />
                      <div class="absolute inset-0 bg-linear-to-t from-(--bg-main)/70 via-transparent to-transparent pointer-events-none" />
                    </div>
                  )}
                  <div class="flex flex-col justify-between p-5 flex-1">
                    <div class="flex flex-col gap-2">
                      <span class="font-metadata text-xs uppercase tracking-[0.3em] text-rust-orange/70">{formatCategory(secondaryB.entry.category)}</span>
                      <h3 class="font-cinzel font-bold text-base sm:text-lg leading-snug group-hover:text-rust-orange transition-colors">
                        <a href={`/hemeroteca/${secondaryB.slug}`}>{secondaryB.entry.title}</a>
                      </h3>
                    </div>
                    <div class="mt-4 pt-3 border-t border-white/5 font-metadata text-xs uppercase tracking-[0.25em]">
                      <a href={`/hemeroteca/${secondaryB.slug}`} class="text-white/35 hover:text-rust-orange transition-colors">Ver Dossier ▸</a>
                    </div>
                  </div>
                </article>

                {/* Placeholder/Teaser "Ver Archivo" como celda par del grid */}
                <a
                  href="/archivo"
                  class="col-span-1 md:col-span-6 w-full h-full group relative overflow-hidden rounded-xl border border-white/6 border-dashed bg-white/1 hover:border-rust-orange/40 hover:bg-rust-orange/3 transition-all duration-500 flex flex-col items-center justify-center min-h-50 p-6 text-center gap-3"
                >
                  <span class="font-metadata text-xs uppercase tracking-[0.4em] text-white/25 group-hover:text-rust-orange/60 transition-colors">Explorar</span>
                  <span class="font-cinzel font-bold text-base text-white/40 group-hover:text-rust-orange/80 transition-colors">Todo el Archivo</span>
                  <span class="text-white/20 group-hover:text-rust-orange/50 group-hover:translate-x-1 transition-all text-sm">→</span>
                </a>
              </>
            )}
          </div>
        </section>
      )}


      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE 3: ENSAYOS RECIENTES (Formato Cinemático Archivo General)
          Mapeo: publishable[4..9] (máx 6)
      ═══════════════════════════════════════════════════════════════════ */}
      {resolvedRecent.length > 0 && (
        <section class="flex flex-col gap-8">
          <div class="reveal-item flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4">
            <div>
              <span class="font-metadata text-[10px] uppercase tracking-[0.4em] text-rust-orange block mb-1">Archivo de Ensayos</span>
              <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-cinzel font-extrabold tracking-tight bg-linear-to-b from-[#FFFFFF] via-[#8E8E93] to-[#1C1C1E] bg-clip-text text-transparent drop-shadow-md">
                Ensayos Recientes
              </h2>
            </div>
            <a href="/archivo" class="font-metadata text-[10px] uppercase tracking-[0.3em] text-white/50 hover:text-rust-orange hover:drop-shadow-[0_0_8px_rgba(239, 235, 227,0.5)] transition-all">
              Ver Catálogo Completo ({publishable.length}) →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {resolvedRecent.map(({ slug, entry, img }) => (
              slug === 'moctezuma-y-cortez-el-ultimo-azteca' ? (
                <CinematicCardStorybook
                  slug={slug}
                  entry={entry}
                  img={img}
                  variant="standard"
                  enableCinemagraph={false}
                />
              ) : (
                <CinematicArchiveCard
                  slug={slug}
                  entry={entry}
                  img={img}
                  variant="standard"
                  enableCinemagraph={false}
                />
              )
            ))}
          </div>
        </section>
      )}

      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE 4: COLECCIONES DESTACADAS (§5.4)
          Solo categorías con ≥ 2 artículos publicables. Sin descripciones inventadas.
      ═══════════════════════════════════════════════════════════════════ */}
      {resolvedCollections.length > 0 && (
        <section class="flex flex-col gap-8">
          <div class="reveal-item flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4">
            <div>
              <span class="font-metadata text-[10px] uppercase tracking-[0.4em] text-rust-orange block mb-1">Organización Temática</span>
              <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-cinzel font-extrabold tracking-tight bg-linear-to-b from-[#FFFFFF] via-[#8E8E93] to-[#1C1C1E] bg-clip-text text-transparent drop-shadow-md">
                Colecciones
              </h2>
            </div>
          </div>

          {/* Mobile: scroll horizontal snapping */}
          <div class="flex md:grid md:grid-cols-2 lg:grid-cols-4 gap-4 overflow-x-auto md:overflow-visible snap-x snap-mandatory md:snap-none pb-2 md:pb-0 -mx-4 px-4 md:mx-0 md:px-0">
            {resolvedCollections.map(({ key, label, count, img, coverEssay }) => (
              <a
                href={`/archivo?categoria=${encodeURIComponent(key)}`}
                class="group shrink-0 w-[72vw] sm:w-[55vw] md:w-auto snap-start bg-white/5 border border-white/10 rounded-xl overflow-hidden hover:border-rust-orange/50 transition-all duration-500 flex flex-col"
              >
                {img ? (
                  <div class="overflow-hidden aspect-video relative">
                    <Image src={img} alt={label} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-70 group-hover:opacity-90" />
                    <div class="absolute inset-0 bg-linear-to-t from-theme-dark/80 to-transparent" />
                    <div class="absolute bottom-0 left-0 p-4">
                      <p class="font-metadata text-[9px] uppercase tracking-[0.3em] text-rust-orange mb-1">{count} artículos</p>
                      <h3 class="font-cinzel font-bold text-lg leading-tight text-white group-hover:text-rust-orange transition-colors">{label}</h3>
                    </div>
                  </div>
                ) : (
                  <div class="p-5 flex flex-col gap-2 flex-1">
                    <p class="font-metadata text-[9px] uppercase tracking-[0.3em] text-rust-orange">{count} artículos</p>
                    <h3 class="font-cinzel font-bold text-lg leading-tight group-hover:text-rust-orange transition-colors">{label}</h3>
                  </div>
                )}
              </a>
            ))}
          </div>
        </section>
      )}

      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE 5: ZONA ARCHIVOS (ESTRUCTURA CINE PREMIER: 1 HERO + DÚO 60/40)
          Mapeo: publishable[10..19] con formato cinemático idéntico a Por Año
      ═══════════════════════════════════════════════════════════════════ */}
      {archiveSequences.length > 0 && (
        <section class="flex flex-col gap-10 md:gap-14">
          <div class="reveal-item flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4">
            <div>
              <span class="font-metadata text-[10px] uppercase tracking-[0.4em] text-rust-orange block mb-1">Hemeroteca</span>
              <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-cinzel font-extrabold tracking-tight bg-linear-to-b from-[#FFFFFF] via-[#8E8E93] to-[#1C1C1E] bg-clip-text text-transparent drop-shadow-md">
                Del Archivo
              </h2>
            </div>
            <a href="/archivo" class="font-metadata text-[10px] uppercase tracking-[0.3em] text-white/50 hover:text-rust-orange transition-colors shrink-0">
              Ver archivo completo ({publishable.length}) →
            </a>
          </div>

          {/* Secuencias Cinematográficas Premier: 1 Hero Full Bleed + Dúo 60/40 con Cinemagraph */}
          <div class="flex flex-col gap-16 md:gap-24">
            {archiveSequences.map((seq) => (
              <div class="premier-sequence flex flex-col gap-8 md:gap-12">
                {/* 1. Hero Cinemático Full Bleed */}
                <div class="w-full">
                  <CinematicArchiveCard
                    slug={seq.hero.slug}
                    entry={seq.hero.entry}
                    img={seq.hero.img}
                    variant="hero"
                    enableCinemagraph={true}
                  />
                </div>

                {/* 2. Dúo de Films Secundarios con Aire, Espaciado y Proporción 60/40 */}
                {seq.duo.length > 0 && (
                  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
                    {seq.duo[0] && (
                      <div class={seq.duo.length > 1 ? "lg:col-span-7 flex flex-col" : "lg:col-span-12 flex flex-col"}>
                        <CinematicArchiveCard
                          slug={seq.duo[0].slug}
                          entry={seq.duo[0].entry}
                          img={seq.duo[0].img}
                          variant={seq.duo.length > 1 ? "duo-60" : "hero"}
                          enableCinemagraph={true}
                        />
                      </div>
                    )}

                    {seq.duo[1] && (
                      <div class="lg:col-span-5 flex flex-col">
                        <CinematicArchiveCard
                          slug={seq.duo[1].slug}
                          entry={seq.duo[1].entry}
                          img={seq.duo[1].img}
                          variant="duo-40"
                          enableCinemagraph={true}
                        />
                      </div>
                    )}
                  </div>
                )}
              </div>
            ))}
          </div>

          <div class="text-center pt-8">
            <a
              href="/archivo"
