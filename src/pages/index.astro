---
import { resolveMultivisionClass } from "../lib/multivision";
export const prerender = true;
import fs from 'node:fs';
import path from 'node:path';
import Image from '../components/SafeImage.astro';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SpotifyIcon from '../components/icons/Spotify.astro';
import YouTubeIcon from '../components/icons/YouTube.astro';
import CinematicArchiveCard from '../components/CinematicArchiveCard.astro';
import CinematicPostEngine from '../components/CinematicPostEngine.astro';
import SliderCinematico from '../components/SliderCinematico.astro';
import RowNetflixClasico from '../components/RowNetflixClasico.astro';
import SpotlightHero from '../components/SpotlightHero.astro';
import CinematicGrid from '../components/CinematicGrid.astro';
import {
  type EssayEntry,
  getPublishableEssays,
  groupByCategory,
  formatCategory,
  formatDate,
  resolveEssayImage,
  sortEssaysByVisualFirst,
  sanitizeImageUrl,
  isValidImageSrc,
} from '../lib/content-filter';

// ─── CARGA Y FILTRADO CENTRALIZADO ───────────────────────────────────────────
const allEssaysRaw = await getCollection('ensayos').catch(err => {
  console.error("[INDEX] Falló carga de ensayos:", err);
  return [];
});

// 1. Consulta la colección 'ensayosCinematicos'
const allCinematicosRaw = await getCollection('ensayosCinematicos').catch(err => {
  console.error("[INDEX] Falló carga de ensayos cinemáticos:", err);
  return [];
});

const allGeorefsRaw = await getCollection('georreferencias').catch(err => {
  console.error("[INDEX] Falló carga de georreferencias:", err);
  return [];
});

const allArquetiposRaw = await getCollection('arquetiposGlobales').catch(() => []);

const isProd = import.meta.env.PROD;
const publishableEssays = getPublishableEssays(allEssaysRaw, isProd);

// 2. Filtra y procesa los posts con fecha real (mtime o item.data.date) y ordena de forma descendente
const publishableCinematicos: EssayEntry[] = allCinematicosRaw.map(item => {
  const slug = item.id.replace(/\/index$/, '');
  const data = item.data as any;

  // Extracción del nombre de archivo o ruta de imagen directa (ej: coverImage, image, portada o gallery[0])
  let directCover = data.coverImage || data.image || data.portada || null;
  if (!directCover && Array.isArray(data.gallery) && data.gallery.length > 0) {
    directCover = data.gallery[0];
  }

  let aiImage = null;
  let aiText = data.generadorTexto || '';
  if (typeof data.generadorTexto === 'string' && data.generadorTexto.trim().startsWith('{')) {
    try {
      const parsed = JSON.parse(data.generadorTexto);
      if (parsed?.image && typeof parsed.image === 'string' && isValidImageSrc(parsed.image)) {
        aiImage = parsed.image;
      }
      if (parsed?.text && typeof parsed.text === 'string') {
        aiText = parsed.text;
      }
    } catch (e) {}
  }

  // Priorizar archivo directo y validar que sea una imagen genuina (nunca un prompt)
  const dynamicCoverImage = (directCover && isValidImageSrc(typeof directCover === 'object' ? directCover.src : directCover))
    ? directCover
    : aiImage;

  // Determinar fecha de publicación real (item.data.date o mtime del archivo index.json)
  let postDate: string | null = (item.data as any).date || null;
  if (!postDate) {
    try {
      const jsonPath = path.join(process.cwd(), 'src', 'content', 'ensayos-cinematicos', slug, 'index.json');
      if (fs.existsSync(jsonPath)) {
        postDate = fs.statSync(jsonPath).mtime.toISOString();
      }
    } catch (e) {}
  }
  if (!postDate) {
    postDate = new Date(0).toISOString();
  }

  // Excerpt dinámico: dek/excerpt del autor o extracción limpia de los primeros caracteres del texto
  const cleanExcerpt = ((item.data as any).dek ||
    (item.data as any).excerpt ||
    (aiText ? aiText.replace(/[#*_`>\n]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 180) + '…' : '')) as string;

  return {
    slug,
    isCinematicGSAP: true,
    entry: {
      title: item.data.title || 'Dossier Cinemático',
      category: 'Ensayos Cinemáticos',
      coverImage: dynamicCoverImage,
      image: dynamicCoverImage,
      portada: dynamicCoverImage,
      excerpt: cleanExcerpt,
      dek: cleanExcerpt,
      date: postDate,
      themeColor: 'obsidiana',
      spotifyLink: null,
      youtubeLink: null,
    }
  };
}).sort((a, b) => {
  const dateA = a.entry.date ? new Date(a.entry.date).getTime() : 0;
  const dateB = b.entry.date ? new Date(b.entry.date).getTime() : 0;
  return dateB - dateA;
});

// 3. Extrae el primer elemento (índice [0]) — El último post publicado
const latestCinematicPost = publishableCinematicos[0] ?? null;

// 4. Inyección de variables dinámicas del último post para el Hero principal
const heroTitle = latestCinematicPost?.entry.title || 'Dossier Cinemático';
const heroExcerpt = latestCinematicPost?.entry.excerpt || latestCinematicPost?.entry.dek || '';
const rawHeroCover = resolveEssayImage(latestCinematicPost?.entry, latestCinematicPost?.slug);
const heroCoverImage = isValidImageSrc(rawHeroCover) ? rawHeroCover : '';
const heroSlug = latestCinematicPost?.slug || '';
const heroHref = `/ensayos-cinematicos/${heroSlug}`;

const publishableGeorefs = getPublishableEssays(allGeorefsRaw, isProd);
const publishableArquetipos = getPublishableEssays(allArquetiposRaw, isProd);

// PRIORIDAD OBLIGATORIA: Los nuevos ensayos cinemáticos van al inicio de los Heroes y feeds
const publishable: EssayEntry[] = [
  ...publishableCinematicos,
  ...publishableEssays,
  ...publishableGeorefs,
  ...publishableArquetipos
].sort(sortEssaysByVisualFirst);

// ─── SEGMENTACIÓN EDITORIAL ADAPTATIVA ───────────────────────────────────────
// El Hero Slider toma como máximo 6 posts (evita dejar el resto del site vacío
// cuando el catálogo tiene pocos artículos).
// El resto se distribuye entre Lead, Secondary y Recientes sin depender de un
// offset fijo. Con 10 posts: 6 Hero + 1 Lead + 1 SecA + 1 SecB + 1 Recent = todo visible.

const HERO_MAX     = 6;
const HERO_COUNT   = Math.min(HERO_MAX, publishable.length);
const heroSlides   = publishable.slice(0, HERO_COUNT).map((e, index) => {
  // Asegurar que el primer slide (índice 0) refleje exactamente las variables del último post cinemático
  const rawSlideImg = (index === 0 && latestCinematicPost)
    ? heroCoverImage
    : resolveEssayImage(e.entry, e.slug);
  const slideImage = isValidImageSrc(rawSlideImg) ? rawSlideImg : '';

  if (index === 0 && latestCinematicPost) {
    return {
      id: heroSlug,
      title: heroTitle,
      subtitle: heroExcerpt || undefined,
      category: formatCategory(latestCinematicPost.entry.category),
      date: formatDate(latestCinematicPost.entry.date),
      readTime: undefined as string | undefined,
      image: slideImage,
      imagePosition: (latestCinematicPost.entry as any).coverImagePosition || (latestCinematicPost.entry as any).imagePosition || 'center center',
      link: heroHref,
      papersLink: undefined, // Deshabilitado globalmente: (latestCinematicPost.entry as any).papersSlug ? `/papers/${(latestCinematicPost.entry as any).papersSlug}` : undefined,
    };
  }

  return {
    id: e.slug,
    title: e.entry.title || '',
    subtitle: (e.entry.dek || e.entry.excerpt || undefined) as string | undefined,
    category: formatCategory(e.entry.category),
    date: formatDate(e.entry.date),
    readTime: undefined as string | undefined,
    image: slideImage,
    imagePosition: (e.entry as any).coverImagePosition || (e.entry as any).imagePosition || 'center center',
    link: (e as any).isCinematicGSAP ? `/ensayos-cinematicos/${e.slug}` : `/hemeroteca/${e.slug}`,
    papersLink: undefined, // Deshabilitado globalmente: (e.entry as any).papersSlug ? `/papers/${(e.entry as any).papersSlug}` : undefined,
  };
});

// ─── DISTRIBUCIÓN EDITORIAL (offset desde el Hero) ───────────────────────────
// Posts disponibles después del Hero (nunca vacío si hay contenido)
const remaining    = publishable.slice(HERO_COUNT);

const leadStory    = remaining[0]           ?? null;
const secondaryA   = remaining[1]           ?? null;
const secondaryB   = remaining[2]           ?? null;

// Slugs ya destacados en Hero y Bloque 2 (Lead y Secundarios)
const topFeaturedSlugs = new Set([
  heroSlug,
  leadStory?.slug,
  secondaryA?.slug,
  secondaryB?.slug,
].filter(Boolean));

// Completar "Ensayos Recientes" con 4 cards de Ensayos Cinemáticos
const availableCinematics = publishableCinematicos.filter(c => !topFeaturedSlugs.has(c.slug));

const recentEssays: EssayEntry[] = [
  ...availableCinematics,
  ...remaining.filter(e => !topFeaturedSlugs.has(e.slug) && !availableCinematics.some(c => c.slug === e.slug))
].slice(0, 4);

const recentSlugs = new Set(recentEssays.map(e => e.slug));

// Posts restantes para "Del Archivo" (sin duplicar los mostrados arriba ni en recientes)
const archiveRows = remaining
  .filter(e => !topFeaturedSlugs.has(e.slug) && !recentSlugs.has(e.slug))
  .slice(0, 10);

// ─── COLECCIONES DESTACADAS (§5.4) ────────────────────────────────────────────
const categoryGroups = groupByCategory(publishable, 2);
const collections = Array.from(categoryGroups.entries())
  .map(([key, essays]) => ({
    key,
    label: formatCategory(essays[0].entry.category),
    count: essays.length,
    coverEssay: essays[0],
  }))
  .slice(0, 4);

// ─── CARGA DE IMÁGENES EDITORIAL ──────────────────────────────────────────────
const leadImage  = resolveEssayImage(leadStory?.entry, leadStory?.slug);
const secAImage  = resolveEssayImage(secondaryA?.entry, secondaryA?.slug);
const secBImage  = resolveEssayImage(secondaryB?.entry, secondaryB?.slug);

const resolvedRecent = recentEssays.map(e => ({
  ...e,
  img: resolveEssayImage(e.entry, e.slug),
}));

const resolvedArchiveRows = archiveRows.map(e => ({
  ...e,
  img: resolveEssayImage(e.entry, e.slug),
}));

// ─── POSTS PARA SPOTLIGHT HERO CON MEDIA TRAY (ESTILO NAT GEO / DISNEY+) ───
const spotlightPosts = publishableCinematicos.map(item => ({
  title: item.entry.title || 'Ensayo Cinemático',
  excerpt: item.entry.dek || item.entry.excerpt || '',
  slug: item.slug,
  coverImage: resolveEssayImage(item.entry, item.slug),
  category: formatCategory(item.entry.category),
  isCinematicGSAP: true,
}));

// ─── POSTS PARA CINEMATIC GRID (NUEVO) ───
const gridItems = publishableCinematicos.map(item => {
  const aiText = item.entry.generadorTexto || '';
  const cleanExcerpt = ((item.entry as any).dek || (item.entry as any).excerpt || (aiText ? aiText.replace(/[#*_`>\n]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 180) + '…' : '')) as string;
  return {
    title: item.entry.title || 'Ensayo Cinemático',
    excerpt: cleanExcerpt,
    img: resolveEssayImage(item.entry, item.slug) as string,
    link: `/ensayos-cinematicos/${item.slug}`,
  };
});

const resolvedCollections = collections.map(c => ({
  ...c,
  img: resolveEssayImage(c.coverEssay.entry, c.coverEssay.slug),
}));

// ─── SECUENCIAS CINE PREMIER PARA ZONA ARCHIVOS (1 HERO FULL + DÚO 60/40) ────
function createPremierSequences(essays: typeof resolvedArchiveRows) {
  const sequences: Array<{
    hero: typeof resolvedArchiveRows[0];
    duo: typeof resolvedArchiveRows;
  }> = [];
  for (let i = 0; i < essays.length; i += 3) {
    sequences.push({ hero: essays[i], duo: essays.slice(i + 1, i + 3) });
  }
  return sequences;
}
const archiveSequences = createPremierSequences(resolvedArchiveRows);
---

<Layout
  title="Hemeroteca TGP — The Great Puzzle Project"
  description="Hemeroteca digital, archivo epistémico, ensayos cinemáticos, arqueosemiótica e investigaciones profundas de The Great Puzzle Project."
  image={heroSlides[0]?.image}
  headerTransparentUntilScroll={true}
  bodyClass="bg-gradient-to-b from-[#1b1d1c] via-[#121413] to-[#0c0d0d]"
  bodyStyle="--bg-main: #121413;"
>
  <div class="w-full pb-20">

    {/* ═══════════════════════════════════════════════════════════════════════
        BLOQUE 1: MOTOR CINEMÁTICO HERO — Slider multi-post tipo Netflix
    ═══════════════════════════════════════════════════════════════════════ */}
    {heroSlides.length > 0 && (
      <div id="hero-cinematic" class="sticky top-0 w-full h-dvh overflow-hidden">
        <CinematicPostEngine slides={heroSlides} maxSlides={15} />
      </div>
    )}

    {/* Lienzo / grilla: se desliza sobre el Hero con fondo sólido (--bg-main) */}
    <div id="home-canvas" class="relative z-20 bg-(--bg-main) shadow-[0_-24px_60px_rgba(0,0,0,0.85)]" style="background-color: var(--bg-main, #121413);">
    <div class="container-editorial max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-32 md:gap-48 lg:gap-60 pt-20 md:pt-32 pb-28 md:pb-44">

      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE 2: DOSSIERES DESTACADOS — MODELO EDITORIAL ARCHIVO GENERAL
      ═══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-32 md:gap-40 lg:gap-56 reveal-item">

        {/* ENCABEZADO EDITORIAL */}
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 pb-4 border-b border-white/8">
          <div>
            <span class="font-metadata text-[10px] uppercase tracking-[0.4em] text-rust-orange block mb-1">Archivo Editorial</span>
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-cinzel font-extrabold tracking-tight" style="background-image: linear-gradient(to bottom, #94A3B8 0%, #64748B 30%, #94A3B8 50%, #475569 75%, #334155 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">
              Dossieres Destacados
            </h2>
          </div>
          <a href="/archivo/" class="font-metadata text-[10px] uppercase tracking-[0.3em] text-white/40 hover:text-rust-orange transition-colors shrink-0 pb-1">
            Ver todo el Archivo →
          </a>
        </div>

        {/* DOSSIER PRINCIPAL — HERO FULL BLEED (ESTILO ARCHIVO GENERAL) */}
        {leadStory && (
          <div class="w-full">
            <CinematicArchiveCard
              slug={leadStory.slug}
              entry={leadStory.entry}
              img={leadImage}
              variant="hero"
              enableCinemagraph={true}
              isEager={true}
              hideExteriorTitle={true}
              centerCtaBelow={true}
              ctaLabel="VER REGISTRO"
            />
          </div>
        )}

        {/* DOSSIER 2 DESTACADO — SECUNDARIO A */}
        {secondaryA && (
          <div class="w-full">
            <CinematicArchiveCard
              slug={secondaryA.slug}
              entry={secondaryA.entry}
              img={secAImage}
              variant="hero"
              enableCinemagraph={true}
              hideExteriorTitle={true}
              centerCtaBelow={true}
              ctaLabel="VER REGISTRO"
            />
          </div>
        )}

        {/* DOSSIER 3 DESTACADO — SECUNDARIO B */}
        {secondaryB && (
          <div class="w-full">
            <CinematicArchiveCard
              slug={secondaryB.slug}
              entry={secondaryB.entry}
              img={secBImage}
              variant="hero"
              enableCinemagraph={true}
              hideExteriorTitle={true}
              centerCtaBelow={true}
              ctaLabel="VER REGISTRO"
            />
          </div>
        )}

      </section>


      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE 3: ENSAYOS RECIENTES — ROW NETFLIX CLÁSICO
      ═══════════════════════════════════════════════════════════════════ */}
      {resolvedRecent.length > 0 && (
        <section class="flex flex-col gap-6 md:gap-8 reveal-item -mx-4 px-4 md:mx-0 md:px-0">
          <RowNetflixClasico 
            title="Ensayos Recientes"
            eyebrow="Archivo de Ensayos"
            items={resolvedRecent}
            max={15}
            actionText={`Ver Catálogo Completo (${publishable.length}) →`}
            actionHref="/archivo/"
            cardAspect="vertical"
          />
        </section>
      )}


      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE 4: COLECCIONES DESTACADAS (§5.4)
          Solo categorías con ≥ 2 artículos publicables. Sin descripciones inventadas.
      ═══════════════════════════════════════════════════════════════════ */}
      {resolvedCollections.length > 0 && (
        <section class="flex flex-col gap-8">
          <div class="reveal-item flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4">
            <div>
              <span class="font-metadata text-[10px] uppercase tracking-[0.4em] text-rust-orange block mb-1">Organización Temática</span>
              <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-cinzel font-extrabold tracking-tight drop-shadow-md" style="background-image: linear-gradient(to bottom, #94A3B8 0%, #64748B 30%, #94A3B8 50%, #475569 75%, #334155 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">
                Colecciones
              </h2>
            </div>
          </div>

          {/* Mobile: scroll horizontal snapping */}
          <div class="flex md:grid md:grid-cols-2 lg:grid-cols-4 gap-4 overflow-x-auto md:overflow-visible snap-x snap-mandatory md:snap-none pb-2 md:pb-0 -mx-4 px-4 md:mx-0 md:px-0">
            {resolvedCollections.map(({ key, label, count, img, coverEssay }) => (
              <a
                href={`/archivo/?categoria=${encodeURIComponent(key)}`}
                class="group shrink-0 w-[72vw] sm:w-[55vw] md:w-auto snap-start bg-white/5 border border-white/10 rounded-xl overflow-hidden hover:border-rust-orange/50 transition-all duration-500 flex flex-col"
              >
                {img ? (
                  <div class="overflow-hidden aspect-video relative">
                    <img src={sanitizeImageUrl(img)} alt={label} loading="lazy" decoding="async" class="transition-transform duration-700 group-hover:scale-105 opacity-70 group-hover:opacity-90 img-nativa" />
                    <div class="absolute inset-0 bg-linear-to-t from-theme-dark/80 to-transparent" />
                    <div class="absolute bottom-0 left-0 p-4">
                      <p class="font-metadata text-[9px] uppercase tracking-[0.3em] text-rust-orange mb-1">{count} artículos</p>
                      <h3 class="font-cinzel font-bold text-lg leading-tight text-white group-hover:text-rust-orange transition-colors">{label}</h3>
                    </div>
                  </div>
                ) : (
                  <div class="p-5 flex flex-col gap-2 flex-1">
                    <p class="font-metadata text-[9px] uppercase tracking-[0.3em] text-rust-orange">{count} artículos</p>
                    <h3 class="font-cinzel font-bold text-lg leading-tight group-hover:text-rust-orange transition-colors">{label}</h3>
                  </div>
                )}
              </a>
            ))}
          </div>
        </section>
      )}

      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE 5: ZONA ARCHIVOS (HEROS FULL BLEED APILADOS COMO ARCHIVO GENERAL)
          Mapeo: publishable[10..19] con formato cinemático idéntico a Por Año
      ═══════════════════════════════════════════════════════════════════ */}
      {resolvedArchiveRows.length > 0 && (
        <section class="flex flex-col gap-10 md:gap-14">
          <div class="reveal-item flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4">
            <div>
              <span class="font-metadata text-[10px] uppercase tracking-[0.4em] text-rust-orange block mb-1">Hemeroteca</span>
              <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-cinzel font-extrabold tracking-tight drop-shadow-md" style="background-image: linear-gradient(to bottom, #94A3B8 0%, #64748B 30%, #94A3B8 50%, #475569 75%, #334155 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">
                Del Archivo
              </h2>
            </div>
            <a href="/archivo/" class="font-metadata text-[10px] uppercase tracking-[0.3em] text-white/50 hover:text-rust-orange transition-colors shrink-0">
              Ver archivo completo ({publishable.length}) →
            </a>
          </div>

          {/* Secuencias Cinematográficas: Heros Full Bleed */}
          <div class="flex flex-col gap-32 md:gap-40 lg:gap-56">
            {resolvedArchiveRows.map((row) => (
              <div class="w-full">
                <CinematicArchiveCard
                  slug={row.slug}
                  entry={row.entry}
                  img={row.img}
                  variant="hero"
                  enableCinemagraph={true}
                  hideExteriorTitle={true}
                  centerCtaBelow={true}
                  ctaLabel="VER REGISTRO"
                />
              </div>
            ))}
          </div>

          <div class="text-center pt-8">
            <a
              href="/archivo/"
              class="group relative inline-flex items-center gap-3.5 font-metadata text-[10.5px] uppercase tracking-[0.35em] px-10 py-4.5 rounded-full bg-[#151718]/90 backdrop-blur-sm border border-white/10 hover:bg-rust-orange/10 hover:border-rust-orange/50 text-[#E0E0E0]/70 hover:text-rust-orange transition-all duration-500 active:scale-95"
            >
              <span>Ver archivo completo ({publishable.length} investigaciones)</span>
              <span class="text-rust-orange group-hover:translate-x-1.5 transition-transform duration-300">→</span>
            </a>
          </div>
        </section>
      )}

      </div>{/* /container-editorial */}

      {/* ═══════════════════════════════════════════════════════════════════
          TRANSICIÓN EDITORIAL: LÍNEA TIPO ARCADA SUTIL + BOTÓN VER MÁS
      ═══════════════════════════════════════════════════════════════════ */}
      {gridItems.length > 0 && (
        <section class="relative w-full overflow-hidden pt-20 md:pt-28 pb-0 flex flex-col items-center justify-center select-none">
          
          {/* Eyebrow & Botón "Ver más" con chevron apuntando hacia abajo */}
          <div class="relative z-20 flex flex-col items-center gap-3.5 mb-10 md:mb-14 px-4 text-center">
            <span class="font-metadata text-[10px] sm:text-[11px] uppercase tracking-[0.4em] text-white/50">
              Colección Exclusiva · Pantalla Completa
            </span>

            <a
              id="btn-ver-mas-cinematicos"
              href="#cg-section"
              class="group relative inline-flex items-center gap-3.5 px-8 py-3.5 sm:px-10 sm:py-4 rounded-xl bg-[#E50914] hover:bg-[#b80710] text-white font-cinzel font-bold text-sm sm:text-base tracking-[0.16em] uppercase shadow-[0_0_35px_rgba(229,9,20,0.5)] hover:shadow-[0_0_55px_rgba(229,9,20,0.85)] transition-all duration-300 hover:scale-[1.03] active:scale-95 cursor-pointer no-underline"
              aria-label="Ver más ensayos cinemáticos"
            >
              <span>Ver más</span>
              {/* Señal hacia abajo: Chevron animado apuntando hacia abajo */}
              <svg 
                class="w-4 h-4 sm:w-5 sm:h-5 transition-transform duration-300 group-hover:translate-y-1.5 animate-bounce text-white" 
                fill="none" 
                viewBox="0 0 24 24" 
                stroke="currentColor" 
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>

          {/* Línea tipo arcada sutil estilo Netflix con resplandor carmesí */}
          <div class="relative w-full overflow-hidden leading-none pointer-events-none -mb-px">
            <svg 
              viewBox="0 0 1440 90" 
              fill="none" 
              preserveAspectRatio="none" 
              class="w-full h-14 sm:h-20 md:h-28 block drop-shadow-[0_-6px_25px_rgba(229,9,20,0.35)]"
            >
              <defs>
                {/* Gradiente lineal horizontal para el trazo de la arcada */}
                <linearGradient id="netflix-arc-stroke" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#E50914" stop-opacity="0" />
                  <stop offset="18%" stop-color="#E50914" stop-opacity="0.25" />
                  <stop offset="40%" stop-color="#FF2A38" stop-opacity="0.9" />
                  <stop offset="50%" stop-color="#FFFFFF" stop-opacity="0.95" />
                  <stop offset="60%" stop-color="#FF2A38" stop-opacity="0.9" />
                  <stop offset="82%" stop-color="#E50914" stop-opacity="0.25" />
                  <stop offset="100%" stop-color="#E50914" stop-opacity="0" />
                </linearGradient>

                {/* Resplandor ambiental bajo el arco hacia el fondo negro */}
                <radialGradient id="netflix-arc-glow" cx="50%" cy="0%" r="65%">
                  <stop offset="0%" stop-color="#E50914" stop-opacity="0.28" />
                  <stop offset="45%" stop-color="#E50914" stop-opacity="0.08" />
                  <stop offset="100%" stop-color="#080808" stop-opacity="0" />
                </radialGradient>
              </defs>

              {/* Área de resplandor ambiental bajo la curva */}
              <path 
                d="M 0,90 Q 720,12 1440,90 L 1440,90 L 0,90 Z" 
                fill="url(#netflix-arc-glow)" 
              />

              {/* Trazo sutil de la arcada */}
              <path 
                d="M 0,90 Q 720,12 1440,90" 
                stroke="url(#netflix-arc-stroke)" 
                stroke-width="3" 
                stroke-linecap="round"
              />
            </svg>
          </div>

        </section>
      )}

      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE FINAL: VERTICAL CINEMATIC GRID (DEBAJO DE TODO)
      ═══════════════════════════════════════════════════════════════════ */}
      {gridItems.length > 0 && (
        <div id="seccion-ensayos-cinematicos" class="relative z-30 w-full bg-[#080808]">
          <CinematicGrid items={gridItems} title="Ensayos Cinemáticos" />
        </div>
      )}

    </div>{/* /#home-canvas */}
  </div>
</Layout>

<script>
  const setupCinematicScroll = () => {
    const btn = document.getElementById('btn-ver-mas-cinematicos');
    if (!btn) return;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const target = document.getElementById('cg-section');
      if (!target) return;
      // @ts-ignore
      const smoother = window.ScrollSmoother?.get();
      if (smoother) {
        smoother.scrollTo(target, true, "top top");
      } else {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  };

  document.addEventListener('DOMContentLoaded', setupCinematicScroll);
  document.addEventListener('astro:page-load', setupCinematicScroll);
</script>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const setupHomeScrollytelling = () => {
    const hero = document.getElementById('hero-cinematic');
    const bg = hero?.querySelector('img');
    if (!hero || !bg) return;

    ScrollTrigger.getAll().forEach((t) => {
      if (t.trigger === hero) t.kill();
    });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    gsap.to(bg, {
      scale: 0.95,
      opacity: 0,
      y: 50,
      ease: 'none',
      scrollTrigger: {
        trigger: hero,
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
    });

    const content = hero.querySelector('.content-layer');
    if (content) {
      gsap.to(content, {
        opacity: 0,
        y: 40,
        ease: 'none',
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
    }
  };

  document.addEventListener('DOMContentLoaded', setupHomeScrollytelling);
  document.addEventListener('astro:page-load', setupHomeScrollytelling);
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    .reveal-item { transition: none !important; opacity: 1 !important; transform: none !important; }
  }
</style>
