<script>
  const setupHomeAnimation = () => {
    const heroHome = document.querySelector('.hero-home');
    if (!heroHome) return;
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const h1 = entry.target.querySelector('h1');
          const content = entry.target.querySelector('.hero-content');
          if (h1) h1.classList.add('revealed');
          if (content) {
            content.classList.remove('opacity-0', 'translate-y-8');
            content.classList.add('opacity-100', 'translate-y-0');
          }
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    observer.observe(heroHome);
  };
  document.addEventListener('DOMContentLoaded', setupHomeAnimation);
  document.addEventListener('astro:page-load', setupHomeAnimation);
</script>

<style>
  @keyframes reverseKenBurns {
    0%   { transform: scale(1.06) translateY(1%); }
    100% { transform: scale(1) translateY(0); }
  }
  .hero-reverse-ken-burns {
    animation: reverseKenBurns 10s cubic-bezier(0.25, 1, 0.5, 1) 1 forwards;
  }
  .hero-content {
    transition: all 1.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: 0.2s;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-reverse-ken-burns { animation: none !important; transform: none !important; }
    .hero-content, .reveal-item { transition: none !important; opacity: 1 !important; transform: none !important; }
  }
</style>
