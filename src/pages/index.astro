---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import SpotifyIcon from '../components/icons/Spotify.astro';
import YouTubeIcon from '../components/icons/YouTube.astro';
import {
  getPublishableEssays,
  groupByCategory,
  formatCategory,
  formatDate,
  formatYear,
  normalizeCategory,
  resolveEssayImage,
} from '../lib/content-filter';

// ─── CARGA Y FILTRADO CENTRALIZADO ───────────────────────────────────────────
const allEssaysRaw = await getCollection('ensayos').catch(err => {
  console.error("[INDEX] Falló carga de ensayos:", err);
  return [];
});

const allGeorefsRaw = await getCollection('georreferencias').catch(err => {
  console.error("[INDEX] Falló carga de georreferencias:", err);
  return [];
});

const isProd = import.meta.env.PROD;
const publishableEssays = getPublishableEssays(allEssaysRaw, isProd);
const publishableGeorefs = getPublishableEssays(allGeorefsRaw, isProd);

const publishable = [...publishableEssays, ...publishableGeorefs].sort((a, b) => {
  const dateA = a.entry.date ? new Date(a.entry.date).getTime() : 0;
  const dateB = b.entry.date ? new Date(b.entry.date).getTime() : 0;
  return dateB - dateA;
});

// ─── SEGMENTACIÓN EDITORIAL (sin repeticiones) ────────────────────────────────
const heroEssay    = publishable[0] ?? null;
const leadStory    = publishable[1] ?? null;
const secondaryA   = publishable[2] ?? null;
const secondaryB   = publishable[3] ?? null;
const recentEssays = publishable.slice(4, 10);           // 4–6 artículos
const archiveRows  = publishable.slice(10, 20);          // índice compacto (§5.5)

// ─── COLECCIONES DESTACADAS (§5.4) ────────────────────────────────────────────
// Solo categorías con ≥ 2 artículos publicables. Sin inventar descripciones.
const categoryGroups = groupByCategory(publishable, 2);
const collections = Array.from(categoryGroups.entries())
  .map(([key, essays]) => ({
    key,
    label: formatCategory(essays[0].entry.category),
    count: essays.length,
    coverEssay: essays[0],
  }))
  .slice(0, 4); // máx 4 colecciones en portada

// ─── IMAGEN HERO OBJECT-POSITION ──────────────────────────────────────────────
const heroImagePosition = (heroEssay?.entry as any)?.coverImagePosition
  || (heroEssay?.entry as any)?.imagePosition
  || 'center center';
const heroOrigin = (heroEssay?.entry as any)?.heroOrigin
  || (heroEssay?.entry as any)?.transformOrigin
  || 'center center';

// ─── CARGA DE IMÁGENES CON RESOLUCIÓN INTELIGENTE ─────────────────────────────
const heroImage  = resolveEssayImage(heroEssay?.entry.coverImage, heroEssay?.slug);
const leadImage  = resolveEssayImage(leadStory?.entry.coverImage, leadStory?.slug);
const secAImage  = resolveEssayImage(secondaryA?.entry.coverImage, secondaryA?.slug);
const secBImage  = resolveEssayImage(secondaryB?.entry.coverImage, secondaryB?.slug);

const resolvedRecent = recentEssays.map(e => ({
  ...e,
  img: resolveEssayImage(e.entry.coverImage, e.slug),
}));

const resolvedArchiveRows = archiveRows.map(e => ({
  ...e,
  img: resolveEssayImage(e.entry.coverImage, e.slug),
}));

const resolvedCollections = collections.map(c => ({
  ...c,
  img: resolveEssayImage(c.coverEssay.entry.coverImage, c.coverEssay.slug),
}));
---

<Layout title="Hemeroteca TGP - Editorial & Cartografía Epistémica">
  <div class="w-full bg-theme-dark text-[#F5F5F7] pb-20">

    {/* ═══════════════════════════════════════════════════════════════════════
        BLOQUE 1: HERO CINEMATOGRÁFICO FULL-BLEED
        Mapeo: sortedPublishable[0]
    ═══════════════════════════════════════════════════════════════════════ */}
    {heroEssay && (
      <section
        class="hero-home relative w-full h-[74svh] md:h-[65vh] lg:h-[78vh] min-h-130 flex flex-col justify-end pb-12 md:pb-16 lg:pb-20 px-6 md:px-12 lg:px-24 overflow-hidden border-b border-white/10"
        style={`--hero-origin: ${heroOrigin};`}
      >
        {/* Background full-bleed con reverse Ken Burns */}
        <div class="absolute inset-0 z-0 bg-theme-dark overflow-hidden pointer-events-none">
          {heroImage ? (
            <Image
              src={heroImage}
              alt={`Portada de ${heroEssay.entry.title}`}
              class="w-full h-full object-cover opacity-90 hero-reverse-ken-burns"
              style={`object-position: ${heroImagePosition}; transform-origin: ${heroOrigin};`}
            />
          ) : (
            <div class="w-full h-full bg-white/5 opacity-40 hero-reverse-ken-burns" />
          )}
          <div class="absolute inset-0 bg-linear-to-t from-theme-dark via-theme-dark/50 to-transparent pointer-events-none z-0" />
          <div class="absolute inset-0 bg-radial-[ellipse_85%_65%_at_15%_100%] from-theme-dark/90 via-theme-dark/35 to-transparent pointer-events-none z-0" />
        </div>

        <div class="relative z-10 w-full max-w-5xl">
          <div class="hero-content flex flex-col gap-4">
            <div class="reveal-item flex items-center gap-3 font-mono text-[10px] md:text-[11px] uppercase tracking-[0.3em] text-[#C8A98B]">
              <span class="px-2.5 py-0.5 bg-white/10 backdrop-blur-md rounded-full border border-white/10 text-white font-bold text-[9px]">Destacado</span>
              <span class="opacity-40">•</span>
              <span>{formatCategory(heroEssay.entry.category)}</span>
              <span class="opacity-40">•</span>
              <span class="text-white/60">{formatYear(heroEssay.entry.date)}</span>
            </div>

            <h1 class="text-[clamp(3.25rem,7.5vw,8.5rem)] leading-[0.98] font-serif tracking-tight antialiased max-w-5xl pt-1 pb-2 bg-linear-to-b from-white via-white/95 to-white/70 bg-clip-text text-transparent drop-shadow-2xl">
              {heroEssay.entry.title}
            </h1>

            {heroEssay.entry.excerpt && (
              <p class="font-serif text-base md:text-lg lg:text-xl text-white/80 leading-relaxed max-w-2xl lg:max-w-3xl line-clamp-2 italic">
                "{heroEssay.entry.excerpt}"
              </p>
            )}

            <div class="reveal-item mt-2">
              <a
                href={`/hemeroteca/${heroEssay.slug}`}
                class="group inline-flex items-center gap-4 border border-white/20 bg-white/10 backdrop-blur-md px-7 py-3.5 rounded-full hover:bg-[#C8A98B] hover:border-[#C8A98B] hover:text-theme-dark transition-all duration-500"
              >
                <span class="font-mono text-[10px] uppercase tracking-[0.3em] font-bold">Leer Investigación</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform duration-300"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <div class="container-editorial max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-20 md:gap-28 pt-16 md:pt-24">

      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE 2: TRES HISTORIAS PRINCIPALES
          Mapeo: [1] lead (8 cols) + [2] secA + [3] secB (4 cols apiladas)
      ═══════════════════════════════════════════════════════════════════ */}
      {(leadStory || secondaryA) && (
        <section class="flex flex-col gap-8">
          <div class="reveal-item flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-white/10 pb-6">
            <div>
              <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B] block mb-1">Dossieres Seleccionados</span>
              <h2 class="text-3xl md:text-5xl font-cinzel font-extrabold tracking-tight bg-linear-to-r from-white via-[#E2E8F0] to-[#94A3B8] bg-clip-text text-transparent drop-shadow-md">
                Historias Fundamentales
              </h2>
            </div>
            <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-white/40">Perspectivas Cruciales</span>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
            {/* Historia Principal: 8 cols */}
            {leadStory && (
              <article class="lg:col-span-8 group flex flex-col justify-between bg-white/5 border border-white/10 rounded-xl overflow-hidden p-6 md:p-8 hover:border-[#C8A98B]/50 transition-all duration-500">
                <div class="flex flex-col gap-6">
                  {leadImage && (
                    <div class="overflow-hidden rounded-lg bg-black/40 aspect-video relative">
                      <Image src={leadImage} alt={leadStory.entry.title || "Historia"} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                      <div class="absolute inset-0 bg-linear-to-t from-theme-dark/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" />
                    </div>
                  )}
                  <div class="flex items-center gap-3 font-mono text-[9px] text-[#C8A98B] tracking-[0.2em] uppercase">
                    <span class="px-2.5 py-0.5 bg-white/10 rounded-full border border-white/10">{formatCategory(leadStory.entry.category)}</span>
                    <span class="opacity-30">•</span>
                    <span class="text-white/40">{formatDate(leadStory.entry.date)}</span>
                  </div>
                  <h3 class="text-2xl md:text-4xl font-cinzel font-bold leading-tight group-hover:text-[#C8A98B] transition-colors duration-300">
                    <a href={`/hemeroteca/${leadStory.slug}`} class="hover:underline">{leadStory.entry.title}</a>
                  </h3>
                  {leadStory.entry.excerpt && (
                    <p class="font-serif text-white/70 text-base md:text-lg leading-relaxed line-clamp-3 italic">"{leadStory.entry.excerpt}"</p>
                  )}
                </div>
                <div class="mt-8 pt-4 border-t border-white/5 flex items-center justify-between font-mono text-[9px] uppercase tracking-[0.3em] text-white/40">
                  <a href={`/hemeroteca/${leadStory.slug}`} class="inline-flex items-center gap-2 hover:text-[#C8A98B] transition-colors">Explorar Dossier →</a>
                  {(leadStory.entry.spotifyLink || leadStory.entry.youtubeLink) && (
                    <div class="flex items-center gap-3">
                      {leadStory.entry.spotifyLink && <a href={leadStory.entry.spotifyLink} target="_blank" rel="noopener noreferrer" class="opacity-40 hover:opacity-100 hover:text-[#C8A98B] transition-all"><SpotifyIcon class="w-3.5 h-3.5" /></a>}
                      {leadStory.entry.youtubeLink && <a href={leadStory.entry.youtubeLink} target="_blank" rel="noopener noreferrer" class="opacity-40 hover:opacity-100 hover:text-[#C8A98B] transition-all"><YouTubeIcon class="w-3.5 h-3.5" /></a>}
                    </div>
                  )}
                </div>
              </article>
            )}

            {/* Secundarias: 4 cols apiladas */}
            <div class="lg:col-span-4 flex flex-col gap-8 justify-between">
              {secondaryA && (
                <article class="group flex-1 flex flex-col justify-between bg-white/5 border border-white/10 rounded-xl overflow-hidden p-6 hover:border-[#C8A98B]/50 transition-all duration-500">
                  <div class="flex flex-col gap-4">
                    {secAImage && (
                      <div class="overflow-hidden rounded-lg bg-black/40 aspect-video relative">
                        <Image src={secAImage} alt={secondaryA.entry.title || "Historia"} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                      </div>
                    )}
                    <div class="flex items-center gap-3 font-mono text-[9px] text-[#C8A98B] tracking-[0.2em] uppercase">
                      <span>{formatCategory(secondaryA.entry.category)}</span>
                      <span class="opacity-30">•</span>
                      <span class="text-white/40">{formatDate(secondaryA.entry.date)}</span>
                    </div>
                    <h3 class="text-xl md:text-2xl font-cinzel font-bold leading-tight group-hover:text-[#C8A98B] transition-colors duration-300">
                      <a href={`/hemeroteca/${secondaryA.slug}`} class="hover:underline">{secondaryA.entry.title}</a>
                    </h3>
                    {secondaryA.entry.excerpt && (
                      <p class="font-serif text-white/60 text-sm leading-relaxed line-clamp-2 italic">"{secondaryA.entry.excerpt}"</p>
                    )}
                  </div>
                  <div class="mt-6 pt-4 border-t border-white/5 font-mono text-[9px] uppercase tracking-[0.3em] text-white/40">
                    <a href={`/hemeroteca/${secondaryA.slug}`} class="hover:text-[#C8A98B] transition-colors">Explorar →</a>
                  </div>
                </article>
              )}
              {secondaryB && (
                <article class="group flex-1 flex flex-col justify-between bg-white/5 border border-white/10 rounded-xl overflow-hidden p-6 hover:border-[#C8A98B]/50 transition-all duration-500">
                  <div class="flex flex-col gap-4">
                    {secBImage && (
                      <div class="overflow-hidden rounded-lg bg-black/40 aspect-video relative">
                        <Image src={secBImage} alt={secondaryB.entry.title || "Historia"} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                      </div>
                    )}
                    <div class="flex items-center gap-3 font-mono text-[9px] text-[#C8A98B] tracking-[0.2em] uppercase">
                      <span>{formatCategory(secondaryB.entry.category)}</span>
                      <span class="opacity-30">•</span>
                      <span class="text-white/40">{formatDate(secondaryB.entry.date)}</span>
                    </div>
                    <h3 class="text-xl md:text-2xl font-cinzel font-bold leading-tight group-hover:text-[#C8A98B] transition-colors duration-300">
                      <a href={`/hemeroteca/${secondaryB.slug}`} class="hover:underline">{secondaryB.entry.title}</a>
                    </h3>
                    {secondaryB.entry.excerpt && (
                      <p class="font-serif text-white/60 text-sm leading-relaxed line-clamp-2 italic">"{secondaryB.entry.excerpt}"</p>
                    )}
                  </div>
                  <div class="mt-6 pt-4 border-t border-white/5 font-mono text-[9px] uppercase tracking-[0.3em] text-white/40">
                    <a href={`/hemeroteca/${secondaryB.slug}`} class="hover:text-[#C8A98B] transition-colors">Explorar →</a>
                  </div>
                </article>
              )}
            </div>
          </div>
        </section>
      )}

      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE 3: ENSAYOS RECIENTES (tarjetas horizontales)
          Mapeo: publishable[4..9] (máx 6)
      ═══════════════════════════════════════════════════════════════════ */}
      {resolvedRecent.length > 0 && (
        <section class="flex flex-col gap-8">
          <div class="reveal-item flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-white/10 pb-6">
            <div>
              <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B] block mb-1">Archivo de Ensayos</span>
              <h2 class="text-3xl md:text-5xl font-cinzel font-extrabold tracking-tight bg-linear-to-r from-white via-[#E2E8F0] to-[#94A3B8] bg-clip-text text-transparent drop-shadow-md">
                Ensayos Recientes
              </h2>
            </div>
            <a href="/archivo" class="font-mono text-[10px] uppercase tracking-[0.3em] text-white/50 hover:text-[#C8A98B] transition-colors">
              Ver Catálogo Completo ({publishable.length}) →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
            {resolvedRecent.map(({ slug, entry, img }) => (
              <article class="group bg-white/5 border border-white/10 rounded-xl p-5 md:p-6 flex flex-col gap-4 hover:border-[#C8A98B]/50 transition-all duration-500">
                {/* Horizontal: imagen izq, texto der en md+ */}
                <div class={img ? "flex flex-col md:flex-row gap-5 items-start" : "flex flex-col gap-3"}>
                  {img && (
                    <div class="w-full md:w-2/5 shrink-0 overflow-hidden rounded-lg bg-black/40 aspect-video md:aspect-auto md:h-32 relative">
                      <Image src={img} alt={entry.title || "Ensayo"} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                    </div>
                  )}
                  <div class="flex flex-col gap-2 flex-1 min-w-0">
                    <div class="flex items-center gap-3 font-mono text-[9px] text-[#C8A98B] tracking-[0.2em] uppercase">
                      <span>{formatCategory(entry.category)}</span>
                      <span class="opacity-30">•</span>
                      <span class="text-white/40">{formatYear(entry.date)}</span>
                    </div>
                    <h3 class="text-xl font-cinzel font-bold leading-tight group-hover:text-[#C8A98B] transition-colors duration-300 line-clamp-2">
                      <a href={`/hemeroteca/${slug}`} class="hover:underline">{entry.title}</a>
                    </h3>
                    {entry.excerpt && (
                      <p class="font-serif text-white/60 text-sm leading-relaxed line-clamp-2 italic">"{entry.excerpt}"</p>
                    )}
                  </div>
                </div>
                <div class="pt-3 border-t border-white/5 flex items-center justify-between font-mono text-[9px] uppercase tracking-[0.3em] text-white/40">
                  <a href={`/hemeroteca/${slug}`} class="hover:text-[#C8A98B] transition-colors">Explorar →</a>
                  {(entry.spotifyLink || entry.youtubeLink) && (
                    <div class="flex items-center gap-3">
                      {entry.spotifyLink && <a href={entry.spotifyLink} target="_blank" rel="noopener noreferrer" class="opacity-40 hover:opacity-100 hover:text-[#C8A98B] transition-all"><SpotifyIcon class="w-3.5 h-3.5" /></a>}
                      {entry.youtubeLink && <a href={entry.youtubeLink} target="_blank" rel="noopener noreferrer" class="opacity-40 hover:opacity-100 hover:text-[#C8A98B] transition-all"><YouTubeIcon class="w-3.5 h-3.5" /></a>}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE 4: COLECCIONES DESTACADAS (§5.4)
          Solo categorías con ≥ 2 artículos publicables. Sin descripciones inventadas.
      ═══════════════════════════════════════════════════════════════════ */}
      {resolvedCollections.length > 0 && (
        <section class="flex flex-col gap-8">
          <div class="reveal-item flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-white/10 pb-6">
            <div>
              <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B] block mb-1">Organización Temática</span>
              <h2 class="text-3xl md:text-5xl font-cinzel font-extrabold tracking-tight bg-linear-to-r from-white via-[#E2E8F0] to-[#94A3B8] bg-clip-text text-transparent drop-shadow-md">
                Colecciones
              </h2>
            </div>
          </div>

          {/* Mobile: scroll horizontal snapping */}
          <div class="flex md:grid md:grid-cols-2 lg:grid-cols-4 gap-4 overflow-x-auto md:overflow-visible snap-x snap-mandatory md:snap-none pb-2 md:pb-0 -mx-4 px-4 md:mx-0 md:px-0">
            {resolvedCollections.map(({ key, label, count, img, coverEssay }) => (
              <a
                href={`/archivo?categoria=${encodeURIComponent(key)}`}
                class="group shrink-0 w-[72vw] sm:w-[55vw] md:w-auto snap-start bg-white/5 border border-white/10 rounded-xl overflow-hidden hover:border-[#C8A98B]/50 transition-all duration-500 flex flex-col"
              >
                {img ? (
                  <div class="overflow-hidden aspect-video relative">
                    <Image src={img} alt={label} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-70 group-hover:opacity-90" />
                    <div class="absolute inset-0 bg-linear-to-t from-theme-dark/80 to-transparent" />
                    <div class="absolute bottom-0 left-0 p-4">
                      <p class="font-mono text-[9px] uppercase tracking-[0.3em] text-[#C8A98B] mb-1">{count} artículos</p>
                      <h3 class="font-cinzel font-bold text-lg leading-tight text-white group-hover:text-[#C8A98B] transition-colors">{label}</h3>
                    </div>
                  </div>
                ) : (
                  <div class="p-5 flex flex-col gap-2 flex-1">
                    <p class="font-mono text-[9px] uppercase tracking-[0.3em] text-[#C8A98B]">{count} artículos</p>
                    <h3 class="font-cinzel font-bold text-lg leading-tight group-hover:text-[#C8A98B] transition-colors">{label}</h3>
                  </div>
                )}
              </a>
            ))}
          </div>
        </section>
      )}

      {/* ═══════════════════════════════════════════════════════════════════
          BLOQUE 5: ACCESO BREVE AL ARCHIVO (§5.5)
          Índice compacto: AÑO · CATEGORÍA · TÍTULO
          Mapeo: publishable[10..19]
      ═══════════════════════════════════════════════════════════════════ */}
      {archiveRows.length > 0 && (
        <section class="flex flex-col gap-6">
          <div class="reveal-item flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-white/10 pb-6">
            <div>
              <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B] block mb-1">Hemeroteca</span>
              <h2 class="text-3xl md:text-5xl font-cinzel font-extrabold tracking-tight bg-linear-to-r from-white via-[#E2E8F0] to-[#94A3B8] bg-clip-text text-transparent drop-shadow-md">
                Del Archivo
              </h2>
            </div>
            <a href="/archivo" class="font-mono text-[10px] uppercase tracking-[0.3em] text-white/50 hover:text-[#C8A98B] transition-colors shrink-0">
              Ver archivo completo →
            </a>
          </div>

          {/* Grilla Editorial Prolija Estilo Suizo con Miniaturas */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {resolvedArchiveRows.map(({ slug, entry, img }) => (
              <a
                href={`/hemeroteca/${slug}`}
                class="group flex items-center gap-4 p-3.5 md:p-4 bg-white/3 border border-white/8 rounded-xl hover:border-[#C8A98B]/40 hover:bg-white/5 transition-all duration-400 overflow-hidden"
              >
                {img ? (
                  <div class="w-16 h-12 md:w-20 md:h-14 shrink-0 overflow-hidden rounded-lg bg-black/40 aspect-video relative">
                    <Image src={img} alt={entry.title || "Ensayo"} class="w-full h-full object-cover opacity-80 group-hover:scale-105 group-hover:opacity-100 transition-all duration-500" />
                  </div>
                ) : (
                  <div class="w-16 h-12 md:w-20 md:h-14 shrink-0 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center font-mono text-[9px] text-[#C8A98B]">
                    TGP
                  </div>
                )}
                <div class="flex flex-col gap-1 min-w-0 flex-1">
                  <div class="flex items-center gap-2 font-mono text-[9px] text-[#C8A98B] tracking-[0.2em] uppercase">
                    <span>{formatCategory(entry.category)}</span>
                    <span class="opacity-30">•</span>
                    <span class="text-white/40 tabular-nums">{formatYear(entry.date)}</span>
                  </div>
                  <h3 class="font-cinzel text-sm md:text-base text-white/90 group-hover:text-[#C8A98B] transition-colors leading-snug line-clamp-1">
                    {entry.title}
                  </h3>
                  {entry.excerpt && (
                    <p class="font-sans text-xs text-white/50 line-clamp-1 font-light tracking-wide italic">
                      "{entry.excerpt}"
                    </p>
                  )}
                </div>
