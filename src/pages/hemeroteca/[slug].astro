  }
  .post-toc-empty { font-size: 0.72rem; font-style: italic; color: rgba(255,255,255,0.25); }

  /* ── Cuerpo central ── */
  .post-body-col { grid-area: body; min-width: 0; }

  /* ── Sidebar derecho ── */
  .post-sidebar-col { grid-area: sidebar; display: none; }
  @media (min-width: 1200px) { .post-sidebar-col { display: block; } }

  .post-sidebar-inner {
    position: sticky;
    top: 6rem;
    display: flex;
