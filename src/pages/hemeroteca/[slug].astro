---
import { render, getEntry, getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import SpotifyIcon from "../../components/icons/Spotify.astro";
import YouTubeIcon from "../../components/icons/YouTube.astro";
import { marked } from 'marked';
import { StickyReaderHeader } from "../../components/StickyReaderHeader";
import { QuickReturnButton } from "../../components/QuickReturnButton";
import SubstackPrefooter from "../../components/SubstackPrefooter.astro";
import RelatedReading from "../../components/RelatedReading.astro";
import ExploreMore from "../../components/ExploreMore.astro";
import { resolveEssayImage, essayImages } from "../../lib/content-filter";

export const prerender = true;
export async function getStaticPaths() {
  const essays = await getCollection("ensayos");
  // Nota: No filtramos por draft para asegurar que se generen todos los ensayos solicitados (27+)

  return essays.map((item) => ({
    params: { slug: item.id.replace(/\/index$/, "") },
    props: { data: item.data },
  }));
}

const { slug } = Astro.params;
const { data } = Astro.props;

// 1. Cargar contenido raw de .mdoc si existe en disco
const rawMdocs = import.meta.glob<string>(
  "/src/content/ensayos/**/content.mdoc",
  { query: '?raw', import: 'default', eager: true }
);

const mdocKey = `/src/content/ensayos/${slug}/content.mdoc`;
const rawMdocText = rawMdocs[mdocKey] || '';

// 2. Carga segura del componente Markdoc si existe
let Content: any = null;
try {
  const contentEntry = await getEntry("ensayosContent", `${slug}/content`);
  if (contentEntry) {
    const rendered = await render(contentEntry);
    Content = rendered.Content;
  }
} catch (err) {
  // Fallback silencioso
}

// 3. Resolución universal y resiliente del texto del ensayo
let finalMarkdownText = '';
if (rawMdocText && rawMdocText.trim().length > 0) {
  finalMarkdownText = rawMdocText.trim();
} else if ((data as any).generadorTexto && (data as any).generadorTexto.trim().length > 0) {
  finalMarkdownText = (data as any).generadorTexto.trim();
} else if (data.generador && data.generador.length > 50) {
  finalMarkdownText = data.generador.trim();
}

// 4. Procesar HTML y vincular imágenes relativas a los assets procesados de Vite
let renderedHtml = '';
if (finalMarkdownText) {
  renderedHtml = marked.parse(finalMarkdownText) as string;
  // Reemplazar rutas de assets /src/assets/ensayos/... por su URL procesada por Vite
  for (const [imgKey, imgModule] of Object.entries(essayImages)) {
    if (renderedHtml.includes(imgKey)) {
      renderedHtml = renderedHtml.replaceAll(imgKey, imgModule.default.src);
    }
  }
}

// 5. Resolución de imagen de portada (exacta o auto-detectada de la carpeta)
const optimizedImage = resolveEssayImage(data.coverImage, slug);

const roomColors: Record<string, string> = {
  "british-green": "#1B382A",
  bordeaux: "#5B2326",
  "old-navy": "#1E2C3A",
  "bus-red": "#8B3A36",
  "vintage-yellow": "#D4A352",
  "rust-orange": "#B55A30",
};
const activeAccent = data.themeColor
  ? roomColors[data.themeColor] || "#ffffff"
  : "#ffffff";
const imagePosition = (data as any).coverImagePosition || (data as any).imagePosition || 'center center';
const heroOrigin = (data as any).heroOrigin || (data as any).transformOrigin || 'center center';
---

<Layout hideHeader={true} footerVariant="minimal" title={`${data.title} | Hemeroteca TGP`}>
  <StickyReaderHeader client:load title={data.title || "Ensayo TGP"} accentColor={activeAccent} />
  <QuickReturnButton client:load accentColor={activeAccent} />

  {/* 2. Hero Cinemático iOS-Style Full-Bleed con Reverse Ken Burns */}
  <section
    class="hero-section relative w-full h-[88vh] md:h-[90vh] lg:h-[95vh] min-h-160 flex flex-col justify-end pb-16 md:pb-24 lg:pb-28 px-6 md:px-14 lg:px-24 z-10 overflow-hidden"
    style={`--hero-origin: ${heroOrigin};`}
  >
    {/* Imagen de Fondo Full Bleed con Reverse Ken Burns */}
    <div class="absolute inset-0 -z-10 bg-theme-dark overflow-hidden pointer-events-none">
      {
        optimizedImage ? (
          <Image
            src={optimizedImage}
            alt={`Portada de ${data.title}`}
            class="w-full h-full object-cover opacity-90 hero-reverse-ken-burns"
            style={`object-position: ${imagePosition}; transform-origin: ${heroOrigin};`}
          />
        ) : (
          <div class="w-full h-full bg-white/5 opacity-40 hero-reverse-ken-burns" />
        )
      }
      {/* Gradiente Localizado Detrás del Texto (Preserva >65% Luminosidad en la Fotografía) */}
      <div
        class="absolute inset-0 bg-linear-to-t from-theme-dark via-theme-dark/50 to-transparent pointer-events-none z-0"
      ></div>
      <div
        class="absolute inset-0 bg-radial-[ellipse_85%_65%_at_15%_100%] from-theme-dark/90 via-theme-dark/35 to-transparent pointer-events-none z-0"
      ></div>
    </div>

    {/* Contenido Editorial del Hero (iOS Style Wide Bounds) */}
    <div class="relative z-10 max-w-7xl lg:max-w-360 w-full mx-auto">
      {/* Categoría y Año */}
      <div
        class="mb-3 font-mono text-[10px] md:text-[11px] flex items-center gap-3 uppercase tracking-[0.3em] text-[#C8A98B]"
      >
        <span>[ {data.category || "ARCHIVO CLASIFICADO"} ]</span>
        <span class="opacity-40">—</span>
        <span class="text-white/60">{data.date ? new Date(data.date).getFullYear() : "S/F"}</span>
      </div>

      {/* Título Display Monumental con Acero Pulido / Titanio Cinemático */}
      <h1
        class="text-[clamp(3.25rem,7.5vw,8.5rem)] leading-[0.98] font-serif font-display tracking-tight antialiased max-w-5xl pt-2 pb-3 bg-linear-to-b from-white via-[#CBD5E1] via-45% to-[#64748B] bg-clip-text text-transparent drop-shadow-2xl"
      >
        {data.title}
      </h1>

      {/* Bajada Breve */}
      {data.excerpt && (
        <p class="font-serif font-light text-base md:text-lg lg:text-xl text-white/80 leading-normal max-w-2xl lg:max-w-3xl italic mt-2 line-clamp-2">
          "{data.excerpt}"
        </p>
      )}

      {/* Podcast Icons en el ángulo inferior derecho del Hero */}
      {(data.spotifyLink || data.youtubeLink) && (
        <div class="absolute bottom-0 right-0 hidden md:flex items-center gap-6 text-white">
          {data.spotifyLink && (
            <a 
              href={data.spotifyLink} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group/pod flex flex-col items-center gap-1.5"
            >
              <div class="p-2.5 rounded-full border border-white/10 bg-white/5 group-hover/pod:border-[#C8A98B]/50 group-hover/pod:bg-[#C8A98B]/10 transition-all duration-500">
                <SpotifyIcon class="w-4 h-4 opacity-50 group-hover/pod:opacity-100 transition-all duration-500" />
              </div>
              <span class="text-[7px] tracking-[0.4em] opacity-30 group-hover/pod:opacity-100 transition-all duration-500 font-mono">SPOTIFY</span>
            </a>
          )}
          {data.youtubeLink && (
            <a 
              href={data.youtubeLink} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group/pod flex flex-col items-center gap-1.5"
            >
              <div class="p-2.5 rounded-full border border-white/10 bg-white/5 group-hover/pod:border-[#C8A98B]/50 group-hover/pod:bg-[#C8A98B]/10 transition-all duration-500">
                <YouTubeIcon class="w-4 h-4 opacity-50 group-hover/pod:opacity-100 transition-all duration-500" />
              </div>
              <span class="text-[7px] tracking-[0.4em] opacity-30 group-hover/pod:opacity-100 transition-all duration-500 font-mono">YOUTUBE</span>
            </a>
          )}
        </div>
      )}
    </div>
  </section>

  {/* 5. Transición Fluida al Contenido */}
  <article
    class="w-full bg-theme-dark relative z-20 pt-24 pb-32 px-6 md:px-8 shadow-[0_-20px_50px_rgba(18,20,19,1)]"
    style={`--theme-accent: ${activeAccent};`}
  >
    {/* Capas FX: Aura Atmosférica sutil */}
    <div
      class="pointer-events-none absolute inset-0 opacity-20"
      style="background: radial-gradient(circle at 50% 20%, var(--theme-accent) 0%, transparent 70%); mix-blend-screen;"
    >
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-7xl mx-auto relative z-10 px-4 md:px-8">
      
      {/* 1. Canal Izquierdo: Marginalia Contemporánea */}
      <aside class="col-span-12 lg:col-span-3 hidden lg:block sticky top-32 h-fit">
        <div class="p-6 border-l border-white/10 bg-white/5 rounded-sm">
          <p class="font-serif italic font-light text-[#C8A98B]/80 text-sm leading-normal">
            "La verdad no es algo que se encuentra, es algo que se recuerda."
          </p>
          <p class="mt-4 font-mono text-[10px] uppercase tracking-widest text-white/40">Contexto: Archivo Base</p>
        </div>
      </aside>

      {/* 2. Columna Central: Ensayo Principal */}
      <div class="col-span-12 lg:col-span-6">
        {
          data.excerpt && (
            <div class="border-l border-[#C8A98B]/30 pl-8 mb-16 max-w-2xl">
              <p class="text-2xl md:text-3xl font-serif font-light opacity-90 italic text-[#C8A98B] leading-normal tracking-wide">
                "{data.excerpt}"
              </p>
            </div>
          )
        }

        {/* Redacción Editorial */}
        <div
          class="prose prose-invert prose-lg max-w-none
          prose-p:font-body prose-p:font-light prose-p:not-italic prose-p:text-[1.25rem] prose-p:leading-[1.9] prose-p:tracking-[0.01em] prose-p:text-white/80 prose-p:mb-10 prose-p:text-left
          prose-h1:hidden
          prose-h2:font-sans prose-h2:not-italic prose-h2:font-medium prose-h2:tracking-tight prose-h2:mt-16 prose-h2:mb-6 prose-h2:leading-snug
          prose-h3:font-body prose-h3:font-light prose-h3:italic prose-h3:text-stone-300 prose-h3:leading-normal prose-h3:mt-12 prose-h3:mb-4
          prose-h4:font-sans prose-h4:font-extralight prose-h4:tracking-widest prose-h4:uppercase prose-h4:text-xs prose-h4:text-[#C8A98B] prose-h4:leading-normal prose-h4:mt-10 prose-h4:mb-3
          prose-strong:font-medium prose-strong:text-white/95
          prose-blockquote:border-l-3 prose-blockquote:border-[#C8A98B] prose-blockquote:bg-white/3 prose-blockquote:text-white/90 prose-blockquote:p-8 prose-blockquote:md:p-10 prose-blockquote:my-10 prose-blockquote:rounded-r-2xl prose-blockquote:shadow-xl prose-blockquote:text-xl prose-blockquote:md:text-2xl prose-blockquote:leading-relaxed prose-blockquote:font-serif prose-blockquote:font-light prose-blockquote:italic
          prose-a:border-b prose-a:border-[#C8A98B]/40 prose-a:text-[#C8A98B] hover:prose-a:text-white transition-colors
          prose-img:rounded-2xl prose-img:border prose-img:border-white/10 prose-img:shadow-2xl prose-img:my-12 prose-img:w-full prose-img:object-cover
          prose-p:first-of-type:first-letter:text-7xl prose-p:first-of-type:first-letter:font-body prose-p:first-of-type:first-letter:font-light prose-p:first-of-type:first-letter:text-[#C8A98B] prose-p:first-of-type:first-letter:mr-3 prose-p:first-of-type:first-letter:float-left prose-p:first-of-type:first-letter:leading-[0.8] prose-p:first-of-type:first-letter:mt-2
          prose-hr:border-none prose-hr:text-center prose-hr:text-stone-600 prose-hr:tracking-[1em] prose-hr:py-12 prose-hr:after:content-['***']"
        >
        {(() => {
          if (renderedHtml) {
            const paragraphs = renderedHtml.split('</p>');
            if (paragraphs.length > 4) {
              const middle = Math.floor(paragraphs.length / 2);
              const part1 = paragraphs.slice(0, middle).join('</p>') + '</p>';
              const part2 = paragraphs.slice(middle).join('</p>');
              return (
                <>
                  <div class="essay-content" set:html={part1} />
                  <RelatedReading currentSlug={slug!} category={data.category ?? undefined} />
                  <div class="essay-content" set:html={part2} />
                  {Content && (
                    <div class="essay-content">
                      <Content />
                    </div>
                  )}
                </>
              );
            }
            return (
              <>
                <div class="essay-content" set:html={renderedHtml} />
                {Content && (
                  <div class="essay-content">
                    <Content />
                  </div>
                )}
                <RelatedReading currentSlug={slug!} category={data.category ?? undefined} />
              </>
            );
          }

          if (Content) {
            return (
              <>
                <div class="essay-content">
                  <Content />
                </div>
                <RelatedReading currentSlug={slug!} category={data.category ?? undefined} />
              </>
            );
          }

          return (
            <div class="py-12 text-white/50 font-serif italic text-lg text-center">
              Documento en proceso de catalogación en el archivo hemerográfico.
            </div>
          );
        })()}
      </div>
      </div>

      {/* 3. Canal Derecho: Ruptura Visual e Inmersión */}
      <aside class="col-span-12 lg:col-span-3 hidden lg:block mt-64">
        {optimizedImage && (
          <div class="overflow-hidden rounded-sm aspect-4/5 mb-4 relative group">
            <div class="absolute inset-0 bg-theme-dark/10 z-10 pointer-events-none group-hover:bg-transparent transition-all duration-1000"></div>
            <Image src={optimizedImage} alt={`Vista ampliada`} class="object-cover w-full h-full hover:scale-105 transition-transform duration-[20s] ease-out" />
          </div>
        )}
        <p class="font-mono text-[10px] text-white/40 tracking-wider uppercase border-b border-white/10 pb-2">FIG I. Registro visual indexado.</p>
        
        <div class="mt-24 p-6 bg-white/5 border-l border-[#C8A98B]/30 relative">
          <div class="absolute top-0 left-0 -translate-x-px w-0.5 h-8 bg-[#C8A98B]"></div>
          <p class="font-serif text-lg font-light italic text-[#C8A98B]/90 leading-relaxed">
            "{data.excerpt || 'Un eco del pasado resonando en la arquitectura de la información moderna.'}"
          </p>
        </div>
      </aside>

    </div>
    
    {/* 4. El Búnker de Referencias (Footer Editorial) */}
    <footer class="mt-32 border-t border-white/5 bg-[#0a0a0a] shadow-inner relative z-10 w-full">
      <div class="max-w-7xl mx-auto px-4 md:px-8 py-16 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 border border-white/5 bg-white/2 rounded-sm hover:border-white/10 transition-colors">
          <h6 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[#C8A98B]/80 mb-4">Bibliografía Principal</h6>
          <ul class="font-mono text-xs text-white/40 space-y-3">
            <li class="pl-3 border-l border-white/10 hover:text-white/70 transition-colors">Fragmentos del Archivo Original. Vol II.</li>
            <li class="pl-3 border-l border-white/10 hover:text-white/70 transition-colors">Transcripciones Esteparias (1230 DC).</li>
            <li class="pl-3 border-l border-white/10 hover:text-white/70 transition-colors">El Códice Fundacional.</li>
          </ul>
        </div>
        <div class="p-6 border border-white/5 bg-white/2 rounded-sm hover:border-white/10 transition-colors">
          <h6 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[#C8A98B]/80 mb-4">Metadatos de Indexación</h6>
          <ul class="font-mono text-xs text-white/40 space-y-3">
            <li class="flex justify-between border-b border-white/5 pb-2"><span>Nivel de Autenticidad</span> <span class="text-[#2483EB]">98.4%</span></li>
            <li class="flex justify-between border-b border-white/5 pb-2"><span>Anomalías Temporales</span> <span class="text-[#2483EB]">Ninguna</span></li>
            <li class="flex justify-between border-b border-white/5 pb-2"><span>Nivel de Clasificación</span> <span class="text-[#C8A98B]">Abierto</span></li>
          </ul>
        </div>
        <div class="p-6 border border-white/5 bg-white/2 rounded-sm hover:border-white/10 transition-colors">
          <h6 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[#C8A98B]/80 mb-4">Rutas Cognitivas</h6>
          <ul class="font-mono text-xs text-white/40 space-y-3">
            <li class="pl-3 border-l border-[#2483EB]/40 hover:text-white/80 transition-colors cursor-pointer">Revisar nodo de asimetría 04x</li>
            <li class="pl-3 border-l border-[#2483EB]/40 hover:text-white/80 transition-colors cursor-pointer">Consultar registros paralelos</li>
          </ul>
        </div>
      </div>
    </footer>

    <ExploreMore currentSlug={slug!} category={data.category ?? undefined} />

    <SubstackPrefooter />

    <div
      class="max-w-2xl mx-auto relative z-10 pt-24 pb-32 text-center"
    >
      <a
        href="/archivo"
        class="inline-block font-mono text-[10px] border border-white/10 px-10 py-5 uppercase tracking-[0.3em] text-white/40 hover:bg-white/5 hover:border-[#C8A98B]/50 hover:text-[#C8A98B] transition-all duration-700 rounded-full"
      >
        Cerrar Archivo
      </a>
    </div>
  </article>

  {/* 4. Animación de Entrada "Aparición Volumétrica" */}
  {/* Floating Action Bar: Podcast links at bottom right */}
  {(data.spotifyLink || data.youtubeLink) && (
    <div class="fixed bottom-8 right-8 z-50 flex flex-col gap-4">
      {data.spotifyLink && (
        <a 
          href={data.spotifyLink} 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-12 h-12 flex items-center justify-center rounded-full bg-black/40 backdrop-blur-xl border border-white/10 text-white/40 hover:text-white hover:border-white/30 hover:scale-110 transition-all duration-700 group shadow-2xl"
          title="Escuchar en Spotify"
        >
          <SpotifyIcon class="w-5 h-5 blur-[0.5px] group-hover:blur-0 transition-all duration-700" />
        </a>
      )}
      {data.youtubeLink && (
        <a 
          href={data.youtubeLink} 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-12 h-12 flex items-center justify-center rounded-full bg-black/40 backdrop-blur-xl border border-white/10 text-white/40 hover:text-white hover:border-white/30 hover:scale-110 transition-all duration-700 group shadow-2xl"
          title="Ver en YouTube"
        >
          <YouTubeIcon class="w-5 h-5 blur-[0.5px] group-hover:blur-0 transition-all duration-700" />
        </a>
      )}
    </div>
  )}

  <style>
    /* Reverse Ken Burns: scale(1.06) translateY(1%) hacia scale(1), 10s, single run */
    @keyframes reverseKenBurns {
      0% {
        transform: scale(1.06) translateY(1%);
      }
      100% {
        transform: scale(1) translateY(0);
      }
    }

    .hero-reverse-ken-burns {
      animation: reverseKenBurns 10s cubic-bezier(0.25, 1, 0.5, 1) 1 forwards;
    }

    /* Soporte de la curva Bézier cinemática */
    .ease-cinematic {
      transition-timing-function: cubic-bezier(0.25, 1, 0.5, 1);
    }

    /* Blockquotes laterales / fuentes históricas con línea editorial de color destacado */
    .essay-content blockquote {
      border-left: 3px solid var(--theme-accent, #C8A98B) !important;
      background: rgba(255, 255, 255, 0.03) !important;
      padding: 1.5rem 2rem !important;
      margin: 2.5rem 0 !important;
      border-radius: 0 1rem 1rem 0 !important;
      font-family: var(--font-serif), Georgia, serif !important;
      font-style: italic !important;
      font-weight: 300 !important;
      color: rgba(255, 255, 255, 0.9) !important;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2) !important;
    }
    .essay-content blockquote p {
      font-size: 1.25rem !important;
      line-height: 1.75 !important;
      margin-bottom: 0 !important;
    }

    /* Recuadro de Fuentes Eruditas & Referencias al final del ensayo */
    .essay-content h2:last-of-type {
      margin-top: 4rem !important;
      padding-top: 1.5rem !important;
      border-top: 1px dashed rgba(200, 169, 139, 0.25) !important;
      color: #C8A98B !important;
      font-family: var(--font-serif), Georgia, serif !important;
      font-weight: 300 !important;
      font-style: italic !important;
      font-size: 1.6rem !important;
    }

    .essay-content ul:last-of-type {
      background: rgba(255, 255, 255, 0.02) !important;
      border: 1px solid rgba(255, 255, 255, 0.08) !important;
      border-left: 3px solid #C8A98B !important;
      padding: 1.75rem 2rem 1.75rem 2.5rem !important;
      border-radius: 0.75rem !important;
      font-family: var(--font-serif), Georgia, serif !important;
      font-style: italic !important;
      font-weight: 300 !important;
      font-size: 1rem !important;
      color: rgba(255, 255, 255, 0.75) !important;
      line-height: 1.8 !important;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-reverse-ken-burns {
        animation: none !important;
        transform: none !important;
      }
    }
  </style>
</Layout>
