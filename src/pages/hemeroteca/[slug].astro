---
import { render, getEntry, getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import MarqueeColecciones from "../../components/MarqueeColecciones.astro";
import { Image } from "astro:assets";
import SpotifyIcon from "../../components/icons/Spotify.astro";
import YouTubeIcon from "../../components/icons/YouTube.astro";
import { marked } from "marked";
import Header from "../../components/Header.astro";
import { QuickReturnButton } from "../../components/QuickReturnButton";
import BackSlideButton from "../../components/BackSlideButton.astro";

import RelatedReading from "../../components/RelatedReading.astro";
import ExploreMore from "../../components/ExploreMore.astro";
import InteriorHero from "../../components/InteriorHero.astro";
import {
  resolveEssayImage,
  resolveAllPostGalleryImages,
  essayImages,
  groupByCategory,
  formatCategory,
  getPublishableEssays,
} from "../../lib/content-filter";
import CinematicDossier from "../../components/CinematicDossier.astro"; // reservado para uso futuro
import CinematicGalleryEngine from "../../components/CinematicGalleryEngine.astro";

export const prerender = true;
export async function getStaticPaths() {
  const essays = await getCollection("ensayos").catch(() => []);
  const georefs = await getCollection("georreferencias").catch(() => []);
  const arquetipos = await getCollection("arquetiposGlobales").catch(() => []);

  const combined = [...essays, ...georefs, ...arquetipos];

  return combined.map((item) => ({
    params: { slug: item.id.replace(/\/index$/, "") },
    props: { data: item.data },
  }));
}

const { slug } = Astro.params;
const { data } = Astro.props;
const doc = data as any;

// 1. Cargar contenido raw de .mdoc si existe en disco (ensayos, georreferencias y arquetipos globales)
const rawMdocs = import.meta.glob<string>(
  [
    "/src/content/ensayos/**/content.mdoc",
    "/src/content/georreferencias/**/content.mdoc",
    "/src/content/arquetipos-globales/**/content.mdoc",
  ],
  { query: "?raw", import: "default", eager: true },
);

const mdocKey = `/src/content/ensayos/${slug}/content.mdoc`;
const georefMdocKey = `/src/content/georreferencias/${slug}/content.mdoc`;
const arquetipoMdocKey = `/src/content/arquetipos-globales/${slug}/content.mdoc`;
const rawMdocText =
  rawMdocs[mdocKey] ||
  rawMdocs[georefMdocKey] ||
  rawMdocs[arquetipoMdocKey] ||
  "";

// 2. Carga segura del componente Markdoc si existe
let Content: any = null;
try {
  const targetCollectionName =
    mdocKey in rawMdocs ? "ensayosContent" :
    georefMdocKey in rawMdocs ? "georreferenciasContent" :
    arquetipoMdocKey in rawMdocs ? "arquetiposGlobalesContent" : null;

  if (targetCollectionName) {
    const contentEntry = await getEntry(targetCollectionName as any, `${slug}/content`);
    if (contentEntry) {
      const rendered = await render(contentEntry);
      Content = rendered.Content;
    }
  }
} catch (err) {
  // Fallback silencioso
}

// 3. Resolución universal y resiliente del texto del ensayo
let rawSourceText = "";
if (rawMdocText && rawMdocText.trim().length > 0) {
  rawSourceText = rawMdocText.trim();
} else if (doc.generadorGeoref && doc.generadorGeoref.trim().length > 0) {
  rawSourceText = doc.generadorGeoref.trim();
} else if (doc.generadorTexto && doc.generadorTexto.trim().length > 0) {
  rawSourceText = doc.generadorTexto.trim();
} else if (doc.generador && doc.generador.length > 50) {
  rawSourceText = doc.generador.trim();
}

// Desanidado universal si el texto almacenado contenía un payload JSON de Gemini
let finalMarkdownText = rawSourceText;
if (
  rawSourceText.startsWith("{") &&
  (rawSourceText.includes('"informeMarkdown"') ||
    rawSourceText.includes('"content"') ||
    rawSourceText.includes('"volantaHook"'))
) {
  try {
    const unnested = JSON.parse(rawSourceText);
    if (unnested.informeMarkdown || unnested.content) {
      finalMarkdownText = unnested.informeMarkdown || unnested.content;
    }
    if (!doc.volantaHook && unnested.volantaHook) {
      doc.volantaHook = unnested.volantaHook;
    }
    if (!doc.volanta && unnested.volanta) {
      doc.volanta = unnested.volanta;
    }
    if (!doc.saberMasDato && unnested.saberMasDato) {
      doc.saberMasDato = unnested.saberMasDato;
    }
    if (!doc.excerpt && unnested.excerpt) {
      doc.excerpt = unnested.excerpt;
    }
    if (!doc.sitioGeohistorico && unnested.sitioGeohistorico) {
      doc.sitioGeohistorico = unnested.sitioGeohistorico;
    }
  } catch (e) {
    // Regex fallback
    const extract = (field: string) => {
      const match = rawSourceText.match(
        new RegExp(`"${field}"\\s*:\\s*"([\\s\\S]*?)"(?=\\s*,\\s*"|\\s*})`),
      );
      return match ? match[1].replace(/\\n/g, "\n").replace(/\\"/g, '"') : null;
    };
    const extractedContent = extract("informeMarkdown") || extract("content");
    if (extractedContent) finalMarkdownText = extractedContent;
    if (!doc.volantaHook) doc.volantaHook = extract("volantaHook") || "";
    if (!doc.saberMasDato) doc.saberMasDato = extract("saberMasDato") || "";
    if (!doc.excerpt) doc.excerpt = extract("excerpt") || "";
  }
}

// 4. Procesar HTML y vincular imágenes relativas a los assets procesados de Vite
let renderedHtml = "";
if (finalMarkdownText) {
  renderedHtml = marked.parse(finalMarkdownText) as string;
  for (const [imgKey, imgModule] of Object.entries(essayImages)) {
    if (renderedHtml.includes(imgKey)) {
      renderedHtml = renderedHtml.replaceAll(imgKey, imgModule.default.src);
    }
  }
}

// 5. Resolución de imagen de portada
const optimizedImage = resolveEssayImage(doc.coverImage, slug);

// 6. Recopilación Universal de Galería Magazine
const allGalleryImages = resolveAllPostGalleryImages(doc, slug);
let wikimediaImages: any[] = allGalleryImages;

// 9. ADAPTADOR CINEMÁTICO (Extracción y emparejamiento)
let isCinematicView = doc.isCinematic === true;
let cinematicFragments: any[] = [];
const globalGalleryFragments = allGalleryImages.map((img: any, index: number) => ({
  image: img.url || img.thumbUrl || img.src || img,
  text: img.title || img.caption || "Registro Documental",
  highlight: index === 0 ? "Registro Visual" : undefined,
  category: index === 0 ? "Archivo Historiográfico" : undefined
}));

// Fragmentos para el modo cinemático total (isCinematic=true)
if (isCinematicView && finalMarkdownText) {
  const paragraphs = finalMarkdownText
    .split(/\n\n+/)
    .map((p) => p.trim().replace(/[*_]/g, ""))
    .filter(
      (p) =>
        p.length > 30 &&
        !p.startsWith("#") &&
        !p.startsWith("![") &&
        !p.startsWith("<"),
    );
  const sourceImgs = allGalleryImages.map(
    (img: any) => img.url || img.thumbUrl || img.src || "",
  );
  const fallback = sourceImgs.length > 0 ? sourceImgs : [optimizedImage || ""];
  cinematicFragments = paragraphs.map((text, i) => ({
    image: fallback[i % fallback.length],
    text,
    highlight: i === 0 ? doc.title : undefined,
    category: i === 0 ? formatCategory(data.category) : undefined,
    year:
      i === 0
        ? data.date
          ? new Date(data.date).getFullYear().toString()
          : "S/F"
        : undefined,
  }));
}


const allEssaysRaw = await getCollection("ensayos").catch(() => []);
const publishable = getPublishableEssays(allEssaysRaw, import.meta.env.PROD);
const collectionsMap = groupByCategory(publishable, 1);
const sidebarCollections = Array.from(collectionsMap.entries())
  .map(([k, list]) => ({
    key: k,
    label: formatCategory(list[0].entry.category),
    count: list.length,
  }))
  .filter((c) => c.key !== (doc.category || "").toLowerCase())
  .slice(0, 6);

// 8. Cita Histórica Contextualizada al Post
function getContextualCitation(item: any) {
  if (item.citaHistorica)
    return {
      text: item.citaHistorica,
      source: item.citaFuente || "Fuente Historiográfica",
    };
  if (item.epigrafe)
    return {
      text: item.epigrafe,
      source: item.epigrafeFuente || "Epígrafe del Documento",
    };
  if (item.quote)
    return {
      text: item.quote,
      source: item.quoteSource || "Registro Documental",
    };

  const cat = (item.category || "").toLowerCase();
  const title = (item.title || "").toLowerCase();

  if (
    title.includes("tikal") ||
    title.includes("maya") ||
    cat.includes("arqueolog")
  ) {
    return {
      text: "Las piedras silenciosas de las selvas guardan la memoria de civilizaciones que miraron al cielo antes de desvanecerse en el tiempo.",
      source: "Crónica Arqueológica del Nuevo Mundo",
    };
  }
  if (
    title.includes("homero") ||
    cat.includes("historia-ideas") ||
    cat.includes("filosof")
  ) {
    return {
      text: "Cantar es recordar aquello que los dioses otorgaron a los mortales para no olvidar el origen de las cosas.",
      source: "Tradición Clásica & Filosofía Epistémica",
    };
  }
  if (
    title.includes("atila") ||
    title.includes("roma") ||
    title.includes("papa") ||
    cat.includes("historia")
  ) {
    return {
      text: "Los imperios no caen por la fuerza de las espadas que los asedian, sino por el agotamiento del espíritu que los sostenía.",
      source: "Anales de la Antigüedad Tardía",
    };
  }
  if (cat.includes("cahiers") || cat.includes("semiotica")) {
    return {
      text: "El signo no sustituye a la realidad: la funda en el entendimiento humano y preserva su código a través de las edades.",
      source: "Cahiers Épistémiques · Cuaderno de Semiótica",
    };
  }
  if (cat.includes("georreferencia") || cat.includes("sitio")) {
    return {
      text: "La geografía es la partitura sobre la cual la historia escribe su marcha inexorable.",
      source: "Cartografía Histórica & Territorial",
    };
  }
  return {
    text: "El documento histórico no es un vestigio inerte, sino una conversación abierta con aquellos que nos precedieron.",
    source: "Archivo Historiográfico TGP",
  };
}

const contextualCitation = getContextualCitation(doc);

const metadataLabels = ["TGP", "RESEARCH", "ESSAYS", "COLLECTION", "SEASON"];
const metaLabelIndex = slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0) % metadataLabels.length;
const dynamicMetaLabel = metadataLabels[metaLabelIndex];

const roomColors: Record<string, string> = {
  "british-green": "#1B382A",
  bordeaux: "#5B2326",
  "old-navy": "#1E2C3A",
  "bus-red": "#8B3A36",
  "vintage-yellow": "#EFEBE3",
  "rust-orange": "#B55A30",
};
const activeAccent = doc.themeColor
  ? roomColors[doc.themeColor] || "#ffffff"
  : "#ffffff";
const imagePosition =
  doc.coverImagePosition || doc.imagePosition || "center center";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  "headline": doc.title,
  "abstract": doc.excerpt || doc.description,
  "author": {
    "@type": "Person",
    "name": "Xavier Benítez"
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Great Puzzle Project"
  },
  "datePublished": doc.date,
  "dateModified": doc.updatedDate || doc.date,
  keywords: [
    doc.category,
    doc.sitioGeohistorico,
    ...(doc.tags || [])
  ].filter(Boolean).join(", ")
};
---

<Layout
  hideHeader={true}
  footerVariant="minimal"
  title={`${doc.title} | Hemeroteca TGP`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {
    isCinematicView ? (
      <div id="cinematic-override" class="w-full min-h-dvh overflow-hidden">
        <CinematicDossier fragments={cinematicFragments} />
      </div>
    ) : (
      <>
        <Header />
        <BackSlideButton fallbackUrl="/archivo" />
        <QuickReturnButton client:load accentColor={activeAccent} fallbackUrl="/archivo" />

        <InteriorHero
          title={doc.title || "Ensayo TGP"}
          image={optimizedImage}
    imageAlt={`Portada de ${data.title}`}
    imagePosition={imagePosition}
    eyebrow={data.category || "Archivo clasificado"}
    subtitle={doc.volantaHook || (doc.excerpt ? `"${doc.excerpt}"` : undefined)}
    titleClass="text-[clamp(2.25rem,5vw,4.5rem)] font-cinzel font-extrabold tracking-tight leading-[1.05] gradient-acero-ios text-center mx-auto"
  >
    <div slot="meta" class="flex flex-col items-center justify-center gap-2.5 w-full">
      <div
        class="flex items-center justify-center gap-3 font-mono text-[9.5px] md:text-[10.5px] uppercase tracking-[0.3em] text-[#EFEBE3]/50 flex-wrap"
      >
        <span class="text-[#EFEBE3]/60">{dynamicMetaLabel}</span>
      </div>

      {/* LINKS DE SPOTIFY Y YOUTUBE — ÍCONOS DESNUDOS APAGADOS CON LANTERN SOFT GLOW */}
      <div class="hero-meta-socials flex items-center justify-center gap-6 mt-1.5 font-mono text-[8px] md:text-[8.5px] uppercase tracking-[0.3em]">
        <a
          href={doc.spotifyLink || "https://open.spotify.com"}
          target="_blank"
          rel="noopener noreferrer"
          class="lantern-hover text-[#EFEBE3]/50 hover:text-[#EFEBE3] flex items-center gap-2 transition-all duration-300"
        >
          <SpotifyIcon class="w-3.5 h-3.5 opacity-60" />
          <span>SPOTIFY</span>
        </a>

        <a
          href={doc.youtubeLink || "https://youtube.com/@thegreatpuzzleproject"}
          target="_blank"
          rel="noopener noreferrer"
          class="lantern-hover text-[#EFEBE3]/50 hover:text-[#EFEBE3] flex items-center gap-2 transition-all duration-300"
        >
          <YouTubeIcon class="w-3.5 h-3.5 opacity-60" />
          <span>YOUTUBE</span>
        </a>
      </div>
    </div>
  </InteriorHero>

  {
    /* 3. Área Editorial con Proporción 80/20 (Lecturabilidad Suiza Premium & Espacio Negativo) */
  }
  <article
    id="post-article"
    class="w-full bg-(--bg-main) relative z-20 pt-16 md:pt-20 pb-32"
    style={`--theme-accent: ${activeAccent};`}
    data-sitio-geo={data.sitioGeohistorico || doc.sitioGeohistorico || ""}
  >
    {/* FX: Aura Atmosférica sutil */}
    <div
      class="pointer-events-none absolute inset-0 opacity-15"
      style="background: radial-gradient(circle at 50% 20%, var(--theme-accent) 0%, transparent 70%); mix-blend-screen;"
    />

    {/* ═══ GRID DE LECTURA 3 COLUMNAS ═══
        [TOC izq sticky] | [Body central 65ch] | [Sidebar der sticky]
        Mobile: una columna. Desktop ≥1200px: 3 columnas.
    */}
    <div class="post-reading-grid relative z-10">

      {/* ── TOC IZQUIERDO STICKY ── */}
      <aside class="post-toc-col" aria-label="Tabla de contenidos">
        <div class="post-toc-inner">
          <p class="post-toc-label">En este ensayo</p>
          <nav id="post-toc-nav" class="post-toc-nav" role="navigation" aria-label="Secciones del ensayo"></nav>
        </div>
      </aside>

      {/* ── CUERPO CENTRAL ── */}
      <div class="post-body-col">
        {
          data.excerpt && (
            <div class="border-l-3 border-[#6E2424] dark:border-rust-orange pl-6 md:pl-8 mb-12 py-3 bg-linear-to-r from-[#6E2424]/10 via-[#6E2424]/5 to-transparent dark:from-rust-orange/10 rounded-r-xl">
              <p class="text-xl md:text-2xl font-serif font-light text-[#6E2424] dark:text-rust-orange leading-relaxed tracking-tight italic">
                "{data.excerpt}"
              </p>
            </div>
          )
        }

        <div
          id="post-body-content"
          class="prose prose-invert max-w-none
          prose-p:font-body prose-p:font-light prose-p:not-italic prose-p:text-[1.18rem] md:prose-p:text-[1.22rem] prose-p:leading-[1.75] prose-p:tracking-tight prose-p:mb-8 prose-p:text-left prose-p:text-pretty
          prose-h1:hidden
          prose-h2:font-sans prose-h2:font-extrabold prose-h2:text-2xl md:prose-h2:text-3xl prose-h2:tracking-tight prose-h2:mt-14 prose-h2:mb-5 prose-h2:leading-snug prose-h2:text-[#1C1E21] dark:prose-h2:text-[#F5F4F0] prose-h2:border-b-2 prose-h2:border-[#6E2424]/40 dark:prose-h2:border-rust-orange/40 prose-h2:pb-2.5 prose-h2:scroll-mt-24
          prose-h3:font-sans prose-h3:font-extrabold prose-h3:text-xl md:prose-h3:text-2xl prose-h3:text-[#6E2424] dark:prose-h3:text-rust-orange prose-h3:leading-snug prose-h3:mt-10 prose-h3:mb-3.5 prose-h3:scroll-mt-24
          prose-h4:font-mono prose-h4:font-black prose-h4:tracking-widest prose-h4:uppercase prose-h4:text-xs md:prose-h4:text-sm prose-h4:text-[#6E2424] dark:prose-h4:text-rust-orange prose-h4:leading-normal prose-h4:mt-8 prose-h4:mb-3 prose-h4:scroll-mt-24
          prose-strong:font-bold prose-strong:text-[#1C1E21] dark:prose-strong:text-white
          prose-blockquote:border-l-3 prose-blockquote:border-[#6E2424] dark:prose-blockquote:border-rust-orange prose-blockquote:bg-stone-200/60 dark:prose-blockquote:bg-white/5 prose-blockquote:p-6 prose-blockquote:md:p-8 prose-blockquote:my-10 prose-blockquote:rounded-r-xl prose-blockquote:shadow-lg prose-blockquote:text-xl prose-blockquote:md:text-2xl prose-blockquote:leading-relaxed prose-blockquote:font-serif prose-blockquote:font-light prose-blockquote:italic
          prose-a:border-b prose-a:border-[#6E2424]/50 dark:prose-a:border-rust-orange/50 prose-a:text-[#6E2424] dark:prose-a:text-rust-orange prose-a:font-semibold transition-colors
          prose-img:rounded-2xl prose-img:border prose-img:border-stone-300 dark:prose-img:border-white/10 prose-img:shadow-2xl prose-img:my-12 prose-img:w-full prose-img:object-cover
          prose-p:first-of-type:first-letter:text-7xl md:prose-p:first-of-type:first-letter:text-8xl prose-p:first-of-type:first-letter:font-bold prose-p:first-of-type:first-letter:text-[#6E2424] dark:prose-p:first-of-type:first-letter:text-rust-orange prose-p:first-of-type:first-letter:mr-4 prose-p:first-of-type:first-letter:float-left prose-p:first-of-type:first-letter:leading-none prose-p:first-of-type:first-letter:mt-1
          prose-hr:border-none prose-hr:text-center prose-hr:text-[#6E2424] dark:prose-hr:text-rust-orange prose-hr:tracking-[1em] prose-hr:py-10 prose-hr:after:content-['***']"
        >
          {
            (() => {
              if (renderedHtml) {
                const paragraphs = renderedHtml.split("</p>");
                if (paragraphs.length > 4) {
                  const middle = Math.floor(paragraphs.length / 2);
                  const part1 = paragraphs.slice(0, middle).join("</p>") + "</p>";
                  const part2 = paragraphs.slice(middle).join("</p>");
                  return (
                    <>
                      <div class="essay-content" set:html={part1} />
                      <RelatedReading currentSlug={slug!} category={data.category ?? undefined} />
                      <div class="essay-content" set:html={part2} />
                      {Content && <div class="essay-content"><Content /></div>}
                    </>
                  );
                }
                return (
                  <>
                    <div class="essay-content" set:html={renderedHtml} />
                    {Content && <div class="essay-content"><Content /></div>}
                    <RelatedReading currentSlug={slug!} category={data.category ?? undefined} />
                  </>
                );
              }
              if (Content) {
                return (
                  <>
                    <div class="essay-content"><Content /></div>
                    <RelatedReading currentSlug={slug!} category={data.category ?? undefined} />
                  </>
                );
              }
              return (
                <div class="py-12 text-stone-500 dark:text-white/50 font-serif italic text-lg text-center">
                  Documento en proceso de catalogación en el archivo hemerográfico.
                </div>
              );
            })()
          }
        </div>

        {/* Nota del Autor — solo visible en mobile (en desktop va al sidebar) */}
        {
          doc.saberMasDato && (
            <div class="my-12 p-6 md:p-8 rounded-2xl bg-linear-to-br from-stone-50 via-[#EBE9E1] to-stone-200 border border-stone-300/80 shadow-md dark:from-stone-900 dark:to-stone-950 dark:border-white/10 lg:hidden">
              <span class="font-mono text-[9.5px] uppercase tracking-[0.3em] text-[#6E2424] dark:text-rust-orange font-bold block mb-3">
                Nota del Autor · Saber Más
              </span>
              <p class="font-serif italic font-medium text-stone-800 dark:text-white/95 text-base md:text-lg leading-relaxed">
                {doc.saberMasDato}
              </p>
            </div>
          )
        }

        {/* Cierre de navegación */}
        <div class="pt-16 pb-8 text-center">
          <a
            href="/archivo"
            class="inline-flex items-center gap-3 font-mono text-[9px] bg-[#151718]/90 backdrop-blur-sm border border-white/10 px-8 py-3.5 uppercase tracking-[0.3em] text-white/50 hover:bg-rust-orange/10 hover:border-rust-orange/45 hover:text-rust-orange transition-all duration-500 rounded-full"
          >
            Cerrar Archivo
          </a>
        </div>
      </div>

      {/* ── SIDEBAR DERECHO STICKY ── */}
      <aside class="post-sidebar-col" aria-label="Contexto del ensayo">
        <div class="post-sidebar-inner">

          {/* Cita Histórica Contextualizada */}
          <div class="p-5 rounded-2xl bg-linear-to-b from-old-navy via-[#2B1A35] to-theme-dark dark:from-[#181d1a] dark:to-[#0d0f0e] text-stone-100 border border-stone-300/30 dark:border-white/10 shadow-2xl flex flex-col gap-3 group">
            <span class="font-mono text-[8px] uppercase tracking-[0.3em] text-rust-orange font-bold border-b border-purple-400/30 pb-2">
              Contexto Histórico
            </span>
            <p class="font-serif italic font-light text-purple-100 text-[12.5px] leading-relaxed text-pretty group-hover:text-white transition-colors duration-500">
              &ldquo;{contextualCitation.text}&rdquo;
            </p>
            <div class="flex items-center justify-between font-mono text-[7.5px] uppercase tracking-[0.22em] text-rust-orange border-t border-purple-400/20 pt-2.5">
              <span>{contextualCitation.source}</span>
            </div>
          </div>

          {/* Metadatos del Post */}
          <div class="post-meta-card flex flex-col gap-3">
            <p class="post-meta-label">Sobre este ensayo</p>
            <dl class="post-meta-list">
              {data.category && (
                <div class="post-meta-item">
                  <dt>Categoría</dt>
                  <dd>{formatCategory(data.category)}</dd>
                </div>
              )}
              {data.date && (
                <div class="post-meta-item">
                  <dt>Publicación</dt>
                  <dd><time datetime={String(data.date)}>{new Date(data.date).toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' })}</time></dd>
                </div>
              )}
              <div class="post-meta-item">
                <dt>Autoría</dt>
                <dd>Xavier Benítez · TGP</dd>
              </div>
              <div class="post-meta-item">
                <dt>Lectura est.</dt>
                <dd id="post-reading-time">—</dd>
              </div>
            </dl>
          </div>

          {/* Saber Más */}
          {
            doc.saberMasDato && (
              <div class="p-5 rounded-2xl bg-linear-to-br from-stone-50 via-[#EBE9E1] to-stone-200 border border-stone-300/80 shadow-md dark:from-stone-900 dark:to-stone-950 dark:border-white/10 flex flex-col gap-2.5 group">
                <div class="flex items-center gap-2 pb-2 border-b border-stone-300/60 dark:border-white/10">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#6E2424] dark:bg-rust-orange animate-pulse" />
                  <span class="font-mono text-[8px] uppercase tracking-[0.28em] text-[#6E2424] dark:text-rust-orange font-bold">
                    SABER MÁS
                  </span>
                </div>
                <p class="font-serif italic font-medium text-stone-800 dark:text-white/85 text-[12px] leading-relaxed text-pretty">
                  {doc.saberMasDato}
                </p>
              </div>
            )
          }

          {/* Colecciones Desplegables */}
          {
            sidebarCollections.length > 0 && (
              <details class="cinematic-card-lantern p-4 rounded-2xl group/col-toggle select-none" open>
                <summary class="flex items-center justify-between border-b border-white/5 pb-2.5 cursor-pointer list-none">
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-[8.5px] uppercase tracking-[0.28em] text-rust-orange font-bold group-hover/col-toggle:drop-shadow-[0_0_8px_rgba(239, 235, 227,0.6)] transition-all">
                      COLECCIONES
                    </span>
                    <span class="text-[8px] text-rust-orange/70 transition-transform duration-300 group-open/col-toggle:rotate-180">▼</span>
                  </div>
                  <a
                    href="/colecciones"
                    onclick="event.stopPropagation()"
                    class="font-mono text-[8px] uppercase tracking-widest text-white/40 hover:text-rust-orange transition-all"
                  >
                    VER TODAS →
                  </a>
                </summary>

                <div class="flex flex-col gap-1 pt-2.5">
                  {sidebarCollections.map((col) => (
                    <a
                      href={`/colecciones/${encodeURIComponent(col.key)}`}
                      class="group/item flex items-center justify-between py-1.5 px-2.5 rounded-lg border border-transparent hover:border-rust-orange/30 hover:bg-rust-orange/10 transition-all duration-300"
                    >
                      <span class="font-mono text-[9px] text-white/60 group-hover/item:text-white transition-all truncate">
                        {col.label}
                      </span>
                      <span class="font-mono text-[8px] text-rust-orange/70 group-hover/item:text-rust-orange shrink-0 font-bold transition-all">
                        {col.count}
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            )
          }

          {/* Registros Visuales */}
          {
            wikimediaImages.length > 0 ? (
              <div class="cinematic-card-lantern p-4 rounded-2xl flex flex-col gap-3 group">
                <span class="font-mono text-[8px] uppercase tracking-[0.25em] text-rust-orange block border-b border-white/5 pb-2 font-bold">
                  REGISTROS VISUALES ({wikimediaImages.length})
                </span>
                <div class="grid grid-cols-2 gap-2">
                  {wikimediaImages.slice(0, 4).map((wmItem: any, idx: number) => (
                    <a
                      href={wmItem.pageUrl || wmItem.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group/img relative aspect-4/3 rounded-lg overflow-hidden border border-white/10 bg-white/5 hover:border-rust-orange/70 transition-all duration-500"
                      title={wmItem.title}
                    >
                      <img
                        src={wmItem.thumbUrl || wmItem.url}
                        alt={wmItem.title}
                        class="w-full h-full object-cover group-hover/img:scale-108 transition-transform duration-700 opacity-80 group-hover/img:opacity-100"
                        loading="lazy"
                      />
                      <span class="absolute bottom-1 right-1 px-1.5 py-0.5 bg-black/80 text-[7px] font-mono text-white/70 rounded">#{idx + 1}</span>
                    </a>
                  ))}
                </div>
              </div>
            ) : optimizedImage ? (
              <div class="cinematic-card-lantern overflow-hidden rounded-2xl aspect-4/5 relative group shadow-xl">
                <Image src={optimizedImage} alt="Registro visual" class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700 ease-out" />
                <div class="absolute bottom-0 inset-x-0 p-3 bg-linear-to-t from-black/90 via-black/40 to-transparent">
                  <p class="font-mono text-[8px] text-white/70 tracking-wider uppercase">FIG I. Portada de archivo.</p>
                </div>
              </div>
            ) : null
          }
        </div>
      </aside>
    </div>

    {/* ── GALERÍA NATIVA — CinematicGalleryEngine (batch de fotos del post) ── */}
    {allGalleryImages.length > 0 && (
      <CinematicGalleryEngine
        slides={allGalleryImages.map((img: any, i: number) => ({
          id: `${slug}-photo-${i}`,
          title: img.title || doc.title || 'Registro Visual',
          subtitle: img.description || img.caption || undefined,
          author: img.author || undefined,
          license: img.license || undefined,
          image: img.url || img.thumbUrl || img.src || img,
          imagePosition: img.position || doc.coverImagePosition || 'center center',
        }))}
        heightClass="h-[80vh] md:h-dvh max-w-7xl mx-auto rounded-3xl my-16"
      />
    )}

    <ExploreMore currentSlug={slug!} category={data.category ?? undefined} />
  </article>

      </>
    )
  }
<MarqueeColecciones />
</Layout>

<style>
  /* ══════════════════════════════════════════════════════════════════
     GRID DE LECTURA — /hemeroteca/[slug]
     3 columnas sticky en desktop ≥1200px. 1 columna en mobile.
     Sin tocar paleta, fuentes ni estilos globales existentes.
  ══════════════════════════════════════════════════════════════════ */

  .post-reading-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: "body";
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  @media (min-width: 1200px) {
    .post-reading-grid {
      grid-template-columns: 256px minmax(0, 75ch) 288px;
      grid-template-areas: "toc body sidebar";
      max-width: 80rem; /* max-w-7xl */
      justify-content: center;
      padding: 0 2rem;
      gap: 0 3rem;
      align-items: start;
    }
  }

  @media (min-width: 1440px) {
    .post-reading-grid {
      grid-template-columns: 256px minmax(0, 75ch) 320px;
      max-width: 80rem;
      gap: 0 4rem;
    }
  }

  /* ── TOC izquierdo ── */
  .post-toc-col { grid-area: toc; display: none; }
  @media (min-width: 1200px) { .post-toc-col { display: block; } }

  .post-toc-inner {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    scrollbar-width: none;
    padding-bottom: 1rem;
    width: 100%;
    box-sizing: border-box;
  }
  .post-toc-inner > * {
    flex-shrink: 0;
    width: 100%;
    box-sizing: border-box;
  }
  .post-toc-inner::-webkit-scrollbar { display: none; }

  .post-toc-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(239, 235, 227, 0.7);
    margin: 0 0 0.3rem;
  }

  .post-toc-nav { display: flex; flex-direction: column; gap: 0.35rem; }

  .post-toc-pill {
    display: block;
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    font-weight: 400;
    line-height: 1.4;
    color: rgba(255,255,255,0.45);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
    text-decoration: none;
