<script>
  /* TOC Scrollspy + Tiempo de lectura — /hemeroteca posts */
  const initPostScript = () => {
    const bodyContent = document.getElementById('post-body-content');
    const tocNav      = document.getElementById('post-toc-nav');
    const rtEl        = document.getElementById('post-reading-time');
    if (!bodyContent) return;

    /* 1. Tiempo de lectura */
    const words = (bodyContent.textContent || '').trim().split(/\s+/).length;
    const mins  = Math.max(1, Math.ceil(words / 225));
    if (rtEl) rtEl.textContent = `${mins} min`;

    /* 2. TOC dinámico */
    if (!tocNav) return;
    tocNav.innerHTML = ''; // Limpiar previo para evitar duplicados en re-render / zoom / navegación

    const headings = Array.from(bodyContent.querySelectorAll('h2, h3'));
    if (headings.length === 0) {
      tocNav.innerHTML = '<span class="post-toc-empty">Sin secciones</span>';
      return;
    }

    /* Asignar IDs */
    headings.forEach((h, i) => {
      if (!h.id) {
        h.id = `hs-${i}-${(h.textContent || '')
          .trim().toLowerCase()
          .replace(/\s+/g, '-')
          .replace(/[^a-z0-9-]/g, '')
          .slice(0, 40)}`;
      }
    });

    /* Crear píldoras */
    const frag = document.createDocumentFragment();
    headings.forEach(h => {
      const a = document.createElement('a');
      a.href        = `#${h.id}`;
      a.className   = `post-toc-pill${h.tagName === 'H3' ? ' toc-h3' : ''}`;
      a.textContent = h.textContent || '';
      (a as HTMLElement).dataset['id'] = h.id;
      a.addEventListener('click', e => {
        e.preventDefault();
        document.getElementById(h.id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      frag.appendChild(a);
    });
    tocNav.appendChild(frag);

    /* 3. Scrollspy */
    const markActive = (id: string) => {
      (tocNav.querySelectorAll('.post-toc-pill') as NodeListOf<HTMLElement>).forEach(p => {
        p.classList.toggle('active', p.dataset['id'] === id);
      });
    };
    const obs = new IntersectionObserver(
      entries => entries.forEach(e => { if (e.isIntersecting) markActive(e.target.id); }),
      { rootMargin: '-5% 0px -80% 0px', threshold: 0 }
    );
    headings.forEach(h => obs.observe(h));
  };

  /* 4. Switcher interactivo de experiencia de lectura (Cinemático vs Doc) */
  const setupReadingModes = () => {
    const btnCinematic = document.getElementById('btn-cinematic-mode');
    const btnDoc       = document.getElementById('btn-doc-mode');
    const viewCinematic = document.getElementById('view-cinematic');
    const viewDoc       = document.getElementById('view-doc');

    if (!btnCinematic || !btnDoc || !viewCinematic || !viewDoc) return;

    const gridContainer = document.getElementById('reading-grid-container');

    const setMode = (mode: 'cinematic' | 'doc') => {
      if (mode === 'cinematic') {
        viewCinematic.classList.remove('hidden');
        viewDoc.classList.add('hidden');
        gridContainer?.classList.add('is-cinematic-mode');
        btnCinematic.classList.add('active-mode');
        btnCinematic.setAttribute('aria-selected', 'true');
        btnDoc.classList.remove('active-mode');
        btnDoc.setAttribute('aria-selected', 'false');
        localStorage.setItem('tgp_reading_mode', 'cinematic');

        // Disparar ScrollTrigger GSAP
        import('../../lib/cinematic-scroll').then(({ initCinematicScroll }) => {
          initCinematicScroll();
        });
      } else {
        viewCinematic.classList.add('hidden');
        viewDoc.classList.remove('hidden');
        gridContainer?.classList.remove('is-cinematic-mode');
        btnDoc.classList.add('active-mode');
        btnDoc.setAttribute('aria-selected', 'true');
        btnCinematic.classList.remove('active-mode');
        btnCinematic.setAttribute('aria-selected', 'false');
        localStorage.setItem('tgp_reading_mode', 'doc');
      }
    };

    btnCinematic.addEventListener('click', () => setMode('cinematic'));
    btnDoc.addEventListener('click', () => setMode('doc'));

    const saved = localStorage.getItem('tgp_reading_mode');
    if (saved === 'doc') {
      setMode('doc');
    } else {
      setMode('cinematic');
    }
  };

  const runAll = () => {
    initPostScript();
    setupReadingModes();
  };

  document.addEventListener('DOMContentLoaded', runAll);
  document.addEventListener('astro:page-load', runAll);
  if (document.readyState !== 'loading') {
    runAll();
  }
</script>

