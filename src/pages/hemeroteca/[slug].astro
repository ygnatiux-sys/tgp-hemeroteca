---
import { render, getEntry, getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import SpotifyIcon from "../../components/icons/Spotify.astro";
import YouTubeIcon from "../../components/icons/YouTube.astro";
import { marked } from 'marked';
import { StickyReaderHeader } from "../../components/StickyReaderHeader";
import { QuickReturnButton } from "../../components/QuickReturnButton";
import SubstackPrefooter from "../../components/SubstackPrefooter.astro";
import RelatedReading from "../../components/RelatedReading.astro";
import ExploreMore from "../../components/ExploreMore.astro";
import {
  resolveEssayImage,
  resolveAllPostGalleryImages,
  essayImages,
  groupByCategory,
  formatCategory,
  getPublishableEssays,
} from "../../lib/content-filter";
import { MagazineFlipGallery } from "../../components/MagazineFlipGallery";

export const prerender = true;
export async function getStaticPaths() {
  const essays = await getCollection("ensayos").catch(() => []);
  const georefs = await getCollection("georreferencias").catch(() => []);

  const combined = [...essays, ...georefs];

  return combined.map((item) => ({
    params: { slug: item.id.replace(/\/index$/, "") },
    props: { data: item.data },
  }));
}

const { slug } = Astro.params;
const { data } = Astro.props;
const doc = data as any;

// 1. Cargar contenido raw de .mdoc si existe en disco (ensayos y georreferencias)
const rawMdocs = import.meta.glob<string>(
  ["/src/content/ensayos/**/content.mdoc", "/src/content/georreferencias/**/content.mdoc"],
  { query: '?raw', import: 'default', eager: true }
);

const mdocKey = `/src/content/ensayos/${slug}/content.mdoc`;
const georefMdocKey = `/src/content/georreferencias/${slug}/content.mdoc`;
const rawMdocText = rawMdocs[mdocKey] || rawMdocs[georefMdocKey] || '';

// 2. Carga segura del componente Markdoc si existe
let Content: any = null;
try {
  const contentEntry = await getEntry("ensayosContent", `${slug}/content`);
  if (contentEntry) {
    const rendered = await render(contentEntry);
    Content = rendered.Content;
  }
} catch (err) {
  // Fallback silencioso
}

// 3. Resolución universal y resiliente del texto del ensayo
let finalMarkdownText = '';
if (rawMdocText && rawMdocText.trim().length > 0) {
  finalMarkdownText = rawMdocText.trim();
} else if (doc.generadorTexto && doc.generadorTexto.trim().length > 0) {
  finalMarkdownText = doc.generadorTexto.trim();
} else if (doc.generador && doc.generador.length > 50) {
  finalMarkdownText = doc.generador.trim();
}

// 4. Procesar HTML y vincular imágenes relativas a los assets procesados de Vite
let renderedHtml = '';
if (finalMarkdownText) {
  renderedHtml = marked.parse(finalMarkdownText) as string;
  for (const [imgKey, imgModule] of Object.entries(essayImages)) {
    if (renderedHtml.includes(imgKey)) {
      renderedHtml = renderedHtml.replaceAll(imgKey, imgModule.default.src);
    }
  }
}

// 5. Resolución de imagen de portada
const optimizedImage = resolveEssayImage(doc.coverImage, slug);

// 6. Recopilación Universal de Galería Magazine
const allGalleryImages = resolveAllPostGalleryImages(doc, slug);
let wikimediaImages: any[] = allGalleryImages;

// 7. Colecciones para la Barra Lateral
const allEssaysRaw = await getCollection("ensayos").catch(() => []);
const publishable = getPublishableEssays(allEssaysRaw, import.meta.env.PROD);
const collectionsMap = groupByCategory(publishable, 1);
const sidebarCollections = Array.from(collectionsMap.entries())
  .map(([k, list]) => ({
    key: k,
    label: formatCategory(list[0].entry.category),
    count: list.length,
  }))
  .filter(c => c.key !== (doc.category || '').toLowerCase())
  .slice(0, 6);

// 8. Cita Histórica Contextualizada al Post
function getContextualCitation(item: any) {
  if (item.citaHistorica) return { text: item.citaHistorica, source: item.citaFuente || "Fuente Historiográfica" };
  if (item.epigrafe) return { text: item.epigrafe, source: item.epigrafeFuente || "Epígrafe del Documento" };
  if (item.quote) return { text: item.quote, source: item.quoteSource || "Registro Documental" };

  const cat = (item.category || '').toLowerCase();
  const title = (item.title || '').toLowerCase();

  if (title.includes('tikal') || title.includes('maya') || cat.includes('arqueolog')) {
    return {
      text: "Las piedras silenciosas de las selvas guardan la memoria de civilizaciones que miraron al cielo antes de desvanecerse en el tiempo.",
      source: "Crónica Arqueológica del Nuevo Mundo"
    };
  }
  if (title.includes('homero') || cat.includes('historia-ideas') || cat.includes('filosof')) {
    return {
      text: "Cantar es recordar aquello que los dioses otorgaron a los mortales para no olvidar el origen de las cosas.",
      source: "Tradición Clásica & Filosofía Epistémica"
    };
  }
  if (title.includes('atila') || title.includes('roma') || title.includes('papa') || cat.includes('historia')) {
    return {
      text: "Los imperios no caen por la fuerza de las espadas que los asedian, sino por el agotamiento del espíritu que los sostenía.",
      source: "Anales de la Antigüedad Tardía"
    };
  }
  if (cat.includes('cahiers') || cat.includes('semiotica')) {
    return {
      text: "El signo no sustituye a la realidad: la funda en el entendimiento humano y preserva su código a través de las edades.",
      source: "Cahiers Épistémiques · Cuaderno de Semiótica"
    };
  }
  if (cat.includes('georreferencia') || cat.includes('sitio')) {
    return {
      text: "La geografía es la partitura sobre la cual la historia escribe su marcha inexorable.",
      source: "Cartografía Histórica & Territorial"
    };
  }
  return {
    text: "El documento histórico no es un vestigio inerte, sino una conversación abierta con aquellos que nos precedieron.",
    source: "Archivo Historiográfico TGP"
  };
}

const contextualCitation = getContextualCitation(doc);

const roomColors: Record<string, string> = {
  "british-green": "#1B382A",
  bordeaux: "#5B2326",
  "old-navy": "#1E2C3A",
  "bus-red": "#8B3A36",
  "vintage-yellow": "#D4A352",
  "rust-orange": "#B55A30",
};
const activeAccent = doc.themeColor
  ? roomColors[doc.themeColor] || "#ffffff"
  : "#ffffff";
const imagePosition = doc.coverImagePosition || doc.imagePosition || 'center center';
const heroOrigin = doc.heroOrigin || doc.transformOrigin || 'center center';
---

<Layout hideHeader={true} footerVariant="minimal" title={`${doc.title} | Hemeroteca TGP`}>
  <StickyReaderHeader client:load title={doc.title || "Ensayo TGP"} accentColor={activeAccent} />
  <QuickReturnButton client:load accentColor={activeAccent} />

  {/* 2. Hero Cinemático iOS-Style Full-Bleed con Fade-Out y Mayor Contraste */}
  <section
    class="hero-section relative w-full h-[88vh] md:h-[90vh] lg:h-[94vh] min-h-160 flex flex-col justify-end pb-16 md:pb-24 lg:pb-28 px-6 md:px-14 lg:px-24 z-10 overflow-hidden"
    style={`--hero-origin: ${heroOrigin};`}
  >
    {/* Imagen de Fondo Full Bleed con Reverse Ken Burns */}
    <div class="absolute inset-0 -z-10 bg-theme-dark overflow-hidden pointer-events-none">
      {
        optimizedImage ? (
          <Image
            src={optimizedImage}
            alt={`Portada de ${data.title}`}
            class="w-full h-full object-cover opacity-85 hero-reverse-ken-burns"
            style={`object-position: ${imagePosition}; transform-origin: ${heroOrigin};`}
          />
        ) : (
          <div class="w-full h-full bg-white/5 opacity-40 hero-reverse-ken-burns" />
        )
      }
      <div
        class="absolute inset-0 bg-linear-to-t from-theme-dark via-theme-dark/65 via-35% to-theme-dark/20 pointer-events-none z-0"
      ></div>
      <div
        class="absolute inset-0 bg-radial-[ellipse_90%_75%_at_15%_95%] from-theme-dark/95 via-theme-dark/45 to-transparent pointer-events-none z-0"
      ></div>
    </div>

    {/* Contenido Editorial del Hero */}
    <div class="relative z-10 max-w-7xl lg:max-w-360 w-full mx-auto">
      {/* Categoría, Sitio y Año */}
      <div
        class="mb-3.5 font-mono text-[10px] md:text-[11px] flex items-center gap-3 uppercase tracking-[0.3em] text-[#C8A98B] flex-wrap"
      >
        <span>[ {data.category || "ARCHIVO CLASIFICADO"} ]</span>
        {doc.sitioGeohistorico && (
          <>
            <span class="opacity-40">—</span>
            <span class="text-white/80">{doc.sitioGeohistorico}</span>
          </>
        )}
        <span class="opacity-40">—</span>
        <span class="text-white/60">{data.date ? new Date(data.date).getFullYear() : "S/F"}</span>
      </div>

      {/* Título Display Monumental con Cinzel ExtraBold y Gradiente Acero */}
      <h1
        class="text-[clamp(2.75rem,6.5vw,7.5rem)] leading-[0.98] font-cinzel font-extrabold tracking-tight antialiased max-w-5xl pt-2 pb-3 gradient-acero-ios drop-shadow-2xl"
      >
        {doc.title}
      </h1>

      {/* Volanta / H2 Smart Hook */}
      {doc.volantaHook ? (
        <h2 class="text-lg md:text-xl lg:text-2xl h2-smart-hook text-slate-100/90 max-w-3xl leading-snug mt-3 drop-shadow-md">
          {doc.volantaHook}
        </h2>
      ) : doc.excerpt ? (
        <p class="font-serif font-light text-base md:text-lg lg:text-xl text-white/80 leading-normal max-w-2xl lg:max-w-3xl italic mt-2 line-clamp-2">
          "{doc.excerpt}"
        </p>
      ) : null}

      {/* Podcast Icons */}
      {(doc.spotifyLink || doc.youtubeLink) && (
        <div class="absolute bottom-0 right-0 hidden md:flex items-center gap-6 text-white">
          {doc.spotifyLink && (
            <a 
              href={doc.spotifyLink} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group/pod flex flex-col items-center gap-1.5"
            >
              <div class="p-2.5 rounded-full border border-white/10 bg-white/5 group-hover/pod:border-[#C8A98B]/50 group-hover/pod:bg-[#C8A98B]/10 transition-all duration-500">
                <SpotifyIcon class="w-4 h-4 opacity-50 group-hover/pod:opacity-100 transition-all duration-500" />
              </div>
              <span class="text-[7px] tracking-[0.4em] opacity-30 group-hover/pod:opacity-100 transition-all duration-500 font-mono">SPOTIFY</span>
            </a>
          )}
          {doc.youtubeLink && (
            <a 
              href={doc.youtubeLink} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group/pod flex flex-col items-center gap-1.5"
            >
              <div class="p-2.5 rounded-full border border-white/10 bg-white/5 group-hover/pod:border-[#C8A98B]/50 group-hover/pod:bg-[#C8A98B]/10 transition-all duration-500">
                <YouTubeIcon class="w-4 h-4 opacity-50 group-hover/pod:opacity-100 transition-all duration-500" />
              </div>
              <span class="text-[7px] tracking-[0.4em] opacity-30 group-hover/pod:opacity-100 transition-all duration-500 font-mono">YOUTUBE</span>
            </a>
          )}
        </div>
      )}
    </div>
  </section>

  {/* 3. Área Editorial con Proporción 80/20 (Lecturabilidad Suiza Premium) */}
  <article
    class="w-full bg-theme-dark relative z-20 pt-16 md:pt-20 pb-32 px-4 md:px-8 lg:px-12 shadow-[0_-20px_50px_rgba(18,20,19,1)]"
    style={`--theme-accent: ${activeAccent};`}
  >
    {/* Capas FX: Aura Atmosférica sutil */}
    <div
      class="pointer-events-none absolute inset-0 opacity-15"
      style="background: radial-gradient(circle at 50% 20%, var(--theme-accent) 0%, transparent 70%); mix-blend-screen;"
    >
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 max-w-7xl mx-auto relative z-10">
      
      {/* ─── 80% COLUMNA PRINCIPAL DE LECTURA (Cuerpo Editorial Amplio) ─── */}
      <div class="col-span-12 lg:col-span-9 max-w-4xl">
        {
          data.excerpt && (
            <div class="border-l-2 border-[#C8A98B]/40 pl-6 md:pl-8 mb-14">
              <p class="text-xl md:text-2xl font-serif font-light text-[#C8A98B]/95 leading-relaxed tracking-wide italic">
                "{data.excerpt}"
              </p>
            </div>
          )
        }

        {/* Redacción Editorial Holgada */}
        <div
          class="prose prose-invert max-w-none
          prose-p:font-body prose-p:font-light prose-p:not-italic prose-p:text-[1.25rem] md:prose-p:text-[1.32rem] prose-p:leading-[1.95] prose-p:tracking-[0.012em] prose-p:text-slate-100/90 prose-p:mb-10 prose-p:text-left
          prose-h1:hidden
          prose-h2:font-sans prose-h2:not-italic prose-h2:font-semibold prose-h2:text-2xl md:prose-h2:text-3xl prose-h2:tracking-tight prose-h2:mt-16 prose-h2:mb-6 prose-h2:leading-snug
          prose-h3:font-body prose-h3:font-normal prose-h3:italic prose-h3:text-xl md:prose-h3:text-2xl prose-h3:text-[#C8A98B] prose-h3:leading-normal prose-h3:mt-12 prose-h3:mb-4
          prose-h4:font-sans prose-h4:font-extralight prose-h4:tracking-widest prose-h4:uppercase prose-h4:text-xs prose-h4:text-[#C8A98B] prose-h4:leading-normal prose-h4:mt-10 prose-h4:mb-3
          prose-strong:font-semibold prose-strong:text-white
          prose-blockquote:border-l-3 prose-blockquote:border-[#C8A98B] prose-blockquote:bg-white/3 prose-blockquote:text-white/90 prose-blockquote:p-8 prose-blockquote:md:p-10 prose-blockquote:my-12 prose-blockquote:rounded-r-2xl prose-blockquote:shadow-xl prose-blockquote:text-xl prose-blockquote:md:text-2xl prose-blockquote:leading-relaxed prose-blockquote:font-serif prose-blockquote:font-light prose-blockquote:italic
          prose-a:border-b prose-a:border-[#C8A98B]/40 prose-a:text-[#C8A98B] hover:prose-a:text-white transition-colors
          prose-img:rounded-2xl prose-img:border prose-img:border-white/10 prose-img:shadow-2xl prose-img:my-12 prose-img:w-full prose-img:object-cover
          prose-p:first-of-type:first-letter:text-7xl prose-p:first-of-type:first-letter:font-body prose-p:first-of-type:first-letter:font-light prose-p:first-of-type:first-letter:text-[#C8A98B] prose-p:first-of-type:first-letter:mr-3.5 prose-p:first-of-type:first-letter:float-left prose-p:first-of-type:first-letter:leading-[0.8] prose-p:first-of-type:first-letter:mt-2
          prose-hr:border-none prose-hr:text-center prose-hr:text-stone-600 prose-hr:tracking-[1em] prose-hr:py-12 prose-hr:after:content-['***']"
        >
        {(() => {
          if (renderedHtml) {
            const paragraphs = renderedHtml.split('</p>');
            if (paragraphs.length > 4) {
              const middle = Math.floor(paragraphs.length / 2);
              const part1 = paragraphs.slice(0, middle).join('</p>') + '</p>';
              const part2 = paragraphs.slice(middle).join('</p>');
              return (
                <>
                  <div class="essay-content" set:html={part1} />
                  <RelatedReading currentSlug={slug!} category={data.category ?? undefined} />
                  <div class="essay-content" set:html={part2} />
                  {Content && (
                    <div class="essay-content">
                      <Content />
                    </div>
                  )}
                </>
              );
            }
            return (
              <>
                <div class="essay-content" set:html={renderedHtml} />
                {Content && (
                  <div class="essay-content">
                    <Content />
                  </div>
                )}
                <RelatedReading currentSlug={slug!} category={data.category ?? undefined} />
              </>
            );
          }

          if (Content) {
            return (
              <>
                <div class="essay-content">
                  <Content />
                </div>
                <RelatedReading currentSlug={slug!} category={data.category ?? undefined} />
              </>
            );
          }

          return (
            <div class="py-12 text-white/50 font-serif italic text-lg text-center">
              Documento en proceso de catalogación en el archivo hemerográfico.
            </div>
          );
        })()}
        </div>

        {/* ─── VISOR DE REVISTA / FLIPBOOK AMPLIO Y LUMINOSO ─── */}
        {allGalleryImages.length > 1 && (
          <MagazineFlipGallery client:load images={allGalleryImages} title={doc.title} accentColor={activeAccent} />
        )}

        {/* Card Saber Más para Móviles / Tablets */}
        {doc.saberMasDato && (
          <div class="my-12 p-8 border border-[#C8A98B]/35 bg-white/4 rounded-2xl backdrop-blur-md shadow-2xl lg:hidden">
            <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-[#C8A98B] font-bold block mb-3">
              Saber Más: La Historia dentro de la Historia
            </span>
            <p class="font-serif italic font-light text-white/95 text-base md:text-lg leading-relaxed">
              {doc.saberMasDato}
            </p>
          </div>
        )}
      </div>

      {/* ─── 20% COLUMNA LATERAL ADELGAZADA & EDITORIAL (Desktop) ─── */}
      <aside class="col-span-12 lg:col-span-3 hidden lg:flex flex-col gap-7 sticky top-28 h-fit self-start">
        
        {/* 1. Cita Histórica Contextualizada al Post */}
        <div class="p-5 border-l-2 border-[#C8A98B]/50 bg-white/3 rounded-r-xl flex flex-col gap-3">
          <p class="font-serif italic font-light text-white/90 text-xs md:text-sm leading-relaxed">
            "{contextualCitation.text}"
          </p>
          <div class="flex items-center justify-between font-mono text-[8px] uppercase tracking-widest text-[#C8A98B]/70 border-t border-white/5 pt-2.5">
            <span>{contextualCitation.source}</span>
          </div>
        </div>

        {/* 2. Saber Más: La Historia dentro de la Historia */}
        {doc.saberMasDato && (
          <div class="p-5 border border-[#C8A98B]/30 bg-linear-to-b from-white/5 to-white/2 rounded-xl backdrop-blur-md shadow-xl relative overflow-hidden group">
            <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-[#C8A98B] font-bold mb-2.5 flex items-center gap-1.5">
              Saber Más
            </span>
            <p class="font-serif italic font-light text-white/85 text-xs leading-relaxed">
              {doc.saberMasDato}
            </p>
          </div>
        )}

        {/* 3. Links a Otras Colecciones (Grid Cómodo y No Invasivo UI/UX) */}
        {sidebarCollections.length > 0 && (
          <div class="flex flex-col gap-3 p-5 rounded-xl border border-white/10 bg-white/2">
            <div class="flex items-center justify-between border-b border-white/8 pb-2">
              <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-[#C8A98B] font-bold">
                Colecciones
              </span>
              <a href="/colecciones" class="font-mono text-[8px] uppercase tracking-widest text-white/40 hover:text-[#C8A98B] transition-colors">
                Ver todas →
              </a>
            </div>
            
            <div class="grid grid-cols-1 gap-1.5">
              {sidebarCollections.map((col) => (
                <a
                  href={`/colecciones/${encodeURIComponent(col.key)}`}
                  class="group/item flex items-center justify-between py-1.5 px-2 rounded-lg hover:bg-white/5 transition-all text-xs"
                >
                  <span class="font-mono text-[10px] text-white/70 group-hover/item:text-[#C8A98B] transition-colors truncate">
                    {col.label}
                  </span>
                  <span class="font-mono text-[8px] text-white/30 group-hover/item:text-white/60 shrink-0">
                    {col.count}
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}

        {/* 4. Visor de Registros Visuales Seleccionados */}
        {wikimediaImages.length > 0 ? (
          <div class="flex flex-col gap-3">
            <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-white/40 block">
              Registros Visuales ({wikimediaImages.length})
            </span>
            <div class="grid grid-cols-2 gap-2">
              {wikimediaImages.slice(0, 4).map((wmItem: any, idx: number) => (
                <a
                  href={wmItem.pageUrl || wmItem.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group relative aspect-4/3 rounded-lg overflow-hidden border border-white/10 bg-white/5 hover:border-[#C8A98B]/60 transition-all duration-300"
                  title={wmItem.title}
                >
                  <img
                    src={wmItem.thumbUrl || wmItem.url}
                    alt={wmItem.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80 group-hover:opacity-100"
                    loading="lazy"
                  />
                  <span class="absolute bottom-1 right-1 px-1 py-0.2 bg-black/80 text-[7px] font-mono text-white/70 rounded">
                    #{idx + 1}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ) : optimizedImage ? (
          <div class="overflow-hidden rounded-xl border border-white/10 aspect-4/5 relative group shadow-xl">
            <Image src={optimizedImage} alt={`Registro visual`} class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700 ease-out" />
            <div class="absolute bottom-0 inset-x-0 p-2.5 bg-linear-to-t from-black/90 to-transparent">
              <p class="font-mono text-[8px] text-white/60 tracking-wider uppercase">FIG I. Portada de archivo.</p>
            </div>
          </div>
        ) : null}

      </aside>

    </div>

    <ExploreMore currentSlug={slug!} category={data.category ?? undefined} />

    <SubstackPrefooter />

    <div
      class="max-w-2xl mx-auto relative z-10 pt-20 pb-28 text-center"
    >
      <a
        href="/archivo"
        class="inline-block font-mono text-[10px] border border-white/10 px-10 py-4 uppercase tracking-[0.3em] text-white/40 hover:bg-white/5 hover:border-[#C8A98B]/50 hover:text-[#C8A98B] transition-all duration-500 rounded-full"
      >
        Cerrar Archivo
      </a>
    </div>
  </article>

  {/* Floating Action Bar: Podcast links */}
  {(doc.spotifyLink || doc.youtubeLink) && (
    <div class="fixed bottom-8 right-8 z-50 flex flex-col gap-4">
      {doc.spotifyLink && (
        <a 
          href={doc.spotifyLink} 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-12 h-12 flex items-center justify-center rounded-full bg-black/40 backdrop-blur-xl border border-white/10 text-white/40 hover:text-white hover:border-white/30 hover:scale-110 transition-all duration-700 group shadow-2xl"
          title="Escuchar en Spotify"
        >
          <SpotifyIcon class="w-5 h-5 blur-[0.5px] group-hover:blur-0 transition-all duration-700" />
        </a>
      )}
      {doc.youtubeLink && (
        <a 
          href={doc.youtubeLink} 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-12 h-12 flex items-center justify-center rounded-full bg-black/40 backdrop-blur-xl border border-white/10 text-white/40 hover:text-white hover:border-white/30 hover:scale-110 transition-all duration-700 group shadow-2xl"
          title="Ver en YouTube"
        >
          <YouTubeIcon class="w-5 h-5 blur-[0.5px] group-hover:blur-0 transition-all duration-700" />
        </a>
      )}
    </div>
  )}
</Layout>
