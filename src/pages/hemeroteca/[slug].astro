    filter: blur(0);
  }

  /* ── Cursor dorado parpadeante TGP ── */
  .aqt-cursor {
    display: inline-block;
    color: #C9A86C;
    font-weight: 100;
    margin-left: 2px;
    animation: aqt-blink 0.85s step-end infinite;
    transition: opacity 0.5s ease;
  }
  @keyframes aqt-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ── Arquetipos: texto h1/h2/h3 heredado con transparencia extra ── */
  .arquetipo-typing-root .cinematic-block p {
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.95) !important;
  }
</style>

<script is:inline>
  (() => {
    /* ════════════════════════════════════════════════════════════════
       MOTOR DE POLVO DORADO TGP (idéntico a PolvoDorado.astro)
       55 partículas, radio 0.8–3.2px, color #C9A86C / dorado
    ════════════════════════════════════════════════════════════════ */
    class ArquetipoPolvo {
      constructor(canvas) {
        this.canvas  = canvas;
        this.ctx     = canvas.getContext('2d');
        this.motes   = [];
        this.raf     = null;
        this.running = false;
        this._resize();
        window.addEventListener('resize', () => this._resize());
      }

      _resize() {
        this.canvas.width  = window.innerWidth;
        this.canvas.height = window.innerHeight;
      }

      _spawn(fromLeft = false) {
        const w = this.canvas.width, h = this.canvas.height;
        return {
          x:  fromLeft ? -10 : Math.random() * w,
          y:  Math.random() * h,
          r:  0.8 + Math.random() * 2.4,
          op: 0.08 + Math.random() * 0.38,
          vx: 0.15 + Math.random() * 0.45,
          vy: (Math.random() - 0.5) * 0.12,
          angle: Math.random() * Math.PI * 2,
          av:    0.004 + Math.random() * 0.014,
          osc:   0.05  + Math.random() * 0.10,
          flickPhase: Math.random() * Math.PI * 2,
          flickSpeed: 0.009 + Math.random() * 0.022,
        };
      }

      start() {
        if (this.running) return;
        this.running = true;
        this.motes = Array.from({ length: 55 }, () => this._spawn());
        this._loop();
      }

      _loop() {
        if (!this.running) return;
        const { ctx, canvas, motes } = this;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        motes.forEach(m => {
          m.x += m.vx;
          m.y += m.vy + Math.sin(m.angle) * m.osc;
          m.angle += m.av;
          m.flickPhase += m.flickSpeed;
          if (m.x > canvas.width + 14) Object.assign(m, this._spawn(true));

          const flick   = 1 + 0.15 * Math.sin(m.flickPhase);
          const finalOp = Math.min(1, m.op * flick);
          const grad    = ctx.createRadialGradient(m.x, m.y, 0, m.x, m.y, m.r * 2.5);
          grad.addColorStop(0,   `rgba(201, 168, 108, ${finalOp})`);
          grad.addColorStop(0.4, `rgba(223, 202, 157, ${(finalOp * 0.55).toFixed(3)})`);
          grad.addColorStop(1,   'rgba(201, 168, 108, 0)');

          ctx.beginPath();
          ctx.fillStyle = grad;
          ctx.arc(m.x, m.y, m.r * 2.5, 0, Math.PI * 2);
          ctx.fill();
        });

        this.raf = requestAnimationFrame(() => this._loop());
      }

      stop() {
        this.running = false;
        if (this.raf) cancelAnimationFrame(this.raf);
      }
    }

    /* ════════════════════════════════════════════════════════════════
       TIPEADO WORD-BY-WORD CINEMÁTICO TGP
       Idéntico al comportamiento de CinematicEssayReader.astro:
         - IntersectionObserver dispara por bloque
         - Cada palabra emerge con clase .aqt-revealed (75ms/palabra)
         - Cursor dorado parpadea y se apaga al terminar el bloque
    ════════════════════════════════════════════════════════════════ */
    function wrapWordsInCinematicBlocks(root) {
      const blocks = root.querySelectorAll('.cinematic-block');
      blocks.forEach(block => {
        if (block.dataset.aqtInit === 'true') return;
        block.dataset.aqtInit = 'true';

        // Sólo los <p> directos del bloque cinemático
        const paragraphs = block.querySelectorAll('p');
        paragraphs.forEach(para => {
          // No procesar si ya fue wrapeado
          if (para.querySelector('.aqt-word')) return;

          const originalText = para.innerHTML;
          // Tokenizar preservando HTML interior (negritas, cursivas, spans)
          // Estrategia: dividir por espacios preservando etiquetas HTML abiertas/cerradas
          const tempDiv = document.createElement('div');
          tempDiv.innerHTML = originalText;
          const textContent = tempDiv.textContent || tempDiv.innerText || '';
          const words = textContent.trim().split(/\s+/).filter(w => w.length > 0);

          if (!words.length) return;

          // Reconstruir con spans para cada palabra (usando textContent simple)
          // Para no romper el HTML interior, re-procesamos el innerHTML tokenizando nodos de texto
          const newHtml = words.map((w, i) =>
            `<span class="aqt-word" data-wi="${i}">${w}</span>`
          ).join('\u00A0');

          para.innerHTML = newHtml;

          // Agregar cursor al final
          const cursor = document.createElement('span');
          cursor.className = 'aqt-cursor';
          cursor.setAttribute('aria-hidden', 'true');
          cursor.textContent = '|';
          para.appendChild(cursor);
        });
      });
    }

    function initArquetipoTyping(root) {
      const blocks = root.querySelectorAll('.cinematic-block');
      const TYPING_DELAY_MS = 72;

      blocks.forEach(block => {
        const words  = Array.from(block.querySelectorAll('.aqt-word'));
        const cursor = block.querySelector('.aqt-cursor');
        if (!words.length) return;

        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            observer.unobserve(block);

            words.forEach((w, i) => {
              setTimeout(() => w.classList.add('aqt-revealed'), i * TYPING_DELAY_MS);
            });

            const totalTime = words.length * TYPING_DELAY_MS + 700;
            setTimeout(() => {
              if (cursor) cursor.style.opacity = '0';
            }, totalTime);
          });
        }, { threshold: 0.12 });

        observer.observe(block);
      });
    }

    /* ════════════════════════════════════════════════════════════════
       INICIALIZACIÓN GLOBAL
    ════════════════════════════════════════════════════════════════ */
    function initArquetipoRespiro() {
      // 0. Fondo hero del post: leer el src de la imagen del InteriorHero ya renderizada
      //    y aplicarla como background-image fijo al body (más confiable que SSR con ImageMetadata)
      const postArticle = document.getElementById('post-article');
      if (postArticle && postArticle.dataset.isArquetipo === 'true') {
        // Obtener la imagen del InteriorHero ya renderizada en el DOM
        const heroImg = document.querySelector('.interior-hero-image');
        const imgSrc = heroImg
          ? (heroImg.currentSrc || heroImg.getAttribute('src') || '')
          : (postArticle.dataset.heroBg || '');
        const imgPos = postArticle.dataset.imagePosition || 'center center';

        if (imgSrc) {
          document.body.classList.add('arquetipo-body-mode');
          const overlay = document.getElementById('arquetipo-overlay');
          if (overlay) {
            // Imagen + gradiente de oscurecimiento cinemático combinados
            overlay.style.background = [
              `linear-gradient(to bottom, rgba(10,10,12,0.55) 0%, rgba(10,10,12,0.80) 55%, rgba(10,10,12,0.97) 100%)`,
              `url("${imgSrc}") ${imgPos} / cover fixed`
            ].join(', ');
          }
        }
      }

      // 1. Polvo dorado
      const canvas = document.getElementById('arquetipo-polvo-canvas');
      if (canvas && !canvas.dataset.pdInit) {
        canvas.dataset.pdInit = 'true';
        const dust = new ArquetipoPolvo(canvas);
        dust.start();
      }

      // 2. Tipeado word-by-word
      const typingRoot = document.querySelector('.arquetipo-typing-root');
      if (typingRoot && !typingRoot.dataset.aqtGlobalInit) {
        typingRoot.dataset.aqtGlobalInit = 'true';
        wrapWordsInCinematicBlocks(typingRoot);
        initArquetipoTyping(typingRoot);
      }
    }

    document.addEventListener('astro:page-load', initArquetipoRespiro);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initArquetipoRespiro();
    } else {
      document.addEventListener('DOMContentLoaded', initArquetipoRespiro);
    }

    // Limpiar init flags al navegar (View Transitions)
    document.addEventListener('astro:before-swap', () => {
      const canvas = document.getElementById('arquetipo-polvo-canvas');
      if (canvas) canvas.dataset.pdInit = '';
      const typingRoot = document.querySelector('.arquetipo-typing-root');
      if (typingRoot) {
        typingRoot.dataset.aqtGlobalInit = '';
        typingRoot.querySelectorAll('.cinematic-block').forEach(b => {
          b.dataset.aqtInit = '';
        });
      }
      // Limpiar clase del body para no contaminar otras páginas
      document.body.classList.remove('arquetipo-body-mode');
    });
  })();
</script>
