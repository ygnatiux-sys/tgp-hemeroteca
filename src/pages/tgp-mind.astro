---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import TgpMindSidebar from '../modules/tgp-agents/TgpMindSidebar';
---

<Layout title="TGP Mind · Atanor Cognitivo" hideHeader={true} footerVariant="minimal" bodyClass="bg-[#07090a]">
  <div class="min-h-screen flex flex-col bg-[#07090a] text-[#d4d4d2]">
    <!-- Barra Superior de Navegación Operativa -->
    <header class="border-b border-[rgba(224,122,95,0.2)] bg-[#0c0e10]/90 backdrop-blur-md px-4 sm:px-8 py-3.5 flex items-center justify-between z-50">
      <div class="flex items-center gap-4">
        <a
          href="/tgp-app"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-[#263231] hover:border-[#e07a5f]/50 bg-[#14181c] hover:bg-[#1a2026] text-xs font-mono text-[#8a9a98] hover:text-[#ffb499] transition-all"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Scriptorium
        </a>
        <div class="h-4 w-px bg-[rgba(224,122,95,0.2)]"></div>
        <div>
          <h1 class="text-sm font-serif tracking-wide text-[#f0f2f1] flex items-center gap-2.5">
            <span class="font-bold tracking-widest text-[#EFEBE3]">TGP MIND</span>
            <span class="text-[10px] uppercase font-mono tracking-widest text-[#ffb499] bg-[#e07a5f]/15 border border-[#e07a5f]/40 px-2 py-0.5 rounded-full">
              Gemini Raw &amp; Deep
            </span>
          </h1>
          <p class="text-[11px] text-[#8a9a98] font-mono mt-0.5">Brainstorming epistémico, consultas sin filtro y síntesis de taller privado</p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-2 text-[11px] font-mono text-[#ffb499]">
          <span class="w-2 h-2 rounded-full bg-[#e07a5f] animate-pulse"></span>
          <span>Nodo: Atanor Local / Cloud Run</span>
        </div>
        <a
          href="/mesa-redaccion"
          class="text-[10px] font-mono text-[#8a9a98] hover:text-[#60a5fa] bg-[#14181c] border border-[#263231] hover:border-blue-500/50 px-2.5 py-1 rounded transition-colors"
        >
          Ir a Mesa Dialogflow ➔
        </a>
      </div>
    </header>

    <!-- Canvas Principal Fullscreen -->
    <main class="grow p-2 sm:p-6 flex flex-col justify-center items-center">
      <div class="w-full max-w-5xl h-[calc(100vh-100px)] border border-[rgba(224,122,95,0.25)] rounded-2xl bg-[#0c0e10] overflow-hidden shadow-[0_0_50px_rgba(0,0,0,0.8)] relative">
        <TgpMindSidebar client:load mode="fullscreen" />
      </div>
    </main>
  </div>
</Layout>
