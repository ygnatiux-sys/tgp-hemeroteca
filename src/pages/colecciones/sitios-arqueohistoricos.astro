---
export const prerender = true;
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CinematicArchiveCard from '../../components/CinematicArchiveCard.astro';
import CinematicPostEngine from '../../components/CinematicPostEngine.astro';
import Marquee from '../../components/Marquee.astro';
import CinematicExcerptRest from '../../components/CinematicExcerptRest.astro';
import AguaNieve from '../../components/AguaNieve.astro';
import {
  getPublishableEssays,
  formatDate,
  formatYear,
  resolveEssayImage,
  sortEssaysByVisualFirst,
} from '../../lib/content-filter';

// ─── CARGA Y FILTRADO ────────────────────────────────────────────────────────
const allEssaysRaw = await getCollection('ensayos').catch(() => []);
const allGeorefsRaw = await getCollection('georreferencias').catch(() => []);

const isProd = import.meta.env.PROD;
const publishableEssays = getPublishableEssays(allEssaysRaw, isProd);
const publishableGeorefs = getPublishableEssays(allGeorefsRaw, isProd);

const publishable = [...publishableEssays, ...publishableGeorefs].sort(sortEssaysByVisualFirst);

// Filtrar artículos de la colección "Sitios Geohistóricos & Arqueohistóricos"
const geohistoricalEssays = publishable.filter(e => {
  const cat = e.entry.category?.toLowerCase() || '';
  return Boolean(e.entry.sitioGeohistorico) || Boolean((e.entry as any).volantaHook) || (e as any).collection === 'georreferencias' || cat.includes('arqueo') || cat.includes('sitio') || cat.includes('historia antigua');
});

const resolvedEssays = geohistoricalEssays.map(e => {
  const showImg = e.entry.publicarConImagen !== false;
  const img = showImg ? resolveEssayImage(e.entry, e.slug) : null;
  return {
    ...e,
    showImg,
    img
  };
});

const coverImage = resolvedEssays.find(e => e.img)?.img ?? null;
const coverEntry = resolvedEssays.find(e => e.img)?.entry;
const coverPosition =
  (coverEntry as any)?.coverImagePosition
  || (coverEntry as any)?.imagePosition
  || 'center center';

// ─── HELPER PARA SECUENCIAS CINE PREMIER (1 HERO FULL + DÚO 60/40) ──────────
function createPremierSequences(items: typeof resolvedEssays) {
  const sequences: Array<{
    hero: typeof resolvedEssays[0];
    duo: typeof resolvedEssays;
  }> = [];
  
  for (let i = 0; i < items.length; i += 3) {
    sequences.push({
      hero: items[i],
      duo: items.slice(i + 1, i + 3),
    });
  }
  return sequences;
}

const sequences = createPremierSequences(resolvedEssays);

// ─── SLIDES PARA EL ENGINE: georreferencias en orden visual-first ────────────
const geoSlides = resolvedEssays
  .filter(e => e.img)
  .map(e => ({
    id: e.slug,
    title: e.entry.title || 'Sitio',
    subtitle: e.entry.excerpt || '',
    category: (e.entry as any).sitioGeohistorico ? 'Sitio Geohistórico' : 'Georreferencia',
    date: e.entry.date ? formatYear(e.entry.date) : '',
    image: (e.img as any)?.src ?? e.img,
    imagePosition: (e.entry as any).coverImagePosition || (e.entry as any).imagePosition || 'center center',
    link: `/hemeroteca/${e.slug}`,
    papersLink: (e.entry as any).papersSlug ? `/papers/${(e.entry as any).papersSlug}` : undefined,
  }));
---

<Layout
  title="Sitios Geohistóricos & Arqueohistóricos | Hemeroteca TGP"
  description="Cartografía epistémica y análisis arqueosemiótico de lugares sagrados y sitios arqueohistóricos en The Great Puzzle Project."
  image={coverImage?.src || (coverImage as any)}
>
  <div class="text-white min-h-screen pb-32">

    {/* ── HERO PRINCIPAL CINEMÁTICO DARK GLOOCK (H1) ── */}
    <Marquee 
      title="SITIOS GEOHISTÓRICOS" 
      subtitle="Cartografía epistémica & análisis arqueosemiótico de lugares sagrados" 
      imageUrl={coverImage?.src || (coverImage as any) || ''} 
      vibeClass="vibe-travel-senses" 
      isH1={true} 
      fontClass="font-serif font-black"
    />

    {/* ── RESPIRO VISUAL / EXCERPT DOBLE SCROLL POLVO DORADO & TYPEMAGIC EN BG-MAIN ── */}
    <CinematicExcerptRest 
      text="Umbrales de [[piedra y silencio]]. **Hitos geohistóricos** que interrogan a la modernidad desde la profundidad de su propio misterio."
    />

    {/* ── ENGINE AUTO CINEMÁTICO: georreferencias full-viewport ── */}
    {geoSlides.length > 0 && (
      <CinematicPostEngine slides={geoSlides} maxSlides={15} />
    )}

    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-12 md:gap-16 pt-8 md:pt-12">

      {/* ═══════════════════════════════════════════════════════════════════
          GRILLA CINEMÁTICA PREMIER DE SITIOS GEOHISTÓRICOS
      ═══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-12 md:gap-16">
        <div class="reveal-item flex items-end justify-between border-b border-white/10 pb-4">
          <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#EFEBE3]">
            Catálogo Georreferenciado
          </span>
          <span class="font-mono text-[9px] text-white/40 tracking-[0.2em]">
            Investigaciones con Módulo Multi-Dimensional
          </span>
        </div>

        <div class="flex flex-col gap-10 md:gap-14">
          {sequences.map((seq, seqIdx) => (
            <div class="premier-sequence flex flex-col gap-6 md:gap-8">
              {/* 1. Hero Cinemático Full Bleed */}
              <div class="w-full">
                <CinematicArchiveCard
                  slug={seq.hero.slug}
                  entry={seq.hero.entry}
                  img={seq.hero.img}
                  variant="hero"
                  enableCinemagraph={true}
                />
              </div>

              {/* 1.5. Excerpt AguaNieve (sleet + conversational 2-line chunks) */}
              {seqIdx === 0 && (
                <AguaNieve category="georreferencias" />
              )}

              {/* 2. Dúo 60/40 */}
              {seq.duo.length > 0 && (
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
                  {seq.duo[0] && (
                    <div class={seq.duo.length > 1 ? "lg:col-span-7 flex flex-col" : "lg:col-span-12 flex flex-col"}>
                      <CinematicArchiveCard
                        slug={seq.duo[0].slug}
                        entry={seq.duo[0].entry}
                        img={seq.duo[0].img}
                        variant={seq.duo.length > 1 ? "duo-60" : "hero"}
                        enableCinemagraph={true}
                      />
                    </div>
                  )}
                  {seq.duo[1] && (
                    <div class="lg:col-span-5 flex flex-col">
                      <CinematicArchiveCard
                        slug={seq.duo[1].slug}
                        entry={seq.duo[1].entry}
                        img={seq.duo[1].img}
                        variant="duo-40"
                        enableCinemagraph={true}
                      />
                    </div>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>

        {resolvedEssays.length === 0 && (
          <div class="p-16 text-center bg-white/3 border border-white/10 rounded-xl">
            <p class="font-mono text-[11px] uppercase tracking-[0.3em] text-white/40 mb-3">
              No hay sitios geohistóricos guardados aún.
            </p>
            <p class="font-serif text-white/60 text-sm tracking-wide">
              Al guardar o crear un post desde Keystatic con la categoría o sitio arqueohistórico (ej: Aramu Muru, Tikal, Bonampak), aparecerá automáticamente en esta sección.
            </p>
          </div>
        )}
      </section>

      <div class="pt-8 border-t border-white/10 flex justify-between font-mono text-[10px] uppercase tracking-[0.3em]">
        <a href="/colecciones/" class="text-white/40 hover:text-[#EFEBE3] transition-colors flex items-center gap-2">
          <span>←</span>
          <span>Volver a Colecciones</span>
        </a>
        <a href="/archivo/" class="text-white/40 hover:text-[#EFEBE3] transition-colors flex items-center gap-2">
          <span>Catálogo Completo</span>
          <span>→</span>
        </a>
      </div>

    </div>
  </div>
</Layout>
