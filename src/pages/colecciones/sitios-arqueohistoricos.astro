---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CinematicArchiveCard from '../../components/CinematicArchiveCard.astro';
import {
  getPublishableEssays,
  formatDate,
  formatYear,
  resolveEssayImage,
} from '../../lib/content-filter';

// ─── CARGA Y FILTRADO ────────────────────────────────────────────────────────
const allEssaysRaw = await getCollection('ensayos').catch(() => []);
const allGeorefsRaw = await getCollection('georreferencias').catch(() => []);

const isProd = import.meta.env.PROD;
const publishableEssays = getPublishableEssays(allEssaysRaw, isProd);
const publishableGeorefs = getPublishableEssays(allGeorefsRaw, isProd);

const publishable = [...publishableEssays, ...publishableGeorefs];

// Filtrar artículos de la colección "Sitios Geohistóricos & Arqueohistóricos"
const geohistoricalEssays = publishable.filter(e => {
  const cat = e.entry.category?.toLowerCase() || '';
  return Boolean(e.entry.sitioGeohistorico) || Boolean((e.entry as any).volantaHook) || (e as any).collection === 'georreferencias' || cat.includes('arqueo') || cat.includes('sitio') || cat.includes('historia antigua');
});

const resolvedEssays = geohistoricalEssays.map(e => {
  const showImg = e.entry.publicarConImagen !== false;
  const img = showImg ? resolveEssayImage(e.entry.coverImage, e.slug) : null;
  return {
    ...e,
    showImg,
    img
  };
});

// ─── HELPER PARA SECUENCIAS CINE PREMIER (1 HERO FULL + DÚO 60/40) ──────────
function createPremierSequences(items: typeof resolvedEssays) {
  const sequences: Array<{
    hero: typeof resolvedEssays[0];
    duo: typeof resolvedEssays;
  }> = [];
  
  for (let i = 0; i < items.length; i += 3) {
    sequences.push({
      hero: items[i],
      duo: items.slice(i + 1, i + 3),
    });
  }
  return sequences;
}

const sequences = createPremierSequences(resolvedEssays);
---

<Layout title="Sitios Geohistóricos & Arqueohistóricos | Hemeroteca TGP">
  <div class="bg-theme-dark text-white min-h-screen pb-32">

    {/* ═══════════════════════════════════════════════════════════════════
        HERO INSTITUCIONAL DE LA NUEVA COLECCIÓN
    ═══════════════════════════════════════════════════════════════════ */}
    <section class="relative w-full pt-28 pb-12 px-6 md:px-12 lg:px-24 overflow-hidden border-b border-white/10 bg-linear-to-b from-[#0a0f0d] via-theme-dark to-theme-dark">
      
      <div class="max-w-360 mx-auto">
        <nav class="mb-6 flex items-center gap-3 font-mono text-[9px] uppercase tracking-[0.3em] text-white/40">
          <a href="/colecciones" class="hover:text-[#C8A98B] transition-colors">Colecciones</a>
          <span>/</span>
          <span class="text-[#C8A98B]">Georreferencias</span>
        </nav>

        {/* H1 CON CINZEL EXTRABOLD Y GRADIENTE ACERO iOS STYLE */}
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-cinzel font-extrabold tracking-tight leading-none mb-4 gradient-acero-ios drop-shadow-2xl">
          SITIOS GEOHISTÓRICOS
        </h1>

        {/* H2 CON SANS OUTFIT / JAKARTA THIN Y LETTER-SPACING AMPIO */}
        <h2 class="text-xl md:text-2xl lg:text-3xl h2-thin-hook text-white/70 max-w-3xl leading-relaxed">
          CARTOGRAFÍA EPISTÉMICA & ANÁLISIS ARQUEOSEMIÓTICO DE LUGARES SAGRADOS
        </h2>

        <div class="flex items-center gap-4 mt-6 pt-6 border-t border-white/10 flex-wrap">
          <span class="px-3 py-1 bg-white/10 backdrop-blur-md rounded-full border border-white/15 font-mono text-[10px] uppercase tracking-[0.3em] text-[#C8A98B] font-bold">
            {resolvedEssays.length} {resolvedEssays.length === 1 ? 'sitio documentado' : 'sitios documentados'}
          </span>
          <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-white/40">
            Geología · Arqueología · Etnografía · Hermenéutica
          </span>
        </div>
      </div>
    </section>

    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-16 pt-12 md:pt-16">

      {/* ═══════════════════════════════════════════════════════════════════
          GRILLA CINEMÁTICA PREMIER DE SITIOS GEOHISTÓRICOS
      ═══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-12 md:gap-16">
        <div class="reveal-item flex items-end justify-between border-b border-white/10 pb-4">
          <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B]">
            Catálogo Georreferenciado
          </span>
          <span class="font-mono text-[9px] text-white/40 tracking-[0.2em]">
            Investigaciones con Módulo Multi-Dimensional
          </span>
        </div>

        <div class="flex flex-col gap-10 md:gap-14">
          {sequences.map((seq) => (
            <div class="premier-sequence flex flex-col gap-6 md:gap-8">
              {/* 1. Hero Cinemático Full Bleed */}
              <div class="w-full">
                <CinematicArchiveCard
                  slug={seq.hero.slug}
                  entry={seq.hero.entry}
                  img={seq.hero.img}
                  variant="hero"
                  enableCinemagraph={true}
                />
              </div>

              {/* 2. Dúo 60/40 */}
              {seq.duo.length > 0 && (
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
                  {seq.duo[0] && (
                    <div class={seq.duo.length > 1 ? "lg:col-span-7 flex flex-col" : "lg:col-span-12 flex flex-col"}>
                      <CinematicArchiveCard
                        slug={seq.duo[0].slug}
                        entry={seq.duo[0].entry}
                        img={seq.duo[0].img}
                        variant={seq.duo.length > 1 ? "duo-60" : "hero"}
                        enableCinemagraph={true}
                      />
                    </div>
                  )}
                  {seq.duo[1] && (
                    <div class="lg:col-span-5 flex flex-col">
                      <CinematicArchiveCard
                        slug={seq.duo[1].slug}
                        entry={seq.duo[1].entry}
                        img={seq.duo[1].img}
                        variant="duo-40"
                        enableCinemagraph={true}
                      />
                    </div>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>

        {resolvedEssays.length === 0 && (
          <div class="p-16 text-center bg-white/3 border border-white/10 rounded-xl">
            <p class="font-mono text-[11px] uppercase tracking-[0.3em] text-white/40 mb-3">
              No hay sitios geohistóricos guardados aún.
            </p>
            <p class="font-serif text-white/60 text-sm italic">
              Al guardar o crear un post desde Keystatic con la categoría o sitio arqueohistórico (ej: Aramu Muru, Tikal, Bonampak), aparecerá automáticamente en esta sección.
            </p>
          </div>
        )}
      </section>

      <div class="pt-8 border-t border-white/10 flex justify-between font-mono text-[10px] uppercase tracking-[0.3em]">
        <a href="/colecciones" class="text-white/40 hover:text-[#C8A98B] transition-colors flex items-center gap-2">
          <span>←</span>
          <span>Volver a Colecciones</span>
        </a>
        <a href="/archivo" class="text-white/40 hover:text-[#C8A98B] transition-colors flex items-center gap-2">
          <span>Catálogo Completo</span>
          <span>→</span>
        </a>
      </div>

    </div>
  </div>
</Layout>
