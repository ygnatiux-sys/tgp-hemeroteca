---
/**
 * src/pages/colecciones/europa-oculta/index.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * PÁGINA OFICIAL DE COLECCIÓN: EUROPA OCULTA & CATACUMBAS
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import BackSlideButton from '../../../components/BackSlideButton.astro';
import ImaxMax from '../../../components/ImaxMax.astro';
---

<Layout title="Europa Oculta & Catacumbas · Colección Arqueosemiótica | TGP">
  <main class="w-full bg-[#0a0709] text-[#e5d8dc] min-h-screen">
    
    <div class="fixed top-5 left-6 z-40">
      <BackSlideButton fallbackUrl="/colecciones/" />
    </div>

    <!-- EXPERIENCIA CINEMÁTICA PRINCIPAL: CÁMARAS Y MONOLITOS SUBTERRÁNEOS -->
    <section class="w-full">
      <ImaxMax collection="alternative" />
    </section>

    <!-- BANNER EDITORIAL DE CINTA -->
    <div class="py-4 bg-[#050304] border-y border-[#d45632]/25 overflow-hidden">
      <div class="whitespace-nowrap font-mono text-xs uppercase tracking-[0.3em] text-[#d45632] text-center animate-pulse">
        EUROPA OCULTA · STONEHENGE · MONTSEGUR Y LOS CÁTAROS · LABERINTO DE CNOSOS · ALTAMIRA Y LASCAUX · CATACUMBAS DE ROMA
      </div>
    </div>

    <!-- GRID DE CAPÍTULOS HIJOS -->
    <section class="max-w-7xl mx-auto px-6 py-20">
      <div class="flex flex-col md:flex-row items-start md:items-end justify-between mb-12 border-b border-white/10 pb-6">
        <div>
          <span class="font-mono text-xs uppercase tracking-[0.3em] text-[#d45632]">Expedientes del Subsuelo & Herejías</span>
          <h2 class="font-serif text-3xl sm:text-5xl font-black uppercase tracking-tight text-white mt-2">
            Hitos Arqueológicos & Memoria Europea
          </h2>
        </div>
        <p class="font-mono text-xs uppercase tracking-widest text-stone-400 mt-4 md:mt-0 max-w-md">
          Megalitismo atlántico, templos circulares, herejías medievales y arte rupestre paleolítico.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- STONEHENGE -->
        <a href="/hemeroteca/stonehenge/" class="group block rounded-2xl border border-white/10 bg-[#120a0e] p-7 hover:border-[#d45632]/60 transition-all duration-300 shadow-xl">
          <span class="font-mono text-[10px] uppercase text-[#d45632]">Episodio I · Britania</span>
          <h3 class="font-serif text-2xl font-bold uppercase text-white group-hover:text-[#d45632] transition-colors mt-2">
            Stonehenge
          </h3>
          <p class="font-sans text-xs text-stone-300 mt-2">
            El círculo megalítico de sarsen y piedras azules con alineaciones astronómicas del Neolítico.
          </p>
        </a>

        <!-- MONTSEGUR Y LOS CATAROS -->
        <a href="/hemeroteca/montsegur-y-las-herejias-medievales/" class="group block rounded-2xl border border-white/10 bg-[#120a0e] p-7 hover:border-[#d45632]/60 transition-all duration-300 shadow-xl">
          <span class="font-mono text-[10px] uppercase text-[#d45632]">Episodio II · Occitania</span>
          <h3 class="font-serif text-2xl font-bold uppercase text-white group-hover:text-[#d45632] transition-colors mt-2">
            Montségur & Los Cátaros
          </h3>
          <p class="font-sans text-xs text-stone-300 mt-2">
            El drama metafísico albigense, el pogromo eclesial y el asedio en la fortaleza pirenaica.
          </p>
        </a>

        <!-- CUEVAS DE ALTAMIRA -->
        <a href="/hemeroteca/cueva-de-altamira/" class="group block rounded-2xl border border-white/10 bg-[#120a0e] p-7 hover:border-[#d45632]/60 transition-all duration-300 shadow-xl">
          <span class="font-mono text-[10px] uppercase text-[#d45632]">Episodio III · Cantabria</span>
          <h3 class="font-serif text-2xl font-bold uppercase text-white group-hover:text-[#d45632] transition-colors mt-2">
            Cueva de Altamira
          </h3>
          <p class="font-sans text-xs text-stone-300 mt-2">
            Los bisontes policromos del Magdaleniense y el alumbramiento de la conciencia figurativa en la roca.
          </p>
        </a>

        <!-- LABERINTO DE CNOSOS -->
        <a href="/hemeroteca/sombras-de-cnosos-la-hemeroteca-del-laberinto-y-el-monstruo-interior/" class="group block rounded-2xl border border-white/10 bg-[#120a0e] p-7 hover:border-[#d45632]/60 transition-all duration-300 shadow-xl">
          <span class="font-mono text-[10px] uppercase text-[#d45632]">Episodio IV · Creta</span>
          <h3 class="font-serif text-2xl font-bold uppercase text-white group-hover:text-[#d45632] transition-colors mt-2">
            Sombras de Cnosos
          </h3>
          <p class="font-sans text-xs text-stone-300 mt-2">
            El palacio minoico, el mito del laberinto táurico y la fractura arquetípica de la civilización egea.
          </p>
        </a>

        <!-- JULIO CESAR Y LOS GALOS -->
        <a href="/hemeroteca/julio-cesar-y-los-galos-2026/" class="group block rounded-2xl border border-white/10 bg-[#120a0e] p-7 hover:border-[#d45632]/60 transition-all duration-300 shadow-xl">
          <span class="font-mono text-[10px] uppercase text-[#d45632]">Episodio V · Galia</span>
          <h3 class="font-serif text-2xl font-bold uppercase text-white group-hover:text-[#d45632] transition-colors mt-2">
            César en Alesia
          </h3>
          <p class="font-sans text-xs text-stone-300 mt-2">
            La doble muralla de asedio, la caída de Vercingétorix y la romanización forzosa del mundo celta.
          </p>
        </a>

        <!-- SCHLIEMANN Y TROYA -->
        <a href="/hemeroteca/schlieman-y-el-descubrimiento-de-troya/" class="group block rounded-2xl border border-white/10 bg-[#120a0e] p-7 hover:border-[#d45632]/60 transition-all duration-300 shadow-xl">
          <span class="font-mono text-[10px] uppercase text-[#d45632]">Episodio VI · Anatolia / Egeo</span>
          <h3 class="font-serif text-2xl font-bold uppercase text-white group-hover:text-[#d45632] transition-colors mt-2">
            Troya & Schliemann
          </h3>
          <p class="font-sans text-xs text-stone-300 mt-2">
            La colina de Hissarlik, la excavación obsesiva de la Ilíada y el tesoro de Príamo.
          </p>
        </a>

      </div>
    </section>

  </main>
</Layout>
