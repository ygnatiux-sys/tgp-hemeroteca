---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CinematicArchiveCard from '../../components/CinematicArchiveCard.astro';
import CinematicPostEngine from '../../components/CinematicPostEngine.astro';
import InteriorHero from '../../components/InteriorHero.astro';
import {
  getPublishableEssays,
  groupByCategory,
  formatCategory,
  formatYear,
  resolveEssayImage,
  sortEssaysByVisualFirst,
} from '../../lib/content-filter';

// ─── CARGA Y FILTRADO ────────────────────────────────────────────────────────
const allEssaysRaw = await getCollection('ensayos').catch(() => []);
const allArquetiposRaw = await getCollection('arquetiposGlobales').catch(() => []);
const isProd = import.meta.env.PROD;
const publishable = [
  ...getPublishableEssays(allEssaysRaw, isProd),
  ...getPublishableEssays(allArquetiposRaw, isProd)
].sort(sortEssaysByVisualFirst);

// ─── TODAS LAS COLECCIONES TEMÁTICAS (≥ 1 ARTÍCULO) ──────────────────────────
const categoryGroups = groupByCategory(publishable, 1);

// Convertir a array ordenado por número de artículos (descendente)
const collections = Array.from(categoryGroups.entries())
  .map(([key, rawEssays]) => {
    const essays = rawEssays.map(essay => ({
      ...essay,
      img: resolveEssayImage(essay.entry.coverImage, essay.slug),
    }));
    return {
      key,
      label: formatCategory(rawEssays[0].entry.category),
      count: essays.length,
      essays,
      coverEssay: essays[0],
    };
  })
  .sort((a, b) => b.count - a.count);

const indexCover = collections[0]?.coverEssay?.img ?? null;
const indexCoverPosition =
  (collections[0]?.coverEssay?.entry as any)?.coverImagePosition
  || (collections[0]?.coverEssay?.entry as any)?.imagePosition
  || 'center center';

// ─── SLIDES PARA EL ENGINE: una slide por coleccion en orden de tamaño ────────
const coleccionesSlides = collections
  .filter(col => col.coverEssay?.img)
  .map(col => ({
    id: col.key,
    title: col.label,
    subtitle: `${col.count} artículo${col.count > 1 ? 's' : ''}`,
    category: 'Colección TGP',
    image: (col.coverEssay.img as any)?.src ?? col.coverEssay.img,
    imagePosition: (col.coverEssay.entry as any).coverImagePosition ||
                   (col.coverEssay.entry as any).imagePosition ||
                   'center center',
    link: `/colecciones/${col.key}`,
  }));
---

<Layout title="Colecciones | The Great Puzzle Project">
  <div class="text-white min-h-screen pb-32">

    <InteriorHero
      title="Colecciones"
      image={indexCover}
      imageAlt="Colecciones del archivo TGP"
      imagePosition={indexCoverPosition}
      eyebrow="The Great Puzzle Project"
      subtitle="Organización temática del archivo de investigaciones"
      titleClass="text-5xl md:text-6xl lg:text-7xl font-cinzel font-extrabold tracking-tight leading-none gradient-acero-ios"
    >
      {/* F2: text-[10px] → text-xs */}
      <div slot="meta" class="font-mono text-xs uppercase tracking-[0.3em] text-[#EFEBE3] font-bold">
        {collections.length} {collections.length === 1 ? 'colección' : 'colecciones'} · {publishable.length} dossiers
      </div>
    </InteriorHero>

    {/* ── ENGINE AUTO CINEMÁTICO: cicla colecciones full-viewport ── */}
    {coleccionesSlides.length > 0 && (
      <CinematicPostEngine slides={coleccionesSlides} />
    )}

    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-12 md:gap-16 pt-8 md:pt-12">

      {/* BANNER DESTACADO: SITIOS GEOHISTÓRICOS */}
      <section class="reveal-item">
        <a
          href="/colecciones/sitios-arqueohistoricos"
          class="group block p-8 md:p-12 rounded-2xl border border-white/15 bg-linear-to-r from-[#0d141b] via-[#121c24] to-[#0a0f14] hover:border-[#64b5f6]/60 transition-all duration-500 shadow-2xl relative overflow-hidden"
        >
          <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex flex-col gap-2 max-w-3xl">
              {/* F2: text-[10px] → text-xs (WCAG min 12px) */}
              <span class="font-mono text-xs uppercase tracking-[0.4em] text-[#64b5f6]">
                Colección Especializada
              </span>
              <h2 class="text-3xl md:text-5xl font-cinzel font-extrabold tracking-tight leading-tight gradient-acero-ios">
                Sitios Geohistóricos &amp; Arqueohistóricos
              </h2>
              <p class="h2-thin-hook text-sm md:text-base text-white/60 tracking-[0.2em] mt-1">
                Aramu Muru · Tikal · Bonampak · Cartago · Qapaq Ñan · Yonaguni
              </p>
            </div>

            <div class="shrink-0">
              {/* F2: text-[10px] → text-xs */}
              <span class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-[#1e4976]/40 border border-[#64b5f6]/40 text-[#90caf9] font-mono text-xs uppercase tracking-[0.3em] font-bold group-hover:bg-[#1976d2] group-hover:text-white transition-all duration-300">
                Explorar Cartografía →
              </span>
            </div>
          </div>
        </a>
      </section>

      {/* ═══════════════════════════════════════════════════════════════════
          COLECCIONES TEMÁTICAS GENERALES — F5: Bento Asimétrico
          F6: grid-cols-1 en móvil, lg:grid-cols-12 en desktop
          F6: Texto siempre visible, sin group-hover reveal en touch
      ═══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-6 md:gap-8 w-full">
        {/* F5: CSS Grid Bento Asimétrico — F6: cols-1 en mobile */}
        <div class="grid grid-cols-1 lg:grid-cols-12 auto-rows-[minmax(280px,auto)] gap-6 lg:gap-8 w-full">
          {collections.map((col, index) => {
            // F5: distribución asimétrica según posición
            let spanClass = "lg:col-span-4 lg:row-span-1";
            if (index === 0) spanClass = "lg:col-span-12 lg:row-span-2";
            else if (index === 1) spanClass = "lg:col-span-7 lg:row-span-1";
            else if (index === 2) spanClass = "lg:col-span-5 lg:row-span-1";

            return (
              <a
                href={`/colecciones/${col.key}`}
                class={`group relative overflow-hidden rounded-2xl md:rounded-3xl border border-white/5 bg-theme-dark/80 shadow-2xl flex flex-col justify-end w-full isolate ${spanClass} min-h-75`}
              >
                {col.coverEssay?.img ? (
                  <Image
                    src={col.coverEssay.img}
                    alt={col.label}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : undefined}
                    decoding="async"
                    quality={80}
                    class="absolute inset-0 w-full h-full object-cover object-center brightness-90 contrast-[1.03] pointer-events-none -z-10 transition-transform duration-700 ease-out group-hover:scale-[1.018] group-hover:brightness-95"
                  />
                ) : (
                  <div class="absolute inset-0 w-full h-full bg-linear-to-br from-[#1c242b] via-theme-dark to-[#0a0b0b] -z-10" />
                )}

                {/* F1: Gradiente mobile CSS nativo puro (costo GPU=0). Desktop: backdrop-blur-[2px] suave */}
                {/* F6: Texto siempre visible — NO depende de :hover para revelar contenido en touch */}
                <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/50 via-45% to-transparent pointer-events-none z-10 md:backdrop-blur-[2px]"></div>

                <div class="relative z-20 p-6 md:p-8 flex flex-col justify-end h-full">
                  {/* F2: text-xs (WCAG). F6: siempre visible sin group-hover reveal */}
                  <span class="font-mono text-xs uppercase tracking-widest text-rust-orange font-bold mb-2">Colección TGP</span>
                  <h2 class="font-cinzel font-extrabold text-3xl md:text-4xl text-white mb-2 leading-tight drop-shadow-lg">{col.label}</h2>
                  <p class="font-sans text-sm text-white/80">{col.count} {col.count === 1 ? 'Documento' : 'Documentos'}</p>
                </div>
              </a>
            );
          })}
        </div>
      </section>

      {/* Fallback si no hay colecciones */}
      {collections.length === 0 && (
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-white/30 text-center py-20">
          No hay colecciones disponibles.
        </p>
      )}

    </div>
  </div>

  <script>
    const h1 = document.querySelector('h1');
    if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    document.addEventListener('astro:page-load', () => {
      const h1 = document.querySelector('h1');
      if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    });
  </script>
</Layout>
