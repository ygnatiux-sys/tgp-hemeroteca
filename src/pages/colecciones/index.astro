---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import {
  getPublishableEssays,
  groupByCategory,
  formatCategory,
  formatYear,
  resolveEssayImage,
} from '../../lib/content-filter';

// ─── CARGA Y FILTRADO ────────────────────────────────────────────────────────
const allEssaysRaw = await getCollection('ensayos').catch(() => []);
const isProd = import.meta.env.PROD;
const publishable = getPublishableEssays(allEssaysRaw, isProd);

// ─── TODAS LAS COLECCIONES TEMÁTICAS (≥ 1 ARTÍCULO) ──────────────────────────
const categoryGroups = groupByCategory(publishable, 1);

// Convertir a array ordenado por número de artículos (descendente)
const collections = Array.from(categoryGroups.entries())
  .map(([key, rawEssays]) => {
    const essays = rawEssays.map(essay => ({
      ...essay,
      img: resolveEssayImage(essay.entry.coverImage, essay.slug),
    }));
    return {
      key,
      label: formatCategory(rawEssays[0].entry.category),
      count: essays.length,
      essays,
      coverEssay: essays[0],
    };
  })
  .sort((a, b) => b.count - a.count);
---

<Layout title="Colecciones | The Great Puzzle Project">
  <div class="bg-theme-dark text-white min-h-screen pt-28 pb-32">
    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-12 md:gap-16">

      {/* ═══════════════════════════════════════════════════════════════════
          CABECERA
      ═══════════════════════════════════════════════════════════════════ */}
      <header class="border-l border-[#C8A98B]/40 pl-6 md:pl-10">
        <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B] block mb-2">The Great Puzzle Project</span>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-cinzel font-extrabold tracking-tight leading-none bg-linear-to-r from-white via-[#E2E8F0] to-[#94A3B8] bg-clip-text text-transparent drop-shadow-md">
          Colecciones
        </h1>
        <div class="reveal-item flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 mt-4">
          <p class="h2-thin-hook font-outfit uppercase tracking-[0.15em] text-white/60 text-xs md:text-sm">
            Organización temática del archivo de investigaciones
          </p>
          <div class="h-px w-12 bg-white/15 hidden sm:block" />
          <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-[#C8A98B] font-bold">
            {collections.length} {collections.length === 1 ? 'colección' : 'colecciones'} · {publishable.length} dossiers
          </p>
        </div>
      </header>

      {/* BANNER DESTACADO: SITIOS GEOHISTÓRICOS */}
      <section class="reveal-item">
        <a
          href="/colecciones/sitios-arqueohistoricos"
          class="group block p-8 md:p-12 rounded-2xl border border-white/15 bg-linear-to-r from-[#0d141b] via-[#121c24] to-[#0a0f14] hover:border-[#64b5f6]/60 transition-all duration-500 shadow-2xl relative overflow-hidden"
        >
          <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex flex-col gap-2 max-w-3xl">
              <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#64b5f6]">
                Colección Especializada
              </span>
              <h2 class="text-3xl md:text-5xl font-cinzel font-extrabold tracking-tight leading-tight gradient-acero-ios">
                Sitios Geohistóricos & Arqueohistóricos
              </h2>
              <p class="h2-thin-hook text-sm md:text-base text-white/60 tracking-[0.2em] mt-1">
                Aramu Muru · Tikal · Bonampak · Cartago · Qapaq Ñan · Yonaguni
              </p>
            </div>

            <div class="shrink-0">
              <span class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-[#1e4976]/40 border border-[#64b5f6]/40 text-[#90caf9] font-mono text-[10px] uppercase tracking-[0.3em] font-bold group-hover:bg-[#1976d2] group-hover:text-white transition-all duration-300">
                Explorar Cartografía →
              </span>
            </div>
          </div>
        </a>
      </section>

      {/* ═══════════════════════════════════════════════════════════════════
          COLECCIONES TEMÁTICAS GENERALES
          Formato: Hero de categoría a 2 columnas (foto izq / títulos y datos der)
          + debajo la galería de miniaturas desplazada horizontalmente.
      ═══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-12 md:gap-16">
        <div class="reveal-item border-b border-white/10 pb-4 flex items-center justify-between">
          <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B] font-bold">
            Colecciones Temáticas Generales
          </span>
          <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-white/40 hidden sm:inline">
            Desplazamiento horizontal para explorar
          </span>
        </div>

        <div class="flex flex-col gap-14 md:gap-20">
          {collections.map(({ key, label, count, essays, coverEssay }) => (
            <div class="reveal-item flex flex-col gap-6 border-b border-white/10 pb-14 last:border-b-0">
              
              {/* Hero Principal de la Categoría */}
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
                {/* Imagen Izquierda: 7 cols */}
                <a
                  href={`/colecciones/${encodeURIComponent(key)}`}
                  class="lg:col-span-7 group relative overflow-hidden rounded-2xl aspect-video bg-black/60 border border-white/10 hover:border-[#C8A98B]/50 transition-all duration-500 block"
                >
                  {coverEssay.img ? (
                    <>
                      <Image
                        src={coverEssay.img}
                        alt={label}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-85 group-hover:opacity-100"
                      />
                      <div class="absolute inset-0 bg-linear-to-t from-theme-dark/80 via-transparent to-transparent pointer-events-none" />
                    </>
                  ) : (
                    <div class="w-full h-full bg-linear-to-br from-[#1b2326] via-theme-dark to-[#0c0d0d] flex items-center justify-center">
                      <span class="font-cinzel text-sm text-[#C8A98B]/40 tracking-widest uppercase">TGP Archive</span>
                    </div>
                  )}
                </a>

                {/* Info Derecha: 5 cols */}
                <div class="lg:col-span-5 flex flex-col justify-center gap-5">
                  <div class="flex flex-col gap-2">
                    <span class="font-mono text-[10px] uppercase tracking-[0.35em] text-[#C8A98B] font-bold">
                      {count} {count === 1 ? 'INVESTIGACIÓN' : 'INVESTIGACIONES'}
                    </span>
                    <a href={`/colecciones/${encodeURIComponent(key)}`} class="group">
                      <h2 class="font-cinzel font-bold text-4xl md:text-5xl lg:text-6xl leading-tight text-white group-hover:text-[#C8A98B] transition-colors">
                        {label}
                      </h2>
                    </a>
                  </div>

                  {/* Lista de primeros artículos */}
                  <ul class="flex flex-col gap-2 border-t border-white/10 pt-4">
                    {essays.slice(0, 3).map(({ slug, entry }) => (
                      <li class="flex items-baseline gap-2 font-mono text-[10px] text-white/50 hover:text-white transition-colors">
                        <span class="text-[#C8A98B]/60 shrink-0">-</span>
                        <a href={`/hemeroteca/${slug}`} class="line-clamp-1 hover:underline">
                          {entry.title}
                        </a>
                      </li>
                    ))}
                    {count > 3 && (
                      <li class="font-mono text-[9px] text-white/30 pt-1">
                        + {count - 3} más
                      </li>
                    )}
                  </ul>

                  <a
                    href={`/colecciones/${encodeURIComponent(key)}`}
                    class="font-mono text-[10px] uppercase tracking-[0.3em] text-white/60 hover:text-[#C8A98B] flex items-center gap-2 transition-colors duration-300 mt-2 group"
                  >
                    <span>EXPLORAR COLECCIÓN</span>
                    <span class="group-hover:translate-x-1.5 transition-transform">→</span>
                  </a>
                </div>
              </div>

              {/* Galería de Miniaturas Desplazada Lateralmente DEBAJO */}
              {essays.length > 0 && (
                <div class="relative mt-2">
                  <div class="collection-gallery-scroll flex gap-4 md:gap-5 overflow-x-auto pb-4 pt-2 snap-x snap-mandatory scroll-smooth">
                    {essays.map(({ slug, entry, img }) => (
                      <a
                        href={`/hemeroteca/${slug}`}
                        class="group shrink-0 snap-start w-60 sm:w-68 md:w-76 flex flex-col rounded-xl overflow-hidden border border-white/10 bg-white/3 hover:border-[#C8A98B]/60 hover:bg-white/6 hover:shadow-[0_0_18px_rgba(200,169,139,0.18)] hover:-translate-y-1 transition-all duration-400"
                      >
                        {/* Miniatura Imagen */}
                        <div class="relative overflow-hidden aspect-16/10 bg-black/60">
                          {img ? (
                            <Image
                              src={img}
                              alt={entry.title || label}
                              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80 group-hover:opacity-100"
                            />
                          ) : (
                            <div class="w-full h-full bg-linear-to-br from-[#1b2326] via-theme-dark to-[#0c0d0d] flex items-center justify-center">
                              <span class="font-cinzel text-[9px] text-[#C8A98B]/40 tracking-widest uppercase">TGP Archive</span>
                            </div>
                          )}
                          <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/20 to-transparent" />
                          {entry.date && (
                            <div class="absolute top-2.5 right-2.5">
                              <span class="px-2 py-0.5 bg-black/75 backdrop-blur-sm rounded font-mono text-[8px] uppercase tracking-[0.2em] text-[#C8A98B] border border-white/10">
                                {formatYear(entry.date)}
                              </span>
                            </div>
                          )}
                        </div>

                        {/* Título y volanta dentro de la miniatura */}
                        <div class="p-4 flex flex-col justify-between flex-1 gap-2.5">
                          <div class="flex flex-col gap-1">
                            <h3 class="font-cinzel font-bold text-xs md:text-sm leading-snug text-white/90 group-hover:text-[#C8A98B] transition-colors line-clamp-2">
                              {entry.title}
                            </h3>
                            {entry.volanta && (
                              <p class="font-mono text-[9px] text-white/40 tracking-[0.05em] line-clamp-1">
                                {entry.volanta}
                              </p>
                            )}
                          </div>
                          <div class="flex items-center gap-1.5 font-mono text-[8px] uppercase tracking-[0.2em] text-white/35 group-hover:text-[#C8A98B] transition-colors pt-2 border-t border-white/5">
                            <span>Leer investigación</span>
                            <span class="group-hover:translate-x-1 transition-transform">→</span>
                          </div>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              )}

            </div>
          ))}
        </div>
      </section>

      {/* Fallback si no hay colecciones */}
      {collections.length === 0 && (
        <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-white/30 text-center py-20">
          No hay colecciones disponibles.
        </p>
      )}

    </div>
  </div>

  <style>
    .collection-gallery-scroll::-webkit-scrollbar {
      height: 4px;
    }
    .collection-gallery-scroll::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.03);
      border-radius: 4px;
    }
    .collection-gallery-scroll::-webkit-scrollbar-thumb {
      background: rgba(200, 169, 139, 0.25);
      border-radius: 4px;
    }
    .collection-gallery-scroll::-webkit-scrollbar-thumb:hover {
      background: rgba(200, 169, 139, 0.6);
    }
  </style>

  <script>
    const h1 = document.querySelector('h1');
    if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    document.addEventListener('astro:page-load', () => {
      const h1 = document.querySelector('h1');
      if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    });
  </script>
</Layout>
