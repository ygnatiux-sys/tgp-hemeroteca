---
export const prerender = true;
import Image from '../../components/SafeImage.astro';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CinematicArchiveCard from '../../components/CinematicArchiveCard.astro';
import CinematicPostEngine from '../../components/CinematicPostEngine.astro';
import CinematicExcerptRest from '../../components/CinematicExcerptRest.astro';
import Marquee from '../../components/Marquee.astro';
import {
  getPublishableEssays,
  groupByCategory,
  formatCategory,
  formatYear,
  resolveEssayImage,
  sortEssaysByVisualFirst,
  sanitizeImageUrl,
} from '../../lib/content-filter';

// ─── CARGA Y FILTRADO ────────────────────────────────────────────────────────
const allEssaysRaw = await getCollection('ensayos').catch(() => []);
const allCinematicosRaw = await getCollection('ensayosCinematicos').catch(() => []);
const allArquetiposRaw = await getCollection('arquetiposGlobales').catch(() => []);
const allGeorefsRaw = await getCollection('georreferencias').catch(() => []);
const isProd = import.meta.env.PROD;
const publishableGeorefs = getPublishableEssays(allGeorefsRaw, isProd);
const publishableCinematicos = allCinematicosRaw.map(item => ({
  slug: item.id.replace(/\/index$/, ''),
  isCinematicGSAP: true,
  entry: {
    title: item.data.title || 'Dossier Cinemático',
    category: 'Ensayos Cinemáticos',
    coverImage: item.data.coverImage || (Array.isArray(item.data.gallery) && item.data.gallery.length > 0 ? item.data.gallery[0] : null),
    excerpt: 'Experiencia inmersiva GSAP a pantalla completa.',
    date: new Date().toISOString(),
    themeColor: 'obsidiana',
  }
}));

const publishable = [
  ...publishableCinematicos,
  ...getPublishableEssays(allEssaysRaw, isProd),
  ...getPublishableEssays(allArquetiposRaw, isProd),
  ...publishableGeorefs
].sort(sortEssaysByVisualFirst);

const georefCoverEssay = publishableGeorefs
  .map(e => ({ ...e, img: resolveEssayImage(e.entry, e.slug) }))
  .find(e => e.img);

// ─── TODAS LAS COLECCIONES TEMÁTICAS (≥ 1 ARTÍCULO) ──────────────────────────
const categoryGroups = groupByCategory(publishable, 1);

// Convertir a array ordenado por número de artículos (descendente)
const collections = Array.from(categoryGroups.entries())
  .map(([key, rawEssays]) => {
    const essays = rawEssays.map(essay => ({
      ...essay,
      img: resolveEssayImage(essay.entry, essay.slug),
    }));
    return {
      key,
      label: formatCategory(rawEssays[0].entry.category),
      count: essays.length,
      essays,
      coverEssay: essays[0],
    };
  })
  .sort((a, b) => b.count - a.count);

const indexCover = collections[0]?.coverEssay?.img ?? null;
const indexCoverPosition =
  (collections[0]?.coverEssay?.entry as any)?.coverImagePosition
  || (collections[0]?.coverEssay?.entry as any)?.imagePosition
  || 'center center';

// ─── SLIDES PARA EL ENGINE: una slide por coleccion en orden de tamaño ────────
const coleccionesSlides = collections
  .filter(col => col.coverEssay?.img)
  .map(col => ({
    id: col.key,
    title: col.label,
    subtitle: `${col.count} artículo${col.count > 1 ? 's' : ''}`,
    category: 'Colección TGP',
    image: (col.coverEssay.img as any)?.src ?? col.coverEssay.img,
    imagePosition: (col.coverEssay.entry as any).coverImagePosition ||
                   (col.coverEssay.entry as any).imagePosition ||
                   'center center',
    link: `/colecciones/${col.key}`,
  }));
---

<Layout
  title="Colecciones Temáticas | The Great Puzzle Project"
  description="Colecciones temáticas, arqueología, antropología, semiología y análisis documental de The Great Puzzle Project."
  image={(collections[0]?.coverEssay?.img as any)?.src ?? collections[0]?.coverEssay?.img}
>
  <div class="text-white min-h-screen pb-32">

    {/* ── HERO PRINCIPAL CINEMÁTICO DARK GLOOCK (H1) ── */}
    <Marquee
      title="COLECCIONES DESTACADAS"
      subtitle="The Great Puzzle Project"
      imageUrl={(collections[0]?.coverEssay?.img as any)?.src ?? collections[0]?.coverEssay?.img ?? ''}
      vibeClass="vibe-travel-senses"
      isH1={true}
      fontClass="font-serif font-black"
    />

    {/* ── RESPIRO VISUAL / EXCERPT DOBLE SCROLL POLVO DORADO & TYPEMAGIC EN BG-MAIN ── */}
    <CinematicExcerptRest 
      text="Un [[mapa de fragmentos]] desgastados por el tiempo. **Cada colección**, un intento humano de arrebatarle el sentido al olvido absoluto."
    />

    {/* ── ENGINE AUTO CINEMÁTICO: cicla colecciones full-viewport ── */}
    {coleccionesSlides.length > 0 && (
      <CinematicPostEngine slides={coleccionesSlides} maxSlides={15} />
    )}

    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-12 md:gap-16 pt-8 md:pt-12">

      {/* BANNER DESTACADO: SITIOS GEOHISTÓRICOS (Hero Card Cinemática con Imagen) */}
      <section class="reveal-item">
        <a
          href="/colecciones/sitios-arqueohistoricos/"
          class="group relative overflow-hidden rounded-2xl md:rounded-3xl border border-white/10 bg-theme-dark/80 hover:border-rust-orange/50 transition-all duration-500 shadow-2xl min-h-60 md:min-h-72 flex flex-col justify-end p-8 md:p-12 isolate"
        >
          {georefCoverEssay?.img && (
            <Image
              src={sanitizeImageUrl(georefCoverEssay.img)}
              alt="Sitios Geohistóricos & Arqueohistóricos"
              inferSize={true}
              format="webp"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover object-center brightness-60 contrast-[1.05] pointer-events-none -z-10 transition-transform duration-700 ease-out group-hover:scale-[1.02] group-hover:brightness-75"
            />
          )}
          <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/50 via-50% to-transparent pointer-events-none z-10"></div>

          <div class="relative z-20 flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div class="flex flex-col gap-2 max-w-3xl">
              <span class="font-mono text-xs uppercase tracking-[0.4em] text-rust-orange font-bold">
                Colección Especializada · Georreferencias
              </span>
              <h2 class="text-3xl md:text-5xl font-serif font-black gradient-general-h1 leading-tight">
                Sitios Geohistóricos &amp; Arqueohistóricos
              </h2>
              <p class="h2-thin-hook text-sm md:text-base text-white/80 tracking-[0.15em] mt-1">
                Aramu Muru · Tikal · Bonampak · Cartago · Qapaq Ñan · Yonaguni
              </p>
            </div>

            <div class="shrink-0">
              <span class="inline-flex items-center gap-3 px-6 py-3.5 rounded-xl bg-[#151718]/90 border border-white/15 text-[#E0E0E0]/85 font-mono text-xs uppercase tracking-[0.3em] font-bold group-hover:bg-white/20 group-hover:border-white/40 group-hover:text-white transition-all duration-300 shadow-lg">
                Explorar Cartografía →
              </span>
            </div>
          </div>
        </a>
      </section>

      {/* ═══════════════════════════════════════════════════════════════════
          COLECCIONES TEMÁTICAS GENERALES — F5: Bento Asimétrico
          F6: grid-cols-1 en móvil, lg:grid-cols-12 en desktop
          F6: Texto siempre visible, sin group-hover reveal en touch
      ═══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-6 md:gap-8 w-full">
        {/* F5: CSS Grid Bento Asimétrico — F6: cols-1 en mobile */}
        <div class="grid grid-cols-1 lg:grid-cols-12 auto-rows-[minmax(280px,auto)] gap-4 md:gap-6 lg:gap-8 w-full">
          {collections.map((col, index) => {
            // F5: distribución asimétrica según posición
            let spanClass = "lg:col-span-4 lg:row-span-1";
            if (index === 0) spanClass = "lg:col-span-12 lg:row-span-2";
            else if (index === 1) spanClass = "lg:col-span-7 lg:row-span-1";
            else if (index === 2) spanClass = "lg:col-span-5 lg:row-span-1";

            // Mobile height control: card hero ocupa menos en móvil para no saturar el viewport
            const mobileHeightClass = index === 0
              ? "min-h-[48vh] md:min-h-[75px]"  // hero: ~mitad del viewport en móvil
              : "min-h-[42vh] md:min-h-[280px]"; // resto: ~40% en móvil

            return (
              <a
                href={`/colecciones/${col.key}/`}
                class={`group relative overflow-hidden rounded-2xl md:rounded-3xl border border-white/5 bg-theme-dark/80 shadow-2xl flex flex-col justify-end w-full isolate mx-4 md:mx-0 ${spanClass} ${mobileHeightClass}`}
              >
                {col.coverEssay?.img ? (
                  <Image
                    src={sanitizeImageUrl(col.coverEssay.img)}
                    alt={col.label}
                    inferSize={true}
                    format="webp"
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : undefined}
                    decoding="async"
                    class="absolute inset-0 w-full h-full object-cover object-center brightness-90 contrast-[1.03] pointer-events-none -z-10 transition-transform duration-700 ease-out group-hover:scale-[1.018] group-hover:brightness-95"
                  />
                ) : (
                  <div class="absolute inset-0 w-full h-full bg-linear-to-br from-[#1c242b] via-theme-dark to-[#0a0b0b] -z-10" />
                )}

                {/* Gradiente nítido sin desenfoque */}
                {/* F6: Texto siempre visible — NO depende de :hover para revelar contenido en touch */}
                <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/50 via-45% to-transparent pointer-events-none z-10"></div>

                <div class="relative z-20 p-5 md:p-6 lg:p-8 flex flex-col justify-end h-full">
                  {/* F2: text-xs (WCAG). F6: siempre visible sin group-hover reveal */}
                  <span class="font-mono text-xs uppercase tracking-widest text-rust-orange font-bold mb-1">Colección TGP</span>
                  <h2 class="gradient-general-h2 text-2xl md:text-3xl lg:text-4xl mb-1 leading-tight">{col.label}</h2>
                  {/* Último artículo como hook visual: muestra el título del cover essay */}
                  {col.coverEssay?.entry?.title && (
                    <p class="font-serif text-white/55 text-xs md:text-sm line-clamp-1 mb-1.5 tracking-wide">
                      {col.coverEssay.entry.title}
                    </p>
                  )}
                  <p class="font-sans text-xs text-white/50">{col.count} {col.count === 1 ? 'Documento' : 'Documentos'}</p>
                </div>
              </a>
            );
          })}
        </div>
      </section>

      {/* Fallback si no hay colecciones */}
      {collections.length === 0 && (
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-white/30 text-center py-20">
          No hay colecciones disponibles.
        </p>
      )}

    </div>
  </div>

  <script>
    const h1 = document.querySelector('h1');
    if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    document.addEventListener('astro:page-load', () => {
      const h1 = document.querySelector('h1');
      if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    });
  </script>
</Layout>
