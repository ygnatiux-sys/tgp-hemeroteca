---
import { resolveMultivisionClass } from "../../lib/multivision";
export const prerender = true;
import Image from '../../components/SafeImage.astro';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SpotlightMediaTray, { type TrayCollectionItem } from '../../components/SpotlightMediaTray.astro';
import RowNetflixClasico from '../../components/RowNetflixClasico.astro';
import CinematicExcerptRest from '../../components/CinematicExcerptRest.astro';
import Marquee from '../../components/Marquee.astro';
import CoverflowCarousel, { type CoverflowPost } from '../../components/CoverflowCarousel';
import CollectionEpigraph from '../../components/CollectionEpigraph.astro';
import VerticalCollectionsStack from '../../components/VerticalCollectionsStack.astro';
import CinematicCollectionCardEngine from '../../components/CinematicCollectionCardEngine.astro';
import {
  getPublishableEssays,
  groupByCategory,
  formatCategory,
  formatYear,
  resolveEssayImage,
  sortEssaysByVisualFirst,
  sanitizeImageUrl,
} from '../../lib/content-filter';

// ─── CARGA Y FILTRADO ────────────────────────────────────────────────────────
const allEssaysRaw = await getCollection('ensayos').catch(() => []);
const allCinematicosRaw = await getCollection('ensayosCinematicos').catch(() => []);
const allArquetiposRaw = await getCollection('arquetiposGlobales').catch(() => []);
const allGeorefsRaw = await getCollection('georreferencias').catch(() => []);
const isProd = import.meta.env.PROD;
const publishableGeorefs = getPublishableEssays(allGeorefsRaw, isProd);
const publishableCinematicos = allCinematicosRaw.map(item => ({
  slug: item.id.replace(/\/index$/, ''),
  isCinematicGSAP: true,
  entry: {
    title: item.data.title || 'Dossier Cinemático',
    category: 'Ensayos Cinemáticos',
    coverImage: item.data.coverImage || (Array.isArray(item.data.gallery) && item.data.gallery.length > 0 ? item.data.gallery[0] : null),
    excerpt: 'Experiencia inmersiva GSAP a pantalla completa.',
    date: new Date().toISOString(),
    themeColor: 'obsidiana',
  }
}));

const publishable = [
  ...publishableCinematicos,
  ...getPublishableEssays(allEssaysRaw, isProd),
  ...getPublishableEssays(allArquetiposRaw, isProd),
  ...publishableGeorefs
].sort(sortEssaysByVisualFirst);

const georefCoverEssay = publishableGeorefs
  .map(e => ({ ...e, img: resolveEssayImage(e.entry, e.slug) }))
  .find(e => e.img);

// ─── TODAS LAS COLECCIONES TEMÁTICAS (≥ 1 ARTÍCULO) ──────────────────────────
const categoryGroups = groupByCategory(publishable, 1);

// Convertir a array ordenado por número de artículos (descendente)
const collections = Array.from(categoryGroups.entries())
  .map(([key, rawEssays]) => {
    const essays = rawEssays.map(essay => ({
      ...essay,
      img: resolveEssayImage(essay.entry, essay.slug),
    }));
    return {
      key,
      label: formatCategory(rawEssays[0].entry.category),
      count: essays.length,
      essays,
      coverEssay: essays[0],
    };
  })
  .sort((a, b) => b.count - a.count);

const indexCover = collections[0]?.coverEssay?.img ?? null;
const indexCoverUrl = sanitizeImageUrl((indexCover as any)?.src ?? indexCover ?? '');
// ─── COLECCIONES PARA SPOTLIGHT MEDIA TRAY (NORMALIZADO A HEREDADOS DE LA PÁGINA) ───
const coleccionesTrayItems: TrayCollectionItem[] = collections
  .filter(col => col.coverEssay?.img)
  .map(col => {
    const rawImg = col.coverEssay.img;
    return {
      slug: col.key,
      title: col.label,
      excerpt: col.coverEssay?.entry?.title || undefined,
      coverImage: rawImg,
      category: 'Colección TGP',
      count: col.count,
      link: `/colecciones/${col.key}/`,
    };
  });

// ─── ITEMS PARA COVERFLOW 3D (UN COVER DE CADA COLECCIÓN) ────────────────────
const coverflowPosts: CoverflowPost[] = collections
  .filter(col => col.coverEssay?.img)
  .map(col => {
    const rawImg = col.coverEssay.img;
    const imgUrl = sanitizeImageUrl(typeof rawImg === 'object' && rawImg?.src ? rawImg.src : (typeof rawImg === 'string' ? rawImg : ''));
    return {
      id: col.key,
      title: col.label,
      subtitle: `${col.count} artículo${col.count > 1 ? 's' : ''} en esta colección`,
      image: imgUrl || 'https://images.unsplash.com/photo-1547036967-23d11aacaee0?q=80&w=1200&auto=format&fit=crop',
      link: `/colecciones/${col.key}/`,
      collectionLabel: 'Colección TGP',
      date: col.coverEssay?.entry?.date ? formatYear(col.coverEssay.entry.date) : undefined,
    };
  });

// ─── FRASES EVOCATIVAS POR COLECCIÓN ───────────────────────────────────────────
const epigraphMap: Record<string, string> = {
  "arqueosemiotica":   "Los [[signos]] sobreviven a los imperios. **Cada glifo,** un mensaje lanzado a la eternidad sin destinatario conocido.",
  "filosofia":         "El pensamiento como [[territorio.]] Las **ideas no mueren:** se transforman, se heredan, se contradicen.",
  "mitologia":         "Antes del dato, existió el [[mito.]] El relato que **une cielo y tierra** antes de que la ciencia los separara.",
  "historia":          "El [[tiempo]] no es lineal. Es una **red de causas** que la memoria humana teje y desteje sin cesar.",
  "ensayos-cinematicos": "Imágenes que **piensan.** El [[cine]] como forma de conocimiento antes de que el conocimiento fuera escrito.",
  "arquetipos":        "Figuras que reaparecen en cada cultura. Los [[arquetipos]] son la gramática **secreta del ser humano.**",
  "historia-natural":  "La vida como **archivo.** Cada especie, un [[capítulo]] de una historia que empezó mucho antes que nosotros.",
  "historia-antigua":  "Las [[civilizaciones]] no colapsan: **se transforman.** Sus ruinas son preguntas, no respuestas.",
  "historia-medieval": "Entre el [[fin del mundo]] romano y el alba del moderno, **siglos de invención** que el olvido llama oscuros.",
  "religion":          "Lo [[sagrado]] como necesidad primaria. **Cada fe,** un intento humano de darle nombre al misterio.",
};
---

<Layout
  title="Colecciones Temáticas | The Great Puzzle Project"
  description="Colecciones temáticas, arqueología, antropología, semiología y análisis documental de The Great Puzzle Project."
  image={indexCoverUrl}
>
  <div class="text-white min-h-screen pb-32">

    {/* ── HERO PRINCIPAL CINEMÁTICO (H1) CON MASK BLACK AL PIE ── */}
    <div class="relative w-full">
      <Marquee
        title="COLECCIONES DESTACADAS"
        subtitle="The Great Puzzle Project"
        imageUrl={indexCoverUrl}
        vibeClass="vibe-travel-senses"
        isH1={true}
        fontClass="font-gloock font-black gradient-general-h1 glow-metallic-gloock"
        heightClass="h-[100vh]"
        marginClass="mt-0 mb-0"
        roundedClass="rounded-none"
        showSocialInTitle={true}
        maskBottom={true}
        fullWidth={true}
        disableParallax={true}
      />

      {/* ── BANDEJA SPOTLIGHT MEDIA TRAY: JUSTO DEBAJO INMEDIATO AL PIE DE IMAGEN CON MASK BLACK A ANCHO TOTAL ── */}
      <div class="relative z-20 -mt-24 sm:-mt-32 md:-mt-40 mb-16 md:mb-24 w-full overflow-x-clip">
        {/* Scrim / Black Mask suave que difumina la transición del pie de imagen con el componente a ancho total */}
        <div class="absolute -top-24 inset-x-0 bottom-0 bg-linear-to-b from-transparent via-black/85 via-40% to-(--bg-current) pointer-events-none -z-10"></div>

        <RowNetflixClasico 
          eyebrow="COLECCIONES DESTACADAS"
          title="COLECCIONES"
          actionText="VER TODAS →"
          actionHref="/colecciones/"
          trayHeight="62vh"
          items={coleccionesTrayItems.map(c => ({
            title: c.title,
            subtitle: c.excerpt,
            image: c.coverImage,
            collectionLabel: c.category,
            link: c.link,
            slug: c.slug
          }))}
        />
      </div>
    </div>

    {/* ── RESPIRO VISUAL / EXCERPT DOBLE SCROLL POLVO DORADO & TYPEMAGIC EN BG-MAIN ── */}
    <CinematicExcerptRest 
      text="Un [[mapa de fragmentos]] desgastados por el tiempo. **Cada colección**, un intento humano de arrebatarle el sentido al olvido absoluto."
    />

    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-12 md:gap-16 pt-8 md:pt-12">

      {/* BANNER DESTACADO: SITIOS GEOHISTÓRICOS & ARQUEOSEMIÓTICA (Hero Card Cinemática con Modo Abajo 75/25) */}
      <section class="reveal-brote w-full">
        <CinematicCollectionCardEngine
          collectionKey="arqueosemiotica"
          label="Sitios Geohistóricos & Arqueohistóricos"
          badge="Colección Especializada · Georreferencias"
          count={publishableGeorefs.length}
          coverImage={georefCoverEssay?.img}
          coverTitle="Aramu Muru · Tikal · Bonampak · Cartago · Qapaq Ñan · Yonaguni"
          link="/colecciones/arqueosemiotica/"
          index={0}
          mode="bottom"
          ctaLabel="Explorar Cartografía"
        />
      </section>

      {/* ─── EPIGRAFE CINEMATICO: entre Sitios Geohistóricos y las Colecciones Temáticas ─── */}
      <CollectionEpigraph
        text="[[Coordenadas]] del pasado. El espacio como **texto cifrado,** la piedra como memoria viva de lo que fuimos."
      />

      {/* ═══════════════════════════════════════════════════════════════════
          COLECCIONES TEMÁTICAS GENERALES — PANTALLAS DE CINE FULL-HEIGHT CINEMÁTICAS
      ═══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-12 sm:gap-16 md:gap-24 w-full">
        {collections.slice(0, 3).map((col, index) => {
          const epigraphText = epigraphMap[col.key] || `**${col.label}:** una [[colección]] de registros del pensamiento humano en expansión.`;

          return (
            <div class="flex flex-col w-full gap-8 md:gap-12">
              {/* Epígrafe cinemático previo (excepto en la primera colección) */}
              {index > 0 && (
                <CollectionEpigraph text={epigraphText} />
              )}

              <CinematicCollectionCardEngine
                collectionKey={col.key}
                label={col.label}
                count={col.count}
                coverImage={col.coverEssay?.img}
                coverTitle={col.coverEssay?.entry?.title}
                link={`/colecciones/${col.key}/`}
                index={index + 1}
                mode={(col.key === 'arqueosemiotica' || col.key.includes('historia') || col.key.includes('cinematic')) ? 'bottom' : 'bottom-right'}
              />
            </div>
          );
        })}
      </section>

      {/* ─── RESTO DE COLECCIONES: VERTICAL STACK CON CHEVRON CTA ─── */}
      {collections.length > 3 && (
        <VerticalCollectionsStack collections={collections.slice(3)} />
      )}
    </div>

    {/* ── SECCIÓN FINAL: COVERFLOW CAROUSEL 3D DE COLECCIONES (FULL WIDTH / EDGE-TO-EDGE) ── */}
    {coverflowPosts.length > 0 && (
      <section class="mt-20 md:mt-32 w-full bg-transparent relative overflow-hidden">
        <CoverflowCarousel 
          client:visible 
          posts={coverflowPosts}
          title="Explorador de Colecciones"
          eyebrow="Galería 3D Coverflow"
        />
      </section>
    )}

  </div>

  <script>
    const setupRevealBrote = () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
          } else {
            entry.target.classList.remove('revealed');
          }
        });
      }, {
        threshold: 0.12,
        rootMargin: "-20px 0px -20px 0px"
      });

      document.querySelectorAll('.reveal-brote').forEach(el => {
        observer.observe(el);
      });
    };

    const initPage = () => {
      const h1 = document.querySelector('h1');
      if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
      setupRevealBrote();
    };

    document.addEventListener('astro:page-load', initPage);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initPage();
    } else {
      document.addEventListener('DOMContentLoaded', initPage);
    }
  </script>
</Layout>
