    background-clip: text !important;
    color: transparent !important;
    -webkit-text-fill-color: transparent !important;
    filter: drop-shadow(0 0 32px rgba(16, 185, 129, 0.58)) !important;
  }

  .oopart-hero-scope[data-oopart-slug="eolitos-valle-del-tajo"] .strat-word,
  .oopart-hero-scope[data-oopart-slug="eolitos-valle-del-tajo"] h1 {
    font-family: 'Clash Grotesk', sans-serif !important;
    font-weight: 700 !important;
    background: linear-gradient(180deg, #fed7aa 0%, #f97316 52%, #c2410c 100%) !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    color: transparent !important;
    -webkit-text-fill-color: transparent !important;
    filter: drop-shadow(0 0 30px rgba(249, 115, 22, 0.6)) drop-shadow(0 12px 24px rgba(0, 0, 0, 0.9)) !important;
  }

  .oopart-hero-scope[data-oopart-slug="pilar-de-hierro-de-delhi"] #blade-content-text h1 {
    font-family: 'Cinzel Decorative', serif !important;
    font-weight: 900 !important;
    background: linear-gradient(180deg, #bfdbfe 0%, #3b82f6 52%, #1d4ed8 100%) !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    color: transparent !important;
    -webkit-text-fill-color: transparent !important;
    filter: drop-shadow(0 0 34px rgba(59, 130, 246, 0.65)) drop-shadow(0 12px 24px rgba(0, 0, 0, 0.95)) !important;
  }

  .oopart-hero-scope[data-oopart-slug="mapa-de-piri-reis"] #cosmos-content-text h1 {
    font-family: 'Fraunces', serif !important;
    font-style: italic !important;
    font-weight: 900 !important;
    background: linear-gradient(180deg, #fef08a 0%, #84cc16 52%, #0d9488 100%) !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    color: transparent !important;
