    -webkit-background-clip: text !important;
    background-clip: text !important;
    color: transparent !important;
    -webkit-text-fill-color: transparent !important;
    filter: drop-shadow(0 0 32px rgba(34, 211, 238, 0.6)) drop-shadow(0 12px 24px rgba(0, 0, 0, 0.9)) !important;
  }

  .oopart-hero-scope[data-oopart-slug="martillo-de-londres"] .tec-title,
  .oopart-hero-scope[data-oopart-slug="martillo-de-londres"] h1 {
    font-family: 'Bodoni Moda', serif !important;
    font-weight: 900 !important;
    background: linear-gradient(180deg, #ff7b7b 0%, #ff1e2d 50%, #990011 100%) !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    color: transparent !important;
    -webkit-text-fill-color: transparent !important;
    filter: drop-shadow(0 0 32px rgba(255, 30, 45, 0.65)) drop-shadow(0 12px 24px rgba(0, 0, 0, 0.9)) !important;
  }

  .oopart-hero-scope[data-oopart-slug="table-mountain-calaveras"] .abyss-h1 {
    font-family: 'Clash Display', sans-serif !important;
    font-weight: 700 !important;
    background: linear-gradient(180deg, #f3e8ff 0%, #c084fc 52%, #7e22ce 100%) !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
