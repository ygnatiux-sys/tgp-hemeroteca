---
/**
 * src/pages/colecciones/america-secrets/pumapunku.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * DOSSIER HIJO: MECANIZADO ANCESTRAL DE PUMAPUNKU
 */
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import BackSlideButton from '../../../components/BackSlideButton.astro';
import PumapunkuHero from '../../../components/PumapunkuHero.astro';
---

<Layout title="Pumapunku · Mecanizado Ancestral · América Secrets">
  <main class="w-full bg-[#050607] text-[#c2c5cc] min-h-screen">
    
    <div class="fixed top-5 left-6 z-40">
      <BackSlideButton href="/colecciones/america-secrets/" label="América Secrets" />
    </div>

    <!-- HERO INDIVIDUAL HIJO CON MODO MILIMÉTRICO DE PUMAPUNKU -->
    <section class="w-full">
      <PumapunkuHero />
    </section>

    <!-- DOSSIER TÉCNICO -->
    <section class="max-w-4xl mx-auto px-6 py-20 font-serif leading-relaxed text-stone-200">
      <div class="border-l-2 border-[#457b77] pl-6 py-2 mb-10">
        <p class="font-mono text-xs uppercase tracking-widest text-[#608f8c]">Andesita Quirúrgica #05</p>
        <h2 class="text-3xl font-bold text-[#c2c5cc] uppercase mt-1">Mecanizado de Precisión e Ingeniería H</h2>
      </div>

      <p class="text-lg text-stone-300 mb-6">
        Ubicado cerca de Tiwanaku en el altiplano boliviano, Pumapunku exhibe cortes en andesita y arenisca roja de una planitud y angulación recta impecables, acompañados de perforaciones cilíndricas en hilera con profundidad uniforme.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 my-12 font-mono text-xs uppercase">
        <div class="p-6 rounded-xl bg-[#090b0d] border border-[#457b77]/30">
          <span class="text-[#608f8c]">Material Lítico</span>
          <p class="text-[#c2c5cc] text-base font-bold mt-2">Andesita & Arenisca Roja</p>
        </div>
        <div class="p-6 rounded-xl bg-[#090b0d] border border-[#457b77]/30">
          <span class="text-[#608f8c]">Tolerancia Dimensional</span>
          <p class="text-[#c2c5cc] text-base font-bold mt-2">Nivel Quirúrgico</p>
        </div>
        <div class="p-6 rounded-xl bg-[#090b0d] border border-[#457b77]/30">
          <span class="text-[#608f8c]">Ensamblaje</span>
          <p class="text-[#c2c5cc] text-base font-bold mt-2">Grapas de Bronce-Arsénico</p>
        </div>
      </div>
    </section>

  </main>
</Layout>
