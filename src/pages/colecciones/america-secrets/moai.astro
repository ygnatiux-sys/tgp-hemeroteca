---
/**
 * src/pages/colecciones/america-secrets/moai.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * DOSSIER HIJO: MOAIS DE RAPA NUI
 */
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import BackSlideButton from '../../../components/BackSlideButton.astro';
import imgMoai from '../../../assets/alternativa/moai.jpg';
---

<Layout title="Moais de Rapa Nui · América Secrets">
  <main class="w-full bg-[#0b0f0d] text-[#e2e8f0] min-h-screen">
    
    <div class="fixed top-5 left-6 z-40">
      <BackSlideButton fallbackUrl="/colecciones/america-secrets/" />
    </div>

    <section class="relative w-full h-[80vh] overflow-hidden flex items-center justify-center">
      <img
        src={imgMoai.src}
        alt="Moais monolíticos en Rapa Nui"
        class="absolute inset-0 w-full h-full object-cover object-center filter brightness-105 contrast-105"
      />
      <div class="absolute inset-0 bg-linear-to-t from-[#0b0f0d] via-[#0b0f0d]/40 to-[#0b0f0d]/80"></div>
      
      <div class="relative z-10 text-center max-w-4xl px-6">
        <span class="font-mono text-xs tracking-[0.35em] uppercase text-[#34d399] py-1 px-4 rounded-full border border-[#34d399]/30 bg-black/60 backdrop-blur-md">
          Isla de Pascua · Rano Raraku
        </span>
        <h1 class="font-serif font-black uppercase text-4xl sm:text-7xl text-white mt-4 tracking-tight">
          Moais de Rapa Nui
        </h1>
        <p class="font-mono text-xs sm:text-sm tracking-widest text-emerald-200/80 uppercase mt-4">
          La ingeniería de desplazamiento monolítico en el Pacífico Sur
        </p>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-6 py-16 font-serif leading-relaxed text-stone-200">
      <div class="border-l-2 border-[#34d399] pl-6 py-2 mb-10">
        <p class="font-mono text-xs uppercase tracking-widest text-[#34d399]">Expediente Lítico #02</p>
        <h2 class="text-2xl font-bold text-white uppercase mt-1">Toba Volcánica y Ahu</h2>
      </div>

      <p class="text-lg text-stone-300 mb-6">
        Esculpidos en la cantera volcánica de Rano Raraku, los casi 900 moais registrados en Rapa Nui constituyen uno de los hitos megalíticos más célebres del hemisferio sur.
      </p>
    </section>

  </main>
</Layout>
