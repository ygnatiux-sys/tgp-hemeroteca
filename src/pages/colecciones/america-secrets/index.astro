---
/**
 * src/pages/colecciones/america-secrets/index.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * PÁGINA OFICIAL DE COLECCIÓN: AMÉRICA SECRETS
 *
 * Apertura cinemática con Fraunces Impact, imán verde musgo y secuencia
 * de investigación (Olmecas, Moais, Göbekli Tepe, Diquís y Pumapunku).
 */
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import ScrollNarrative from '../../../components/ScrollNarrative.astro';
import Marquee from '../../../components/Marquee.astro';
import BackSlideButton from '../../../components/BackSlideButton.astro';
---

<Layout title="América Secrets · Colección Arqueosemiótica">
  <main class="w-full bg-[#0b0f0d] text-[#e2e8f0] min-h-screen">
    
    <div class="fixed top-5 left-6 z-40">
      <BackSlideButton href="/colecciones/" label="Colecciones" />
    </div>

    <!-- EXPERIENCIA CINEMÁTICA PRINCIPAL DE AMERICA SECRETS -->
    <section class="w-full">
      <ScrollNarrative />
    </section>

    <!-- MARQUEE EDITORIAL -->
    <div class="py-6 bg-[#050806] border-y border-[#34d399]/20">
      <Marquee text="AMERICA SECRETS · CABEZAS COLOSALES OLMECAS · MOAIS DE RAPA NUI · GÖBEKLI TEPE · ESFERAS DEL DIQUÍS · PUMAPUNKU ·" speed={45} />
    </div>

    <!-- GRID DE CAPÍTULOS HIJOS -->
    <section class="max-w-7xl mx-auto px-6 py-20">
      <div class="flex flex-col md:flex-row items-start md:items-end justify-between mb-12 border-b border-white/10 pb-6">
        <div>
          <span class="font-mono text-xs uppercase tracking-[0.3em] text-[#34d399]">Episodios & Expedientes Líticos</span>
          <h2 class="font-serif text-3xl sm:text-5xl font-black uppercase tracking-tight text-white mt-2">
            Hitos Megalíticos de América & Conexiones
          </h2>
        </div>
        <p class="font-mono text-xs uppercase tracking-widest text-stone-400 mt-4 md:mt-0 max-w-md">
          Estudio de precisión, escultura en basalto, esfericidad matemática y alta tecnología prehistórica.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- OLMECAS -->
        <a href="/colecciones/america-secrets/olmeca/" class="group block rounded-2xl border border-white/10 bg-[#121915] p-7 hover:border-[#34d399]/50 transition-all duration-300 shadow-xl">
          <span class="font-mono text-[10px] uppercase text-[#34d399]">Episodio I</span>
          <h3 class="font-serif text-2xl font-bold uppercase text-white group-hover:text-[#34d399] transition-colors mt-2">
            Cabezas Olmecas
          </h3>
          <p class="font-sans text-xs text-stone-300 mt-2">
            Basalto colosal transportado sin rueda a través de pantanos mesoamericanos.
          </p>
        </a>

        <!-- MOAIS -->
        <a href="/colecciones/america-secrets/moai/" class="group block rounded-2xl border border-white/10 bg-[#121915] p-7 hover:border-[#34d399]/50 transition-all duration-300 shadow-xl">
          <span class="font-mono text-[10px] uppercase text-[#34d399]">Episodio II</span>
          <h3 class="font-serif text-2xl font-bold uppercase text-white group-hover:text-[#34d399] transition-colors mt-2">
            Moais de Rapa Nui
          </h3>
          <p class="font-sans text-xs text-stone-300 mt-2">
            Monolitos de toba volcánica mirando al interior de la isla.
          </p>
        </a>

        <!-- GÖBEKLI TEPE -->
        <a href="/colecciones/america-secrets/gobekli-tepe/" class="group block rounded-2xl border border-white/10 bg-[#121915] p-7 hover:border-[#34d399]/50 transition-all duration-300 shadow-xl">
          <span class="font-mono text-[10px] uppercase text-[#34d399]">Episodio III</span>
          <h3 class="font-serif text-2xl font-bold uppercase text-white group-hover:text-[#34d399] transition-colors mt-2">
            Göbekli Tepe
          </h3>
          <p class="font-sans text-xs text-stone-300 mt-2">
            El primer templo de la humanidad tallado en piedra limpia.
          </p>
        </a>

        <!-- DIQUÍS -->
        <a href="/colecciones/america-secrets/diquis/" class="group block rounded-2xl border border-white/10 bg-[#121915] p-7 hover:border-[#34d399]/50 transition-all duration-300 shadow-xl">
          <span class="font-mono text-[10px] uppercase text-[#34d399]">Episodio IV</span>
          <h3 class="font-serif text-2xl font-bold uppercase text-white group-hover:text-[#34d399] transition-colors mt-2">
            Esferas del Diquís
          </h3>
          <p class="font-sans text-xs text-stone-300 mt-2">
            Geometría perfecta en gabro y granodiorita del delta de Costa Rica.
          </p>
        </a>

        <!-- PUMAPUNKU -->
        <a href="/colecciones/america-secrets/pumapunku/" class="group block rounded-2xl border border-[#457b77]/40 bg-[#121915] p-7 hover:border-[#608f8c] transition-all duration-300 shadow-xl">
          <span class="font-mono text-[10px] uppercase text-[#608f8c]">Episodio V · Andesita Quirúrgica</span>
          <h3 class="font-serif text-2xl font-bold uppercase text-white group-hover:text-[#c2c5cc] transition-colors mt-2">
            Pumapunku
          </h3>
          <p class="font-sans text-xs text-stone-300 mt-2">
            Mecanizado de precisión milimétrica en bloques H y andesita dura.
          </p>
        </a>

      </div>
    </section>

  </main>
</Layout>
