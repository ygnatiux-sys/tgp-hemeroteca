---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CinematicArchiveCard from '../../components/CinematicArchiveCard.astro';
import InteriorHero from '../../components/InteriorHero.astro';
import Marquee from '../../components/Marquee.astro';
import {
  getPublishableEssays,
  groupByCategory,
  formatCategory,
  normalizeCategory,
  formatDate,
  formatYear,
  resolveEssayImage,
} from '../../lib/content-filter';

// ─── GENERACIÓN ESTÁTICA DE RUTAS ────────────────────────────────────────────
export async function getStaticPaths() {
  const allEssaysRaw = await getCollection('ensayos').catch(() => []);
  const isProd = import.meta.env.PROD;
  const publishable = getPublishableEssays(allEssaysRaw, isProd);
  const groups = groupByCategory(publishable, 1);

  return Array.from(groups.entries()).map(([key, essays]) => ({
    params: { categoria: key },
    props: { essays, key },
  }));
}

// ─── PROPS ───────────────────────────────────────────────────────────────────
const { essays, key } = Astro.props;
const label = formatCategory(essays[0]?.entry.category);

// ─── IMÁGENES CON RESOLUCIÓN INTELIGENTE ──────────────────────────────────────
const resolvedEssays = essays.map((e: typeof essays[0]) => ({
  ...e,
  img: resolveEssayImage(e.entry.coverImage, e.slug),
}));

const coverImage = resolvedEssays[0]?.img ?? null;
const coverPosition =
  (resolvedEssays[0]?.entry as any)?.coverImagePosition
  || (resolvedEssays[0]?.entry as any)?.imagePosition
  || 'center center';

// ─── HELPER PARA SECUENCIAS CINE PREMIER (1 HERO FULL + DÚO 60/40) ──────────
function createPremierSequences(items: typeof resolvedEssays) {
  const sequences: Array<{
    hero: typeof resolvedEssays[0];
    duo: typeof resolvedEssays;
  }> = [];
  
  for (let i = 0; i < items.length; i += 3) {
    sequences.push({
      hero: items[i],
      duo: items.slice(i + 1, i + 3),
    });
  }
  return sequences;
}

const sequences = createPremierSequences(resolvedEssays);
---

<Layout title={`${label} | Colecciones TGP`}>
  <div class="text-white min-h-screen pb-32">

    <InteriorHero
      title={label}
      image={coverImage}
      imageAlt={`Colección ${label}`}
      imagePosition={coverPosition}
      eyebrow="Colección temática"
      titleClass="text-5xl md:text-6xl lg:text-7xl font-cinzel font-extrabold tracking-tight leading-none gradient-acero-ios"
    >
      <nav slot="breadcrumb" class="flex items-center gap-3 font-mono text-[9px] uppercase tracking-[0.3em] text-white/40">
        <a href="/" class="hover:text-white transition-colors">Hemeroteca</a>
        <span>/</span>
        <a href="/colecciones" class="hover:text-white transition-colors">Colecciones</a>
        <span>/</span>
        <span class="text-[#EFEBE3]">{label}</span>
      </nav>
      <div slot="meta" class="flex items-center gap-4 flex-wrap">
        <span class="px-3 py-1 bg-white/10 backdrop-blur-md rounded-full border border-white/15 font-mono text-[10px] uppercase tracking-[0.3em] text-[#EFEBE3] font-bold">
          {essays.length} {essays.length === 1 ? 'investigación documentada' : 'investigaciones documentadas'}
        </span>
        <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-white/40">
          Cartografía Epistémica · Archivo Especializado
        </span>
      </div>
    </InteriorHero>

    <Marquee 
      title={label} 
      subtitle="Colección temática" 
      imageUrl={coverImage?.src || (coverImage as any)} 
      vibeClass="vibe-travel-senses" 
      isH1={true} 
    />

    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-16 pt-12 md:pt-16">

      {/* ═══════════════════════════════════════════════════════════════════
          GRILLA CINEMÁTICA PREMIER: 1 HERO + DÚO 60/40
      ═══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-12 md:gap-16">
        {sequences.map((seq) => (
          <div class="premier-sequence flex flex-col gap-6 md:gap-8">
            {/* 1. Hero Cinemático Full Bleed */}
            <div class="w-full">
              <CinematicArchiveCard
                slug={seq.hero.slug}
                entry={seq.hero.entry}
                img={seq.hero.img}
                variant="hero"
                enableCinemagraph={true}
              />
            </div>

            {/* 2. Dúo 60/40 */}
            {seq.duo.length > 0 && (
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
                {seq.duo[0] && (
                  <div class={seq.duo.length > 1 ? "lg:col-span-7 flex flex-col" : "lg:col-span-12 flex flex-col"}>
                    <CinematicArchiveCard
                      slug={seq.duo[0].slug}
                      entry={seq.duo[0].entry}
                      img={seq.duo[0].img}
                      variant={seq.duo.length > 1 ? "duo-60" : "hero"}
                      enableCinemagraph={true}
                    />
                  </div>
                )}
                {seq.duo[1] && (
                  <div class="lg:col-span-5 flex flex-col">
                    <CinematicArchiveCard
                      slug={seq.duo[1].slug}
                      entry={seq.duo[1].entry}
                      img={seq.duo[1].img}
                      variant="duo-40"
                      enableCinemagraph={true}
                    />
                  </div>
                )}
              </div>
            )}
          </div>
        ))}
      </section>

      {/* ═══════════════════════════════════════════════════════════════════
          ÍNDICE INTERNO & NAVEGACIÓN
      ═══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-6 border-t border-white/10 pt-10">
        <div class="reveal-item">
          <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#EFEBE3] block mb-2">Índice</span>
          <h2 class="text-2xl md:text-3xl font-cinzel font-bold text-white/90">{label} — Catálogo Completo</h2>
        </div>

        <ol class="flex flex-col divide-y divide-white/5">
          {resolvedEssays.map(({ slug, entry }: { slug: string; entry: typeof essays[0]['entry'] }, i: number) => (
            <li>
              <a
                href={`/hemeroteca/${slug}`}
                class="group flex items-baseline gap-4 md:gap-6 py-3.5 hover:text-[#EFEBE3] transition-colors duration-300"
              >
                <span class="font-mono text-[10px] text-white/30 tracking-[0.2em] tabular-nums shrink-0 w-6 text-right">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="font-mono text-[9px] text-[#EFEBE3]/70 tracking-[0.2em] shrink-0 hidden sm:inline">
                  {formatYear(entry.date)}
                </span>
                <span class="font-cinzel text-sm md:text-base text-white/80 group-hover:text-[#EFEBE3] transition-colors leading-snug line-clamp-1 flex-1 font-bold">
                  {entry.title}
                </span>
                <span class="font-mono text-[9px] text-white/20 shrink-0 group-hover:text-[#EFEBE3]/60 group-hover:translate-x-1 transition-all">→</span>
              </a>
            </li>
          ))}
        </ol>

        <div class="pt-6 flex items-center justify-between border-t border-white/5 font-mono text-[10px] uppercase tracking-[0.3em]">
          <a
            href="/colecciones"
            class="text-white/40 hover:text-[#EFEBE3] transition-colors flex items-center gap-2"
          >
            <span>←</span>
            <span>Todas las colecciones</span>
          </a>
          <a
            href="/archivo"
            class="text-white/40 hover:text-[#EFEBE3] transition-colors flex items-center gap-2"
          >
            <span>Archivo general</span>
            <span>→</span>
          </a>
        </div>
      </section>

    </div>
  </div>

  <script>
    const h1 = document.querySelector('h1');
    if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    document.addEventListener('astro:page-load', () => {
      const h1 = document.querySelector('h1');
      if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    });
  </script>
</Layout>
