---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CinematicArchiveCard from '../../components/CinematicArchiveCard.astro';
import Marquee from '../../components/Marquee.astro';
import CinematicExcerptRest from '../../components/CinematicExcerptRest.astro';
import AguaNieve from '../../components/AguaNieve.astro';

import {
  getPublishableEssays,
  groupByCategory,
  formatCategory,
  normalizeCategory,
  formatDate,
  formatYear,
  resolveEssayImage,
} from '../../lib/content-filter';

// ─── GENERACIÓN ESTÁTICA DE RUTAS ────────────────────────────────────────────
export async function getStaticPaths() {
  const allEssaysRaw = await getCollection('ensayos').catch(() => []);
  const allArquetiposRaw = await getCollection('arquetiposGlobales').catch(() => []);
  const isProd = import.meta.env.PROD;
  const publishable = [
    ...getPublishableEssays(allEssaysRaw, isProd),
    ...getPublishableEssays(allArquetiposRaw, isProd)
  ];
  const groups = groupByCategory(publishable, 1);

  return Array.from(groups.entries()).map(([key, essays]) => ({
    params: { categoria: key },
    props: { essays, key },
  }));
}

// ─── PROPS ───────────────────────────────────────────────────────────────────
const { essays, key } = Astro.props;
const label = formatCategory(essays[0]?.entry.category);

// ─── IMÁGENES CON RESOLUCIÓN INTELIGENTE ──────────────────────────────────────
const resolvedEssays = essays.map((e: typeof essays[0]) => ({
  ...e,
  img: resolveEssayImage(e.entry, e.slug),
}));

const coverImage = resolvedEssays[0]?.img ?? '/images/placeholder-cover.png';
const coverPosition =
  (resolvedEssays[0]?.entry as any)?.coverImagePosition
  || (resolvedEssays[0]?.entry as any)?.imagePosition
  || 'center center';

// Segunda imagen para parallax de contrapunto
const coverImage2 = resolvedEssays[1]?.img ?? '/images/placeholder-cover.png';
const coverPosition2 =
  (resolvedEssays[1]?.entry as any)?.coverImagePosition
  || (resolvedEssays[1]?.entry as any)?.imagePosition
  || 'center center';

// ─── TEXTOS DE POLVO DORADO POR CATEGORÍA ────────────────────────────────────────────
const categoryDustTexts: Record<string, string> = {
  'antropologia':       '[[Anthropos]] y su memoria inscrita. **El ser humano** como primer archivo, portador de rítos, lenguas y saberes que anteceden toda escritura. Aquí cada hallazgo es un espejo roto que refleja lo que fuimos antes de saber que éramos.',
  'arqueologia':        'La piedra **guarda más** que el papel. Cada capa de tierra es un párrafo de historia no escrita, un silencio que la [[arqueología]] aprende a leer. Los objetos hablan cuando se les da el tiempo y la atención que merecen.',
  'arqueosemiotica':    'Los símbolos preexisten al lenguaje. [[Arqueosemiótica]] es la disciplina que rastrea cómo el sentido se depositó en formas, gestos y grafismos antes de que existieran palabras para nombrarlos.',
  'arquetipos-globales':'Hay figuras que **trascienden culturas** y épocas. Los [[arquetipos]] son el ADN simbólico de la humanidad: patrones que emergen en mitos, ritos y sombras, repitiéndose en civilizaciones que jamás se conocieron.',
  'historia-medieval':  'La Edad Media no fue oscura. Fue un **laboratorio de formas** donde se forjó la Europa moderna entre [[scriptorios]], catedrales y cruzadas. Sus rastros herénticos aguardan aún nuevas lecturas.',
  'historia-moderna':   '**Ruptura y continuidad.** La [[historia moderna]] es el escenario donde el mundo occidental aprendió a mirarse a sí mismo: imprenta, Reforma, Razón. Todo comenzó aquí, en ese umbral vertiginoso.',
  'historia-antigua':   'Las primeras ciudades, los primeros [[códigos]], las primeras guerras de registro. La historia antigua es el origen del contrato humano con el tiempo: la decisión de **no olvidar.**',
  'lingueistica':       'El lenguaje no describe el mundo. Lo [[construye.]] Cada estructura gramatical es una forma de ver, y cada lengua perdida lleva consigo una manera irrecuperable de nombrar la realidad. **Las palabras son los últimos fósiles.**',
  'semiotica':          'Nada es solo lo que parece. La [[semiótica]] es la ciencia del significado: estudia cómo los signos crean mundos, cómo un color puede ser una orden y cómo **el silencio también habla.**',
  'filosofia':          '[[Filosofar]] es atreverse a no tener respuesta. Es la práctica más antigua de la humanidad consciente: dudar, preguntar, construir sistemas y destruirlos. Cada gran filósofo es un naufragio **que ilumina.**',
  'mitologia':          'El mito no miente. **Habla de otra verdad,** una que la historia no puede tocar. Los [[mitos]] son el lenguaje del alma colectiva: relatos que explican lo que la ciencia aún no puede y que el olvido todavía no se ha llevado.',
  'prehistoria':        'Antes de la escritura, hubo [[pintura]]. Antes de la ciudad, hubo rito. La prehistoria es el capítulo más largo del libro humano, escrito en hueso, pigmento y piedra. **Todo lo que somos nació allí.**',
};

// Texto por defecto si la categoría no está mapeada
const defaultDustText = `La colección [[${label}]] concentra investigaciones que excavan más allá de la superficie. **Cada documento es un umbral.** Un conjunto de rastros que aguardan la mirada que los vuelva a nombrar, trazar y comprender.`;

const dustText = categoryDustTexts[key] ?? defaultDustText;

// ─── HELPER PARA SECUENCIAS CINE PREMIER (1 HERO FULL + DÚO 60/40) ──────────
function createPremierSequences(items: typeof resolvedEssays) {
  const sequences: Array<{
    hero: typeof resolvedEssays[0];
    duo: typeof resolvedEssays;
  }> = [];
  
  for (let i = 0; i < items.length; i += 3) {
    sequences.push({
      hero: items[i],
      duo: items.slice(i + 1, i + 3),
    });
  }
  return sequences;
}

const sequences = createPremierSequences(resolvedEssays);
---

<Layout title={`${label} | Colecciones TGP`}>
  <div class="text-white min-h-screen pb-32">

    {/* ── HERO PRINCIPAL CINEMÁTICO DARK GLOOCK (H1) ── */}
    <Marquee
      title={label.toUpperCase()}
      subtitle="Colección Documental · TGP"
      imageUrl={(coverImage as any)?.src ?? coverImage ?? ''}
      vibeClass="vibe-travel-senses"
      isH1={true}
      fontClass="font-serif font-black"
    />

    {/* ── RESPIRO VISUAL / EXCERPT DOBLE SCROLL POLVO DORADO & TYPEMAGIC EN BG-MAIN ── */}
    <CinematicExcerptRest 
      text={dustText}
    />

    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-12 md:gap-16 pt-8 md:pt-12">

      {/* ═══════════════════════════════════════════════════════════════════
          GRILLA CINEMÁTICA PREMIER: 1 HERO + DÚO 60/40
      ═══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-12 md:gap-16">
        {sequences.map((seq, seqIdx) => (
          <div class="premier-sequence flex flex-col gap-6 md:gap-8">
            {/* 1. Hero Cinemático Full Bleed */}
            <div class="w-full">
              <CinematicArchiveCard
                slug={seq.hero.slug}
                entry={seq.hero.entry}
                img={seq.hero.img}
                variant="hero"
                enableCinemagraph={true}
              />
            </div>

            {/* 1.5. Excerpt AguaNieve (sleet + conversational 2-line chunks) */}
            {seqIdx === 0 && (
              <AguaNieve category={key} />
            )}

            {/* 2. Dúo 60/40 */}
            {seq.duo.length > 0 && (
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
                {seq.duo[0] && (
                  <div class={seq.duo.length > 1 ? "lg:col-span-7 flex flex-col" : "lg:col-span-12 flex flex-col"}>
                    <CinematicArchiveCard
                      slug={seq.duo[0].slug}
                      entry={seq.duo[0].entry}
                      img={seq.duo[0].img}
                      variant={seq.duo.length > 1 ? "duo-60" : "hero"}
                      enableCinemagraph={true}
                    />
                  </div>
                )}
                {seq.duo[1] && (
                  <div class="lg:col-span-5 flex flex-col">
                    <CinematicArchiveCard
                      slug={seq.duo[1].slug}
                      entry={seq.duo[1].entry}
                      img={seq.duo[1].img}
                      variant="duo-40"
                      enableCinemagraph={true}
                    />
                  </div>
                )}
              </div>
            )}
          </div>
        ))}
      </section>

      {/* ═══════════════════════════════════════════════════════════════════
          ÍNDICE INTERNO & NAVEGACIÓN
      ═══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-6 border-t border-white/10 pt-10">
        <div class="reveal-item">
          <span class="font-metadata text-[10px] uppercase tracking-[0.4em] text-[#EFEBE3] block mb-2">Índice</span>
          <h2 class="text-2xl md:text-3xl gradient-general-h2">{label} — Catálogo Completo</h2>
        </div>

        <ol class="flex flex-col divide-y divide-white/5">
          {resolvedEssays.map(({ slug, entry }: { slug: string; entry: typeof essays[0]['entry'] }, i: number) => (
            <li>
              <a
                href={`/hemeroteca/${slug}`}
                class="group flex items-baseline gap-4 md:gap-6 py-3.5 hover:text-[#EFEBE3] transition-colors duration-300"
              >
                <span class="font-metadata text-[10px] text-white/30 tracking-[0.2em] tabular-nums shrink-0 w-6 text-right">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="font-metadata text-[9px] text-[#EFEBE3]/70 tracking-[0.2em] shrink-0 hidden sm:inline">
                  {formatYear(entry.date)}
                </span>
                <span class="font-cinzel text-sm md:text-base text-white/80 group-hover:text-[#EFEBE3] transition-colors leading-snug line-clamp-1 flex-1 font-bold">
                  {entry.title}
                </span>
                <span class="font-metadata text-[9px] text-white/20 shrink-0 group-hover:text-[#EFEBE3]/60 group-hover:translate-x-1 transition-all">→</span>
              </a>
            </li>
          ))}
        </ol>

        <div class="pt-6 flex items-center justify-between border-t border-white/5 font-metadata text-[10px] uppercase tracking-[0.3em]">
          <a
            href="/colecciones"
            class="text-white/40 hover:text-[#EFEBE3] transition-colors flex items-center gap-2"
          >
            <span>←</span>
            <span>Todas las colecciones</span>
          </a>
          <a
            href="/archivo"
            class="text-white/40 hover:text-[#EFEBE3] transition-colors flex items-center gap-2"
          >
            <span>Archivo general</span>
            <span>→</span>
          </a>
        </div>
      </section>

    </div>
  </div>

  <script>
    const h1 = document.querySelector('h1');
    if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    document.addEventListener('astro:page-load', () => {
      const h1 = document.querySelector('h1');
      if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    });
  </script>
</Layout>
