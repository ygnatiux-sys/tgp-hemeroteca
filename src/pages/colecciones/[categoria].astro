---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import {
  getPublishableEssays,
  groupByCategory,
  formatCategory,
  normalizeCategory,
  formatDate,
  formatYear,
  resolveEssayImage,
} from '../../lib/content-filter';

// ─── GENERACIÓN ESTÁTICA DE RUTAS ────────────────────────────────────────────
export async function getStaticPaths() {
  const allEssaysRaw = await getCollection('ensayos').catch(() => []);
  const isProd = import.meta.env.PROD;
  const publishable = getPublishableEssays(allEssaysRaw, isProd);
  const groups = groupByCategory(publishable, 1);

  return Array.from(groups.entries()).map(([key, essays]) => ({
    params: { categoria: key },
    props: { essays, key },
  }));
}

// ─── PROPS ───────────────────────────────────────────────────────────────────
const { essays, key } = Astro.props;
const label = formatCategory(essays[0]?.entry.category);

// ─── IMÁGENES CON RESOLUCIÓN INTELIGENTE ──────────────────────────────────────
const featuredEssay = essays[0];
const featuredImg = featuredEssay ? resolveEssayImage(featuredEssay.entry.coverImage, featuredEssay.slug) : null;

const resolvedEssays = essays.map((e: typeof essays[0]) => ({
  ...e,
  img: resolveEssayImage(e.entry.coverImage, e.slug),
}));
const listEssays = resolvedEssays.slice(1); // el [0] va como destacado
---

<Layout title={`${label} | Colecciones TGP`}>
  <div class="bg-theme-dark text-white min-h-screen pb-32">

    {/* ═══════════════════════════════════════════════════════════════════
        HERO DE COLECCIÓN
        Altura reducida: 42–56vh. Sin Ken Burns. Más institucional que editorial.
    ═══════════════════════════════════════════════════════════════════ */}
    <section class="relative w-full h-[52vh] md:h-[48vh] min-h-80 flex flex-col justify-end pb-10 md:pb-14 px-6 md:px-12 lg:px-24 overflow-hidden border-b border-white/10">
      <div class="absolute inset-0 z-0 bg-theme-dark overflow-hidden pointer-events-none">
        {featuredImg ? (
          <>
            <Image
              src={featuredImg}
              alt={label}
              class="w-full h-full object-cover opacity-40"
            />
            <div class="absolute inset-0 bg-linear-to-t from-theme-dark via-theme-dark/60 to-transparent pointer-events-none" />
            <div class="absolute inset-0 bg-linear-to-r from-theme-dark/80 to-transparent pointer-events-none" />
          </>
        ) : (
          <div class="absolute inset-0 bg-white/3" />
        )}
      </div>

      <div class="relative z-10 max-w-4xl">
        <nav class="mb-6 flex items-center gap-3 font-mono text-[9px] uppercase tracking-[0.3em] text-white/30">
          <a href="/colecciones" class="hover:text-[#C8A98B] transition-colors">Colecciones</a>
          <span>/</span>
          <span class="text-[#C8A98B]">{label}</span>
        </nav>
        <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B] block mb-3">
          {essays.length} {essays.length === 1 ? 'investigación' : 'investigaciones'}
        </span>
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-serif tracking-tighter leading-none">{label}</h1>
      </div>
    </section>

    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-12 md:gap-20 pt-14 md:pt-20">

      {/* ═══════════════════════════════════════════════════════════════════
          ARTÍCULO DESTACADO DE LA COLECCIÓN
          Desktop: imagen 7 cols / texto 5 cols
      ═══════════════════════════════════════════════════════════════════ */}
      {featuredEssay && (
        <section class="flex flex-col gap-6">
          <div class="reveal-item border-b border-white/10 pb-4">
            <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B]">Entrada Destacada</span>
          </div>

          <article class="group grid grid-cols-1 lg:grid-cols-12 gap-0 rounded-xl border border-white/10 overflow-hidden hover:border-[#C8A98B]/40 transition-all duration-500">
            {/* Imagen: 7 cols */}
            {featuredImg && (
              <div class="lg:col-span-7 relative overflow-hidden aspect-video lg:aspect-auto min-h-60">
                <Image
                  src={featuredImg}
                  alt={featuredEssay.entry.title || label}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-85 group-hover:opacity-100"
                />
                <div class="absolute inset-0 bg-linear-to-r from-transparent to-theme-dark/50 hidden lg:block pointer-events-none" />
              </div>
            )}

            {/* Texto: 5 cols (o 12 si sin imagen) */}
            <div class={`${featuredImg ? 'lg:col-span-5' : 'lg:col-span-12'} flex flex-col justify-center gap-4 p-7 md:p-9 bg-white/3`}>
              <div class="flex items-center gap-3 font-mono text-[9px] text-[#C8A98B] tracking-[0.2em] uppercase">
                <span>{formatCategory(featuredEssay.entry.category)}</span>
                <span class="opacity-30">•</span>
                <span class="text-white/40">{formatDate(featuredEssay.entry.date)}</span>
              </div>

              <h2 class="font-serif text-2xl md:text-3xl lg:text-4xl leading-tight group-hover:text-[#C8A98B] transition-colors duration-300">
                <a href={`/hemeroteca/${featuredEssay.slug}`} class="hover:underline">
                  {featuredEssay.entry.title}
                </a>
              </h2>

              {featuredEssay.entry.excerpt && (
                <p class="font-serif text-white/65 text-base leading-relaxed line-clamp-3 italic">
                  "{featuredEssay.entry.excerpt}"
                </p>
              )}

              <a
                href={`/hemeroteca/${featuredEssay.slug}`}
                class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.3em] text-white/40 hover:text-[#C8A98B] transition-colors duration-300 mt-2"
              >
                Leer investigación →
              </a>
            </div>
          </article>
        </section>
      )}

      {/* ═══════════════════════════════════════════════════════════════════
          LISTA DE ARTÍCULOS DE LA COLECCIÓN
          Tarjetas horizontales: imagen 40% / texto 60%
      ═══════════════════════════════════════════════════════════════════ */}
      {listEssays.length > 0 && (
        <section class="flex flex-col gap-6">
          <div class="reveal-item flex items-end justify-between border-b border-white/10 pb-4">
            <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B]">
              Más en {label}
            </span>
            <span class="font-mono text-[9px] text-white/30 tracking-[0.2em]">
              {listEssays.length} {listEssays.length === 1 ? 'entrada' : 'entradas'}
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {listEssays.map(({ slug, entry, img }: { slug: string; entry: typeof essays[0]['entry']; img: ImageMetadata | null }) => (
              <article class="group flex flex-col border border-white/8 rounded-xl overflow-hidden hover:border-[#C8A98B]/40 transition-all duration-400 bg-white/3">
                <div class={img ? "flex flex-col md:flex-row" : "flex flex-col"}>
                  {img && (
                    <div class="w-full md:w-[40%] shrink-0 overflow-hidden relative aspect-video md:aspect-auto md:min-h-35">
                      <Image
                        src={img}
                        alt={entry.title || label}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80 group-hover:opacity-100"
                      />
                    </div>
                  )}
                  <div class="flex flex-col justify-between gap-3 p-5 flex-1">
                    <div class="flex flex-col gap-2">
                      <div class="flex items-center gap-3 font-mono text-[9px] text-[#C8A98B] tracking-[0.2em] uppercase">
                        <span>{formatYear(entry.date)}</span>
                      </div>
                      <h3 class="font-serif text-lg md:text-xl leading-tight group-hover:text-[#C8A98B] transition-colors duration-300 line-clamp-2">
                        <a href={`/hemeroteca/${slug}`} class="hover:underline">{entry.title}</a>
                      </h3>
                      {entry.excerpt && (
                        <p class="font-serif text-white/55 text-sm leading-relaxed line-clamp-2 italic">
                          "{entry.excerpt}"
                        </p>
                      )}
                    </div>
                    <div class="pt-3 border-t border-white/5 font-mono text-[9px] uppercase tracking-[0.3em] text-white/30">
                      <a href={`/hemeroteca/${slug}`} class="hover:text-[#C8A98B] transition-colors">Explorar →</a>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {/* ═══════════════════════════════════════════════════════════════════
          ÍNDICE INTERNO
          AÑO · TÍTULO (solo artículos de esta colección)
      ═══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-6 border-t border-white/5 pt-10">
        <div class="reveal-item">
          <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B] block mb-2">Índice</span>
          <h2 class="text-2xl md:text-3xl font-serif">{label} — Todos los artículos</h2>
        </div>

        <ol class="flex flex-col divide-y divide-white/5">
          {resolvedEssays.map(({ slug, entry }: { slug: string; entry: typeof essays[0]['entry'] }, i: number) => (
            <li>
              <a
                href={`/hemeroteca/${slug}`}
                class="group flex items-baseline gap-4 md:gap-6 py-3 hover:text-[#C8A98B] transition-colors duration-300"
              >
                <span class="font-mono text-[10px] text-white/25 tracking-[0.2em] tabular-nums shrink-0 w-6 text-right">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="font-mono text-[9px] text-white/25 tracking-[0.2em] shrink-0 hidden sm:inline">
                  {formatYear(entry.date)}
                </span>
                <span class="font-serif text-sm md:text-base text-white/75 group-hover:text-[#C8A98B] transition-colors leading-snug line-clamp-1 flex-1">
                  {entry.title}
                </span>
                <span class="font-mono text-[9px] text-white/20 shrink-0 group-hover:text-[#C8A98B]/50">→</span>
              </a>
            </li>
          ))}
        </ol>

        <div class="pt-4 flex items-center justify-between">
          <a
            href="/colecciones"
            class="font-mono text-[10px] uppercase tracking-[0.3em] text-white/30 hover:text-[#C8A98B] transition-colors"
          >
            ← Todas las colecciones
          </a>
          <a
            href="/archivo"
            class="font-mono text-[10px] uppercase tracking-[0.3em] text-white/30 hover:text-[#C8A98B] transition-colors"
          >
            Archivo completo →
          </a>
        </div>
      </section>

    </div>
  </div>

  <script>
    const h1 = document.querySelector('h1');
    if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    document.addEventListener('astro:page-load', () => {
      const h1 = document.querySelector('h1');
      if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    });
  </script>
</Layout>
