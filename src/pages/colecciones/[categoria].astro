---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Image from '../../components/SafeImage.astro';
import CinematicArchiveCard from '../../components/CinematicArchiveCard.astro';
import CinematicGalleryEngine from '../../components/CinematicGalleryEngine.astro';
import Marquee from '../../components/Marquee.astro';
import CinematicExcerptRest from '../../components/CinematicExcerptRest.astro';
import AguaNieve from '../../components/AguaNieve.astro';
import VisorTemasSlider from '../../components/VisorTemasSlider.astro';

import {
  getPublishableEssays,
  groupByCategory,
  formatCategory,
  normalizeCategory,
  formatDate,
  formatYear,
  resolveEssayImage,
  sanitizeImageUrl,
} from '../../lib/content-filter';

// ─── GENERACIÓN ESTÁTICA DE RUTAS ────────────────────────────────────────────
export const prerender = true;
export async function getStaticPaths() {
  const allEssaysRaw = await getCollection('ensayos').catch(() => []);
  const allArquetiposRaw = await getCollection('arquetiposGlobales').catch(() => []);
  const allCinematicosRaw = await getCollection('ensayosCinematicos').catch(() => []);
  const allGeorefsRaw = await getCollection('georreferencias').catch(() => []);

  const isProd = import.meta.env.PROD;
  const publishableCinematicos = allCinematicosRaw.map(item => ({
    slug: item.id.replace(/\/index$/, ''),
    isCinematicGSAP: true,
    entry: {
      title: item.data.title || 'Dossier Cinemático',
      category: 'Ensayos Cinemáticos',
      coverImage: item.data.coverImage || (Array.isArray(item.data.gallery) && item.data.gallery.length > 0 ? item.data.gallery[0] : null),
      excerpt: 'Experiencia inmersiva GSAP a pantalla completa con diseño atmosférico.',
      date: new Date().toISOString(),
      themeColor: 'obsidiana',
      isCinematicGSAP: true,
    }
  }));

  const publishable = [
    ...publishableCinematicos,
    ...getPublishableEssays(allEssaysRaw, isProd),
    ...getPublishableEssays(allArquetiposRaw, isProd),
    ...getPublishableEssays(allGeorefsRaw, isProd)
  ];
  const groups = groupByCategory(publishable, 1);

  const paths = Array.from(groups.entries()).map(([key, essays]) => ({
    params: { categoria: key },
    props: { essays, key },
  }));

  // Alias compatible para georreferencias / sitios arqueohistóricos
  if (groups.has('arqueosemiotica') && !groups.has('sitios-arqueohistoricos')) {
    paths.push({
      params: { categoria: 'sitios-arqueohistoricos' },
      props: { essays: groups.get('arqueosemiotica')!, key: 'arqueosemiotica' },
    });
  }

  return paths;
}

// ─── PROPS & RESOLUCIÓN ───────────────────────────────────────────────────────
const { essays, key } = Astro.props;
const label = formatCategory(essays[0]?.entry.category || key);

// Resuelve imágenes de forma inteligente para cada ensayo
const resolvedEssays = essays.map((e: typeof essays[0]) => ({
  ...e,
  img: resolveEssayImage(e.entry, e.slug),
}));

const coverImage = resolvedEssays[0]?.img ?? '/images/placeholder-cover.png';
const coverImageUrl = sanitizeImageUrl((coverImage as any)?.src ?? coverImage ?? '');
const coverPosition =
  (resolvedEssays[0]?.entry as any)?.coverImagePosition
  || (resolvedEssays[0]?.entry as any)?.imagePosition
  || 'center center';

// Slides para el carrusel cinematográfico superior (hasta 8 imágenes destacadas)
const heroGallerySlides = resolvedEssays
  .filter((e: typeof resolvedEssays[0]) => e.img)
  .slice(0, 8)
  .map((e: typeof resolvedEssays[0]) => {
    const isCine = (e as any).isCinematicGSAP || e.entry?.category === 'Ensayos Cinemáticos';
    return {
      id:            e.slug,
      title:         e.entry.title || 'Sin Título',
      subtitle:      e.entry.volanta || e.entry.dek || undefined,
      category:      formatCategory(e.entry.category || label),
      year:          formatYear(e.entry.date),
      link:          isCine ? `/ensayos-cinematicos/${e.slug}/` : `/hemeroteca/${e.slug}/`,
      image:         sanitizeImageUrl((e.img as any)?.src ?? e.img),
      imagePosition: (e.entry as any)?.coverImagePosition ||
                     (e.entry as any)?.imagePosition ||
                     'center center',
    };
  });

// ─── TEXTOS DE POLVO DORADO POR CATEGORÍA ────────────────────────────────────
const categoryDustTexts: Record<string, string> = {
  'antropologia':        '[[Anthropos]] y su memoria inscrita. **El ser humano** como primer archivo, portador de ritos, lenguas y saberes que anteceden toda escritura. Aquí cada hallazgo es un espejo roto que refleja lo que fuimos antes de saber que éramos.',
  'arqueologia':         'La piedra **guarda más** que el papel. Cada capa de tierra es un párrafo de historia no escrita, un silencio que la [[arqueología]] aprende a leer. Los objetos hablan cuando se les da el tiempo y la atención que merecen.',
  'arqueosemiotica':     'Los símbolos preexisten al lenguaje. [[Arqueosemiótica]] es la disciplina que rastrea cómo el sentido se depositó en formas, gestos y relieves geográficos antes de que existieran palabras para nombrarlos.',
  'arquetipos-globales': 'Hay figuras que **trascienden culturas** y épocas. Los [[arquetipos]] son el ADN simbólico de la humanidad: patrones que emergen en mitos, ritos y sombras, repitiéndose en civilizaciones que jamás se conocieron.',
  'ensayos-cinematicos': 'La imagen no ilustra: **construye.** Cada [[dossier cinemático]] es una experiencia de lectura a pantalla completa: atmósfera, tipografía y movimiento al servicio de la idea. Un nuevo contrato entre ensayo e imagen.',
  'historia-medieval':   'La Edad Media no fue oscura. Fue un **laboratorio de formas** donde se forjó la Europa moderna entre [[scriptorios]], catedrales y cruzadas. Sus rastros herméticos aguardan aún nuevas lecturas.',
  'historia-moderna':    '**Ruptura y continuidad.** La [[historia moderna]] es el escenario donde el mundo occidental aprendió a mirarse a sí mismo: imprenta, Reforma, Razón. Todo comenzó aquí, en ese umbral vertiginoso.',
  'historia-antigua':    'Las primeras ciudades, los primeros [[códigos]], las primeras guerras de registro. La historia antigua es el origen del contrato humano con el tiempo: la decisión de **no olvidar.**',
  'historia':            'La historia no es el pasado: es la **tensión viva** entre lo que aconteció y el modo en que decidimos recordarlo. [[Archivos, testimonios y fracturas]] donde el tiempo cobra espesor.',
  'linguistica':         'El lenguaje no describe el mundo. Lo [[construye.]] Cada estructura gramatical es una forma de ver, y cada lengua perdida lleva consigo una manera irrecuperable de nombrar la realidad. **Las palabras son los últimos fósiles.**',
  'semiotica-cultural':  'Nada es solo lo que parece. La [[semiótica]] es la ciencia del significado: estudia cómo los signos crean mundos, cómo un color puede ser una orden y cómo **el silencio también habla.**',
  'filosofia':           '[[Filosofar]] es atreverse a no tener respuesta. Es la práctica más antigua de la humanidad consciente: dudar, preguntar, construir sistemas y destruirlos. Cada gran filósofo es un naufragio **que ilumina.**',
  'mitologia':           'El mito no miente. **Habla de otra verdad,** una que la historia no puede tocar. Los [[mitos]] son el lenguaje del alma colectiva: relatos que explican lo que la ciencia aún no puede y que el olvido todavía no se ha llevado.',
  'prehistoria':         'Antes de la escritura, hubo [[pintura]]. Antes de la ciudad, hubo rito. La prehistoria es el capítulo más largo del libro humano, escrito en hueso, pigmento y piedra. **Todo lo que somos nació allí.**',
  'georreferencias':     'Cartografía viva de [[lugares sagrados]] y coordenadas liminales. Hitos geohistóricos que anclan el mito a la roca, desafiando las cronologías convencionales con su muda presencia.',
};

const defaultDustText = `La colección [[${label}]] concentra investigaciones que excavan más allá de la superficie. **Cada documento es un umbral.** Un conjunto de rastros que aguardan la mirada que los vuelva a nombrar, trazar y comprender.`;
const dustText = categoryDustTexts[key] ?? defaultDustText;

// ─── TIPO DE LAYOUT EXCLUSIVO POR COLECCIÓN ─────────────────────────────────
type LayoutType = 'mosaico-arquetipos' | 'bitacora-arqueosemiotica' | 'cronica-historia' | 'teatro-cinematico' | 'premier-default';

const layoutType: LayoutType =
  key === 'arquetipos-globales' ? 'mosaico-arquetipos' :
  (key === 'arqueosemiotica' || key === 'georreferencias' || key === 'sitios-arqueohistoricos') ? 'bitacora-arqueosemiotica' :
  key === 'ensayos-cinematicos' ? 'teatro-cinematico' :
  key.startsWith('historia') ? 'cronica-historia' :
  'premier-default';

// Helper para secuencias Premier (usado en premier-default y como respaldo)
function createPremierSequences(items: typeof resolvedEssays) {
  const sequences: Array<{
    hero: typeof resolvedEssays[0];
    duo: typeof resolvedEssays;
  }> = [];
  
  for (let i = 0; i < items.length; i += 3) {
    sequences.push({
      hero: items[i],
      duo: items.slice(i + 1, i + 3),
    });
  }
  return sequences;
}

const sequences = createPremierSequences(resolvedEssays);
---

<Layout
  title={`${label} | Colección Exclusiva TGP`}
  description={`Colección temática especializada sobre ${label} en The Great Puzzle Project. Catálogo completo con ${resolvedEssays.length} investigaciones documentadas.`}
  image={coverImageUrl}
>
  <div class="text-white min-h-screen pb-32">

    {/* ── HERO: SEO H1 INVISIBLE ── */}
    <h1 class="sr-only">{label} | Colección Exclusiva TGP</h1>

    {/* ── HERO CABECERA: GALLERY ENGINE CON IMÁGENES DE LA COLECCIÓN ── */}
    {heroGallerySlides.length > 0 ? (
      <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 pt-4 md:pt-6">
        <CinematicGalleryEngine
          slides={heroGallerySlides}
          heightClass="h-[70vh] min-h-[500px] md:h-[80vh] lg:h-[84vh]"
          maxSlides={8}
        />
      </div>
    ) : (
      <Marquee
        title={label.toUpperCase()}
        subtitle="Colección Documental · TGP"
        imageUrl={coverImageUrl}
        vibeClass="vibe-travel-senses"
        isH1={true}
        fontClass="font-serif font-black"
      />
    )}

    {/* ── RESPIRO VISUAL / EXCERPT DOBLE SCROLL POLVO DORADO & TYPEMAGIC ── */}
    <CinematicExcerptRest text={dustText} />

    {/* ── AGUANIEVE CRISTALINO NARRATIVO ── */}
    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 -mt-4 mb-8">
      <AguaNieve category={key} />
    </div>

    {/* ── CONTENIDO PRINCIPAL SEGÚN EL LAYOUT EXCLUSIVO DE LA COLECCIÓN ── */}
    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-12 md:gap-16 pt-4">

      {/* ═════════════════════════════════════════════════════════════════════
          CASO 1: ARQUETIPOS GLOBALES (MOSAICO SIMBÓLICO TIPO CÓDEX / TAROT)
      ═════════════════════════════════════════════════════════════════════ */}
      {layoutType === 'mosaico-arquetipos' && (
        <section class="flex flex-col gap-8 md:gap-12">
          <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-white/10 pb-5 gap-3">
            <div>
              <span class="font-mono text-xs uppercase tracking-[0.4em] text-rust-orange font-bold block mb-1">
                Colección Simbólica · Cartografía de la Psique
              </span>
              <h2 class="text-3xl md:text-4xl lg:text-5xl font-serif font-black gradient-general-h1">
                Arquetipos Globales
              </h2>
            </div>
            <span class="font-mono text-xs uppercase tracking-[0.25em] text-white/50">
              {resolvedEssays.length} {resolvedEssays.length === 1 ? 'Arquetipo' : 'Arquetipos Documentados'}
            </span>
          </div>

          {/* Grilla Mosaico Simbólico: 3 columnas simétricas con proporción vertical editorial */}
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            {resolvedEssays.map((item, idx) => {
              const itemImg = item.img ? sanitizeImageUrl((item.img as any)?.src ?? item.img) : null;
              const linkUrl = `/hemeroteca/${item.slug}/`;

              return (
                <a
                  href={linkUrl}
                  class="group relative overflow-hidden rounded-xl md:rounded-2xl border border-white/10 bg-theme-dark/90 hover:border-white/25 hover:shadow-2xl hover:shadow-black/60 transition-all duration-500 flex flex-col justify-end isolate min-h-110 md:min-h-125"
                >
                  {itemImg ? (
                    <Image
                      src={itemImg}
                      alt={item.entry.title}
                      inferSize={true}
                      format="webp"
                      loading={idx < 3 ? "eager" : "lazy"}
                      decoding="async"
                      class="absolute inset-0 w-full h-full object-cover object-center brightness-85 contrast-[1.05] pointer-events-none -z-10 transition-transform duration-700 ease-out group-hover:scale-[1.03] group-hover:brightness-95"
                    />
                  ) : (
                    <div class="absolute inset-0 w-full h-full bg-linear-to-br from-[#1b1c24] via-theme-dark to-black -z-10" />
                  )}

                  {/* Scrim global */}
                  <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/40 via-40% to-transparent pointer-events-none z-10" />

                  {/* Scrim de blend en zona del título */}
                  <div class="absolute bottom-0 left-0 right-0 h-2/5 pointer-events-none z-10" style="background: linear-gradient(to top, rgba(8,6,5,0.88) 0%, rgba(8,6,5,0.55) 55%, transparent 100%); mix-blend-mode: multiply;" />

                  <div class="relative z-20 p-6 md:p-8 flex flex-col justify-end h-full">
                    <h3 class="font-cinzel font-extrabold text-2xl md:text-3xl leading-tight mb-4 gradient-acero-ios drop-shadow-xl">
                      {item.entry.title}
                    </h3>

                    <div class="pt-3 border-t border-white/10 flex items-center justify-between">
                      <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-white/45 group-hover:text-white/80 transition-colors">
                        Explorar →
                      </span>
                      {item.entry.date && (
                        <span class="font-mono text-[10px] text-white/30">
                          {formatYear(item.entry.date)}
                        </span>
                      )}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      {/* ═════════════════════════════════════════════════════════════════════
          CASO 2: ARQUEOSEMIÓTICA & GEORREFERENCIAS (BITÁCORA DE EXPEDICIÓN)
      ═════════════════════════════════════════════════════════════════════ */}
      {layoutType === 'bitacora-arqueosemiotica' && (
        <section class="flex flex-col gap-10 md:gap-14">
          <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-white/10 pb-5 gap-3">
            <div>
              <span class="font-mono text-xs uppercase tracking-[0.4em] text-rust-orange font-bold block mb-1">
                Bitácora de Campo · Cartografía Lítica & Simbólica
              </span>
              <h2 class="text-3xl md:text-4xl lg:text-5xl font-serif font-black gradient-general-h1">
                Arqueosemiótica & Georreferencias
              </h2>
            </div>
            <span class="font-mono text-xs uppercase tracking-[0.25em] text-white/50">
              {resolvedEssays.length} {resolvedEssays.length === 1 ? 'Sitio' : 'Sitios & Investigaciones'}
            </span>
          </div>

          {/* 1. Sitio Principal Destacado (Hero Panorámico con Coordenadas) */}
          {resolvedEssays[0] && (
            <div class="w-full">
              <CinematicArchiveCard
                slug={resolvedEssays[0].slug}
                entry={resolvedEssays[0].entry}
                img={resolvedEssays[0].img}
                variant="hero"
                enableCinemagraph={true}
              />
            </div>
          )}

          {/* 2. Grid de Expediciones: 2 columnas asimétricas con datos geohistóricos */}
          {resolvedEssays.length > 1 && (
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
              {resolvedEssays.slice(1).map((item, idx) => {
                const itemImg = item.img ? sanitizeImageUrl((item.img as any)?.src ?? item.img) : null;
                const linkUrl = `/hemeroteca/${item.slug}/`;

                return (
                  <a
                    href={linkUrl}
                    class="group relative overflow-hidden rounded-xl md:rounded-2xl border border-white/10 bg-theme-dark/80 hover:border-white/25 transition-all duration-500 flex flex-col justify-end min-h-95 md:min-h-105 isolate"
                  >
                    {itemImg ? (
                      <Image
                        src={itemImg}
                        alt={item.entry.title}
                        inferSize={true}
                        format="webp"
                        loading="lazy"
                        decoding="async"
                        class="absolute inset-0 w-full h-full object-cover object-center brightness-75 contrast-[1.05] pointer-events-none -z-10 transition-transform duration-700 ease-out group-hover:scale-[1.025] group-hover:brightness-90"
                      />
                    ) : (
                      <div class="absolute inset-0 w-full h-full bg-linear-to-br from-[#161a1d] via-theme-dark to-[#090b0c] -z-10" />
                    )}

                    {/* Scrim global */}
                    <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/40 via-50% to-transparent pointer-events-none z-10" />

                    {/* Scrim blend en zona del título */}
                    <div class="absolute bottom-0 left-0 right-0 h-2/5 pointer-events-none z-10" style="background: linear-gradient(to top, rgba(8,6,5,0.85) 0%, rgba(8,6,5,0.45) 60%, transparent 100%); mix-blend-mode: multiply;" />

                    <div class="relative z-20 p-6 md:p-8 flex flex-col justify-end h-full">
                      <h3 class="font-cinzel font-extrabold text-2xl md:text-3xl leading-tight mb-4 gradient-acero-ios drop-shadow-xl">
                        {item.entry.title}
                      </h3>

                      <div class="pt-3 border-t border-white/10 flex items-center justify-between">
                        <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-white/45 group-hover:text-white/80 transition-colors">
                          Explorar →
                        </span>
                        <span class="font-mono text-[10px] text-white/30">
                          {formatYear(item.entry.date)}
                        </span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          )}
        </section>
      )}

      {/* ═════════════════════════════════════════════════════════════════════
          CASO 3: HISTORIA & CRÓNICA DOCUMENTAL (LÍNEA DE TIEMPO / CRÓNICA)
      ═════════════════════════════════════════════════════════════════════ */}
      {layoutType === 'cronica-historia' && (
        <section class="flex flex-col gap-10 md:gap-14">
          <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-white/10 pb-5 gap-3">
            <div>
              <span class="font-mono text-xs uppercase tracking-[0.4em] text-rust-orange font-bold block mb-1">
                Crónica Documental · Archivo Histórico
              </span>
              <h2 class="text-3xl md:text-4xl lg:text-5xl font-serif font-black gradient-general-h1">
                {label}
              </h2>
            </div>
            <span class="font-mono text-xs uppercase tracking-[0.25em] text-white/50">
              {resolvedEssays.length} {resolvedEssays.length === 1 ? 'Registro' : 'Registros Documentales'}
            </span>
          </div>

          {/* Secuencias Cinematográficas Premier: 1 Hero Full Bleed + Dúo 60/40 */}
          <div class="flex flex-col gap-12 md:gap-16">
            {sequences.map((seq) => (
              <div class="premier-sequence flex flex-col gap-6 md:gap-8">
                {/* 1. Hero Cinemático */}
                <div class="w-full">
                  <CinematicArchiveCard
                    slug={seq.hero.slug}
                    entry={seq.hero.entry}
                    img={seq.hero.img}
                    variant="hero"
                    enableCinemagraph={true}
                  />
                </div>

                {/* 2. Dúo 60/40 */}
                {seq.duo.length > 0 && (
                  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
                    {seq.duo[0] && (
                      <div class={seq.duo.length > 1 ? "lg:col-span-7 flex flex-col" : "lg:col-span-12 flex flex-col"}>
                        <CinematicArchiveCard
                          slug={seq.duo[0].slug}
                          entry={seq.duo[0].entry}
                          img={seq.duo[0].img}
                          variant={seq.duo.length > 1 ? "duo-60" : "hero"}
                          enableCinemagraph={true}
                        />
                      </div>
                    )}
                    {seq.duo[1] && (
                      <div class="lg:col-span-5 flex flex-col">
                        <CinematicArchiveCard
                          slug={seq.duo[1].slug}
                          entry={seq.duo[1].entry}
                          img={seq.duo[1].img}
                          variant="duo-40"
                          enableCinemagraph={true}
                        />
                      </div>
                    )}
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      {/* ═════════════════════════════════════════════════════════════════════
          CASO 4: ENSAYOS CINEMÁTICOS (TEATRO OSCURO / DOSSIERES GSAP)
      ═════════════════════════════════════════════════════════════════════ */}
      {layoutType === 'teatro-cinematico' && (
        <section class="flex flex-col gap-10 md:gap-14">
          <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-white/10 pb-5 gap-3">
            <div>
              <span class="font-mono text-xs uppercase tracking-[0.4em] text-rust-orange font-bold block mb-1">
                Experiencias a Pantalla Completa · Dossieres GSAP
              </span>
              <h2 class="text-3xl md:text-4xl lg:text-5xl font-serif font-black gradient-general-h1">
                Ensayos Cinemáticos
              </h2>
            </div>
            <span class="font-mono text-xs uppercase tracking-[0.25em] text-white/50">
              {resolvedEssays.length} {resolvedEssays.length === 1 ? 'Dossier' : 'Dossieres Cinemáticos'}
            </span>
          </div>

          {/* Grilla de Posters Cinemáticos Panorámicos */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
            {resolvedEssays.map((item, idx) => {
              const itemImg = item.img ? sanitizeImageUrl((item.img as any)?.src ?? item.img) : null;
              const linkUrl = `/ensayos-cinematicos/${item.slug}/`;

              return (
                <a
                  href={linkUrl}
                  class="group relative overflow-hidden rounded-2xl md:rounded-3xl border border-white/10 bg-theme-dark hover:border-white/25 hover:shadow-2xl hover:shadow-black/80 transition-all duration-500 flex flex-col justify-end aspect-16/10 min-h-90 md:min-h-105 isolate"
                >
                  {itemImg ? (
                    <Image
                      src={itemImg}
                      alt={item.entry.title}
                      inferSize={true}
                      format="webp"
                      loading={idx < 4 ? "eager" : "lazy"}
                      decoding="async"
                      class="absolute inset-0 w-full h-full object-cover object-center brightness-75 contrast-[1.08] pointer-events-none -z-10 transition-transform duration-700 ease-out group-hover:scale-[1.03] group-hover:brightness-90"
                    />
                  ) : (
                    <div class="absolute inset-0 w-full h-full bg-linear-to-br from-[#101316] via-theme-dark to-black -z-10" />
                  )}

                  <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/50 via-40% to-transparent pointer-events-none z-10" />

                  <div class="relative z-20 p-6 md:p-8 flex flex-col justify-end h-full">
                    <div class="flex items-center gap-3 mb-2">
                      <span class="font-mono text-[9px] md:text-[10px] uppercase tracking-[0.35em] text-rust-orange font-bold px-2.5 py-1 rounded bg-black/60 border border-rust-orange/30 backdrop-blur-sm">
                        GSAP Inmersivo
                      </span>
                      {item.entry.date && (
                        <span class="font-mono text-[10px] text-white/50 tracking-wider">
                          {formatYear(item.entry.date)}
                        </span>
                      )}
                    </div>

                    <h3 class="text-2xl md:text-3xl lg:text-4xl font-serif font-black text-white group-hover:text-rust-orange transition-colors leading-tight mb-2">
                      {item.entry.title}
                    </h3>

                    {item.entry.dek && (
                      <p class="font-serif text-white/75 text-xs md:text-sm line-clamp-2 mb-4 leading-relaxed font-light">
                        {item.entry.dek}
                      </p>
                    )}

                    <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.25em] text-white/70 group-hover:text-white transition-colors">
                      <span>Iniciar Experiencia Cinemática</span>
                      <span class="group-hover:translate-x-1.5 transition-transform">→</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      {/* ═════════════════════════════════════════════════════════════════════
          CASO 5: PREMIER DEFAULT (ARQUEOLOGÍA, FILOSOFÍA, ENSAYO, ETC.)
      ═════════════════════════════════════════════════════════════════════ */}
      {layoutType === 'premier-default' && (
        <section class="flex flex-col gap-10 md:gap-14">
          <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-white/10 pb-5 gap-3">
            <div>
              <span class="font-mono text-xs uppercase tracking-[0.4em] text-rust-orange font-bold block mb-1">
                Colección Especializada · Archivo TGP
              </span>
              <h2 class="text-3xl md:text-4xl lg:text-5xl font-serif font-black gradient-general-h1">
                {label}
              </h2>
            </div>
            <span class="font-mono text-xs uppercase tracking-[0.25em] text-white/50">
              {resolvedEssays.length} {resolvedEssays.length === 1 ? 'Documento' : 'Documentos'}
            </span>
          </div>

          <div class="flex flex-col gap-12 md:gap-16">
            {sequences.map((seq) => (
              <div class="premier-sequence flex flex-col gap-6 md:gap-8">
                {/* 1. Hero Cinemático */}
                <div class="w-full">
                  <CinematicArchiveCard
                    slug={seq.hero.slug}
                    entry={seq.hero.entry}
                    img={seq.hero.img}
                    variant="hero"
                    enableCinemagraph={true}
                  />
                </div>

                {/* 2. Dúo 60/40 */}
                {seq.duo.length > 0 && (
                  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
                    {seq.duo[0] && (
                      <div class={seq.duo.length > 1 ? "lg:col-span-7 flex flex-col" : "lg:col-span-12 flex flex-col"}>
                        <CinematicArchiveCard
                          slug={seq.duo[0].slug}
                          entry={seq.duo[0].entry}
                          img={seq.duo[0].img}
                          variant={seq.duo.length > 1 ? "duo-60" : "hero"}
                          enableCinemagraph={true}
                        />
                      </div>
                    )}
                    {seq.duo[1] && (
                      <div class="lg:col-span-5 flex flex-col">
                        <CinematicArchiveCard
                          slug={seq.duo[1].slug}
                          entry={seq.duo[1].entry}
                          img={seq.duo[1].img}
                          variant="duo-40"
                          enableCinemagraph={true}
                        />
                      </div>
                    )}
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      {/* ═════════════════════════════════════════════════════════════════════
          ÍNDICE INTERNO & VISOR CINEMÁTICO SINCRONIZADO
      ═════════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-8 border-t border-white/10 pt-12 mt-8">
        <div class="reveal-item flex items-end justify-between">
          <div>
            <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-rust-orange block mb-1">Catálogo Exhaustivo</span>
            <h2 class="text-2xl md:text-3xl font-serif font-black gradient-general-h2">
              {label} — Visor &amp; Índice Completo
            </h2>
          </div>
          <span class="font-mono text-xs text-white/40">
            {resolvedEssays.length} {resolvedEssays.length === 1 ? 'Entrada' : 'Entradas'}
          </span>
        </div>

        {/* Visor Cinemático Horizontal (Cinema Stage con Slider GSAP y Chevrons) */}
        <VisorTemasSlider items={resolvedEssays} label={label} />

        {/* Lista Exhaustiva Sincronizada con el Visor */}
        <div class="flex flex-col gap-2 mt-4">
          <div class="flex items-center justify-between px-3 pb-2 border-b border-white/10 text-white/40 font-mono text-[10px] uppercase tracking-widest">
            <span>N° · Temas del Catálogo (Haz clic en una fila para proyectar en el visor)</span>
            <span class="hidden sm:inline">Acción</span>
          </div>

          <ol class="flex flex-col divide-y divide-white/5">
            {resolvedEssays.map(({ slug, entry, isCinematicGSAP }: { slug: string; entry: typeof essays[0]['entry']; isCinematicGSAP?: boolean }, i: number) => {
              const isCine = isCinematicGSAP || entry.category === 'Ensayos Cinemáticos' || (entry as any)?.isCinematicGSAP;
              const linkHref = isCine ? `/ensayos-cinematicos/${slug}/` : `/hemeroteca/${slug}/`;
              return (
                <li
                  class={`catalogo-indice-item group flex items-center justify-between py-3.5 px-3 md:px-4 rounded-xl transition-all duration-300 hover:bg-white/5 cursor-pointer ${i === 0 ? 'bg-white/5 text-white' : 'text-white/80'}`}
                  data-item-index={i}
                  style={i === 0 ? 'border-left: 3px solid #e07a5f;' : 'border-left: 3px solid transparent;'}
                >
                  <div class="flex items-center gap-4 md:gap-6 min-w-0 flex-1">
                    <span class="font-mono text-xs text-white/30 tracking-wider tabular-nums shrink-0 w-8 text-right group-hover:text-rust-orange transition-colors">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="font-mono text-[10px] text-rust-orange/80 tracking-[0.2em] shrink-0 hidden sm:inline">
                      {formatYear(entry.date)}
                    </span>
                    <span class="font-serif text-sm md:text-base group-hover:text-white transition-colors leading-snug line-clamp-1 font-medium">
                      {entry.title}
                    </span>
                  </div>

                  <div class="flex items-center gap-3 shrink-0 ml-4">
                    <button
                      type="button"
                      class="px-2.5 py-1 rounded bg-white/5 hover:bg-white/10 text-white/60 hover:text-white font-mono text-[9px] uppercase tracking-wider transition-colors hidden md:inline-block"
                    >
                      Proyectar ✦
                    </button>
                    <a
                      href={linkHref}
                      class="font-mono text-[10px] uppercase text-white/40 group-hover:text-rust-orange group-hover:translate-x-1 transition-all py-1 px-2"
                      aria-label={`Abrir ${entry.title}`}
                    >
                      {isCine ? 'GSAP →' : 'Leer →'}
                    </a>
                  </div>
                </li>
              );
            })}
          </ol>
        </div>

        {/* Barra de Retorno y Exploración Cruzada */}
        <div class="pt-8 flex items-center justify-between border-t border-white/10 font-mono text-[11px] uppercase tracking-[0.3em]">
          <a
            href="/colecciones/"
            class="text-white/50 hover:text-rust-orange transition-colors flex items-center gap-2 py-2"
          >
            <span>←</span>
            <span>Todas las colecciones</span>
          </a>
          <a
            href="/archivo/"
            class="text-white/50 hover:text-rust-orange transition-colors flex items-center gap-2 py-2"
          >
            <span>Archivo general</span>
            <span>→</span>
          </a>
        </div>
      </section>

    </div>
  </div>

  <script>
    const h1 = document.querySelector('h1');
    if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    document.addEventListener('astro:page-load', () => {
      const h1 = document.querySelector('h1');
      if (h1) setTimeout(() => h1.classList.add('revealed'), 200);
    });
  </script>
</Layout>
