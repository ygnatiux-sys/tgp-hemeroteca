---
/**
 * src/pages/test-revista-curador.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * LABORATORIO DE CURADURÍA VISUAL Y EXHIBICIÓN (TGP REVISTAS DIGITALES)
 *
 * Entorno de prueba interactivo de alta fidelidad:
 * - Hero Cinemax Max (21:9) con GSAP adaptativo.
 * - Mesa de luz Developer Lightbox con grilla 4x3 de 12 tarjetas en vista.
 * - Sincronización en tiempo real vía evento 'tgp:preview-batch'.
 * - Exportación Cloud Run de 2 vías (WebP q82 + PDF de referencia).
 * ─────────────────────────────────────────────────────────────────────────────
 */

export const prerender = false;

import Layout from '../layouts/Layout.astro';
import WikiCinematicHero from '../components/WikiCinematicHero.astro';
import WikiDeveloperLightbox from '../components/WikiDeveloperLightbox.astro';
import { searchWikiCurator } from '../lib/wikiCuratorEngine';

const queryParam = Astro.url.searchParams.get('q') || 'Saqqara pyramid';

// Pre-fetch inicial en el servidor
const curatorResult = await searchWikiCurator({
  query: queryParam,
  limit: 40,
  useGeminiAgent: true,
});

const initialImages = curatorResult.images;
const initialHeroBatch = initialImages.slice(0, 12);
---

<Layout 
  title="Laboratorio de Curaduría Visual · TGP Revistas Digitales"
  description="Sistema de curaduría fotográfica, Hero 21:9 anamórfico y exportación Cloud Run"
  headerTransparentUntilScroll={true}
>
  <main class="w-full min-h-screen bg-black text-white selection:bg-amber-400 selection:text-black">
    
    <!-- 1. HERO CINEMÁTICO ADAPTATIVO (21:9 / h-[88vh]) -->
    <WikiCinematicHero 
      images={initialHeroBatch}
      headline={`Acervo Curado: ${queryParam}`}
      tagline="Lote de Alta Resolución · Wikimedia Commons Scale"
      showAnamorphicBars={true}
    />

    <!-- Separador Sutil con Indicador de Flujo -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-2 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <h2 class="font-mono text-xs uppercase tracking-widest text-zinc-400">
          Mesa de Luz y Selector de Revista (Lote de 40 fotos)
        </h2>
      </div>

      <div class="font-mono text-[11px] text-zinc-500">
        Traducción canónica Commons: <span class="text-amber-400 font-semibold">{curatorResult.searchTermEnglish}</span>
      </div>
    </div>

    <!-- 2. DEVELOPER LIGHTBOX CON EXPORTACIÓN CLOUD RUN -->
    <WikiDeveloperLightbox 
      initialQuery={queryParam}
      initialBatch={initialImages}
      cloudRunEndpoint="/api/cloudrun-magazine-export"
    />

  </main>
</Layout>
