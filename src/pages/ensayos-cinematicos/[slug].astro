---
import { getCollection, getEntry, render } from 'astro:content';
import LayoutObsidiana from '../../layouts/CinematicFX/LayoutObsidiana.astro';
import LayoutDeriva from '../../layouts/CinematicFX/LayoutDeriva.astro';
import LayoutUmbral from '../../layouts/CinematicFX/LayoutUmbral.astro';
import { parseLLMText } from '../../lib/parseLLMText';
import { isValidImageSrc } from '../../lib/content-filter';
import PostCinematicStyle from '../../components/PostCinematicStyle.astro';
import BackSlideButton from '../../components/BackSlideButton.astro';

export const prerender = true;

export async function getStaticPaths() {
  const ensayos = await getCollection('ensayosCinematicos').catch(() => []);

  return ensayos.map((entry) => ({
    params: { slug: entry.id.replace(/\/index$/, '') },
    props: { entry },
  }));
}

const slug = Astro.params.slug as string;
const { entry } = Astro.props;

// Carga del contenido Markdoc si existe en la colección
let Content: any = null;
try {
  const contentEntry = await getEntry('ensayosCinematicosContent' as any, `${slug}/content`);
  if (contentEntry && contentEntry.body && contentEntry.body.trim().length > 0) {
    const rendered = await render(contentEntry as any);
    Content = rendered.Content;
  }
} catch (err) {
  // Sin content.mdoc — se renderizará desde generadorTexto o aiText
}

// ─── EXTRACCIÓN UNIFICADA DE IA (TEXTO + IMAGEN) ───
let aiText = entry.data.generadorTexto || '';
let aiImage = null;

if (entry.data.generadorTexto && entry.data.generadorTexto.startsWith('{')) {
  try {
    const parsed = JSON.parse(entry.data.generadorTexto);
    aiText = parsed.text || '';
    if (parsed?.image && isValidImageSrc(parsed.image)) {
      aiImage = parsed.image;
    }
  } catch (e) {}
}

const directCover = (entry.data as any).coverImage || (entry.data as any).image || (entry.data as any).portada || null;
const validDirectCover = (directCover && isValidImageSrc(typeof directCover === 'object' ? directCover.src : directCover)) ? directCover : null;

const finalFrontmatter = {
  ...entry.data,
  // Si no hay coverImage/image/portada manual válido, inyectamos la generada por Gemini Flash (si es válida)
  coverImage: validDirectCover || aiImage,
  image: validDirectCover || aiImage,
  portada: validDirectCover || aiImage,
  // Excerpt de los primeros 200 chars del texto IA si no hay ninguno
  excerpt: (entry.data as any).excerpt || (aiText ? aiText.replace(/[#*_`]/g, '').slice(0, 200) + '…' : ''),
};

// 1. Diccionario de Presets Cinemáticos
const PRESETS_CINEMATICOS = {
  obsidiana: LayoutObsidiana,
  deriva: LayoutDeriva,
  umbral: LayoutUmbral,
} as const;

type PresetKey = keyof typeof PRESETS_CINEMATICOS;

// 2. Extracción de atmósfera (soporte para valor simple o fields.conditional de Keystatic)
const rawAtmosfera = entry.data.atmosfera;
let atmosferaKey: string = 'obsidiana';
let customVariables: Record<string, any> = {};

if (typeof rawAtmosfera === 'string') {
  atmosferaKey = rawAtmosfera;
} else if (rawAtmosfera && typeof rawAtmosfera === 'object') {
  atmosferaKey = rawAtmosfera.discriminant || 'obsidiana';
  if (atmosferaKey === 'custom' && rawAtmosfera.value) {
    customVariables = rawAtmosfera.value;
  }
}

const isCustom = atmosferaKey === 'custom';

// 3. Resolución dinámica del Layout (fallback a LayoutObsidiana si no coincide o es custom)
const SelectedLayout = !isCustom && atmosferaKey in PRESETS_CINEMATICOS
  ? PRESETS_CINEMATICOS[atmosferaKey as PresetKey]
  : LayoutObsidiana;

// 4. Parámetros de configuración (preset estándar vs variables personalizadas custom)
const layoutProps = {
  frontmatter: finalFrontmatter,
  isCustom,
  atmosfera: atmosferaKey,
  config: isCustom ? customVariables : undefined,
};

const fullEssayText = aiText || (finalFrontmatter as any).generadorTexto || '';
// Todos los ensayos cinemáticos usan el modo Hero Cinemático
const parsedHtml = parseLLMText(fullEssayText, { isHeroCinematicStyle: true });
---

<SelectedLayout {...layoutProps}>
  <BackSlideButton fallbackUrl="/ensayos-cinematicos" />
  {Content ? (
    <div class="flex flex-col gap-12 w-full">
      <Content />
    </div>
  ) : (
    <div class="flex flex-col gap-12 w-full">
      <PostCinematicStyle class="hero-cinematic-mode">
        <div class="cinematic-essay-content w-full" set:html={parsedHtml} />
      </PostCinematicStyle>
    </div>
  )}
</SelectedLayout>

<script>
  function initHeroCinematicReveal() {
    // Aplica a todos los ensayos cinemáticos (hero-cinematic-mode en todos)
    const blocks = document.querySelectorAll<HTMLElement>('.hero-cinematic-mode .cinematic-block');
    if (!blocks.length) return;

    // Marcamos inmediatamente los primeros 2 bloques como visibles para lectura inmediata
    blocks.forEach((block, idx) => {
      if (idx < 2) {
        block.classList.add('is-visible');
      }
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    blocks.forEach((block) => observer.observe(block));
  }

  document.addEventListener('astro:page-load', initHeroCinematicReveal);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroCinematicReveal);
  } else {
    initHeroCinematicReveal();
  }
</script>


