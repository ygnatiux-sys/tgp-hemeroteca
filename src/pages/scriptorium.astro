---
import Layout from '../layouts/Layout.astro';
import ScriptoriumCapture from '../components/ScriptoriumCapture.svelte';
---

<Layout title="TGP Scriptorium · Motor Cognitivo Multimodal">
  <main class="w-full max-w-[1750px] mx-auto px-4 sm:px-8 lg:px-12 py-5 min-h-screen flex flex-col justify-start pb-24">
    <ScriptoriumCapture client:load embedded={true} />
  </main>
</Layout>

<style is:global>
  .picker-dialog-bg {
    z-index: 99998 !important;
    position: fixed !important;
  }
  .picker-dialog {
    z-index: 99999 !important;
    position: fixed !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
  }
</style>
