---
import '../styles/global.css';
import ScriptoriumCapture from '../components/ScriptoriumCapture.svelte';

export const prerender = false;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TGP Scriptorium · Motor Cognitivo Multimodal</title>
    <link rel="icon" type="image/webp" href="/images/favicon.TGP.webp" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800;900&family=Gloock&family=Inter:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0f1112] text-stone-200 antialiased min-h-screen selection:bg-emerald-900 selection:text-white">
    <div class="w-full min-h-screen p-2 sm:p-4 lg:p-6 flex flex-col justify-start">
      <ScriptoriumCapture client:only="svelte" embedded={true} />
    </div>
  </body>
</html>

<style is:global>
  .picker-dialog-bg {
    z-index: 99998 !important;
    position: fixed !important;
  }
  .picker-dialog {
    z-index: 99999 !important;
    position: fixed !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
  }
</style>
