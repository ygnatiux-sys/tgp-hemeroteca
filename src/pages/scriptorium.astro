---
import Layout from '../layouts/Layout.astro';
import ScriptoriumCapture from '../components/ScriptoriumCapture.svelte';
---

<Layout title="TGP Scriptorium · Motor Cognitivo Multimodal">
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 min-h-screen flex flex-col justify-center">
    <header class="mb-10 text-center">
      <span class="inline-block px-3 py-1 text-[11px] font-mono font-medium uppercase tracking-widest text-emerald-600 bg-emerald-50 rounded-full border border-emerald-200 mb-3">
        Ingesta &amp; Visión Cognitiva
      </span>
      <h1 class="text-3xl sm:text-4xl font-serif font-light text-zinc-900 dark:text-zinc-100">
        TGP Scriptorium
      </h1>
      <p class="text-zinc-500 dark:text-zinc-400 mt-2 text-sm max-w-xl mx-auto font-sans leading-relaxed">
        Análisis semiótico de imágenes, iconografía y consulta directa con Google Cloud.
      </p>
    </header>

    <div class="bg-zinc-50 dark:bg-zinc-900/50 p-6 sm:p-8 rounded-3xl border border-zinc-200 dark:border-zinc-800 shadow-xl">
      <ScriptoriumCapture client:load />
    </div>
  </main>
</Layout>
