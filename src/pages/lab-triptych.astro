---
import BaseLayout from '../layouts/BaseLayout.astro';
import TgpHeroTriptych from '../components/TgpHeroTriptych.astro';
---

<BaseLayout title="Laboratorio: Tríptico Editorial Apple TV+ | TGP">
  <main class="min-h-screen bg-[#09090b] text-white p-4 md:p-8 flex flex-col gap-8">
    <header class="max-w-7xl mx-auto w-full pt-4 pb-2 border-b border-zinc-800/80 flex items-center justify-between">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-amber-400">Lab Experimental</span>
        <h1 class="text-xl font-bold tracking-tight text-zinc-100">TgpHeroTriptych (Composición Editorial Asimétrica 48% / 37% / 15%)</h1>
      </div>
      <span class="text-xs px-2.5 py-1 rounded bg-zinc-800 text-zinc-300 font-mono">Apple TV+ Engine</span>
    </header>

    <div class="max-w-7xl mx-auto w-full">
      <TgpHeroTriptych />
    </div>
  </main>
</BaseLayout>
