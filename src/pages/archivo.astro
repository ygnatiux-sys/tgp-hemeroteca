---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CinematicArchiveCard from '../components/CinematicArchiveCard.astro';
import CinematicPostEngine from '../components/CinematicPostEngine.astro';
import InteriorHero from '../components/InteriorHero.astro';
import {
  getPublishableEssays,
  formatCategory,
  formatDate,
  formatYear,
  normalizeCategory,
  resolveEssayImage,
  sortEssaysByVisualFirst,
} from '../lib/content-filter';

// ─── CARGA Y FILTRADO CENTRALIZADO ───────────────────────────────────────────
const allEssaysRaw = await getCollection('ensayos').catch(err => {
  console.error("[ARCHIVO] Falló carga de ensayos:", err);
  return [];
});

const allArquetiposRaw = await getCollection('arquetiposGlobales').catch(() => []);

const isProd = import.meta.env.PROD;
const publishableEssays = getPublishableEssays(allEssaysRaw, isProd);
const publishableArquetipos = getPublishableEssays(allArquetiposRaw, isProd);

const publishable = [...publishableEssays, ...publishableArquetipos].sort(sortEssaysByVisualFirst);

// ─── CATEGORÍAS Y AÑOS REALES PARA FILTROS ───────────────────────────────────
const categories = [...new Set(
  publishable
    .map(e => normalizeCategory(e.entry.category))
    .filter(c => c !== 'ensayo')
)].sort();

const years = [...new Set(
  publishable
    .map(e => e.entry.date ? new Date(e.entry.date).getFullYear().toString() : '')
    .filter(Boolean)
)].sort((a, b) => Number(b) - Number(a));

// ─── CARGA DE IMÁGENES CON RESOLUCIÓN INTELIGENTE ─────────────────────────────
const resolvedEssays = publishable.map(e => ({
  ...e,
  img: resolveEssayImage(e.entry.coverImage, e.slug),
}));

// Agrupamiento por categorías para barras editoriales estilo suizo
const essaysByCategory = categories.map(cat => {
  const essays = resolvedEssays.filter(e => normalizeCategory(e.entry.category) === cat);
  return {
    catKey: cat,
    catLabel: formatCategory(cat),
    essays
  };
}).filter(group => group.essays.length > 0);

const categorizedSlugs = new Set(essaysByCategory.flatMap(g => g.essays.map(e => e.slug)));
const uncategorized = resolvedEssays.filter(e => !categorizedSlugs.has(e.slug));
if (uncategorized.length > 0) {
  essaysByCategory.push({
    catKey: 'otros',
    catLabel: 'Otras Investigaciones',
    essays: uncategorized
  });
}

// 4 Tarjetas Destacadas de Categoría para el Header del Archivo
const categoryHighlightCards = essaysByCategory.slice(0, 4).map(group => {
  const leadEssay = group.essays[0];
  const yearRange = group.essays
    .map(e => e.entry.date ? new Date(e.entry.date).getFullYear() : null)
    .filter(Boolean)
    .sort((a, b) => (a as number) - (b as number));
  
  const yearLabel = yearRange.length > 0
    ? yearRange[0] === yearRange[yearRange.length - 1]
      ? `${yearRange[0]}`
      : `${yearRange[0]}–${yearRange[yearRange.length - 1]}`
    : '';

  return {
    catKey: group.catKey,
    catLabel: group.catLabel,
    count: group.essays.length,
    yearLabel,
    img: leadEssay?.img,
  };
});

// ─── PORTADA DEL HERO: primer arquetipoGlobal con imagen ────────────────────
const arquetiposConImg = publishableArquetipos
  .map(e => ({ ...e, img: resolveEssayImage(e.entry.coverImage, e.slug) }))
  .filter(e => e.img);
const archiveCoverEssay = arquetiposConImg[0] ?? resolvedEssays.find(e => e.img);
const archiveCover = archiveCoverEssay
  ? {
      src: (archiveCoverEssay.img as any)?.src ?? archiveCoverEssay.img,
      position: (archiveCoverEssay.entry as any).coverImagePosition ||
                (archiveCoverEssay.entry as any).imagePosition ||
                'center center',
    }
  : null;

// ─── SLIDES PARA EL ENGINE: todos los posts en orden de categoría ─────────────
const archiveSlides = essaysByCategory.flatMap(group =>
  group.essays.map(e => ({
    id: e.slug,
    title: e.entry.title || 'Dossier',
    subtitle: e.entry.excerpt || '',
    category: group.catLabel,
    date: e.entry.date ? formatYear(e.entry.date) : '',
    image: (e.img as any)?.src ?? e.img,
    imagePosition: (e.entry as any).coverImagePosition || (e.entry as any).imagePosition || 'center center',
    link: `/hemeroteca/${e.slug}`,
  }))
).filter(s => s.image);

// Helper para mapear essays a SlideData de CinematicPostEngine
function mapToSlideData(essays: typeof resolvedEssays) {
  return essays.map(e => ({
    id: e.slug,
    title: e.entry.title || 'Dossier',
    subtitle: e.entry.excerpt || '',
    category: formatCategory(e.entry.category),
    date: e.entry.date ? formatYear(e.entry.date) : '',
    image: (e.img as any)?.src ?? e.img,
    imagePosition: (e.entry as any).coverImagePosition || (e.entry as any).imagePosition || 'center center',
    link: `/hemeroteca/${e.slug}`,
    papersLink: (e.entry as any).papersSlug ? `/papers/${(e.entry as any).papersSlug}` : undefined,
  }));
}

// ─── HELPER PARA SECUENCIAS CINE PREMIER (1 HERO FULL + DÚO 60/40) ──────────
function createPremierSequences(essays: typeof resolvedEssays) {
  const sequences: Array<{
    hero: typeof resolvedEssays[0];
    duo: typeof resolvedEssays;
  }> = [];
  
  for (let i = 0; i < essays.length; i += 3) {
    sequences.push({
      hero: essays[i],
      duo: essays.slice(i + 1, i + 3),
    });
  }
  return sequences;
}

---

<Layout title="Archivo General | The Great Puzzle Project">
  <InteriorHero
    title="ARCHIVO GENERAL"
    image={archiveCoverEssay?.img ?? null}
    imageAlt="Archivo General — The Great Puzzle Project"
    imagePosition={archiveCover?.position ?? 'center center'}
    eyebrow="Cartografía Epistémica · TGP"
    subtitle="Análisis multidisciplinario de investigaciones"
    titleClass="text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-cinzel font-extrabold tracking-tight leading-none gradient-acero-ios drop-shadow-2xl"
  >
    <div slot="meta" class="font-mono text-[10px] uppercase tracking-[0.3em] text-[#EFEBE3] font-bold">
      {publishable.length} DOSSIERS · {categories.length} CATEGORÍAS
    </div>
  </InteriorHero>

  {archiveSlides.length > 0 && (
    <CinematicPostEngine slides={archiveSlides} />
  )}

  <div class="min-h-screen pb-32 pt-12">
    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-12 md:gap-16">


      {/* ══════════════════════════════════════════════════════════════════
          SISTEMA DE SOLAPAS PRINCIPALES (TABS MINIMALISTAS)
      ══════════════════════════════════════════════════════════════════ */}
      <div class="flex items-center justify-between gap-4 border-b border-white/5 pb-5">
        <div class="flex items-center gap-2 sm:gap-3" role="tablist" aria-label="Modo de visualización del archivo">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="view-categories"
            id="tab-btn-categories"
            data-main-tab="categories"
            class="archive-main-tab-btn font-mono text-[10px] md:text-[11px] uppercase tracking-[0.25em] px-4 md:px-5 py-2 rounded-lg border border-rust-orange text-rust-orange bg-rust-orange/15 shadow-[0_0_18px_rgba(239, 235, 227,0.3)] font-bold cursor-pointer transition-all duration-300 flex items-center gap-2 hover:-translate-y-0.5"
          >
            <span class="tab-indicator w-2 h-2 rounded-full bg-rust-orange"></span>
            Por Categoría
          </button>
          
          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="view-years"
            id="tab-btn-years"
            data-main-tab="years"
            class="archive-main-tab-btn font-mono text-[10px] md:text-[11px] uppercase tracking-[0.25em] px-4 md:px-5 py-2 rounded-lg border border-white/10 text-white/50 bg-white/3 hover:border-rust-orange/60 hover:text-white hover:bg-white/10 hover:shadow-[0_0_14px_rgba(239, 235, 227,0.25)] cursor-pointer transition-all duration-300 flex items-center gap-2 hover:-translate-y-0.5"
          >
            <span class="tab-indicator w-2 h-2 rounded-full bg-white/30"></span>
            Por Año
          </button>
        </div>
      </div>

      {/* ══════════════════════════════════════════════════════════════════
          SOLAPA 1: ARCHIVO GENERAL POR CATEGORÍA
      ══════════════════════════════════════════════════════════════════ */}
      <div id="view-categories" role="tabpanel" aria-labelledby="tab-btn-categories" class="archive-view-panel flex flex-col gap-10">
        
        {/* ─── SERIE DE 4 CARDS DE CATEGORÍAS (CON IMÁGENES + FECHAS + CONTEO) ─── */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5 pb-4 border-b border-white/10">
          {categoryHighlightCards.map(card => (
            <button
              type="button"
              data-cat-filter-btn={card.catKey}
              class="cat-filter-btn group card-hover-cinematic relative overflow-hidden rounded-2xl border border-white/10 bg-[#151718]/90 text-left p-4 md:p-5 flex flex-col justify-end min-h-37.5 md:min-h-42.5 cursor-pointer transition-all duration-500"
            >
              {card.img && (
                <img
                  src={(card.img as any)?.src ?? card.img}
                  alt={card.catLabel}
                  class="absolute inset-0 w-full h-full object-cover brightness-[0.45] group-hover:scale-105 group-hover:brightness-[0.55] transition-all duration-700"
                />
              )}
              <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/40 to-transparent pointer-events-none" />
              <div class="relative z-10 flex flex-col gap-1">
                <span class="font-mono text-[8.5px] uppercase tracking-[0.25em] text-[#EFEBE3] font-bold">
                  {card.count} ARTÍCULO{card.count > 1 ? 'S' : ''} {card.yearLabel && `• ${card.yearLabel}`}
                </span>
                <h3 class="font-cinzel font-extrabold text-lg md:text-xl text-white tracking-wide uppercase group-hover:text-[#EFEBE3] transition-colors">
                  {card.catLabel}
                </h3>
              </div>
            </button>
          ))}
        </div>

        {/* Barra de Filtros Unificada de Archivo (Categoría + Tema) */}
        <div class="flex items-center gap-3 flex-wrap relative z-30 pb-3 border-b border-white/10">
          {/* Botón TODAS */}
          <button
            type="button"
            data-cat-filter-btn="all"
            class="cat-filter-btn font-mono text-[9.5px] uppercase tracking-[0.2em] px-4 py-2 rounded-xl border border-transparent text-[#EFEBE3] bg-transparent hover:border-[#EFEBE3] hover:bg-white/5 cursor-pointer transition-all duration-300 font-bold"
          >
            TODAS LAS INVESTIGACIONES ({publishable.length})
          </button>

          {/* Desplegable Unificado Categoría / Tema */}
          <div class="relative inline-block text-left">
            <select
              id="cat-linter-select"
              aria-label="Seleccionar categoría o tema de investigación"
              class="appearance-none font-mono text-[9.5px] uppercase tracking-[0.2em] px-4 py-2 pr-9 rounded-xl border border-white/10 text-[#EFEBE3] bg-[#151718]/90 hover:bg-[#EFEBE3]/10 hover:border-[#EFEBE3] cursor-pointer transition-all duration-300 outline-none font-bold"
            >
              <option value="all" class="bg-[#0a0a0a] text-white">POR CATEGORÍA / TEMA ▾</option>
              {categories.map(cat => (
                <option value={cat} class="bg-[#151718] text-[#EFEBE3]">
                  • {formatCategory(cat).toUpperCase()}
                </option>
              ))}
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-[#EFEBE3]">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
              </svg>
            </div>
          </div>
        </div>

        {/* Lista de Categorías con estructura cinemática: Post #1 Motor Cinemático Auto + 2 Amplias + Individuales 80/20 */}
        <section class="flex flex-col gap-16 md:gap-24" id="archive-list">
          {essaysByCategory.map(group => {
            const slideBatch = mapToSlideData(group.essays);
            const secondA = group.essays[1] ?? null;
            const secondB = group.essays[2] ?? null;
            const remainingEssays = group.essays.slice(3);

            return (
              <div class="category-block flex flex-col gap-8" data-category-group={group.catKey}>
                {/* Barra Editorial de Categoría */}
                <div class="editorial-bar flex items-center justify-between pb-2 border-b border-white/10">
                  <div class="flex items-center gap-3">
                    <span class="w-2 h-2 rounded-full bg-rust-orange shadow-[0_0_8px_#EFEBE3]" />
                    <h2 class="font-cinzel font-bold text-xl md:text-2xl tracking-wider text-white">
                      • {group.catLabel.toUpperCase()}
                    </h2>
                  </div>
                  <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-white/40">
                    {group.essays.length} DOSSIERES EN CATEGORÍA
                  </span>
                </div>

                {/* 1. Header Motor Cinemático (CinematicPostEngine.astro): Auto-batch de la Categoría */}
                <div class="w-full card-hover-cinematic overflow-hidden rounded-2xl md:rounded-3xl border border-white/8 shadow-2xl">
                  <CinematicPostEngine
                    slides={slideBatch}
                    heightClass="h-[400px] sm:h-[460px] md:h-[500px]"
                  />
                </div>

                {/* 2. Dos Cards Debajo También Amplias (Grid 2 Columnas) */}
                {(secondA || secondB) && (
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
                    {[secondA, secondB].filter(Boolean).map(e => e && (
                      <article class="card-hover-cinematic group relative overflow-hidden rounded-2xl border border-white/8 bg-[#151718]/90 flex flex-col justify-between min-h-85 md:min-h-95">
                        {e.img && (
                          <div class="relative overflow-hidden aspect-video md:aspect-16/10 w-full shrink-0">
                            <img
                              src={(e.img as any)?.src ?? e.img}
                              alt={e.entry.title || 'Dossier'}
                              class="w-full h-full object-cover transition-transform duration-700 delay-75 group-hover:scale-[1.018] brightness-85"
                              loading="lazy"
                            />
                            <div class="absolute inset-0 bg-linear-to-t from-[#151718]/90 via-transparent to-transparent pointer-events-none" />
                          </div>
                        )}
                        <div class="flex flex-col justify-between p-6 flex-1">
                          <div class="flex flex-col gap-2">
                            <span class="font-mono text-[8.5px] uppercase tracking-[0.3em] text-[#EFEBE3] font-bold">
                              {e.entry.category}
                            </span>
                            <h3 class="font-cinzel font-bold text-xl md:text-2xl leading-snug text-white group-hover:text-[#EFEBE3] transition-colors line-clamp-2">
                              <a href={`/papers/${e.slug}`}>{e.entry.title}</a>
                            </h3>
                            {e.entry.excerpt && (
                              <p class="font-serif italic text-white/60 text-xs md:text-sm line-clamp-2 mt-1">
                                "{e.entry.excerpt}"
                              </p>
                            )}
                          </div>
                          <div class="mt-5 pt-3 border-t border-white/5 flex items-center justify-between">
                            <a
                              href={`/papers/${e.slug}`}
                              class="inline-flex items-center gap-2 px-4 py-2 bg-[#1A1C1D]/90 border border-white/10 text-[#E0E0E0]/75 font-mono font-bold text-[8.5px] tracking-[0.25em] uppercase rounded-lg hover:bg-[#EFEBE3]/10 hover:border-[#EFEBE3]/45 hover:text-[#EFEBE3] transition-all"
                            >
                              <span>VER REGISTRO</span>
                              <span>▸</span>
                            </a>
                          </div>
                        </div>
                      </article>
                    ))}
                  </div>
                )}

                {/* 3. Posts Individuales Restantes (#4, #5, etc.): Proporción Uniforme 80/20 */}
                {remainingEssays.length > 0 && (
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 mt-2">
                    {remainingEssays.map(e => (
                      <article class="card-hover-cinematic group relative overflow-hidden rounded-2xl border border-white/8 bg-[#151718]/80 flex flex-col justify-between">
                        {/* 80% Viewport Imagen */}
                        {e.img && (
                          <div class="relative overflow-hidden aspect-video md:aspect-16/10 w-full shrink-0">
                            <img
                              src={(e.img as any)?.src ?? e.img}
                              alt={e.entry.title || 'Dossier'}
                              class="w-full h-full object-cover transition-transform duration-700 delay-75 group-hover:scale-[1.018] brightness-85"
                              loading="lazy"
                            />
                            <div class="absolute inset-0 bg-linear-to-t from-[#151718]/80 via-transparent to-transparent pointer-events-none" />
                          </div>
                        )}
                        {/* 20% Contenido Metadata */}
                        <div class="flex flex-col justify-between p-5 md:p-6 flex-1">
                          <div class="flex flex-col gap-2">
                            <span class="font-mono text-[8.5px] uppercase tracking-[0.3em] text-[#EFEBE3]/80 font-bold">
                              {e.entry.category}
                            </span>
                            <h4 class="font-cinzel font-bold text-lg md:text-xl leading-snug text-white group-hover:text-[#EFEBE3] transition-colors line-clamp-2">
                              <a href={`/papers/${e.slug}`}>{e.entry.title}</a>
                            </h4>
                          </div>
                          <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between">
                            <a
                              href={`/papers/${e.slug}`}
                              class="font-mono text-[8.5px] uppercase tracking-[0.25em] text-white/50 hover:text-[#EFEBE3] transition-colors flex items-center gap-1"
                            >
                              <span>VER REGISTRO</span>
                              <span>▸</span>
                            </a>
                          </div>
                        </div>
                      </article>
                    ))}
                  </div>
                )}
              </div>
            );
          })}
        </section>
      </div>

      {/* ══════════════════════════════════════════════════════════════════
          SOLAPA 2: ÍNDICE CRONOLÓGICO POR AÑO
      ══════════════════════════════════════════════════════════════════ */}
      {years.length > 0 && (
        <div id="view-years" role="tabpanel" aria-labelledby="tab-btn-years" class="archive-view-panel hidden flex-col gap-10">
          
          {/* Cabecera y Filtros de Año */}
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-white/10">
            {/* Desplegable Linter Selector de Años */}
            <div class="flex items-center gap-3 flex-wrap">
              <button
                type="button"
                data-year-filter-btn="all"
                class="year-filter-btn font-mono text-[9.5px] uppercase tracking-[0.2em] px-4 py-2 rounded-xl border border-transparent text-white/60 bg-transparent hover:border-rust-orange hover:text-white hover:bg-white/10 hover:shadow-[0_0_14px_rgba(239, 235, 227,0.3)] cursor-pointer transition-all duration-300"
              >
                Todos los Años
              </button>

              <div class="relative inline-block text-left">
                <select
                  id="year-linter-select"
                  aria-label="Seleccionar año de archivo"
                  class="appearance-none font-mono text-[9.5px] uppercase tracking-[0.2em] px-4 py-2 pr-9 rounded-xl border border-transparent text-rust-orange bg-transparent hover:bg-white/10 hover:border-rust-orange hover:shadow-[0_0_16px_rgba(239, 235, 227,0.35)] cursor-pointer transition-all duration-300 outline-none font-bold"
                >
                  <option value="all" class="bg-[#0a0a0a] text-white">AÑOS ▾</option>
                  {years.map(year => (
                    <option value={year} class="bg-(--bg-main) text-rust-orange">
                      • AÑO {year}
                    </option>
                  ))}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-rust-orange">
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                    <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
                  </svg>
                </div>
              </div>
            </div>
          </div>

          {/* Bloques Cronológicos por Año */}
          <section class="flex flex-col gap-20 md:gap-28" id="archive-yearly-cinematic">
            {years.map(year => {
              const yearEssays = resolvedEssays.filter(e =>
                e.entry.date && new Date(e.entry.date).getFullYear().toString() === year
              );
              const premierSequences = createPremierSequences(yearEssays);

              return (
                <div class="archive-year-cinematic-group flex flex-col gap-10 md:gap-14" data-year-group={year}>
                  {/* Divisor de Año Editorial con Amplio Tracking y Espacio Negativo */}
                  <div class="flex items-center justify-between border-b border-rust-orange/20 pb-4 pt-2">
                    <div class="flex items-center gap-3.5">
                      <span class="w-2 h-2 rounded-full bg-rust-orange shadow-[0_0_8px_#EFEBE3]" />
                      <h2 class="font-cinzel font-bold text-2xl md:text-3xl tracking-[0.15em] text-white">
                        AÑO {year}
                      </h2>
                    </div>
                  </div>

                  {/* Secuencias Cinematográficas Premier: 1 Hero Full Bleed + Dúo 60/40 con Cinemagraph */}
                  <div class="flex flex-col gap-16 md:gap-24">
                    {premierSequences.map((seq, seqIdx) => (
                      <div class="premier-sequence flex flex-col gap-8 md:gap-12">
                        {/* 1. Hero Cinemático Full Bleed */}
                        <div class="w-full">
                          <CinematicArchiveCard
                            slug={seq.hero.slug}
                            entry={seq.hero.entry}
                            img={seq.hero.img}
                            variant="hero"
                            enableCinemagraph={true}
                          />
                        </div>

                        {/* 2. Dúo de Films Secundarios con Aire, Espaciado y Proporción 60/40 */}
                        {seq.duo.length > 0 && (
                          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
                            {seq.duo[0] && (
                              <div class={seq.duo.length > 1 ? "lg:col-span-7 flex flex-col" : "lg:col-span-12 flex flex-col"}>
                                <CinematicArchiveCard
                                  slug={seq.duo[0].slug}
                                  entry={seq.duo[0].entry}
                                  img={seq.duo[0].img}
                                  variant={seq.duo.length > 1 ? "duo-60" : "hero"}
                                  enableCinemagraph={true}
                                />
                              </div>
                            )}

                            {seq.duo[1] && (
                              <div class="lg:col-span-5 flex flex-col">
                                <CinematicArchiveCard
                                  slug={seq.duo[1].slug}
                                  entry={seq.duo[1].entry}
                                  img={seq.duo[1].img}
                                  variant="duo-40"
                                  enableCinemagraph={true}
                                />
                              </div>
                            )}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
          </section>
        </div>
      )}

    </div>
  </div>

  <script>
    const setupArchiveTabsAndFilters = () => {
      const h1 = document.querySelector('h1');
      if (h1) setTimeout(() => h1.classList.add('revealed'), 200);

      const tabButtons = document.querySelectorAll<HTMLButtonElement>('.archive-main-tab-btn');
      const viewCategories = document.getElementById('view-categories');
      const viewYears = document.getElementById('view-years');

      const catFilterButtons = document.querySelectorAll<HTMLButtonElement>('.cat-filter-btn');
      const categoryBlocks = document.querySelectorAll<HTMLElement>('.category-block');

      const yearFilterButtons = document.querySelectorAll<HTMLButtonElement>('.year-filter-btn');
      const yearGroups = document.querySelectorAll<HTMLElement>('.archive-year-cinematic-group');

      const activeBtnClasses = ['border-[#EFEBE3]', 'text-[#EFEBE3]', 'bg-[#EFEBE3]/15', 'shadow-[0_0_18px_rgba(239, 235, 227,0.3)]', 'font-bold'];
      const inactiveBtnClasses = ['border-white/10', 'text-white/50', 'bg-white/3'];

      // Función para cambiar de solapa principal
      const switchTab = (tabName: 'categories' | 'years') => {
        tabButtons.forEach(btn => {
          const target = btn.getAttribute('data-main-tab');
          const indicator = btn.querySelector('.tab-indicator');
          const isActive = target === tabName;

          if (isActive) {
            btn.classList.remove(...inactiveBtnClasses);
            btn.classList.add(...activeBtnClasses);
            btn.setAttribute('aria-selected', 'true');
            if (indicator) {
              indicator.classList.remove('bg-white/30');
              indicator.classList.add('bg-[#EFEBE3]');
            }
          } else {
            btn.classList.remove(...activeBtnClasses);
            btn.classList.add(...inactiveBtnClasses);
            btn.setAttribute('aria-selected', 'false');
            if (indicator) {
              indicator.classList.remove('bg-[#EFEBE3]');
              indicator.classList.add('bg-white/30');
            }
          }
        });

        if (tabName === 'categories') {
          viewCategories?.classList.remove('hidden');
          viewYears?.classList.add('hidden');
        } else {
          viewCategories?.classList.add('hidden');
          viewYears?.classList.remove('hidden');
        }
      };

      const catSelectEl = document.getElementById('cat-linter-select') as HTMLSelectElement;
      const yearSelectEl = document.getElementById('year-linter-select') as HTMLSelectElement;

      // Función para filtrar categorías dentro de la solapa 1
      const filterCategories = (catValue: string) => {
        catFilterButtons.forEach(btn => {
          const val = btn.getAttribute('data-cat-filter-btn');
          const isActive = (catValue === 'all' && val === 'all') || val === catValue;
          if (isActive) {
            btn.classList.remove(...inactiveBtnClasses);
            btn.classList.add(...activeBtnClasses);
          } else {
            btn.classList.remove(...activeBtnClasses);
            btn.classList.add(...inactiveBtnClasses);
          }
        });

        if (catSelectEl && catSelectEl.value !== catValue) {
          catSelectEl.value = catValue;
        }

        categoryBlocks.forEach(block => {
          const blockCat = block.getAttribute('data-category-group');
          if (catValue === 'all' || blockCat === catValue) {
            block.style.display = '';
          } else {
            block.style.display = 'none';
          }
        });
      };

      // Función para filtrar años dentro de la solapa 2
      const filterYears = (yearValue: string) => {
        yearFilterButtons.forEach(btn => {
          const val = btn.getAttribute('data-year-filter-btn');
          const isActive = (yearValue === 'all' && val === 'all') || val === yearValue;
          if (isActive) {
            btn.classList.remove(...inactiveBtnClasses);
            btn.classList.add(...activeBtnClasses);
          } else {
            btn.classList.remove(...activeBtnClasses);
            btn.classList.add(...inactiveBtnClasses);
          }
        });

        if (yearSelectEl && yearSelectEl.value !== yearValue) {
          yearSelectEl.value = yearValue;
        }

        yearGroups.forEach(group => {
          const groupYear = group.getAttribute('data-year-group');
          if (yearValue === 'all' || groupYear === yearValue) {
            group.style.display = '';
          } else {
            group.style.display = 'none';
          }
        });
      };

      // Eventos para pestañas principales
      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetTab = (btn.getAttribute('data-main-tab') as 'categories' | 'years') || 'categories';
          switchTab(targetTab);
          
          if (targetTab === 'years') {
            history.replaceState(null, '', `?vista=ano`);
          } else {
            history.replaceState(null, '', `?vista=categoria`);
          }
        });
      });

      // Eventos para desplegable linter de categorías
      if (catSelectEl) {
        catSelectEl.addEventListener('change', (e) => {
          const val = (e.target as HTMLSelectElement).value;
          filterCategories(val);
          if (val === 'all') {
            history.replaceState(null, '', `?vista=categoria`);
          } else {
            history.replaceState(null, '', `?vista=categoria&categoria=${encodeURIComponent(val)}`);
          }
        });
      }

      // Eventos para desplegable linter de años
      if (yearSelectEl) {
        yearSelectEl.addEventListener('change', (e) => {
          const val = (e.target as HTMLSelectElement).value;
          filterYears(val);
          if (val === 'all') {
            history.replaceState(null, '', `?vista=ano`);
          } else {
            history.replaceState(null, '', `?vista=ano&año=${encodeURIComponent(val)}`);
          }
        });
      }

      // Eventos para botones rápidos de categoría
      catFilterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-cat-filter-btn') || 'all';
          filterCategories(val);
          if (val === 'all') {
            history.replaceState(null, '', `?vista=categoria`);
          } else {
            history.replaceState(null, '', `?vista=categoria&categoria=${encodeURIComponent(val)}`);
          }
        });
      });

      // Eventos para botones rápidos de año
      yearFilterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-year-filter-btn') || 'all';
          filterYears(val);
          if (val === 'all') {
            history.replaceState(null, '', `?vista=ano`);
          } else {
            history.replaceState(null, '', `?vista=ano&año=${encodeURIComponent(val)}`);
          }
        });
      });

      // Inicializar desde URL
      const params = new URLSearchParams(window.location.search);
      const vistaParam = params.get('vista');
      const catParam = params.get('categoria');
      const yearParam = params.get('año');

      if (vistaParam === 'ano' || vistaParam === 'año' || yearParam) {
        switchTab('years');
        if (yearParam) {
          filterYears(yearParam);
        }
      } else {
        switchTab('categories');
        if (catParam) {
          filterCategories(catParam.toLowerCase().trim());
        }
      }
    };

    document.addEventListener('DOMContentLoaded', setupArchiveTabsAndFilters);
    document.addEventListener('astro:page-load', setupArchiveTabsAndFilters);
  </script>
</Layout>
