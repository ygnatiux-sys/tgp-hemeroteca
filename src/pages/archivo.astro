---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import SpotifyIcon from '../components/icons/Spotify.astro';
import YouTubeIcon from '../components/icons/YouTube.astro';
import {
  getPublishableEssays,
  formatCategory,
  formatDate,
  formatYear,
  normalizeCategory,
  resolveEssayImage,
} from '../lib/content-filter';

// ─── CARGA Y FILTRADO CENTRALIZADO ───────────────────────────────────────────
const allEssaysRaw = await getCollection('ensayos').catch(err => {
  console.error("❌ [ARCHIVO] Falló carga de ensayos:", err);
  return [];
});

const isProd = import.meta.env.PROD;
const publishable = getPublishableEssays(allEssaysRaw, isProd);

// ─── CATEGORÍAS Y AÑOS REALES PARA FILTROS ───────────────────────────────────
const categories = [...new Set(
  publishable
    .map(e => normalizeCategory(e.entry.category))
    .filter(c => c !== 'ensayo')
)].sort();

const years = [...new Set(
  publishable
    .map(e => e.entry.date ? new Date(e.entry.date).getFullYear().toString() : '')
    .filter(Boolean)
)].sort((a, b) => Number(b) - Number(a));

// ─── CARGA DE IMÁGENES CON RESOLUCIÓN INTELIGENTE ─────────────────────────────
const resolvedEssays = publishable.map(e => ({
  ...e,
  img: resolveEssayImage(e.entry.coverImage, e.slug),
}));
---

<Layout title="Archivo General | The Great Puzzle Project">
  <div class="bg-theme-dark text-white min-h-screen selection:bg-[#C8A98B] selection:text-black pt-28 pb-32">

    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-12 md:gap-16">

      {/* ══════════════════════════════════════════════════════════════════
          CABECERA DEL ARCHIVO (§6.1)
          Sin hero cinematográfico. Función documental.
      ══════════════════════════════════════════════════════════════════ */}
      <header class="border-l border-[#C8A98B]/40 pl-6 md:pl-10">
        <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B] block mb-2">The Great Puzzle Project</span>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-serif tracking-tighter leading-none">Archivo</h1>
        <div class="reveal-item flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 mt-4">
          <p class="font-mono text-[10px] uppercase tracking-[0.3em] opacity-50">Hemeroteca completa de investigaciones</p>
          <div class="h-px w-16 bg-white/10 hidden sm:block" />
          <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-[#C8A98B]">
            {publishable.length} {publishable.length === 1 ? 'entrada' : 'entradas'}
          </p>
        </div>
      </header>

      {/* ══════════════════════════════════════════════════════════════════
          FILTROS (§6.2)
          Categorías y años reales con filtrado dinámico.
      ══════════════════════════════════════════════════════════════════ */}
      <nav aria-label="Filtros del archivo" class="flex flex-wrap items-center gap-2 md:gap-3 border-b border-white/5 pb-6">
        <span class="font-mono text-[9px] uppercase tracking-[0.3em] text-white/30 self-center mr-2 hidden sm:inline">Filtrar:</span>
        <button
          type="button"
          data-filter-btn="all"
          class="archive-filter-btn font-mono text-[9px] uppercase tracking-[0.2em] px-3 py-1.5 rounded-full border border-[#C8A98B]/50 text-[#C8A98B] bg-[#C8A98B]/10 cursor-pointer transition-all duration-300"
        >
          Todos
        </button>
        {categories.map(cat => (
          <button
            type="button"
            data-filter-btn="category"
            data-filter-value={cat}
            class="archive-filter-btn font-mono text-[9px] uppercase tracking-[0.2em] px-3 py-1.5 rounded-full border border-white/10 text-white/40 hover:border-[#C8A98B]/50 hover:text-[#C8A98B] cursor-pointer transition-all duration-300"
          >
            {formatCategory(cat)}
          </button>
        ))}
        {years.length > 0 && (
          <span class="font-mono text-[9px] uppercase tracking-[0.3em] text-white/20 self-center mx-1">|</span>
        )}
        {years.map(year => (
          <button
            type="button"
            data-filter-btn="year"
            data-filter-value={year}
            class="archive-filter-btn font-mono text-[9px] uppercase tracking-[0.2em] px-3 py-1.5 rounded-full border border-white/10 text-white/40 hover:border-[#C8A98B]/50 hover:text-[#C8A98B] cursor-pointer transition-all duration-300"
          >
            {year}
          </button>
        ))}
      </nav>

      {/* ══════════════════════════════════════════════════════════════════
          LISTA COMPLETA (§6.3)
          Tarjetas horizontales compactas: imagen 30–35% / texto 65–70%
      ══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-4" id="archive-list">
        {resolvedEssays.map(({ slug, entry, img }, index) => (
          <article
            class="archive-card group bg-white/3 border border-white/8 rounded-xl hover:border-[#C8A98B]/40 transition-all duration-400 overflow-hidden"
            data-category={normalizeCategory(entry.category)}
            data-year={formatYear(entry.date)}
          >
            <div class={img ? "flex flex-col md:flex-row" : "flex flex-col"}>
              {/* Imagen: 30–35% en desktop, full en mobile */}
              {img && (
                <div class="w-full md:w-[32%] shrink-0 overflow-hidden relative">
                  <div class="aspect-video md:aspect-auto md:h-full min-h-30">
                    <Image
                      src={img}
                      alt={entry.title || "Ensayo"}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80 group-hover:opacity-100"
                    />
                    <div class="absolute inset-0 bg-linear-to-r from-transparent to-theme-dark/30 pointer-events-none hidden md:block" />
                  </div>
                </div>
              )}

              {/* Texto: 65–70% en desktop */}
              <div class={`flex flex-col justify-between gap-3 p-5 md:p-6 flex-1 ${!img ? 'border-l-2 border-[#C8A98B]/20' : ''}`}>
                <div class="flex flex-col gap-2">
                  <div class="flex flex-wrap items-center gap-3 font-mono text-[9px] text-[#C8A98B] tracking-[0.2em] uppercase">
                    <span>{formatCategory(entry.category)}</span>
                    <span class="opacity-30">•</span>
                    <span class="text-white/40">{formatDate(entry.date)}</span>
                  </div>
                  <h2 class="text-lg md:text-xl font-serif leading-tight group-hover:text-[#C8A98B] transition-colors duration-300">
                    <a href={`/hemeroteca/${slug}`} class="hover:underline">{entry.title}</a>
                  </h2>
                  {entry.excerpt && (
                    <p class="font-serif text-white/55 text-sm leading-relaxed line-clamp-2 italic">
                      "{entry.excerpt}"
                    </p>
                  )}
                </div>

                <div class="flex items-center justify-between font-mono text-[9px] tracking-[0.3em] uppercase text-white/30 pt-3 border-t border-white/5">
                  <a href={`/hemeroteca/${slug}`} class="hover:text-[#C8A98B] transition-colors">
                    Registrum #{String(index + 1).padStart(2, '0')} →
                  </a>
                  {(entry.spotifyLink || entry.youtubeLink) && (
                    <div class="flex items-center gap-3">
                      {entry.spotifyLink && (
                        <a href={entry.spotifyLink} target="_blank" rel="noopener noreferrer" class="opacity-40 hover:opacity-100 hover:text-[#C8A98B] transition-all" aria-label="Spotify">
                          <SpotifyIcon class="w-3.5 h-3.5" />
                        </a>
                      )}
                      {entry.youtubeLink && (
                        <a href={entry.youtubeLink} target="_blank" rel="noopener noreferrer" class="opacity-40 hover:opacity-100 hover:text-[#C8A98B] transition-all" aria-label="YouTube">
                          <YouTubeIcon class="w-3.5 h-3.5" />
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </section>

      {/* ══════════════════════════════════════════════════════════════════
          ÍNDICE FINAL POR AÑO (§6.4)
          AÑO · CATEGORÍA · TÍTULO — agrupado por año.
      ══════════════════════════════════════════════════════════════════ */}
      {years.length > 0 && (
        <section class="flex flex-col gap-8 border-t border-white/5 pt-12" id="archive-yearly-index">
          <div class="reveal-item">
            <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B] block mb-2">Índice Cronológico</span>
            <h2 class="text-3xl md:text-4xl font-serif">Por Año</h2>
          </div>

          <div class="flex flex-col gap-8">
            {years.map(year => {
              const yearEssays = resolvedEssays.filter(e =>
                e.entry.date && new Date(e.entry.date).getFullYear().toString() === year
              );
              return (
                <div class="archive-year-group flex flex-col gap-0" data-year-group={year}>
                  <h3 class="font-mono text-[10px] uppercase tracking-[0.4em] text-white/30 pb-3 border-b border-white/5">
                    {year} — {yearEssays.length} {yearEssays.length === 1 ? 'entrada' : 'entradas'}
                  </h3>
                  <ol class="flex flex-col divide-y divide-white/5">
                    {yearEssays.map(({ slug, entry }) => (
                      <li class="archive-index-item" data-category={normalizeCategory(entry.category)}>
                        <a
                          href={`/hemeroteca/${slug}`}
                          class="group flex items-baseline gap-3 md:gap-6 py-2.5 hover:text-[#C8A98B] transition-colors duration-300"
                        >
                          <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-[#C8A98B]/60 shrink-0 hidden sm:inline">
                            {formatCategory(entry.category)}
                          </span>
                          <span class="font-serif text-sm md:text-base text-white/70 group-hover:text-[#C8A98B] transition-colors leading-snug line-clamp-1 flex-1">
                            {entry.title}
                          </span>
                          <span class="font-mono text-[9px] text-white/20 shrink-0 group-hover:text-[#C8A98B]/50">→</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              );
            })}
          </div>
        </section>
      )}

    </div>
  </div>

  <script>
    const setupArchiveFilter = () => {
      const h1 = document.querySelector('h1');
      if (h1) setTimeout(() => h1.classList.add('revealed'), 200);

      const buttons = document.querySelectorAll<HTMLButtonElement>('.archive-filter-btn');
      const cards = document.querySelectorAll<HTMLElement>('.archive-card');
      const indexItems = document.querySelectorAll<HTMLElement>('.archive-index-item');
      const yearGroups = document.querySelectorAll<HTMLElement>('.archive-year-group');

      if (!buttons.length) return;

      const activeClasses = ['border-[#C8A98B]/50', 'text-[#C8A98B]', 'bg-[#C8A98B]/10'];
      const inactiveClasses = ['border-white/10', 'text-white/40'];

      const applyFilter = (type: string, value?: string | null) => {
        // Actualizar estilos de botones
        buttons.forEach(btn => {
          const btnType = btn.getAttribute('data-filter-btn');
          const btnVal = btn.getAttribute('data-filter-value');
          const isActive = (type === 'all' && btnType === 'all') ||
                           (btnType === type && btnVal === value);

          if (isActive) {
            btn.classList.remove(...inactiveClasses);
            btn.classList.add(...activeClasses);
          } else {
            btn.classList.remove(...activeClasses);
            btn.classList.add(...inactiveClasses);
          }
        });

        // Filtrar tarjetas
        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          const cardYear = card.getAttribute('data-year');

          let show = true;
          if (type === 'category' && value) {
            show = cardCat === value;
          } else if (type === 'year' && value) {
            show = cardYear === value;
          }

          if (show) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });

        // Filtrar índice por año
        if (type === 'year' && value) {
          yearGroups.forEach(group => {
            if (group.getAttribute('data-year-group') === value) {
              group.style.display = '';
            } else {
              group.style.display = 'none';
            }
          });
        } else if (type === 'category' && value) {
          yearGroups.forEach(group => {
            let hasVisible = false;
            group.querySelectorAll<HTMLElement>('.archive-index-item').forEach(item => {
              if (item.getAttribute('data-category') === value) {
                item.style.display = '';
                hasVisible = true;
              } else {
                item.style.display = 'none';
              }
            });
            group.style.display = hasVisible ? '' : 'none';
          });
        } else {
          yearGroups.forEach(group => {
            group.style.display = '';
            group.querySelectorAll<HTMLElement>('.archive-index-item').forEach(item => {
              item.style.display = '';
            });
          });
        }
      };

      // Manejar clics
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const type = btn.getAttribute('data-filter-btn') || 'all';
          const value = btn.getAttribute('data-filter-value');

          if (type === 'all') {
            history.replaceState(null, '', window.location.pathname);
          } else if (type === 'category' && value) {
            history.replaceState(null, '', `?categoria=${encodeURIComponent(value)}`);
          } else if (type === 'year' && value) {
            history.replaceState(null, '', `?año=${encodeURIComponent(value)}`);
          }

          applyFilter(type, value);
        });
      });

      // Leer query params iniciales
      const params = new URLSearchParams(window.location.search);
      const initialCat = params.get('categoria');
      const initialYear = params.get('año');

      if (initialCat) {
        applyFilter('category', initialCat.toLowerCase().trim());
      } else if (initialYear) {
        applyFilter('year', initialYear);
      }
    };

    document.addEventListener('DOMContentLoaded', setupArchiveFilter);
    document.addEventListener('astro:page-load', setupArchiveFilter);
  </script>
</Layout>
