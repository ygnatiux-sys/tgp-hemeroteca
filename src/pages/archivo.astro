---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import SpotifyIcon from '../components/icons/Spotify.astro';
import YouTubeIcon from '../components/icons/YouTube.astro';
import {
  getPublishableEssays,
  formatCategory,
  formatDate,
  formatYear,
  normalizeCategory,
  resolveEssayImage,
} from '../lib/content-filter';

// ─── CARGA Y FILTRADO CENTRALIZADO ───────────────────────────────────────────
const allEssaysRaw = await getCollection('ensayos').catch(err => {
  console.error("[ARCHIVO] Falló carga de ensayos:", err);
  return [];
});

const isProd = import.meta.env.PROD;
const publishable = getPublishableEssays(allEssaysRaw, isProd);

// ─── CATEGORÍAS Y AÑOS REALES PARA FILTROS ───────────────────────────────────
const categories = [...new Set(
  publishable
    .map(e => normalizeCategory(e.entry.category))
    .filter(c => c !== 'ensayo')
)].sort();

const years = [...new Set(
  publishable
    .map(e => e.entry.date ? new Date(e.entry.date).getFullYear().toString() : '')
    .filter(Boolean)
)].sort((a, b) => Number(b) - Number(a));

// ─── CARGA DE IMÁGENES CON RESOLUCIÓN INTELIGENTE ─────────────────────────────
const resolvedEssays = publishable.map(e => ({
  ...e,
  img: resolveEssayImage(e.entry.coverImage, e.slug),
}));

// Agrupamiento por categorías para barras editoriales estilo suizo
const essaysByCategory = categories.map(cat => {
  const essays = resolvedEssays.filter(e => normalizeCategory(e.entry.category) === cat);
  return {
    catKey: cat,
    catLabel: formatCategory(cat),
    essays
  };
}).filter(group => group.essays.length > 0);

const categorizedSlugs = new Set(essaysByCategory.flatMap(g => g.essays.map(e => e.slug)));
const uncategorized = resolvedEssays.filter(e => !categorizedSlugs.has(e.slug));
if (uncategorized.length > 0) {
  essaysByCategory.push({
    catKey: 'otros',
    catLabel: 'Otras Investigaciones',
    essays: uncategorized
  });
}
---

<Layout title="Archivo General | The Great Puzzle Project">
  <div class="bg-theme-dark text-white min-h-screen selection:bg-[#C8A98B] selection:text-black pt-28 pb-32">

    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-12 md:gap-16">

      {/* ══════════════════════════════════════════════════════════════════
          CABECERA HERO CINEMATOGRÁFICA DEL ARCHIVO GENERAL
      ══════════════════════════════════════════════════════════════════ */}
      <header class="relative w-full flex flex-col justify-end pt-8 pb-10 border-b border-white/10">
        <nav class="mb-4 flex items-center gap-3 font-mono text-[9px] uppercase tracking-[0.3em] text-white/40">
          <a href="/" class="hover:text-[#C8A98B] transition-colors">Hemeroteca</a>
          <span>/</span>
          <span class="text-[#C8A98B]">Archivo General</span>
        </nav>

        {/* H1 CON CINZEL EXTRABOLD Y GRADIENTE ACERO iOS STYLE */}
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-cinzel font-extrabold tracking-tight leading-none mb-4 gradient-acero-ios drop-shadow-2xl">
          ARCHIVO GENERAL
        </h1>

        {/* H2 CON SANS OUTFIT / JAKARTA THIN Y LETTER-SPACING AMPIO */}
        <h2 class="text-xl md:text-2xl lg:text-3xl h2-thin-hook text-white/70 max-w-4xl leading-relaxed">
          CARTOGRAFÍA EPISTÉMICA & ANÁLISIS MULTIDISCIPLINARIO DE INVESTIGACIONES
        </h2>

        <div class="flex flex-wrap items-center gap-4 mt-6 pt-6 border-t border-white/10">
          <span class="px-3.5 py-1 bg-white/10 backdrop-blur-md rounded-full border border-white/15 font-mono text-[10px] uppercase tracking-[0.3em] text-[#C8A98B] font-bold">
            {publishable.length} {publishable.length === 1 ? 'dossier acopiado' : 'dossieres acopiados'}
          </span>
          <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-white/40">
            Arqueosemiótica · Semiótica Cultural · Geocultura · Hermenéutica · Epistemología
          </span>
        </div>
      </header>

      {/* ══════════════════════════════════════════════════════════════════
          FILTROS (§6.2)
          Sistema de Hover Linter / Menu Bar con Hover Hype de Selección
      ══════════════════════════════════════════════════════════════════ */}
      <nav aria-label="Filtros del archivo" class="flex flex-wrap items-center gap-2 md:gap-2.5 border-b border-white/10 pb-6">
        <span class="font-mono text-[9px] uppercase tracking-[0.3em] text-[#C8A98B] font-bold self-center mr-2 hidden sm:inline-flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C8A98B] animate-pulse"></span>
          Filtrar:
        </span>
        <button
          type="button"
          data-filter-btn="all"
          class="archive-filter-btn font-mono text-[9px] uppercase tracking-[0.2em] px-3.5 py-1.5 rounded-lg border border-[#C8A98B] text-[#C8A98B] bg-[#C8A98B]/15 shadow-[0_0_16px_rgba(200,169,139,0.3)] font-bold cursor-pointer transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_0_18px_rgba(200,169,139,0.4)]"
        >
          Todos
        </button>
        {categories.map(cat => (
          <button
            type="button"
            data-filter-btn="category"
            data-filter-value={cat}
            class="archive-filter-btn font-mono text-[9px] uppercase tracking-[0.2em] px-3.5 py-1.5 rounded-lg border border-white/10 text-white/50 bg-white/3 hover:border-[#C8A98B]/60 hover:text-white hover:bg-white/10 hover:shadow-[0_0_14px_rgba(200,169,139,0.25)] hover:-translate-y-0.5 cursor-pointer transition-all duration-300"
          >
            {formatCategory(cat)}
          </button>
        ))}
        {years.length > 0 && (
          <span class="font-mono text-[9px] uppercase tracking-[0.3em] text-white/20 self-center mx-1">|</span>
        )}
        {years.map(year => (
          <button
            type="button"
            data-filter-btn="year"
            data-filter-value={year}
            class="archive-filter-btn font-mono text-[9px] uppercase tracking-[0.2em] px-3.5 py-1.5 rounded-lg border border-white/10 text-white/50 bg-white/3 hover:border-[#C8A98B]/60 hover:text-white hover:bg-white/10 hover:shadow-[0_0_14px_rgba(200,169,139,0.25)] hover:-translate-y-0.5 cursor-pointer transition-all duration-300"
          >
            {year}
          </button>
        ))}
      </nav>

      {/* ══════════════════════════════════════════════════════════════════
          LISTA CINEMATOGRÁFICA POR CATEGORÍAS EN GRILLA 2 COLUMNAS (§6.3)
      ══════════════════════════════════════════════════════════════════ */}
      <section class="flex flex-col gap-16" id="archive-list">
        {essaysByCategory.map(group => (
          <div class="category-block flex flex-col gap-6" data-category-group={group.catKey}>
            {/* Barra Editorial de Categoría con Estilo Cinzel y Gradiente Acero */}
            <div class="editorial-bar flex items-center justify-between border-b border-[#C8A98B]/30 pb-3">
              <div class="flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-[#C8A98B] shadow-[0_0_8px_#C8A98B]" />
                <h2 class="font-cinzel font-bold text-lg md:text-2xl tracking-wider bg-linear-to-r from-white via-[#E2E8F0] to-[#94A3B8] bg-clip-text text-transparent drop-shadow-md">
                  {group.catLabel}
                </h2>
              </div>
              <span class="font-mono text-[9px] uppercase tracking-[0.3em] text-[#C8A98B]/80 font-bold">
                {group.essays.length} {group.essays.length === 1 ? 'dossier acopiado' : 'dossieres acopiados'}
              </span>
            </div>

            {/* Grilla Cinematográfica de 2 Columnas */}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {group.essays.map(({ slug, entry, img }, index) => {
                const sitio = (entry as any).sitioGeohistorico;
                return (
                  <article
                    class="archive-card group flex flex-col bg-white/3 border border-white/10 rounded-2xl overflow-hidden hover:border-[#C8A98B]/50 transition-all duration-500 shadow-xl"
                    data-category={normalizeCategory(entry.category)}
                    data-year={formatYear(entry.date)}
                  >
                    {/* Imagen Portada Cinematográfica 16:9 */}
                    {img ? (
                      <div class="relative overflow-hidden aspect-video bg-black/40">
                        <Image
                          src={img}
                          alt={entry.title || "Ensayo del Archivo"}
                          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-85 group-hover:opacity-100"
                        />
                        <div class="absolute inset-0 bg-linear-to-t from-theme-dark/90 via-transparent to-transparent pointer-events-none" />
                        {sitio && (
                          <div class="absolute bottom-4 left-4 z-10">
                            <span class="px-2.5 py-1 bg-black/70 backdrop-blur-md rounded-md border border-white/20 font-mono text-[9px] uppercase tracking-[0.2em] text-[#C8A98B]">
                              {sitio}
                            </span>
                          </div>
                        )}
                      </div>
                    ) : (
                      <div class="relative overflow-hidden aspect-video bg-linear-to-br from-[#1b2326] via-theme-dark to-[#0c0d0d] flex items-center justify-center border-b border-white/5">
                        <div class="font-cinzel text-3xl text-[#C8A98B]/30 tracking-widest">TGP ARCHIVE</div>
                      </div>
                    )}

                    {/* Cuerpo de la Tarjeta */}
                    <div class="p-7 md:p-8 flex flex-col justify-between flex-1 gap-5">
                      <div class="flex flex-col gap-3">
                        <div class="flex items-center justify-between font-mono text-[9px] text-[#C8A98B] tracking-[0.2em] uppercase">
                          <span>{formatCategory(entry.category)}</span>
                          <span class="text-white/40">{formatYear(entry.date)}</span>
                        </div>

                        <h3 class="font-cinzel font-bold text-xl md:text-2xl leading-tight group-hover:text-[#C8A98B] transition-colors duration-300">
                          <a href={`/hemeroteca/${slug}`} class="hover:underline">
                            {entry.title}
                          </a>
                        </h3>

                        {entry.excerpt && (
                          <p class="font-serif text-white/70 text-sm md:text-base leading-relaxed line-clamp-3 italic">
                            "{entry.excerpt}"
                          </p>
                        )}
                      </div>

                      <div class="pt-4 border-t border-white/5 flex items-center justify-between font-mono text-[9px] uppercase tracking-[0.3em] text-white/40">
                        <a href={`/hemeroteca/${slug}`} class="hover:text-[#C8A98B] transition-colors inline-flex items-center gap-2">
                          Explorar Dossier →
                        </a>
                        {(entry.spotifyLink || entry.youtubeLink) && (
                          <div class="flex items-center gap-3">
                            {entry.spotifyLink && (
                              <a href={entry.spotifyLink} target="_blank" rel="noopener noreferrer" class="opacity-40 hover:opacity-100 hover:text-[#C8A98B] transition-all" aria-label="Spotify">
                                <SpotifyIcon class="w-3.5 h-3.5" />
                              </a>
                            )}
                            {entry.youtubeLink && (
                              <a href={entry.youtubeLink} target="_blank" rel="noopener noreferrer" class="opacity-40 hover:opacity-100 hover:text-[#C8A98B] transition-all" aria-label="YouTube">
                                <YouTubeIcon class="w-3.5 h-3.5" />
                              </a>
                            )}
                          </div>
                        )}
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        ))}
      </section>

      {/* ══════════════════════════════════════════════════════════════════
          ÍNDICE CRONOLÓGICO POR AÑO CON MINIATURAS EDITORIALES (§6.4)
          Mapeo de estilo idéntico a 'Del Archivo' del Inicio
      ══════════════════════════════════════════════════════════════════ */}
      {years.length > 0 && (
        <section class="flex flex-col gap-8 border-t border-white/10 pt-14" id="archive-yearly-index">
          <div class="reveal-item flex items-end justify-between border-b border-white/10 pb-4">
            <div>
              <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B] block mb-1">Índice Cronológico</span>
              <h2 class="text-3xl md:text-4xl font-cinzel font-extrabold tracking-tight">Por Año</h2>
            </div>
            <span class="font-mono text-[9px] text-white/40 tracking-[0.2em]">
              Catálogo Histórico Rankeado
            </span>
          </div>

          <div class="flex flex-col gap-10">
            {years.map(year => {
              const yearEssays = resolvedEssays.filter(e =>
                e.entry.date && new Date(e.entry.date).getFullYear().toString() === year
              );
              return (
                <div class="archive-year-group flex flex-col gap-4" data-year-group={year}>
                  <div class="flex items-center gap-3 border-b border-white/5 pb-2">
                    <span class="w-2 h-2 rounded-full bg-[#C8A98B]" />
                    <h3 class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B] font-bold">
                      {year} — {yearEssays.length} {yearEssays.length === 1 ? 'dossier' : 'dossieres'}
                    </h3>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {yearEssays.map(({ slug, entry, img }) => (
                      <article class="archive-index-item" data-category={normalizeCategory(entry.category)}>
                        <a
                          href={`/hemeroteca/${slug}`}
                          class="group flex items-center gap-4 p-3.5 md:p-4 bg-white/3 border border-white/8 rounded-xl hover:border-[#C8A98B]/50 hover:bg-white/5 transition-all duration-400 overflow-hidden"
                        >
                          {img ? (
                            <div class="w-16 h-12 md:w-20 md:h-14 shrink-0 overflow-hidden rounded-lg bg-black/40 aspect-video relative">
                              <Image src={img} alt={entry.title || "Ensayo"} class="w-full h-full object-cover opacity-85 group-hover:scale-105 group-hover:opacity-100 transition-all duration-500" />
                            </div>
                          ) : (
                            <div class="w-16 h-12 md:w-20 md:h-14 shrink-0 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center font-mono text-[9px] text-[#C8A98B]">
                              TGP
                            </div>
                          )}
                          <div class="flex flex-col gap-1 min-w-0 flex-1">
                            <div class="flex items-center gap-2 font-mono text-[9px] text-[#C8A98B] tracking-[0.2em] uppercase">
                              <span>{formatCategory(entry.category)}</span>
                              <span class="opacity-30">•</span>
                              <span class="text-white/40 tabular-nums">{formatYear(entry.date)}</span>
                            </div>
                            <h4 class="font-cinzel text-sm md:text-base text-white/90 group-hover:text-[#C8A98B] transition-colors leading-snug line-clamp-1">
                              {entry.title}
                            </h4>
                            {entry.excerpt && (
                              <p class="font-serif text-xs text-white/50 line-clamp-1 font-light tracking-wide italic">
                                "{entry.excerpt}"
                              </p>
                            )}
                          </div>
                          <span class="font-mono text-[10px] text-white/20 group-hover:text-[#C8A98B] transition-colors shrink-0 pr-1">→</span>
                        </a>
                      </article>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      )}

    </div>
  </div>

  <script>
    const setupArchiveFilter = () => {
      const h1 = document.querySelector('h1');
      if (h1) setTimeout(() => h1.classList.add('revealed'), 200);

      const buttons = document.querySelectorAll<HTMLButtonElement>('.archive-filter-btn');
      const categoryBlocks = document.querySelectorAll<HTMLElement>('.category-block');
      const cards = document.querySelectorAll<HTMLElement>('.archive-card');
      const yearGroups = document.querySelectorAll<HTMLElement>('.archive-year-group');

      if (!buttons.length) return;

      const activeClasses = ['border-[#C8A98B]', 'text-[#C8A98B]', 'bg-[#C8A98B]/15', 'shadow-[0_0_16px_rgba(200,169,139,0.3)]', 'font-bold'];
      const inactiveClasses = ['border-white/10', 'text-white/50', 'bg-white/3'];

      const applyFilter = (type: string, value?: string | null) => {
        // Actualizar botones
        buttons.forEach(btn => {
          const btnType = btn.getAttribute('data-filter-btn');
          const btnVal = btn.getAttribute('data-filter-value');
          const isActive = (type === 'all' && btnType === 'all') ||
                           (btnType === type && btnVal === value);

          if (isActive) {
            btn.classList.remove(...inactiveClasses);
            btn.classList.add(...activeClasses);
          } else {
            btn.classList.remove(...activeClasses);
            btn.classList.add(...inactiveClasses);
          }
        });

        // Filtrar bloques por categoría y tarjetas
        categoryBlocks.forEach(block => {
          const blockCat = block.getAttribute('data-category-group');
          let blockHasVisible = false;

          block.querySelectorAll<HTMLElement>('.archive-card').forEach(card => {
            const cardCat = card.getAttribute('data-category');
            const cardYear = card.getAttribute('data-year');

            let show = true;
            if (type === 'category' && value) {
              show = cardCat === value;
            } else if (type === 'year' && value) {
              show = cardYear === value;
            }

            if (show) {
              card.style.display = '';
              blockHasVisible = true;
            } else {
              card.style.display = 'none';
            }
          });

          if (type === 'category' && value) {
            block.style.display = (blockCat === value) ? '' : 'none';
          } else {
            block.style.display = blockHasVisible ? '' : 'none';
          }
        });

        // Filtrar índice por año
        if (type === 'year' && value) {
          yearGroups.forEach(group => {
            if (group.getAttribute('data-year-group') === value) {
              group.style.display = '';
            } else {
              group.style.display = 'none';
            }
          });
        } else if (type === 'category' && value) {
          yearGroups.forEach(group => {
            let hasVisible = false;
            group.querySelectorAll<HTMLElement>('.archive-index-item').forEach(item => {
              if (item.getAttribute('data-category') === value) {
                item.style.display = '';
                hasVisible = true;
              } else {
                item.style.display = 'none';
              }
            });
            group.style.display = hasVisible ? '' : 'none';
          });
        } else {
          yearGroups.forEach(group => {
            group.style.display = '';
            group.querySelectorAll<HTMLElement>('.archive-index-item').forEach(item => {
              item.style.display = '';
            });
          });
        }
      };

      // Manejar clics
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const type = btn.getAttribute('data-filter-btn') || 'all';
          const value = btn.getAttribute('data-filter-value');

          if (type === 'all') {
            history.replaceState(null, '', window.location.pathname);
          } else if (type === 'category' && value) {
            history.replaceState(null, '', `?categoria=${encodeURIComponent(value)}`);
          } else if (type === 'year' && value) {
            history.replaceState(null, '', `?año=${encodeURIComponent(value)}`);
          }

          applyFilter(type, value);
        });
      });

      // Leer query params iniciales
      const params = new URLSearchParams(window.location.search);
      const initialCat = params.get('categoria');
      const initialYear = params.get('año');

      if (initialCat) {
        applyFilter('category', initialCat.toLowerCase().trim());
      } else if (initialYear) {
        applyFilter('year', initialYear);
      }
    };

    document.addEventListener('DOMContentLoaded', setupArchiveFilter);
    document.addEventListener('astro:page-load', setupArchiveFilter);
  </script>
</Layout>
