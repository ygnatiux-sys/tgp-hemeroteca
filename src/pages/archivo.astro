---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CinematicArchiveCard from '../components/CinematicArchiveCard.astro';
import {
  getPublishableEssays,
  formatCategory,
  formatDate,
  formatYear,
  normalizeCategory,
  resolveEssayImage,
} from '../lib/content-filter';

// ─── CARGA Y FILTRADO CENTRALIZADO ───────────────────────────────────────────
const allEssaysRaw = await getCollection('ensayos').catch(err => {
  console.error("[ARCHIVO] Falló carga de ensayos:", err);
  return [];
});

const allArquetiposRaw = await getCollection('arquetiposGlobales').catch(() => []);

const isProd = import.meta.env.PROD;
const publishableEssays = getPublishableEssays(allEssaysRaw, isProd);
const publishableArquetipos = getPublishableEssays(allArquetiposRaw, isProd);

const publishable = [...publishableEssays, ...publishableArquetipos].sort((a, b) => {
  const dateA = a.entry.date ? new Date(a.entry.date).getTime() : 0;
  const dateB = b.entry.date ? new Date(b.entry.date).getTime() : 0;
  return dateB - dateA;
});

// ─── CATEGORÍAS Y AÑOS REALES PARA FILTROS ───────────────────────────────────
const categories = [...new Set(
  publishable
    .map(e => normalizeCategory(e.entry.category))
    .filter(c => c !== 'ensayo')
)].sort();

const years = [...new Set(
  publishable
    .map(e => e.entry.date ? new Date(e.entry.date).getFullYear().toString() : '')
    .filter(Boolean)
)].sort((a, b) => Number(b) - Number(a));

// ─── CARGA DE IMÁGENES CON RESOLUCIÓN INTELIGENTE ─────────────────────────────
const resolvedEssays = publishable.map(e => ({
  ...e,
  img: resolveEssayImage(e.entry.coverImage, e.slug),
}));

// Agrupamiento por categorías para barras editoriales estilo suizo
const essaysByCategory = categories.map(cat => {
  const essays = resolvedEssays.filter(e => normalizeCategory(e.entry.category) === cat);
  return {
    catKey: cat,
    catLabel: formatCategory(cat),
    essays
  };
}).filter(group => group.essays.length > 0);

const categorizedSlugs = new Set(essaysByCategory.flatMap(g => g.essays.map(e => e.slug)));
const uncategorized = resolvedEssays.filter(e => !categorizedSlugs.has(e.slug));
if (uncategorized.length > 0) {
  essaysByCategory.push({
    catKey: 'otros',
    catLabel: 'Otras Investigaciones',
    essays: uncategorized
  });
}

// ─── HELPER PARA SECUENCIAS CINE PREMIER (1 HERO FULL + DÚO 60/40) ──────────
function createPremierSequences(essays: typeof resolvedEssays) {
  const sequences: Array<{
    hero: typeof resolvedEssays[0];
    duo: typeof resolvedEssays;
  }> = [];
  
  for (let i = 0; i < essays.length; i += 3) {
    sequences.push({
      hero: essays[i],
      duo: essays.slice(i + 1, i + 3),
    });
  }
  return sequences;
}
---

<Layout title="Archivo General | The Great Puzzle Project">
  <div class="bg-theme-dark text-white min-h-screen selection:bg-[#C8A98B] selection:text-black pt-28 pb-32">

    <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 flex flex-col gap-12 md:gap-16">

      {/* ══════════════════════════════════════════════════════════════════
          CABECERA HERO CINEMATOGRÁFICA DEL ARCHIVO GENERAL (MINIMALISTA)
      ══════════════════════════════════════════════════════════════════ */}
      <header class="relative w-full flex flex-col justify-end pt-8 pb-8 border-b border-white/10">
        <nav class="mb-4 flex items-center gap-3 font-mono text-[9px] uppercase tracking-[0.3em] text-white/40">
          <a href="/" class="hover:text-white transition-colors">Hemeroteca</a>
          <span>/</span>
          <span class="text-[#C8A98B]">Archivo General</span>
        </nav>

        {/* H1 CON CINZEL EXTRABOLD Y GRADIENTE ACERO iOS STYLE */}
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-cinzel font-extrabold tracking-tight leading-none mb-4 gradient-acero-ios drop-shadow-2xl">
          ARCHIVO GENERAL
        </h1>

        {/* H2 CON SANS OUTFIT / JAKARTA THIN Y LETTER-SPACING AMPLIO */}
        <h2 class="text-xl md:text-2xl lg:text-3xl h2-thin-hook text-white/70 max-w-4xl leading-relaxed">
          CARTOGRAFÍA EPISTÉMICA & ANÁLISIS MULTIDISCIPLINARIO DE INVESTIGACIONES
        </h2>
      </header>

      {/* ══════════════════════════════════════════════════════════════════
          SISTEMA DE SOLAPAS PRINCIPALES (TABS MINIMALISTAS)
      ══════════════════════════════════════════════════════════════════ */}
      <div class="flex items-center justify-between gap-4 border-b border-white/10 pb-5">
        <div class="flex items-center gap-2 sm:gap-3" role="tablist" aria-label="Modo de visualización del archivo">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="view-categories"
            id="tab-btn-categories"
            data-main-tab="categories"
            class="archive-main-tab-btn font-mono text-[10px] md:text-[11px] uppercase tracking-[0.25em] px-4 md:px-5 py-2 rounded-lg border border-[#C8A98B] text-[#C8A98B] bg-[#C8A98B]/15 shadow-[0_0_18px_rgba(200,169,139,0.3)] font-bold cursor-pointer transition-all duration-300 flex items-center gap-2 hover:-translate-y-0.5"
          >
            <span class="tab-indicator w-2 h-2 rounded-full bg-[#C8A98B]"></span>
            Por Categoría
          </button>
          
          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="view-years"
            id="tab-btn-years"
            data-main-tab="years"
            class="archive-main-tab-btn font-mono text-[10px] md:text-[11px] uppercase tracking-[0.25em] px-4 md:px-5 py-2 rounded-lg border border-white/10 text-white/50 bg-white/3 hover:border-[#C8A98B]/60 hover:text-white hover:bg-white/10 hover:shadow-[0_0_14px_rgba(200,169,139,0.25)] cursor-pointer transition-all duration-300 flex items-center gap-2 hover:-translate-y-0.5"
          >
            <span class="tab-indicator w-2 h-2 rounded-full bg-white/30"></span>
            Por Año
          </button>
        </div>
      </div>

      {/* ══════════════════════════════════════════════════════════════════
          SOLAPA 1: ARCHIVO GENERAL POR CATEGORÍA
      ══════════════════════════════════════════════════════════════════ */}
      <div id="view-categories" role="tabpanel" aria-labelledby="tab-btn-categories" class="archive-view-panel flex flex-col gap-10">
        
        {/* Barra de Filtros de Categoría con Desplegable Linter Elegante */}
        <div class="flex items-center gap-3 flex-wrap relative z-30 pb-3 border-b border-white/10">
          {/* Botón Rápido TODAS */}
          <button
            type="button"
            data-cat-filter-btn="all"
            class="cat-filter-btn font-mono text-[9.5px] uppercase tracking-[0.2em] px-4 py-2 rounded-xl border border-transparent text-white/60 bg-transparent hover:border-[#C8A98B] hover:text-white hover:bg-white/10 hover:shadow-[0_0_14px_rgba(200,169,139,0.3)] cursor-pointer transition-all duration-300"
          >
            Todas ({publishable.length})
          </button>

          {/* Desplegable Linter Selector de Categorías */}
          <div class="relative inline-block text-left">
            <select
              id="cat-linter-select"
              aria-label="Seleccionar categoría de investigación"
              class="appearance-none font-mono text-[9.5px] uppercase tracking-[0.2em] px-4 py-2 pr-9 rounded-xl border border-transparent text-[#C8A98B] bg-transparent hover:bg-white/10 hover:border-[#C8A98B] hover:shadow-[0_0_16px_rgba(200,169,139,0.35)] cursor-pointer transition-all duration-300 outline-none font-bold"
            >
              <option value="all" class="bg-[#0a0a0a] text-white">CATEGORÍAS ▾</option>
              {categories.map(cat => (
                <option value={cat} class="bg-[#0a0a0a] text-[#C8A98B]">
                  • {formatCategory(cat).toUpperCase()}
                </option>
              ))}
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-[#C8A98B]">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
              </svg>
            </div>
          </div>
        </div>

        {/* Lista de Categorías en Grilla 2 Columnas */}
        <section class="flex flex-col gap-16" id="archive-list">
          {essaysByCategory.map(group => (
            <div class="category-block flex flex-col gap-6" data-category-group={group.catKey}>
              {/* Barra Editorial de Categoría */}
              <div class="editorial-bar flex items-center justify-between border-b border-[#C8A98B]/20 pb-3">
                <div class="flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-[#C8A98B] shadow-[0_0_8px_#C8A98B]" />
                  <h2 class="font-cinzel font-bold text-lg md:text-2xl tracking-wider bg-linear-to-r from-white via-[#E2E8F0] to-[#94A3B8] bg-clip-text text-transparent drop-shadow-md">
                    {group.catLabel}
                  </h2>
                </div>
              </div>

              {/* Grilla de 2 Columnas con Formato Cinemático */}
              <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {group.essays.map(({ slug, entry, img }) => (
                  <CinematicArchiveCard
                    slug={slug}
                    entry={entry}
                    img={img}
                    variant="standard"
                    enableCinemagraph={false}
                  />
                ))}
              </div>
            </div>
          ))}
        </section>
      </div>

      {/* ══════════════════════════════════════════════════════════════════
          SOLAPA 2: ÍNDICE CRONOLÓGICO POR AÑO
      ══════════════════════════════════════════════════════════════════ */}
      {years.length > 0 && (
        <div id="view-years" role="tabpanel" aria-labelledby="tab-btn-years" class="archive-view-panel hidden flex-col gap-10">
          
          {/* Cabecera y Filtros de Año */}
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-white/10">
            {/* Desplegable Linter Selector de Años */}
            <div class="flex items-center gap-3 flex-wrap">
              <button
                type="button"
                data-year-filter-btn="all"
                class="year-filter-btn font-mono text-[9.5px] uppercase tracking-[0.2em] px-4 py-2 rounded-xl border border-transparent text-white/60 bg-transparent hover:border-[#C8A98B] hover:text-white hover:bg-white/10 hover:shadow-[0_0_14px_rgba(200,169,139,0.3)] cursor-pointer transition-all duration-300"
              >
                Todos los Años
              </button>

              <div class="relative inline-block text-left">
                <select
                  id="year-linter-select"
                  aria-label="Seleccionar año de archivo"
                  class="appearance-none font-mono text-[9.5px] uppercase tracking-[0.2em] px-4 py-2 pr-9 rounded-xl border border-transparent text-[#C8A98B] bg-transparent hover:bg-white/10 hover:border-[#C8A98B] hover:shadow-[0_0_16px_rgba(200,169,139,0.35)] cursor-pointer transition-all duration-300 outline-none font-bold"
                >
                  <option value="all" class="bg-[#0a0a0a] text-white">AÑOS ▾</option>
                  {years.map(year => (
                    <option value={year} class="bg-[#0a0a0a] text-[#C8A98B]">
                      • AÑO {year}
                    </option>
                  ))}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-[#C8A98B]">
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                    <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
                  </svg>
                </div>
              </div>
            </div>
          </div>

          {/* Bloques Cronológicos por Año */}
          <section class="flex flex-col gap-20 md:gap-28" id="archive-yearly-cinematic">
            {years.map(year => {
              const yearEssays = resolvedEssays.filter(e =>
                e.entry.date && new Date(e.entry.date).getFullYear().toString() === year
              );
              const premierSequences = createPremierSequences(yearEssays);

              return (
                <div class="archive-year-cinematic-group flex flex-col gap-10 md:gap-14" data-year-group={year}>
                  {/* Divisor de Año Editorial con Amplio Tracking y Espacio Negativo */}
                  <div class="flex items-center justify-between border-b border-[#C8A98B]/20 pb-4 pt-2">
                    <div class="flex items-center gap-3.5">
                      <span class="w-2 h-2 rounded-full bg-[#C8A98B] shadow-[0_0_8px_#C8A98B]" />
                      <h2 class="font-cinzel font-bold text-2xl md:text-3xl tracking-[0.15em] text-white">
                        AÑO {year}
                      </h2>
                    </div>
                  </div>

                  {/* Secuencias Cinematográficas Premier: 1 Hero Full Bleed + Dúo 60/40 con Cinemagraph */}
                  <div class="flex flex-col gap-16 md:gap-24">
                    {premierSequences.map((seq, seqIdx) => (
                      <div class="premier-sequence flex flex-col gap-8 md:gap-12">
                        {/* 1. Hero Cinemático Full Bleed */}
                        <div class="w-full">
                          <CinematicArchiveCard
                            slug={seq.hero.slug}
                            entry={seq.hero.entry}
                            img={seq.hero.img}
                            variant="hero"
                            enableCinemagraph={true}
                          />
                        </div>

                        {/* 2. Dúo de Films Secundarios con Aire, Espaciado y Proporción 60/40 */}
                        {seq.duo.length > 0 && (
                          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
                            {seq.duo[0] && (
                              <div class={seq.duo.length > 1 ? "lg:col-span-7 flex flex-col" : "lg:col-span-12 flex flex-col"}>
                                <CinematicArchiveCard
                                  slug={seq.duo[0].slug}
                                  entry={seq.duo[0].entry}
                                  img={seq.duo[0].img}
                                  variant={seq.duo.length > 1 ? "duo-60" : "hero"}
                                  enableCinemagraph={true}
                                />
                              </div>
                            )}

                            {seq.duo[1] && (
                              <div class="lg:col-span-5 flex flex-col">
                                <CinematicArchiveCard
                                  slug={seq.duo[1].slug}
                                  entry={seq.duo[1].entry}
                                  img={seq.duo[1].img}
                                  variant="duo-40"
                                  enableCinemagraph={true}
                                />
                              </div>
                            )}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
          </section>
        </div>
      )}

    </div>
  </div>

  <script>
    const setupArchiveTabsAndFilters = () => {
      const h1 = document.querySelector('h1');
      if (h1) setTimeout(() => h1.classList.add('revealed'), 200);

      const tabButtons = document.querySelectorAll<HTMLButtonElement>('.archive-main-tab-btn');
      const viewCategories = document.getElementById('view-categories');
      const viewYears = document.getElementById('view-years');

      const catFilterButtons = document.querySelectorAll<HTMLButtonElement>('.cat-filter-btn');
      const categoryBlocks = document.querySelectorAll<HTMLElement>('.category-block');

      const yearFilterButtons = document.querySelectorAll<HTMLButtonElement>('.year-filter-btn');
      const yearGroups = document.querySelectorAll<HTMLElement>('.archive-year-cinematic-group');

      const activeBtnClasses = ['border-[#C8A98B]', 'text-[#C8A98B]', 'bg-[#C8A98B]/15', 'shadow-[0_0_18px_rgba(200,169,139,0.3)]', 'font-bold'];
      const inactiveBtnClasses = ['border-white/10', 'text-white/50', 'bg-white/3'];

      // Función para cambiar de solapa principal
      const switchTab = (tabName: 'categories' | 'years') => {
        tabButtons.forEach(btn => {
          const target = btn.getAttribute('data-main-tab');
          const indicator = btn.querySelector('.tab-indicator');
          const isActive = target === tabName;

          if (isActive) {
            btn.classList.remove(...inactiveBtnClasses);
            btn.classList.add(...activeBtnClasses);
            btn.setAttribute('aria-selected', 'true');
            if (indicator) {
              indicator.classList.remove('bg-white/30');
              indicator.classList.add('bg-[#C8A98B]');
            }
          } else {
            btn.classList.remove(...activeBtnClasses);
            btn.classList.add(...inactiveBtnClasses);
            btn.setAttribute('aria-selected', 'false');
            if (indicator) {
              indicator.classList.remove('bg-[#C8A98B]');
              indicator.classList.add('bg-white/30');
            }
          }
        });

        if (tabName === 'categories') {
          viewCategories?.classList.remove('hidden');
          viewYears?.classList.add('hidden');
        } else {
          viewCategories?.classList.add('hidden');
          viewYears?.classList.remove('hidden');
        }
      };

      const catSelectEl = document.getElementById('cat-linter-select') as HTMLSelectElement;
      const yearSelectEl = document.getElementById('year-linter-select') as HTMLSelectElement;

      // Función para filtrar categorías dentro de la solapa 1
      const filterCategories = (catValue: string) => {
        catFilterButtons.forEach(btn => {
          const val = btn.getAttribute('data-cat-filter-btn');
          const isActive = (catValue === 'all' && val === 'all') || val === catValue;
          if (isActive) {
            btn.classList.remove(...inactiveBtnClasses);
            btn.classList.add(...activeBtnClasses);
          } else {
            btn.classList.remove(...activeBtnClasses);
            btn.classList.add(...inactiveBtnClasses);
          }
        });

        if (catSelectEl && catSelectEl.value !== catValue) {
          catSelectEl.value = catValue;
        }

        categoryBlocks.forEach(block => {
          const blockCat = block.getAttribute('data-category-group');
          if (catValue === 'all' || blockCat === catValue) {
            block.style.display = '';
          } else {
            block.style.display = 'none';
          }
        });
      };

      // Función para filtrar años dentro de la solapa 2
      const filterYears = (yearValue: string) => {
        yearFilterButtons.forEach(btn => {
          const val = btn.getAttribute('data-year-filter-btn');
          const isActive = (yearValue === 'all' && val === 'all') || val === yearValue;
          if (isActive) {
            btn.classList.remove(...inactiveBtnClasses);
            btn.classList.add(...activeBtnClasses);
          } else {
            btn.classList.remove(...activeBtnClasses);
            btn.classList.add(...inactiveBtnClasses);
          }
        });

        if (yearSelectEl && yearSelectEl.value !== yearValue) {
          yearSelectEl.value = yearValue;
        }

        yearGroups.forEach(group => {
          const groupYear = group.getAttribute('data-year-group');
          if (yearValue === 'all' || groupYear === yearValue) {
            group.style.display = '';
          } else {
            group.style.display = 'none';
          }
        });
      };

      // Eventos para pestañas principales
      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetTab = (btn.getAttribute('data-main-tab') as 'categories' | 'years') || 'categories';
          switchTab(targetTab);
          
          if (targetTab === 'years') {
            history.replaceState(null, '', `?vista=ano`);
          } else {
            history.replaceState(null, '', `?vista=categoria`);
          }
        });
      });

      // Eventos para desplegable linter de categorías
      if (catSelectEl) {
        catSelectEl.addEventListener('change', (e) => {
          const val = (e.target as HTMLSelectElement).value;
          filterCategories(val);
          if (val === 'all') {
            history.replaceState(null, '', `?vista=categoria`);
          } else {
            history.replaceState(null, '', `?vista=categoria&categoria=${encodeURIComponent(val)}`);
          }
        });
      }

      // Eventos para desplegable linter de años
      if (yearSelectEl) {
        yearSelectEl.addEventListener('change', (e) => {
          const val = (e.target as HTMLSelectElement).value;
          filterYears(val);
          if (val === 'all') {
            history.replaceState(null, '', `?vista=ano`);
          } else {
            history.replaceState(null, '', `?vista=ano&año=${encodeURIComponent(val)}`);
          }
        });
      }

      // Eventos para botones rápidos de categoría
      catFilterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-cat-filter-btn') || 'all';
          filterCategories(val);
          if (val === 'all') {
            history.replaceState(null, '', `?vista=categoria`);
          } else {
            history.replaceState(null, '', `?vista=categoria&categoria=${encodeURIComponent(val)}`);
          }
        });
      });

      // Eventos para botones rápidos de año
      yearFilterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-year-filter-btn') || 'all';
          filterYears(val);
          if (val === 'all') {
            history.replaceState(null, '', `?vista=ano`);
          } else {
            history.replaceState(null, '', `?vista=ano&año=${encodeURIComponent(val)}`);
          }
        });
      });

      // Inicializar desde URL
      const params = new URLSearchParams(window.location.search);
      const vistaParam = params.get('vista');
      const catParam = params.get('categoria');
      const yearParam = params.get('año');

      if (vistaParam === 'ano' || vistaParam === 'año' || yearParam) {
        switchTab('years');
        if (yearParam) {
          filterYears(yearParam);
        }
      } else {
        switchTab('categories');
        if (catParam) {
          filterCategories(catParam.toLowerCase().trim());
        }
      }
    };

    document.addEventListener('DOMContentLoaded', setupArchiveTabsAndFilters);
    document.addEventListener('astro:page-load', setupArchiveTabsAndFilters);
  </script>
</Layout>
