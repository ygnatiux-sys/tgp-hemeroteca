---
import Layout from '../layouts/Layout.astro';
import HeroNetflixTgp from '../components/HeroNetflixTgp.astro';

export const prerender = true;
---

<Layout
  title="Hero Netflix TGP Preview"
  description="Previsualización del Hero estilo Netflix con estética y ADN de The Great Puzzle Project."
  hideHeader={true}
>
  <main class="w-full min-h-screen bg-[#070709] flex flex-col justify-center items-center p-0 md:p-8">
    <div class="w-full max-w-375 overflow-hidden md:rounded-3xl border border-white/10 shadow-[0_20px_80px_rgba(0,0,0,0.95)]">
      <HeroNetflixTgp
        align="left"
        titulo="Solo en The Great Puzzle"
        bajada="En la Hemeroteca TGP encontrarás investigaciones originales, arqueosemiótica y ensayos cinemáticos que no están en ninguna otra parte. Pensados exclusivamente para mentes inquisitivas."
        ctaText="Comenzar lectura"
        ctaHref="/archivo/"
        secondaryCtaText="Explorar catálogo"
        secondaryCtaHref="/colecciones/"
      />
    </div>
  </main>
</Layout>
