---
// SSR requerido: Telegram Mini Apps necesitan HTTPS y headers dinámicos.
export const prerender = false;
import BotSelector from "../components/BotSelector.svelte";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="robots" content="noindex, nofollow" />
    <title>TGP · Configurar Publicación</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Telegram WebApp SDK (DEBE ir en el <head>) -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>

    <style>
      html, body {
        margin: 0; padding: 0;
        background: #0d1117;
        color: #e6edf3;
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        overscroll-behavior: none;
      }
    </style>
  </head>
  <body>
    <BotSelector client:load />
  </body>
</html>
