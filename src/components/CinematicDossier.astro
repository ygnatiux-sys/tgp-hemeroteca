---
// src/components/CinematicDossier.astro
import SpotifyIcon from './icons/Spotify.astro';
import YouTubeIcon from './icons/YouTube.astro';

export interface Fragment {
  image: any;
  text: string;
  highlight?: string;
  link?: string;
  category?: string;
  year?: string;
  position?: string;
  origin?: string;
  spotifyLink?: string;
  youtubeLink?: string;
}

interface Props {
  fragments: Fragment[];
  isModal?: boolean;
}

const { fragments = [], isModal = false } = Astro.props;
---

<section 
  id="cinematic-dossier"
  class={`cinematic-dossier-wrapper w-full h-dvh overflow-hidden relative bg-theme-dark ${isModal ? 'fixed inset-0 z-9999 opacity-0 pointer-events-none' : 'block'}`}
  data-images={JSON.stringify(fragments.map(f => typeof f.image === 'string' ? f.image : (f.image?.src || '')))}
>
  {/* Botón de Cerrar Modal (Solo si es Modal) */}
  {isModal && (
    <button class="dossier-close-btn tgp-ui-control absolute top-6 right-6 z-50 w-14 h-14 flex items-center justify-center rounded-full text-transparent hover:text-[#C8A98B] bg-transparent hover:bg-black/40 hover:backdrop-blur-md opacity-0 hover:opacity-100 transition-all duration-700 cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  )}

  <div class="slides-container relative w-full h-full">
    {fragments.map((fragment, index) => (
      <article class={`slide w-full h-full absolute inset-0 flex items-center justify-center ${index === 0 ? 'active z-20' : 'opacity-0 pointer-events-none z-10'}`} data-index={index}>
         
         <div class="absolute inset-4 md:inset-8 overflow-hidden rounded-3xl md:rounded-[2.5rem] shadow-2xl bg-black">
           {/* Imagen de fondo con scale para el efecto Ken Burns */}
           <img 
             src={typeof fragment.image === 'string' ? fragment.image : fragment.image?.src} 
             alt={fragment.highlight || "Registro Documental"} 
             class="bg-image absolute inset-0 w-full h-full object-cover scale-100"
             style={`object-position: ${fragment.position || 'center center'}; transform-origin: ${fragment.origin || 'center center'};`} 
           />
           
           {/* Overlay de oscurecimiento y vignette radial para esquinas (Softens corners) */}
           <div class="overlay shadow-[inset_0_0_180px_20px_rgba(0,0,0,1)] mix-blend-multiply absolute inset-0 z-0 pointer-events-none"></div>
         </div>
         
         <div class="content-layer relative z-10 w-full max-w-6xl px-6 md:px-12 lg:px-24 flex flex-col items-start text-left gap-5 md:gap-6">
           {/* Etiquetas Superiores */}
           {(fragment.category || fragment.year) && (
             <div class="immersive-tags flex items-center gap-3 font-mono text-[10px] md:text-[11px] uppercase tracking-[0.4em] text-[#C8A98B]">
               <span>{fragment.category}</span>
               {fragment.year && (
                 <>
                   <span class="opacity-40">•</span>
                   <span class="text-white/60">{fragment.year}</span>
                 </>
               )}
             </div>
           )}

           {/* Título Principal Inmersivo */}
           {fragment.highlight && (
             <h1 class="immersive-title font-cinzel text-[clamp(3.25rem,6.5vw,8.5rem)] text-white leading-[0.95] font-bold drop-shadow-2xl antialiased max-w-4xl">
               <span class="bg-linear-to-r from-vintage-yellow to-rust-orange bg-clip-text text-transparent inline-block pb-2 pr-2">
                 {fragment.highlight}
               </span>
             </h1>
           )}
           
           {/* Texto Descriptivo */}
           {fragment.text && (
             <p class="immersive-desc text-white/70 text-lg md:text-xl max-w-2xl font-light leading-relaxed drop-shadow-md">
               {fragment.text}
             </p>
           )}

           {/* Iconos de Herramientas (Solo ilustrativos) */}
           <div class="immersive-icons flex items-center gap-4 mt-4">
             <button class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white/50 hover:bg-white hover:text-black transition-all" aria-label="Expandir">
               <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
             </button>
             <button class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white/50 hover:bg-white hover:text-black transition-all" aria-label="Información">
               <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
             </button>
           </div>

           {/* Botón CTA */}
           {fragment.link && (
             <div class="immersive-cta mt-4">
               <a href={fragment.link} class="group inline-flex items-center gap-3 text-[#C8A98B] hover:text-white transition-colors">
                 <span class="font-mono text-[10px] uppercase tracking-[0.3em] font-bold">Leer Investigación</span>
                 <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform duration-300"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
               </a>
             </div>
           )}
         </div>
      </article>
    ))}
  {/* Pantalla Intro Cinemática en Tandas */}
  <div class="intro-screen absolute inset-0 z-50 flex flex-col items-center justify-center opacity-0 pointer-events-none bg-black">
    {/* TANDA 1: Marca & Presenta */}
    <div class="intro-brand-stage absolute inset-0 flex flex-col items-center justify-center opacity-0">
      <div class="intro-tgp-title font-cinzel text-4xl md:text-6xl text-[#C8A98B] font-bold drop-shadow-[0_0_35px_rgba(200,169,139,0.7)] tracking-wider text-center px-6">
        The Great Puzzle
      </div>
      <div class="intro-tgp-project font-mono text-xs md:text-sm tracking-[0.6em] text-white/50 mt-4 uppercase">
        — project —
      </div>
      <div class="intro-tgp-presenta font-serif italic text-sm md:text-base text-white/60 tracking-widest mt-8">
        presenta
      </div>
    </div>

    {/* TANDA 2: Título Extra Bold + Registro Visual Completo */}
    <div class="intro-post-stage absolute inset-0 flex flex-col items-center justify-center opacity-0 text-center px-6 max-w-5xl">
      <h1 class="intro-post-title font-cinzel text-4xl md:text-6xl lg:text-7xl font-extrabold text-white leading-tight drop-shadow-2xl tracking-tight mb-4">
        {fragments[0]?.highlight || 'Ensayo Historiográfico'}
      </h1>
      <h2 class="intro-post-h2 font-mono text-xs md:text-sm uppercase tracking-[0.4em] text-[#C8A98B] font-semibold border-t border-[#C8A98B]/30 pt-3 inline-block">
        REGISTRO VISUAL COMPLETO
      </h2>
    </div>
  </div>

  {/* Pantalla Outro (The Great Puzzle) */}
  <div class="outro-screen absolute inset-0 z-50 flex flex-col items-center justify-center opacity-0 pointer-events-none bg-black">
    {/* 1. Título del Post - aparece primero, 2 seg, desaparece */}
    <h2 class="outro-post-title font-cinzel text-2xl md:text-4xl text-white/80 font-bold opacity-0 text-center px-8 max-w-4xl tracking-wide">
       {fragments[0]?.highlight || 'Registro Visual'}
    </h2>
    {/* 2. The Great Puzzle - surge desde centro, 2 seg */}
    <div class="outro-brand-main absolute inset-0 flex flex-col items-center justify-center opacity-0 scale-50">
      <div class="font-cinzel text-4xl md:text-6xl text-[#C8A98B] font-bold drop-shadow-[0_0_30px_rgba(200,169,139,0.6)] tracking-wide text-center px-6">
        The Great Puzzle
      </div>
    </div>
    {/* 3. -project- - aparece inmediatamente después, se desvanece junto */}
    <div class="outro-brand-sub absolute inset-0 flex flex-col items-center justify-center pt-28 md:pt-32 opacity-0">
      <div class="font-mono text-xs md:text-sm tracking-[0.6em] text-white/40 uppercase">
        — project —
      </div>
    </div>
  </div>

  {/* Controles de Navegación UI */}
  {fragments.length > 1 && (
    <div class="dossier-controls absolute inset-x-0 top-1/2 -translate-y-1/2 flex items-center justify-between px-4 md:px-8 z-40 pointer-events-none">
      <button class="dossier-prev tgp-ui-control pointer-events-auto w-16 h-24 md:w-24 md:h-32 flex items-center justify-center rounded-xl text-transparent hover:text-[#C8A98B] bg-transparent hover:bg-linear-to-r hover:from-black/50 hover:to-transparent opacity-0 hover:opacity-100 transition-all duration-700 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button class="dossier-next tgp-ui-control pointer-events-auto w-16 h-24 md:w-24 md:h-32 flex items-center justify-center rounded-xl text-transparent hover:text-[#C8A98B] bg-transparent hover:bg-linear-to-l hover:from-black/50 hover:to-transparent opacity-0 hover:opacity-100 transition-all duration-700 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  )}
  
  {/* Indicador de Progreso */}
  {fragments.length > 1 && (
    <div class="dossier-progress absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-2 z-40">
      {fragments.map((_, i) => (
        <div class={`progress-dot w-2 h-2 rounded-full transition-all duration-500 ${i === 0 ? 'bg-[#C8A98B] w-6' : 'bg-white/30'}`} data-target={i}></div>
      ))}
    </div>
  )}

  {/* PIP Thumbnail (cuadro dentro de cuadro) */}
  <div class="dossier-pip absolute bottom-32 right-5 md:right-12 z-30 opacity-0 transition-opacity duration-1000 pointer-events-none">
    <div class="relative w-32 h-22 md:w-48 md:h-32 overflow-hidden rounded-2xl shadow-2xl border border-white/10 bg-black">
      <img class="pip-img w-full h-full object-cover" src="" alt="" />
      <div class="absolute inset-0 shadow-[inset_0_0_30px_8px_rgba(0,0,0,0.8)] pointer-events-none rounded-2xl"></div>
    </div>
    <div class="absolute -bottom-1 -right-1 w-2.5 h-2.5 rounded-full bg-[#C8A98B]/50 shadow-[0_0_8px_rgba(200,169,139,0.4)]"></div>
  </div>

  {/* Filmstrip: miniaturas prev/next */}
  {fragments.length > 1 && (
    <div class="dossier-filmstrip absolute bottom-3 left-1/2 -translate-x-1/2 z-30 flex items-center gap-1.5 opacity-0 transition-opacity duration-700">
      <div class="filmstrip-slot filmstrip-prev relative w-10 h-7 md:w-14 md:h-10 rounded-lg overflow-hidden opacity-40 border border-white/10 bg-black/40">
        <img class="filmstrip-prev-img w-full h-full object-cover" src="" alt="" />
      </div>
      <div class="filmstrip-slot filmstrip-curr relative w-14 h-10 md:w-18 md:h-12 rounded-xl overflow-hidden opacity-60 border border-[#C8A98B]/30 ring-1 ring-[#C8A98B]/20 bg-black">
        <img class="filmstrip-curr-img w-full h-full object-cover" src="" alt="" />
      </div>
      <div class="filmstrip-slot filmstrip-next relative w-10 h-7 md:w-14 md:h-10 rounded-lg overflow-hidden opacity-40 border border-white/10 bg-black/40">
        <img class="filmstrip-next-img w-full h-full object-cover" src="" alt="" />
      </div>
    </div>
  )}
</section>

<script>
  import { gsap } from 'gsap';
  import SplitType from 'split-type';

  function initCinematicDossier() {
    const wrapper = document.querySelector('.cinematic-dossier-wrapper');
    if (!wrapper) return;

    const slides = Array.from(wrapper.querySelectorAll('.slide')) as HTMLElement[];
    if (slides.length === 0) return;

    const prevBtn = wrapper.querySelector('.dossier-prev');
    const nextBtn = wrapper.querySelector('.dossier-next');
    const closeBtn = wrapper.querySelector('.dossier-close-btn');
    const dots = wrapper.querySelectorAll('.progress-dot');

    // Datos de imágenes para PIP y filmstrip
    const imageUrls: string[] = JSON.parse((wrapper as HTMLElement).dataset.images || '[]');
    const pipImg = wrapper.querySelector('.pip-img') as HTMLImageElement;
    const pipEl = wrapper.querySelector('.dossier-pip') as HTMLElement;
    const filmstripPrev = wrapper.querySelector('.filmstrip-prev-img') as HTMLImageElement;
    const filmstripCurr = wrapper.querySelector('.filmstrip-curr-img') as HTMLImageElement;
    const filmstripNext = wrapper.querySelector('.filmstrip-next-img') as HTMLImageElement;
    const filmstripEl = wrapper.querySelector('.dossier-filmstrip') as HTMLElement;

    // Flag para el intro del título
    let introTitleFaded = false;
    let isIntroPlaying = false;
    
    let currentIndex = 0;
    let isAnimating = false;
    let isOutroPlaying = false;
    let touchStartX = 0;

    // Inicializar SplitType en todas las slides
    slides.forEach(slide => {
      const title = slide.querySelector('.immersive-title');
      const subtitle = slide.querySelector('.immersive-desc');

      if (title && (title as any)._splitInstance) {
        (title as any)._splitInstance.revert();
      }
      if (subtitle && (subtitle as any)._splitInstance) {
        (subtitle as any)._splitInstance.revert();
      }

      let splitTitle = title ? new SplitType(title as HTMLElement, { types: 'words,chars' }) : null;
      if (title) (title as any)._splitInstance = splitTitle;
      
      let splitSubtitle = subtitle ? new SplitType(subtitle as HTMLElement, { types: 'words,chars' }) : null;
      if (subtitle) (subtitle as any)._splitInstance = splitSubtitle;

      // Ocultar textos de slides que no sean la primera
      if (slide.dataset.index !== '0') {
        gsap.set(slide, { opacity: 0 });
      }
    });

    function playTextAnimation(slide: HTMLElement) {
      const title = slide.querySelector('.immersive-title');
      const subtitle = slide.querySelector('.immersive-desc');
      const tags = slide.querySelector('.immersive-tags');
      const cta = slide.querySelector('.immersive-cta');
      const icons = slide.querySelector('.immersive-icons');
      
      const splitTitle = title ? (title as any)._splitInstance : null;
      const splitSubtitle = subtitle ? (subtitle as any)._splitInstance : null;

      const elementsToAnimate = [
        ...(splitTitle ? splitTitle.chars || [] : []),
        ...(splitSubtitle ? splitSubtitle.chars || [] : [])
      ];

      const extrasToAnimate = [tags, cta, icons].filter(Boolean);

      // Set initial states
      gsap.set(elementsToAnimate, { opacity: 0, y: 45, filter: 'blur(12px)' });
      if (extrasToAnimate.length) gsap.set(extrasToAnimate, { opacity: 0, y: 20 });

      const tl = gsap.timeline({ delay: 0.2 });

      if (splitTitle && splitTitle.chars && splitTitle.chars.length > 0) {
        tl.to(splitTitle.chars, {
          opacity: 1, y: 0, filter: 'blur(0px)', duration: 1.5, ease: 'power3.out', stagger: 0.02
        });
      }

      if (splitSubtitle && splitSubtitle.chars && splitSubtitle.chars.length > 0) {
        tl.to(splitSubtitle.chars, {
          opacity: 1, y: 0, filter: 'blur(0px)', duration: 1.5, ease: 'power3.out', stagger: 0.01
        }, "-=1.0");
      }

      if (extrasToAnimate.length > 0) {
        tl.to(extrasToAnimate, {
          opacity: 1, y: 0, duration: 1.5, ease: 'power3.out', stagger: 0.1
        }, "-=1.2");
      }
      
      // INTRO: Después de que el texto aparezca completamente,
      // 2 segundos de visibilidad, y luego fade out suave
      if (slide.dataset.index === '0' && title && !introTitleFaded) {
        tl.addCallback(() => {
          introTitleFaded = true;
          gsap.to(title, { opacity: 0, duration: 1.5, delay: 2, ease: 'power2.inOut' });
        });
      }
      
      // Ken Burns en la imagen de fondo
      const bgImage = slide.querySelector('.bg-image');
      if (bgImage) {
         gsap.fromTo(bgImage, 
           { scale: 1.05, filter: 'brightness(0.6)' },
           { scale: 1, filter: 'brightness(1)', duration: 10, ease: 'power1.out' }
         );
      }
    }

    function goToSlide(index: number, direction: 'next' | 'prev', isAuto = false) {
      if (isAnimating || index === currentIndex || isOutroPlaying) return;
      
      // Si llegamos al final y vamos hacia adelante, activamos el OUTRO
      if (currentIndex === slides.length - 1 && direction === 'next' && !isOutroPlaying) {
        playOutroSequence();
        return;
      }
      
      if (!isAuto) {
        stopAutoplay();
        startAutoplay(); // Reinicia el ciclo si fue manual
      }
      isAnimating = true;

      const currentSlide = slides[currentIndex];
      const nextSlide = slides[index];

      // Update dots
      if (dots.length) {
        dots[currentIndex].classList.replace('w-6', 'w-2');
        dots[currentIndex].classList.replace('bg-[#C8A98B]', 'bg-white/30');
        dots[index].classList.replace('w-2', 'w-6');
        dots[index].classList.replace('bg-white/30', 'bg-[#C8A98B]');
      }

      // Animación GSAP de transición
      const tl = gsap.timeline({
        onComplete: () => {
          gsap.set(currentSlide, { opacity: 0, pointerEvents: 'none', zIndex: 10 });
          gsap.set(nextSlide, { pointerEvents: 'auto', zIndex: 20 });
          currentSlide.classList.remove('active');
          nextSlide.classList.add('active');
          currentIndex = index;
          isAnimating = false;
        }
      });

      const currentImg = currentSlide.querySelector('img');
      const nextImg = nextSlide.querySelector('img');

      gsap.set(nextSlide, { opacity: 0, zIndex: 15 });
      
      // Cruzamos los fades en paralelo - menos oscurecimiento, más fluido
      tl.to(currentSlide, { opacity: 0, duration: 2, ease: 'power1.inOut' }, 0);
      if (currentImg) {
         tl.to(currentImg, { scale: 0.98, xPercent: direction === 'next' ? -2 : 2, filter: 'brightness(0.75)', duration: 2, ease: 'power2.inOut' }, 0);
      }
      
      tl.to(nextSlide, { opacity: 1, duration: 2, ease: 'power1.inOut' }, 0);
      if (nextImg) {
         // "Linterna": la nueva imagen amanece desde penumbra, no desde negro total
         tl.fromTo(nextImg, 
            { scale: 1.02, xPercent: direction === 'next' ? 2 : -2, filter: 'brightness(0.65)' }, 
            { scale: 1, xPercent: 0, filter: 'brightness(1)', duration: 2.5, ease: 'power2.out' }, 
         0);
      }

      playTextAnimation(nextSlide);
      playPageSound();
      updatePipAndFilmstrip(index);
    }

    function next() {
      if (slides.length <= 1) return;
      goToSlide(currentIndex === slides.length - 1 ? 0 : currentIndex + 1, 'next');
    }

    function prev() {
      if (slides.length <= 1) return;
      const prevIdx = (currentIndex - 1 + slides.length) % slides.length;
      goToSlide(prevIdx, 'prev');
    }
    
    // Sonido sutil de pase de hoja (Web Audio API)
    function playPageSound() {
      try {
        const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
        const duration = 0.25;
        const buf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * duration), ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) {
          const t = i / ctx.sampleRate;
          data[i] = (Math.random() * 2 - 1) * Math.exp(-t * 25) * 0.4;
        }
        const source = ctx.createBufferSource();
        source.buffer = buf;
        const gain = ctx.createGain();
        gain.gain.value = 0.025; // Muy sutil
        const filter = ctx.createBiquadFilter();
        filter.type = 'highpass';
        filter.frequency.value = 2000;
        source.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);
        source.start();
        setTimeout(() => ctx.close(), 500);
      } catch(e) { /* Browser sin soporte */ }
    }
    
    // PIP + Filmstrip update
    function updatePipAndFilmstrip(idx: number) {
      if (imageUrls.length === 0) return;
      
      // Actualizar PIP
      if (pipImg && imageUrls[idx]) {
        pipImg.src = imageUrls[idx];
        if (pipEl) {
          gsap.to(pipEl, { opacity: 1, duration: 0.8, delay: 0.5 });
        }
      }
      
      // Actualizar filmstrip
      if (filmstripCurr && imageUrls[idx]) filmstripCurr.src = imageUrls[idx];
      
      const prevIdx = (idx - 1 + imageUrls.length) % imageUrls.length;
      const nextIdx = (idx + 1) % imageUrls.length;
      
      if (filmstripPrev) {
        filmstripPrev.src = imageUrls[prevIdx] || '';
        const slot = filmstripPrev.closest('.filmstrip-slot') as HTMLElement;
        if (slot) slot.style.opacity = prevIdx === idx ? '0' : '0.4';
      }
      if (filmstripNext) {
        filmstripNext.src = imageUrls[nextIdx] || '';
        const slot = filmstripNext.closest('.filmstrip-slot') as HTMLElement;
        if (slot) slot.style.opacity = nextIdx === idx ? '0' : '0.4';
      }
      
      if (filmstripEl) {
        gsap.to(filmstripEl, { opacity: 1, duration: 0.7, delay: 0.3 });
      }
    }
    
    // Secuencia de Entradas Cinemáticas en Tandas (Intro)
    function playIntroSequence(onCompleteCallback?: () => void) {
      const introScreen = wrapper!.querySelector('.intro-screen');
      const brandStage = wrapper!.querySelector('.intro-brand-stage');
      const tgpTitle = wrapper!.querySelector('.intro-tgp-title');
      const tgpProject = wrapper!.querySelector('.intro-tgp-project');
      const tgpPresenta = wrapper!.querySelector('.intro-tgp-presenta');
      const postStage = wrapper!.querySelector('.intro-post-stage');
      const postTitle = wrapper!.querySelector('.intro-post-title');
      const postH2 = wrapper!.querySelector('.intro-post-h2');

      if (!introScreen || !brandStage || !postStage) {
        if (onCompleteCallback) onCompleteCallback();
        return;
      }

      // Capturar título de la página si es genérico
      const pageH1 = document.querySelector('h1')?.textContent?.trim();
      if (pageH1 && postTitle && (!postTitle.textContent || postTitle.textContent.includes('Registro Visual') || postTitle.textContent.includes('Ensayo Historiográfico'))) {
        postTitle.textContent = pageH1;
      }

      isIntroPlaying = true;

      const tl = gsap.timeline({
        onComplete: () => {
          gsap.set(introScreen, { opacity: 0, pointerEvents: 'none' });
          isIntroPlaying = false;
          if (onCompleteCallback) onCompleteCallback();
        }
      });

      gsap.set(introScreen, { opacity: 1, pointerEvents: 'auto' });
      gsap.set([brandStage, postStage], { opacity: 0 });
      gsap.set([tgpTitle, tgpProject, tgpPresenta, postTitle, postH2], { opacity: 0, y: 20 });
      gsap.set(tgpTitle, { scale: 0.85, filter: 'blur(10px)' });
      gsap.set(postTitle, { scale: 0.95, filter: 'blur(8px)' });

      tl
        // TANDA 1: The Great Puzzle > — project — > presenta
        .to(brandStage, { opacity: 1, duration: 0.5 })
        .to(tgpTitle, { opacity: 1, scale: 1, filter: 'blur(0px)', duration: 1.6, ease: 'power2.out' })
        .to(tgpProject, { opacity: 1, y: 0, duration: 1, ease: 'power2.out' }, '-=0.8')
        .to(tgpPresenta, { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.4')
        .to(brandStage, { opacity: 0, y: -20, filter: 'blur(6px)', duration: 1, ease: 'power2.in' }, '+=1.0')

        // TANDA 2: Título Extra Bold > REGISTRO VISUAL COMPLETO H2
        .to(postStage, { opacity: 1, duration: 0.5 })
        .to(postTitle, { opacity: 1, y: 0, scale: 1, filter: 'blur(0px)', duration: 1.5, ease: 'power3.out' })
        .to(postH2, { opacity: 1, y: 0, duration: 1, ease: 'power2.out' }, '-=0.7')
        .to(postStage, { opacity: 0, filter: 'blur(8px)', duration: 1.2, ease: 'power2.in' }, '+=1.5')
        
        // FADE TOTAL A CONTENIDO DE IMÁGENES
        .to(introScreen, { opacity: 0, duration: 1.2, ease: 'power2.inOut' }, '-=0.4');
    }

    // Secuencia de Finalización (Outro)
    function playOutroSequence() {
      isOutroPlaying = true;
      stopAutoplay();
      
      const outroScreen = wrapper!.querySelector('.outro-screen');
      const outroTitle = wrapper!.querySelector('.outro-post-title');
      const outroBrandMain = wrapper!.querySelector('.outro-brand-main');
      const outroBrandSub = wrapper!.querySelector('.outro-brand-sub');
      if (!outroScreen || !outroTitle || !outroBrandMain || !outroBrandSub) return;
      
      // Set initial GSAP states
      gsap.set([outroTitle, outroBrandMain, outroBrandSub], { opacity: 0 });
      gsap.set(outroBrandMain, { scale: 0.6 });
      
      const tl = gsap.timeline({
         onComplete: () => {
            gsap.set(outroScreen, { opacity: 0, pointerEvents: 'none' });
            isOutroPlaying = false;
            goToSlide(0, 'next', true);
         }
      });
      
      gsap.set(outroScreen, { pointerEvents: 'auto' });
      
      tl
        // Fade al negro total
        .to(outroScreen, { opacity: 1, duration: 1.5, ease: 'power2.inOut' })
        
        // 1ª TANDA: Título del Post — aparece, dura 2 segundos, desaparece en 1 seg
        .to(outroTitle, { opacity: 1, duration: 1, ease: 'power2.out' }, '+=0.3')
        .to(outroTitle, { opacity: 0, duration: 1, ease: 'power2.in' }, '+=2')
        
        // 2ª TANDA: "The Great Puzzle" surge desde el centro
        .to(outroBrandMain, { opacity: 1, scale: 1, duration: 2, ease: 'power2.out' }, '+=0.5')
        
        // "-project-" aparece inmediatamente, en segunda ola
        .to(outroBrandSub, { opacity: 1, duration: 1.5, ease: 'power2.out' }, '-=0.5')
        
        // Ambos se desvanecen juntos después de 2 segundos
        .to([outroBrandMain, outroBrandSub], { opacity: 0, scale: 1.05, duration: 1.5, ease: 'power2.in' }, '+=2');
    }

    // Bind UI controls
    if (nextBtn) nextBtn.addEventListener('click', next);
    if (prevBtn) prevBtn.addEventListener('click', prev);

    // Keyboard support
    window.addEventListener('keydown', (e) => {
      // Only process keys if dossier is visible
      if (window.getComputedStyle(wrapper).opacity === '0') return;
      if (e.key === 'ArrowRight') next();
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'Escape' && closeBtn) closeBtn.dispatchEvent(new Event('click'));
    });

    // Touch support (Swipe)
    wrapper.addEventListener('touchstart', (e: any) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    wrapper.addEventListener('touchend', (e: any) => {
      const touchEndX = e.changedTouches[0].screenX;
      if (touchEndX < touchStartX - 50) next();
      if (touchEndX > touchStartX + 50) prev();
    }, { passive: true });

    // Wheel support (Scroll)
    let wheelTimeout: any;
    wrapper.addEventListener('wheel', (e: any) => {
      if (window.getComputedStyle(wrapper).opacity === '0') return;
      
      // Bloquear scroll de la página base
      e.preventDefault();

      if (isAnimating) return;
      
      clearTimeout(wheelTimeout);
      wheelTimeout = setTimeout(() => {
        if (e.deltaY > 50) next();
        else if (e.deltaY < -50) prev();
      }, 50);
    }, { passive: false });

    // Close Modal Logic
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        gsap.to(wrapper, { 
          opacity: 0, 
          duration: 1.2, 
          onComplete: () => {
            gsap.set(wrapper, { pointerEvents: 'none' });
            document.body.style.overflow = ''; // Restaurar scroll
          }
        });
      });
    }

    // --- LÓGICA DE AUTOPLAY ---
    let autoplayTimer: ReturnType<typeof setInterval>;
    let isPaused = false;

    function startAutoplay() {
      clearInterval(autoplayTimer);
      autoplayTimer = setInterval(() => {
        if (!isPaused && slides.length > 1) {
          goToSlide(currentIndex === slides.length - 1 ? 0 : currentIndex + 1, 'next', true);
        }
      }, 3000);
    }

    function stopAutoplay() {
      clearInterval(autoplayTimer);
    }

    // Pausar con interacción
    wrapper.addEventListener('mouseenter', () => isPaused = true);
    wrapper.addEventListener('mouseleave', () => isPaused = false);
    wrapper.addEventListener('touchstart', () => isPaused = true, { passive: true });
    wrapper.addEventListener('touchend', () => {
      setTimeout(() => isPaused = false, 2000);
    });

    // Función para activar destello inicial en controles
    function flashControls() {
      const controls = wrapper!.querySelectorAll('.tgp-ui-control');
      controls.forEach(c => {
        c.classList.remove('flash-presence');
        void (c as HTMLElement).offsetWidth; 
        c.classList.add('flash-presence');
      });
    }

    // Exponer la función de apertura globalmente
    (window as any).openCinematicDossierModal = () => {
      gsap.set(wrapper, { pointerEvents: 'auto' });
      gsap.to(wrapper, { opacity: 1, duration: 1.2 });
      document.body.style.overflow = 'hidden'; // Bloquear scroll de la página base
      
      playIntroSequence(() => {
        if (currentIndex === 0 && !isAnimating) {
          playTextAnimation(slides[0]);
        }
        startAutoplay();
        flashControls();
        updatePipAndFilmstrip(currentIndex);
      });
    };

    // Iniciar animación en la primera diapositiva si no es un modal (isCinematic=true)
    if (wrapper && !wrapper.classList.contains('pointer-events-none')) {
      playIntroSequence(() => {
        playTextAnimation(slides[0]);
        startAutoplay();
        flashControls();
        updatePipAndFilmstrip(0);
      });
    }
  }

  // Soporte para carga inicial y Astro View Transitions
  document.addEventListener('astro:page-load', initCinematicDossier);
</script>

<style>
  .cinematic-dossier-wrapper {
    contain: paint;
  }
  
  .immersive-title :global(.word) {
    padding-bottom: 0.1em;
  }

  .immersive-title :global(.char) {
    line-height: 1.1;
  }
</style>
