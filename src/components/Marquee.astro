---
import { sanitizeImageUrl } from "../lib/content-filter";

interface Props {
  title: string;
  subtitle?: string;
  imageUrl?: string;
  vibeClass?: string;
  isH1?: boolean;
  fontClass?: string;
  heightClass?: string;
  marginClass?: string;
  roundedClass?: string;
  showSocialInTitle?: boolean;
  maskBottom?: boolean;
  fullWidth?: boolean;
  disableParallax?: boolean;
}
const {
  title,
  subtitle = "The Great Puzzle",
  imageUrl = "",
  vibeClass = "",
  isH1 = false,
  fontClass = "font-serif",
  heightClass = "h-[calc(80vh-2rem)] min-h-150",
  marginClass = "mb-[25vh] md:mb-[35vh]",
  roundedClass = "rounded-3xl",
  showSocialInTitle = false,
  maskBottom = false,
  fullWidth = false,
  disableParallax = false,
} = Astro.props;

const safeImageUrl = sanitizeImageUrl(imageUrl);
const isSerif = fontClass.includes("serif") || fontClass.includes("gloock");
const gradientClass = isSerif ? "gradient-general-h1" : "gradient-acero-ios";
---

<section
  class={`dark-hero relative ${fullWidth ? 'w-full' : 'w-[calc(100%-2rem)] mx-auto mt-4'} ${heightClass} ${marginClass} flex flex-col items-center justify-center overflow-hidden ${fullWidth ? 'rounded-none' : roundedClass} ${vibeClass}`}
  style={maskBottom ? "background-color: var(--bg-current); mask-image: linear-gradient(to bottom, black 0%, black 70%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 0%, black 70%, transparent 100%);" : "background-color: var(--bg-current);"}
  data-disable-parallax={disableParallax ? "true" : undefined}
>
  <div class="absolute inset-0 z-0 opacity-70 marquee-bg-pin overflow-hidden">
    {safeImageUrl ? (
      <img
        src={safeImageUrl}
        alt={title}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="dark-img-target ken-burns-hero w-full h-full object-cover"
      />
    ) : null}
  </div>

  <div class="texture-grain"></div>
  <div class="texture-scratches"></div>
  <div class="atmospheric-dust"></div>

  <div
    class="absolute inset-0 z-10"
    style="background-image: linear-gradient(to top, var(--bg-current) 0%, color-mix(in srgb, var(--bg-current) 60%, transparent) 60%, transparent 100%);"
  >
  </div>
  <div class="absolute inset-0 z-10 bg-black/40"></div>

  <div
    class:list={[
      "title-container relative z-20 text-center px-6 w-full max-w-5xl mx-auto flex flex-col items-center justify-center",
      Astro.slots.has('default') 
        ? "grow flex-1 pt-8 sm:pt-12 pb-2" 
        : "py-6 md:py-8 -translate-y-4 my-auto"
    ]}
  >
    {isH1 ? (
      <h1
        class:list={[
          "vibe-target-h1 hero-interactive-h1 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight leading-[0.95] pb-1 drop-shadow-2xl text-balance mx-auto max-w-[22ch] inline-block",
          fontClass,
          gradientClass
        ]}
      >
        {title}
      </h1>
    ) : (
      <h2
        class:list={[
          "vibe-target-h1 hero-interactive-h1 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight leading-[0.95] pb-1 drop-shadow-2xl text-balance mx-auto max-w-[22ch] inline-block",
          fontClass,
          gradientClass
        ]}
      >
        {title}
      </h2>
    )}
    {subtitle && (
      <p
        class="vibe-target-h2 font-sans text-xs md:text-sm tracking-[0.15em] text-[#c4a484]/80 my-2 drop-shadow-md text-balance max-w-2xl mx-auto"
      >
        {subtitle}
      </p>
    )}
    <h3
      class={`vibe-target-folio font-tgp-tech text-[#c4a484]/50 text-[9px] md:text-[10px] tracking-[0.25em] uppercase mt-1.5 ${vibeClass === "vibe-travel-senses" ? "vibe-vertical" : ""}`}
    >
      TGP Editorial // {vibeClass.replace("vibe-", "").replace(/-/g, " ")}
    </h3>

    {/* Spotify & YouTube Discrete Links within title-container when slot is present OR showSocialInTitle is true */}
    {(Astro.slots.has('default') || showSocialInTitle) && (
      <div class="flex items-center gap-5 justify-center mt-3 pointer-events-auto">
        <a
          href="https://open.spotify.com/show/3zFq9ab980MamMHW48Sqxy"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-[8.5px] tracking-[0.2em] uppercase font-tgp-tech text-old-silver/80 hover:text-[#E3DDD3] transition-colors duration-300 group"
        >
          <span class="flex items-center justify-center w-5.5 h-5.5 rounded-full border border-old-silver/20 bg-white/4 group-hover:border-[#E3DDD3]/50 group-hover:bg-white/8 transition-all duration-300">
            <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.59 14.42c-.18.27-.53.37-.8.19-2.25-1.38-5.08-1.69-8.41-.93-.31.07-.62-.13-.69-.44-.07-.31.13-.62.44-.69 3.65-.83 6.78-.47 9.29 1.07.28.17.37.52.17.8zm1.22-2.72c-.22.36-.69.48-1.05.25-2.58-1.59-6.52-2.05-9.57-1.12-.4.12-.83-.11-.95-.51-.12-.4.11-.83.51-.95 3.5-.1 7.84.41 10.82 2.25.36.22.48.69.24 1.08zm.11-2.86C14.77 8.9 9.53 8.7 6.49 9.62c-.46.14-.94-.12-1.08-.58-.14-.46.12-.94.58-1.08 3.51-1.06 9.3-.84 13.06 1.39.42.25.56.8.31 1.22-.25.42-.8.56-1.22.31z"/>
            </svg>
          </span>
          <span>Spotify</span>
        </a>
        <a
          href="https://www.youtube.com/@thegreatpuzzleproject"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-[8.5px] tracking-[0.2em] uppercase font-tgp-tech text-old-silver/80 hover:text-[#E3DDD3] transition-colors duration-300 group"
        >
          <span class="flex items-center justify-center w-5.5 h-5.5 rounded-full border border-old-silver/20 bg-white/4 group-hover:border-[#E3DDD3]/50 group-hover:bg-white/8 transition-all duration-300">
            <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.507 9.388.507 9.388.507s7.518 0 9.388-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </span>
          <span>YouTube</span>
        </a>
      </div>
    )}
  </div>

  {/* Spotify & YouTube Discrete Links at the Hero Base ONLY if NO slot and NOT showSocialInTitle */}
  {!Astro.slots.has('default') && !showSocialInTitle && (
    <div class="absolute bottom-5 sm:bottom-6 left-1/2 -translate-x-1/2 z-20 flex items-center gap-5 justify-center pointer-events-auto">
      <a
        href="https://open.spotify.com/show/3zFq9ab980MamMHW48Sqxy"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-[9px] tracking-[0.22em] uppercase font-tgp-tech text-old-silver hover:text-[#E3DDD3] transition-colors duration-300 group"
      >
        <span class="flex items-center justify-center w-6 h-6 rounded-full border border-old-silver/20 bg-white/4 group-hover:border-[#E3DDD3]/50 group-hover:bg-white/8 transition-all duration-300">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.59 14.42c-.18.27-.53.37-.8.19-2.25-1.38-5.08-1.69-8.41-.93-.31.07-.62-.13-.69-.44-.07-.31.13-.62.44-.69 3.65-.83 6.78-.47 9.29 1.07.28.17.37.52.17.8zm1.22-2.72c-.22.36-.69.48-1.05.25-2.58-1.59-6.52-2.05-9.57-1.12-.4.12-.83-.11-.95-.51-.12-.4.11-.83.51-.95 3.5-.1 7.84.41 10.82 2.25.36.22.48.69.24 1.08zm.11-2.86C14.77 8.9 9.53 8.7 6.49 9.62c-.46.14-.94-.12-1.08-.58-.14-.46.12-.94.58-1.08 3.51-1.06 9.3-.84 13.06 1.39.42.25.56.8.31 1.22-.25.42-.8.56-1.22.31z"/>
          </svg>
        </span>
        <span>Spotify</span>
      </a>
      <a
        href="https://www.youtube.com/@thegreatpuzzleproject"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-[9px] tracking-[0.22em] uppercase font-tgp-tech text-old-silver hover:text-[#E3DDD3] transition-colors duration-300 group"
      >
        <span class="flex items-center justify-center w-6 h-6 rounded-full border border-old-silver/20 bg-white/4 group-hover:border-[#E3DDD3]/50 group-hover:bg-white/8 transition-all duration-300">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
            <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.507 9.388.507 9.388.507s7.518 0 9.388-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </span>
        <span>YouTube</span>
      </a>
    </div>
  )}

  {/* ── 25% LOWER ZONE: MEDIA TRAY SLOT ── */}
  {Astro.slots.has('default') && (
    <div class="relative z-20 w-full mt-auto pb-4 sm:pb-6 px-3 sm:px-6 md:px-8 pointer-events-auto">
      <slot />
    </div>
  )}
</section>

<style>
  @keyframes kenBurnsIntro {
    0% {
      transform: scale(1.04) translateY(2px);
      filter: brightness(0.85);
    }
    100% {
      transform: scale(1.0) translateY(0);
      filter: brightness(1);
    }
  }

  .ken-burns-hero {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: center center;
    animation: kenBurnsIntro 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: transform, filter;
  }

  .dark-hero:hover .dark-img-target {
    /* Suavizamos la bajada de luz en hover para que no quede negro total */
    filter: brightness(0.8) contrast(1.1);
    transition: filter 1.8s ease;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initDarkHero = () => {
    const heroSection = document.querySelector(".dark-hero");
    const bgPin = document.querySelector(".dark-hero .marquee-bg-pin");
    const titleContainer = document.querySelector(
      ".dark-hero .title-container",
    );
    const image = document.querySelector(".dark-hero .dark-img-target");

    if (heroSection && !(heroSection as HTMLElement).dataset.disableParallax) {
      // 1. ZOOM-OUT & FADE OUT TO BLACK ON SCROLL
      if (image) {
        gsap.to(image, {
          scrollTrigger: {
            trigger: heroSection,
            start: "top top",
            end: "bottom top",
            scrub: true,
          },
          scale: 0.85,
          opacity: 0.2,
          ease: "power2.inOut",
        });
      }

      // 2. PARALLAX DRIFT
      if (bgPin) {
        gsap.to(bgPin, {
          scrollTrigger: {
            trigger: heroSection,
            start: "top top",
            end: "bottom top",
            scrub: true,
          },
          y: 80,
          ease: "none",
        });
      }
    }

    // 3. TITLE TRANSITION (IN-PLACE SOFT GRADUAL FADE)
    if (heroSection && titleContainer) {
      gsap.to(titleContainer, {
        scrollTrigger: {
          trigger: heroSection,
          start: "top top",
          end: "70% top",
          scrub: 1.2,
        },
        y: 35,
        opacity: 0,
        scale: 0.94,
        ease: "power2.out",
      });
    }
  };

  // Lifecycle Protocol
  document.addEventListener("astro:page-load", initDarkHero);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initDarkHero();
  } else {
    document.addEventListener("DOMContentLoaded", initDarkHero);
  }
</script>
