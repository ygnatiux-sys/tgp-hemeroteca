---
/**
 * src/components/DiagonalScaleHero.astro
 * Motor cinemático "Diagonal Canvas Scale" (Apertura de ojo anamórfico SVG + GSAP).
 * Rescatado de laboratorio como componente reutilizable con showHud = false por defecto.
 */
import type { ImageMetadata } from 'astro';

interface Props {
  beforeImage?: ImageMetadata;
  image: ImageMetadata;
  word: string;
  subtitle: string;
  badge?: string;
  teaserTitle?: string;
  duration?: number;
  showHud?: boolean;
}

const {
  beforeImage,
  image,
  word,
  subtitle,
  badge = 'Cartografía Liminal · TGP FX',
  teaserTitle = word,
  duration = 1.7,
  showHud = false,
} = Astro.props;
---

<section class="relative w-full h-svh min-h-145 overflow-hidden bg-[#050507] text-white select-none" data-eye-duration={duration}>
  <div id="eye-stage" class="relative w-full h-full overflow-hidden will-change-transform">
    <!-- CAPA 0: ESTADO PREVIO -->
    <div id="cave-layer" class="absolute inset-0 z-10 overflow-hidden bg-black flex items-center justify-center">
      {beforeImage && (
        <img
          id="cave-bg-img"
          src={beforeImage.src}
          alt=""
          class="absolute inset-0 w-full h-full object-cover object-center opacity-35 filter brightness-50 contrast-125 scale-105 will-change-transform"
          loading="eager"
          decoding="async"
        />
      )}
      <div class="absolute inset-0 bg-radial from-transparent via-black/80 to-black pointer-events-none"></div>
      <div id="eye-slit-core" class="relative z-20 flex flex-col items-center justify-center text-center px-6 pointer-events-none">
        <div class="w-20 h-20 rounded-full border border-[#d4af37]/30 flex items-center justify-center shadow-[0_0_50px_rgba(212,175,55,0.4)] backdrop-blur-xs mb-4">
          <span class="font-serif text-3xl text-[#d4af37] animate-pulse">◈</span>
        </div>
        <span class="font-mono text-[10px] uppercase tracking-[0.5em] text-[#d4af37]/80">
          Apertura Diagonal
        </span>
        <h2 class="font-serif text-2xl md:text-4xl text-stone-200 mt-2 tracking-wider">
          {teaserTitle}
        </h2>
      </div>
    </div>

    <!-- CAPA 1: ESTADO REVELADO -->
    <div
      id="cosmos-layer"
      class="absolute inset-0 z-20 overflow-hidden will-change-[clip-path]"
      style="clip-path: url(#eye-scale-clip); -webkit-clip-path: url(#eye-scale-clip);"
    >
      <img
        id="cosmos-bg-img"
        src={image.src}
        alt={word}
        class="absolute inset-0 w-full h-full object-cover object-center will-change-transform scale-110"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/30 to-black/40 pointer-events-none"></div>
      <div class="absolute inset-0 bg-linear-to-r from-black/85 via-transparent to-black/35 pointer-events-none"></div>

      <div id="cosmos-content-text" class="absolute bottom-16 md:bottom-24 left-6 md:left-16 max-w-2xl z-30 flex flex-col gap-3">
        <span class="inline-flex items-center gap-2 font-mono text-[10px] md:text-xs uppercase tracking-[0.45em] text-[#d4af37]">
          <span class="w-2 h-px bg-[#d4af37]"></span>
          {badge}
        </span>
        <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight text-transparent bg-clip-text bg-linear-to-r from-white via-[#f3ede2] to-[#c5b392] drop-shadow-[0_10px_30px_rgba(0,0,0,0.95)]">
          {word}
        </h1>
        <p class="font-serif italic text-base md:text-xl text-stone-300/90 leading-relaxed max-w-xl drop-shadow-md">
          {subtitle}
        </p>
      </div>
    </div>

    <!-- CAPA 2: MOTOR SVG -->
    <svg
      id="eye-svg-engine"
      class="absolute inset-0 w-full h-full pointer-events-none z-30 overflow-visible"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <clipPath id="eye-scale-clip" clipPathUnits="userSpaceOnUse">
          <path id="eye-scale-path" d="" />
        </clipPath>
        <filter id="eye-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur1" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="12" result="blur2" />
          <feMerge>
            <feMergeNode in="blur2" />
            <feMergeNode in="blur1" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>
      <path id="eye-border-aura" d="" fill="none" stroke="#d4af37" stroke-width="8" filter="url(#eye-glow)" opacity="0" />
      <path id="eye-border-core" d="" fill="none" stroke="#ffffff" stroke-width="2" opacity="0" />
    </svg>

    <button
      type="button"
      id="eye-replay-btn"
      class="absolute bottom-6 right-6 z-40 w-10 h-10 rounded-full border border-white/20 bg-black/45 backdrop-blur-md text-white/75 hover:text-white hover:border-[#d4af37]/60 flex items-center justify-center transition-all cursor-pointer"
      aria-label="Repetir apertura"
    >
      ↻
    </button>

    {showHud && import.meta.env.DEV && (
      <div class="absolute top-20 right-6 z-40 px-3 py-1.5 rounded-full bg-black/75 border border-[#d4af37]/40 font-mono text-[10px] uppercase tracking-widest text-[#d4af37]">
        Dev FX · Diagonal Scale
      </div>
    )}
  </div>
</section>

<script>
  import gsap from 'gsap';

  function initDiagonalScaleHero() {
    const stage = document.getElementById('eye-stage');
    const host = stage?.closest('section') as HTMLElement | null;
    const clipPathEl = document.getElementById('eye-scale-path');
    const auraEl = document.getElementById('eye-border-aura');
    const coreEl = document.getElementById('eye-border-core');
    const slitCore = document.getElementById('eye-slit-core');
    const caveImg = document.getElementById('cave-bg-img');
    const cosmosImg = document.getElementById('cosmos-bg-img');
    const contentText = document.getElementById('cosmos-content-text');
    const replayBtn = document.getElementById('eye-replay-btn');

    if (!stage || !clipPathEl || !auraEl || !coreEl) return;
    if (stage.dataset.eyeInit === 'true') return;
    stage.dataset.eyeInit = 'true';

    const currentDuration = parseFloat(host?.dataset.eyeDuration || '1.7');
    let isExpanding = false;

    function updateEyeScaleGeometry(progress: number) {
      if (!clipPathEl || !auraEl || !coreEl || !stage) return;
      const W = stage.clientWidth || window.innerWidth;
      const H = stage.clientHeight || window.innerHeight;
      const cx = W / 2;
      const cy = H / 2;
      const maxRadius = Math.sqrt(W * W + H * H) * 0.75;

      if (progress <= 0) {
        clipPathEl.setAttribute('d', `M ${cx} ${cy} Z`);
        auraEl.setAttribute('opacity', '0');
        coreEl.setAttribute('opacity', '0');
        return;
      }
      if (progress >= 1) {
        clipPathEl.setAttribute('d', `M 0 0 L ${W} 0 L ${W} ${H} L 0 ${H} Z`);
        auraEl.setAttribute('opacity', '0');
        coreEl.setAttribute('opacity', '0');
        return;
      }

      const r = progress * maxRadius;
      const rx = r * 1.35;
      const ry = r * 0.75;
      const angleRad = -0.62;
      const cos = Math.cos(angleRad);
      const sin = Math.sin(angleRad);

      const p1x = cx + (-rx) * cos;
      const p1y = cy + (-rx) * sin;
      const p2x = cx + rx * cos;
      const p2y = cy + rx * sin;
      const topCtrlX = cx - (-ry * 1.4) * sin;
      const topCtrlY = cy + (-ry * 1.4) * cos;
      const botCtrlX = cx - (ry * 1.4) * sin;
      const botCtrlY = cy + (ry * 1.4) * cos;

      const dPath = `M ${Math.round(p1x)} ${Math.round(p1y)} Q ${Math.round(topCtrlX)} ${Math.round(topCtrlY)} ${Math.round(p2x)} ${Math.round(p2y)} Q ${Math.round(botCtrlX)} ${Math.round(botCtrlY)} ${Math.round(p1x)} ${Math.round(p1y)} Z`;
      clipPathEl.setAttribute('d', dPath);
      auraEl.setAttribute('d', dPath);
      coreEl.setAttribute('d', dPath);

      const edgeOpacity = progress < 0.85 ? Math.min(progress * 2.5, 1) : Math.max(0, (1 - progress) * 6.5);
      auraEl.setAttribute('opacity', `${edgeOpacity * 0.9}`);
      coreEl.setAttribute('opacity', `${edgeOpacity}`);
    }

    function executeDiagonalScale() {
      if (isExpanding) return;
      isExpanding = true;
      gsap.killTweensOf([stage, caveImg, cosmosImg, contentText, slitCore]);
      updateEyeScaleGeometry(0);
      if (slitCore) gsap.set(slitCore, { opacity: 1, scale: 1 });
      if (cosmosImg) gsap.set(cosmosImg, { scale: 1.18 });
      if (contentText) gsap.set(contentText, { opacity: 0, y: 30 });

      const tracker = { val: 0 };
      const tl = gsap.timeline({
        onComplete: () => {
          updateEyeScaleGeometry(1);
          isExpanding = false;
        },
      });

      if (slitCore) tl.to(slitCore, { opacity: 0, scale: 1.5, duration: 0.25, ease: 'power2.in' }, 0);
      if (caveImg) tl.to(caveImg, { scale: 1.25, opacity: 0.1, duration: currentDuration * 1.4, ease: 'power2.out' }, 0);
      tl.to(tracker, {
        val: 1,
        duration: currentDuration,
        ease: 'expo.out',
        onUpdate: () => updateEyeScaleGeometry(tracker.val),
      }, 0)
        .to(stage, { scale: 1.015, duration: 0.08, ease: 'power4.inOut' }, currentDuration * 0.5)
        .to(stage, { scale: 1.0, duration: 0.25, ease: 'elastic.out(1, 0.5)' });

      if (cosmosImg) tl.to(cosmosImg, { scale: 1.0, duration: currentDuration * 2.1, ease: 'power3.out' }, 0);
      if (contentText) tl.to(contentText, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, currentDuration * 0.45);
    }

    replayBtn?.addEventListener('click', () => executeDiagonalScale());
    setTimeout(() => executeDiagonalScale(), 400);
  }

  document.addEventListener('astro:page-load', initDiagonalScaleHero);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDiagonalScaleHero);
  } else {
    initDiagonalScaleHero();
  }
</script>
