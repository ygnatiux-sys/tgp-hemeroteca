---

<section 
  id="showcase-batch" 
  class="relative w-full bg-[#0a0a0c] text-white py-16 md:py-24 border-t border-white/5 overflow-hidden select-none"
  data-showcase={JSON.stringify(mockCategories)}
>
  <!-- Resplandor ambiental de fondo sutil -->
