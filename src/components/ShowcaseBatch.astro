  <!-- ══════════════════════════════════════════════════════════════════════════
       1. HEADER / NAVEGADOR DE CATEGORÍAS (PATRÓN HBO MAX)
       ══════════════════════════════════════════════════════════════════════════ -->
  <div class="text-center max-w-5xl mx-auto px-4 mb-10 md:mb-14 relative z-10">
    <!-- Subtítulo pequeño centrado arriba -->
    <span class="block text-xs md:text-sm tracking-[0.25em] text-gray-400 uppercase font-mono font-medium mb-4 sm:mb-6">
      DESCUBRE LO MEJOR EN
    </span>

    <!-- Selector de Categorías Horizontal con Chevrons -->
    <div class="flex items-center justify-center gap-3 sm:gap-6 md:gap-10">
      
      <!-- Chevron Izquierdo (<) estilo HBO -->
      <button 
        type="button" 
        data-btn-prev
        class="p-2 sm:p-3 text-white/40 hover:text-white transition-all duration-200 cursor-pointer hover:scale-110 active:scale-95 shrink-0"
        aria-label="Categoría anterior"
      >
        <svg class="w-6 h-6 sm:w-8 sm:h-8 -translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Categoría Anterior (Atenuada, clickeable) -->
      <span 
        data-cat-prev
        class="hidden sm:inline-block text-lg md:text-2xl text-gray-500 opacity-60 font-light hover:opacity-100 hover:text-gray-300 transition-all cursor-pointer truncate max-w-[200px]"
        title="Ver categoría anterior"
      >
        {prevCategory.name}
      </span>

      <!-- Categoría Activa (Centrada, monumental) -->
      <h2 
        data-cat-active
        class="text-2xl sm:text-4xl md:text-5xl font-light text-white tracking-tight px-2 sm:px-4 leading-tight transition-transform duration-300"
      >
        {activeCategory.name}
      </h2>

      <!-- Categoría Siguiente (Atenuada, clickeable) -->
      <span 
        data-cat-next
        class="hidden sm:inline-block text-lg md:text-2xl text-gray-500 opacity-60 font-light hover:opacity-100 hover:text-gray-300 transition-all cursor-pointer truncate max-w-[200px]"
        title="Ver categoría siguiente"
      >
        {nextCategory.name}
      </span>

      <!-- Chevron Derecho (>) estilo HBO -->
      <button 
        type="button" 
        data-btn-next
        class="p-2 sm:p-3 text-white/40 hover:text-white transition-all duration-200 cursor-pointer hover:scale-110 active:scale-95 shrink-0"
        aria-label="Categoría siguiente"
      >
        <svg class="w-6 h-6 sm:w-8 sm:h-8 translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════
       2. GRID DE POSTEOS (BATCH DE 6 MINIATURAS EN ASPECT-VIDEO 16:9)
       ══════════════════════════════════════════════════════════════════════════ -->
  <div class="max-w-6xl mx-auto px-4 relative z-10">
    <div 
      data-showcase-grid
      class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 items-stretch transition-all duration-300 ease-in-out opacity-100 transform scale-100"
    >
      {activeCategory.items.map((post) => (
        <a 
          href={post.href}
          class="group relative block aspect-video w-full rounded-md md:rounded-lg overflow-hidden bg-neutral-900 border border-white/10 shadow-lg hover:shadow-[0_16px_36px_rgba(0,0,0,0.85)] hover:border-white/30 transition-all duration-300 hover:scale-105 cursor-pointer z-10 hover:z-20"
        >
          <!-- Imagen de fondo (aspect-video obligatorio) -->
          <img 
            src={post.image} 
            alt={post.title}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-110 pointer-events-none"
          />

          <!-- Scrim degradado inferior para legibilidad cinematográfica -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 via-40% to-transparent pointer-events-none transition-opacity duration-300 group-hover:from-black"></div>

          <!-- Badge de categoría sutil superior -->
          {post.badge && (
            <div class="absolute top-2.5 left-2.5 z-10 flex items-center gap-1.5 px-2 py-0.5 rounded bg-black/70 backdrop-blur-md border border-white/10 text-[9px] sm:text-[10px] font-mono tracking-wider text-gray-300 uppercase pointer-events-none">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              <span>{post.badge}</span>
            </div>
          )}

          <!-- Bloque de Título y Bajada anclado en la base -->
          <div class="absolute inset-x-0 bottom-0 p-3 sm:p-4 md:p-5 z-10 flex flex-col justify-end pointer-events-none">
            <h3 class="font-cinzel text-xs sm:text-sm md:text-base font-bold text-white tracking-wide uppercase line-clamp-2 drop-shadow-md group-hover:text-amber-200 transition-colors duration-200">
              {post.title}
            </h3>
            {post.dek && (
              <p class="hidden sm:block text-[11px] md:text-xs text-gray-300/80 font-sans line-clamp-1 mt-1 font-normal drop-shadow">
                {post.dek}
              </p>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════
       3. BRANDING & CTA (EMULANDO EL PATRÓN HBO MAX)
       ══════════════════════════════════════════════════════════════════════════ -->
  <div class="mt-14 sm:mt-20 text-center flex flex-col items-center justify-center relative z-10 gap-8">
    <!-- Botón CTA estilo HBO Max (de la primera captura: "Suscríbete" -> "Explorar Hemeroteca") -->
    <a 
      href="/colecciones/" 
      class="inline-flex items-center justify-center px-8 sm:px-10 py-3 rounded-md bg-[#e5e7eb] hover:bg-white text-black font-semibold text-xs sm:text-sm tracking-wide shadow-[0_4px_20px_rgba(255,255,255,0.1)] hover:shadow-[0_8px_30px_rgba(255,255,255,0.25)] hover:scale-105 active:scale-95 transition-all duration-300"
    >
      Explorar Hemeroteca
    </a>

    <!-- Logo / Brand Monumental estilo HBO 3D Chrome (de la segunda captura) -->
    <a 
      href="/colecciones/" 
      class="group inline-flex flex-col items-center justify-center transition-transform duration-300 hover:scale-105"
      title="Explorar todas las colecciones"
    >
      <span class="font-gloock font-black text-3xl sm:text-4xl md:text-5xl tracking-widest text-transparent bg-clip-text bg-gradient-to-b from-white via-stone-300 to-stone-600 uppercase drop-shadow-[0_8px_32px_rgba(255,255,255,0.18)] group-hover:from-white group-hover:to-amber-200 transition-colors">
        THE GREAT PUZZLE PROJECT
      </span>
      <span class="text-[10px] sm:text-xs font-mono uppercase tracking-[0.3em] text-stone-400 group-hover:text-amber-300 transition-colors mt-2">
        Memoria & Sentido Humano • Archivo Abierto
      </span>
    </a>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════════════════════
     4. CLIENT SCRIPT (INTERACTIVIDAD VANILLA JS CON FADE IN/OUT DE 300MS)
     ════════════════════════════════════════════════════════════════════════════ -->
<script>
  function initShowcaseBatch() {
    const container = document.getElementById('showcase-batch');
    if (!container) return;

    // Leer datos estructurados serializados desde el atributo data-showcase
    const rawData = container.getAttribute('data-showcase');
    if (!rawData) return;

    let categories: Array<{
      id: string;
      name: string;
      items: Array<{
        id: string;
        title: string;
        dek?: string;
        badge?: string;
        image: string;
        href: string;
      }>;
    }> = [];

    try {
      categories = JSON.parse(rawData);
    } catch (e) {
      console.error('[ShowcaseBatch] Error al parsear data-showcase:', e);
      return;
    }

    if (!categories || categories.length === 0) return;

    // Nodos del DOM vinculados por selectores data-*
    const grid = container.querySelector<HTMLDivElement>('[data-showcase-grid]');
    const btnPrev = container.querySelector<HTMLButtonElement>('[data-btn-prev]');
    const btnNext = container.querySelector<HTMLButtonElement>('[data-btn-next]');
    const catPrev = container.querySelector<HTMLSpanElement>('[data-cat-prev]');
    const catActive = container.querySelector<HTMLHeadingElement>('[data-cat-active]');
    const catNext = container.querySelector<HTMLSpanElement>('[data-cat-next]');

    if (!grid) return;

    // Estado del cliente
    let currentCategoryIndex = 0;
    let isTransitioning = false;

    // Generador de plantillas HTML para cada tarjeta
    const createCardHTML = (post: typeof categories[0]['items'][0]) => `
      <a 
        href="${post.href}"
        class="group relative block aspect-video w-full rounded-md md:rounded-lg overflow-hidden bg-neutral-900 border border-white/10 shadow-lg hover:shadow-[0_16px_36px_rgba(0,0,0,0.85)] hover:border-white/30 transition-all duration-300 hover:scale-105 cursor-pointer z-10 hover:z-20"
      >
        <img 
          src="${post.image}" 
          alt="${post.title}"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-110 pointer-events-none"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 via-40% to-transparent pointer-events-none transition-opacity duration-300 group-hover:from-black"></div>
        ${post.badge ? `
          <div class="absolute top-2.5 left-2.5 z-10 flex items-center gap-1.5 px-2 py-0.5 rounded bg-black/70 backdrop-blur-md border border-white/10 text-[9px] sm:text-[10px] font-mono tracking-wider text-gray-300 uppercase pointer-events-none">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>${post.badge}</span>
          </div>
        ` : ''}
        <div class="absolute inset-x-0 bottom-0 p-3 sm:p-4 md:p-5 z-10 flex flex-col justify-end pointer-events-none">
          <h3 class="font-cinzel text-xs sm:text-sm md:text-base font-bold text-white tracking-wide uppercase line-clamp-2 drop-shadow-md group-hover:text-amber-200 transition-colors duration-200">
            ${post.title}
          </h3>
          ${post.dek ? `
            <p class="hidden sm:block text-[11px] md:text-xs text-gray-300/80 font-sans line-clamp-1 mt-1 font-normal drop-shadow">
              ${post.dek}
            </p>
          ` : ''}
        </div>
      </a>
    `;

    // Función principal de transición con Fade Out/In
    const navigateCategory = (delta: number) => {
      if (isTransitioning) return;
      isTransitioning = true;

      // Cálculo del nuevo índice en bucle infinito
      const total = categories.length;
      currentCategoryIndex = (currentCategoryIndex + delta + total) % total;

      const activeCat = categories[currentCategoryIndex];
      const prevCat = categories[(currentCategoryIndex - 1 + total) % total];
      const nextCat = categories[(currentCategoryIndex + 1) % total];

      // ── PASO 1: FADE OUT (Opacidad a 0) ──
      grid.classList.add('opacity-0', 'scale-[0.98]');

      // ── PASO 2: INYECCIÓN DE DATOS TRAS 300MS ──
      setTimeout(() => {
        // Actualizar textos del header
        if (catPrev) catPrev.textContent = prevCat.name;
        if (catActive) catActive.textContent = activeCat.name;
        if (catNext) catNext.textContent = nextCat.name;

        // Renderizar las nuevas 6 tarjetas
        grid.innerHTML = activeCat.items.map(createCardHTML).join('');

        // ── PASO 3: FADE IN (Opacidad a 100) ──
        requestAnimationFrame(() => {
          grid.classList.remove('opacity-0', 'scale-[0.98]');
          isTransitioning = false;
        });
      }, 300);
    };

    // Event Listeners de Chevrones
    btnPrev?.addEventListener('click', () => navigateCategory(-1));
    btnNext?.addEventListener('click', () => navigateCategory(1));

    // Clic en los nombres de categorías adyacentes para navegación intuitiva
    catPrev?.addEventListener('click', () => navigateCategory(-1));
    catNext?.addEventListener('click', () => navigateCategory(1));

    // Soporte para flechas del teclado cuando el componente está a la vista
    const handleKeydown = (e: KeyboardEvent) => {
      const rect = container.getBoundingClientRect();
      const inView = rect.top < window.innerHeight && rect.bottom > 0;
      if (!inView) return;

      if (e.key === 'ArrowLeft') {
        navigateCategory(-1);
      } else if (e.key === 'ArrowRight') {
        navigateCategory(1);
      }
    };
    window.addEventListener('keydown', handleKeydown);
  }

  // Inicialización compatible con Astro y View Transitions
  document.addEventListener('DOMContentLoaded', initShowcaseBatch);
  document.addEventListener('astro:page-load', initShowcaseBatch);
</script>
