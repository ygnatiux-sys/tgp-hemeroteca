interface Props {
  showHeader?: boolean;
  customKicker?: string;
  customTitle?: string;
  customDescription?: string;
}

const { 
  showHeader = true,
  customKicker = "Apple TV Dark Format · Dual Bento Gallery",
  customTitle = "Galería de Sombras & Memoria Lítica",
  customDescription = "Morfología vertical 4:5 en acabado obsidiana y grafito calibrado: fondo semioscuro de alto contraste que realza la volumetría de las piezas arqueológicas y su sombra de apoyo."
} = Astro.props;
---

<section class={`apple-dual-bento-dark-section w-full px-4 sm:px-6 relative z-10 ${showHeader ? 'py-16 sm:py-20' : 'pb-16'}`} id="showcase-dual-bento-dark">
  <!-- ENCABEZADO DE SECCIÓN EDITORIAL (DARK PREMIUM) -->
  {showHeader && (
    <div class="max-w-4xl mx-auto text-center mb-12 md:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/6 border border-white/10 text-white/70 text-[11px] font-mono tracking-widest uppercase mb-4 backdrop-blur-md">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        {customKicker}
      </div>
      <h2 class="font-gloock text-3xl sm:text-4xl md:text-5xl text-white tracking-tight mb-4">
        {customTitle}
      </h2>
      <p class="font-inter text-sm sm:text-base text-white/60 max-w-2xl mx-auto leading-relaxed font-light">
        {customDescription}
      </p>
    </div>
  )}

  <!-- CONTENEDOR VERTICAL APILADO (CARDS ANCHAS PARA PRIMERÍSIMO PLANO SIN CONSTRICCIÓN) -->
  <div class="max-w-6xl mx-auto w-full flex flex-col gap-12 sm:gap-16 items-center">

    <!-- TÍTULO PREFACIO DE TRACKING DINÁMICO #1 -->
    <div class="bento-tracking-interlude w-full text-center py-4 sm:py-6 overflow-hidden">
      <span class="font-mono text-[10px] sm:text-xs uppercase tracking-[0.45em] text-amber-400/80 block mb-2">
        SALA I · ROSTROS DE LA ANTIGÜEDAD
      </span>
      <h3 class="bento-tracking-title font-gloock font-black uppercase text-[clamp(2rem,5.8vw,4.8rem)] leading-[0.95] text-transparent bg-clip-text bg-linear-to-b from-white via-[#f3ede2] to-[#9b8d75] tracking-[0.28em]">
        EL ROSTRO DEL TIEMPO
      </h3>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         TARJETA BENTO DARK 1: NEFERTITI / HERMES / SAMOTRACIA (ANCHA + PRIMERÍSIMO PLANO)
         ═══════════════════════════════════════════════════════ -->
    <div 
      class="bento-dark-card group/bento relative w-full max-w-5xl rounded-4xl overflow-hidden bg-[#141418] border border-white/12 text-[#f5f5f7] shadow-[0_30px_80px_rgba(0,0,0,0.85),inset_0_1px_1px_rgba(255,255,255,0.1)] flex flex-col justify-between h-[92vh] min-h-205 md:min-h-235 max-h-255 select-none transition-all duration-500 hover:shadow-[0_36px_90px_rgba(0,0,0,0.95)] hover:border-amber-400/25"
      id="bento-dark-left"
      data-card-id="left"
    >
      <!-- HEADER EDITORIAL SUPERIOR -->
      <div class="pt-8 sm:pt-10 px-8 pb-2 text-center flex flex-col items-center z-20 relative">
        <!-- ICONO + KICKER APPLE STYLE -->
        <div class="inline-flex items-center gap-2 text-[10px] sm:text-[11px] font-mono tracking-[0.22em] uppercase text-white/50 mb-3">
          <span class="bento-icon-wrapper flex items-center justify-center w-5 h-5 rounded-full bg-white/8 text-amber-400 border border-white/10">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="12" cy="8" r="5"/>
              <path d="M12 13v8M9 16h6M9 5a3 3 0 016 0"/>
            </svg>
          </span>
          <span class="bento-kicker-text transition-opacity duration-500">{bentoLeftArtifacts[0].kicker}</span>
        </div>

        <!-- H3 PRINCIPAL EN DOS LÍNEAS -->
        <h3 class="bento-title-text font-inter font-bold text-2xl sm:text-[28px] lg:text-[32px] text-white tracking-tight leading-[1.15] transition-opacity duration-500">
          <span class="line-1 block">{bentoLeftArtifacts[0].titleLine1}</span>
          <span class="line-2 block font-medium text-white/70">{bentoLeftArtifacts[0].titleLine2}</span>
        </h3>

        <!-- LOGLINE CONCISO Y FILOSÓFICO -->
        <p class="bento-logline-text font-inter text-xs sm:text-[13px] text-white/60 font-normal leading-relaxed max-w-xs mt-2.5 transition-opacity duration-500">
          {bentoLeftArtifacts[0].logline}
        </p>

        <!-- ENLACE ACCIÓN APPLE CON CHEVRON -->
        <a 
          href={bentoLeftArtifacts[0].ctaLink} 
          class="bento-cta-link inline-flex items-center gap-1 text-xs sm:text-sm font-normal text-[#2997ff] hover:text-[#52aaff] mt-3 group/link transition-colors"
        >
          <span class="bento-cta-text">{bentoLeftArtifacts[0].ctaText}</span>
          <svg class="w-3.5 h-3.5 transform transition-transform group-hover/link:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </a>

        <!-- PILL CONTEXTUAL DE ÉPOCA Y MATERIAL -->
        <div class="mt-2.5 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white/6 border border-white/8 text-[10px] font-mono text-white/50 tracking-wider uppercase">
          <span class="w-1 h-1 rounded-full bg-amber-400"></span>
          <span class="bento-era-text">{bentoLeftArtifacts[0].era}</span>
        </div>
      </div>

      <!-- STAGE: PRIMERÍSIMO PRIMER PLANO MACRO CINEMATOGRÁFICO SIN CORTAR CABEZAS -->
      <div class="bento-stage mt-auto w-full relative grow flex justify-center items-end px-4 pb-0 overflow-hidden min-h-135 sm:min-h-155 md:min-h-175 z-10">
        <!-- CONTRALUZ DORADA + VIÑETA DRAMÁTICA -->
        <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_50%_42%,rgba(212,175,55,0.22)_0%,rgba(78,242,210,0.06)_40%,rgba(12,12,16,0.9)_78%)]"></div>
        <div class="absolute inset-x-0 top-0 h-10 bg-linear-to-b from-[#141418] to-transparent pointer-events-none z-20"></div>
        <div class="absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-[#0b0b0e] via-[#0b0b0e]/45 to-transparent pointer-events-none z-20"></div>

        <!-- ARRAY DE IMÁGENES EN PRIMERÍSIMO PRIMER PLANO (7 TEMAS) -->
        {bentoLeftArtifacts.map((art, idx) => (
          <div
            class={`bento-artifact-wrapper absolute inset-x-0 bottom-0 h-full flex justify-center items-end pt-3 transition-all duration-700 ease-out pointer-events-none ${
              idx === 0 
                ? "opacity-100 translate-y-0 scale-100 z-10" 
                : "opacity-0 translate-y-5 scale-[0.98] z-0 invisible"
            }`}
            data-index={idx}
          >
            <picture class="h-full w-full flex justify-center items-end overflow-hidden">
              <img 
                src={art.imageWebp} 
                data-fallback={art.fallbackWebp || ''}
                onerror="if(this.dataset.fallback && this.src !== this.dataset.fallback){this.src = this.dataset.fallback;}"
                alt={art.alt}
                loading="lazy"
                decoding="async"
                class="h-[112%] sm:h-[116%] w-auto max-w-[92%] object-contain object-top translate-y-6 bento-dark-statue-shadow transition-transform duration-700 scale-105 group-hover/bento:scale-[1.11]"
              />
            </picture>
          </div>
        ))}
      </div>

      <!-- PAGINACIÓN POR PUNTOS SUTILES EN DARK -->
      <div class="absolute top-5 right-6 z-30 flex items-center gap-1.5 bg-white/6 border border-white/8 px-2 py-1 rounded-full backdrop-blur-xs">
        {bentoLeftArtifacts.map((_, idx) => (
          <button 
            type="button"
            class={`bento-dot rounded-full transition-all duration-500 cursor-pointer ${
              idx === 0 ? "bg-white w-3.5 h-1.5" : "bg-white/25 w-1.5 h-1.5 hover:bg-white/50"
            }`}
            data-target-idx={idx}
            aria-label={`Ver artefacto ${idx + 1}`}
          />
        ))}
      </div>
    </div>

    <!-- TÍTULO INTERLUDIO DE TRACKING DINÁMICO #2 ENTRE CARDS -->
    <div class="bento-tracking-interlude w-full text-center py-6 sm:py-10 overflow-hidden">
      <div class="w-24 h-px bg-linear-to-r from-transparent via-amber-400/70 to-transparent mx-auto mb-6"></div>
      <span class="font-mono text-[10px] sm:text-xs uppercase tracking-[0.45em] text-[#4ef2d2]/80 block mb-2">
        SALA II · CANON &amp; MATERIA
      </span>
      <h3 class="bento-tracking-title font-gloock font-black uppercase text-[clamp(2rem,5.8vw,4.8rem)] leading-[0.95] text-transparent bg-clip-text bg-linear-to-b from-white via-[#f3ede2] to-[#9b8d75] tracking-[0.28em]">
        CANON DE LA SOMBRA
      </h3>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         TARJETA BENTO DARK 2: SANXINGDUI / APOLO / OLMECA (ANCHA + PRIMERÍSIMO PLANO)
         ═══════════════════════════════════════════════════════ -->
    <div 
      class="bento-dark-card group/bento relative w-full max-w-5xl rounded-4xl overflow-hidden bg-[#141418] border border-white/12 text-[#f5f5f7] shadow-[0_30px_80px_rgba(0,0,0,0.85),inset_0_1px_1px_rgba(255,255,255,0.1)] flex flex-col justify-between h-[92vh] min-h-205 md:min-h-235 max-h-255 select-none transition-all duration-500 hover:shadow-[0_36px_90px_rgba(0,0,0,0.95)] hover:border-amber-400/25"
      id="bento-dark-right"
      data-card-id="right"
    >
      <!-- HEADER EDITORIAL SUPERIOR -->
      <div class="pt-8 sm:pt-10 px-8 pb-2 text-center flex flex-col items-center z-20 relative">
        <!-- ICONO + KICKER APPLE STYLE -->
        <div class="inline-flex items-center gap-2 text-[10px] sm:text-[11px] font-mono tracking-[0.22em] uppercase text-white/50 mb-3">
          <span class="bento-icon-wrapper flex items-center justify-center w-5 h-5 rounded-full bg-white/8 text-amber-400 border border-white/10">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="12" cy="12" r="5"/>
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
            </svg>
          </span>
          <span class="bento-kicker-text transition-opacity duration-500">{bentoRightArtifacts[0].kicker}</span>
        </div>

        <!-- H3 PRINCIPAL EN DOS LÍNEAS -->
        <h3 class="bento-title-text font-inter font-bold text-2xl sm:text-[28px] lg:text-[32px] text-white tracking-tight leading-[1.15] transition-opacity duration-500">
          <span class="line-1 block">{bentoRightArtifacts[0].titleLine1}</span>
          <span class="line-2 block font-medium text-white/70">{bentoRightArtifacts[0].titleLine2}</span>
        </h3>

        <!-- LOGLINE CONCISO Y FILOSÓFICO -->
        <p class="bento-logline-text font-inter text-xs sm:text-[13px] text-white/60 font-normal leading-relaxed max-w-xs mt-2.5 transition-opacity duration-500">
          {bentoRightArtifacts[0].logline}
        </p>

        <!-- ENLACE ACCIÓN APPLE CON CHEVRON -->
        <a 
          href={bentoRightArtifacts[0].ctaLink} 
          class="bento-cta-link inline-flex items-center gap-1 text-xs sm:text-sm font-normal text-[#2997ff] hover:text-[#52aaff] mt-3 group/link transition-colors"
        >
          <span class="bento-cta-text">{bentoRightArtifacts[0].ctaText}</span>
          <svg class="w-3.5 h-3.5 transform transition-transform group-hover/link:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </a>

        <!-- PILL CONTEXTUAL DE ÉPOCA Y MATERIAL -->
        <div class="mt-2.5 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white/6 border border-white/8 text-[10px] font-mono text-white/50 tracking-wider uppercase">
          <span class="w-1 h-1 rounded-full bg-amber-400"></span>
          <span class="bento-era-text">{bentoRightArtifacts[0].era}</span>
        </div>
      </div>

      <!-- STAGE: PRIMERÍSIMO PRIMER PLANO MACRO CINEMATOGRÁFICO SIN CORTAR CABEZAS -->
      <div class="bento-stage mt-auto w-full relative grow flex justify-center items-end px-4 pb-0 overflow-hidden min-h-135 sm:min-h-155 md:min-h-175 z-10">
        <!-- CONTRALUZ CIAN/DORADA + VIÑETA DRAMÁTICA -->
        <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_50%_42%,rgba(78,242,210,0.18)_0%,rgba(212,175,55,0.08)_40%,rgba(12,12,16,0.9)_78%)]"></div>
        <div class="absolute inset-x-0 top-0 h-10 bg-linear-to-b from-[#141418] to-transparent pointer-events-none z-20"></div>
        <div class="absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-[#0b0b0e] via-[#0b0b0e]/45 to-transparent pointer-events-none z-20"></div>

        <!-- ARRAY DE IMÁGENES EN PRIMERÍSIMO PRIMER PLANO (7 TEMAS) -->
        {bentoRightArtifacts.map((art, idx) => (
          <div
            class={`bento-artifact-wrapper absolute inset-x-0 bottom-0 h-full flex justify-center items-end pt-3 transition-all duration-700 ease-out pointer-events-none ${
              idx === 0 
                ? "opacity-100 translate-y-0 scale-100 z-10" 
                : "opacity-0 translate-y-5 scale-[0.98] z-0 invisible"
            }`}
            data-index={idx}
          >
            <picture class="h-full w-full flex justify-center items-end overflow-hidden">
              <img 
                src={art.imageWebp} 
                data-fallback={art.fallbackWebp || ''}
                onerror="if(this.dataset.fallback && this.src !== this.dataset.fallback){this.src = this.dataset.fallback;}"
                alt={art.alt}
                loading="lazy"
                decoding="async"
                class="h-[112%] sm:h-[116%] w-auto max-w-[92%] object-contain object-top translate-y-6 bento-dark-statue-shadow transition-transform duration-700 scale-105 group-hover/bento:scale-[1.11]"
              />
            </picture>
          </div>
        ))}
      </div>

      <!-- PAGINACIÓN POR PUNTOS SUTILES EN DARK -->
      <div class="absolute top-5 right-6 z-30 flex items-center gap-1.5 bg-white/6 border border-white/8 px-2 py-1 rounded-full backdrop-blur-xs">
        {bentoRightArtifacts.map((_, idx) => (
          <button 
            type="button"
            class={`bento-dot rounded-full transition-all duration-500 cursor-pointer ${
              idx === 0 ? "bg-white w-3.5 h-1.5" : "bg-white/25 w-1.5 h-1.5 hover:bg-white/50"
            }`}
            data-target-idx={idx}
            aria-label={`Ver artefacto ${idx + 1}`}
          />
        ))}
      </div>
    </div>

  </div>
</section>

<!-- SCRIPT DE ORQUESTACIÓN ASÍNCRONA DESACOPLADA (DARK FORK) -->
<script define:vars={{ bentoLeftArtifacts, bentoRightArtifacts }}>
  document.addEventListener("DOMContentLoaded", () => {
    function setupBentoCard(cardElement, artifacts, intervalMs, initialDelayMs) {
      if (!cardElement) return;

      const wrappers = cardElement.querySelectorAll(".bento-artifact-wrapper");
      const kickerEl = cardElement.querySelector(".bento-kicker-text");
      const line1El = cardElement.querySelector(".bento-title-text .line-1");
      const line2El = cardElement.querySelector(".bento-title-text .line-2");
      const loglineEl = cardElement.querySelector(".bento-logline-text");
      const ctaLinkEl = cardElement.querySelector(".bento-cta-link");
      const ctaTextEl = cardElement.querySelector(".bento-cta-text");
      const eraTextEl = cardElement.querySelector(".bento-era-text");
      const dots = cardElement.querySelectorAll(".bento-dot");

      let currentIndex = 0;
      let timer = null;
      let isPaused = false;

      function goToIndex(nextIndex) {
        if (nextIndex === currentIndex) return;

        wrappers.forEach((w, i) => {
          if (i === nextIndex) {
            w.classList.remove("opacity-0", "translate-y-5", "scale-[0.98]", "z-0", "invisible");
            w.classList.add("opacity-100", "translate-y-0", "scale-100", "z-10");
          } else {
            w.classList.remove("opacity-100", "translate-y-0", "scale-100", "z-10");
            w.classList.add("opacity-0", "translate-y-5", "scale-[0.98]", "z-0");
            setTimeout(() => {
              if (i !== currentIndex) {
                w.classList.add("invisible");
              }
            }, 700);
          }
        });

        const data = artifacts[nextIndex];
        if (data) {
          if (kickerEl) kickerEl.textContent = data.kicker;
          if (line1El) line1El.textContent = data.titleLine1;
          if (line2El) line2El.textContent = data.titleLine2;
          if (loglineEl) loglineEl.textContent = data.logline;
          if (ctaTextEl) ctaTextEl.textContent = data.ctaText;
          if (ctaLinkEl) ctaLinkEl.setAttribute("href", data.ctaLink);
          if (eraTextEl) eraTextEl.textContent = data.era;
        }

        dots.forEach((dot, i) => {
          if (i === nextIndex) {
            dot.classList.add("bg-white", "w-3.5");
            dot.classList.remove("bg-white/25", "w-1.5");
          } else {
            dot.classList.remove("bg-white", "w-3.5");
            dot.classList.add("bg-white/25", "w-1.5");
          }
        });

        currentIndex = nextIndex;
      }

      function next() {
        const nextIdx = (currentIndex + 1) % artifacts.length;
        goToIndex(nextIdx);
      }

      function startLoop() {
        stopLoop();
        timer = setInterval(() => {
          if (!isPaused) {
            next();
          }
        }, intervalMs);
      }

      function stopLoop() {
        if (timer) clearInterval(timer);
      }

      setTimeout(() => {
        startLoop();
      }, initialDelayMs);

      cardElement.addEventListener("mouseenter", () => {
        isPaused = true;
      });
      cardElement.addEventListener("mouseleave", () => {
        isPaused = false;
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", (e) => {
          e.stopPropagation();
          const target = parseInt(dot.getAttribute("data-target-idx") || "0", 10);
          goToIndex(target);
          startLoop();
        });
      });
    }

    const cardLeft = document.getElementById("bento-dark-left");
    const cardRight = document.getElementById("bento-dark-right");

    setupBentoCard(cardLeft, bentoLeftArtifacts, 6000, 300);
    setupBentoCard(cardRight, bentoRightArtifacts, 6000, 3300);

    // Tracking dinámico en los títulos grandes que median entre las cards apiladas
    const trackingTitles = document.querySelectorAll(".bento-tracking-title");
    if (trackingTitles.length > 0 && "IntersectionObserver" in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-tracked");
            } else {
              entry.target.classList.remove("is-tracked");
            }
          });
        },
        { threshold: 0.35 }
      );
      trackingTitles.forEach((el) => obs.observe(el));
    }
  });
</script>

<style>
  .bento-tracking-title {
    transition: letter-spacing 1.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.9s ease;
    opacity: 0.72;
  }
  .bento-tracking-title.is-tracked {
    letter-spacing: -0.015em;
    opacity: 1;
  }
  .apple-dual-bento-dark-section {
    contain: layout style;
  }

  .bento-dark-card {
    will-change: transform, box-shadow;
  }

  /* Halo sutil de fondo para elevar el contraste contra las estatuas */
  .bento-ambient-glow {
    background: radial-gradient(circle at 50% 68%, rgba(255, 255, 255, 0.04) 0%, transparent 65%);
  }

  /* Sombra tridimensional contrastada en modo Dark */
  .bento-dark-statue-shadow {
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.75)) drop-shadow(0 6px 10px rgba(0, 0, 0, 0.5));
  }

  .bento-stage picture img {
    max-height: 100%;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
