interface Props {
  showHeader?: boolean;
}

const { showHeader = true } = Astro.props;
---

<section class={`apple-dual-bento-dark-section w-full px-4 sm:px-6 relative z-10 ${showHeader ? 'py-20' : 'pb-16'}`} id="showcase-dual-bento-dark">
  <!-- ENCABEZADO DE SECCIÓN EDITORIAL (DARK PREMIUM) -->
  {showHeader && (
    <div class="max-w-4xl mx-auto text-center mb-14 md:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/6 border border-white/10 text-white/70 text-[11px] font-mono tracking-widest uppercase mb-4 backdrop-blur-md">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        Apple TV Dark Format · Dual Bento Gallery
      </div>
      <h2 class="font-gloock text-3xl sm:text-4xl md:text-5xl text-white tracking-tight mb-4">
        Galería de Sombras & Memoria Lítica
      </h2>
      <p class="font-inter text-sm sm:text-base text-white/60 max-w-2xl mx-auto leading-relaxed font-light">
        Morfología vertical 4:5 en acabado obsidiana y grafito calibrado: fondo semioscuro de alto contraste que realza la volumetría de las piezas arqueológicas y su sombra de apoyo.
      </p>
    </div>
  )}

  <!-- CONTENEDOR GRID DUAL CENTRADO -->
  <div class="max-w-5xl mx-auto w-full grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 items-stretch justify-items-center">

    <!-- ═══════════════════════════════════════════════════════
         TARJETA BENTO DARK 1: HERMES / SAMOTRACIA / NEFERTITI
         ═══════════════════════════════════════════════════════ -->
    <div 
      class="bento-dark-card group/bento relative w-full max-w-115 rounded-4xl overflow-hidden bg-[#18181c] border border-white/10 text-[#f5f5f7] shadow-[0_24px_54px_rgba(0,0,0,0.65),inset_0_1px_1px_rgba(255,255,255,0.08)] flex flex-col justify-between aspect-4/5 min-h-130 md:min-h-145 select-none transition-all duration-500 hover:shadow-[0_32px_70px_rgba(0,0,0,0.85)] hover:border-white/16 hover:-translate-y-1"
      id="bento-dark-left"
      data-card-id="left"
    >
      <!-- HEADER EDITORIAL SUPERIOR -->
      <div class="pt-8 sm:pt-10 px-8 pb-2 text-center flex flex-col items-center z-20 relative">
        <!-- ICONO + KICKER APPLE STYLE -->
        <div class="inline-flex items-center gap-2 text-[10px] sm:text-[11px] font-mono tracking-[0.22em] uppercase text-white/50 mb-3">
          <span class="bento-icon-wrapper flex items-center justify-center w-5 h-5 rounded-full bg-white/8 text-amber-400 border border-white/10">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="12" cy="8" r="5"/>
              <path d="M12 13v8M9 16h6M9 5a3 3 0 016 0"/>
            </svg>
          </span>
          <span class="bento-kicker-text transition-opacity duration-500">{bentoLeftArtifacts[0].kicker}</span>
        </div>

        <!-- H3 PRINCIPAL EN DOS LÍNEAS -->
        <h3 class="bento-title-text font-inter font-bold text-2xl sm:text-[28px] lg:text-[32px] text-white tracking-tight leading-[1.15] transition-opacity duration-500">
          <span class="line-1 block">{bentoLeftArtifacts[0].titleLine1}</span>
          <span class="line-2 block font-medium text-white/70">{bentoLeftArtifacts[0].titleLine2}</span>
        </h3>

        <!-- LOGLINE CONCISO Y FILOSÓFICO -->
        <p class="bento-logline-text font-inter text-xs sm:text-[13px] text-white/60 font-normal leading-relaxed max-w-xs mt-2.5 transition-opacity duration-500">
          {bentoLeftArtifacts[0].logline}
        </p>

        <!-- ENLACE ACCIÓN APPLE CON CHEVRON -->
        <a 
          href={bentoLeftArtifacts[0].ctaLink} 
          class="bento-cta-link inline-flex items-center gap-1 text-xs sm:text-sm font-normal text-[#2997ff] hover:text-[#52aaff] mt-3 group/link transition-colors"
        >
          <span class="bento-cta-text">{bentoLeftArtifacts[0].ctaText}</span>
          <svg class="w-3.5 h-3.5 transform transition-transform group-hover/link:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </a>

        <!-- PILL CONTEXTUAL DE ÉPOCA Y MATERIAL -->
        <div class="mt-2.5 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white/6 border border-white/8 text-[10px] font-mono text-white/50 tracking-wider uppercase">
