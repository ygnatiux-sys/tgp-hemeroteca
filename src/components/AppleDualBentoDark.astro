  id: string;
  kickerIcon: string;
  kicker: string;
  titleLine1: string;
  titleLine2: string;
  logline: string;
  era: string;
  imageWebp: string;
  fallbackWebp?: string;
  alt: string;
  ctaText: string;
  ctaLink: string;
}

