---
/**
 * AppleDualBentoDark.astro
 * Fork Arquitectónico: Dual Bento Showcase Dark Edition (Apple TV 4K Master Reference).
 * Paleta Dark Calibrada: Fondo de tarjeta en grafito/obsidiana suave (#1a1a1f) contrastado
 * contra el fondo negro puro (#070709), permitiendo que la sombra de apoyo volumétrica
 * y el contorno de las estatuas recortadas proyecten profundidad tridimensional.
 * Rotación asíncrona de 3 artefactos por tarjeta (tríadas ontológicas del archivo TGP).
 */

interface Artifact {
  id: string;
  kickerIcon: string;
  kicker: string;
  titleLine1: string;
  titleLine2: string;
  logline: string;
  era: string;
  imageWebp: string;
  alt: string;
  ctaText: string;
  ctaLink: string;
}

const bentoLeftArtifacts: Artifact[] = [
  {
    id: "hermes",
    kickerIcon: "mercury",
    kicker: "HERMES · EL PSICOPOMPO",
    titleLine1: "El Dios de las Encrucijadas.",
    titleLine2: "Hermes y lo Liminal.",
    logline: "La frontera no se custodia: se constituye. Autopsia conceptual y arqueológica sobre el psicopompo y el kerykeion en el Mediterráneo antiguo.",
    era: "Vulci / Louvre G264 · c. 480 a.C.",
    imageWebp: "https://storage.thegreatpuzzleproject.com/vault-media/1792977769539-052061f8.webp",
    alt: "Estatua clásica de mármol de Hermes con caduceo",
    ctaText: "Explorar ensayo",
    ctaLink: "/ensayos/mercurio-hermes-arquetipo-liminal"
  },
  {
    id: "nike",
    kickerIcon: "wings",
    kicker: "SAMOTRACIA · DINÁMICA HELÉNICA",
    titleLine1: "La Victoria sin Rostro.",
    titleLine2: "El Vuelo en la Piedra.",
    logline: "El viento marino esculpido en el mármol de Paros. La proa de guerra que desafió el olvido del Mediterráneo.",
    era: "Pariano Helénico · c. 190 a.C.",
    imageWebp: "https://storage.thegreatpuzzleproject.com/vault-media/1792977775310-08f70d8d.webp",
    alt: "Estatua helenística de la Victoria Alada de Samotracia",
    ctaText: "Explorar ensayo",
    ctaLink: "/ensayos/amnesia-programada"
  },
  {
    id: "nefertiti",
    kickerIcon: "crown",
    kicker: "AMARNA · EL ROSTRO DEL TIEMPO",
    titleLine1: "El Silencio de Nefertiti.",
    titleLine2: "La Mirada en la Fractura.",
    logline: "Piedra caliza policromada y la cuenca vacía del ojo izquierdo: el rostro que emerge del polvo para interpelar la permanencia de la memoria.",
    era: "Taller de Tutmose · c. 1345 a.C.",
    imageWebp: "https://storage.thegreatpuzzleproject.com/vault-media/1792979907494-5629ca02.webp",
    alt: "Busto egipcio de la reina Nefertiti en caliza policromada",
    ctaText: "Explorar ensayo",
    ctaLink: "/ensayos/el-silencio-de-nefertiti-un-rostro-en-la-fractura-del-tiempo-6183"
  }
];

const bentoRightArtifacts: Artifact[] = [
  {
    id: "apollo",
    kickerIcon: "sun",
    kicker: "APOLO · EL ARQUERO SOLAR",
    titleLine1: "El Canon de la Luz.",
    titleLine2: "La Flecha Inmóvil.",
    logline: "La encarnación del orden apolíneo y la victoria sobre la serpiente Pitón: el ideal clásico antes de la fractura del cataclismo.",
    era: "Mármol Romano · c. 120–140 d.C.",
    imageWebp: "https://storage.thegreatpuzzleproject.com/vault-media/1792979909395-131dc59d.webp",
    alt: "Estatua clásica del Apolo de Belvedere en mármol",
    ctaText: "Explorar ensayo",
    ctaLink: "/ensayos/colapso-1177"
  },
  {
    id: "athena",
    kickerIcon: "shield",
    kicker: "ATENEA · LA INTELIGENCIA TÉCNICA",
    titleLine1: "La Razón Vigilante.",
    titleLine2: "Memoria de la Pólis.",
    logline: "El escudo con el rostro de la Gorgona y la mirada serena: la técnica y el logos preservados frente al cataclismo civilizatorio.",
    era: "Ático Clásico · c. 460 a.C.",
    imageWebp: "https://storage.thegreatpuzzleproject.com/vault-media/1792977773642-b069c3e0.webp",
    alt: "Estatua clásica de Atenea con yelmo, égida y lanza",
    ctaText: "Explorar ensayo",
    ctaLink: "/ensayos/la-geometria-petrea-de-pumapunku-andesita-tiempo-y-cosmos-3332"
  },
  {
    id: "jupiter",
    kickerIcon: "lightning",
    kicker: "JÚPITER · SOBERANÍA LÍTICA",
    titleLine1: "El Orden Arquetípico.",
    titleLine2: "La Potestad del Rayo.",
