  {
    id: "sanxingdui",
    kickerIcon: "mask",
    kicker: "SICHUAN · LA CIVILIZACIÓN INCINERADA",
    titleLine1: "La Máscara de Sanxingdui.",
    titleLine2: "El Rostro fuera del Canon.",
    logline: "Bronce monumental con pupilas cilíndricas proyectadas: una metalurgia soberana quebrada y enterrada ritualmente sin dejar una sola crónica escrita.",
