---
import { resolveMultivisionClass } from "../lib/multivision";
import Image from './SafeImage.astro';
import { sanitizeImageUrl, isValidImageSrc, normalizeCategory } from "../lib/content-filter";
import { recommendMetallicGradient } from "../lib/metallic-gradients";

// ─── FRASES EVOCATIVAS POR COLECCIÓN ─────────────────────────────────────────
const epigraphMap: Record<string, string> = {
  "arqueosemiotica":    "Los [[signos]] sobreviven a los imperios. **Cada glifo,** un mensaje lanzado a la eternidad sin destinatario conocido.",
  "filosofia":          "El pensamiento como [[territorio.]] Las **ideas no mueren:** se transforman, se heredan, se contradicen.",
  "mitologia":          "Antes del dato, existió el [[mito.]] El relato que **une cielo y tierra** antes de que la ciencia los separara.",
  "historia":           "El [[tiempo]] no es lineal. Es una **red de causas** que la memoria humana teje y desteje sin cesar.",
  "ensayos-cinematicos": "Imágenes que **piensan.** El [[cine]] como forma de conocimiento antes de que el conocimiento fuera escrito.",
  "arquetipos":         "Figuras que reaparecen en cada cultura. Los [[arquetipos]] son la gramática **secreta del ser humano.**",
  "arquetipos-globales": "Figuras que reaparecen en cada cultura. Los [[arquetipos]] son la gramática **secreta del ser humano.**",
  "historia-natural":   "La vida como **archivo.** Cada especie, un [[capítulo]] de una historia que empezó mucho antes que nosotros.",
  "historia-antigua":   "Las [[civilizaciones]] no colapsan: **se transforman.** Sus ruinas son preguntas, no respuestas.",
  "historia-medieval":  "Entre el [[fin del mundo]] romano y el alba del moderno, **siglos de invención** que el olvido llama oscuros.",
  "religion":           "Lo [[sagrado]] como necesidad primaria. **Cada fe,** un intento humano de darle nombre al misterio.",
};

function parseHeroPhrase(text: string) {
  if (!text) return '';
  const clean = text.replace(/^[#*`>\s]+/, '').trim();
  
  if (clean.includes("[[") || clean.includes("**")) {
    return clean
      .replace(/\*\*([^*]+)\*\*/g, '<strong class="text-white font-bold md:font-black">$1</strong>')
      .replace(/\[\[([^\]]+)\]\]/g, '<span class="italic text-amber-200/90 font-serif drop-shadow-[0_0_12px_rgba(245,158,11,0.5)]">$1</span>')
      .replace(/(^|[^*])\*([^*]+)\*([^*]|$)/g, '$1<span class="italic text-white/95 font-serif">$2</span>$3');
  }

  // Estilizado suave para excerpts planos: resalta las primeras dos palabras con serif ámbar
  const words = clean.split(' ');
  if (words.length > 3) {
    const firstTwo = words.slice(0, 2).join(' ');
    const rest = words.slice(2).join(' ');
    return `<span class="italic text-amber-200/90 font-serif">${firstTwo}</span> ${rest}`;
  }

  return clean;
}

/**
 * CinematicPostEngine.astro
 * ──────────────────────────────────────────────────────────────────────────────
 * Motor cinemático tipo Netflix para el Hero del Home de TGP.
 *
 * Comportamiento:
 *  - Auto-ciclo infinito (SLIDE_DURATION ms/slide), con animación GSAP.
 *  - Ken Burns muy lento y sutil en la imagen de fondo (scale 1→1.06).
 *  - Textos: fade-in desde abajo (efecto "Primicia") con stagger.
 *  - Metadatos: pulso suave (yoyo opacidad 0.35↔1, repeat -1).
 *  - Salida: fade-out general suave antes del siguiente slide.
 *  - Control manual: drag/swipe (finger o cursor) → pausa auto → reinicia auto
 *    tras 8 s de inactividad.
 *  - Dots de paginación con transición de ancho.
 *  - Barra de progreso en la base del hero.
 *  - Sin fundido hacia abajo: el hero ocupa h-dvh y el contenido fluye debajo.
 *
 * Props:
 *  slides: SlideData[]  — Array de posts recientes desde el servidor Astro.
 *
 * Hereda: paleta CSS (--bg-main, rust-orange, cinzel, mono, serif), botones y
 * estilos globales. Nada se cambia sin autorización.
 */

export interface SlideData {
  id: string;
  title: string;
  subtitle?: string;
  excerpt?: string;
  description?: string;
  category?: string;
  date?: string;
  readTime?: string;
  image: any;
  imagePosition?: string;
  titlePosition?: 'top' | 'bottom' | 'center';
  link: string;
  papersLink?: string;
}

interface Props {
  slides: SlideData[];
  heightClass?: string;
  maxSlides?: number;
}

const { slides = [], heightClass = "h-dvh", maxSlides = 15 } = Astro.props;
const safeSlides = (slides.length > 0 ? slides : []).slice(0, maxSlides);
---

{
  safeSlides.length > 0 && (
    <section
      class={`cpe-root relative w-full ${heightClass} overflow-hidden bg-black rounded-2xl md:rounded-3xl select-none mb-[25vh] md:mb-[35vh] [contain-intrinsic-size:auto_100vh]`}
      aria-label="Cartelera Cinemática TGP"
    >
      {/* ── SLIDES ── */}
      <div class="cpe-slides absolute inset-0">
        {safeSlides.map((slide: SlideData, i: number) => {
          const safeSrc = (slide.image && isValidImageSrc(slide.image)) ? sanitizeImageUrl(slide.image) : "";
          const categoryKey = normalizeCategory(slide.category || '');
          const heroPhraseRaw = slide.subtitle || slide.excerpt || slide.description || epigraphMap[categoryKey] || null;
          const heroPhraseHTML = heroPhraseRaw ? parseHeroPhrase(heroPhraseRaw) : '';
          const mode = i % 3; // 0: Izquierda | 1: Derecha | 2: Base / Abajo

          // Detección automática por RegEx para personajes/retratos centrados + lectura de propiedad explícita
          const explicitPos = slide.titlePosition || null;
          const isSubjectPortrait = /hegel|homero|saturno|busto|estatua|retrato|filosofia|moctezuma|gengis|tatu|rostro|portrait|escultura|venus|urano|arquetipo|personaje|aguara|fauna|animal/i.test(
            `${slide.title} ${slide.id} ${slide.category || ''}`
          );
          const titlePos = explicitPos || (isSubjectPortrait ? "top" : "bottom");
          const explicitBgContrast = slide.bgContrast || null;
          const bgContrast = explicitBgContrast || (titlePos === "top" ? "light" : "dark");
          const { gradientClass, strokeClass } = recommendMetallicGradient(
            slide.category || '',
            slide.title || '',
            bgContrast
          );
          
          return (
            <article
              class={`cpe-slide absolute inset-0 flex justify-center backface-hidden transform-3d will-change-transform [content-visibility:auto] contain-content ${titlePos === "top" ? "items-start pt-24 sm:pt-28 md:pt-36 pb-8" : "items-end pb-24 md:pb-32 pt-8"} ${i === 0 ? "z-20" : "z-10 opacity-0 pointer-events-none"}`}
              style={`z-index: ${100 - i}; transform: translateZ(1px);`}
              data-index={i}
              data-title-pos={titlePos}
              data-bg-contrast={bgContrast}
              {...(i !== 0 ? { "aria-hidden": "true" } : {})}
            >
              {/* Fondo: Ken Burns */}
              <div class="cpe-bg-wrap absolute inset-0 overflow-hidden">
                {safeSrc ? (
                  <Image
                    src={safeSrc}
                    alt={slide.title}
                    class="cpe-bg-img absolute inset-0 scale-100 img-nativa"
                    style={`object-position: ${slide.imagePosition || "center center"};`}
                    inferSize={true}
                    format="webp"
                    widths={[400, 768, 1200, 1920]}
                    sizes="(max-width: 768px) 400px, (max-width: 1200px) 768px, 1200px"
                    loading={i < 2 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : undefined}
                    decoding="async"
                  />
                ) : (
                  <div class="fallback-background absolute inset-0 bg-stone-900 pointer-events-none -z-10" />
                )}
              </div>

              {/* Capa Cinemática (Frase / Excerpt) — Modo 0: Derecha | Modo 1: Izquierda | Modo 2: Base / Abajo */}
              {heroPhraseHTML && (
                <div class={`cpe-hero-cinematic-layer absolute inset-0 opacity-0 pointer-events-none z-15 flex ${mode === 0 ? "justify-end items-center" : mode === 1 ? "justify-start items-center" : "justify-center items-end"}`}>
                  <div class={`${mode === 2 ? "w-full max-w-5xl px-6 md:px-12 text-center bg-linear-to-t from-black via-black/85 to-transparent pt-16 md:pt-24 pb-8 md:pb-12" : "w-full md:w-[48%] lg:w-[42%] h-full flex items-center justify-center p-6 sm:p-10 md:p-12 lg:p-16"} ${mode === 0 ? "bg-linear-to-t md:bg-linear-to-r from-transparent via-black/90 to-black" : mode === 1 ? "bg-linear-to-t md:bg-linear-to-l from-transparent via-black/90 to-black" : ""}`}>
                    <p class={`cpe-hero-cinematic-text font-serif text-xl sm:text-2xl md:text-3xl ${mode === 2 ? "lg:text-[2.6rem]" : "lg:text-[2.75rem]"} text-[#E3DDD3]/95 leading-tight tracking-tight drop-shadow-2xl text-balance ${mode === 0 ? "text-center md:text-left max-w-[34ch]" : mode === 1 ? "text-center md:text-right max-w-[34ch]" : "text-center max-w-[42ch] mx-auto"}`}>
                      <span class="cpe-hero-text-anim inline-block opacity-0" set:html={heroPhraseHTML}></span>
                    </p>
                  </div>
                </div>
              )}

              {/* Contenido Editorial — Siempre Centrado (Etapa 1 & 4 General) */}
              <div class={`cpe-content relative z-20 w-full max-w-7xl mx-auto px-6 md:px-12 lg:px-20 flex flex-col gap-6 opacity-0 ${titlePos === "top" ? "pt-4 md:pt-8" : "pb-6 md:pb-10"}`}>
                
                {/* Bloque Principal Centrado */}
                <div class="flex flex-col items-center text-center mx-auto max-w-4xl gap-3 md:gap-5">
                  {/* 1. Metadatos superiores: Pulso suave GSAP */}
                  <div class="cpe-meta flex items-center justify-center gap-3">
                    <span class="inline-flex items-center gap-2 font-metadata text-[9px] md:text-[10px] uppercase tracking-[0.4em] text-[#EFEBE3]">
                      <span class="cpe-meta-dot w-1.5 h-1.5 rounded-full bg-rust-orange inline-block shadow-[0_0_6px_rgba(239, 235, 227,0.8)]" />
                      {slide.category || "Investigación"}
                    </span>
                    {slide.date && (
                      <span class="font-metadata text-[8.5px] uppercase tracking-[0.3em] text-white/35">
                        {slide.date}
                      </span>
                    )}
                    {slide.readTime && (
                      <>
                        <span class="text-white/20 text-xs">·</span>
                        <span class="font-metadata text-[8.5px] uppercase tracking-[0.25em] text-white/35">
                          {slide.readTime} lectura
                        </span>
                      </>
                    )}
                  </div>

                  {/* 2. Título Centrado */}
                  <h1 class="cpe-title font-cinzel font-black text-3xl sm:text-4xl md:text-5xl lg:text-[4.5rem] leading-[1.05] tracking-tight text-pretty group-hover:scale-[1.01] transition-transform duration-700 ease-out origin-center text-center">
                    <a
                      href={slide.link}
                      class:list={[gradientClass, strokeClass, "inline-block drop-shadow-[0_4px_28px_rgba(0,0,0,0.95)] transition-all duration-500"]}
                    >
                      {slide.title}
                    </a>
                  </h1>

                  {/* 3. CTA con Destaque Centrado */}
                  <div class="cpe-cta flex items-center justify-center gap-4 mt-2 flex-wrap shrink-0">
                    <a
                      href={slide.link}
                      class="group inline-flex items-center gap-3 px-6 py-3 md:px-8 md:py-3.5 bg-white/5 md:backdrop-blur-md border border-white/20 text-[#E0E0E0] font-metadata font-bold text-xs tracking-[0.25em] uppercase rounded-full hover:bg-white/10 hover:border-white/40 hover:text-white transition-all duration-400 active:scale-95"
                    >
                      <span>Ver Hemeroteca</span>
                      <span class="opacity-50 group-hover:translate-x-1 transition-transform">
                        ▸
                      </span>
                    </a>
                    {slide.papersLink && (
                      <a
                        href={slide.papersLink}
                        class="group inline-flex items-center gap-3 px-6 py-3 md:px-8 md:py-3.5 bg-transparent border border-white/15 text-white/55 font-metadata font-bold text-xs tracking-[0.25em] uppercase rounded-full hover:bg-white/5 hover:border-white/30 hover:text-white transition-all duration-400 active:scale-95"
                      >
                        <span>Leer Dossier</span>
                        <span class="opacity-40 group-hover:translate-x-1 transition-transform">
                          ▸
                        </span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      {/* ── TOOLBAR / CONTROLES AUTO-HIDE (dots, flechas) ── */}
      {safeSlides.length > 1 && (
        <div
          class="cpe-toolbar absolute inset-0 w-full z-30 pointer-events-none opacity-0 transition-opacity duration-500"
        >
          {/* Dots de paginación */}
          <nav
            class="cpe-dots absolute bottom-7 md:bottom-8 left-1/2 -translate-x-1/2 flex flex-wrap justify-center items-center gap-1.5 md:gap-2 max-w-[92vw] pointer-events-auto z-50"
            aria-label="Indicadores de slide"
          >
            {safeSlides.map((_: SlideData, i: number) => (
              <button
                class={`cpe-dot h-1.5 rounded-full transition-all duration-500 cursor-pointer border-0 p-0 ${i === 0 ? 'w-6 md:w-8 bg-white' : 'w-1.5 md:w-2 bg-white/30 hover:bg-white/60'}`}
                data-dot={i}
                aria-label={`Ir al slide ${i + 1}`}
              />
            ))}
          </nav>

          {/* Flecha Prev */}
          <button
            class="cpe-arrow cpe-prev absolute left-4 md:left-8 top-1/2 -translate-y-1/2 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center lantern-hover transition-all duration-300 active:scale-90 pointer-events-auto md:shadow-lg z-50"
            aria-label="Anterior"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>

           {/* Flecha Next */}
          <button
            class="cpe-arrow cpe-next absolute right-4 md:right-8 top-1/2 -translate-y-1/2 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center lantern-hover transition-all duration-300 active:scale-90 pointer-events-auto md:shadow-lg z-50"
            aria-label="Siguiente"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      )}
      
      {/* Barra de progreso — Línea punteada estática */}
      <div class="absolute bottom-0 left-0 w-full h-0.5 border-b border-dotted border-[#EFEBE3]/25 cpe-progress z-30"></div>
    </section>
  )
}

<script>
  import gsap from "gsap";

  const SLIDE_DURATION = 14500; // ms por slide
  const AUTO_RESUME = 8000; // ms de inactividad → retoma auto
  const KB_SCALE = 1.06; // Ken Burns scale destino
  const FADE_DUR = 1.1; // s para cross-fade entre slides
  const SWIPE_THRESHOLD = 50; // px mínimos para contar como swipe

  function initCPE() {
    const roots = Array.from(
      document.querySelectorAll<HTMLElement>(".cpe-root"),
    );
    if (roots.length === 0) return;

    roots.forEach((root) => {
      if (root.dataset.cpeInitialized === "true") return;
      root.dataset.cpeInitialized = "true";

      const slideEls = Array.from(
        root.querySelectorAll<HTMLElement>(".cpe-slide"),
      );
      const dotEls = Array.from(root.querySelectorAll<HTMLElement>(".cpe-dot"));
      const progress = root.querySelector<HTMLElement>(".cpe-progress");
      const prevBtn = root.querySelector<HTMLElement>(".cpe-prev");
      const nextBtn = root.querySelector<HTMLElement>(".cpe-next");
      const toolbar = root.querySelector<HTMLElement>(".cpe-toolbar");
      const total = slideEls.length;

      if (total === 0) return;

      // Estado estático estándar en móvil (primer slide visible y activo)
      if (slideEls[0]) {
        slideEls[0].classList.remove("pointer-events-none");
        slideEls[0].removeAttribute("aria-hidden");
        slideEls[0].style.opacity = "1";
      }

      /* ── 1. Aislamiento de GSAP con matchMedia (Escritorio: min-width: 768px) ── */
      const mm = gsap.matchMedia();

      mm.add("(min-width: 768px)", () => {
        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        let current = 0;
        let isAnimating = false;
        let autoTimer: ReturnType<typeof setTimeout> | undefined;
        let resumeTimer: ReturnType<typeof setTimeout> | undefined;
        let toolbarTimer: ReturnType<typeof setTimeout> | undefined;
        let progressTween: gsap.core.Tween | undefined;
        let metaPulseTween: gsap.core.Tween | undefined;

        /* ── Auto-hide de Toolbar en movimiento / hover ── */
        function showToolbar() {
          if (!toolbar) return;
          toolbar.classList.remove("opacity-0");
          toolbar.classList.add("opacity-100");
        }

        function hideToolbar() {
          if (!toolbar) return;
          toolbar.classList.remove("opacity-100");
          toolbar.classList.add("opacity-0");
        }

        function resetToolbarTimer() {
          showToolbar();
          clearTimeout(toolbarTimer);
          toolbarTimer = setTimeout(() => {
            hideToolbar();
          }, 2800);
        }

        root.addEventListener("mousemove", resetToolbarTimer);
        root.addEventListener("mouseenter", resetToolbarTimer);
        root.addEventListener("touchstart", resetToolbarTimer, { passive: true });
        root.addEventListener("mouseleave", () => {
          clearTimeout(toolbarTimer);
          hideToolbar();
        });

        /* ── Entrada de slide ── */
        function slideIn(slide: HTMLElement, done: (() => void) | null) {
          const bg = slide.querySelector<HTMLElement>(".cpe-bg-img");
          const metaEl = slide.querySelector<HTMLElement>(".cpe-meta");
          const titleEl = slide.querySelector<HTMLElement>(".cpe-title");
          const ctaEl = slide.querySelector<HTMLElement>(".cpe-cta");
          const dot = slide.querySelector<HTMLElement>(".cpe-meta-dot");
          const cpeContent = slide.querySelector<HTMLElement>(".cpe-content");
          const cinematicLayer = slide.querySelector<HTMLElement>(".cpe-hero-cinematic-layer");
          const textAnim = slide.querySelector<HTMLElement>(".cpe-hero-text-anim");

          slide.classList.remove("pointer-events-none");
          slide.setAttribute("aria-hidden", "false");
          slide.style.zIndex = "20";

          if (reduceMotion) {
            gsap.set(slide, { opacity: 1 });
            if (cpeContent) gsap.set(cpeContent, { opacity: 1 });
            done?.();
            return;
          }

          if ((slide as any)._cpeTimeline) {
            (slide as any)._cpeTimeline.kill();
          }
          const tl = gsap.timeline();
          (slide as any)._cpeTimeline = tl;

          /* Slide fade-in */
          tl.fromTo(
            slide,
            { opacity: 0 },
            { 
              opacity: 1, 
              duration: 0.85, 
              ease: "power2.inOut",
              onComplete: () => done?.()
            },
            0,
          );

          /* Ken Burns: escala milimétrica y ascenso vertical suave */
          if (bg) {
            gsap.set(bg, { scale: 1, yPercent: 0 });
            gsap.to(bg, {
              scale: 1.045,
              yPercent: -2.5,
              duration: SLIDE_DURATION / 1000 + FADE_DUR,
              ease: "none",
            });
          }

          const slideIdx = parseInt(slide.dataset.index || "0", 10);
          const mode = slideIdx % 3;

          const textIntroEls = [metaEl, titleEl].filter(Boolean) as HTMLElement[];
          const textFullEls = [metaEl, titleEl, ctaEl].filter(Boolean) as HTMLElement[];

          // ── PASO 1: Aparición inicial del Título + Metadatos con Staggering ──
          if (cpeContent) gsap.set(cpeContent, { opacity: 1 });
          if (ctaEl) gsap.set(ctaEl, { opacity: 0 }); // Oculta CTA inicialmente

          if (textIntroEls.length > 0) {
            tl.fromTo(
              textIntroEls,
              { opacity: 0, y: 22, filter: "blur(4px)" },
              { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.75, stagger: 0.12, ease: "power3.out" },
              0.25
            );

            // Pausa de lectura inicial del título
            tl.to({}, { duration: 1.4 });

            // PASO 2: El Título se desvanece suavemente
            tl.to(textIntroEls, {
              opacity: 0,
              y: -12,
              filter: "blur(6px)",
              duration: 0.6,
              ease: "power2.in",
            });
          }

          // ── PASO 3: Desplazamiento / Elevación de imagen + Aparición de Mask Shadow & Frase ──
          if (cinematicLayer && textAnim) {
            const panX = mode === 0 ? -7 : mode === 1 ? 7 : 0;
            const panY = mode === 2 ? -12 : -2.5;

            // Paneo lateral (Modos 0 y 1) o Elevación vertical (Modo 2) con escala 1.14 para despejar zona mask sin vacíos rectos negros
            if (bg) {
              tl.to(bg, { scale: 1.14, xPercent: panX, yPercent: panY, duration: 1.5, ease: "power2.out" }, "-=0.2");
            }

            // Capa de mask shadow entra rápido (0.45s) al instante que arranca la apertura para cubrir el gap de inmediato
            tl.to(cinematicLayer, { opacity: 1, duration: 0.45, ease: "power2.out" }, "<");

            // La frase se escribe en sincronía con el desplazamiento/elevación
            tl.fromTo(
              textAnim,
              { opacity: 0, y: 14, scale: 0.98, filter: "blur(4px)" },
              { opacity: 1, y: 0, scale: 1, filter: "blur(0px)", duration: 0.65, ease: "power2.out" },
              "<0.05"
            );

            // Pausa contemplativa de la frase escrita en zona mask
            tl.to({}, { duration: 3.2 });

            // Salida sin gaps: la frase se desvanece rápido y la sombra protectora se desvanece suavemente MIENTRAS la imagen re-encuadra
            tl.to(textAnim, { opacity: 0, filter: "blur(4px)", y: -6, duration: 0.35, ease: "power2.in" });
            if (bg) {
              tl.to(bg, { scale: 1.045, xPercent: 0, yPercent: -2.5, duration: 1.2, ease: "power2.inOut" }, "-=0.1");
            }
            tl.to(cinematicLayer, { opacity: 0, duration: 0.9, ease: "power2.inOut" }, "<");
          }

          // ── PASO 4: Aparece Título + Metadatos + CTA Destaque ──
          if (textFullEls.length > 0) {
            tl.set(ctaEl, { scale: 1, y: 0 });
            tl.fromTo(
              textFullEls,
              { opacity: 0, y: 20, filter: "blur(4px)" },
              { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.75, stagger: 0.12, ease: "power3.out" },
              "+=0.1"
            );

            // Pausa con CTA destacado activo
            tl.to({}, { duration: 2.2 });

            // ✦ PASO 4.5 (NUEVO PASO): El Título y Metadatos se retiran,
            // el CTA queda SOLO en tamaño 1px mayor (+luminosidad) antes de desvanecer
            if (textIntroEls.length > 0) {
              tl.to(textIntroEls, {
                opacity: 0,
                y: -14,
                filter: "blur(6px)",
                duration: 0.65,
                ease: "power2.in",
              });
            }

            if (ctaEl) {
              tl.to(ctaEl, {
                scale: 1.04, // 1px mayor en tamaño físico de forma armónica
                y: -2,
                filter: "drop-shadow(0 0 20px rgba(255,255,255,0.25))",
                duration: 0.55,
                ease: "power2.out",
              }, "<0.1");

              // Pausa con CTA solitario destacado activo
              tl.to({}, { duration: 2.0 });

              // El CTA se desvanece suavemente
              tl.to(ctaEl, {
                opacity: 0,
                y: -8,
                scale: 1.01,
                filter: "blur(6px)",
                duration: 0.75,
                ease: "power2.inOut",
              });
            }

            // ── PASO 5: IMAGEN NUDA (Protagonista visual pura, límpida y sin filtros) ──
            tl.to({}, { duration: 2.2 });
          }

          /* Pulso del dot: yoyo opacidad */
          if (dot) {
            metaPulseTween?.kill();
            metaPulseTween = gsap.to(dot, {
              opacity: 0.35,
              duration: 1.4,
              ease: "sine.inOut",
              yoyo: true,
              repeat: -1,
              delay: 0.8,
            });
          }
        }

        /* ── Salida de slide ── */
        function slideOut(slide: HTMLElement, done: (() => void) | null) {
          if ((slide as any)._cpeTimeline) {
            (slide as any)._cpeTimeline.kill();
          }
          
          if (reduceMotion) {
            gsap.set(slide, { opacity: 0 });
            slide.classList.add("pointer-events-none");
            slide.setAttribute("aria-hidden", "true");
            slide.style.zIndex = "10";
            done?.();
            return;
          }
          gsap.to(slide, {
            opacity: 0,
            duration: FADE_DUR * 0.85,
            ease: "power2.inOut",
            onComplete: () => {
              slide.classList.add("pointer-events-none");
              slide.setAttribute("aria-hidden", "true");
              slide.style.zIndex = "10";
              done?.();
            },
          });
        }

        /* ── Dots ── */
        function updateDots(idx: number) {
          dotEls.forEach((d, i) => {
            const active = i === idx;
            d.classList.toggle("w-6", active);
            d.classList.toggle("md:w-8", active);
            d.classList.toggle("bg-[#EFEBE3]", active);
            d.classList.toggle("w-1.5", !active);
            d.classList.toggle("md:w-2", !active);
            d.classList.toggle("bg-white/30", !active);
          });
        }

        /* ── Barra de progreso ── */
        function startProgress() {
          progressTween?.kill();
        }

        /* ── Ir al slide idx ── */
        function goTo(idx: number) {
          if (isAnimating || idx === current) return;
          isAnimating = true;

          const prevIdx = current;
          const nextIdx = ((idx % total) + total) % total;
          current = nextIdx;
          updateDots(current);
          startProgress();

          slideEls[nextIdx].style.zIndex = "20";
          slideEls[prevIdx].style.zIndex = "15";

          /* Cross-fade: salida del anterior, entrada del nuevo en paralelo */
          slideOut(slideEls[prevIdx], null);
          slideIn(slideEls[nextIdx], () => {
            isAnimating = false;
          });
        }

        /* ── Auto-avance ── */
        function scheduleNext() {
          clearTimeout(autoTimer);
          autoTimer = setTimeout(() => {
            goTo((current + 1) % total);
            scheduleNext();
          }, SLIDE_DURATION);
        }

        function pauseAuto() {
          clearTimeout(autoTimer);
          clearTimeout(resumeTimer);
          progressTween?.pause();
        }

        function resumeAuto() {
          clearTimeout(resumeTimer);
          resumeTimer = setTimeout(() => {
            progressTween?.play();
            scheduleNext();
          }, AUTO_RESUME);
        }

        /* ── Botones ── */
        const onPrev = (e: MouseEvent) => {
          e.stopPropagation();
          pauseAuto();
          goTo((current - 1 + total) % total);
          resumeAuto();
        };
        const onNext = (e: MouseEvent) => {
          e.stopPropagation();
          pauseAuto();
          goTo((current + 1) % total);
          resumeAuto();
        };

        prevBtn?.addEventListener("click", onPrev);
        nextBtn?.addEventListener("click", onNext);

        /* ── Dots click ── */
        const dotListeners: Array<{ el: HTMLElement; fn: (e: MouseEvent) => void }> = [];
        dotEls.forEach((d) => {
          const fn = (e: MouseEvent) => {
            e.stopPropagation();
            const idx = Number(d.dataset["dot"]);
            if (idx === current) return;
            pauseAuto();
            goTo(idx);
            resumeAuto();
          };
          d.addEventListener("click", fn);
          dotListeners.push({ el: d, fn });
        });

        /* ── Swipe / drag (respetando clicks en enlaces/botones) ── */
        let dragStartX = 0;
        let isDragging = false;

        const onPointerDown = (e: PointerEvent) => {
          const target = e.target as HTMLElement | null;
          if (target?.closest("a, button, nav, input, select")) return;
          dragStartX = e.clientX;
          isDragging = true;
          pauseAuto();
          (root as HTMLElement).setPointerCapture(e.pointerId);
        };

        const onPointerUp = (e: PointerEvent) => {
          if (!isDragging) return;
          isDragging = false;
          const delta = e.clientX - dragStartX;
          if (Math.abs(delta) > SWIPE_THRESHOLD) {
            goTo(
              delta < 0 ? (current + 1) % total : (current - 1 + total) % total,
            );
          }
          resumeAuto();
        };

        const onPointerCancel = () => {
          isDragging = false;
          resumeAuto();
        };

        root.addEventListener("pointerdown", onPointerDown);
        root.addEventListener("pointerup", onPointerUp);
        root.addEventListener("pointercancel", onPointerCancel);

        /* ── Teclado (solo responde si este root está visible) ── */
        const onKey = (e: KeyboardEvent) => {
          if (!root.isConnected || root.offsetParent === null) return;
          if (e.key === "ArrowLeft") {
            pauseAuto();
            goTo((current - 1 + total) % total);
            resumeAuto();
          }
          if (e.key === "ArrowRight") {
            pauseAuto();
            goTo((current + 1) % total);
            resumeAuto();
          }
        };
        document.addEventListener("keydown", onKey);

        /* ── Arranque Desktop ── */
        gsap.set(slideEls[0], { opacity: 1 });
        slideEls[0].classList.remove("pointer-events-none");
        slideEls[0].removeAttribute("aria-hidden");
        if (!reduceMotion) slideIn(slideEls[0], null);

        updateDots(0);
        startProgress();
        resetToolbarTimer();
        if (total > 1) scheduleNext();

        return () => {
          clearTimeout(autoTimer);
          clearTimeout(resumeTimer);
          clearTimeout(toolbarTimer);
          progressTween?.kill();
          metaPulseTween?.kill();
          gsap.killTweensOf(slideEls);
          gsap.killTweensOf(Array.from(root.querySelectorAll(".cpe-bg-img")));
          prevBtn?.removeEventListener("click", onPrev);
          nextBtn?.removeEventListener("click", onNext);
          dotListeners.forEach(({ el, fn }) => el.removeEventListener("click", fn));
          root.removeEventListener("pointerdown", onPointerDown);
          root.removeEventListener("pointerup", onPointerUp);
          root.removeEventListener("pointercancel", onPointerCancel);
          document.removeEventListener("keydown", onKey);
        };
      });

      /* ── Cleanup Global Astro ── */
      document.addEventListener(
        "astro:before-swap",
        () => {
          mm.revert();
        },
        { once: true },
      );
    });
  }

  document.addEventListener("DOMContentLoaded", initCPE);
  document.addEventListener("astro:page-load", initCPE);
</script>

<style>
  /* Evita drag de imagen nativo */
  .cpe-root img {
    user-drag: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* Cursor grab en desktop y pointer en enlaces/botones */
  @media (pointer: fine) {
    .cpe-root {
      cursor: grab;
    }
    .cpe-root:active {
      cursor: grabbing;
    }

    .cpe-root a,
    .cpe-root button,
    .cpe-root [role="button"],
    .cpe-arrow,
    .cpe-dot {
      cursor: pointer !important;
    }
  }

  /* GPU layers para fluidez — backface-hidden evita Z-fighting en cross-fade */
  .cpe-slide {
    will-change: opacity;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .cpe-bg-img {
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Dots: transición de ancho fluida */
  .cpe-dot {
    transition:
      width 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.4s ease;
  }

  /* 2. Optimización CSS H1: Gradiente estático en móvil (< md), animación de movimiento activa solo en escritorio (md+) */
  .cpe-title a.gradient-acero-ios,
  .cpe-title .gradient-acero-ios {
    animation: none !important;
    will-change: auto !important;
  }

  @media (min-width: 768px) {
    .cpe-title a.gradient-acero-ios,
    .cpe-title .gradient-acero-ios {
      animation: titaniumMetallicSweep 16s ease-in-out infinite !important;
      will-change: background-position !important;
    }
  }

  /* Título: Hover en degradado de titanio (Ash White con brillo suave) */
  .cpe-title a.gradient-acero-ios:hover {
    background: none !important;
    -webkit-text-fill-color: #EFEBE3 !important;
    color: #EFEBE3 !important;
    text-shadow: 0 0 10px rgba(239, 235, 227, 0.45);
    filter: drop-shadow(0 0 8px rgba(239, 235, 227, 0.35));
  }
</style>
