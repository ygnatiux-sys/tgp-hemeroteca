---
/**
 * TriplicoRevelacion.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Tríptico de Revelación — Cinematic Reveal Loop
 *
 * Tres actos superpuestos con crossfade GSAP (autoAlpha):
 *   Acto I  (Novedades)   → Grid de 3 tarjetas de posts recientes
 *   Acto II (Profundidad) → Bento Card a pantalla completa con imagen hero
 *   Acto III (Umbral)     → CTA minimalista "Explorar colecciones"
 *
 * Dimensiones: w-full, h = 62vh (equivalente a ~3 tarjetas individuales)
 * Ubicación en About: antes del footer, después de MubiBlockCinematic.
 */

export interface TriplicoPost {
  title: string;
  excerpt?: string;
  img: string;
  href: string;
  badge?: string;
}

interface Props {
  posts: TriplicoPost[];       // Acto I — últimos posts (idealmente 3)
  heroPost?: TriplicoPost;     // Acto II — colección destacada (imagen grande)
  /** ID único para permitir múltiples instancias en la misma página sin colisión de DOM */
  instanceId?: string;
  /** Etiqueta editorial (eyebrow) */
  label?: string;
  /** Titular principal del encabezado */
  headline?: string;
  /** Texto del CTA secundario en Acto III */
  ctaHref?: string;
  ctaLabel?: string;
  ctaSecondaryHref?: string;
  ctaSecondaryLabel?: string;
  /** Modo de presentación del Acto I: grilla simultánea (por defecto) o secuencia centrada ("guest") */
  actOneMode?: 'grid' | 'sequence';
}

const {
  posts = [],
  heroPost,
  instanceId = 'default',
  label = 'Tríptico de Revelación',
  headline = 'Lo Reciente. Lo Profundo. El Umbral.',
  ctaHref = '/colecciones/',
  ctaLabel = 'Ver Todas las Colecciones',
  ctaSecondaryHref = '/archivo/',
  ctaSecondaryLabel = 'Archivo Completo',
  actOneMode = 'grid',
} = Astro.props;

const stageId    = `triptico-stage-${instanceId}`;
const acto1Id    = `triptico-acto1-${instanceId}`;
const acto2Id    = `triptico-acto2-${instanceId}`;
const acto3Id    = `triptico-acto3-${instanceId}`;
const dotsId     = `triptico-dots-${instanceId}`;
const progressId = `triptico-progress-${instanceId}`;

const hero = heroPost ?? posts[0] ?? null;
const slicedPosts = posts.slice(0, 3);
---

<section
  id={`triptico-revelacion-${instanceId}`}
  class="triptico-root w-full max-w-360 mx-auto px-4 md:px-8 lg:px-12 py-16 md:py-24"
  aria-label="Tríptico de Revelación — Colecciones en Rotación"
>
  <!-- Encabezado editorial -->
  <header class="mb-8 flex flex-col gap-1.5">
    <span class="font-mono text-[10px] uppercase tracking-[0.5em] text-rust-orange font-bold opacity-70">
      {label}
    </span>
    <h2 class="font-cinzel font-extrabold text-3xl md:text-4xl lg:text-5xl gradient-steel-titanium tracking-tight leading-[0.95]">
      {headline}
    </h2>
  </header>

  <!-- CONTENEDOR DE LOS TRES ACTOS -->
  <div
    id={stageId}
    class="relative w-full overflow-hidden rounded-2xl md:rounded-3xl border border-white/5 shadow-2xl min-h-[82vh] md:min-h-180 lg:min-h-205 bg-black"
  >

    <!-- ═══════════════════════════════ -->
    <!-- ACTO I — Novedades (Grid 3 o Seq)-->
    <!-- ═══════════════════════════════ -->
    <div
      id={acto1Id}
      class={`triptico-acto absolute inset-0 ${actOneMode === 'grid' ? 'grid grid-cols-1 sm:grid-cols-3' : 'flex items-center justify-center'}`}
      style="visibility: visible; opacity: 1;"
    >
      {slicedPosts.map((post, i) => (
        <a
          href={post.href}
          class={actOneMode === 'grid' 
            ? "group relative overflow-hidden bg-[#0a0a0b] flex flex-col justify-end border-r border-white/5 last:border-r-0 transition-all duration-500"
            : "triptico-seq-card absolute inset-0 group overflow-hidden bg-[#0a0a0b] flex flex-col justify-end transition-all duration-500 invisible opacity-0"}
          style={actOneMode === 'grid' ? `transition-delay:${i * 60}ms` : ''}
        >
          <div class="absolute inset-0 z-0">
            <img
              src={post.img}
              alt={post.title}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/50 to-black/10"></div>
          </div>
          <div class="relative z-10 p-5 md:p-6 flex flex-col gap-2">
            {post.badge && (
              <span class="font-mono text-[8px] uppercase tracking-[0.4em] text-rust-orange font-bold opacity-70">
                {post.badge}
              </span>
            )}
            <h3 class="font-cinzel font-bold text-white text-sm md:text-base lg:text-lg leading-snug line-clamp-3 group-hover:text-rust-orange transition-colors duration-300">
              {post.title}
            </h3>
            {post.excerpt && (
              <p class="font-sans text-[11px] text-white/45 leading-relaxed line-clamp-2 hidden md:block">
                {post.excerpt}
              </p>
            )}
            <span class={`font-mono uppercase text-white/25 group-hover:text-rust-orange/60 transition-colors mt-1 ${actOneMode === 'grid' ? 'text-[9px] tracking-[0.3em]' : 'text-[11px] tracking-[0.4em] drop-shadow-md'}`}>
              Explorar Dossier →
            </span>
          </div>
          {actOneMode === 'grid' && (
            <div class="absolute left-0 top-0 h-full w-0.5 bg-rust-orange scale-y-0 group-hover:scale-y-100 transition-transform duration-500 origin-bottom z-20"></div>
          )}
        </a>
      ))}
      <div class="absolute top-4 right-5 z-30 font-mono text-[8px] uppercase tracking-[0.4em] text-white/20">
        Acto I — Novedades
      </div>
    </div>

    <!-- ═══════════════════════════════════ -->
    <!-- ACTO II — Bento Colección Hero     -->
    <!-- ═══════════════════════════════════ -->
    <div
      id={acto2Id}
      class="triptico-acto absolute inset-0"
      style="visibility: hidden; opacity: 0;"
    >
      {hero ? (
        <a href={hero.href} class="group relative w-full h-full flex items-end overflow-hidden">
          <div class="absolute inset-0 z-0">
            <img
              src={hero.img}
              alt={hero.title}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-linear-to-b from-black/30 via-transparent to-black/95"></div>
            <div class="absolute inset-0 bg-linear-to-r from-black/70 via-transparent to-black/40"></div>
          </div>
          <div class="relative z-10 p-8 md:p-12 lg:p-16 max-w-3xl flex flex-col gap-4">
            <span class="font-mono text-[9px] uppercase tracking-[0.5em] text-rust-orange font-bold">
              Colección Destacada
            </span>
            <h3 class="font-cinzel font-black text-white text-3xl md:text-4xl lg:text-5xl xl:text-6xl leading-[0.95] tracking-tight drop-shadow-2xl">
              {hero.title}
            </h3>
            {hero.excerpt && (
              <p class="font-serif italic text-white/55 text-base md:text-lg leading-relaxed max-w-xl">
                {hero.excerpt}
              </p>
            )}
            <span class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.4em] text-white/30 group-hover:text-rust-orange transition-colors mt-2">
              <span class="w-8 h-px bg-rust-orange/40 group-hover:bg-rust-orange transition-colors"></span>
              Explorar colección completa →
            </span>
          </div>
        </a>
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-[#0a0a0b]">
          <span class="font-mono text-white/20 text-sm">Sin datos de colección destacada</span>
        </div>
      )}
      <div class="absolute top-4 right-5 z-30 font-mono text-[8px] uppercase tracking-[0.4em] text-white/20">
        Acto II — Profundidad
      </div>
    </div>

    <!-- ═══════════════════════════════ -->
    <!-- ACTO III — Umbral CTA          -->
    <!-- ═══════════════════════════════ -->
    <div
      id={acto3Id}
      class="triptico-acto absolute inset-0 flex flex-col items-center justify-center gap-8 bg-[#060607]"
      style="visibility: hidden; opacity: 0;"
    >
      <!-- Ruido sutil de fondo -->
      <div class="absolute inset-0 opacity-[0.018]" style="background-image:url(data:image/svg+xml;base64,);"></div>

      <div class="relative z-10 flex flex-col items-center gap-8 md:gap-10 text-center px-8 max-w-4xl">
        <!-- Eyebrow ornamental -->
        <div class="triptico-a3-anim flex items-center gap-4 opacity-0">
          <div class="w-12 h-px bg-rust-orange/30"></div>
          <span class="font-mono text-[10px] uppercase tracking-[0.6em] text-rust-orange/80 font-bold">El Umbral</span>
          <div class="w-12 h-px bg-rust-orange/30"></div>
        </div>

        <!-- Headline -->
        <h3 class="triptico-a3-anim font-cinzel font-black text-white text-5xl md:text-7xl lg:text-[6rem] xl:text-[8rem] leading-[0.85] tracking-tight drop-shadow-[0_0_40px_rgba(255,255,255,0.15)] opacity-0">
          {headline.split('.')[0]}<br />
          <span class="gradient-steel-titanium drop-shadow-[0_0_20px_rgba(255,255,255,0.1)]">{headline.split('.').slice(1).join('.')}</span>
        </h3>

        <p class="triptico-a3-anim font-serif italic text-white/40 text-xl md:text-2xl leading-relaxed max-w-2xl mx-auto opacity-0">
          Ensayos cinemáticos, arqueosemiótica, arquetipos y dirección de arte.<br />
          <span class="text-white/20">Un archivo vivo de pensamiento visual.</span>
        </p>

        <div class="triptico-a3-anim flex items-center justify-center mt-4 opacity-0">
          <a
            href={ctaHref}
            class="group/cta inline-flex items-center gap-4 px-10 py-5 bg-black/40 backdrop-blur-md border border-white/10 font-mono font-bold text-[14px] tracking-[0.3em] uppercase text-white/80 rounded-full transition-all duration-500 hover:border-rust-orange/60 hover:bg-rust-orange/10 hover:text-white hover:shadow-[0_0_40px_rgba(217,119,6,0.25)] active:scale-95"
          >
            <span>{ctaLabel}</span>
            <span class="opacity-70 group-hover/cta:translate-x-1.5 transition-transform duration-300">▸</span>
          </a>
        </div>
      </div>

      <div class="absolute top-4 right-5 z-30 font-mono text-[8px] uppercase tracking-[0.4em] text-white/15">
        Acto III — Umbral
      </div>
    </div>

    <!-- Dots de navegación -->
    <div class="absolute bottom-5 left-1/2 -translate-x-1/2 z-40 flex items-center gap-2.5" id={dotsId} role="tablist">
      {[1, 2, 3].map((n) => (
        <button
          type="button"
          class={`triptico-dot rounded-full transition-all duration-500 cursor-pointer border-none outline-none shrink-0 ${n === 1 ? 'bg-rust-orange w-5 h-1.5' : 'bg-white/20 hover:bg-white/40 w-1.5 h-1.5'}`}
          data-acto={n}
          aria-label={`Acto ${n}`}
          aria-selected={n === 1 ? 'true' : 'false'}
        />
      ))}
    </div>

    <!-- Barra de progreso (oculta a petición, conservada para lógica de JS) -->
    <div class="absolute bottom-0 left-0 z-40 h-0.5 w-full opacity-0 pointer-events-none" aria-hidden="true">
      <div id={progressId} class="h-full w-0"></div>
    </div>

  </div>
</section>

<script define:vars={{ stageId, acto1Id, acto2Id, acto3Id, dotsId, progressId, actOneMode }}>
  const initTriptico = () => {
    const stage = document.getElementById(stageId);
    if (!stage || stage.__triptico_init) return;
    stage.__triptico_init = true;

    const acto1 = document.getElementById(acto1Id);
    const acto2 = document.getElementById(acto2Id);
    const acto3 = document.getElementById(acto3Id);
    const progressBar = document.getElementById(progressId);
    const dots = Array.from(document.querySelectorAll(`#${dotsId} .triptico-dot`));

    if (!acto1 || !acto2 || !acto3) return;

    const STAY = 6;
    const FADE = 1.2;
    const SEQ_STAY = 3.5;
    const SEQ_FADE = 1.5;
    
    const actos = [acto1, acto2, acto3];
    let currentActo = 0;
    let loopTimeout = null;
    let progressRaf = null;
    let paused = false;
    let progressStart = 0;
    let timeRemaining = 0;
    
    let act1Timeline = null;
    
    const getDurationForAct = (idx) => {
      if (idx === 0 && actOneMode === 'sequence') {
        const cardsCount = document.querySelectorAll(`#${acto1Id} .triptico-seq-card`).length;
        return (SEQ_STAY + SEQ_FADE) * cardsCount * 1000;
      }
      return (STAY + FADE) * 1000;
    };

    const loadGSAP = () => {
      return new Promise((resolve) => {
        if (window.gsap) { resolve(window.gsap); return; }
        const s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js';
        s.onload = () => resolve(window.gsap);
        document.head.appendChild(s);
      });
    };

    const updateDots = (idx) => {
      dots.forEach((dot, i) => {
        const active = i === idx;
        dot.setAttribute('aria-selected', String(active));
        if (active) {
          dot.classList.add('bg-rust-orange', 'w-5');
          dot.classList.remove('bg-white/20', 'w-1.5');
        } else {
          dot.classList.remove('bg-rust-orange', 'w-5');
          dot.classList.add('bg-white/20', 'w-1.5');
        }
      });
    };

    const animateProgress = () => {
      if (!progressBar) return;
      if (progressRaf) cancelAnimationFrame(progressRaf);
      progressStart = performance.now();
      const currentDuration = getDurationForAct(currentActo);
      
      const tick = (now) => {
        if (paused) { progressRaf = requestAnimationFrame(tick); return; }
        const elapsed = now - progressStart;
        const pct = Math.min((elapsed / currentDuration) * 100, 100);
        progressBar.style.width = `${pct}%`;
        if (pct < 100) progressRaf = requestAnimationFrame(tick);
      };
      progressRaf = requestAnimationFrame(tick);
    };

    const crossfade = (gsap, nextIdx) => {
      const currentDuration = getDurationForAct(nextIdx);
      
      // Fade out current act
      gsap.to(actos[currentActo], { autoAlpha: 0, duration: FADE, ease: 'power2.inOut' });
      
      if (currentActo === 2) {
        gsap.set(`#${acto3Id} .triptico-a3-anim`, { opacity: 0, y: 30, filter: "blur(12px)" });
      }

      // Fade in next act
      gsap.to(actos[nextIdx], { autoAlpha: 1, duration: FADE, ease: 'power2.inOut' });

      // Animations inside the Acts
      if (nextIdx === 2) {
        gsap.fromTo(`#${acto3Id} .triptico-a3-anim`, 
          { opacity: 0, y: 40, filter: "blur(16px)" },
          { opacity: 1, y: 0, filter: "blur(0px)", duration: 1.4, stagger: 0.15, ease: 'power3.out', delay: FADE * 0.4 }
        );
      } else if (nextIdx === 0 && actOneMode === 'sequence') {
        const seqCards = document.querySelectorAll(`#${acto1Id} .triptico-seq-card`);
        if (act1Timeline) act1Timeline.kill();
        act1Timeline = gsap.timeline();
        
        seqCards.forEach((card, i) => {
          act1Timeline.fromTo(card,
            { autoAlpha: 0, scale: 0.95, filter: "blur(10px)" },
            { autoAlpha: 1, scale: 1, filter: "blur(0px)", duration: SEQ_FADE, ease: 'power2.out' },
            i * (SEQ_STAY + SEQ_FADE)
          );
          act1Timeline.to(card,
            { autoAlpha: 0, scale: 1.05, filter: "blur(6px)", duration: SEQ_FADE, ease: 'power2.in' },
            i * (SEQ_STAY + SEQ_FADE) + SEQ_STAY
          );
        });
      }

      currentActo = nextIdx;
      updateDots(currentActo);
      animateProgress();
      
      timeRemaining = currentDuration;
      scheduleNext(gsap, timeRemaining);
    };

    const scheduleNext = (gsap, durationMs) => {
      if (loopTimeout) clearTimeout(loopTimeout);
      loopTimeout = setTimeout(() => {
        if (!paused) {
          crossfade(gsap, (currentActo + 1) % 3);
        }
      }, durationMs);
    };

    // Hover pause
    stage.addEventListener('mouseenter', () => { 
      paused = true;
      if (act1Timeline && currentActo === 0 && actOneMode === 'sequence') act1Timeline.pause();
      if (loopTimeout) clearTimeout(loopTimeout);
      
      if (progressBar) {
        const currentDuration = getDurationForAct(currentActo);
        const elapsed = parseFloat(progressBar.style.width || '0') / 100 * currentDuration;
        timeRemaining = currentDuration - elapsed;
      }
    });
    
    stage.addEventListener('mouseleave', () => {
      paused = false;
      if (act1Timeline && currentActo === 0 && actOneMode === 'sequence') act1Timeline.play();
      
      if (progressBar) {
        const currentDuration = getDurationForAct(currentActo);
        progressStart = performance.now() - (currentDuration - timeRemaining);
      }
      
      loadGSAP().then((gsap) => scheduleNext(gsap, timeRemaining));
    });

    // Dots manuales
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        if (i === currentActo) return;
        loadGSAP().then((gsap) => {
          if (loopTimeout) clearTimeout(loopTimeout);
          crossfade(gsap, i);
          scheduleNext(gsap);
        });
      });
    });

    // Precargar imagen del Acto II
    const heroImg = acto2.querySelector('img');
    if (heroImg?.src) {
      const link = document.createElement('link');
      link.rel = 'preload';
      link.as = 'image';
      link.href = heroImg.src;
      document.head.appendChild(link);
    }

    // Arranque
    loadGSAP().then((gsap) => {
      gsap.set(acto1, { autoAlpha: 1 });
      gsap.set(acto2, { autoAlpha: 0 });
      gsap.set(acto3, { autoAlpha: 0 });
      
      // Boot up sequence if in sequence mode
      if (actOneMode === 'sequence') {
        const seqCards = document.querySelectorAll(`#${acto1Id} .triptico-seq-card`);
        act1Timeline = gsap.timeline();
        seqCards.forEach((card, i) => {
          act1Timeline.fromTo(card,
            { autoAlpha: 0, scale: 0.95, filter: "blur(10px)" },
            { autoAlpha: 1, scale: 1, filter: "blur(0px)", duration: SEQ_FADE, ease: 'power2.out' },
            i * (SEQ_STAY + SEQ_FADE)
          );
          act1Timeline.to(card,
            { autoAlpha: 0, scale: 1.05, filter: "blur(6px)", duration: SEQ_FADE, ease: 'power2.in' },
            i * (SEQ_STAY + SEQ_FADE) + SEQ_STAY
          );
        });
      }
      
      updateDots(0);
      animateProgress();
      timeRemaining = getDurationForAct(0);
      scheduleNext(gsap, timeRemaining);
    });
  };

  document.addEventListener('DOMContentLoaded', initTriptico);
  document.addEventListener('astro:page-load', initTriptico);
</script>

<style>
  .triptico-acto { will-change: opacity, visibility; }
  .triptico-dot:focus-visible {
    outline: 2px solid rgba(239,235,227,0.5);
    outline-offset: 3px;
    border-radius: 999px;
  }
</style>
