---
// src/components/WikiCinematicHero.astro
export interface WikiHeroImage {
  id: string;
  title: string;
  cleanTitle?: string;
  url: string;
  thumbUrl: string;
  width: number;
  height: number;
  license: string;
  licenseShortName?: string;
  isCC0OrPublicDomain?: boolean;
  author: string;
  description: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  images?: any[];
  headline?: string;
  tagline?: string;
}

const { 
  title = Astro.props.title || Astro.props.headline || "Acervo Documental TGP", 
  subtitle = Astro.props.subtitle || Astro.props.tagline || "Wikimedia Commons Scale", 
  images = [] 
} = Astro.props;
---

<section 
  id="tgp-apple-visor" 
  class="relative w-full max-w-full m-0 p-0 bg-black select-none border-b border-zinc-800/80"
>
  <!-- 1. VISOR PRINCIPAL (85vh): Efecto IMAX MAX e Inmersión Absoluta Apple Showcase -->
  <div 
    id="tgp-cinemax-hero" 
    class="relative w-[100vw] max-w-full m-0 p-0 h-[85vh] bg-black overflow-hidden"
    style="width: 100vw; max-width: 100%; margin: 0; padding: 0; height: 85vh;"
  >
    <!-- Barra superior de control del Hero (discreta y elegante) -->
    <div class="absolute top-0 left-0 z-20 w-full px-6 sm:px-10 py-3 bg-linear-to-b from-black/80 via-black/20 to-transparent flex items-center justify-between text-xs font-mono text-zinc-300">
      <div class="flex items-center gap-3">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="tracking-wider uppercase text-zinc-300 font-semibold">TGP Apple Visor</span>
        <span id="hero-cadence-badge" class="hidden sm:inline-block px-2.5 py-0.5 rounded-full bg-zinc-900/90 border border-zinc-700/80 text-zinc-300 text-[11px]">
          Calculando cadencia...
        </span>
      </div>
      <div id="hero-counter" class="text-zinc-200 tracking-widest font-semibold px-2.5 py-0.5 rounded-full bg-black/60 border border-white/10">
        01 / {String(images.length).padStart(2, '0')}
      </div>
    </div>

    <!-- Escenario de Imágenes Nativas: Frame Congelado (absolute, object-fit: cover, object-position: center) -->
    <div id="hero-stage" class="absolute inset-0 z-0 bg-black overflow-hidden">
      {images.map((img, idx) => (
        <div 
          class={`hero-slide absolute inset-0 w-full h-full overflow-hidden ${idx === 0 ? 'opacity-100' : 'opacity-0'}`}
          data-index={idx}
        >
          <img
            src={img.thumbUrl || img.url}
            alt={img.description || img.title}
            crossorigin="anonymous"
            class="hero-zoom-img absolute top-0 left-0 w-full h-full object-cover object-center will-change-transform"
          />
          <!-- Gradiente Focalizado Apple: Solo en el 40% inferior para contraste de letras, dejando el 60% superior 100% puro y brillante -->
          <div 
            class="hero-focal-overlay absolute inset-0 pointer-events-none"
            style="background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 15%, rgba(0, 0, 0, 0) 40%);"
          ></div>
        </div>
      ))}
    </div>

    <!-- Posicionamiento de Tipografía Apple: z-index: 10, flex column justify-end, misma altura exacta del Hero -->
    <div 
      class="absolute inset-0 z-10 w-full h-full flex flex-col justify-end px-6 sm:px-10 pb-8 pointer-events-none"
      style="z-index: 10; display: flex; flex-direction: column; justify-content: flex-end;"
    >
      <div class="max-w-3xl pointer-events-auto">
        <h2 
          id="hero-subtitle"
          class="font-sans text-xs sm:text-sm font-semibold tracking-wider text-amber-400 uppercase mb-1 drop-shadow"
        >
          {subtitle}
        </h2>
        <h1 
          id="hero-title"
          class="font-sans font-bold text-[clamp(1.75rem,3.6vw,3.5rem)] text-white tracking-tight leading-[1.08] drop-shadow-xl mb-3"
        >
          {title}
        </h1>

        <!-- Píldora de atribución + Barra de progreso sincronizada -->
        <div class="flex items-center gap-4 pt-1">
          <div id="hero-attr-stage" class="relative h-6 flex-1 max-w-lg overflow-hidden">
            {images.map((img, idx) => (
              <div 
                class={`hero-attr-item absolute inset-0 flex items-center gap-2 font-mono text-xs text-zinc-300 ${idx === 0 ? 'opacity-100' : 'opacity-0'}`}
              >
                <span class="px-2 py-0.5 rounded-full bg-white/15 text-white font-semibold border border-white/20 text-[11px]">
                  {img.licenseShortName || img.license || 'CC Commons'}
                </span>
                <span class="truncate text-zinc-300 drop-shadow">
                  Foto: <strong class="text-white">{img.author || 'Wikimedia Commons'}</strong> — {img.cleanTitle || img.title.replace(/^File:/i, '')}
                </span>
              </div>
            ))}
          </div>

          <div class="w-28 sm:w-44 h-1 bg-white/20 rounded-full overflow-hidden shrink-0">
            <div id="hero-progress-bar" class="h-full bg-amber-400 w-0"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. EL EFECTO "INSET" DEL CARRUSEL (Array de imágenes sobre fondo #1c1c1e) -->
  <div 
    id="tgp-apple-carousel-strip" 
    class="w-full bg-[#1c1c1e] py-3.5 border-t border-white/10"
  >
    <div class="px-6 sm:px-10 pb-2 flex items-center justify-between text-xs font-mono text-zinc-400">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span class="uppercase tracking-widest text-zinc-200 font-semibold text-[11px]">Carrusel Inset Apple</span>
        <span class="text-zinc-500 hidden md:inline text-[11px]">· {images.length} piezas seleccionadas</span>
      </div>
      <span class="text-zinc-400 text-[11px] hidden sm:inline font-sans">
        Toca cualquier miniatura para proyectarla en el visor principal
      </span>
    </div>

    <!-- Contenedor del array: flex, gap: 20px, overflow-x: auto, scroll-snap-type: x mandatory, padding: 10px 40px -->
    <div 
      id="hero-thumb-carousel"
      class="flex gap-5 overflow-x-auto scroll-smooth px-6 sm:px-10 py-2 [scroll-snap-type:x_mandatory] cursor-grab active:cursor-grabbing"
    >
      {images.map((img, idx) => (
        <button
          type="button"
          class={`hero-thumb-card relative aspect-16/9 w-[260px] sm:w-[300px] shrink-0 [scroll-snap-align:start] rounded-2xl overflow-hidden bg-black border-2 transition-all duration-300 cursor-pointer shadow-[0_8px_24px_rgba(0,0,0,0.5)] group text-left ${
            idx === 0 
              ? 'border-amber-400 ring-2 ring-amber-400/50 scale-[1.02]' 
              : 'border-white/10 hover:border-amber-400/70 hover:scale-[1.01]'
          }`}
          data-index={idx}
          title={`Ver imagen #${idx + 1}`}
        >
          <img 
            src={img.thumbUrl || img.url} 
            alt={img.title} 
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/75 via-transparent to-black/30 pointer-events-none"></div>
          
          <!-- Número de orden -->
          <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md bg-black/80 border border-white/10 text-[10px] font-mono font-semibold text-zinc-200">
            #{String(idx + 1).padStart(2, '0')}
          </span>

          <!-- Pill de licencia -->
          <span class="absolute bottom-2.5 left-2.5 px-2 py-0.5 rounded-full bg-black/80 border border-white/15 text-[10px] font-mono text-amber-300 font-medium truncate max-w-[65%]">
            {img.licenseShortName || img.license || 'Commons'}
          </span>

          <span class="absolute bottom-2.5 right-2.5 text-[10px] font-mono text-zinc-400">
            {img.width}×{img.height}
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  let activeTimeline: gsap.core.Timeline | null = null;
  let currentIndex = 0;

  function computeAdaptiveTiming(count: number) {
    if (count <= 4) {
      return {
        hold: 5.5,
        fade: 1.25,
        scale: 1.05,
        ease: "sine.inOut",
        label: `MODO CONTEMPLATIVO (${count} FOTOS • FADE 1.25s)`
      };
    }
    if (count <= 8) {
      return {
        hold: 3.6,
        fade: 0.65,
        scale: 1.06,
        ease: "power2.inOut",
        label: `MODO EDITORIAL (${count} FOTOS • FADE 0.65s)`
      };
    }
    return {
      hold: 2.5,
      fade: 0.35,
      scale: 1.08,
      ease: "power3.inOut",
      label: `MODO SECUENCIA ÁGIL (${count} FOTOS • FADE 0.35s)`
    };
  }

  function highlightThumbCard(idx: number) {
    const thumbs = document.querySelectorAll<HTMLElement>(".hero-thumb-card");
    thumbs.forEach((th, i) => {
      if (i === idx) {
        th.classList.add("border-amber-400", "ring-2", "ring-amber-400/50", "scale-[1.02]");
        th.classList.remove("border-white/10");
        // Centrar suavemente en el carrusel
        th.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
      } else {
        th.classList.remove("border-amber-400", "ring-2", "ring-amber-400/50", "scale-[1.02]");
        th.classList.add("border-white/10");
      }
    });
  }

  function jumpToSlide(targetIdx: number) {
    const container = document.getElementById("tgp-cinemax-hero");
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>(".hero-slide");
    const attrs = container.querySelectorAll<HTMLElement>(".hero-attr-item");
    const counter = document.getElementById("hero-counter");
    const progressBar = document.getElementById("hero-progress-bar");
    const total = slides.length;

    if (total === 0 || targetIdx < 0 || targetIdx >= total) return;

    if (activeTimeline) {
      activeTimeline.kill();
      activeTimeline = null;
    }

    slides.forEach((s, i) => {
      gsap.to(s, { opacity: i === targetIdx ? 1 : 0, duration: 0.4, ease: "power2.out" });
    });
    attrs.forEach((a, i) => {
      gsap.to(a, { opacity: i === targetIdx ? 1 : 0, duration: 0.4, ease: "power2.out" });
    });

    if (counter) {
      counter.textContent = `${String(targetIdx + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
    }
    if (progressBar) {
      gsap.fromTo(progressBar, { width: "0%" }, { width: "100%", duration: 4, ease: "none" });
    }

    currentIndex = targetIdx;
    highlightThumbCard(targetIdx);

    // Reanudar la cadencia adaptativa tras la interacción manual
    initHeroTimeline(targetIdx);
  }

  function initHeroTimeline(startIndex = 0) {
    if (activeTimeline) {
      activeTimeline.kill();
      activeTimeline = null;
    }

    const container = document.getElementById("tgp-cinemax-hero");
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>(".hero-slide");
    const imgs = container.querySelectorAll<HTMLElement>(".hero-zoom-img");
    const attrs = container.querySelectorAll<HTMLElement>(".hero-attr-item");
    const badge = document.getElementById("hero-cadence-badge");
    const counter = document.getElementById("hero-counter");
    const progressBar = document.getElementById("hero-progress-bar");

    const total = slides.length;
    if (total === 0) return;

    const cfg = computeAdaptiveTiming(total);
    if (badge) badge.textContent = cfg.label;

    if (total === 1) {
      gsap.fromTo(imgs[0], { scale: 1 }, { scale: cfg.scale, duration: 10, yoyo: true, repeat: -1, ease: "sine.inOut" });
      return;
    }

    // Configuración inicial respetando el índice inicial
    slides.forEach((s, i) => gsap.set(s, { opacity: i === startIndex ? 1 : 0 }));
    attrs.forEach((a, i) => gsap.set(a, { opacity: i === startIndex ? 1 : 0 }));
    imgs.forEach(img => gsap.set(img, { scale: 1 }));
    highlightThumbCard(startIndex);

    const tl = gsap.timeline({ repeat: -1 });
    activeTimeline = tl;

    for (let offset = 0; offset < total; offset++) {
      const i = (startIndex + offset) % total;
      const next = (i + 1) % total;

      tl.call(() => {
        currentIndex = i;
        if (counter) {
          counter.textContent = `${String(i + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
        }
        highlightThumbCard(i);
      });

      if (progressBar) {
        tl.fromTo(progressBar, { width: "0%" }, { width: "100%", duration: cfg.hold, ease: "none" });
      }

      tl.fromTo(
        imgs[i],
        { scale: 1 },
        { scale: cfg.scale, duration: cfg.hold + cfg.fade, ease: "none" },
        `<`
      );

      tl.to([slides[i], attrs[i]], {
        opacity: 0,
        duration: cfg.fade,
        ease: cfg.ease
      }, `-=${cfg.fade}`);

      tl.to([slides[next], attrs[next]], {
        opacity: 1,
        duration: cfg.fade,
        ease: cfg.ease
      }, total <= 4 ? `-=${cfg.fade * 0.45}` : `>`);
    }
  }

  function bindThumbClickEvents() {
    const thumbs = document.querySelectorAll<HTMLElement>(".hero-thumb-card");
    thumbs.forEach(th => {
      th.addEventListener("click", () => {
        const idx = Number(th.dataset.index);
        if (!isNaN(idx)) {
          jumpToSlide(idx);
        }
      });
    });
  }

  document.addEventListener("astro:page-load", () => {
    initHeroTimeline();
    bindThumbClickEvents();
  });

  if (document.readyState !== "loading") {
    initHeroTimeline();
    bindThumbClickEvents();
  }

  // Escucha en tiempo real cuando el Developer actualiza el lote desde el Lightbox Curador
  window.addEventListener("tgp:preview-batch", ((e: CustomEvent) => {
    const { images, queryTitle } = e.detail;
    const stage = document.getElementById("hero-stage");
    const attrStage = document.getElementById("hero-attr-stage");
    const titleEl = document.getElementById("hero-title");
    const thumbCarousel = document.getElementById("hero-thumb-carousel");

    if (!stage || !attrStage || !thumbCarousel || !images?.length) return;
    if (titleEl && queryTitle) titleEl.textContent = queryTitle;

    // 1. Reconstruir Visor Principal (Frame Congelado y Gradiente Focalizado Apple)
    stage.innerHTML = images.map((img: any, idx: number) => `
      <div class="hero-slide absolute inset-0 w-full h-full overflow-hidden ${idx === 0 ? 'opacity-100' : 'opacity-0'}" data-index="${idx}">
        <img src="${img.thumbUrl || img.url}" alt="${img.title}" crossorigin="anonymous" class="hero-zoom-img absolute top-0 left-0 w-full h-full object-cover object-center will-change-transform" />
        <div class="hero-focal-overlay absolute inset-0 pointer-events-none" style="background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 15%, rgba(0, 0, 0, 0) 40%);"></div>
      </div>
    `).join("");

    attrStage.innerHTML = images.map((img: any, idx: number) => `
      <div class="hero-attr-item absolute inset-0 flex items-center gap-2 font-mono text-xs text-zinc-300 ${idx === 0 ? 'opacity-100' : 'opacity-0'}">
        <span class="px-2 py-0.5 rounded-full bg-white/15 text-white font-semibold border border-white/20 text-[11px]">${img.licenseShortName || img.license || 'CC Commons'}</span>
        <span class="truncate text-zinc-300 drop-shadow">Foto: <strong class="text-white">${img.author || 'Wikimedia'}</strong> — ${img.cleanTitle || img.title.replace(/^File:/i, '')}</span>
      </div>
    `).join("");

    // 2. Reconstruir Carrusel Inset
    thumbCarousel.innerHTML = images.map((img: any, idx: number) => `
      <button
        type="button"
        class="hero-thumb-card relative aspect-16/9 w-[260px] sm:w-[300px] shrink-0 [scroll-snap-align:start] rounded-2xl overflow-hidden bg-black border-2 transition-all duration-300 cursor-pointer shadow-[0_8px_24px_rgba(0,0,0,0.5)] group text-left ${
          idx === 0 
            ? 'border-amber-400 ring-2 ring-amber-400/50 scale-[1.02]' 
            : 'border-white/10 hover:border-amber-400/70 hover:scale-[1.01]'
        }"
        data-index="${idx}"
        title="Ver imagen #${idx + 1}"
      >
        <img 
          src="${img.thumbUrl || img.url}" 
          alt="${img.title}" 
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/75 via-transparent to-black/30 pointer-events-none"></div>
        <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md bg-black/80 border border-white/10 text-[10px] font-mono font-semibold text-zinc-200">
          #${String(idx + 1).padStart(2, '0')}
        </span>
        <span class="absolute bottom-2.5 left-2.5 px-2 py-0.5 rounded-full bg-black/80 border border-white/15 text-[10px] font-mono text-amber-300 font-medium truncate max-w-[65%]">
          ${img.licenseShortName || img.license || 'Commons'}
        </span>
        <span class="absolute bottom-2.5 right-2.5 text-[10px] font-mono text-zinc-400">
          ${img.width}×${img.height}
        </span>
      </button>
    `).join("");

    bindThumbClickEvents();
    initHeroTimeline(0);
    document.getElementById("tgp-apple-visor")?.scrollIntoView({ behavior: "smooth" });
  }) as EventListener);
</script>

<style>
  /* Scrollbar oculta y suave para el carrusel de miniaturas */
  #hero-thumb-carousel::-webkit-scrollbar {
    height: 4px;
  }
  #hero-thumb-carousel::-webkit-scrollbar-track {
    background: #1c1c1e;
  }
  #hero-thumb-carousel::-webkit-scrollbar-thumb {
    background: #3a3a3c;
    border-radius: 9999px;
  }
  #hero-thumb-carousel::-webkit-scrollbar-thumb:hover {
    background: #505054;
  }
</style>
