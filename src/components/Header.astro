---
// Header Component Institucional (Dark Academia Premium)
import { BuscadorModal } from './BuscadorModal';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  transparentUntilScroll?: boolean;
}

const { transparentUntilScroll = false } = Astro.props;
---

<header
  id="site-header"
  class="fixed top-0 w-full z-50 transition-all duration-500 bg-transparent border-b border-transparent"
>
  <div class="w-full px-4 md:px-6 lg:px-8 xl:px-12 py-3.5 md:py-4 flex justify-between items-center relative">
    {/* Izquierda: Marca — compact para no invadir nav centrada */}
    <div class="flex items-center shrink-0 z-10">
      <div class="flex items-center gap-2 md:gap-2.5">
        {/* Logo y Título principal */}
        {/* Logo y Título principal unificados en formato 3 líneas idéntico al Footer */}
        <a href="https://ediciones.thegreatpuzzleproject.com" class="group/brand flex flex-col text-left justify-center select-none" title="Ir a Ediciones de The Great Puzzle Project">
          <span class="font-['Gloock'] font-black text-[11px] md:text-[12px] lg:text-[13px] tracking-wide uppercase leading-none transition-colors gradient-steel-line-1">
            THE GREAT
          </span>
          <div class="flex items-center gap-1.5 my-0.5">
            <div class="brand-element w-4.5 h-4.5 md:w-5 md:h-5 rounded-full border-0 bg-current/5 flex items-center justify-center transition-all duration-300 shrink-0 relative overflow-hidden shadow-md">
              <img 
                src="/images/favicon.TGP.webp" 
                alt="The Great Puzzle Project Logo" 
                class="w-full h-full object-cover scale-[1.05] animate-soft-pulse group-hover/brand:scale-[1.10] transition-transform duration-500"
              />
            </div>
            <span class="font-['Gloock'] font-black text-[11px] md:text-[12px] lg:text-[13px] tracking-wide uppercase leading-none transition-colors gradient-steel-line-2">
              PUZZLE
            </span>
          </div>
          <span class="font-['Gloock'] font-black text-[11px] md:text-[12px] lg:text-[13px] tracking-wide uppercase leading-none transition-colors gradient-steel-line-3">
            PROJECT
          </span>
        </a>
        
        {/* Separador vertical sutil adaptado al alto de las 3 líneas */}
        <div class="w-px h-8 md:h-9 bg-white/15 mx-0.5 rounded-full"></div>

        {/* HEMEROTECA: compacto, sin pisar la nav */}
        <a href="/" class="brand-hemeroteca header-subtitle-hemeroteca font-['Gloock'] font-black text-xs md:text-sm lg:text-[15px] tracking-widest uppercase px-1.5 py-0.5 rounded-md transition-all duration-500 border border-transparent leading-none gradient-steel-line-3" title="Volver al Inicio de la Hemeroteca">
          HEMEROTECA
        </a>
      </div>
    </div>
    
    {/* Centro: Navegación Compacta Absoluta con tamaño aumentado (+2px) */}
    <nav class="toolbar-element hidden xl:flex absolute left-1/2 -translate-x-1/2 items-center gap-4 xl:gap-5 2xl:gap-6 shrink-0 font-metadata text-sm xl:text-[15px] tracking-[-0.015em] whitespace-nowrap z-0 transition-all duration-500">

      <a href="/" class="header-nav-link transition-colors">Inicio</a>
      <a href="/colecciones/" class="header-nav-link transition-colors">Colecciones</a>
      <a href="/archivo/" class="header-nav-link transition-colors">Archivo</a>
      <a href="/papers/" class="header-nav-link transition-colors">Papers</a>
      <a href="/about/" class="header-nav-link transition-colors">About</a>
      <a href="/codice/" class="header-nav-link transition-colors">El Códice</a>

      {/* Divisor */}
      <span class="w-px h-3 bg-white/15 rounded-full"></span>

      <a
        href="https://ediciones.thegreatpuzzleproject.com"
        target="_blank"
        rel="noopener noreferrer"
        class="header-nav-link transition-colors flex items-center gap-1"
        title="Editorial TGP — Archivo Editorial"
      >
        Editorial
        <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
      </a>
    </nav>

    {/* Derecha: Acciones (Tema, Lupa, Menú Hamburguesa en móvil) */}
    <div class="flex items-center gap-2 md:gap-2.5 ml-auto z-10">
      <ThemeToggle />
      <BuscadorModal client:load />

      {/* Botón Hamburguesa Cinemático (Visible solo en < xl) */}
      <button
        id="nav-mobile-btn"
        type="button"
        class="xl:hidden w-9 h-9 rounded-lg border border-white/15 bg-white/5 hover:bg-white/10 text-[#EFEBE3] flex flex-col items-center justify-center gap-1.25 transition-all duration-300 cursor-pointer"
        aria-label="Alternar menú de navegación"
        aria-expanded="false"
      >
        <span class="hamburger-line w-4.5 h-0.5 bg-current rounded-full transition-all duration-300 origin-center"></span>
        <span class="hamburger-line w-4.5 h-0.5 bg-current rounded-full transition-all duration-300 origin-center"></span>
        <span class="hamburger-line w-4.5 h-0.5 bg-current rounded-full transition-all duration-300 origin-center"></span>
      </button>
    </div>
  </div>

  {/* Overlay de Navegación Móvil Cinemático (Glassmorphism Dark) */}
  <div
    id="nav-mobile-overlay"
    class="fixed inset-0 z-9990 bg-black/92 backdrop-blur-2xl opacity-0 pointer-events-none transition-all duration-500 flex flex-col justify-between p-8 sm:p-12 xl:hidden"
    aria-hidden="true"
  >
    {/* Cabecera del overlay móvil */}
    <div class="flex items-center justify-between border-b border-white/10 pb-6 pt-2">
      <span class="font-metadata text-xs uppercase tracking-[0.3em] text-rust-orange font-bold">
        Hemeroteca TGP · Navegación
      </span>
      <button
        id="nav-mobile-close"
        type="button"
        class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center font-metadata text-base transition-colors cursor-pointer"
        aria-label="Cerrar menú"
      >
        ✕
      </button>
    </div>

    {/* Enlaces Principales Grandes */}
    <nav class="flex flex-col gap-5 sm:gap-6 my-auto py-6">
      <a href="/" class="mobile-nav-link font-['Gloock'] text-2xl sm:text-3xl text-[#EFEBE3] hover:text-rust-orange transition-colors">
        Inicio
      </a>
      <a href="/colecciones/" class="mobile-nav-link font-['Gloock'] text-2xl sm:text-3xl text-[#EFEBE3] hover:text-rust-orange transition-colors">
        Colecciones
      </a>
      <a href="/archivo/" class="mobile-nav-link font-['Gloock'] text-2xl sm:text-3xl text-[#EFEBE3] hover:text-rust-orange transition-colors">
        Archivo
      </a>
      <a href="/papers/" class="mobile-nav-link font-['Gloock'] text-2xl sm:text-3xl text-[#EFEBE3] hover:text-rust-orange transition-colors">
        Papers
      </a>
      <a href="/about/" class="mobile-nav-link font-['Gloock'] text-2xl sm:text-3xl text-[#EFEBE3] hover:text-rust-orange transition-colors">
        About
      </a>
      <a href="/codice/" class="mobile-nav-link font-['Gloock'] text-2xl sm:text-3xl text-[#EFEBE3] hover:text-rust-orange transition-colors">
        El Códice
      </a>
      <a
        href="https://ediciones.thegreatpuzzleproject.com"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link font-['Gloock'] text-xl sm:text-2xl text-[#EFEBE3]/70 hover:text-white transition-colors flex items-center gap-2 pt-2 border-t border-white/10"
      >
        Editorial TGP
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
      </a>
    </nav>

    {/* Pie del overlay */}
    <div class="border-t border-white/10 pt-4 flex items-center justify-between font-metadata text-[10px] uppercase tracking-widest text-white/40">
      <span>The Great Puzzle Project</span>
      <span>Patrimonio & Archivo</span>
    </div>
  </div>
</header>

<script is:inline>
  const setupHeaderScroll = () => {
    const header = document.getElementById('site-header');
    if (!header) return;

    // Destacar la pestaña activa según la URL actual
    const currentPath = window.location.pathname;
    const navLinks = header.querySelectorAll('.header-nav-link');
    
    navLinks.forEach(link => {
      const href = link.getAttribute('href');
      if (href) {
        // Normalizar trailing slashes para evitar problemas de coincidencia
        const normalizedPath = currentPath.endsWith('/') && currentPath !== '/' ? currentPath.slice(0, -1) : currentPath;
        const normalizedHref = href.endsWith('/') && href !== '/' ? href.slice(0, -1) : href;

        let isActive = false;
        
        if (normalizedHref === '/') {
          isActive = normalizedPath === '/';
        } else if (normalizedHref === '/papers') {
          // Para /papers, activar también si estamos en un subdirectorio o en /hemeroteca
          isActive = normalizedPath.startsWith('/papers') || normalizedPath.startsWith('/hemeroteca');
        } else {
          // Para el resto, coincidencia por prefijo
          isActive = normalizedPath.startsWith(normalizedHref);
        }

        if (isActive) {
          link.classList.add('active');
          link.setAttribute('data-active', 'true');
        } else {
          link.classList.remove('active');
          link.removeAttribute('data-active');
        }
      }
    });

    // Limpiar event listeners previos si existen en `window.tgpHeaderState` para evitar fugas de memoria
    if (window.tgpHeaderState) {
      window.removeEventListener('scroll', window.tgpHeaderState.scrollHandler);
      document.removeEventListener('click', window.tgpHeaderState.clickHandler);
      
      const oldTrigger = document.getElementById('header-hover-trigger');
      if (oldTrigger && window.tgpHeaderState.hoverEnterHandler) {
        oldTrigger.removeEventListener('mouseenter', window.tgpHeaderState.hoverEnterHandler);
      }
      if (window.tgpHeaderState.hoverLeaveHandler) {
        header.removeEventListener('mouseleave', window.tgpHeaderState.hoverLeaveHandler);
      }
    } else {
      window.tgpHeaderState = {};
    }

    // Crear o buscar el trigger invisible en el tope de la pantalla para hover
    let trigger = document.getElementById('header-hover-trigger');
    if (!trigger) {
      trigger = document.createElement('div');
      trigger.id = 'header-hover-trigger';
      trigger.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:15px;z-index:9999;pointer-events:auto;';
      document.body.appendChild(trigger);
    }

    const hoverEnterHandler = () => {
      if (header.classList.contains('is-scrolled')) {
        header.classList.add('is-hovered-revealed');
      }
    };
    
    const hoverLeaveHandler = () => {
      header.classList.remove('is-hovered-revealed');
    };

    trigger.addEventListener('mouseenter', hoverEnterHandler);
    header.addEventListener('mouseleave', hoverLeaveHandler);
    
    window.tgpHeaderState.hoverEnterHandler = hoverEnterHandler;
    window.tgpHeaderState.hoverLeaveHandler = hoverLeaveHandler;

    let lastScrollY = window.scrollY;

    const scrollHandler = () => {
      const currentScrollY = window.scrollY;
      
      // Al hacer scroll, se quita la revelación por click o hover previo
      if (Math.abs(currentScrollY - lastScrollY) > 5) {
        header.classList.remove('is-clicked-revealed');
        header.classList.remove('is-hovered-revealed');
      }
      lastScrollY = currentScrollY;

      // Con scroll (> 20px) se oculta la barra
      if (currentScrollY > 20) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
        header.classList.remove('is-clicked-revealed');
        header.classList.remove('is-hovered-revealed');
      }
    };

    // Si el usuario clickea en cualquier parte de la pantalla, el menú/navbar aparece
    const clickHandler = (e) => {
      if (window.scrollY > 20) {
        const isClickInsideHeader = header.contains(e.target);
        if (!isClickInsideHeader) {
          if (header.classList.contains('is-clicked-revealed')) {
            header.classList.remove('is-clicked-revealed');
          } else {
            header.classList.add('is-clicked-revealed');
          }
        }
      }
    };

    window.addEventListener('scroll', scrollHandler, { passive: true });
    document.addEventListener('click', clickHandler);
    
    window.tgpHeaderState.scrollHandler = scrollHandler;
    window.tgpHeaderState.clickHandler = clickHandler;
    
    // ── Menú Móvil Cinemático (Hamburguesa + Overlay) ──
    const mobileBtn = document.getElementById('nav-mobile-btn');
    const mobileOverlay = document.getElementById('nav-mobile-overlay');
    const mobileClose = document.getElementById('nav-mobile-close');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    if (mobileBtn && mobileOverlay) {
      let isMobileMenuOpen = false;

      const setMobileMenuState = (open) => {
        isMobileMenuOpen = open;
        mobileBtn.setAttribute('aria-expanded', String(open));
        mobileOverlay.setAttribute('aria-hidden', String(!open));

        if (open) {
          mobileOverlay.classList.remove('opacity-0', 'pointer-events-none');
          mobileOverlay.classList.add('opacity-100', 'pointer-events-auto');
          mobileBtn.classList.add('is-active');
          document.body.style.overflow = 'hidden';
        } else {
          mobileOverlay.classList.remove('opacity-100', 'pointer-events-auto');
          mobileOverlay.classList.add('opacity-0', 'pointer-events-none');
          mobileBtn.classList.remove('is-active');
          document.body.style.overflow = '';
        }
      };

      mobileBtn.onclick = (e) => {
        e.stopPropagation();
        setMobileMenuState(!isMobileMenuOpen);
      };

      if (mobileClose) {
        mobileClose.onclick = (e) => {
          e.stopPropagation();
          setMobileMenuState(false);
        };
      }

      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => {
          setMobileMenuState(false);
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isMobileMenuOpen) {
          setMobileMenuState(false);
        }
      });
    }

    scrollHandler();
  };

  const initHeader = () => {
    setupHeaderScroll();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  /* Header totalmente transparente — sin franja ni bordes en ninguna sección */
  #site-header {
    background-color: transparent !important;
    border-bottom-color: transparent !important;
    box-shadow: none !important;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  /* Con scroll inmediato se va (fade out + desplazamiento sutil) en todas las secciones */
  #site-header.is-scrolled {
    opacity: 0 !important;
    pointer-events: none;
    transform: translateY(-10px);
  }

  /* Si se revela por hover, foco o click, tiene visibilidad total */
  #site-header.is-scrolled:focus-within,
  #site-header.is-hovered-revealed,
  #site-header.is-clicked-revealed {
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }

  /* Animación del botón hamburguesa activo */
  #nav-mobile-btn.is-active .hamburger-line:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  #nav-mobile-btn.is-active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #nav-mobile-btn.is-active .hamburger-line:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* NOTA: El estado activo (.active / [data-active]) está definido en global.css
     con la especificidad necesaria para superar las reglas !important del header. */

  [data-theme='light'] #site-header .header-brand-title,
  [data-theme='light'] #site-header .header-nav-link,
  [data-theme='light'] #site-header .header-btn-codice,
  [data-theme='light'] #site-header .header-action-btn {
    color: #F5F5F7 !important;
  }

  [data-theme='light'] #site-header .header-action-btn svg {
    stroke: #F5F5F7 !important;
    color: #F5F5F7 !important;
  }

  @keyframes soft-pulse {
    0%, 100% { transform: scale(1.05); }
    50% { transform: scale(1.08); }
  }
  .animate-soft-pulse {
    animation: soft-pulse 3.5s ease-in-out infinite;
  }

  .header-subtitle-hemeroteca {
    background-color: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  .header-subtitle-hemeroteca:hover {
    background-color: rgba(239, 235, 227, 0.04);
    border-color: rgba(26, 28, 29, 0.8);
    box-shadow: 0 0 12px rgba(239, 235, 227, 0.04);
  }

  [data-theme='light'] .header-subtitle-hemeroteca:hover {
    border-color: rgba(239, 235, 227, 0.3);
    background-color: rgba(239, 235, 227, 0.08);
  }

  .header-nav-link:hover {
    text-shadow: 0 0 10px rgba(239, 235, 227, 0.06);
  }

  @media (max-width: 1200px) {
    nav.toolbar-element {
      display: none !important;
    }
  }
</style>
