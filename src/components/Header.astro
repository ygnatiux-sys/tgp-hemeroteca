---
// Header Component Institucional (Dark Academia Premium)
import { BuscadorModal } from './BuscadorModal';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** En home: fondo transparente al tope; sólido + blur tras 50px */
  transparentUntilScroll?: boolean;
}

const { transparentUntilScroll = false } = Astro.props;
---

<header
  id="site-header"
  data-transparent-until-scroll={transparentUntilScroll ? 'true' : 'false'}
  class:list={[
    'fixed top-0 w-full z-50 transition-all duration-700',
    transparentUntilScroll
      ? 'bg-transparent border-b border-transparent'
      : 'bg-(--header-bg) backdrop-blur-xl border-b border-(--header-border) shadow-xs',
  ]}
>
  <div class="max-w-400 mx-auto px-6 md:px-10 lg:px-14 py-4 md:py-5 lg:py-5.5 flex justify-between items-center gap-8 md:gap-16 lg:gap-24 xl:gap-32">
    <div class="flex items-center shrink-0">
      <a href="/" class="group flex flex-row items-center gap-4" title="The Great Puzzle Project">
        {/* Logo Imagen (Favicon TGP) Circular sin borde con animación 'soft pulse' y 5% más grande */}
        <div class="brand-element w-11 h-11 md:w-12 md:h-12 rounded-full border-0 bg-current/5 flex items-center justify-center transition-all duration-300 shrink-0 relative overflow-hidden">
          <img 
            src="/images/favicon.TGP.webp" 
            alt="The Great Puzzle Project Logo" 
            class="w-full h-full object-cover scale-[1.05] animate-soft-pulse group-hover:scale-[1.10] transition-transform duration-500"
          />
        </div>
        <div class="brand-element flex flex-col">
          <span class="header-brand-title gradient-steel-brand text-base md:text-lg lg:text-[20px] leading-tight transition-colors">
            The Great Puzzle Project
          </span>
        </div>
      </a>
    </div>
    
    <div class="flex items-center gap-6 md:gap-10 lg:gap-14 ml-auto">
      {/* Navegación Tradicional Fina en Monoespaciado con Tracking Amplio (Aireado y Desplazado a la Derecha) */}
      <nav class="hidden md:flex items-center gap-7 lg:gap-10 xl:gap-12 shrink-0 font-mono font-light text-xs md:text-[13px] uppercase tracking-[0.28em]">
        <a href="/" class="header-nav-link transition-colors">Inicio</a>
        <a href="/colecciones" class="header-nav-link transition-colors">Colecciones</a>
        <a href="/archivo" class="header-nav-link transition-colors">Archivo</a>
        <a href="/papers" class="header-nav-link transition-colors">Papers</a>
        <a href="/about" class="header-nav-link transition-colors">About</a>
        <a href="/codice" class="header-btn-codice px-3.5 py-1.5 rounded-xl font-mono font-light text-xs uppercase tracking-[0.28em] transition-all whitespace-nowrap">
          El Códice
        </a>
      </nav>

      {/* Botonera de Acción Simétrica y Coherente */}
      <div class="flex items-center gap-2.5 md:gap-3">
        {/* Toggle Sol / Luna */}
        <ThemeToggle />

        {/* Lupa de Búsqueda + Menú Sándwich 3 Guiones ≡ */}
        <BuscadorModal client:load />
      </div>
    </div>
  </div>
</header>

{transparentUntilScroll && (
  <script>
    const SCROLLED_CLASSES = ['is-scrolled', 'backdrop-blur-md', 'bg-[#1A1C1D]/85', 'border-white/10'];
    const TOP_CLASSES = ['bg-transparent', 'border-transparent'];

    let headerScrollHandler: (() => void) | null = null;

    const setupHeaderScroll = () => {
      const header = document.getElementById('site-header');
      if (!header || header.dataset.transparentUntilScroll !== 'true') return;

      if (headerScrollHandler) {
        window.removeEventListener('scroll', headerScrollHandler);
      }

      headerScrollHandler = () => {
        if (window.scrollY > 50) {
          header.classList.add(...SCROLLED_CLASSES);
          header.classList.remove(...TOP_CLASSES);
        } else {
          header.classList.remove(...SCROLLED_CLASSES);
          header.classList.add(...TOP_CLASSES);
        }
      };

      window.addEventListener('scroll', headerScrollHandler, { passive: true });
      headerScrollHandler();
    };

    document.addEventListener('DOMContentLoaded', setupHeaderScroll);
    document.addEventListener('astro:page-load', setupHeaderScroll);
  </script>
)}

<style>
  /* Sobre el hero cinemático: fade desde el comienzo a opacidad cercana a 1% (~0.02), reaparece lento al hover */
  #site-header[data-transparent-until-scroll='true'] {
    background-color: transparent !important;
    border-bottom-color: transparent !important;
    box-shadow: none !important;
  }

  #site-header[data-transparent-until-scroll='true']:not(.is-scrolled) {
    opacity: 0.02;
    transition: opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.7s ease, border-color 0.7s ease;
  }

  #site-header[data-transparent-until-scroll='true']:not(.is-scrolled):hover,
  #site-header[data-transparent-until-scroll='true']:not(.is-scrolled):focus-within {
    opacity: 1 !important;
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #site-header[data-transparent-until-scroll='true'].is-scrolled,
  #site-header.is-scrolled {
    opacity: 1 !important;
    background-color: rgba(26, 28, 29, 0.88) !important;
    border-bottom-color: rgba(255, 255, 255, 0.06) !important;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: opacity 0.4s ease, background-color 0.5s ease;
  }

  [data-theme='light'] #site-header[data-transparent-until-scroll='true'] .header-brand-title,
  [data-theme='light'] #site-header[data-transparent-until-scroll='true'] .header-nav-link,
  [data-theme='light'] #site-header[data-transparent-until-scroll='true'] .header-btn-codice,
  [data-theme='light'] #site-header[data-transparent-until-scroll='true'] .header-action-btn {
    color: #F5F5F7 !important;
  }

  [data-theme='light'] #site-header[data-transparent-until-scroll='true'] .header-action-btn svg {
    stroke: #F5F5F7 !important;
    color: #F5F5F7 !important;
  }

  @keyframes soft-pulse {
    0%, 100% { transform: scale(1.05); }
    50% { transform: scale(1.08); }
  }
  .animate-soft-pulse {
    animation: soft-pulse 3.5s ease-in-out infinite;
  }
</style>
