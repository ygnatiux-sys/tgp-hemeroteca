---
// Header Component Institucional (Dark Academia Premium)
import { BuscadorModal } from './BuscadorModal';
---

<header class="fixed top-0 w-full z-100 bg-black/60 backdrop-blur-xl border-b border-white/5 transition-all duration-700">
  <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 py-4 flex justify-between items-center">
    <div class="flex items-center gap-6">
      <a href="/" class="group flex flex-row items-center gap-3">
        <div class="brand-element w-9.5 h-9.5 md:w-10 md:h-10 rounded-full border border-white/25 flex items-center justify-center overflow-hidden group-hover:border-[#C8A98B]/60 transition-all duration-700 opacity-0 blur-md translate-y-2 bg-white/3">
          <img src="/favicon.png" alt="TGP Logo" class="w-6 h-6 md:w-6.5 md:h-6.5 object-contain brightness-150 grayscale group-hover:grayscale-0 transition-all duration-500" />
        </div>
        <div class="brand-element flex flex-col opacity-0 blur-md translate-y-2">
          <span class="font-serif tracking-[0.22em] text-[11px] md:text-[11.5px] uppercase text-transparent bg-clip-text bg-linear-to-b from-[#f0f0f0] to-[#e0e0e0]/40 drop-shadow-2xl group-hover:text-[#C8A98B] transition-all duration-700 font-medium">
            The Great Puzzle Project
          </span>
        </div>
      </a>
      
      {/* Tagline de la Franja */}
      <div class="hidden lg:block brand-element border-l border-white/10 pl-6 opacity-0 blur-md translate-y-2">
        <span class="font-mono text-[8px] uppercase tracking-[0.4em] text-white/30 italic">
          Investigación & Cartografía Epistémica
        </span>
      </div>
    </div>
    
    <div class="flex items-center gap-4 md:gap-6">
      {/* Navegación Tradicional (Se oculta en móvil o al condensar) */}
      <nav class="hidden md:flex items-center gap-3 sm:gap-6 shrink-0">
        <a href="/" class="font-mono text-[9px] uppercase tracking-[0.3em] text-white/40 hover:text-white transition-all duration-500">Inicio</a>
        <a href="/colecciones" class="font-mono text-[9px] uppercase tracking-[0.2em] sm:tracking-[0.3em] text-white/40 hover:text-white transition-all duration-500">Colecciones</a>
        <a href="/archivo" class="font-mono text-[9px] uppercase tracking-[0.2em] sm:tracking-[0.3em] text-white/40 hover:text-white transition-all duration-500">Archivo</a>
        <a href="/manifiesto" class="font-mono text-[9px] uppercase tracking-[0.2em] sm:tracking-[0.3em] text-white/40 hover:text-white transition-all duration-500">Manifiesto</a>
        <a href="/codice" class="px-3 sm:px-4 py-1 sm:py-2 border border-white/10 rounded-full font-mono text-[8px] sm:text-[9px] uppercase tracking-[0.2em] sm:tracking-[0.3em] text-white/80 hover:text-white hover:border-white/30 transition-all duration-500 bg-white/5 whitespace-nowrap">El Códice</a>
      </nav>

      {/* Lupa de Búsqueda + Menú Sándwich 3 Guiones ≡ */}
      <BuscadorModal client:load />
    </div>
  </div>
</header>

<script>
  const setupHeaderReveal = () => {
    const elements = document.querySelectorAll('.brand-element');
    elements.forEach((el, index) => {
      setTimeout(() => {
        el.classList.remove('opacity-0', 'blur-md', 'translate-y-2');
        el.classList.add('opacity-100', 'blur-0', 'translate-y-0');
      }, index * 400 + 400);
    });
  };

  document.addEventListener('DOMContentLoaded', setupHeaderReveal);
  document.addEventListener('astro:page-load', setupHeaderReveal);
</script>

<style>
  .brand-element {
    transition: all 2.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
</style>
