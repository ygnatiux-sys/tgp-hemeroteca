---
// Header Component Institucional (Dark Academia Premium)
import { BuscadorModal } from './BuscadorModal';
---

<header class="fixed top-0 w-full z-100 bg-black/70 backdrop-blur-xl border-b border-white/5 transition-all duration-700">
  <div class="max-w-360 mx-auto px-4 md:px-8 lg:px-12 py-3.5 flex justify-between items-center">
    <div class="flex items-center gap-6">
      <a href="/" class="group flex flex-row items-center gap-3">
        <div class="brand-element w-9 h-9 md:w-9.5 md:h-9.5 rounded-full border border-white/20 flex items-center justify-center overflow-hidden group-hover:border-[#C8A98B] group-hover:shadow-[0_0_14px_rgba(200,169,139,0.35)] transition-all duration-500 bg-transparent">
          <img src="/favicon.png" alt="TGP Logo" class="w-5.5 h-5.5 object-contain brightness-150 grayscale group-hover:grayscale-0 transition-all duration-500" />
        </div>
        <div class="brand-element flex flex-col">
          <span class="font-serif tracking-[0.24em] text-[11px] md:text-[12px] uppercase text-transparent bg-clip-text bg-linear-to-b from-[#ffffff] to-[#ffffff]/70 drop-shadow-2xl group-hover:text-[#C8A98B] transition-all duration-500 font-semibold">
            The Great Puzzle Project
          </span>
        </div>
      </a>
    </div>
    
    <div class="flex items-center gap-4 md:gap-6">
      {/* Navegación Tradicional Limpia & Translúcida (Sin Bordes Persistentes) */}
      <nav class="hidden md:flex items-center gap-4 sm:gap-6 shrink-0 font-mono text-[9px] uppercase tracking-[0.28em]">
        <a href="/" class="text-white/60 hover:text-white hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.7)] transition-all duration-300">Inicio</a>
        <a href="/colecciones" class="text-white/60 hover:text-white hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.7)] transition-all duration-300">Colecciones</a>
        <a href="/archivo" class="text-white/60 hover:text-white hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.7)] transition-all duration-300">Archivo</a>
        <a href="/manifiesto" class="text-white/60 hover:text-white hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.7)] transition-all duration-300">Manifiesto</a>
        <a href="/codice" class="px-3.5 py-1.5 border border-transparent rounded-full text-white/70 bg-transparent hover:text-white hover:bg-white/15 hover:border-[#C8A98B] hover:shadow-[0_0_16px_rgba(200,169,139,0.35)] transition-all duration-300 whitespace-nowrap">El Códice</a>
      </nav>

      {/* Lupa de Búsqueda + Menú Sándwich 3 Guiones ≡ */}
      <BuscadorModal client:load />
    </div>
  </div>
</header>

<script>
  const setupHeaderReveal = () => {
    const elements = document.querySelectorAll('.brand-element');
    elements.forEach((el, index) => {
      setTimeout(() => {
        el.classList.remove('opacity-0', 'blur-md', 'translate-y-2');
        el.classList.add('opacity-100', 'blur-0', 'translate-y-0');
      }, index * 400 + 400);
    });
  };

  document.addEventListener('DOMContentLoaded', setupHeaderReveal);
  document.addEventListener('astro:page-load', setupHeaderReveal);
</script>

<style>
  .brand-element {
    transition: all 2.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
</style>
