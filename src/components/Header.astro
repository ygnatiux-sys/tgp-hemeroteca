---
// Header Component Institucional (Dark Academia Premium)
import { BuscadorModal } from './BuscadorModal';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="fixed top-0 w-full z-100 bg-(--header-bg) backdrop-blur-xl border-b border-(--header-border) transition-all duration-700 shadow-xs">
  <div class="max-w-400 mx-auto px-6 md:px-10 lg:px-14 py-4 md:py-5 lg:py-5.5 flex justify-between items-center gap-8 md:gap-16 lg:gap-24 xl:gap-32">
    <div class="flex items-center shrink-0">
      <a href="/" class="group flex flex-row items-center gap-4" title="The Great Puzzle Project">
        {/* Isotipo Vectorial Verdadero Circular (Color Heredado de CSS) */}
        <div class="brand-element w-11 h-11 md:w-12 md:h-12 rounded-full border border-current/25 bg-current/5 flex items-center justify-center group-hover:scale-105 transition-all duration-300 shrink-0">
          <svg class="w-6.5 h-6.5 md:w-7 md:h-7 text-current group-hover:text-rust-orange transition-colors" viewBox="0 0 100 100" fill="none">
            <path
              d="M 34 28
                 H 42
                 C 41.5 21, 37 10, 50 10
                 C 63 10, 58.5 21, 58 28
                 H 66
                 A 6 6 0 0 1 72 34
                 V 66
                 A 6 6 0 0 1 66 72
                 H 58
                 C 58.5 79, 63 90, 50 90
                 C 37 90, 41.5 79, 42 72
                 H 34
                 A 6 6 0 0 1 28 66
                 V 58
                 C 35 58.5, 45 63, 45 50
                 C 45 37, 35 41.5, 28 42
                 V 34
                 A 6 6 0 0 1 34 28
                 Z"
              stroke="currentColor"
              stroke-width="5.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>
        <div class="brand-element flex flex-col">
          <span class="header-brand-title gradient-steel-brand text-base md:text-lg lg:text-[20px] leading-tight transition-colors">
            The Great Puzzle Project
          </span>
        </div>
      </a>
    </div>
    
    <div class="flex items-center gap-6 md:gap-10 lg:gap-14 ml-auto">
      {/* Navegación Tradicional Fina en Monoespaciado con Tracking Amplio (Aireado y Desplazado a la Derecha) */}
      <nav class="hidden md:flex items-center gap-7 lg:gap-10 xl:gap-12 shrink-0 font-mono font-light text-xs md:text-[13px] uppercase tracking-[0.28em]">
        <a href="/" class="header-nav-link transition-colors">Inicio</a>
        <a href="/colecciones" class="header-nav-link transition-colors">Colecciones</a>
        <a href="/archivo" class="header-nav-link transition-colors">Archivo</a>
        <a href="/manifiesto" class="header-nav-link transition-colors">Manifiesto</a>
        <a href="/codice" class="header-btn-codice px-3.5 py-1.5 rounded-xl font-mono font-light text-xs uppercase tracking-[0.28em] transition-all whitespace-nowrap">
          El Códice
        </a>
      </nav>

      {/* Botonera de Acción Simétrica y Coherente */}
      <div class="flex items-center gap-2.5 md:gap-3">
        {/* Toggle Sol / Luna */}
        <ThemeToggle />

        {/* Lupa de Búsqueda + Menú Sándwich 3 Guiones ≡ */}
        <BuscadorModal client:load />
      </div>
    </div>
  </div>
</header>
