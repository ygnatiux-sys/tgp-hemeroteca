---
import { resolveMultivisionClass } from "../lib/multivision";
/**
 * SpotlightMediaTray.astro
 * Bandeja horizontal estilo Row Netflix Clásico (Sibling Push + Chevrons + Hover Delay)
 * Diseñada para anclarse en el 25% inferior del Hero Cover de Archivo General.
 */
import { sanitizeImageUrl } from '../lib/content-filter';

export interface TrayCollectionItem {
  slug: string;
  title: string;
  excerpt?: string;
  coverImage?: any;
  category?: string;
  count?: number;
  link?: string;
}

interface Props {
  collections: TrayCollectionItem[];
  eyebrow?: string;
  title?: string;
  allLink?: string;
  cardAspect?: "landscape" | "portrait";
}

const { 
  collections = [], 
  eyebrow = "COLECCIONES DEL ARCHIVO",
  title = "COLECCIONES",
  allLink = "/colecciones/",
  cardAspect = "landscape"
} = Astro.props;

const uid = `tray-${Math.random().toString(36).substring(2, 8)}`;
---

{collections.length > 0 && (
  <div id={uid} class="spotlight-media-tray-root w-full z-20 select-none">
    {/* Encabezado discreto de la bandeja a ancho total con tokens heredados */}
    <div class="flex flex-col mb-4 px-3 sm:px-6 md:px-8">
      {eyebrow && (
        <span class="text-xs sm:text-[13px] uppercase tracking-[0.4em] font-mono text-rust-orange font-bold mb-1">
          {eyebrow}
        </span>
      )}
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-cinzel font-extrabold text-2xl sm:text-3xl md:text-4xl tracking-tight gradient-general-h1 uppercase">
          {title}
        </h2>
        {allLink && (
          <a 
            href={allLink} 
            class="text-[13px] uppercase tracking-[0.3em] font-mono text-white/50 hover:text-rust-orange transition-colors pb-1"
          >
            Ver Todas →
          </a>
        )}
      </div>
    </div>

    {/* Contenedor del Carrusel con Chevrons */}
    <div class="relative w-full">
      {/* Botón Anterior Flotante en Cápsula con tokens heredados */}
      <button 
        type="button"
        class="tray-nav-btn prev-btn absolute left-1 sm:left-2 md:left-4 top-1/2 -translate-y-1/2 z-40 w-9 md:w-11 h-20 md:h-24 rounded-full bg-black/40 hover:bg-black/85 text-[#E3DDD3]/40 hover:text-[#EFEBE3] border border-[#E3DDD3]/10 hover:border-[#E3DDD3]/30 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-70 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none disabled:opacity-0 disabled:pointer-events-none"
        aria-label="Colecciones anteriores"
      >
        <svg class="w-5 h-5 md:w-6 md:h-6 -translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      </button>

      {/* Botón Siguiente Flotante en Cápsula con tokens heredados */}
      <button 
        type="button"
        class="tray-nav-btn next-btn absolute right-1 sm:right-2 md:right-4 top-1/2 -translate-y-1/2 z-40 w-9 md:w-11 h-20 md:h-24 rounded-full bg-black/40 hover:bg-black/85 text-[#E3DDD3]/40 hover:text-[#EFEBE3] border border-[#E3DDD3]/10 hover:border-[#E3DDD3]/30 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-70 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none disabled:opacity-0 disabled:pointer-events-none"
        aria-label="Siguientes colecciones"
      >
        <svg class="w-4 h-4 md:w-5 md:h-5 translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </button>

      {/* Pista de Deslizamiento con Sibling Push y margen vertical para hover al 15% */}
      <div class="tray-track-wrapper py-6 sm:py-8 px-3 sm:px-6 md:px-8">
        <div class="tray-track flex w-max gap-4 sm:gap-5 md:gap-6 transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]">
          {collections.map((col) => {
            const rawImg = col.coverImage;
            const imgUrl = sanitizeImageUrl(typeof rawImg === 'object' && rawImg?.src ? rawImg.src : (typeof rawImg === 'string' ? rawImg : '')) || 'https://images.unsplash.com/photo-1547036967-23d11aacaee0?q=80&w=1200&auto=format&fit=crop';
            const linkUrl = col.link || `/colecciones/${col.slug}/`;

            if (import.meta.env.DEV && cardAspect === "portrait") {
              if (imgUrl.includes('hero-') || imgUrl.includes('pano-') || imgUrl.includes('cover-')) {
                console.warn(`[TGP Vision] Advertencia: Se inyectó una imagen panorámica (${imgUrl.split('/').pop()}) en un contenedor vertical. Aplicando fallback cinemático.`);
              }
            }

            const fallbackClass = cardAspect === "portrait" ? "w-full h-full object-contain bg-[#0a0c0f]" : "w-full h-full object-cover";

            return (
              <a
                href={linkUrl}
                class:list={[
                  "tray-card shrink-0 rounded-2xl md:rounded-3xl overflow-hidden cursor-pointer relative border border-white/10 bg-theme-dark/80 shadow-2xl group/traycard focus:outline-none transition-all duration-300",
                  cardAspect === "landscape"
                    ? "w-65 sm:w-80 md:w-90 aspect-video"
                    : "aspect-2/3 h-52 sm:h-60 md:h-68 lg:h-76 w-auto"
                ]}
                aria-label={`Explorar colección: ${col.title}`}
              >
                {/* Imagen de Portada con zoom suave heredado */}
                <img 
                  src={imgUrl}
                  alt={col.title}
                  class={`absolute inset-0 object-center pointer-events-none brightness-90 contrast-[1.03] transition-transform duration-700 ease-out group-hover/traycard:scale-[1.02] group-hover/traycard:brightness-95 z-0 ${fallbackClass}`}
                  loading="lazy"
                  decoding="async"
                />

                {/* Scrim degradado idéntico a las cards de Bento */}
                <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/50 via-45% to-transparent pointer-events-none z-10" />

                {/* Información Editorial en la base con tipografía y jerarquía heredada */}
                <div class="relative z-20 p-4 sm:p-5 flex flex-col justify-end h-full pointer-events-auto select-text cursor-text">
                  {/* Badge de Categoría */}
                  <span class="font-mono text-xs sm:text-[13px] uppercase tracking-widest text-rust-orange font-bold mb-1 block">
                    {col.category || 'Colección TGP'}
                  </span>

                  {/* Título en Gloock con degradado general H2 */}
                  <h3 class="gradient-general-h2 text-base sm:text-lg md:text-xl font-serif font-extrabold leading-tight mb-1 group-hover/traycard:brightness-110 transition-all">
                    {col.title}
                  </h3>

                  {/* Artículo destacado como hook visual (fuente Serif heredada) */}
                  {col.excerpt && (
                    <p class="font-serif text-white/60 text-sm sm:text-[15px] line-clamp-1 mb-1 tracking-wide">
                      {col.excerpt}
                    </p>
                  )}

                  {/* Conteo de documentos */}
                  <p class="font-sans text-[13px] sm:text-sm text-white/50">
                    {col.count ? `${col.count} ${col.count === 1 ? 'Documento' : 'Documentos'}` : ''}
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
)}

<style>
  .tray-track-wrapper {
    width: 100%;
    overflow-x: clip;
    overflow-y: visible;
  }

  .tray-track {
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  /* ── MOVIMIENTO Y HOVER HEREDADO (EXPANSIÓN 15% + BORDE FINO RUST-ORANGE + SIBLING PUSH) ── */
  .tray-card {
    transform: translate3d(0, 0, 0) scale(1);
    transform-origin: center center;
    border-color: transparent;
    transition: 
      transform 300ms cubic-bezier(0.25, 1, 0.5, 1), 
      opacity 250ms ease,
      box-shadow 300ms ease, 
      border-color 300ms ease;
    will-change: transform, opacity;
  }

  .tray-card:first-child {
    transform-origin: left center;
  }

  .tray-card:last-child {
    transform-origin: right center;
  }

  /* Aumento de 15% en hover con el borde fino idéntico a Sitios Geohistóricos (solo aparece al hover) */
  .tray-card:hover {
    transform: translate3d(0, -6px, 0) scale(1.15);
    z-index: 40 !important;
    border-color: rgba(239, 235, 227, 0.5) !important;
    box-shadow: 
      0 20px 40px -10px rgba(0, 0, 0, 0.95), 
      0 0 20px rgba(239, 235, 227, 0.12);
    transition-delay: 50ms;
  }

  /* Sibling push sutil en la fila para la tarjeta con aumento del 15% */
  .tray-track:has(.tray-card:hover) .tray-card:not(:hover):has(~ .tray-card:hover) {
    transform: translate3d(-10px, 0, 0) scale(0.98);
    opacity: 0.85;
    transition-delay: 50ms;
  }

  .tray-card:hover ~ .tray-card {
    transform: translate3d(10px, 0, 0) scale(0.98);
    opacity: 0.85;
    transition-delay: 50ms;
  }

  .tray-track:not(:hover) .tray-card {
    transition-delay: 0ms;
  }
</style>

<script>
  function initSpotlightMediaTrays() {
    const trays = document.querySelectorAll<HTMLElement>('.spotlight-media-tray-root');

    trays.forEach(root => {
      if (root.hasAttribute('data-init')) return;
      root.setAttribute('data-init', 'true');

      const track = root.querySelector('.tray-track') as HTMLElement | null;
      const trackWrapper = root.querySelector('.tray-track-wrapper') as HTMLElement | null;
      const prevBtn = root.querySelector('.prev-btn') as HTMLButtonElement | null;
      const nextBtn = root.querySelector('.next-btn') as HTMLButtonElement | null;

      if (!track || !trackWrapper || !prevBtn || !nextBtn) return;

      let currentTransform = 0;

      function updateButtons() {
        if (!track || !trackWrapper || !prevBtn || !nextBtn) return;
        const trackWidth = track.scrollWidth;
        const containerWidth = trackWrapper.offsetWidth;

        prevBtn.disabled = currentTransform >= 0;
        nextBtn.disabled = Math.abs(currentTransform) + containerWidth >= trackWidth - 10;
      }

      function slide(direction: 'next' | 'prev') {
        if (!track || !trackWrapper) return;
        const containerWidth = trackWrapper.offsetWidth;
        const moveAmount = containerWidth * 0.78;

        if (direction === 'next') {
          currentTransform -= moveAmount;
        } else {
          currentTransform += moveAmount;
        }

        const maxScroll = -(track.scrollWidth - containerWidth);
        if (currentTransform > 0) currentTransform = 0;
        if (currentTransform < maxScroll) currentTransform = maxScroll;

        track.style.transform = `translate3d(${currentTransform}px, 0, 0)`;
        updateButtons();
      }

      nextBtn.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); slide('next'); });
      prevBtn.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); slide('prev'); });

      window.addEventListener('resize', () => {
        currentTransform = 0;
        if (track) track.style.transform = 'translate3d(0px, 0, 0)';
        updateButtons();
      });

      // Swipe en móvil
      let touchStartX = 0;
      let touchEndX = 0;

      trackWrapper.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      trackWrapper.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) slide('next');
          else slide('prev');
        }
      }, { passive: true });

      updateButtons();
    });
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSpotlightMediaTrays);
    } else {
      initSpotlightMediaTrays();
    }
    document.addEventListener('astro:page-load', initSpotlightMediaTrays);
  }
</script>
