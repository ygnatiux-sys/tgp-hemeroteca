---
/**
 * src/components/AbyssHero.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * PARALAJE DE ABISMO (Profundidad Z) — GSAP Core
 *
 * 1. Paleta terrosa y opresiva: Carbón absoluto (#0a0a0a) + Cinabrio / Ámbar Quemado.
 * 2. Tipografía: Clash Display Bold (brutalismo arqueológico).
 * 3. Animación Z: El titular masivo frontal escala hacia abajo (scale: 0.45) y
 *    se precipita en perspectiva hacia el fondo del túnel (translateZ: -500px),
 *    mientras el subtítulo emerge a la superficie con nitidez.
 */
interface Props {
  image: ImageMetadata;
  imageScale?: number;
  imageFilter?: string;
  imagePosition?: string;
  word: string;
  subtitle: string;
  fontHref?: string;
  fontFamily?: string;
  speed?: number;
  showHud?: boolean;
  hudLabel?: string;
}

const {
  image,
  imageScale = 1,
  imageFilter = "contrast(1.15) brightness(0.85)",
  imagePosition = "center",
  word,
  subtitle,
  fontHref = "https://api.fontshare.com/v2/css?f[]=clash-display@600,700&display=swap",
  fontFamily = "'Clash Display', 'Inter', system-ui, sans-serif",
  speed = 1,
  showHud = true,
  hudLabel = "Paralaje de Abismo · Derinkuyu",
} = Astro.props;
---

<link rel="preconnect" href="https://api.fontshare.com" />
<link rel="stylesheet" href={fontHref} />

<section class="abyss-stage" aria-label={word}>
  <!-- Fondo cinemático con foto del túnel / rueda de molino -->
  <div class="abyss-bg-wrap">
    <img
      class="abyss-img"
      src={image.src}
      alt=""
      style={`--s:${imageScale};object-position:${imagePosition};filter:${imageFilter};`}
      loading="eager"
      decoding="async"
    />
  </div>

  <!-- Iluminación: viñeta de carbón absoluto + halo cálido de la antorcha -->
  <div class="abyss-vignette"></div>
  <div class="abyss-torch"></div>
  <div class="abyss-grain"></div>
  <div class="abyss-ash" aria-hidden="true"></div>

  <!-- Escenario de Perspectiva Tridimensional (Eje Z) -->
  <div class="abyss-viewport">
    <div class="abyss-chamber">
      <h1 class="abyss-h1" aria-label={word} style={`font-family:${fontFamily};`}>
        {word}
      </h1>
      <h2 class="abyss-sub">
        <span class="abyss-sub-dash">—</span>
        {subtitle}
      </h2>
    </div>
  </div>

  {
    showHud ? (
      <div class="abyss-hud">
        <div class="abyss-hud-head">
          <span class="abyss-hud-dot" />
          <span>{hudLabel}</span>
        </div>
        <button type="button" id="abyss-replay" class="abyss-hud-btn">
          Caer al Abismo (Espacio)
        </button>
        <div class="abyss-hud-speeds">
          <button type="button" class="abyss-speed" data-speed="1.6">Rápido</button>
          <button type="button" class="abyss-speed is-active" data-speed="1">Místico</button>
          <button type="button" class="abyss-speed" data-speed="0.6">Profundo</button>
        </div>
      </div>
    ) : (
      <button type="button" id="abyss-replay" class="abyss-replay" aria-label="Repetir descenso">
        ↻
      </button>
    )
  }
</section>

<noscript>
  <style>
    .abyss-h1,
    .abyss-sub {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  </style>
</noscript>

<style>
  .abyss-stage {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 580px;
    overflow: hidden;
    background: #0a0a0a;
    color: #fff;
  }

  .abyss-bg-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .abyss-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--s));
    will-change: transform;
  }

  /* Viñeta opresiva de carbón absoluto (#0a0a0a) */
  .abyss-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 50% 50%,
      rgba(10, 10, 10, 0.2) 0%,
      rgba(10, 10, 10, 0.65) 60%,
      rgba(10, 10, 10, 0.96) 95%
    );
    pointer-events: none;
  }

  /* Resplandor cálido de la antorcha sobre la ceniza */
  .abyss-torch {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 66% 72%,
      rgba(217, 99, 63, 0.24) 0%,
      rgba(184, 58, 36, 0.12) 28%,
      transparent 60%
    );
    mix-blend-mode: screen;
    pointer-events: none;
  }

  /* Grano analógico A24 */
  .abyss-grain {
    position: absolute;
    inset: 0;
    opacity: 0.22;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.92' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    pointer-events: none;
    animation: abyss-grain-anim 0.8s steps(5) infinite;
  }

  @keyframes abyss-grain-anim {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-2%, 1%); }
    50% { transform: translate(1%, -2%); }
    75% { transform: translate(-1%, 2%); }
    100% { transform: translate(0, 0); }
  }

  .abyss-ash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
  }

  .abyss-ash :global(span) {
    position: absolute;
    border-radius: 50%;
    background: #e69a46;
    pointer-events: none;
  }

  /* Cámara de Perspectiva 3D */
  .abyss-viewport {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1100px;
    perspective-origin: 50% 48%;
    z-index: 6;
    pointer-events: none;
    padding: 2rem 4vw;
  }

  .abyss-chamber {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform-style: preserve-3d;
    width: 100%;
    max-width: 1400px;
    text-align: center;
  }

  /* TÍTULO BRUTALISTA: Clash Display con Cinabrio / Ámbar Quemado */
  .abyss-h1 {
    margin: 0;
    font-size: clamp(3.8rem, 15vw, 15.5rem);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    will-change: transform, opacity, filter;
    /* Gradiente cinabrio / óxido / ámbar quemado sobre ceniza volcánica */
    background: linear-gradient(
      180deg,
      #f2825c 0%,
      #d45632 32%,
      #9e2a18 70%,
      #4a0d06 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter: drop-shadow(0 20px 45px rgba(0, 0, 0, 0.98))
      drop-shadow(0 0 45px rgba(184, 58, 36, 0.38));
  }

  /* SUBTÍTULO: Blanco marfil nítido con acento ámbar que emerge */
  .abyss-sub {
    position: absolute;
    margin: 0;
    top: 50%;
    transform: translateY(-50%);
    font-family: "Inter", system-ui, sans-serif;
    font-size: clamp(0.85rem, 2.2vw, 1.45rem);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #f7ebe1;
    opacity: 0;
    will-change: transform, opacity, filter;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.95), 0 0 20px rgba(230, 154, 70, 0.4);
  }

  .abyss-sub-dash {
    color: #e69a46;
    margin-right: 0.4rem;
  }

  /* HUD de Control */
  .abyss-hud {
    position: absolute;
    top: 5.5rem;
    right: 1.5rem;
    z-index: 25;
    width: 16rem;
    padding: 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-radius: 1rem;
    background: rgba(10, 10, 10, 0.88);
    border: 1px solid rgba(217, 99, 63, 0.28);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(16px);
    font-family: "Inter", system-ui, sans-serif;
  }

  .abyss-hud-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #e69a46;
    font-weight: 700;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .abyss-hud-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #e69a46;
    box-shadow: 0 0 8px #e69a46;
  }

  .abyss-hud-btn {
    padding: 0.75rem;
    border-radius: 0.7rem;
    border: 0;
    cursor: pointer;
    background: linear-gradient(90deg, #d45632, #e69a46);
    color: #0a0a0a;
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .abyss-hud-btn:hover {
    filter: brightness(1.1);
  }

  .abyss-hud-btn:active {
    transform: scale(0.96);
  }

  .abyss-hud-speeds {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 0.6rem;
    background: rgba(255, 255, 255, 0.05);
  }

  .abyss-speed {
    padding: 0.4rem 0;
    border: 0;
    border-radius: 0.4rem;
    cursor: pointer;
    background: transparent;
    color: #b5aba2;
    font-size: 0.62rem;
    letter-spacing: 0.05em;
  }

  .abyss-speed.is-active {
    background: #d45632;
    color: #fff;
    font-weight: 700;
  }

  .abyss-replay {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 20;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(10, 10, 10, 0.6);
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.1rem;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all 0.25s ease;
  }

  .abyss-replay:hover {
    color: #fff;
    border-color: #e69a46;
    transform: rotate(-90deg);
  }
</style>

<script>
  import gsap from "gsap";

  const setupAbyss = () => {
    const stage = document.querySelector<HTMLElement>(".abyss-stage");
    if (!stage || stage.dataset.ready === "true") return;
    stage.dataset.ready = "true";

    const h1 = stage.querySelector<HTMLElement>(".abyss-h1");
    const sub = stage.querySelector<HTMLElement>(".abyss-sub");
    const img = stage.querySelector<HTMLElement>(".abyss-img");
    const ash = stage.querySelector<HTMLElement>(".abyss-ash");
    const replayBtn = document.getElementById("abyss-replay");
    const speedBtns = document.querySelectorAll<HTMLElement>(".abyss-speed");

    if (!h1 || !sub || !img || !ash) return;

    let speed = 1;
    let tl: gsap.core.Timeline | null = null;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const spawnAsh = () => {
      ash.innerHTML = "";
      const count = 32;
      const w = stage.offsetWidth;
      const h = stage.offsetHeight;

      for (let i = 0; i < count; i++) {
        const dot = document.createElement("span");
        const s = 1.2 + Math.random() * 2.8;
        dot.style.width = `${s}px`;
        dot.style.height = `${s}px`;
        dot.style.left = `${Math.random() * w}px`;
        dot.style.top = `${h * 0.4 + Math.random() * h * 0.5}px`;
        dot.style.opacity = "0";
        ash.appendChild(dot);

        gsap.to(dot, {
          opacity: 0.2 + Math.random() * 0.6,
          y: -(40 + Math.random() * 120),
          x: (Math.random() - 0.5) * 60,
          duration: 3 + Math.random() * 3,
          ease: "sine.inOut",
          repeat: -1,
          yoyo: true,
          delay: Math.random() * 2,
        });
      }
    };

    const reset = () => {
      tl?.kill();
      tl = null;
      gsap.set(h1, {
        opacity: 0,
        scale: 1.08,
        z: 0,
        y: 0,
        filter: "blur(0px)",
      });
      gsap.set(sub, {
        opacity: 0,
        y: 50,
        filter: "blur(12px)",
      });
      gsap.set(img, {
        scale: 1,
      });
    };

    const play = async () => {
      if (document.fonts?.ready) await document.fonts.ready;
      reset();

      if (reduceMotion) {
        gsap.set(h1, { opacity: 0.25, scale: 0.5, z: -400 });
        gsap.set(sub, { opacity: 1, y: 0, filter: "blur(0px)" });
        return;
      }

      tl = gsap.timeline();

      // FASE 1: El título masivo aparece sólido en el primer plano frontal
      tl.to(h1, {
        opacity: 1,
        scale: 1,
        duration: 1.4,
        ease: "power2.out",
      })
        // FASE 2: Contemplación de la monumentalidad subterránea
        .to({}, { duration: 0.9 })
        .addLabel("abyss")
        // FASE 3: PARALAJE DE ABISMO (Profundidad Z)
        // El título no sube: cae hacia el fondo del túnel tridimensional (scale 0.46, Z -520px)
        .to(
          h1,
          {
            scale: 0.46,
            z: -520,
            y: 35,
            opacity: 0.14,
            filter: "blur(9px)",
            duration: 2.8,
            ease: "power3.inOut",
          },
          "abyss"
        )
        // La cámara avanza lentamente hacia el interior del túnel aumentando el vértigo
        .to(
          img,
          {
            scale: 1.07,
            duration: 3.2,
            ease: "power2.out",
          },
          "abyss"
        )
        // FASE 4: La revelación. El H2 asciende a la superficie con nitidez
        .to(
          sub,
          {
            opacity: 1,
            y: 0,
            filter: "blur(0px)",
            duration: 2.0,
            ease: "power2.out",
          },
          "abyss+=1.0"
        );

      tl.timeScale(speed);
    };

    spawnAsh();
    reset();
    setTimeout(play, 500);

    replayBtn?.addEventListener("click", play);

    speedBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        speedBtns.forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        speed = parseFloat(btn.dataset.speed || "1");
        play();
      });
    });

    window.addEventListener("keydown", (e) => {
      if (e.code === "Space" && (e.target as HTMLElement)?.tagName !== "INPUT") {
        e.preventDefault();
        play();
      }
    });
  };

  document.addEventListener("astro:page-load", setupAbyss);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupAbyss);
  } else {
    setupAbyss();
  }
</script>
