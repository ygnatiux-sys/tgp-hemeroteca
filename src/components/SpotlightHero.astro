---
/**
 * SpotlightHero.astro
 * "Spotlight Hero con Media Tray" inspirado en la interfaz de National Geographic / Disney+.
 * 
 * Props:
 *  - posts: Array<{ title: string; excerpt?: string; slug: string; coverImage: any; category?: string; isCinematicGSAP?: boolean }>
 *  - eyebrow?: string
 */
import Image from './SafeImage.astro';
import { sanitizeImageUrl, isValidImageSrc, resolveEssayImage } from '../lib/content-filter';

export interface SpotlightPost {
  title?: string;
  excerpt?: string;
  slug: string;
  coverImage?: any;
  category?: string;
  isCinematicGSAP?: boolean;
}

interface Props {
  posts: SpotlightPost[];
  eyebrow?: string;
}

const { posts = [], eyebrow = "EXPLORAR COLECCIÓN RECIENTE" } = Astro.props;

// Normalizamos los posts para el componente
const safePosts = posts.map(p => {
  const rawImg = p.coverImage || resolveEssayImage(p, p.slug);
  const coverUrl = sanitizeImageUrl(typeof rawImg === 'object' && rawImg?.src ? rawImg.src : (typeof rawImg === 'string' ? rawImg : '')) || 'https://images.unsplash.com/photo-1547036967-23d11aacaee0?q=80&w=1200&auto=format&fit=crop';
  const link = p.isCinematicGSAP ? `/ensayos-cinematicos/${p.slug}` : `/hemeroteca/${p.slug}/`;
  
  return {
    title: p.title || 'Ensayo Cinemático',
    excerpt: p.excerpt || '',
    slug: p.slug,
    coverUrl,
    link,
    category: p.category || 'Ensayo'
  };
});

const initialPost = safePosts[0] || null;
const uid = `spotlight-${Math.random().toString(36).substring(2, 8)}`;
---

{safePosts.length > 0 && (
  <section 
    id={uid}
    class="spotlight-hero-root relative min-h-[90vh] flex flex-col justify-between overflow-hidden bg-black py-12 px-6 rounded-2xl md:rounded-3xl select-none"
    aria-label="Spotlight Hero"
  >
    {/* ── BACKDROP DINÁMICO (FONDO AMBIENTAL) ── */}
    <div class="spotlight-backdrop absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <img 
        src={initialPost?.coverUrl}
        alt={initialPost?.title || "Ambiente"}
        class="spotlight-bg-image w-full h-full object-cover scale-105 filter blur-md opacity-40 transition-all duration-700 ease-out"
        loading="eager"
        decoding="async"
      />
      {/* Overlay de control lumínico: centro oscuro para lectura confortable */}
      <div class="absolute inset-0 bg-linear-to-t from-black via-black/80 to-transparent" />
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(0,0,0,0.6)_0%,rgba(0,0,0,0.95)_100%)]" />
    </div>

    {/* ── BLOQUE EDITORIAL CENTRAL (z-10, expandido con grow y centrado) ── */}
    <div class="spotlight-editorial relative z-10 w-full max-w-3xl mx-auto text-center grow flex flex-col justify-center items-center py-6 md:py-10 space-y-4 px-4">
      {initialPost?.category && (
        <span class="spotlight-category font-metadata text-[10px] md:text-xs uppercase tracking-[0.4em] text-rust-orange font-bold block transition-opacity duration-300">
          {initialPost.category}
        </span>
      )}

      <h2 class="spotlight-title font-cinzel font-semibold text-stone-200 text-2xl sm:text-3xl md:text-4xl lg:text-5xl tracking-tight leading-tight transition-all duration-300 max-w-2xl">
        {initialPost?.title}
      </h2>

      <p class="spotlight-excerpt font-alegreya text-stone-400 text-sm sm:text-base leading-relaxed line-clamp-3 max-w-xl font-light transition-all duration-300">
        {initialPost?.excerpt}
      </p>

      <div class="pt-3">
        <a 
          href={initialPost?.link}
          class="spotlight-cta inline-flex items-center gap-2.5 px-8 py-2.5 rounded-full border border-stone-600/80 bg-stone-900/60 hover:bg-stone-800 hover:border-amber-500/80 text-stone-200 hover:text-white font-metadata text-xs uppercase tracking-[0.25em] transition-all duration-300 shadow-lg hover:shadow-amber-500/20 active:scale-95"
        >
          <span>LEER ENSAYO</span>
          <span class="text-amber-500/80 text-sm">→</span>
        </a>
      </div>
    </div>

    {/* ── EMBEDDED MEDIA TRAY (BANDEJA INFERIOR ANCLADA CON MT-AUTO Y MÁX 30% DEL ESPACIO) ── */}
    <div class="spotlight-tray w-full max-w-6xl mx-auto z-10 mt-auto shrink-0 pt-4 pb-6 md:pb-8">
      <div class="flex items-center justify-between mb-3 px-1">
        <span class="font-metadata text-[10px] sm:text-xs uppercase tracking-[0.35em] text-rust-orange/90 font-bold block">
          {eyebrow}
        </span>
        <span class="font-metadata text-[9px] uppercase tracking-[0.25em] text-white/40">
          {safePosts.length} Investigaciones
        </span>
      </div>

      {/* Fila de tarjetas con scroll horizontal suave y altura contenida (h-36 sm:h-44) */}
      <div class="spotlight-track flex gap-3.5 sm:gap-4 overflow-x-auto pb-2 scrollbar-none snap-x py-1 px-1">
        {safePosts.map((post, idx) => {
          const isActive = idx === 0;
          return (
            <button
              type="button"
              class:list={[
                "spotlight-card aspect-2/3 h-36 sm:h-44 w-auto shrink-0 rounded-lg overflow-hidden cursor-pointer relative border transition-all duration-300 snap-start text-left focus:outline-none",
                isActive 
                  ? "spotlight-card-active border-amber-500/80 scale-105 shadow-lg shadow-black/50 ring-1 ring-amber-500/50" 
                  : "border-white/10 opacity-70 hover:opacity-100 hover:scale-100"
              ]}
              data-index={idx}
              data-title={post.title}
              data-excerpt={post.excerpt}
              data-cover={post.coverUrl}
              data-link={post.link}
              data-category={post.category}
              aria-label={`Seleccionar: ${post.title}`}
            >
              {/* Imagen 100% nítida, sin filtros oscuros globales */}
              <img 
                src={post.coverUrl}
                alt={post.title}
                class="w-full h-full object-cover pointer-events-none"
                loading="lazy"
                decoding="async"
              />
            </button>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  /* Ocultar barra de scroll estándar en la bandeja horizontal */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .spotlight-card {
    will-change: transform, opacity, border-color;
  }
</style>

<script>
  function initSpotlightHeroes() {
    const spotlights = document.querySelectorAll<HTMLElement>('.spotlight-hero-root');

    spotlights.forEach(root => {
      if (root.hasAttribute('data-init')) return;
      root.setAttribute('data-init', 'true');

      const bgImg = root.querySelector('.spotlight-bg-image') as HTMLImageElement | null;
      const categoryEl = root.querySelector('.spotlight-category') as HTMLElement | null;
      const titleEl = root.querySelector('.spotlight-title') as HTMLElement | null;
      const excerptEl = root.querySelector('.spotlight-excerpt') as HTMLElement | null;
      const ctaEl = root.querySelector('.spotlight-cta') as HTMLAnchorElement | null;
      const cards = root.querySelectorAll<HTMLButtonElement>('.spotlight-card');

      if (!bgImg || !titleEl || !ctaEl || cards.length === 0) return;

      cards.forEach(card => {
        card.addEventListener('click', () => {
          // Desactivar tarjeta previa
          cards.forEach(c => {
            c.classList.remove('spotlight-card-active', 'border-amber-500/80', 'scale-105', 'shadow-lg', 'shadow-black/50', 'ring-1', 'ring-amber-500/50');
            c.classList.add('border-white/10', 'opacity-70');
          });

          // Activar tarjeta seleccionada
          card.classList.remove('border-white/10', 'opacity-70');
          card.classList.add('spotlight-card-active', 'border-amber-500/80', 'scale-105', 'shadow-lg', 'shadow-black/50', 'ring-1', 'ring-amber-500/50');

          // Suave centrado de la tarjeta en la bandeja
          card.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });

          const newCover = card.dataset.cover || '';
          const newTitle = card.dataset.title || '';
          const newExcerpt = card.dataset.excerpt || '';
          const newLink = card.dataset.link || '#';
          const newCategory = card.dataset.category || '';

          // Transición suave del bloque editorial
          titleEl.style.opacity = '0';
          titleEl.style.transform = 'translateY(6px)';
          if (excerptEl) {
            excerptEl.style.opacity = '0';
            excerptEl.style.transform = 'translateY(6px)';
          }

          // Transición suave del fondo ambiental
          bgImg.style.opacity = '0';

          setTimeout(() => {
            bgImg.onload = () => {
              bgImg.style.opacity = '0.4';
            };
            bgImg.src = newCover;
            // Fallback por si la imagen está en caché
            if (bgImg.complete) {
              bgImg.style.opacity = '0.4';
            }

            titleEl.textContent = newTitle;
            titleEl.style.opacity = '1';
            titleEl.style.transform = 'translateY(0)';

            if (excerptEl) {
              excerptEl.textContent = newExcerpt;
              excerptEl.style.opacity = '1';
              excerptEl.style.transform = 'translateY(0)';
            }

            if (categoryEl && newCategory) {
              categoryEl.textContent = newCategory;
            }

            ctaEl.href = newLink;
          }, 200);
        });
      });
    });
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSpotlightHeroes);
    } else {
      initSpotlightHeroes();
    }
    document.addEventListener('astro:page-load', initSpotlightHeroes);
  }
</script>
