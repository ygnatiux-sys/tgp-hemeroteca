---
/**
 * SpotlightHero.astro
 * "Spotlight Hero con Media Tray" inspirado en la interfaz de National Geographic / Disney+.
 * 
 * Props:
 *  - posts: Array<{ title?: string; excerpt?: string; slug: string; coverImage: any; category?: string; isCinematicGSAP?: boolean }>
 *  - eyebrow?: string
 */
import Image from './SafeImage.astro';
import { sanitizeImageUrl, isValidImageSrc, resolveEssayImage } from '../lib/content-filter';

export interface SpotlightPost {
  title?: string;
  excerpt?: string;
  slug: string;
  coverImage?: any;
  category?: string;
  isCinematicGSAP?: boolean;
  link?: string;
}

interface Props {
  posts: SpotlightPost[];
  eyebrow?: string;
  ctaText?: string;
}

const { 
  posts = [], 
  eyebrow = "EXPLORAR COLECCIÓN RECIENTE",
  ctaText = "EXPLORAR COLECCIÓN"
} = Astro.props;

// Normalizamos los posts para el componente
const safePosts = posts.map(p => {
  const rawImg = p.coverImage || resolveEssayImage(p, p.slug);
  const coverUrl = sanitizeImageUrl(typeof rawImg === 'object' && rawImg?.src ? rawImg.src : (typeof rawImg === 'string' ? rawImg : '')) || 'https://images.unsplash.com/photo-1547036967-23d11aacaee0?q=80&w=1200&auto=format&fit=crop';
  const link = p.link || (p.isCinematicGSAP ? `/ensayos-cinematicos/${p.slug}` : `/hemeroteca/${p.slug}/`);
  
  return {
    title: p.title || 'Ensayo Cinemático',
    excerpt: p.excerpt || '',
    slug: p.slug,
    coverUrl,
    link,
    category: p.category || 'Colección'
  };
});

const initialPost = safePosts[0] || null;
const uid = `spotlight-${Math.random().toString(36).substring(2, 8)}`;
---

{safePosts.length > 0 && (
  <section 
    id={uid}
    class="spotlight-hero-root relative min-h-[90vh] flex flex-col justify-between overflow-hidden bg-black py-8 md:py-12 px-4 md:px-8 rounded-2xl md:rounded-3xl select-none"
    aria-label="Spotlight Hero"
  >
    {/* ── BACKDROP DINÁMICO (FONDO AMBIENTAL) ── */}
    <div class="spotlight-backdrop absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <img 
        src={initialPost?.coverUrl}
        alt={initialPost?.title || "Ambiente"}
        class="spotlight-bg-image w-full h-full object-cover scale-105 filter blur-md opacity-40 transition-all duration-700 ease-out"
        loading="eager"
        decoding="async"
      />
      {/* Overlay de control lumínico: centro oscuro para lectura confortable */}
      <div class="absolute inset-0 bg-linear-to-t from-black via-black/80 to-transparent" />
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(0,0,0,0.6)_0%,rgba(0,0,0,0.95)_100%)]" />
    </div>

    {/* ── BLOQUE EDITORIAL CENTRAL (z-10, expandido con grow y centrado) ── */}
    <div class="spotlight-editorial relative z-10 w-full max-w-3xl mx-auto text-center grow flex flex-col justify-center items-center py-6 md:py-10 space-y-4 px-4">
      {initialPost?.category && (
        <span class="spotlight-category font-metadata text-[10px] md:text-xs uppercase tracking-[0.4em] text-rust-orange font-bold block transition-opacity duration-300">
          {initialPost.category}
        </span>
      )}

      <h2 class="spotlight-title font-cinzel font-semibold text-stone-200 text-2xl sm:text-3xl md:text-4xl lg:text-5xl tracking-tight leading-tight transition-all duration-300 max-w-2xl">
        {initialPost?.title}
      </h2>

      <p class="spotlight-excerpt font-alegreya text-stone-400 text-sm sm:text-base leading-relaxed line-clamp-3 max-w-xl font-light transition-all duration-300">
        {initialPost?.excerpt}
      </p>

      <div class="pt-3">
        <a 
          href={initialPost?.link}
          class="spotlight-cta inline-flex items-center gap-2.5 px-8 py-2.5 rounded-full border border-stone-600/80 bg-stone-900/60 hover:bg-stone-800 hover:border-amber-500/80 text-stone-200 hover:text-white font-metadata text-xs uppercase tracking-[0.25em] transition-all duration-300 shadow-lg hover:shadow-amber-500/20 active:scale-95 cursor-pointer"
        >
          <span class="spotlight-cta-text">{ctaText}</span>
          <span class="text-amber-500/80 text-sm">→</span>
        </a>
      </div>
    </div>

    {/* ── EMBEDDED MEDIA TRAY (BANDEJA INFERIOR SLIDER CON MOVIMIENTO TIPO ROW NETFLIX) ── */}
    <div class="spotlight-tray w-full max-w-6xl mx-auto z-10 mt-auto shrink-0 pt-4 pb-4 md:pb-6">
      <div class="flex items-center justify-between mb-3 px-1">
        <span class="font-metadata text-[10px] sm:text-xs uppercase tracking-[0.35em] text-rust-orange/90 font-bold block">
          {eyebrow}
        </span>
        <span class="font-metadata text-[9px] uppercase tracking-[0.25em] text-white/40">
          {safePosts.length} Colecciones
        </span>
      </div>

      {/* Contenedor Maestro de Navegación */}
      <div class="relative w-full">
        {/* Botón Anterior Flotante en Cápsula */}
        <button 
          type="button"
          class="nav-btn prev-btn absolute -left-2 md:-left-4 top-1/2 -translate-y-1/2 z-30 w-8 md:w-10 h-14 md:h-18 rounded-full bg-black/40 hover:bg-black/85 text-[#E3DDD3]/40 hover:text-[#EFEBE3] border border-[#E3DDD3]/10 hover:border-[#E3DDD3]/30 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-70 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none disabled:opacity-0 disabled:pointer-events-none"
          aria-label="Anterior"
        >
          <svg class="w-4 h-4 md:w-5 md:h-5 -translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>

        {/* Botón Siguiente Flotante en Cápsula */}
        <button 
          type="button"
          class="nav-btn next-btn absolute -right-2 md:-right-4 top-1/2 -translate-y-1/2 z-30 w-8 md:w-10 h-14 md:h-18 rounded-full bg-black/40 hover:bg-black/85 text-[#E3DDD3]/40 hover:text-[#EFEBE3] border border-[#E3DDD3]/10 hover:border-[#E3DDD3]/30 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-70 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none disabled:opacity-0 disabled:pointer-events-none"
          aria-label="Siguiente"
        >
          <svg class="w-4 h-4 md:w-5 md:h-5 translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>

        {/* Pista de Deslizamiento Animada Tipo Netflix */}
        <div class="spotlight-track-wrapper overflow-hidden py-3 px-1">
          <div class="spotlight-track flex gap-3.5 sm:gap-4 transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]">
            {safePosts.map((post, idx) => {
              const isActive = idx === 0;
              return (
                <button
                  type="button"
                  class:list={[
                    "spotlight-card aspect-2/3 h-40 sm:h-48 md:h-52 w-auto shrink-0 rounded-xl overflow-hidden cursor-pointer relative border text-left focus:outline-none shadow-lg",
                    isActive 
                      ? "spotlight-card-active border-amber-500/90 scale-105 shadow-xl shadow-black/80 ring-1 ring-amber-500/60 opacity-100" 
                      : "border-white/10 opacity-70 hover:opacity-100"
                  ]}
                  data-index={idx}
                  data-title={post.title}
                  data-excerpt={post.excerpt}
                  data-cover={post.coverUrl}
                  data-link={post.link}
                  data-category={post.category}
                  aria-label={`Seleccionar: ${post.title}`}
                >
                  {/* Imagen 100% nítida */}
                  <img 
                    src={post.coverUrl}
                    alt={post.title}
                    class="w-full h-full object-cover pointer-events-none transition-transform duration-500 ease-out"
                    loading="lazy"
                    decoding="async"
                  />
                  
                  {/* Scrim degradado estilo Row Netflix Clásico */}
                  <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/45 to-transparent pointer-events-none" />

                  {/* Información Editorial en la base de la tarjeta */}
                  <div class="absolute inset-x-0 bottom-0 p-2 sm:p-3 flex flex-col justify-end pointer-events-none z-10">
                    {post.category && (
                      <span class="text-[7.5px] sm:text-[8px] tracking-[0.25em] font-mono text-rust-orange font-bold uppercase truncate mb-0.5">
                        {post.category}
                      </span>
                    )}
                    <h4 class="font-cinzel text-[11px] sm:text-xs text-white/95 font-semibold line-clamp-2 leading-tight">
                      {post.title}
                    </h4>
                  </div>
                </button>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .spotlight-track-wrapper {
    width: 100%;
  }

  .spotlight-track {
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  /* ── MOVIMIENTO Y HOVER TIPO ROW NETFLIX ── */
  .spotlight-card {
    transform: translate3d(0, 0, 0) scale(1);
    transform-origin: center center;
    transition: 
      transform 340ms cubic-bezier(0.25, 1, 0.5, 1), 
      opacity 300ms ease,
      box-shadow 300ms ease, 
      border-color 300ms ease;
    will-change: transform, opacity;
  }

  .spotlight-card:not(.spotlight-card-active):hover {
    transform: translate3d(0, -6px, 0) scale(1.08);
    z-index: 20;
    opacity: 1;
    border-color: rgba(245, 158, 11, 0.85);
    box-shadow: 0 16px 32px -4px rgba(0, 0, 0, 0.8);
    transition-delay: 100ms;
  }

  .spotlight-card-active {
    transform: translate3d(0, -4px, 0) scale(1.06);
    z-index: 10;
  }

  /* Sibling push sutil en la bandeja horizontal */
  .spotlight-track:has(.spotlight-card:hover) .spotlight-card:not(:hover):has(~ .spotlight-card:hover) {
    transform: translate3d(-6px, 0, 0);
    transition-delay: 100ms;
  }

  .spotlight-card:hover ~ .spotlight-card {
    transform: translate3d(6px, 0, 0);
    transition-delay: 100ms;
  }

  .spotlight-track:not(:hover) .spotlight-card:not(.spotlight-card-active) {
    transition-delay: 0ms;
  }
</style>

<script>
  function initSpotlightHeroes() {
    const spotlights = document.querySelectorAll<HTMLElement>('.spotlight-hero-root');

    spotlights.forEach(root => {
      if (root.hasAttribute('data-init')) return;
      root.setAttribute('data-init', 'true');

      const bgImg = root.querySelector('.spotlight-bg-image') as HTMLImageElement | null;
      const categoryEl = root.querySelector('.spotlight-category') as HTMLElement | null;
      const titleEl = root.querySelector('.spotlight-title') as HTMLElement | null;
      const excerptEl = root.querySelector('.spotlight-excerpt') as HTMLElement | null;
      const ctaEl = root.querySelector('.spotlight-cta') as HTMLAnchorElement | null;
      const cards = root.querySelectorAll<HTMLButtonElement>('.spotlight-card');

      const track = root.querySelector('.spotlight-track') as HTMLElement | null;
      const trackWrapper = root.querySelector('.spotlight-track-wrapper') as HTMLElement | null;
      const prevBtn = root.querySelector('.prev-btn') as HTMLButtonElement | null;
      const nextBtn = root.querySelector('.next-btn') as HTMLButtonElement | null;

      if (!bgImg || !titleEl || !ctaEl || cards.length === 0) return;

      // ─── CONTROL DEL CARRUSEL SLIDER TIPO ROW NETFLIX ───
      let currentTransform = 0;

      function updateButtons() {
        if (!track || !trackWrapper || !prevBtn || !nextBtn) return;
        const trackWidth = track.scrollWidth;
        const containerWidth = trackWrapper.offsetWidth;

        prevBtn.disabled = currentTransform >= 0;
        nextBtn.disabled = Math.abs(currentTransform) + containerWidth >= trackWidth - 10;
      }

      function slide(direction: 'next' | 'prev') {
        if (!track || !trackWrapper) return;
        const containerWidth = trackWrapper.offsetWidth;
        const moveAmount = containerWidth * 0.75;

        if (direction === 'next') {
          currentTransform -= moveAmount;
        } else {
          currentTransform += moveAmount;
        }

        const maxScroll = -(track.scrollWidth - containerWidth);
        if (currentTransform > 0) currentTransform = 0;
        if (currentTransform < maxScroll) currentTransform = maxScroll;

        track.style.transform = `translate3d(${currentTransform}px, 0, 0)`;
        updateButtons();
      }

      if (nextBtn) nextBtn.addEventListener('click', () => slide('next'));
      if (prevBtn) prevBtn.addEventListener('click', () => slide('prev'));

      window.addEventListener('resize', () => {
        currentTransform = 0;
        if (track) track.style.transform = 'translate3d(0px, 0, 0)';
        updateButtons();
      });

      updateButtons();

      // ─── SELECCIÓN INTERACTIVA DE POST ───
      cards.forEach(card => {
        card.addEventListener('click', () => {
          // Desactivar tarjeta previa
          cards.forEach(c => {
            c.classList.remove('spotlight-card-active', 'border-amber-500/90', 'scale-105', 'shadow-xl', 'shadow-black/70', 'ring-1', 'ring-amber-500/60', 'opacity-100');
            c.classList.add('border-white/10', 'opacity-70');
          });

          // Activar tarjeta seleccionada
          card.classList.remove('border-white/10', 'opacity-70');
          card.classList.add('spotlight-card-active', 'border-amber-500/90', 'scale-105', 'shadow-xl', 'shadow-black/70', 'ring-1', 'ring-amber-500/60', 'opacity-100');

          // Auto-ajustar posición si la tarjeta está en el extremo oculto
          if (track && trackWrapper) {
            const cardRect = card.getBoundingClientRect();
            const wrapperRect = trackWrapper.getBoundingClientRect();
            if (cardRect.left < wrapperRect.left + 20) {
              slide('prev');
            } else if (cardRect.right > wrapperRect.right - 20) {
              slide('next');
            }
          }

          const newCover = card.dataset.cover || '';
          const newTitle = card.dataset.title || '';
          const newExcerpt = card.dataset.excerpt || '';
          const newLink = card.dataset.link || '#';
          const newCategory = card.dataset.category || '';

          // Transición suave del bloque editorial
          titleEl.style.opacity = '0';
          titleEl.style.transform = 'translateY(6px)';
          if (excerptEl) {
            excerptEl.style.opacity = '0';
            excerptEl.style.transform = 'translateY(6px)';
          }

          // Transición suave del fondo ambiental
          bgImg.style.opacity = '0';

          setTimeout(() => {
            bgImg.onload = () => {
              bgImg.style.opacity = '0.4';
            };
            bgImg.src = newCover;
            if (bgImg.complete) {
              bgImg.style.opacity = '0.4';
            }

            titleEl.textContent = newTitle;
            titleEl.style.opacity = '1';
            titleEl.style.transform = 'translateY(0)';

            if (excerptEl) {
              excerptEl.textContent = newExcerpt;
              excerptEl.style.opacity = '1';
              excerptEl.style.transform = 'translateY(0)';
            }

            if (categoryEl && newCategory) {
              categoryEl.textContent = newCategory;
            }

            ctaEl.href = newLink;
          }, 200);
        });
      });
    });
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSpotlightHeroes);
    } else {
      initSpotlightHeroes();
    }
    document.addEventListener('astro:page-load', initSpotlightHeroes);
  }
</script>
