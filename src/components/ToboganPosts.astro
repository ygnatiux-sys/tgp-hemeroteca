---
/**
 * ToboganPosts.astro
 * Cascada diagonal tipo 'tobogán' con física orgánica de desaceleración gravitatoria (ease-out).
 * - Progreso X: 1 - (1 - t)^1.5 (amontonamiento suave al final)
 * - Progreso Y: 1 - (1 - t)^2.2 (caída con fuerza y frenado en base)
 * - Torsión angular progresiva: -30° al inicio a -8° en la base (nunca 0° ni positivo)
 * - Z-Index: orden de capas físico creciente
 * - Fade-out: mask-image to bottom right
 */

export interface ToboganItem {
  title: string;
  src: string;
  href: string;
  category?: string;
}

interface Props {
  posts: ToboganItem[];
  titulo?: string;
  subtitulo?: string;
  descripcion?: string;
  cta?: { label: string; href: string };
  badge?: string;
}

const {
  posts = [],
  titulo = "Hemeroteca en Movimiento",
  subtitulo = "Un archivo vivo de señales, memoria y arqueosemiótica",
  descripcion = "Cada investigación publicada es una pieza de un rompecabezas mayor. Explora el acervo completo donde el conocimiento se cartografía como una experiencia visual continua.",
  cta = { label: "Explorar Hemeroteca", href: "/archivo/" },
  badge = "Acervo Cartográfico",
} = Astro.props;
---

{posts.length > 0 && (
  <section class="tobogan-root relative w-full overflow-hidden bg-[#070709] border-t border-white/5 py-24 md:py-32" aria-label="Tobogán de Ensayos">
    {/* Resplandores ambientales de fondo */}
    <div class="pointer-events-none absolute -top-40 right-1/4 w-150 h-150 bg-rust-orange/5 rounded-full blur-[140px]"></div>
    <div class="pointer-events-none absolute -bottom-40 left-1/4 w-125 h-125 bg-sky-950/10 rounded-full blur-[160px]"></div>

    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center min-h-160">
      
      {/* ── COLUMNA IZQUIERDA: Texto Principal Editorial ── */}
      <div class="lg:col-span-5 flex flex-col items-start gap-6 z-20">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/4 border border-white/10 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-rust-orange animate-pulse"></span>
          <span class="font-mono text-[9px] md:text-[10px] uppercase tracking-[0.3em] text-white/70 font-semibold">{badge}</span>
        </div>

        <h2 class="font-cinzel font-black text-3xl sm:text-4xl md:text-5xl lg:text-5xl tracking-tight leading-[1.08] text-white">
          <span class="gradient-steel-titanium block">{titulo}</span>
        </h2>

        <p class="font-sans text-base sm:text-lg text-white/70 font-light leading-relaxed max-w-xl">
          {descripcion}
        </p>

        <p class="font-mono text-xs uppercase tracking-[0.2em] text-rust-orange/90 font-medium">
          {subtitulo}
        </p>

        {cta && (
          <div class="pt-2">
            <a
              href={cta.href}
              class="group inline-flex items-center gap-3 px-7 py-3.5 rounded-full bg-white/6 hover:bg-rust-orange/15 border border-white/15 hover:border-rust-orange/50 text-white font-mono text-[11px] uppercase tracking-[0.25em] transition-all duration-400 shadow-xl hover:shadow-[0_0_25px_rgba(224,122,95,0.25)] hover:-translate-y-0.5"
            >
              <span>{cta.label}</span>
              <svg class="w-4 h-4 stroke-current transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        )}
      </div>

      {/* ── COLUMNA DERECHA: Contenedor Relativo del Tobogán ── */}
      <div class="lg:col-span-7 relative flex justify-start items-center w-full min-h-120 sm:min-h-145 lg:min-h-170">
        
        {/* Viewport global con máscara diagonal de fade-out */}
        <div class="tobogan-viewport relative w-full h-140 sm:h-165 lg:h-180">
          
          {/* Riel deslizante GSAP */}
          <div class="tobogan-track" id="toboganTrack">
            {posts.map((post, idx) => (
              <a
                href={post.href}
                class="tobogan-card group/card"
                data-index={idx}
                style={`z-index: ${idx};`}
                aria-label={post.title}
                title={post.title}
              >
                <div class="tobogan-card-inner">
                  <img
                    src={post.src}
                    alt={post.title}
                    loading="lazy"
                    decoding="async"
                    class="tobogan-img"
                  />
                  
                  <div class="tobogan-vignette"></div>

                  <div class="tobogan-overlay">
                    {post.category && (
                      <span class="tobogan-cat font-mono text-[8px] uppercase tracking-[0.2em] text-rust-orange">
                        {post.category}
                      </span>
                    )}
                    <p class="tobogan-card-title font-cinzel text-xs text-white line-clamp-2 leading-snug">
                      {post.title}
                    </p>
                  </div>
                </div>
              </a>
            ))}
          </div>

        </div>

      </div>

    </div>
  </section>
)}

<style>
  /* ── VIEWPORT Y MÁSCARA DIAGONAL DE FADE-OUT ──
     Las últimas piezas se funden con el fondo oscuro antes de salir de cuadro */
  .tobogan-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(to bottom right, black 55%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom right, black 55%, transparent 100%);
  }

  .tobogan-track {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
  }

  /* ── TARJETA INDIVIDUAL ── */
  .tobogan-card {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(120px, 11vw, 150px);
    height: clamp(120px, 11vw, 150px);
    aspect-ratio: 1 / 1;
    transform-origin: center center;
    display: block;
    text-decoration: none;
    will-change: transform;
  }

  /* ── SOMBRA PARALELA HACIA ABAJO/IZQUIERDA: -15px 15px 30px rgba(0,0,0,0.6) ── */
  .tobogan-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 18px;
    overflow: hidden;
    background-color: #111215;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: -15px 15px 30px rgba(0, 0, 0, 0.6);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .tobogan-card:hover .tobogan-card-inner {
    border-color: rgba(224, 122, 95, 0.7);
    box-shadow:
      -18px 20px 38px rgba(0, 0, 0, 0.8),
      0 0 25px rgba(224, 122, 95, 0.25);
  }

  .tobogan-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    filter: brightness(0.92) contrast(1.04);
    transition: filter 0.3s ease, transform 0.4s ease;
    display: block;
    pointer-events: none;
  }

  .tobogan-card:hover .tobogan-img {
    filter: brightness(1.06) contrast(1.08);
    transform: scale(1.04);
  }

  .tobogan-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at center, transparent 55%, rgba(0, 0, 0, 0.45) 100%);
  }

  .tobogan-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.2) 60%, transparent 100%);
    opacity: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0.85rem;
    gap: 0.25rem;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .tobogan-card:hover .tobogan-overlay {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .tobogan-card {
      width: 100px;
      height: 100px;
    }
    .tobogan-card-inner {
      border-radius: 14px;
      box-shadow: -10px 10px 22px rgba(0, 0, 0, 0.65);
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initTobogan() {
    const track = document.getElementById("toboganTrack");
    if (!track) return;

    if (track.dataset.ready === "1") return;
    track.dataset.ready = "1";

    const section = track.closest(".tobogan-root");
    const cards = Array.from(track.querySelectorAll<HTMLElement>(".tobogan-card"));
    if (!cards.length) return;

    const N = cards.length;
    const prog = (i: number) => (N > 1 ? i / (N - 1) : 0);

    // ── KEYFRAMES MEDIDOS CARTA POR CARTA DEL SAMPLE (11 tarjetas) ──
    // x, y en múltiplos del ancho de carta C. rot en grados (nunca ≥ 0). scale relativa.
    // Al final se "abren": el paso en X crece y la rotación llega a -30°.
    const KF_X     = [0, 0.45, 0.84, 1.30, 1.65, 2.00, 2.45, 3.00, 3.55, 4.08, 4.60];
    const KF_Y     = [0, 0.56, 1.09, 1.55, 1.80, 2.04, 2.38, 2.65, 2.98, 3.26, 3.55];
    const KF_ROT   = [-6, -10, -13, -19, -21, -23, -26, -27, -28, -29, -30];
    const KF_SCALE = [0.95, 0.96, 0.98, 0.99, 1, 1, 1, 1.03, 1.05, 1.08, 1.10];

    // Muestreo lineal del keyframe (si hay ≠ 11 posts se re-muestrea sobre t)
    const sample = (kf: number[], i: number) => {
      const f = prog(i) * (kf.length - 1);
      const a = Math.floor(f);
      const b = Math.min(a + 1, kf.length - 1);
      return kf[a] + (kf[b] - kf[a]) * (f - a);
    };

    const layout = () => {
      // Tamaño de carta según el ancho disponible (recorrido total ≈ 5.6 C)
      const viewport = track.parentElement as HTMLElement;
      const W = viewport?.clientWidth || 640;
      const C = Math.max(84, Math.min(150, W / 5.4));
      const pad = 0.1 * C;

      cards.forEach((card, i) => {
        card.style.width = `${C}px`;
        card.style.height = `${C}px`;
        card.dataset.x = String(pad + sample(KF_X, i) * C);
        card.dataset.y = String(pad + sample(KF_Y, i) * C);
        card.dataset.rot = String(sample(KF_ROT, i));
        card.dataset.scale = String(sample(KF_SCALE, i));
        card.dataset.z = String(i);
      });

      gsap.set(cards, {
        transformOrigin: "center center",
        x: (i: number) => parseFloat(cards[i].dataset.x || "0"),
        y: (i: number) => parseFloat(cards[i].dataset.y || "0"),
        rotation: (i: number) => parseFloat(cards[i].dataset.rot || "-20"),
        scale: (i: number) => parseFloat(cards[i].dataset.scale || "1"),
        zIndex: (i: number) => i, // la carta siguiente tapa a la anterior
        force3D: true,
      });
    };

    layout();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(layout, 150);
    });

    // ── MICRO-INTERACCIÓN HOVER RESPETANDO EL ÁNGULO ORGÁNICO DE CADA CARTA ──
    cards.forEach((card, i) => {
      card.addEventListener("mouseenter", () => {
        const x = parseFloat(card.dataset.x || "0");
        const y = parseFloat(card.dataset.y || "0");
        const rot = parseFloat(card.dataset.rot || "-20");

        card.style.zIndex = "90";
        gsap.to(card, {
          x: x - 8,
          y: y - 14,
          scale: parseFloat(card.dataset.scale || "1") * 1.06,
          rotation: rot, // Mantiene la inclinación orgánica de esta carta
          duration: 0.3,
          ease: "power2.out",
          overwrite: "auto",
        });
      });

      card.addEventListener("mouseleave", () => {
        const x = parseFloat(card.dataset.x || "0");
        const y = parseFloat(card.dataset.y || "0");
        const rot = parseFloat(card.dataset.rot || "-20");
        const origZ = card.dataset.z || String(i);

        gsap.to(card, {
          x,
          y,
          scale: parseFloat(card.dataset.scale || "1"),
          rotation: rot,
          duration: 0.25,
          ease: "power2.inOut",
          overwrite: "auto",
          onComplete: () => {
            card.style.zIndex = origZ;
          },
        });
      });
    });

    // ── SCROLLTRIGGER: ACOMPAÑAMIENTO FLUIDO AL SCROLL ──
    if (section) {
      const st = ScrollTrigger.create({
        trigger: section,
        start: "top bottom",
        end: "bottom top",
        scrub: 1.2,
        onUpdate: (self) => {
          const p = self.progress;
          gsap.set(track, {
            x: (p - 0.5) * -70,
            y: (p - 0.5) * -90,
            force3D: true,
          });
        },
      });

      document.addEventListener(
        "astro:before-swap",
        () => {
          st.kill();
        },
        { once: true }
      );
    }
  }

  document.addEventListener("astro:page-load", initTobogan);
  if (document.readyState !== "loading") initTobogan();
  else document.addEventListener("DOMContentLoaded", initTobogan);
</script>
