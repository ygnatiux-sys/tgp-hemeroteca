---
/**
 * src/components/AfricaSeriesNarrative.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * SERIE DESTACADA: 'MISTERIOS DEL ÁFRICA'
 *
 * 1. Intro Monumental: Título masivo en Rojo Diquís (#FF4D55 -> #E50914) con
 *    estética dramática, que da paso de inmediato a la secuencia de investigación.
 * 2. Capítulo I: "La Cicatriz del Agua" (Erosión pluvial en el recinto de la Esfinge de Giza).
 * 3. Arquitectura extensible para incorporar los próximos episodios del continente africano.
 */
import imgEsfinge from "../assets/alternativa/esfinge-erosion.jpg";
import imgOsireion from "../assets/alternativa/osireion.jpg";

interface Props {
  className?: string;
  autoplayDuration?: number;
}

const { className = "", autoplayDuration = 6500 } = Astro.props;

// 14 estratos verticales para la cascada pluvial de Giza
const sliceCount = 14;
const slices = Array.from({ length: sliceCount }, (_, i) => {
  const start = (i / sliceCount) * 100;
  const end = ((i + 1) / sliceCount) * 100 + 0.15;
  return {
    index: i,
    clip: `polygon(${start}% 0%, ${end}% 0%, ${end}% 100%, ${start}% 100%)`,
  };
});
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://api.fontshare.com" />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cinzel:wght@800;900&family=Fraunces:opsz,wght,SOFT,WONK@9..144,900,0,1&display=swap"
/>
<link
  href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@800,900&display=swap"
  rel="stylesheet"
/>

<section
  id="africa-series-container"
  class={`relative w-full h-[380vh] bg-[#141210] text-white select-none ${className}`}
  data-autoplay={autoplayDuration}
  aria-label="Serie Destacada: Misterios del África"
>
  <!-- Contenedor Sticky a Pantalla Completa (Full Bleed) -->
  <div class="sticky top-0 h-screen w-full overflow-hidden bg-[#141210]">

    <!-- ══════════════════════════════════════════════════════════════════════
         INTRO MONUMENTAL: 'MISTERIOS DEL ÁFRICA' — AMBIENT GLOW Y RITMO DE PERCUSIÓN
    ══════════════════════════════════════════════════════════════════════ -->
    <div
      class="afr-intro-overlay absolute inset-0 z-25 flex items-center justify-center overflow-hidden bg-[#060404]"
    >
      <!-- Ambient Glow: resplandores esféricos difuminados de rojo cinabrio mineral hacia black -->
      <div class="afr-glow-orb-1 absolute -top-[18%] -left-[10%] w-[78vw] h-[78vw] max-w-225 max-h-225 rounded-full bg-[radial-gradient(circle_at_center,rgba(196,30,58,0.42)_0%,rgba(155,17,30,0.22)_35%,rgba(90,10,18,0.08)_60%,transparent_75%)] blur-3xl pointer-events-none will-change-transform"></div>
      <div class="afr-glow-orb-2 absolute -bottom-[22%] -right-[12%] w-[68vw] h-[68vw] max-w-175 max-h-175 rounded-full bg-[radial-gradient(circle_at_center,rgba(229,9,20,0.32)_0%,rgba(139,0,0,0.14)_40%,transparent_70%)] blur-3xl pointer-events-none will-change-transform"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_30%,rgba(6,4,4,0.7)_70%,#060404_100%)] pointer-events-none"></div>

      <!-- Grano analógico y partículas de ceniza/cinabrio -->
      <div class="afr-grain absolute inset-0 opacity-22 pointer-events-none mix-blend-overlay"></div>
      <div class="afr-cinabrio-particles absolute inset-0 pointer-events-none z-10" aria-hidden="true"></div>

      <!-- Anillo / Onda expansiva de impacto percusivo (Shockwave) -->
      <div class="afr-drum-shockwave absolute w-28 h-28 rounded-full border-2 border-[#ff3b30] pointer-events-none opacity-0 scale-50 z-15 shadow-[0_0_60px_#c41e3a]"></div>
      <div class="afr-drum-shockwave-2 absolute w-28 h-28 rounded-full border border-[#ff6b6b] pointer-events-none opacity-0 scale-50 z-15"></div>

      <!-- Escenario Tipográfico Minimalista de la Colección -->
      <div class="afr-drum-stage relative z-20 flex flex-col items-center justify-center text-center max-w-6xl w-full px-4 select-none">
        
        <!-- Nombre de la Colección: H1 ÁFRICA + H2 MISTERIOS Destacado -->
        <div class="afr-percussion-box relative flex flex-col items-center justify-center">
          <!-- H1 Monumental -->
          <h1 class="afr-beat-africa font-serif font-black uppercase text-[clamp(4.8rem,18.5vw,18rem)] leading-[0.84] tracking-[-0.035em] whitespace-nowrap text-transparent opacity-0 will-change-transform">
            ÁFRICA
          </h1>

          <!-- H2 Destacado de la Colección -->
          <div class="afr-collection-wrap relative inline-block mt-3 overflow-visible">
            <h2 class="afr-collection-h2 font-mono font-bold uppercase text-[clamp(1.4rem,4.8vw,3.8rem)] tracking-[0.42em] text-[#ff4d55] drop-shadow-[0_0_35px_rgba(255,77,85,0.55)] m-0 opacity-0 will-change-transform">
              MISTERIOS
            </h2>
          </div>
        </div>

        <!-- Tagline Canónico -->
        <p class="afr-intro-sub mt-6 font-mono text-[10px] sm:text-[12px] tracking-[0.35em] uppercase text-stone-300 opacity-0">
          La geología sagrada del Nilo · El tiempo antes de los faraones
        </p>

      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════
         CAPÍTULO I: LA CICATRIZ DEL AGUA (GIZA, EGIPTO) — EROSIÓN PLUVIAL
    ══════════════════════════════════════════════════════════════════════ -->
    <div
      class="afr-layer absolute inset-0 w-full h-full opacity-100 pointer-events-auto"
      data-layer-index="0"
    >
      <div class="afr-bg-wrap absolute inset-0 overflow-hidden">
        <img
          src={imgEsfinge.src}
          alt="Recinto de la Esfinge de Giza con fisuras verticales de erosión pluvial"
          class="afr-img absolute inset-0 w-full h-full object-cover object-[18%_30%] filter brightness-105 contrast-105 will-change-transform"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Scrim sutil ceñido al pie y resplandor solar rasante (máxima nitidez fotográfica) -->
      <div class="absolute inset-x-0 bottom-0 h-32 sm:h-40 md:h-48 bg-linear-to-t from-[#141210]/90 via-[#141210]/35 to-transparent pointer-events-none"></div>
      <div class="absolute inset-0 pointer-events-none mix-blend-screen bg-[radial-gradient(circle_at_18%_28%,rgba(240,220,184,0.22)_0%,rgba(212,184,134,0.1)_28%,transparent_60%)]"></div>
      <div class="afr-grain absolute inset-0 pointer-events-none"></div>
      <div class="afr-dust absolute inset-0 pointer-events-none z-10" aria-hidden="true"></div>

      <!-- Escenario Tipográfico Pluvial Minimalista -->
      <div class="absolute inset-0 flex items-center justify-center z-20 pointer-events-none px-4">
        <div class="afr-pluvial-chamber relative flex flex-col items-center text-center max-w-7xl">
          <div class="afr-cascade-wrap relative inline-block">
            <h2 class="afr-master font-serif font-black uppercase whitespace-nowrap text-[clamp(1.8rem,5.5vw,5.5rem)] leading-[0.92] tracking-[0.03em] text-transparent opacity-0 select-none">
              La Cicatriz del Agua
            </h2>

            <div class="afr-slices-box absolute inset-0 pointer-events-none" aria-hidden="true">
              {
                slices.map((slice) => (
                  <span
                    class="afr-slice absolute inset-0 font-serif font-black uppercase whitespace-nowrap text-[clamp(1.8rem,5.5vw,5.5rem)] leading-[0.92] tracking-[0.03em] text-transparent will-change-transform"
                    style={`clip-path: ${slice.clip};`}
                  >
                    La Cicatriz del Agua
                  </span>
                ))
              }
            </div>
          </div>

          <!-- Tagline Canónico -->
          <p class="afr-sub mt-6 font-serif text-[clamp(0.9rem,1.8vw,1.4rem)] font-medium tracking-[0.25em] uppercase text-[#ead5b3] opacity-0">
            <span class="text-[#d4b886] mr-2">—</span> La geología que reescribe la cronología humana
          </p>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════
         CAPÍTULO II: EL OSIREION (ABIDOS, EGIPTO) — NIVEL FREÁTICO Y BRUTALISMO
    ══════════════════════════════════════════════════════════════════════ -->
    <div
      class="afr-layer-osireion absolute inset-0 w-full h-full opacity-0 pointer-events-none transition-opacity duration-700 bg-[#0a0f0d]"
      data-layer-index="1"
    >
      <div class="afr-osi-bg-wrap absolute inset-0 overflow-hidden">
        <img
          src={imgOsireion.src}
          alt="Pilares de granito del Osireion de Abidos sumergidos en agua subterránea"
          class="afr-osi-img absolute inset-0 w-full h-full object-cover object-[50%_45%] filter brightness-112 contrast-108 saturate-105 will-change-transform"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Scrims perimetrales ligeros (máxima nitidez y brillo fotográfico) -->
      <div class="absolute inset-x-0 top-0 h-28 bg-linear-to-b from-[#0a0f0d]/75 to-transparent pointer-events-none"></div>
      <div class="absolute inset-x-0 bottom-0 h-44 bg-linear-to-t from-[#0a0f0d]/90 via-[#0a0f0d]/35 to-transparent pointer-events-none"></div>
      <div class="absolute inset-0 pointer-events-none mix-blend-screen bg-[radial-gradient(circle_at_50%_45%,rgba(220,187,168,0.12)_0%,transparent_60%)]"></div>

      <!-- Escenario Tipográfico del Osireion Minimalista -->
      <div class="absolute inset-0 flex items-center justify-center z-20 pointer-events-none px-4">
        <div class="afr-osi-chamber relative flex flex-col items-center text-center max-w-6xl w-full">
          <!-- Título Brutalista con descenso por máscara clip-path -->
          <div class="afr-osi-title-wrap relative w-full flex items-center justify-center overflow-hidden py-2">
            <h2
              class="afr-osi-main relative flex items-center justify-center font-black uppercase text-[clamp(2.5rem,8.5vw,9rem)] leading-[0.88] tracking-[-0.01em] select-none"
              style="font-family: 'Cabinet Grotesk', sans-serif;"
            >
              <span class="afr-osi-stone relative inline-block">
                EL OSIREION
              </span>
            </h2>

            <!-- Línea de tensión superficial del agua que desciende -->
            <div class="afr-osi-water-line absolute inset-x-0 h-[1.5px] bg-linear-to-r from-transparent via-[#8b5a45] to-transparent pointer-events-none opacity-0 shadow-[0_0_15px_#8b5a45]"></div>
          </div>

          <!-- Tagline Canónico -->
          <div class="afr-osi-sub-wrap mt-6 flex flex-col items-center">
            <p class="afr-osi-sub font-black text-[clamp(0.95rem,2.2vw,1.6rem)] tracking-[0.24em] uppercase text-[#dcbba8]/90 opacity-0">
              La cronología sumergida de <span class="text-[#8b5a45] font-extrabold underline decoration-[#8b5a45]/50 underline-offset-4">Abidos</span>
            </p>
          </div>
        </div>
      </div>
    </div>



  </div>
</section>

<style>
  /* Tipografía y Gradiente ROJO CINABRIO MINERAL (PERCUSIÓN ÁFRICA) */
  .afr-beat-africa {
    font-family: 'Fraunces', serif;
    font-variation-settings: 'opsz' 9, 'SOFT' 0, 'WONK' 0;
    background: linear-gradient(180deg, #ff8080 0%, #ff2a38 30%, #c41e3a 58%, #800000 85%, #3d0306 100%);
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 25px 60px rgba(0, 0, 0, 0.98)) drop-shadow(0 0 65px rgba(229, 9, 20, 0.65));
  }

  .afr-collection-h2 {
    font-family: 'Space Mono', monospace;
  }

  .afr-cinabrio-particles :global(span) {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  /* Tipografía Ocre Atardecer para Giza */
  .afr-master,
  .afr-slice {
    font-family: 'Cinzel', serif;
    background: linear-gradient(
      180deg,
      #f7ebd6 0%,
      #e8d1a7 30%,
      #d4b886 65%,
      #8e7040 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 18px 45px rgba(0, 0, 0, 0.98)) drop-shadow(0 0 40px rgba(212, 184, 134, 0.32));
  }

  .afr-sub {
    text-shadow: 0 4px 22px rgba(0, 0, 0, 0.95), 0 0 25px rgba(212, 184, 134, 0.35);
  }

  /* Tipografía Granito Pálido y Abismo para Osireion */
  .afr-osi-stone {
    color: #dcbba8;
    background: linear-gradient(
      180deg,
      #f2dfd5 0%,
      #dcbba8 45%,
      #c49f8a 85%,
      #8b5a45 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 20px 45px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 35px rgba(139, 90, 69, 0.25));
  }

  .afr-osi-sub {
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.95), 0 0 25px rgba(139, 90, 69, 0.35);
  }

  /* Grano analógico A24 */
  .afr-grain {
    opacity: 0.18;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    animation: afr-grain-anim 0.8s steps(5) infinite;
  }

  @keyframes afr-grain-anim {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-2%, 1%); }
    50% { transform: translate(1%, -2%); }
    75% { transform: translate(-1%, 2%); }
    100% { transform: translate(0, 0); }
  }

  .afr-dust :global(span) {
    position: absolute;
    border-radius: 50%;
    background: #d4b886;
    pointer-events: none;
  }
</style>

<script>
  import { gsap } from "gsap";

  function setupAfricaSeries() {
    const container = document.getElementById("africa-series-container");
    if (!container || container.dataset.ready === "true") return;
    container.dataset.ready = "true";

    const introOverlay = container.querySelector<HTMLElement>(".afr-intro-overlay");
    const beatAfrica = container.querySelector<HTMLElement>(".afr-beat-africa");
    const collectionH2 = container.querySelector<HTMLElement>(".afr-collection-h2");
    const introSub = container.querySelector<HTMLElement>(".afr-intro-sub");
    const shockwave = container.querySelector<HTMLElement>(".afr-drum-shockwave");
    const shockwave2 = container.querySelector<HTMLElement>(".afr-drum-shockwave-2");
    const cinabrioParticles = container.querySelector<HTMLElement>(".afr-cinabrio-particles");
    const orb1 = container.querySelector<HTMLElement>(".afr-glow-orb-1");
    const orb2 = container.querySelector<HTMLElement>(".afr-glow-orb-2");
    const percussionBox = container.querySelector<HTMLElement>(".afr-percussion-box");

    // Capa I: Giza
    const layer0 = container.querySelector<HTMLElement>('.afr-layer[data-layer-index="0"]');
    const cascadeWrap = container.querySelector<HTMLElement>(".afr-cascade-wrap");
    const slices = container.querySelectorAll<HTMLElement>(".afr-slice");
    const sub0 = container.querySelector<HTMLElement>(".afr-sub");
    const dustLayer = container.querySelector<HTMLElement>(".afr-dust");

    // Capa II: El Osireion
    const layer1 = container.querySelector<HTMLElement>('.afr-layer-osireion[data-layer-index="1"]');
    const titleMain1 = container.querySelector<HTMLElement>(".afr-osi-main");
    const waterLine1 = container.querySelector<HTMLElement>(".afr-osi-water-line");
    const sub1 = container.querySelector<HTMLElement>(".afr-osi-sub");
    const img1 = container.querySelector<HTMLElement>(".afr-osi-img");

    if (!introOverlay || !beatAfrica || !layer0 || !layer1) return;

    // Generador de partículas de ceniza y pigmento cinabrio para los golpes de percusión
    const spawnCinabrioDust = (intensity: number = 24) => {
      if (!cinabrioParticles) return;
      for (let i = 0; i < intensity; i++) {
        const p = document.createElement("span");
        const s = 1.6 + Math.random() * 3.4;
        p.style.width = `${s}px`;
        p.style.height = `${s}px`;
        p.style.left = `${20 + Math.random() * 60}%`;
        p.style.top = `${25 + Math.random() * 50}%`;
        p.style.background = Math.random() > 0.4 ? "#ff3b30" : (Math.random() > 0.5 ? "#c41e3a" : "#ffd166");
        p.style.boxShadow = "0 0 12px rgba(255, 59, 48, 0.85)";
        p.style.opacity = "0";
        cinabrioParticles.appendChild(p);

        gsap.fromTo(
          p,
          { opacity: 0, scale: 0.3 },
          {
            opacity: 0.4 + Math.random() * 0.6,
            x: (Math.random() - 0.5) * 160,
            y: (Math.random() - 0.5) * 130 - 25,
            scale: 1.4,
            duration: 1.3 + Math.random() * 1.1,
            ease: "power2.out",
            onComplete: () => {
              gsap.to(p, { opacity: 0, duration: 0.5, onComplete: () => p.remove() });
            }
          }
        );
      }
    };

    let tl0: gsap.core.Timeline | null = null;
    let tl1: gsap.core.Timeline | null = null;
    let currentChapter = 0;
    let autoplayTimer: ReturnType<typeof setTimeout> | null = null;
    const autoplayDuration = parseInt(container.dataset.autoplay || "6500", 10);
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const stopAutoplay = () => {
      if (autoplayTimer) {
        clearTimeout(autoplayTimer);
        autoplayTimer = null;
      }
    };

    const scheduleNextChapter = () => {
      stopAutoplay();
      if (reduceMotion) return;
      autoplayTimer = setTimeout(() => {
        const nextChapter = (currentChapter + 1) % 3;
        if (nextChapter === 0) {
          startSeriesFlow();
        } else if (nextChapter === 1) {
          playGiza();
        } else {
          playOsireion();
        }
      }, autoplayDuration);
    };

    // Generar partículas de caliza para Giza
    const spawnLimestoneDust = () => {
      if (!dustLayer || !cascadeWrap) return;
      dustLayer.innerHTML = "";
      const count = 28;
      const rect = cascadeWrap.getBoundingClientRect();
      const contRect = container.getBoundingClientRect();
      const originX = rect.left - contRect.left;
      const originY = rect.top - contRect.top + rect.height * 0.5;

      for (let i = 0; i < count; i++) {
        const dot = document.createElement("span");
        const s = 1.2 + Math.random() * 2.8;
        dot.style.width = `${s}px`;
        dot.style.height = `${s}px`;
        dot.style.left = `${originX + Math.random() * rect.width}px`;
        dot.style.top = `${originY}px`;
        dot.style.opacity = "0";
        dustLayer.appendChild(dot);

        gsap.fromTo(
          dot,
          { opacity: 0, y: 0, scale: 0.6 },
          {
            opacity: 0.35 + Math.random() * 0.55,
            y: (Math.random() - 0.5) * 80 + 30,
            x: (Math.random() - 0.5) * 70,
            scale: 1.4,
            duration: 1.8 + Math.random() * 1.5,
            ease: "power2.out",
            onComplete: () => {
              gsap.to(dot, { opacity: 0, duration: 0.8, onComplete: () => dot.remove() });
            },
          }
        );
      }
    };



    // Reset Giza
    const resetGiza = () => {
      tl0?.kill();
      tl0 = null;
      if (dustLayer) dustLayer.innerHTML = "";
      if (sub0) gsap.set(sub0, { opacity: 0, y: 35, filter: "blur(14px)" });
      if (cascadeWrap) gsap.set(cascadeWrap, { y: 0, filter: "none" });
      slices.forEach((slice) => {
        gsap.set(slice, { yPercent: -140, opacity: 0, scaleY: 1.25 });
      });
    };

    // Reset Osireion
    const resetOsireion = () => {
      tl1?.kill();
      tl1 = null;
      if (titleMain1) {
        gsap.set(titleMain1, { clipPath: "polygon(0% 0%, 100% 0%, 100% 0%, 0% 0%)", opacity: 1 });
      }
      if (waterLine1) gsap.set(waterLine1, { top: "0%", opacity: 0 });
      if (sub1) gsap.set(sub1, { opacity: 0, y: 35, filter: "blur(10px)" });
      if (img1) gsap.set(img1, { scale: 1.05 });
    };

    // Reproducir Capítulo I: Giza
    const playGiza = () => {
      resetGiza();
      currentChapter = 1;

      gsap.to(introOverlay, { opacity: 0, duration: 0.6, pointerEvents: "none" });
      gsap.to(layer0, { opacity: 1, duration: 0.6, pointerEvents: "auto" });
      gsap.to(layer1, { opacity: 0, duration: 0.6, pointerEvents: "none" });

      if (reduceMotion) {
        if (sub0) gsap.set(sub0, { opacity: 1, y: 0, filter: "none" });
        slices.forEach((s) => gsap.set(s, { yPercent: 0, opacity: 1, scaleY: 1 }));
        scheduleNextChapter();
        return;
      }

      const mainTl = gsap.timeline({
        onComplete: () => {
          scheduleNextChapter();
        },
      });
      tl0 = mainTl;

      mainTl.addLabel("flood", 0.2);

      slices.forEach((slice, idx) => {
        const randomDelay = (idx % 3) * 0.08 + Math.sin(idx * 0.8) * 0.12 + 0.1;
        const duration = 1.1 + (idx % 4) * 0.08;
        mainTl.to(
          slice,
          { yPercent: 0, opacity: 1, scaleY: 1, duration: duration, ease: "power4.in" },
          `flood+=${randomDelay}`
        );
      });

      mainTl.addLabel("impact", "flood+=1.35");
      mainTl.add(() => spawnLimestoneDust(), "impact");

      if (cascadeWrap) {
        mainTl.fromTo(
          cascadeWrap,
          { y: -3, filter: "blur(3.5px)" },
          { y: 3, filter: "blur(1.5px)", duration: 0.05, repeat: 5, yoyo: true, ease: "none" },
          "impact"
        ).to(cascadeWrap, { y: 0, filter: "blur(0px)", duration: 0.4, ease: "power2.out" });
      }

      if (sub0) mainTl.to(sub0, { opacity: 1, y: 0, filter: "blur(0px)", duration: 1.6, ease: "power3.out" }, "impact+=0.4");
    };

    // Reproducir Capítulo II: El Osireion (Nivel Freático)
    const playOsireion = () => {
      resetOsireion();
      currentChapter = 2;

      gsap.to(introOverlay, { opacity: 0, duration: 0.6, pointerEvents: "none" });
      gsap.to(layer1, { opacity: 1, duration: 0.7, pointerEvents: "auto" });
      gsap.to(layer0, { opacity: 0, duration: 0.7, pointerEvents: "none" });

      if (reduceMotion) {
        if (titleMain1) gsap.set(titleMain1, { clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)" });
        if (sub1) gsap.set(sub1, { opacity: 1, y: 0, filter: "none" });
        scheduleNextChapter();
        return;
      }

      const osiTl = gsap.timeline({
        defaults: { ease: "power3.out" },
        onComplete: () => {
          scheduleNextChapter();
        },
      });
      tl1 = osiTl;

      if (img1) osiTl.to(img1, { scale: 1.0, duration: 4.0, ease: "power1.out" }, 0);
      if (waterLine1) osiTl.to(waterLine1, { opacity: 0.85, duration: 0.3 }, 0.3);

      // Descenso del agua por clip-path
      if (waterLine1) {
        osiTl.to(waterLine1, { top: "100%", duration: 2.2, ease: "power2.inOut" }, 0.4);
      }
      if (titleMain1) {
        osiTl.to(
          titleMain1,
          {
            clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
            duration: 2.2,
            ease: "power2.inOut",
            onComplete: () => {
              if (waterLine1) gsap.to(waterLine1, { opacity: 0, duration: 0.4 });
            },
          },
          0.4
        );
      }

      // Ecos en la caverna: Tagline canónico
      if (sub1) {
        osiTl.fromTo(
          sub1,
          { opacity: 0, y: 35, filter: "blur(10px)" },
          { opacity: 1, y: 0, filter: "blur(0px)", duration: 1.6, ease: "power3.out" },
          1.4
        );
      }
    };

    // Secuencia inicial con la apertura monumental de África (H1 ÁFRICA + H2 MISTERIOS Destacado)
    const startSeriesFlow = () => {
      resetGiza();
      resetOsireion();
      stopAutoplay();
      currentChapter = 0;

      if (cinabrioParticles) cinabrioParticles.innerHTML = "";
      gsap.to(layer0, { opacity: 0, duration: 0.4, pointerEvents: "none" });
      gsap.to(layer1, { opacity: 0, duration: 0.4, pointerEvents: "none" });
      gsap.set(introOverlay, { opacity: 1, pointerEvents: "auto" });
      gsap.set([beatAfrica, collectionH2], { opacity: 0 });
      gsap.set(introSub, { opacity: 0, y: 18 });
      if (shockwave) gsap.set(shockwave, { scale: 0.2, opacity: 0 });
      if (shockwave2) gsap.set(shockwave2, { scale: 0.3, opacity: 0 });

      if (reduceMotion) {
        gsap.set(introOverlay, { opacity: 0, pointerEvents: "none" });
        playGiza();
        return;
      }

      const introTl = gsap.timeline();

      // Respiración previa del resplandor cinabrio
      introTl.fromTo(
        [orb1, orb2],
        { scale: 0.9, opacity: 0.6 },
        { scale: 1.05, opacity: 1, duration: 0.8, ease: "power1.inOut" }
      );

      // CLÍMAX MONUMENTAL: "ÁFRICA" (H1)
      introTl.addLabel("beatAfrica");
      introTl.add(() => spawnCinabrioDust(45), "beatAfrica");

      if (beatAfrica) {
        introTl.fromTo(
          beatAfrica,
          { opacity: 0, scale: 2.2, filter: "blur(20px)" },
          { opacity: 1, scale: 1, filter: "blur(0px)", duration: 0.68, ease: "power4.out" },
          "beatAfrica"
        );
      }

      if (shockwave) {
        introTl.fromTo(
          shockwave,
          { scale: 0.2, opacity: 1 },
          { scale: 7.5, opacity: 0, duration: 0.95, ease: "power2.out" },
          "beatAfrica"
        );
      }
      if (shockwave2) {
        introTl.fromTo(
          shockwave2,
          { scale: 0.3, opacity: 0.9 },
          { scale: 9.5, opacity: 0, duration: 1.15, ease: "power2.out" },
          "beatAfrica+=0.06"
        );
      }

      if (percussionBox) {
        introTl.fromTo(
          percussionBox,
          { x: -5, y: 4 },
          { x: 4, y: -3, duration: 0.04, repeat: 5, yoyo: true, ease: "none" },
          "beatAfrica"
        ).to(percussionBox, { x: 0, y: 0, duration: 0.15 });
      }

      introTl.to([orb1, orb2], { scale: 1.18, duration: 0.35, yoyo: true, repeat: 1, ease: "power2.out" }, "beatAfrica");

      // REVELACIÓN DEL H2 DESTACADO: "MISTERIOS"
      introTl.addLabel("beatMisterios", "beatAfrica+=0.3");
      introTl.add(() => spawnCinabrioDust(18), "beatMisterios");

      if (collectionH2) {
        introTl.fromTo(
          collectionH2,
          { opacity: 0, scale: 1.4, y: 15, filter: "blur(10px)" },
          { opacity: 1, scale: 1, y: 0, filter: "blur(0px)", duration: 0.5, ease: "power3.out" },
          "beatMisterios"
        );
      }

      // Tagline canónico
      if (introSub) {
        introTl.to(introSub, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" }, "beatMisterios+=0.25");
      }

      // Micro-reverberación
      if (beatAfrica) {
        introTl.to(beatAfrica, { scale: 1.02, duration: 0.6, yoyo: true, repeat: 1, ease: "sine.inOut" }, "beatMisterios+=0.5");
      }

      // Pausa de contemplación antes de pasar al primer post
      introTl.to({}, { duration: 2.2 });

      // Transición fluida hacia Capítulo I (Giza)
      introTl.to(
        [percussionBox, introSub],
        { opacity: 0, scale: 0.96, duration: 0.75, ease: "power3.in" }
      );
      introTl.to(
        introOverlay,
        {
          opacity: 0,
          duration: 0.85,
          ease: "power2.inOut",
          onComplete: () => {
            introOverlay.style.pointerEvents = "none";
            playGiza();
          },
        },
        "-=0.25"
      );
    };

    // Control por Scroll
    let scrollTicking = false;
    const handleScroll = () => {
      if (scrollTicking) return;
      scrollTicking = true;
      requestAnimationFrame(() => {
        const rect = container.getBoundingClientRect();
        const winH = window.innerHeight;
        const totalScrollable = rect.height - winH;
        if (totalScrollable > 0) {
          const currentScroll = -rect.top;
          const progress = Math.max(0, Math.min(1, currentScroll / totalScrollable));

          if (progress < 0.33 && currentChapter !== 0) {
            stopAutoplay();
            startSeriesFlow();
          } else if (progress >= 0.33 && progress < 0.68 && currentChapter !== 1) {
            stopAutoplay();
            playGiza();
          } else if (progress >= 0.68 && currentChapter !== 2) {
            stopAutoplay();
            playOsireion();
          }
        }
        scrollTicking = false;
      });
    };

    window.addEventListener("scroll", handleScroll, { passive: true });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            startSeriesFlow();
          } else {
            stopAutoplay();
            resetGiza();
            resetOsireion();
          }
        });
      },
      { threshold: 0.12 }
    );
    observer.observe(container);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupAfricaSeries);
  } else {
    setupAfricaSeries();
  }
  document.addEventListener("astro:page-load", setupAfricaSeries);
</script>
