---
interface Props {
  fallbackUrl?: string;
}
const { fallbackUrl = "/" } = Astro.props;
---

<button
  id="back-slide-btn"
  type="button"
  class="back-slide-btn"
  title="Volver"
  aria-label="Volver"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="back-icon"><path d="m15 18-6-6 6-6"/></svg>
</button>

<script define:vars={{ fallbackUrl }}>
  const initBackSlide = () => {
    const btn = document.getElementById('back-slide-btn');
    if (!btn) return;

    const showBtn = () => {
      btn.classList.add('is-visible');
    };

    // Activación inmediata en carga
    showBtn();

    // Activar en cualquier interacción
    window.addEventListener('mousemove', (e) => {
      if (e.clientX < 120) {
        showBtn();
      }
    }, { passive: true });

    window.addEventListener('scroll', showBtn, { passive: true });

    // Navegación de salida inteligente
    btn.onclick = () => {
      const hasHistory = window.history.length > 1 && document.referrer.includes(window.location.host);
      if (hasHistory) {
        window.history.back();
      } else {
        window.location.href = fallbackUrl;
      }
    };
  };

  document.addEventListener('astro:page-load', initBackSlide);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initBackSlide();
  } else {
    document.addEventListener('DOMContentLoaded', initBackSlide);
  }
</script>

<style>
  .back-slide-btn {
    position: fixed;
    left: 10px;
    top: 50%;
    transform: translateY(-50%) scale(0.88);
    z-index: 100;
    background: rgba(26, 28, 29, 0.55);
    color: #D8D9D7; /* Color default ahumado */
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    width: 24px;
    height: 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(4px);
  }

  /* Reposo: aparece diminuto con opacidad default discreta */
  .back-slide-btn.is-visible {
    opacity: 0.22;
    pointer-events: auto;
    transform: translateY(-50%) scale(1);
  }

  .back-icon {
    transition: transform 0.25s ease;
  }

  /* Hover: foco y nitidez */
  .back-slide-btn:hover {
    opacity: 1 !important;
    background-color: #1A1C1D;
    border-color: rgba(239, 235, 227, 0.3);
    color: #EFEBE3;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
  }

  .back-slide-btn:hover .back-icon {
    transform: translateX(-1.5px);
  }
</style>
