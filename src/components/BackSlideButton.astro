---
interface Props {
  fallbackUrl?: string;
}
const { fallbackUrl = "/" } = Astro.props;
---

<button
  id="back-slide-btn"
  type="button"
  class="back-slide-btn"
  title="Volver"
  aria-label="Volver"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="back-icon"><path d="m15 18-6-6 6-6"/></svg>
</button>

<script define:vars={{ fallbackUrl }}>
  const initBackSlide = () => {
    const btn = document.getElementById('back-slide-btn');
    if (!btn) return;

    // Ya no dependemos del mousemove para visibilidad básica,
    // pero podemos dejarlo visible siempre.
    btn.classList.add('is-visible');

    // Navegación de salida inteligente
    btn.onclick = () => {
      const hasHistory = window.history.length > 1 && document.referrer.includes(window.location.host);
      if (hasHistory) {
        window.history.back();
      } else {
        window.location.href = fallbackUrl;
      }
    };
  };

  document.addEventListener('astro:page-load', initBackSlide);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initBackSlide();
  } else {
    document.addEventListener('DOMContentLoaded', initBackSlide);
  }
</script>

<style>
  .back-slide-btn {
    position: fixed;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 100;
    /* Estilos copiados exactamente del slider CinematicPostEngine */
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.2);
    color: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
  }

  @media (min-width: 768px) {
    .back-slide-btn {
      left: 24px;
      width: 48px;
      height: 48px;
    }
  }

  .back-slide-btn.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .back-icon {
    transition: transform 0.25s ease;
  }

  .back-slide-btn:hover {
    background-color: rgba(0, 0, 0, 0.5);
    color: rgba(255, 255, 255, 1);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .back-slide-btn:hover .back-icon {
    transform: translateX(-1.5px);
  }
</style>
