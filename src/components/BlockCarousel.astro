---
/**
 * BlockCarousel.astro
 * Carrusel por bloques rígidos de 3 tarjetas — MUBI style.
 * Mecánica: Stagger Fade Out → Stagger Fade In con GSAP.
 * Probado con datos hardcoded internamente.
 *
 * Props:
 *   cards — array de { title, label, image, href }
 */

interface Card {
  title: string;
  label?: string;
  image: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  cards: Card[];
  cardsPerPage?: number;    // Default: 3
  autoplay?: number;        // Segundos. 0 = sin autoplay. Default: 7
  height?: string;          // CSS height del stage. Default: "65vh"
}

const {
  eyebrow  = "Colecciones",
  heading  = "Colecciones",
  cards    = [],
  cardsPerPage = 3,
  autoplay = 7,
  height   = "65vh",
} = Astro.props;

// Partir el array en páginas de N cards
const pages: Card[][] = [];
for (let i = 0; i < cards.length; i += cardsPerPage) {
  pages.push(cards.slice(i, i + cardsPerPage));
}
const totalPages = pages.length;
const uid = "bc-" + Math.random().toString(36).slice(2, 8);
---

{cards.length > 0 && (
<section
  id={uid}
  class="bc-root"
  data-autoplay={autoplay}
  data-total={totalPages}
>

  <!-- ── HEADER ── -->
  <div class="bc-header">
    <div>
      {eyebrow && <span class="bc-eyebrow">{eyebrow}</span>}
      <h2 class="bc-heading">{heading}</h2>
    </div>
  </div>

  <!-- ── STAGE WRAPPER CON CHEVRONS NATIVOS SLIDER NETFLIX ── -->
  <div class="relative w-full group/stage">
    {totalPages > 1 && (
      <>
        <!-- Botón Anterior Flotante en Cápsula (Nativo Netflix) -->
        <button 
          class="bc-prev absolute left-0 md:left-2 top-1/2 -translate-y-1/2 z-40 w-9 md:w-10 h-16 md:h-20 rounded-full bg-black/40 hover:bg-black/85 text-[#E3DDD3]/40 hover:text-[#EFEBE3] border border-[#E3DDD3]/10 hover:border-[#E3DDD3]/30 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-70 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none"
          type="button"
          aria-label="Anterior"
        >
          <svg class="w-5 h-5 -translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>

        <!-- Botón Siguiente Flotante en Cápsula (Nativo Netflix) -->
        <button 
          class="bc-next absolute right-0 md:right-2 top-1/2 -translate-y-1/2 z-40 w-9 md:w-10 h-16 md:h-20 rounded-full bg-black/40 hover:bg-black/85 text-[#E3DDD3]/40 hover:text-[#EFEBE3] border border-[#E3DDD3]/10 hover:border-[#E3DDD3]/30 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-70 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none"
          type="button"
          aria-label="Siguiente"
        >
          <svg class="w-5 h-5 translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>
      </>
    )}

    <!-- ── STAGE ── -->
    <div class="bc-stage" style={`--bc-h:${height}`}>
      {pages.map((page, pi) => (
        <div class={`bc-page ${pi === 0 ? "bc-active" : ""}`} data-page={pi} aria-hidden={pi !== 0 ? "true" : "false"}>
          {page.map((card) => (
            <a href={card.href} class="bc-card">
              <img src={card.image} alt={card.title} loading="lazy" decoding="async" />
              <div class="bc-scrim"></div>
              <div class="bc-info">
                {card.label && <span class="bc-label">{card.label}</span>}
                <p class="bc-title">{card.title}</p>
              </div>
            </a>
          ))}
        </div>
      ))}
    </div>
  </div>

</section>
)}

<style>
/* ── ROOT ── */
.bc-root {
  position: relative;
  width: 100%;
  overflow: hidden;
}

/* ── HEADER ── */
.bc-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem;
  padding-bottom: 1.25rem;
}
.bc-eyebrow {
  display: block;
  font-size: 0.625rem;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  margin-bottom: 0.25rem;
  /* color hereda del proyecto */
  color: var(--color-rust-orange, #e07a5f);
  font-family: var(--font-metadata, sans-serif);
}
.bc-heading {
  font-size: clamp(1.5rem, 3vw, 3rem);
  font-weight: 900;
  letter-spacing: -0.02em;
  background-image: linear-gradient(180deg, #CBD5E1 0%, #334155 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin: 0;
  font-family: var(--font-cinzel, serif);
}

/* ── STAGE — contenedor de altura fija ── */
.bc-stage {
  position: relative;
  width: 100%;
  height: var(--bc-h, 65vh);
  min-height: 400px;
  max-height: 720px;
}

/* ── PÁGINAS — apiladas sobre sí, una visible a la vez ── */
.bc-page {
  position: absolute;
  inset: 0;
  display: flex;
  gap: 0.875rem;
  /* oculto por defecto */
  visibility: hidden;
  pointer-events: none;
}
.bc-page.bc-active {
  visibility: visible;
  pointer-events: auto;
}

/* ── TARJETA ── */
.bc-card {
  flex: 1 1 0;
  min-width: 0;
  position: relative;
  overflow: hidden;
  display: block;
  border-radius: 1rem;
  border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.65);
  text-decoration: none;
  /* estado inicial siempre visible — GSAP lo anima */
  opacity: 1;
  transition: border-color 0.4s ease, box-shadow 0.4s ease;
}
.bc-card:hover {
  border-color: rgba(224, 122, 95, 0.45);
  box-shadow: 0 20px 45px rgba(0, 0, 0, 0.8), 0 0 20px rgba(224, 122, 95, 0.15);
}
.bc-card img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  pointer-events: none;
  transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.bc-card:hover img { transform: scale(1.025); }

/* ── SCRIM ── */
.bc-scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top,
    rgba(0,0,0,0.92) 0%,
    rgba(0,0,0,0.55) 30%,
    transparent 60%
  );
  pointer-events: none;
}

/* ── INFO ── */
.bc-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1.5rem 1.5rem 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  z-index: 2;
}
.bc-label {
  font-family: var(--font-metadata, sans-serif);
  font-size: 0.65rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--color-rust-orange, #e07a5f);
  line-height: 1;
  display: block;
}
.bc-title {
  font-family: var(--font-alegreya, serif);
  font-size: clamp(1rem, 1.5vw, 1.5rem);
  font-weight: 800;
  line-height: 1.2;
  color: #fff;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  /* gradient title si el proyecto tiene esta utilidad */
  background-image: linear-gradient(180deg, #e8e0d8 0%, #a89e92 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
  .bc-stage {
    height: clamp(380px, 60vh, 560px);
  }
  /* En móvil solo 1 card */
  .bc-page { gap: 0; }
  .bc-card:not(:first-child) { display: none; }
}
</style>

<script>
import gsap from "gsap";

function init() {
  document.querySelectorAll<HTMLElement>(".bc-root").forEach((root) => {
    if (root.dataset.ready === "1") return;
    root.dataset.ready = "1";

    const autoplaySecs = parseFloat(root.dataset.autoplay || "7");
    const totalPages   = parseInt(root.dataset.total   || "1", 10);

    if (totalPages < 2) return;

    const pages   = Array.from(root.querySelectorAll<HTMLElement>(".bc-page"));
    const btnPrev = root.querySelector<HTMLButtonElement>(".bc-prev");
    const btnNext = root.querySelector<HTMLButtonElement>(".bc-next");
    const curEl   = root.querySelector<HTMLElement>(".bc-cur");

    let cur          = 0;
    let busy         = false;
    let hovered      = false;
    let timer: gsap.core.Tween | null = null;

    /* ── Programar próximo autoplay ── */
    function schedule() {
      timer?.kill();
      if (autoplaySecs <= 0) return;
      timer = gsap.delayedCall(autoplaySecs, () => go(1));
      if (hovered) timer.pause();
    }

    /* ── Transición principal ── */
    function go(delta: number) {
      if (busy) return;
      const next = (cur + delta + totalPages) % totalPages;
      if (next === cur) return;

      busy = true;

      const pageOut  = pages[cur];
      const pageIn   = pages[next];
      const cardsOut = Array.from(pageOut.querySelectorAll<HTMLElement>(".bc-card"));
      const cardsIn  = Array.from(pageIn.querySelectorAll<HTMLElement>(".bc-card"));

      /* Preparar el bloque entrante: activo pero cards en opacity 0 con y: 20 */
      pageIn.classList.add("bc-active");
      pageIn.setAttribute("aria-hidden", "false");
      gsap.set(cardsIn, { opacity: 0, y: 20 });

      /* Actualizar paginación */
      if (curEl) curEl.textContent = String(next + 1).padStart(2, "0");

      const tl = gsap.timeline({
        onComplete() {
          /* Limpiar bloque saliente y resetear sus cards para el loop */
          pageOut.classList.remove("bc-active");
          pageOut.setAttribute("aria-hidden", "true");
          gsap.set(cardsOut, { clearProps: "all" });

          cur  = next;
          busy = false;
          schedule();
        }
      });

      /* 1 — STAGGER FADE OUT del bloque saliente (desplazamiento -20px y curva suave) */
      tl.to(cardsOut, {
        opacity: 0,
        y: -20,
        duration: 0.55,
        stagger: 0.1,
        ease: "power2.inOut",
      });

      /* 2 — STAGGER FADE IN del bloque entrante (inercia cinemática power3.out) */
      tl.to(cardsIn, {
        opacity: 1,
        y: 0,
        duration: 0.65,
        stagger: 0.1,
        ease: "power3.out",
      });
    }

    /* ── Hover: pausa y reanuda el timer ── */
    root.addEventListener("mouseenter", () => {
      hovered = true;
      timer?.pause();
    });
    root.addEventListener("mouseleave", () => {
      hovered = false;
      if (!busy) timer?.resume();
    });

    /* ── Botones manuales ── */
    btnPrev?.addEventListener("click", () => go(-1));
    btnNext?.addEventListener("click", () => go( 1));

    /* Arrancar */
    schedule();
  });
}

document.addEventListener("astro:page-load", init);
if (document.readyState !== "loading") init();
else document.addEventListener("DOMContentLoaded", init);
</script>
