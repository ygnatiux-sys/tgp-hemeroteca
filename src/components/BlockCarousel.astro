---
// src/components/BlockCarousel.astro
/**
 * BlockCarousel.astro
 * Refactorizado al layout MUBI / Criterion Channel ("Hero Spotlight + Satélites"):
 * - Grid de 4 columnas (Hero: 2 cols, Satélites: 1 col cada una).
 * - Aspect ratios estrictos: Hero aspect-[4/5] y Satélites aspect-[2/3].
 * - Jerarquía tipográfica: text-2xl lg:text-3xl en Hero, text-lg lg:text-xl en satélites.
 * - Limpieza de Markdown en títulos y extractos.
 * - Stagger fade GSAP con autoplay, pause on hover y controles de navegación.
 */

interface Card {
  title: string;
  label?: string;
  image: string;
  href: string;
  excerpt?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  cards: Card[];
  cardsPerPage?: number;    // Default: 3
  autoplay?: number;        // Segundos. 0 = sin autoplay. Default: 7
  height?: string;          // Opcional
}

const {
  eyebrow  = "Organización Temática",
  heading  = "Colecciones",
  cards    = [],
  cardsPerPage = 3,
  autoplay = 7,
} = Astro.props;

// Limpiador de símbolos de Markdown crudo
const cleanMarkdown = (text?: string) => {
  if (!text) return "";
  return text.replace(/^[#*\->\s]+/gm, '').trim();
};

// Partir el array en páginas de 3 cards (1 Hero + 2 Satélites)
const pages: Card[][] = [];
for (let i = 0; i < cards.length; i += cardsPerPage) {
  pages.push(cards.slice(i, i + cardsPerPage));
}
const totalPages = pages.length;
const uid = "bc-" + Math.random().toString(36).slice(2, 8);
---

{cards.length > 0 && (
<section
  id={uid}
  class="bc-root w-full relative overflow-hidden"
  data-autoplay={autoplay}
  data-total={totalPages}
>

  <!-- ── HEADER ── -->
  <div class="bc-header flex items-end justify-between gap-4 pb-5 border-b border-white/10">
    <div>
      {eyebrow && (
        <span class="bc-eyebrow block text-[10px] font-mono tracking-[0.4em] uppercase text-amber-500 font-bold mb-1">
          {eyebrow}
        </span>
      )}
      <h2 class="bc-heading font-cinzel text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-transparent bg-clip-text bg-linear-to-b from-slate-200 to-slate-500 m-0 leading-tight">
        {heading}
      </h2>
    </div>

    {totalPages > 1 && (
      <div class="hidden sm:flex items-center gap-2">
        <span class="text-xs font-mono text-zinc-400 tracking-widest">
          BLOQUE <span class="bc-cur text-white font-bold">01</span> / {String(totalPages).padStart(2, "0")}
        </span>
      </div>
    )}
  </div>

  <!-- ── STAGE WRAPPER CON CHEVRONS FLOTANTES ── -->
  <div class="relative w-full group/stage mt-6">
    {totalPages > 1 && (
      <>
        <!-- Botón Anterior Flotante -->
        <button 
          class="bc-prev absolute left-0 md:left-2 top-1/2 -translate-y-1/2 z-40 w-10 h-16 md:h-20 rounded-full bg-black/60 hover:bg-black/90 text-zinc-300 hover:text-white border border-white/15 hover:border-amber-500/50 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-0 group-hover/stage:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none"
          type="button"
          aria-label="Página anterior"
        >
          <svg class="w-5 h-5 -translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>

        <!-- Botón Siguiente Flotante -->
        <button 
          class="bc-next absolute right-0 md:right-2 top-1/2 -translate-y-1/2 z-40 w-10 h-16 md:h-20 rounded-full bg-black/60 hover:bg-black/90 text-zinc-300 hover:text-white border border-white/15 hover:border-amber-500/50 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-0 group-hover/stage:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none"
          type="button"
          aria-label="Página siguiente"
        >
          <svg class="w-5 h-5 translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>
      </>
    )}

    <!-- ── STAGE DE GRILLA MUBI / BENTO TRÍPTICO NIVELADO ── -->
    <div class="bc-stage relative w-full">
      {pages.map((page, pi) => (
        <div 
          class={`bc-page ${pi === 0 ? "bc-active" : ""} grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 items-stretch w-full`} 
          data-page={pi} 
          aria-hidden={pi !== 0 ? "true" : "false"}
        >
          {page.map((card, ci) => {
            const isHero = ci % 3 === 0;
            const cleanedTitle = cleanMarkdown(card.title);
            const cleanedExcerpt = cleanMarkdown(card.excerpt);
            
            return (
              <a 
                href={card.href} 
                class={`bc-card group/card relative flex flex-col w-full text-white no-underline transition-all duration-300 ${isHero ? 'col-span-1 md:col-span-2 lg:col-span-2' : 'col-span-1'}`}
              >
                <!-- Contenedor Multimedia Nivelado (Misma Altura para las 3 Tarjetas con Bokeh) -->
                <div class="relative w-full h-[520px] sm:h-[560px] md:h-[600px] lg:h-[640px] rounded-2xl overflow-hidden bg-[#0c0d10] border border-white/10 shadow-2xl transition-all duration-500 group-hover/card:border-amber-500/40 group-hover/card:shadow-[0_24px_50px_rgba(0,0,0,0.85)]">
                  
                  <!-- Capa de Bokeh expandido de fondo (estilo TgpHeroTriptych) -->
                  <img 
                    src={card.image} 
                    alt="" 
                    aria-hidden="true"
                    class="absolute inset-0 w-full h-full object-cover scale-150 blur-3xl brightness-75 saturate-150 pointer-events-none"
                  />

                  <!-- Imagen neta principal -->
                  <img 
                    src={card.image} 
                    alt={cleanedTitle} 
                    loading="lazy" 
                    decoding="async" 
                    class="relative z-10 w-full h-full object-cover transition-transform duration-700 ease-out group-hover/card:scale-105 pointer-events-none"
                  />
                  
                  <!-- Scrim degradado inferior para legibilidad del texto -->
                  <div class="absolute inset-0 z-15 bg-linear-to-t from-black/95 via-black/45 to-transparent pointer-events-none"></div>

                  <!-- Badge superior flotante -->
                  <div class="absolute top-3.5 left-3.5 z-20 flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/75 backdrop-blur-md border border-white/15 pointer-events-none">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    <span class="text-[10px] md:text-[11px] font-mono tracking-wider text-zinc-300 uppercase">
                      {card.label || "DOSSIER CINEMÁTICO"}
                    </span>
                  </div>

                  <!-- Bloque Tipográfico anclado en la base del póster -->
                  <div class="absolute bottom-0 left-0 right-0 p-5 md:p-6 lg:p-7 z-20 flex flex-col gap-1.5 pointer-events-none">
                    <h3 class={`font-cinzel font-bold uppercase tracking-tight text-white drop-shadow-md transition-colors duration-300 group-hover/card:text-amber-200 ${isHero ? 'text-2xl sm:text-3xl lg:text-4xl leading-[1.08]' : 'text-xl sm:text-2xl leading-[1.12]'}`}>
                      {cleanedTitle}
                    </h3>
                    {cleanedExcerpt && (
                      <p class={`font-sans text-white/80 line-clamp-2 leading-relaxed font-normal ${isHero ? 'text-sm md:text-base' : 'text-xs md:text-sm'}`}>
                        {cleanedExcerpt}
                      </p>
                    )}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ))}
    </div>
  </div>

</section>
)}

<style>
/* ── PÁGINAS — La activa define el flujo del stage, las inactivas se ocultan de forma absoluta ── */
.bc-stage {
  position: relative;
  width: 100%;
}

.bc-page {
  transition: opacity 0.4s ease;
}

.bc-page:not(.bc-active) {
  position: absolute;
  inset: 0;
  visibility: hidden;
  pointer-events: none;
  opacity: 0;
}

.bc-page.bc-active {
  position: relative;
  visibility: visible;
  pointer-events: auto;
  opacity: 1;
}

/* ── Tarjeta base para animación GSAP ── */
.bc-card {
  min-width: 0;
  cursor: pointer;
}
</style>

<script>
import gsap from "gsap";

function initBlockCarousel() {
  document.querySelectorAll<HTMLElement>(".bc-root").forEach((root) => {
    if (root.dataset.ready === "1") return;
    root.dataset.ready = "1";

    const autoplaySecs = parseFloat(root.dataset.autoplay || "7");
    const totalPages   = parseInt(root.dataset.total   || "1", 10);

    if (totalPages < 2) return;

    const pages   = Array.from(root.querySelectorAll<HTMLElement>(".bc-page"));
    const btnPrev = root.querySelector<HTMLButtonElement>(".bc-prev");
    const btnNext = root.querySelector<HTMLButtonElement>(".bc-next");
    const curEl   = root.querySelector<HTMLElement>(".bc-cur");

    let cur          = 0;
    let busy         = false;
    let hovered      = false;
    let timer: gsap.core.Tween | null = null;

    /* ── Programar próximo autoplay ── */
    function schedule() {
      timer?.kill();
      if (autoplaySecs <= 0) return;
      timer = gsap.delayedCall(autoplaySecs, () => go(1));
      if (hovered) timer.pause();
    }

    /* ── Transición principal con física Apple TV+ (rápida de a 3, expo.out y micro-zoom) ── */
    function go(delta: number) {
      if (busy) return;
      const next = (cur + delta + totalPages) % totalPages;
      if (next === cur) return;

      busy = true;

      const pageOut  = pages[cur];
      const pageIn   = pages[next];
      const cardsOut = Array.from(pageOut.querySelectorAll<HTMLElement>(".bc-card"));
      const cardsIn  = Array.from(pageIn.querySelectorAll<HTMLElement>(".bc-card"));

      /* Preparar el bloque entrante: visible y en posición de entrada con micro-zoom */
      pageIn.classList.add("bc-active");
      pageIn.setAttribute("aria-hidden", "false");
      gsap.set(cardsIn, { opacity: 0, x: 28, scale: 1.04 });

      /* Actualizar paginación */
      if (curEl) curEl.textContent = String(next + 1).padStart(2, "0");

      const tl = gsap.timeline({
        defaults: { ease: "expo.out" },
        onComplete() {
          /* Ocultar bloque saliente y resetear sus cards */
          pageOut.classList.remove("bc-active");
          pageOut.setAttribute("aria-hidden", "true");
          gsap.set(cardsOut, { clearProps: "all" });

          cur  = next;
          busy = false;
          schedule();
        }
      });

      /* 1 — Salida ultrarrápida del bloque actual (280ms) con leve retroceso a la izquierda */
      tl.to(cardsOut, {
        opacity: 0,
        x: -25,
        scale: 0.98,
        duration: 0.28,
        stagger: 0.05,
        ease: "power2.in",
      }, 0);

      /* 2 — Entrada explosiva sincronizada de las nuevas 3 tarjetas (550ms expo.out) */
      tl.to(cardsIn, {
        opacity: 1,
        x: 0,
        scale: 1,
        duration: 0.55,
        stagger: 0.07,
        ease: "expo.out",
      }, 0.12);
    }

    /* ── Hover: pausa y reanuda el timer ── */
    root.addEventListener("mouseenter", () => {
      hovered = true;
      timer?.pause();
    });
    root.addEventListener("mouseleave", () => {
      hovered = false;
      if (!busy) timer?.resume();
    });

    /* ── Botones manuales ── */
    btnPrev?.addEventListener("click", () => go(-1));
    btnNext?.addEventListener("click", () => go( 1));

    /* Arrancar autoplay */
    schedule();
  });
}

document.addEventListener("astro:page-load", initBlockCarousel);
if (document.readyState !== "loading") initBlockCarousel();
else document.addEventListener("DOMContentLoaded", initBlockCarousel);
</script>
