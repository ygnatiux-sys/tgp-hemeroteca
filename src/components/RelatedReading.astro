---
---

<div class="not-prose my-12 -mx-4 md:-mx-10 lg:-mx-20 xl:-mx-28 px-4 md:px-10">
  <div class="relative overflow-hidden rounded-2xl border border-white/8 bg-white/2 p-6 md:p-8 flex flex-col sm:flex-row gap-6 sm:gap-8 items-start">

    {/* Línea editorial izquierda */}
    <div class="shrink-0 flex flex-col gap-2 sm:max-w-50">
      <span class="font-mono text-[8.5px] uppercase tracking-[0.4em] text-rust-orange block">Lectura Relacionada</span>
      <h4 class="font-cinzel font-bold text-lg sm:text-xl text-[#E0E0E0]/90 leading-snug">
        Únete a la investigación
      </h4>
      <p class="font-mono text-[8px] uppercase tracking-[0.2em] text-white/30 leading-relaxed">
        Documentos exclusivos y nuevos descubrimientos de la colección.
      </p>
    </div>

    {/* Separador vertical en sm+ */}
    <div class="hidden sm:block w-px self-stretch bg-white/6 shrink-0"></div>

    {/* Links */}
    <div class="flex flex-col gap-3 flex-1 w-full">
      <!-- El Códice -->
      <a
        href="/codice"
        class="group flex items-center gap-4 rounded-xl border border-white/8 bg-white/2 p-3.5 hover:border-rust-orange/35 hover:bg-rust-orange/4 transition-all duration-400"
      >
        <div class="w-14 h-14 rounded-lg overflow-hidden shrink-0 border border-white/10">
          <img
            src="/images/lead-magnet/book-cover.jpg"
            alt="El Códice Fundacional"
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
          />
        </div>
        <div class="flex flex-col gap-0.5">
          <span class="font-mono text-[7.5px] uppercase tracking-[0.3em] text-rust-orange/70">Documento Exclusivo</span>
          <h5 class="font-cinzel font-bold text-sm text-[#E0E0E0]/85 group-hover:text-rust-orange transition-colors leading-snug">
            El Códice Fundacional
          </h5>
          <p class="font-serif italic text-[10px] text-white/35 leading-snug line-clamp-1">
            "La verdad no es algo que se encuentra, es algo que se recuerda."
          </p>
        </div>
        <span class="ml-auto text-white/20 group-hover:text-rust-orange/60 group-hover:translate-x-0.5 transition-all text-sm shrink-0">▸</span>
      </a>

      <!-- Substack -->
      <a
        href="https://thegreatpuzzleproject.substack.com"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-4 rounded-xl border border-white/8 bg-white/2 p-3.5 hover:border-rust-orange/35 hover:bg-rust-orange/4 transition-all duration-400"
      >
        <div class="w-14 h-14 rounded-lg overflow-hidden shrink-0 border border-white/10 bg-white/4 flex items-center justify-center">
          <svg viewBox="0 0 24 24" class="w-6 h-6 fill-rust-orange/70 group-hover:fill-rust-orange transition-colors" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.539 8.242H1.46V5.406h21.078v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.078V0z"/>
          </svg>
        </div>
        <div class="flex flex-col gap-0.5">
          <span class="font-mono text-[7.5px] uppercase tracking-[0.3em] text-rust-orange/70">Bitácora · Substack</span>
          <h5 class="font-cinzel font-bold text-sm text-[#E0E0E0]/85 group-hover:text-rust-orange transition-colors leading-snug">
            Pensamiento Crítico en tu Buzón
          </h5>
          <p class="font-mono text-[10px] text-white/35 leading-snug">
            Ensayos exclusivos · Suscripción gratuita
          </p>
        </div>
        <span class="ml-auto text-white/20 group-hover:text-rust-orange/60 group-hover:translate-x-0.5 transition-all text-sm shrink-0">↗</span>
      </a>
    </div>
  </div>
</div>
