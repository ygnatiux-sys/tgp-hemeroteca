---
/**
 * NavAcademic.astro - Barra superior cinematica para /papers
 * Preserva la identidad academica + hamburguer 3-state + retorno limpio al inicio
 */
import { BuscadorModal } from './BuscadorModal';
import ThemeToggle from './ThemeToggle.astro';
---

<header
  id="ac-site-header"
  class="fixed top-0 w-full z-50 transition-all duration-700 bg-transparent border-b border-transparent"
  data-transparent="true"
>
  <div class="w-full px-4 md:px-8 lg:px-12 xl:px-16 py-3.5 md:py-4 flex justify-between items-center relative">

    <!-- Izquierda: Retorno al inicio -->
    <a
      href="/"
      class="ac-back-home group flex items-center gap-2 text-current opacity-60 hover:opacity-100 transition-all duration-300"
      title="Volver al inicio - Hemeroteca TGP"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:-translate-x-0.5">
        <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
      </svg>
      <span class="font-mono text-[9px] lg:text-[10px] tracking-[0.18em] uppercase">Hemeroteca</span>
    </a>

    <!-- Centro: Brand academico -->
    <a href="/papers" class="ac-brand absolute left-1/2 -translate-x-1/2 flex flex-col items-center gap-0.5 text-center no-underline transition-opacity duration-300">
      <span class="font-['Cormorant_Garamond'] font-extrabold text-[15px] md:text-[17px] lg:text-[19px] tracking-[-0.02em] leading-none text-current whitespace-nowrap">
        TGP <em class="not-italic ac-gold-dot">•</em> Papers
      </span>
      <span class="font-mono font-light text-[8px] tracking-[0.22em] uppercase opacity-50">Scriptorium Epistemico</span>
    </a>

    <!-- Derecha: Acciones -->
    <div class="flex items-center gap-2 ml-auto z-10">
      <ThemeToggle />
      <BuscadorModal client:load />
    </div>

  </div>
</header>

<!-- Espaciador para que el contenido no quede bajo el header fixed -->
<div class="h-[60px] md:h-[68px]"></div>

<script>
  const SCROLLED = ['ac-is-scrolled'];

  const setupAcScroll = () => {
    const header = document.getElementById('ac-site-header');
    if (!header) return;

    const onScroll = () => {
      if (window.scrollY > 40) {
        header.classList.add(...SCROLLED);
      } else {
        header.classList.remove(...SCROLLED);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  };

  document.addEventListener('DOMContentLoaded', setupAcScroll);
  document.addEventListener('astro:page-load', setupAcScroll);
</script>

<style>
  /* -- Variables academicas -- */
  :root {
    --ac-gold: #8C6D2F;
  }

  .ac-gold-dot {
    color: var(--ac-gold);
  }

  /* -- Base: siempre transparente -- */
  #ac-site-header {
    background-color: transparent;
    border-bottom-color: transparent;
  }

  /* -- Al scrollear: atenuado cinematico identico al Header.astro -- */
  #ac-site-header.ac-is-scrolled {
    opacity: 0.02;
    background-color: transparent !important;
    border-bottom-color: transparent !important;
    backdrop-filter: none;
    transition: opacity 0.5s ease;
  }

  #ac-site-header.ac-is-scrolled:hover,
  #ac-site-header.ac-is-scrolled:focus-within {
    opacity: 1;
    background-color: rgba(250, 250, 249, 0.92) !important;
    border-bottom-color: rgba(60, 50, 30, 0.1) !important;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: opacity 0.3s ease, background-color 0.3s ease;
  }

  /* -- Brand hover -- */
  .ac-brand:hover {
    opacity: 0.8;
  }

  /* -- Modo light -- */
  [data-theme='light'] #ac-site-header.ac-is-scrolled:hover {
    background-color: rgba(250, 250, 249, 0.97) !important;
  }
</style>
