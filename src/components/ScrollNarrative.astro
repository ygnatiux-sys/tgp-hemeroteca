---
/**
 * src/components/ScrollNarrative.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * COLECCIÓN DESTACADA: 'AMERICA SECRETS' (TIMELINE UNIFICADA EN LOOP CONTINUO)
 *
 * Secuencia cinematográfica integral en un solo lienzo:
 * 1. Intro Colección: Ambient Glow Andesita/Cian (#050607 + #4ef2d2) → AMÉRICA.
 *    Corte Láser CNC de Precisión: Un hilo láser cian traza y revela SECRETS.
 * 2. Transición fluida a PUMAPUNKU: Fotografía luminosa del Bloque H de andesita
 *    + Encastre de precisión milimétrica + Subtítulo de telemetría geológica.
 * 3. Loop infinito continuo (repite suavemente el ciclo cinematográfico).
 * 4. Cero metadata innecesaria: pura estética de cine de alta gama.
 */
import imgPumapunku from "../assets/alternativa/pumapunku.jpg";

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://api.fontshare.com" />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,900,0,1&family=Chivo+Mono:wght@500;700&display=swap"
/>
<link
  rel="stylesheet"
  href="https://api.fontshare.com/v2/css?f[]=panchang@700,800,900&display=swap"
/>

<section
  id="scroll-narrative-container"
  class={`america-unified-stage relative w-full h-svh min-h-145 bg-[#050607] text-[#e2e8f0] select-none overflow-hidden ${className}`}
  aria-label="Colección Destacada: América Secrets"
>
  <!-- ════════════════════════════════════════════════════════════════════════
       CAPA 1: APERTURA AMERICA SECRETS (AMBIENT GLOW ANDESITA / CIAN CNC)
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="america-layer-intro absolute inset-0 z-20 flex items-center justify-center overflow-hidden bg-[#050607]">
    <!-- Ambient Glow: destello de andesita cian en la esquina superior izquierda -->
    <div class="absolute -top-[15%] -left-[10%] w-[75vw] h-[75vw] max-w-225 max-h-225 rounded-full bg-[radial-gradient(circle_at_center,rgba(78,242,210,0.28)_0%,rgba(69,123,119,0.16)_35%,rgba(20,40,38,0.06)_60%,transparent_75%)] blur-3xl pointer-events-none"></div>

    <!-- Destello secundario cálido de óxido de cobre en la esquina inferior derecha -->
    <div class="absolute -bottom-[20%] -right-[15%] w-[60vw] h-[60vw] max-w-175 max-h-175 rounded-full bg-[radial-gradient(circle_at_center,rgba(217,119,6,0.18)_0%,rgba(146,64,14,0.08)_40%,transparent_70%)] blur-3xl pointer-events-none"></div>

    <!-- Viñeta perimetral de basalto para sellar bordes -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_38%,rgba(5,6,7,0.75)_70%,#050607_100%)] pointer-events-none"></div>

    <!-- Grilla técnica sutil de ingeniería / AutoCAD -->
    <div class="america-grid-overlay absolute inset-0 opacity-15 pointer-events-none"></div>
    <div class="america-grain absolute inset-0 opacity-20 pointer-events-none mix-blend-overlay"></div>

    <!-- Escenario Central del Título CNC -->
    <div class="relative z-20 flex flex-col items-center justify-center text-center px-4 max-w-6xl w-full">
      <!-- TÍTULO: AMÉRICA (Masa imponente con gradiente titanio / andesita) -->
      <h1 class="america-title-word font-fraunces font-black uppercase text-[clamp(4.2rem,16vw,15.5rem)] leading-[0.85] tracking-[-0.03em] whitespace-nowrap opacity-0">
        AMÉRICA
      </h1>

      <!-- CORTE LÁSER CNC: SECRETS revelado por hilo láser de diamante -->
      <div class="america-cnc-wrap relative inline-block mt-3 overflow-visible">
        <!-- Texto final revelado -->
        <h2 class="america-secrets-word font-['Chivo_Mono'] font-bold uppercase text-[clamp(1.4rem,4.5vw,3.6rem)] tracking-[0.38em] text-[#4ef2d2] drop-shadow-[0_0_30px_rgba(78,242,210,0.45)] m-0">
          SECRETS
        </h2>

        <!-- Hilo Láser Cian de 1px con chispa de corte de diamante -->
        <div class="america-laser-line absolute top-0 bottom-0 w-0.5 bg-[#4ef2d2] shadow-[0_0_14px_#4ef2d2] pointer-events-none opacity-0">
          <span class="america-laser-spark absolute top-1/2 -translate-y-1/2 -left-1.25 w-3 h-3 rounded-full bg-white shadow-[0_0_18px_#4ef2d2,0_0_30px_#ffffff]"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════════════
       CAPA 2: REVELACIÓN PUMAPUNKU (ANDESITA QUIRÚRGICA / CORTE MILIMÉTRICO)
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="america-layer-pumapunku absolute inset-0 z-10 flex items-center justify-center overflow-hidden opacity-0 bg-[#050607]">
    <!-- Fotografía luminosa de alta definición del Bloque H -->
    <div class="absolute inset-0 overflow-hidden">
      <img
        src={imgPumapunku.src}
        alt="Bloque H de andesita con corte geométrico perfecto en Pumapunku"
        class="pumapunku-bg-img absolute inset-0 w-full h-full object-cover object-[center_42%] filter brightness-105 contrast-102 will-change-transform"
        loading="eager"
        decoding="async"
      />
    </div>

    <!-- Scrim ceñido para contraste sin oscurecer el centro -->
    <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_center,transparent_42%,rgba(5,6,7,0.32)_78%,rgba(5,6,7,0.88)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-36 bg-linear-to-t from-[#050607] to-transparent pointer-events-none"></div>

    <!-- Título de Encastre Perfecto: PUMA PUNKU -->
    <div class="absolute inset-0 flex flex-col items-center justify-center p-4 z-20 pointer-events-none">
      <div class="pumapunku-slot flex flex-col items-center text-center">
        <!-- Título monumental de Panchang brutalista CNC -->
        <h2 class="pumapunku-title m-0 font-['Panchang'] font-black uppercase text-[clamp(2.8rem,9vw,9.8rem)] leading-[0.9] tracking-[0.04em] text-center whitespace-nowrap opacity-0 will-change-transform">
          PUMA PUNKU
        </h2>

        <!-- Subtítulo de precisión milimétrica -->
        <div class="pumapunku-sub-wrap overflow-hidden mt-3 pt-1 pb-2">
          <p class="pumapunku-sub m-0 font-['Chivo_Mono'] font-medium text-[clamp(0.72rem,1.15vw,1.3rem)] tracking-[0.3em] uppercase text-center text-[#4ef2d2] opacity-0 translate-y-[120%] will-change-transform drop-shadow-[0_2px_15px_rgba(0,0,0,0.9)]">
            Mecanizado de precisión en el altiplano boliviano
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* TÍTULO AMÉRICA EN TITANIO / CALIZA ANDINA */
  .america-title-word {
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      #e2e8f0 45%,
      #94a3b8 80%,
      #475569 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 20px 45px rgba(0, 0, 0, 0.98))
      drop-shadow(0 0 45px rgba(78, 242, 210, 0.28));
    will-change: transform, opacity;
  }

  /* Grilla técnica de ingeniería */
  .america-grid-overlay {
    background-size: 50px 50px;
    background-image: 
      linear-gradient(to right, rgba(78, 242, 210, 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(78, 242, 210, 0.08) 1px, transparent 1px);
  }

  /* Grano analógico de película */
  .america-grain {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  /* TÍTULO PUMA PUNKU EN ANDESITA DE PRECISIÓN */
  .pumapunku-title {
    background: linear-gradient(
      180deg,
      #f8fafc 0%,
      #cbd5e1 35%,
      #64748b 75%,
      #334155 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 20px 48px rgba(0, 0, 0, 0.98))
      drop-shadow(0 0 35px rgba(78, 242, 210, 0.35));
  }

  .pumapunku-bg-img {
    animation: pumapunku-drift 32s ease-in-out infinite alternate;
  }
  @keyframes pumapunku-drift {
    0% { transform: scale(1); }
    100% { transform: scale(1.045); }
  }
</style>

<script>
  import gsap from "gsap";

  const initUnifiedAmericaTimeline = () => {
    const stage = document.querySelector<HTMLElement>(".america-unified-stage");
    if (!stage || stage.dataset.ready === "true") return;
    stage.dataset.ready = "true";

    // Capa 1: Intro Colección
    const layerIntro = stage.querySelector<HTMLElement>(".america-layer-intro");
    const titleAmerica = stage.querySelector<HTMLElement>(".america-title-word");
    const secretsWord = stage.querySelector<HTMLElement>(".america-secrets-word");
    const laserLine = stage.querySelector<HTMLElement>(".america-laser-line");

    // Capa 2: Pumapunku
    const layerPumapunku = stage.querySelector<HTMLElement>(".america-layer-pumapunku");
    const titlePumapunku = stage.querySelector<HTMLElement>(".pumapunku-title");
    const subPumapunku = stage.querySelector<HTMLElement>(".pumapunku-sub");

    if (!layerIntro || !titleAmerica || !secretsWord || !laserLine || !layerPumapunku || !titlePumapunku || !subPumapunku) return;

    let masterTl: gsap.core.Timeline | null = null;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const resetElements = () => {
      gsap.set(layerIntro, { opacity: 1 });
      gsap.set(titleAmerica, { opacity: 0, scale: 1.06, y: 0 });
      gsap.set(secretsWord, { clipPath: "inset(0 100% 0 0)" });
      gsap.set(laserLine, { left: "0%", opacity: 0 });

      gsap.set(layerPumapunku, { opacity: 0 });
      gsap.set(titlePumapunku, { opacity: 0, scale: 1.08, y: 0 });
      gsap.set(subPumapunku, { yPercent: 120, opacity: 0 });
    };

    const buildTimeline = async () => {
      if (document.fonts?.ready) await document.fonts.ready;
      masterTl?.kill();
      resetElements();

      if (reduceMotion) {
        gsap.set(layerIntro, { opacity: 1 });
        gsap.set(titleAmerica, { opacity: 1 });
        gsap.set(secretsWord, { clipPath: "inset(0 0 0 0)" });
        return;
      }

      // TIMELINE UNIFICADA EN LOOP CONTINUO PARA AMÉRICA SECRETS
      masterTl = gsap.timeline({
        repeat: -1,
        repeatDelay: 1.2,
      });

      // ─────────────────────────────────────────────────────────────
      // FASE 1: APERTURA AMÉRICA SECRETS (AMBIENT GLOW CIAN / CNC)
      // ─────────────────────────────────────────────────────────────
      // 1. AMÉRICA aparece imponente en el primer plano
      masterTl.to(titleAmerica, {
        opacity: 1,
        scale: 1,
        duration: 1.4,
        ease: "power2.out",
      }, 0.3)
        // 2. Contemplación breve
        .to({}, { duration: 0.6 })

        // 3. Encendido del Hilo Láser CNC
        .to(laserLine, {
          opacity: 1,
          duration: 0.15,
          ease: "none",
        }, "laserCut")

        // 4. Corte de precisión horizontal: el láser recorre y revela SECRETS
        .to(laserLine, {
          left: "100%",
          duration: 1.8,
          ease: "power1.inOut",
        }, "laserCut")
        .to(secretsWord, {
          clipPath: "inset(0 0% 0 0)",
          duration: 1.8,
          ease: "power1.inOut",
        }, "laserCut")

        // 5. Apagado del láser tras completar el corte milimétrico
        .to(laserLine, {
          opacity: 0,
          duration: 0.2,
          ease: "none",
        }, "laserCut+=1.8")

        // 6. Contemplación del título completo
        .to({}, { duration: 1.4 });

      // ─────────────────────────────────────────────────────────────
      // FASE 2: TRANSICIÓN FLUIDA A PUMAPUNKU (ANDESITA QUIRÚRGICA)
      // ─────────────────────────────────────────────────────────────
      masterTl.to(layerIntro, {
        opacity: 0,
        duration: 1.3,
        ease: "power2.inOut",
      }, "ppTransition")
        .to(layerPumapunku, {
          opacity: 1,
          duration: 1.3,
          ease: "power2.inOut",
        }, "ppTransition");

      // ─────────────────────────────────────────────────────────────
      // FASE 3: ENCASTRE DE PRECISIÓN DE PUMAPUNKU
      // ─────────────────────────────────────────────────────────────
      // 7. PUMA PUNKU se asienta con golpe seco de máquina CNC
      masterTl.to(titlePumapunku, {
        opacity: 1,
        scale: 1,
        duration: 1.5,
        ease: "power4.out",
      }, "ppSettle")
        // 8. Subtítulo asciende a la superficie con nitidez
        .to(subPumapunku, {
          yPercent: 0,
          opacity: 1,
          duration: 1.4,
          ease: "power3.out",
        }, "ppSettle+=0.5")

        // 9. Contemplación final del hito de Pumapunku
        .to({}, { duration: 3.5 });

      // ─────────────────────────────────────────────────────────────
      // FASE 4: DISOLUCIÓN DE VUELTA AL INICIO DEL LOOP
      // ─────────────────────────────────────────────────────────────
      masterTl.to(layerPumapunku, {
        opacity: 0,
        duration: 1.4,
        ease: "power2.inOut",
      });
    };

    buildTimeline();
  };

  document.addEventListener("astro:page-load", initUnifiedAmericaTimeline);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initUnifiedAmericaTimeline);
  } else {
    initUnifiedAmericaTimeline();
  }
</script>
