---
/**
 * ScrollNarrative.astro
 * Sticky Scroll Narrative de 3 pasos a pantalla completa.
 * Estilo editorial de alta gama (National Geographic / Apple / The Great Puzzle).
 * Integración con GSAP para transiciones cinemáticas, encuadre despejado y autoplay fluido.
 */

interface Step {
  id: string;
  badge?: string;
  image: string;
  alt: string;
  text: string;
  ctaText?: string;
  ctaHref?: string;
}

interface Props {
  steps?: Step[];
  className?: string;
  autoplayDuration?: number; // En milisegundos, default 3500ms
}

const defaultSteps: Step[] = [
  {
    id: "step-1",
    badge: "CAPÍTULO I · MESOAMÉRICA",
    image: "/images/megalitos/olmeca.jpg",
    alt: "Cabeza Olmeca colosal sobre fondo oscuro",
    text: "Un mismo lenguaje, continentes separados por océanos.",
  },
  {
    id: "step-2",
    badge: "CAPÍTULO II · RAPA NUI",
    image: "/images/megalitos/moai.jpg",
    alt: "Moái monolítico recortado contra el océano",
    text: "La misma obsesión monolítica.",
  },
  {
    id: "step-3",
    badge: "CAPÍTULO III · ANATOLIA",
    image: "/images/megalitos/gobekli-tepe.jpg",
    alt: "Pilar megalítico grabado en Göbekli Tepe",
    text: "El rompecabezas original.",
    ctaText: "Explorar el Dossier Megalítico",
    ctaHref: "/colecciones/arqueosemiotica/",
  },
];

const { steps = defaultSteps, className = "", autoplayDuration = 3500 } = Astro.props;
---

<section
  id="scroll-narrative-container"
  class={`relative w-full h-[300vh] bg-black ${className}`}
  data-scroll-narrative
  data-autoplay={autoplayDuration}
>
  {/* Contenedor Sticky a Pantalla Completa */}
  <div class="sticky top-0 h-screen w-full overflow-hidden bg-black select-none">
    
    {/* Capas narrativas superpuestas */}
    {steps.map((step, index) => (
      <div
        class={`narrative-layer absolute inset-0 w-full h-full flex flex-col items-center justify-end pb-12 sm:pb-14 md:pb-16 px-6 sm:px-10 ${index === 0 ? "opacity-100 pointer-events-auto" : "opacity-0 pointer-events-none"}`}
        data-step-index={index}
      >
        {/* Imagen de fondo nítida y brillante a pantalla completa */}
        <img
          src={step.image}
          alt={step.alt}
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
          class="narrative-img absolute inset-0 w-full h-full object-cover object-center filter brightness-105 contrast-105 will-change-transform origin-center"
        />

        {/* Gradiente compacto al pie de la pantalla: no invade la imagen ni el monolito */}
        <div class="absolute inset-x-0 bottom-0 h-44 sm:h-52 md:h-60 bg-linear-to-t from-black/90 via-black/45 to-transparent pointer-events-none" />

        {/* Contenido textual anclado en la base inferior */}
        <div class="narrative-content relative z-10 max-w-4xl mx-auto text-center flex flex-col items-center gap-3 sm:gap-4 mb-2 sm:mb-3">
          {step.badge && (
            <span class="inline-block font-metadata text-[9.5px] sm:text-[10.5px] tracking-[0.35em] uppercase text-stone-200 font-medium py-0.5 px-3 rounded-full border border-white/20 bg-black/40 backdrop-blur-md">
              {step.badge}
            </span>
          )}

          <h2 class="font-serif text-stone-100 text-2xl sm:text-3xl md:text-4xl lg:text-5xl leading-[1.18] tracking-tight drop-shadow-[0_2px_16px_rgba(0,0,0,0.95)] max-w-2xl">
            {step.text}
          </h2>

          {step.ctaText && (
            <div class="pt-1.5 sm:pt-2">
              <a
                href={step.ctaHref || "#"}
                class="group relative inline-flex items-center gap-3 px-6 sm:px-8 py-2.5 sm:py-3 rounded-full bg-stone-100 text-stone-950 font-metadata text-xs font-bold uppercase tracking-[0.25em] shadow-[0_0_25px_rgba(255,255,255,0.25)] hover:bg-white hover:scale-[1.03] active:scale-95 transition-all duration-300 pointer-events-auto cursor-pointer"
              >
                <span>{step.ctaText}</span>
                <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
              </a>
            </div>
          )}
        </div>
      </div>
    ))}

  </div>
</section>

<script>
  import { gsap } from "gsap";

  function setupScrollNarrative() {
    const container = document.getElementById("scroll-narrative-container");
    if (!container) return;

    const layers = container.querySelectorAll<HTMLElement>(".narrative-layer");
    const totalSteps = layers.length;
    if (totalSteps === 0) return;

    const autoDurationAttr = container.getAttribute("data-autoplay");
    const autoplayDuration = autoDurationAttr ? parseInt(autoDurationAttr, 10) : 3500;

    let currentIndex = 0;
    let autoTimer: any = null;
    let isVisible = false;

    // Transición cinemática orquestada con GSAP
    function goToStep(targetIndex: number) {
      if (targetIndex < 0 || targetIndex >= totalSteps) return;
      if (targetIndex === currentIndex) return;

      const prevIndex = currentIndex;
      currentIndex = targetIndex;

      const prevLayer = layers[prevIndex];
      const nextLayer = layers[targetIndex];
      const prevImg = prevLayer?.querySelector<HTMLElement>(".narrative-img");
      const nextImg = nextLayer?.querySelector<HTMLElement>(".narrative-img");
      const prevContent = prevLayer?.querySelector<HTMLElement>(".narrative-content");
      const nextContent = nextLayer?.querySelector<HTMLElement>(".narrative-content");

      // 1. Desvanecer capa saliente
      if (prevLayer && prevLayer !== nextLayer) {
        gsap.killTweensOf([prevLayer, prevImg, prevContent]);
        gsap.to(prevLayer, {
          opacity: 0,
          duration: 0.55,
          ease: "power2.inOut",
          onComplete: () => {
            prevLayer.classList.remove("pointer-events-auto");
            prevLayer.classList.add("pointer-events-none");
          }
        });
        if (prevContent) {
          gsap.to(prevContent, {
            y: -18,
            opacity: 0,
            duration: 0.45,
            ease: "power2.in"
          });
        }
      }

      // 2. Animar entrada cinemática de la capa siguiente
      if (nextLayer) {
        gsap.killTweensOf([nextLayer, nextImg, nextContent]);
        nextLayer.classList.remove("pointer-events-none");
        nextLayer.classList.add("pointer-events-auto");

        gsap.fromTo(nextLayer, 
          { opacity: 0 }, 
          { opacity: 1, duration: 0.6, ease: "power2.out" }
        );

        if (nextImg) {
          gsap.fromTo(nextImg, 
            { scale: 1.05 }, 
            { scale: 1.0, duration: 0.85, ease: "power2.out" }
          );
        }

        if (nextContent) {
          gsap.fromTo(nextContent, 
            { y: 22, opacity: 0 }, 
            { y: 0, opacity: 1, duration: 0.6, ease: "power3.out", delay: 0.08 }
          );
        }
      }
    }

    // Temporizador de avance automático
    function startAutoTimer() {
      stopAutoTimer();
      autoTimer = setInterval(() => {
        if (isVisible) {
          const next = (currentIndex + 1) % totalSteps;
          goToStep(next);
        }
      }, autoplayDuration);
    }

    function stopAutoTimer() {
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    function resetAutoTimer() {
      startAutoTimer();
    }

    // Control de scroll sincronizado
    let ticking = false;
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          ticking = false;
          if (!container) return;
          const rect = container.getBoundingClientRect();
          const scrollableDistance = rect.height - window.innerHeight;
          if (scrollableDistance <= 0) return;

          // Solo si el usuario se encuentra dentro del contenedor de 300vh
          if (rect.top <= 0 && rect.bottom >= window.innerHeight) {
            const rawProgress = -rect.top / scrollableDistance;
            const progress = Math.min(Math.max(rawProgress, 0), 1);
            const slice = 1 / totalSteps;
            const target = Math.min(Math.floor(progress / slice), totalSteps - 1);
            if (target !== currentIndex) {
              goToStep(target);
              resetAutoTimer();
            }
          }
        });
        ticking = true;
      }
    }

    // Pausar autoplay cuando la sección no esté visible en la pantalla
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            startAutoTimer();
          } else {
            stopAutoTimer();
          }
        });
      },
      { threshold: 0.15 }
    );
    observer.observe(container);

    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // Inicialización compatible con SPA y recarga estándar
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupScrollNarrative);
  } else {
    setupScrollNarrative();
  }
  document.addEventListener("astro:page-load", setupScrollNarrative);
</script>
