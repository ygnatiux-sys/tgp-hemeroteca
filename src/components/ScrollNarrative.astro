---
/**
 * src/components/ScrollNarrative.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Sticky Scroll Narrative de 3 pasos a pantalla completa (300vh).
 * Estilo Editorial Dark Academia (National Geographic / Apple).
 *
 * - 100% Astro + Tailwind CSS + Vanilla JS (cero dependencias pesadas).
 * - Transiciones ágiles de 300ms (transition-opacity duration-300 ease-in-out).
 * - Capa 1 (0-33%): Cabeza Colosal Olmeca.
 * - Capa 2 (33-66%): Moái de Rapa Nui.
 * - Capa 3 (66-100%): Pilar 43 de Göbekli Tepe + CTA "Explorar el Dossier Megalítico".
 */
import imgOlmeca from "../assets/alternativa/olmeca.jpg";
import imgMoai from "../assets/alternativa/moai.jpg";

interface Props {
  olmecaImage?: string;
  moaiImage?: string;
  gobekliImage?: string;
  ctaHref?: string;
  ctaLabel?: string;
  className?: string;
}

const {
  olmecaImage = imgOlmeca.src,
  moaiImage = imgMoai.src,
  gobekliImage = "/images/gobekli-tepe-pilar43-dark.webp",
  ctaHref = "/colecciones/america-secrets/gobekli-tepe/",
  ctaLabel = "Explorar el Dossier Megalítico",
  className = "",
} = Astro.props;
---

<section
  data-scroll-narrative
  class={`relative h-[300vh] w-full select-none ${className}`}
  aria-label="Narrativa Megalítica en 3 Actos"
>
  <!-- Contenedor Sticky a pantalla completa -->
  <div class="sticky top-0 h-screen w-full overflow-hidden bg-black">

    <!-- ═══════════════════════════════════════════════════════════════════════
         CAPA 1 (0% - 33%): CABEZA COLOSAL OLMECA
         ═══════════════════════════════════════════════════════════════════════ -->
    <div
      data-narrative-layer="0"
      class="absolute inset-0 h-full w-full transition-opacity duration-300 ease-in-out opacity-100 z-10"
    >
      <img
        src={olmecaImage}
        alt="Cabeza Colosal Olmeca tallada en basalto"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-center"
      />
      <!-- Overlay negro bg-black/60 + viñeta editorial -->
      <div class="absolute inset-0 bg-black/60 bg-[radial-gradient(circle_at_center,transparent_20%,rgba(0,0,0,0.65)_100%)]"></div>

      <div class="relative z-10 flex h-full w-full flex-col items-center justify-center px-6 text-center">
        <span class="mb-5 font-mono text-[10px] sm:text-xs uppercase tracking-[0.35em] text-amber-300/80">
          Acto I · Mesoamérica Arcaica
        </span>
        <h2 class="max-w-4xl font-serif text-3xl sm:text-5xl md:text-6xl font-normal leading-[1.12] tracking-tight text-stone-200 drop-shadow-[0_4px_24px_rgba(0,0,0,0.9)]">
          “Un mismo lenguaje, continentes separados por océanos.”
        </h2>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CAPA 2 (33% - 66%): MOÁI DE RAPA NUI
         ═══════════════════════════════════════════════════════════════════════ -->
    <div
      data-narrative-layer="1"
      class="absolute inset-0 h-full w-full transition-opacity duration-300 ease-in-out opacity-0 z-0 pointer-events-none"
    >
      <img
        src={moaiImage}
        alt="Monolito Moái en Rapa Nui"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-center"
      />
      <!-- Overlay negro bg-black/60 + viñeta editorial -->
      <div class="absolute inset-0 bg-black/60 bg-[radial-gradient(circle_at_center,transparent_20%,rgba(0,0,0,0.65)_100%)]"></div>

      <div class="relative z-10 flex h-full w-full flex-col items-center justify-center px-6 text-center">
        <span class="mb-5 font-mono text-[10px] sm:text-xs uppercase tracking-[0.35em] text-amber-300/80">
          Acto II · Pacífico Sur
        </span>
        <h2 class="max-w-4xl font-serif text-3xl sm:text-5xl md:text-6xl font-normal leading-[1.12] tracking-tight text-stone-200 drop-shadow-[0_4px_24px_rgba(0,0,0,0.9)]">
          “La misma obsesión monolítica.”
        </h2>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CAPA 3 (66% - 100%): GÖBEKLI TEPE (PILAR 43) + CTA
         ═══════════════════════════════════════════════════════════════════════ -->
    <div
      data-narrative-layer="2"
      class="absolute inset-0 h-full w-full transition-opacity duration-300 ease-in-out opacity-0 z-0 pointer-events-none"
    >
      <img
        src={gobekliImage}
        alt="Pilar 43 de Göbekli Tepe con bajorrelieves de buitre, escorpión e ibis"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-center"
      />
      <!-- Overlay negro bg-black/60 + viñeta Dark Academia -->
      <div class="absolute inset-0 bg-black/60 bg-[radial-gradient(circle_at_center,transparent_15%,rgba(0,0,0,0.75)_100%)]"></div>

      <div class="relative z-10 flex h-full w-full flex-col items-center justify-center px-6 text-center">
        <span class="mb-5 font-mono text-[10px] sm:text-xs uppercase tracking-[0.35em] text-amber-400">
          Acto III · Anatolia · 9600 a. C.
        </span>
        <h2 class="max-w-4xl font-serif text-4xl sm:text-5xl md:text-6xl font-normal leading-[1.12] tracking-tight text-stone-200 drop-shadow-[0_4px_24px_rgba(0,0,0,0.95)]">
          “El rompecabezas original.”
        </h2>

        <div class="mt-9 sm:mt-11">
          <a
            href={ctaHref}
            class="group inline-flex items-center gap-3 rounded-full bg-[#EFEBE3] px-8 py-4 font-sans text-xs sm:text-sm font-bold uppercase tracking-[0.18em] text-[#09090b] shadow-[0_10px_35px_rgba(0,0,0,0.85)] transition-all duration-300 hover:bg-white hover:scale-105 active:scale-95"
          >
            <span>{ctaLabel}</span>
            <svg
              class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
               fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Indicador minimalista de progreso lateral/inferior (3 pasos) -->
    <div class="pointer-events-none absolute bottom-8 left-1/2 z-20 flex -translate-x-1/2 items-center gap-3">
      <span data-narrative-dot="0" class="h-1.5 w-8 rounded-full bg-stone-200 transition-all duration-300"></span>
      <span data-narrative-dot="1" class="h-1.5 w-2.5 rounded-full bg-stone-200/30 transition-all duration-300"></span>
      <span data-narrative-dot="2" class="h-1.5 w-2.5 rounded-full bg-stone-200/30 transition-all duration-300"></span>
    </div>
  </div>
</section>

<script>
  function initScrollNarrative() {
    const sections = document.querySelectorAll<HTMLElement>('[data-scroll-narrative]');
    if (!sections.length) return;

    sections.forEach((section) => {
      // Evitar doble binding en navegaciones de Astro
      if (section.dataset.bound === 'true') return;
      section.dataset.bound = 'true';

      const layers = section.querySelectorAll<HTMLElement>('[data-narrative-layer]');
      const dots = section.querySelectorAll<HTMLElement>('[data-narrative-dot]');
      if (layers.length < 3) return;

      let activeStep = 0;
      let ticking = false;

      const setStep = (nextStep: number) => {
        if (nextStep === activeStep) return;
        activeStep = nextStep;

        layers.forEach((layer, idx) => {
          if (idx === activeStep) {
            layer.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
            layer.classList.add('opacity-100', 'z-10', 'pointer-events-auto');
          } else {
            layer.classList.remove('opacity-100', 'z-10', 'pointer-events-auto');
            layer.classList.add('opacity-0', 'z-0', 'pointer-events-none');
          }
        });

        dots.forEach((dot, idx) => {
          if (idx === activeStep) {
            dot.classList.remove('w-2.5', 'bg-stone-200/30');
            dot.classList.add('w-8', 'bg-stone-200');
          } else {
            dot.classList.remove('w-8', 'bg-stone-200');
            dot.classList.add('w-2.5', 'bg-stone-200/30');
          }
        });
      };

      const updateScrollProgress = () => {
        const rect = section.getBoundingClientRect();
        const scrollableDistance = section.offsetHeight - window.innerHeight;

        if (scrollableDistance <= 0) {
          ticking = false;
          return;
        }

        // Progreso normalizado de 0 a 100%
        const scrolled = -rect.top;
        const progress = Math.max(0, Math.min(100, (scrolled / scrollableDistance) * 100));

        // 0-33%: Capa 1 | 33-66%: Capa 2 | 66-100%: Capa 3
        let targetStep = 0;
        if (progress >= 66) {
          targetStep = 2;
        } else if (progress >= 33) {
          targetStep = 1;
        }

        setStep(targetStep);
        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(updateScrollProgress);
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updateScrollProgress();
    });
  }

  document.addEventListener('DOMContentLoaded', initScrollNarrative);
  document.addEventListener('astro:page-load', initScrollNarrative);
</script>

