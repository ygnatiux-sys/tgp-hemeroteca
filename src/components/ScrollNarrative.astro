---
/**
 * ScrollNarrative.astro
 * Sticky Scroll Narrative de 3 pasos a pantalla completa.
 * Estilo editorial de alta gama (National Geographic / Apple / The Great Puzzle).
 * Integración con GSAP para transiciones cinemáticas, encuadre despejado y autoplay fluido.
 */

interface Step {
  id: string;
  badge?: string;
  image: string;
  alt: string;
  text: string;
  ctaText?: string;
  ctaHref?: string;
  imagePosition?: string;
}

interface Props {
  steps?: Step[];
  className?: string;
  autoplayDuration?: number; // En milisegundos, default 3500ms
}

const defaultSteps: Step[] = [
  {
    id: "step-1",
    badge: "CAPÍTULO I · MESOAMÉRICA",
    image: "/images/megalitos/olmeca.jpg",
    alt: "Cabeza Olmeca colosal sobre fondo oscuro",
    text: "Un mismo lenguaje, continentes separados por océanos.",
    imagePosition: "center 24%",
  },
  {
    id: "step-2",
    badge: "CAPÍTULO II · RAPA NUI",
    image: "/images/megalitos/moai.jpg",
    alt: "Moái monolítico recortado contra el océano",
    text: "La misma obsesión monolítica.",
    imagePosition: "center 30%",
  },
  {
    id: "step-3",
    badge: "CAPÍTULO III · ANATOLIA",
    image: "/images/megalitos/gobekli-tepe.jpg",
    alt: "Pilar megalítico grabado en Göbekli Tepe",
    text: "El rompecabezas original.",
    ctaText: "Explorar el Dossier Megalítico",
    ctaHref: "/colecciones/arqueosemiotica/",
    imagePosition: "center 28%",
  },
];

const { steps = defaultSteps, className = "", autoplayDuration = 3500 } = Astro.props;
---

<section
  id="scroll-narrative-container"
  class={`relative w-full h-[300vh] bg-black ${className}`}
  data-scroll-narrative
  data-autoplay={autoplayDuration}
>
  {/* Contenedor Sticky a Pantalla Completa */}
  <div class="sticky top-0 h-screen w-full overflow-hidden bg-black select-none">

    {/* ══════════════════════════════════════════════════════════════════════
         PANTALLA PREVIA CINEMÁTICA: 'AMERICA SECRETS' (ESTILO APERTURA DE PELÍCULA)
    ══════════════════════════════════════════════════════════════════════ */}
    <div
      class="narrative-intro-overlay absolute inset-0 z-35 flex items-center justify-center pointer-events-auto px-4 bg-[#0c0e0b]/92 backdrop-blur-md"
    >
      {/* Fondo difuminado parcial verde musgo levemente fosfóreo */}
      <div class="america-moss-aura absolute inset-0 pointer-events-none" aria-hidden="true"></div>

      <div class="narrative-intro-box relative z-10 flex flex-col items-center text-center max-w-6xl">
        <span class="narrative-intro-badge inline-block mb-3 sm:mb-4 font-mono text-[9.5px] sm:text-[11px] tracking-[0.4em] uppercase text-[#BDEBB8] py-1 px-4 rounded-full border border-[#72D468]/35 bg-[#142013]/70 backdrop-blur-md shadow-[0_0_20px_rgba(114,212,104,0.2)] opacity-0">
          Colección Destacada · Archivo Monolítico
        </span>

        <h1 class="narrative-intro-title font-fraunces font-black uppercase text-[clamp(1.8rem,5.2vw,5.4rem)] leading-[0.9] tracking-[-0.01em] select-none opacity-0">
          <span class="america-destacado">AMÉRICA</span>
          <span class="secrets-lithic block sm:inline sm:ml-4">SECRETS</span>
        </h1>

        <p class="narrative-intro-sub mt-4 sm:mt-6 font-mono text-[10px] sm:text-[12px] tracking-[0.32em] uppercase text-[#D2C3B0] max-w-2xl opacity-0">
          La misma obsesión monolítica · Tres continentes separados por océanos
        </p>
      </div>
    </div>

    {/* Capas narrativas superpuestas */}
    {steps.map((step, index) => (
      <div
        class={`narrative-layer absolute inset-0 w-full h-full flex flex-col items-center justify-end pb-2 sm:pb-3 md:pb-4 px-4 sm:px-8 ${index === 0 ? "opacity-100 pointer-events-auto" : "opacity-0 pointer-events-none"}`}
        data-step-index={index}
      >
        {/* Imagen de fondo nítida y brillante con encuadre elevado para ver el sujeto completo */}
        <img
          src={step.image}
          alt={step.alt}
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
          class="narrative-img absolute inset-0 w-full h-full object-cover filter brightness-105 contrast-105 will-change-transform origin-center"
          style={`object-position: ${step.imagePosition || "center 28%"};`}
        />

        {/* Gradiente ceñido y ultracompacto estrictamente al pie de la pantalla */}
        <div class="absolute inset-x-0 bottom-0 h-20 sm:h-24 md:h-28 bg-linear-to-t from-black/90 via-black/40 to-transparent pointer-events-none" />

        {/* Contenido textual anclado estrictamente en la base inferior */}
        <div class="narrative-content relative z-10 max-w-5xl mx-auto text-center flex flex-col items-center gap-1.5 sm:gap-2 mb-0">
          {step.badge && (
            <span class="inline-block font-metadata text-[9px] sm:text-[10px] tracking-[0.3em] uppercase text-stone-200 font-medium py-0.5 px-2.5 rounded-full border border-white/20 bg-black/50 backdrop-blur-md">
              {step.badge}
            </span>
          )}

          <h2 class="font-serif text-stone-100 text-xl sm:text-2xl md:text-3xl lg:text-4xl leading-tight tracking-tight drop-shadow-[0_2px_16px_rgba(0,0,0,0.95)] max-w-4xl lg:max-w-5xl text-balance">
            {step.text}
          </h2>

          {step.ctaText && (
            <div class="pt-1">
              <a
                href={step.ctaHref || "#"}
                class="group relative inline-flex items-center gap-2.5 px-5 sm:px-7 py-2 rounded-full bg-stone-100 text-stone-950 font-metadata text-[11px] font-bold uppercase tracking-[0.2em] shadow-[0_0_20px_rgba(255,255,255,0.2)] hover:bg-white hover:scale-[1.02] active:scale-95 transition-all duration-300 pointer-events-auto cursor-pointer"
              >
                <span>{step.ctaText}</span>
                <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
              </a>
            </div>
          )}
        </div>
      </div>
    ))}

  </div>
</section>

<script>
  import { gsap } from "gsap";

  function setupScrollNarrative() {
    const container = document.getElementById("scroll-narrative-container");
    if (!container) return;

    const layers = container.querySelectorAll<HTMLElement>(".narrative-layer");
    const totalSteps = layers.length;
    if (totalSteps === 0) return;

    const introOverlay = container.querySelector<HTMLElement>(".narrative-intro-overlay");
    const introTitle = container.querySelector<HTMLElement>(".narrative-intro-title");
    const introBadge = container.querySelector<HTMLElement>(".narrative-intro-badge");
    const introSub = container.querySelector<HTMLElement>(".narrative-intro-sub");

    const autoDurationAttr = container.getAttribute("data-autoplay");
    const autoplayDuration = autoDurationAttr ? parseInt(autoDurationAttr, 10) : 3500;

    let currentIndex = 0;
    let autoTimer: any = null;
    let isVisible = false;
    let introPlayed = false;
    let introTl: gsap.core.Timeline | null = null;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Reproducción de la apertura cinematográfica 'AMERICA SECRETS'
    function playIntro() {
      if (!introOverlay || !introTitle || introPlayed) return;
      introPlayed = true;

      if (reduceMotion) {
        introOverlay.style.opacity = "0";
        introOverlay.classList.remove("pointer-events-auto");
        introOverlay.classList.add("pointer-events-none");
        startAutoTimer();
        return;
      }

      introTl = gsap.timeline({
        onComplete: () => {
          gsap.to(introOverlay, {
            opacity: 0,
            duration: 0.85,
            ease: "power2.inOut",
            onComplete: () => {
              introOverlay.classList.remove("pointer-events-auto");
              introOverlay.classList.add("pointer-events-none");
              startAutoTimer();
            }
          });
        }
      });

      // Revelación cinemática con Fraunces Impact
      introTl
        .to([introBadge, introSub], { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" })
        .fromTo(
          introTitle,
          { opacity: 0, scale: 1.08, filter: "blur(8px)" },
          { opacity: 1, scale: 1, filter: "blur(0px)", duration: 1.25, ease: "power3.out" },
          "-=0.3"
        )
        .to({}, { duration: 1.4 }); // Contemplación del título de película
    }

    // Transición cinemática orquestada con GSAP
    function goToStep(targetIndex: number) {
      if (targetIndex < 0 || targetIndex >= totalSteps) return;
      if (targetIndex === currentIndex) return;

      const prevIndex = currentIndex;
      currentIndex = targetIndex;

      const prevLayer = layers[prevIndex];
      const nextLayer = layers[targetIndex];
      const prevImg = prevLayer?.querySelector<HTMLElement>(".narrative-img");
      const nextImg = nextLayer?.querySelector<HTMLElement>(".narrative-img");
      const prevContent = prevLayer?.querySelector<HTMLElement>(".narrative-content");
      const nextContent = nextLayer?.querySelector<HTMLElement>(".narrative-content");

      // 1. Desvanecer capa saliente
      if (prevLayer && prevLayer !== nextLayer) {
        gsap.killTweensOf([prevLayer, prevImg, prevContent]);
        gsap.to(prevLayer, {
          opacity: 0,
          duration: 0.55,
          ease: "power2.inOut",
          onComplete: () => {
            prevLayer.classList.remove("pointer-events-auto");
            prevLayer.classList.add("pointer-events-none");
          }
        });
        if (prevContent) {
          gsap.to(prevContent, {
            y: -18,
            opacity: 0,
            duration: 0.45,
            ease: "power2.in"
          });
        }
      }

      // 2. Animar entrada cinemática de la capa siguiente
      if (nextLayer) {
        gsap.killTweensOf([nextLayer, nextImg, nextContent]);
        nextLayer.classList.remove("pointer-events-none");
        nextLayer.classList.add("pointer-events-auto");

        gsap.fromTo(nextLayer, 
          { opacity: 0 }, 
          { opacity: 1, duration: 0.6, ease: "power2.out" }
        );

        if (nextImg) {
          gsap.fromTo(nextImg, 
            { scale: 1.05 }, 
            { scale: 1.0, duration: 0.85, ease: "power2.out" }
          );
        }

        if (nextContent) {
          gsap.fromTo(nextContent, 
            { y: 22, opacity: 0 }, 
            { y: 0, opacity: 1, duration: 0.6, ease: "power3.out", delay: 0.08 }
          );
        }
      }
    }

    // Temporizador de avance automático
    function startAutoTimer() {
      stopAutoTimer();
      autoTimer = setInterval(() => {
        if (isVisible) {
          const next = (currentIndex + 1) % totalSteps;
          goToStep(next);
        }
      }, autoplayDuration);
    }

    function stopAutoTimer() {
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    function resetAutoTimer() {
      startAutoTimer();
    }

    // Control de scroll sincronizado
    let ticking = false;
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          ticking = false;
          if (!container) return;
          const rect = container.getBoundingClientRect();
          const scrollableDistance = rect.height - window.innerHeight;
          if (scrollableDistance <= 0) return;

          // Si el usuario hace scroll directo, cerramos el intro overlay si seguía abierto
          if (!introPlayed && introOverlay && rect.top <= 0) {
            introPlayed = true;
            introTl?.kill();
            gsap.to(introOverlay, {
              opacity: 0,
              duration: 0.4,
              ease: "power2.out",
              onComplete: () => {
                introOverlay.classList.remove("pointer-events-auto");
                introOverlay.classList.add("pointer-events-none");
              }
            });
          }

          // Solo si el usuario se encuentra dentro del contenedor de 300vh
          if (rect.top <= 0 && rect.bottom >= window.innerHeight) {
            const rawProgress = -rect.top / scrollableDistance;
            const progress = Math.min(Math.max(rawProgress, 0), 1);
            const slice = 1 / totalSteps;
            const target = Math.min(Math.floor(progress / slice), totalSteps - 1);
            if (target !== currentIndex) {
              goToStep(target);
              resetAutoTimer();
            }
          }
        });
        ticking = true;
      }
    }

    // Pausar autoplay o detonar intro cuando la sección sea visible
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            if (!introPlayed) {
              playIntro();
            } else {
              startAutoTimer();
            }
          } else {
            stopAutoTimer();
          }
        });
      },
      { threshold: 0.15 }
    );
    observer.observe(container);

    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // Inicialización compatible con SPA y recarga estándar
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupScrollNarrative);
  } else {
    setupScrollNarrative();
  }
  document.addEventListener("astro:page-load", setupScrollNarrative);
</script>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,900,0,1&display=swap"
/>

<style>
  /* Tipografía FRAUNCES IMPACT para AMÉRICA SECRETS */
  .narrative-intro-title {
    font-family: 'Fraunces', serif;
    font-variation-settings: 'opsz' 144, 'SOFT' 0, 'WONK' 1;
  }

  /* AMÉRICA: Título de película monumental lítico en terracota y ocre ardiente */
  .america-destacado {
    background: linear-gradient(
      180deg,
      #fce2c2 0%,
      #f09b62 25%,
      #c55228 58%,
      #782710 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter: drop-shadow(0 4px 0 #4a1508)
      drop-shadow(0 14px 35px rgba(0, 0, 0, 0.98))
      drop-shadow(0 0 55px rgba(197, 82, 40, 0.45));
  }

  /* SECRETS: Caliza ocre tallada */
  .secrets-lithic {
    background: linear-gradient(
      180deg,
      #f7eedf 0%,
      #dfc394 32%,
      #b89257 65%,
      #6c512a 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter: drop-shadow(0 4px 0 #312310)
      drop-shadow(0 14px 35px rgba(0, 0, 0, 0.98))
      drop-shadow(0 0 40px rgba(217, 185, 134, 0.3));
  }

  /* Fondo difuminado parcial verde musgo levemente fosfóreo */
  .america-moss-aura {
    background: radial-gradient(
      ellipse at 50% 50%,
      rgba(114, 212, 104, 0.24) 0%,
      rgba(52, 110, 46, 0.38) 32%,
      rgba(18, 38, 16, 0.6) 65%,
      transparent 85%
    );
    filter: blur(55px);
    mix-blend-mode: screen;
  }
</style>
