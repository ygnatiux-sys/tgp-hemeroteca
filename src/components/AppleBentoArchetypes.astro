---
/**
 * AppleBentoArchetypes.astro
 * Bento Ultra-Wide "Tornasol Histórico" (Apple TV Style).
 * Incorpora:
 * - Parche anti-bordes cuadrados con máscara radial elíptica [mask-image:radial-gradient(ellipse_65%_75%_at_50%_45%,black_40%,transparent_95%)].
 * - Sombra direccional hacia la izquierda drop-shadow-[-20px_15px_30px_rgba(0,0,0,0.75)].
 * - Filtro cálido de unificación contrast-115 sepia-[0.12].
 * - Animación GSAP "Magnetic Convergence + Dolly Zoom" en bucle cinemático.
 */

interface ArchetypeFigure {
  src: string;
  alt: string;
  title?: string;
  classNames: string;
}

interface Props {
  badgeLabel?: string;
  tagline?: string;
  subtext?: string;
  ctaHref?: string;
  ctaLabel?: string;
  figures?: ArchetypeFigure[];
}

const {
  badgeLabel = "Archivo Vivo",
  tagline = "Cada época. Sin fragmentos perdidos. Ahora en el mapa.",
  subtext = "Acceso libre y sin registro. Más de 50 investigaciones resguardadas.",
  ctaHref = "/colecciones/",
  ctaLabel = "Explorar las 14 colecciones",
  figures,
} = Astro.props;

// Trío Cinematográfico para la Convergencia Magnética (Recortes transparentes separados en 3 carriles)
const defaultFigures: ArchetypeFigure[] = [
  // 0. Fondo lejano detrás (Pazuzu asomando tras hombro derecho de Venus)
  {
    src: "https://storage.thegreatpuzzleproject.com/busts/busto-pazuzu.webp",
    alt: "Pazuzu Bronce Asirio",
    title: "Pazuzu",
    classNames: "busto-layer absolute right-[2%] sm:right-[3%] bottom-[6%] h-[74%] w-auto object-contain z-[1] opacity-80 brightness-90 contrast-115 [mask-image:radial-gradient(ellipse_70%_80%_at_50%_50%,black_50%,transparent_95%)] [-webkit-mask-image:radial-gradient(ellipse_70%_80%_at_50%_50%,black_50%,transparent_95%)] filter sepia-[0.15] pointer-events-none",
  },
  // 1. Plano medio izquierda (Cabeza Colosal Olmeca centrada en su carril)
  {
    src: "https://storage.thegreatpuzzleproject.com/busts/busto-olmeca.webp",
    alt: "Cabeza Colosal Olmeca",
    title: "Megalito Olmeca",
    classNames: "busto-layer absolute right-[45%] sm:right-[47%] bottom-[6%] h-[72%] w-auto object-contain z-[2] brightness-90 contrast-115 drop-shadow-[-20px_15px_30px_rgba(0,0,0,0.85)] [mask-image:radial-gradient(ellipse_80%_85%_at_50%_50%,black_60%,transparent_98%)] [-webkit-mask-image:radial-gradient(ellipse_80%_85%_at_50%_50%,black_60%,transparent_98%)] filter sepia-[0.12] pointer-events-none",
  },
  // 2. Primer plano centro-derecha (Venus protagonista, 100% sólida y escala calibrada)
  {
    src: "https://storage.thegreatpuzzleproject.com/busts/busto-venus.webp",
    alt: "Estatua Clásica de Venus · British Museum",
    title: "Venus",
    classNames: "busto-layer absolute right-[10%] sm:right-[12%] bottom-[-5%] h-[92%] sm:h-[95%] w-auto object-contain z-[3] opacity-100 brightness-95 contrast-115 drop-shadow-[-25px_18px_35px_rgba(0,0,0,0.9)] filter sepia-[0.08] pointer-events-none",
  },
];

const layers = figures && figures.length > 0 ? figures : defaultFigures;
---

<section class="w-full px-4 sm:px-6 md:px-10 py-8 md:py-12 bg-transparent">
  <!-- BENTO ULTRA-WIDE TORNASOL (Pastilla panorámica con isolate) -->
  <div
    id="bento-tornasol-arquetipos"
    class="relative isolate w-full max-w-400 h-100 md:h-105 mx-auto rounded-[28px] overflow-hidden bg-[#08090c] border border-white/10 shadow-[0_24px_60px_-15px_rgba(0,0,0,0.9)] select-none group/tornasol"
  >
    {/* ── 1. FONDO TORNASOLADO HISTÓRICO (2 TONOS EN CHOQUE DIAGONAL + GLOW) ── */}
    {/* Base diagonal: Negro/Azul Pizarra a la izquierda -> Bronce/Ámbar a la derecha */}
    <div
      class="pointer-events-none absolute inset-0 z-0 bg-[linear-gradient(108deg,#07080b_0%,#0f1523_38%,#5a2818_72%,#b86530_92%,#d89c4a_100%)]"
    />

    {/* Luz atmosférica cálida (Glow reactivo GSAP) detrás de las cabezas */}
    <div
      class="bento-glow pointer-events-none absolute right-[6%] top-[-10%] w-[58%] h-[120%] z-0 bg-[radial-gradient(circle_at_60%_45%,rgba(235,145,75,0.45)_0%,rgba(140,45,30,0.25)_45%,transparent_75%)] blur-2xl transform origin-center"
    />

    {/* Filtro sutil de viñeta lateral izquierda para lectura nítida */}
    <div
      class="pointer-events-none absolute inset-0 z-0 bg-[linear-gradient(90deg,rgba(7,8,11,0.94)_0%,rgba(7,8,11,0.65)_36%,transparent_62%)]"
    />

    {/* ── 2. ESTÁTUAS CON MÁSCARA RADIAL ELÍPTICA (SIN BORDES CUADRADOS) ── */}
    <div class="pointer-events-none select-none absolute inset-y-0 right-0 w-[74%] sm:w-[70%] z-10 overflow-hidden">
      {layers.map((fig) => (
        <img
          src={fig.src}
          alt={fig.alt}
          loading="eager"
          decoding="async"
          class={fig.classNames}
        />
      ))}
    </div>

    {/* ── 3. BLOQUE DE TEXTO Y CTA A LA IZQUIERDA (SANS MODERNA APPLE STYLE) ── */}
    <div class="relative z-20 h-full w-full md:w-[46%] lg:w-[42%] pl-6 sm:pl-10 md:pl-14 pr-6 flex flex-col justify-center items-start pointer-events-auto">
      
      {/* Identificador superior estilo Apple TV */}
      <div class="flex items-center gap-2.5 mb-3.5">
        <span class="text-white font-bold tracking-tight text-xl md:text-2xl font-sans">
          TGP
        </span>
        <span class="text-[11px] uppercase tracking-[0.2em] font-mono px-2.5 py-0.5 rounded-full bg-white/10 text-amber-300/90 border border-white/15 backdrop-blur-md">
          {badgeLabel}
        </span>
      </div>

      {/* Tagline Sans-Serif audaz y compacta */}
      <h2 class="font-sans text-2xl sm:text-3xl md:text-[34px] font-bold text-white leading-[1.14] tracking-[-0.02em] mb-6 max-w-sm sm:max-w-md">
        {tagline}
      </h2>

      {/* Botón Píldora Blanco (Estilo Apple TV Accept Button) */}
      <a
        href={ctaHref}
        class="px-8 py-3.5 rounded-full bg-[#f5f5f7] hover:bg-white text-[#1d1d1f] font-sans text-xs sm:text-sm font-semibold tracking-tight transition-all duration-300 shadow-xl hover:scale-[1.03] active:scale-[0.98] inline-flex items-center gap-2 group/btn"
      >
        <span>{ctaLabel}</span>
        <span class="text-xs transition-transform group-hover/btn:translate-x-0.5">→</span>
      </a>

      {/* Micro-copy sutil debajo del CTA */}
      <p class="font-sans text-xs text-white/55 mt-3.5 tracking-normal">
        {subtext}
      </p>

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  let activeTl: gsap.core.Timeline | null = null;

  function initBentoTornasol() {
    const bento = document.getElementById('bento-tornasol-arquetipos');
    if (!bento) return;

    if (activeTl) {
      activeTl.kill();
      activeTl = null;
    }

    // Seleccionamos las capas de arquetipos y el glow de fondo
    const layers = gsap.utils.toArray<HTMLElement>('#bento-tornasol-arquetipos .busto-layer');
    const glow = bento.querySelector<HTMLElement>('.bento-glow');
    if (layers.length < 3) return;

    // Timeline en loop con estética "Trailer Cut" (Rápido al juntarse -> Tensión Dolly Zoom -> Corte)
    const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.2 });
    activeTl = tl;

    // 1. SNAP-IN: Vienen separados y se asientan magnéticamente en sus 3 carriles
    tl.fromTo(layers[0], // Fondo lejano detrás (Pazuzu)
      { x: 35, scale: 1.05, opacity: 0, filter: 'blur(4px)' },
      { x: 0, scale: 1, opacity: 0.8, filter: 'blur(0px)', duration: 0.55, ease: 'expo.out' }, 0
    )
    .fromTo(layers[1], // Plano medio izquierda (Cabeza Olmeca - entra desde la izquierda a su carril)
      { x: -35, scale: 0.94, opacity: 0 },
      { x: 0, scale: 1, opacity: 0.95, duration: 0.6, ease: 'expo.out' }, 0.06
    )
    .fromTo(layers[2], // Primer plano centro-derecha (Venus - entra a su carril protagonista)
      { x: 35, scale: 1.05, opacity: 0 },
      { x: 0, scale: 1, opacity: 1, duration: 0.65, ease: 'expo.out' }, 0.12
    )

    // 2. TENSIÓN MAGNÉTICA (Recorrido x calibrado para respirar sin taparse)
    .to(layers[1], { x: 10, scale: 0.98, duration: 2.4, ease: 'sine.inOut' }, 0.65)
    .to(layers[2], { x: -10, scale: 1.02, duration: 2.4, ease: 'sine.inOut' }, 0.65)
    .to(layers[0], { x: -6, scale: 1.02, duration: 2.4, ease: 'sine.inOut' }, 0.65)
    .fromTo(glow, 
      { scale: 0.92, opacity: 0.5, x: 15 }, 
      { scale: 1.2, opacity: 0.95, x: -10, duration: 2.4, ease: 'sine.inOut' }, 0.65
    )

    // 3. WHIP-OUT (Salida rápida en 0.35s hacia el centro antes de reiniciar el ciclo)
    .to(layers, {
      x: (i: number) => (i === 1 ? 25 : -25), // Cruce ágil sin brusquedad
      scale: 1.04,
      opacity: 0,
      filter: 'blur(4px)',
      duration: 0.35,
      stagger: 0.03,
      ease: 'power3.in'
    }, 3.05);

    // Pausa en hover para contemplar la composición fija si el usuario interactúa
    bento.addEventListener('mouseenter', () => tl.pause());
    bento.addEventListener('mouseleave', () => tl.play());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBentoTornasol);
  } else {
    initBentoTornasol();
  }
  document.addEventListener('astro:page-load', initBentoTornasol);
</script>
