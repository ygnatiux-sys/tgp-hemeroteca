---
/**
 * HeroSpotifyColecciones.astro
 * Hero full-bleed estilo Spotify: texto + 2 botones pill a la izquierda,
 * grilla inclinada de 12 portadas (4 col × 3 filas) a la derecha, cortada por arriba y derecha.
 * Todo escala con --u (1u = 1vw en desktop) para copiar las proporciones del sample.
 * Fuente: Outfit (ya cargada en Layout.astro).
 */

export interface HeroTile {
  src: string;
  alt?: string;
  href?: string;
}

interface Props {
  tiles: HeroTile[];
  titulo?: string;
  bajada?: string;
  ctaPrimary?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  letraChica?: string[];
  isH1?: boolean;
}

const {
  tiles = [],
  titulo = "Explorá sin límites. Recorré las colecciones del archivo TGP.",
  bajada = "Ensayos, arquetipos y georreferencias en un solo mapa. Leé cuando quieras.",
  ctaPrimary = { label: "Explorar colecciones", href: "#sec-col-vertical" },
  ctaSecondary = { label: "Ver todo el archivo", href: "/archivo/" },
  letraChica = [
    "El archivo crece con cada ensayo publicado.",
    "Acceso abierto, sin registro. Se aplican Términos.",
  ],
  isH1 = false,
} = Astro.props;

const grid = tiles.slice(0, 12);
---

{grid.length >= 6 && (
  <section class="hs-root" aria-label="Explorá las colecciones del archivo">
    <div class="hs-glow" aria-hidden="true"></div>

    <div class="hs-copy">
      {isH1 ? (
        <h1 class="hs-title">{titulo}</h1>
      ) : (
        <h2 class="hs-title">{titulo}</h2>
      )}
      <p class="hs-sub">{bajada}</p>

      <div class="hs-actions">
        <a class="hs-btn hs-btn--primary" href={ctaPrimary.href}>{ctaPrimary.label}</a>
        <a class="hs-btn hs-btn--ghost" href={ctaSecondary.href}>{ctaSecondary.label}</a>
      </div>

      <p class="hs-fine">
        {letraChica.map((line) => (<span>{line}</span>))}
      </p>
    </div>

    <div class="hs-art" aria-hidden="false">
      <div class="hs-grid">
        {grid.map((t, i) => (
          <a class="hs-tile" href={t.href || "#"} aria-label={t.alt || `Colección ${i + 1}`} tabindex={t.href ? 0 : -1}>
            <img src={t.src} alt={t.alt || ""} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .hs-root {
    --u: 1vw;
    --hs-accent: var(--color-rust-orange, #e07a5f);
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: max(380px, calc(37.6 * var(--u)));
    overflow: hidden;
    background: #070709;
    isolation: isolate;
    font-family: "Outfit", "Plus Jakarta Sans", sans-serif;
    color: #fff;
  }

  /* Resplandor arriba-izquierda (en Spotify es verde; aquí rust-orange) */
  .hs-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 62% 78% at 0% 0%, rgba(224, 122, 95, 0.55) 0%, rgba(224, 122, 95, 0.18) 38%, transparent 72%),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.0) 70%, rgba(0, 0, 0, 0.35) 100%);
  }

  /* ── TEXTO ── */
  .hs-copy {
    position: relative;
    z-index: 2;
    max-width: calc(52 * var(--u));
    padding: calc(5 * var(--u)) 0 calc(5 * var(--u)) calc(6.3 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hs-title {
    margin: 0;
    font-weight: 700;
    font-size: clamp(28px, calc(4.1 * var(--u)), 64px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    max-width: 11.5em;
    text-wrap: balance;
  }
  .hs-sub {
    margin: calc(1.6 * var(--u)) 0 0;
    font-weight: 400;
    font-size: clamp(13px, calc(1.4 * var(--u)), 19px);
    line-height: 1.4;
    color: #fff;
  }
  .hs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: calc(1.1 * var(--u));
    margin-top: calc(3.2 * var(--u));
  }
  .hs-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 calc(2.6 * var(--u));
    border-radius: 999px;
    font-weight: 700;
    font-size: clamp(13px, calc(1.4 * var(--u)), 17px);
    letter-spacing: 0;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }
  .hs-btn:hover { transform: scale(1.04); }
  .hs-btn:active { transform: scale(0.98); }
  .hs-btn--primary {
    background: var(--hs-accent);
    color: #0b0b0b;
    border: 1px solid var(--hs-accent);
  }
  .hs-btn--primary:hover { background: #ee8c72; border-color: #ee8c72; }
  .hs-btn--ghost {
    background: #000;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.55);
  }
  .hs-btn--ghost:hover { border-color: #fff; }

  .hs-fine {
    margin: calc(3.2 * var(--u)) 0 0;
    max-width: calc(46 * var(--u));
    font-size: clamp(10.5px, calc(1.05 * var(--u)), 13px);
    line-height: 1.5;
    color: #a7a7a7;
  }
  .hs-fine span { display: block; }

  /* ── GRILLA INCLINADA (-20°) ── */
  .hs-art {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .hs-grid {
    position: absolute;
    left: calc(46 * var(--u));
    top: calc(10 * var(--u));
    display: grid;
    grid-template-columns: repeat(4, calc(13.5 * var(--u)));
    gap: var(--u);
    transform: rotate(-20deg);
    transform-origin: 0 0;
  }
  .hs-tile {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: calc(0.9 * var(--u));
    overflow: hidden;
    background: #14151a;
    box-shadow: 0 calc(1.2 * var(--u)) calc(2.4 * var(--u)) rgba(0, 0, 0, 0.45);
    pointer-events: auto;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }
  .hs-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hs-tile:hover {
    transform: translateY(calc(-0.5 * var(--u))) scale(1.03);
    box-shadow: 0 calc(1.8 * var(--u)) calc(3.2 * var(--u)) rgba(0, 0, 0, 0.6);
    z-index: 3;
  }

  /* ── MÓVIL: texto arriba, grilla abajo ── */
  @media (max-width: 768px) {
    .hs-root {
      --u: 1.8vw;
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
    }
    .hs-copy {
      max-width: none;
      padding: calc(4 * var(--u)) calc(3.4 * var(--u)) 0;
    }
    .hs-title { max-width: none; }
    .hs-actions { margin-top: calc(2.6 * var(--u)); }
    .hs-btn { min-height: 46px; padding: 0 calc(3 * var(--u)); }
    .hs-fine { margin-top: calc(2.4 * var(--u)); max-width: none; }
    .hs-art {
      position: relative;
      inset: auto;
      height: calc(40 * var(--u));
      margin-top: calc(1.5 * var(--u));
    }
    .hs-grid { left: calc(20 * var(--u)); top: calc(5 * var(--u)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hs-btn, .hs-tile { transition: none; }
  }
</style>
