---
/**
 * src/components/TgpHeroTriptych.astro
 *
 * Tríptico Editorial Asimétrico Cinemático (Estilo Apple TV+).
 * 
 * Arquitectura Visual:
 * - Panel Izquierdo: Brand Header Apple TV+ ('the great puzzle project' en Newsreader cursiva + kicker),
 *   H1 monumental en tipografías de impacto Extrabold por slide (League Spartan, Oswald, Syne, Cinzel),
 *   especificaciones técnicas [IMAX 70MM] [4K UHD], sinopsis fluida y botonera interactiva Apple TV.
 * - Panel Derecho: 3 tarjetas asimétricas en formato cuadrado (aspect-square) con escala escalonada,
 *   fondos de imagen nítidos, badges flotantes '01', '02', '03' en glassmorphism y rotulado de base.
 * - Fondo: Bokeh cinemático expandido en escala 1.25 con viñeta horizontal gradual y resplandor ambiente.
 * - GSAP: Transiciones atómicas limpias con display:none estricto para evitar solapamientos,
 *   indicadores inferiores interactivos y pausa en hover/touch.
 */
import { sanitizeImageUrl, isValidImageSrc } from '../lib/content-filter';

export interface TriptychPost {
  title: string;
  excerpt?: string;
  category?: string;
  img: string;
  href: string;
  date?: string;
}

export interface Panel {
  image: string;
  alt: string;
  title?: string;
  href?: string;
  category?: string;
  objectPosition?: string;
}

export interface SlideItem {
  kicker: string;
  title: string;
  tagLabel: string;
  subtitle: string;
  ctaText: string;
  ctaHref: string;
  fontH1: string;
  fontH2: string;
  badgeImax: string;
  techSpecs: string[];
  panels: [Panel, Panel, Panel];
}

interface Props {
  posts?: TriptychPost[];
  slides?: SlideItem[];
  kicker?: string;
  title?: string;
  tagLabel?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  panels?: [Panel, Panel, Panel];
}

const {
  posts,
  slides,
  kicker,
  title,
  tagLabel,
  subtitle,
  ctaText,
  ctaHref,
  panels
} = Astro.props;

// Cuatro combinaciones tipográficas exactas solicitadas para cada slide hero:
const FONT_PRESETS = [
  {
    fontH1: "font-['League_Spartan',sans-serif] font-black tracking-tighter uppercase",
    fontH2: "font-['Inter',sans-serif]",
    badgeImax: "IMAX 70MM",
    techSpecs: ["4K UHD", "COLOR RAW", "AUDIO ENSAYO"]
  },
  {
    fontH1: "font-['Oswald',sans-serif] font-bold tracking-tight uppercase",
    fontH2: "font-['Space_Mono',monospace]",
    badgeImax: "IMAX CINEMA",
    techSpecs: ["4K UHD", "RESONANCIA 432HZ", "CC"]
  },
  {
    fontH1: "font-['Syne',sans-serif] font-extrabold tracking-tight uppercase",
    fontH2: "font-['IBM_Plex_Mono',monospace]",
    badgeImax: "IMAX SCANNER",
    techSpecs: ["4K UHD", "GPR SCANNER", "ESTRATIGRAFÍA 3D"]
  },
  {
    fontH1: "font-['Cinzel',serif] font-black tracking-normal uppercase",
    fontH2: "font-['Plus_Jakarta_Sans',sans-serif]",
    badgeImax: "IMAX 70MM",
    techSpecs: ["4K UHD", "LIDAR 3D", "AD"]
  }
];

// Construcción dinámica de Slides a partir de Posts Reales en bloques de 3 en 3
let computedSlides: SlideItem[] = [];

if (posts && posts.length >= 3) {
  for (let i = 0; i < posts.length; i += 3) {
    const chunk = posts.slice(i, i + 3);
    if (chunk.length < 3) break;
    const p1 = chunk[0];
    const p2 = chunk[1];
    const p3 = chunk[2];
    const slideNumber = String(Math.floor(i / 3) + 1).padStart(2, '0');
    const preset = FONT_PRESETS[(Math.floor(i / 3)) % FONT_PRESETS.length];

    computedSlides.push({
      kicker: `${(p1.category || 'ARCHIVO TGP').toUpperCase()} // DOSSIER ${slideNumber}`,
      title: p1.title,
      tagLabel: p1.category || 'Investigación',
      subtitle: p1.excerpt ? p1.excerpt.replace(/[#*_`]/g, '').slice(0, 160) + '…' : 'Investigación profunda y análisis documental del acervo.',
      ctaText: 'Ver investigación',
      ctaHref: p1.href,
      fontH1: preset.fontH1,
      fontH2: preset.fontH2,
      badgeImax: preset.badgeImax,
      techSpecs: preset.techSpecs,
      panels: [
        {
          image: p1.img,
          alt: p1.title,
          title: p1.title,
          href: p1.href,
          category: p1.category,
          objectPosition: 'center 20%'
        },
        {
          image: p2.img,
          alt: p2.title,
          title: p2.title,
          href: p2.href,
          category: p2.category,
          objectPosition: 'center 25%'
        },
        {
          image: p3.img,
          alt: p3.title,
          title: p3.title,
          href: p3.href,
          category: p3.category,
          objectPosition: 'center 20%'
        }
      ]
    });
  }
}

// Fallback de respaldo con imágenes temáticas de historia/arqueología si no se pasan posts ni slides
const defaultSlides: SlideItem[] = [
  {
    kicker: "ARCHAEOSEMIOTICS // DOSSIER 01",
    title: "LA ARQUITECTURA DEL TIEMPO",
    tagLabel: "Memoria Material",
    subtitle: "Estratos líticos y signos rituales donde la civilización humana codificó el tiempo antes de la escritura.",
    ctaText: "Ver investigación",
    ctaHref: "/archivo/",
    fontH1: FONT_PRESETS[0].fontH1,
    fontH2: FONT_PRESETS[0].fontH2,
    badgeImax: FONT_PRESETS[0].badgeImax,
    techSpecs: FONT_PRESETS[0].techSpecs,
    panels: [
      {
        image: "https://storage.thegreatpuzzleproject.com/remotas/stepped-pyramid-of-djoser-at-saqqara.webp",
        alt: "Pirámide Escalonada de Saqqara",
        title: "Pirámide de Saqqara",
        category: "Arqueosemiótica",
        objectPosition: "center 20%"
      },
      {
        image: "https://storage.thegreatpuzzleproject.com/wikimedia/1790166100412-8c88f7a9.webp",
        alt: "La Pirámide Roja en Dahshur",
        title: "Pirámide Roja",
        category: "Ensayos Cinemáticos",
        objectPosition: "center 25%"
      },
      {
        image: "https://storage.thegreatpuzzleproject.com/alternativa/gunung-padang.jpg",
        alt: "Terrazas Megalíticas de Gunung Padang",
        title: "Gunung Padang",
        category: "Prehistoria",
        objectPosition: "center 20%"
      }
    ]
  },
  {
    kicker: "EPIGRAFÍA // DOSSIER 02",
    title: "EL ENIGMA DEL GRANITO ESPEJO",
    tagLabel: "Resonancia Lítica",
    subtitle: "Bloques ciclópeos y acústica hermética tallada en la roca viva para modular estados de conciencia.",
    ctaText: "Ver investigación",
    ctaHref: "/archivo/",
    fontH1: FONT_PRESETS[1].fontH1,
    fontH2: FONT_PRESETS[1].fontH2,
    badgeImax: FONT_PRESETS[1].badgeImax,
    techSpecs: FONT_PRESETS[1].techSpecs,
    panels: [
      {
        image: "https://storage.thegreatpuzzleproject.com/wikimedia/1790166100412-8c88f7a9.webp",
        alt: "Pirámide Roja de Dahshur",
        title: "Pirámide Roja",
        category: "Acústica Sagrada",
        objectPosition: "center 25%"
      },
      {
        image: "https://storage.thegreatpuzzleproject.com/remotas/yangshan-stele-quarry.webp",
        alt: "Cantera Imperial de Yangshan",
        title: "Monolitos de Yangshan",
        category: "Corte Mecanizado",
        objectPosition: "center 20%"
      },
      {
        image: "https://storage.thegreatpuzzleproject.com/remotas/stepped-pyramid-of-djoser-at-saqqara.webp",
        alt: "Pirámide Escalonada de Saqqara",
        title: "Pirámide de Saqqara",
        category: "Arqueosemiótica",
        objectPosition: "center 20%"
      }
    ]
  }
];

const allSlides: SlideItem[] = computedSlides.length > 0
  ? computedSlides
  : (slides && slides.length > 0 
      ? slides 
      : (title && panels 
          ? [{
              kicker: kicker || defaultSlides[0].kicker,
              title: title,
              tagLabel: tagLabel || defaultSlides[0].tagLabel,
              subtitle: subtitle || defaultSlides[0].subtitle,
              ctaText: ctaText || defaultSlides[0].ctaText,
              ctaHref: ctaHref || defaultSlides[0].ctaHref,
              fontH1: FONT_PRESETS[0].fontH1,
              fontH2: FONT_PRESETS[0].fontH2,
              badgeImax: FONT_PRESETS[0].badgeImax,
              techSpecs: FONT_PRESETS[0].techSpecs,
              panels: panels
            }]
          : defaultSlides));
---

<!-- Importación directa de respaldo por si el layout no ha recargado fuentes -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@700;800;900&family=Oswald:wght@600;700&family=Syne:wght@700;800&family=Cinzel:wght@700;800;900&display=swap" rel="stylesheet">

<section class="tgp-hero-triptych-container relative w-full h-[78vh] min-h-140 max-h-200 bg-[#07080a] text-white overflow-hidden rounded-3xl select-none shadow-[0_30px_90px_rgba(0,0,0,0.95)] border border-white/10 my-10">
  
  <!-- ═══════════════════════════════════════════════════════════════════
       1. CONTENEDOR DE FONDOS ATMOSFÉRICOS (BOKEH EXPANDIDO DE ALTA GAMA)
       ═══════════════════════════════════════════════════════════════════ -->
  <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
    {allSlides.map((slide, sIdx) => (
      <div 
        class={`triptych-bg-slide absolute inset-0 w-full h-full pointer-events-none transition-none ${sIdx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
        data-bg-slide={sIdx}
        style={sIdx === 0 ? 'display: block;' : 'display: none;'}
      >
        <img 
          src={sanitizeImageUrl(slide.panels[0].image) || slide.panels[0].image} 
          alt="" 
          aria-hidden="true"
          class="w-full h-full object-cover scale-125 blur-3xl opacity-35 brightness-75 saturate-125"
        />
        {/* Viñeta multidireccional Apple TV: Fundido suave de izquierda a derecha y base oscura */}
        <div class="absolute inset-0 bg-linear-to-r from-[#07080a] via-[#07080a]/80 via-45% to-transparent z-1"></div>
        <div class="absolute inset-0 bg-linear-to-t from-[#07080a] via-transparent to-transparent z-1"></div>
        {/* Glow cobrizo sutil superior */}
        <div class="absolute inset-0 z-1 pointer-events-none opacity-40 bg-[radial-gradient(circle_at_0%_0%,rgba(217,119,6,0.25)_0%,transparent_50%)]"></div>
      </div>
    ))}
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════
       2. CONTENEDOR DERECHO: 3 POSTS EN FORMATO CUADRADO PROPORCIONADO
       ═══════════════════════════════════════════════════════════════════ -->
  <div class="absolute inset-0 w-full h-full z-10 overflow-hidden pointer-events-none">
    {allSlides.map((slide, sIdx) => (
      <div 
        class={`triptych-cards-slide absolute inset-0 w-full h-full flex items-center justify-end px-6 sm:px-10 md:px-14 lg:px-16 pointer-events-none transition-none ${sIdx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
        data-cards-slide={sIdx}
        style={sIdx === 0 ? 'display: flex;' : 'display: none;'}
      >
        {/* Espacio izquierdo transparente para dejar paso libre al texto editorial */}
        <div class="hidden md:block w-[42%] lg:w-[40%] h-full shrink-0"></div>

        {/* Fila de 3 paneles cuadrados escalonados */}
        <div class="relative w-full md:w-[58%] lg:w-[60%] flex items-center justify-end gap-3.5 sm:gap-4 md:gap-5 overflow-hidden py-8">
          {slide.panels.map((panel, pIdx) => {
            const isMainPanel = pIdx === 0;
            return (
              <a
                href={panel.href || slide.ctaHref}
                class={`group/card relative block aspect-square rounded-2xl overflow-hidden border border-white/15 bg-black/60 shadow-2xl transition-all duration-500 hover:border-amber-400/70 hover:scale-[1.03] hover:shadow-[0_20px_45px_rgba(217,119,6,0.3)] pointer-events-auto cursor-pointer ${
                  isMainPanel
                    ? 'w-[42%] sm:w-[38%] md:w-[37%] z-20'
                    : pIdx === 1
                      ? 'w-[34%] sm:w-[32%] md:w-[32%] z-15'
                      : 'hidden sm:block sm:w-[28%] md:w-[28%] z-10'
                }`}
              >
                {/* Imagen en formato cuadrado */}
                <img
                  src={sanitizeImageUrl(panel.image) || panel.image}
                  alt={panel.alt || panel.title || ''}
                  loading={sIdx === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover/card:scale-105 brightness-[0.92] contrast-[1.05]"
                  style={`object-position: ${panel.objectPosition || 'center 25%'};`}
                />

                {/* Scrim gradual inferior sobre la imagen */}
                <div class="absolute inset-x-0 bottom-0 h-3/5 bg-linear-to-t from-black/85 via-black/35 to-transparent pointer-events-none"></div>

                {/* Rotulado del post con jerarquía limpia */}
                <div class="absolute inset-x-0 bottom-0 p-3.5 sm:p-4 flex flex-col gap-1 pointer-events-none">
                  {panel.category && (
                    <span class="text-[8px] sm:text-[9px] uppercase tracking-[0.25em] font-mono text-amber-300 font-bold line-clamp-1 drop-shadow-sm">
                      {panel.category}
                    </span>
                  )}
                  {panel.title && (
                    <h3 class="font-sans font-bold text-xs sm:text-sm text-white line-clamp-2 leading-tight drop-shadow-md group-hover/card:text-amber-200 transition-colors">
                      {panel.title}
                    </h3>
                  )}
                </div>

                {/* Badge de orden estilo cápsula de vidrio Apple TV */}
                <div class="absolute top-3 right-3 px-2 py-0.5 rounded-full bg-black/60 backdrop-blur-md border border-white/15 text-[9px] font-mono text-white/80 font-bold shadow-sm">
                  0{pIdx + 1}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════
       3. BLOQUE EDITORIAL IZQUIERDO ESTILO APPLE TV+
       ═══════════════════════════════════════════════════════════════════ -->
  <div class="relative z-20 w-full h-full flex flex-col justify-center items-start p-6 sm:p-10 md:p-14 lg:p-16 pointer-events-none">
    {allSlides.map((slide, sIdx) => (
      <div 
        class={`triptych-content absolute inset-y-0 left-6 sm:left-10 md:left-14 lg:left-16 flex flex-col justify-center items-start max-w-sm sm:max-w-md md:max-w-lg transition-none ${sIdx === 0 ? 'opacity-100 pointer-events-auto z-30' : 'opacity-0 pointer-events-none z-0'}`}
        data-content-index={sIdx}
        style={sIdx === 0 ? 'display: flex;' : 'display: none;'}
      >
        {/* Brand Header Apple TV Style (Newsreader cursiva + Kicker + Badge IMAX) */}
        <div class="flex items-center gap-2 mb-3 flex-wrap">
          <div class="flex items-baseline gap-1.5">
            <span class="text-white/60 font-['Newsreader',serif] italic text-xs tracking-wider">the great puzzle project</span>
            <span class="text-white/30 text-[10px]">·</span>
            <span class="font-['Syne',sans-serif] font-black text-[10px] tracking-widest uppercase text-amber-400">
              {slide.kicker}
            </span>
          </div>
          <span class="px-1.5 py-0.5 rounded text-[8.5px] font-mono tracking-wider bg-white/10 text-white/80 border border-white/15 font-bold backdrop-blur-sm">
            {slide.badgeImax}
          </span>
        </div>

        {/* TÍTULO MONUMENTAL H1 CON FONT EXTRABOLD / IMPACT ESPECÍFICA */}
        <h1 class={`showcase-title text-2xl sm:text-3xl md:text-4xl lg:text-[42px] text-white leading-[1.02] tracking-tight drop-shadow-[0_4px_25px_rgba(0,0,0,0.9)] mb-3 ${slide.fontH1}`}>
          {slide.title}
        </h1>

        {/* ETIQUETA DE ESPECIFICACIÓN Y CATEGORÍA */}
        <div class="flex items-center gap-2 mb-3">
          <span class="px-2 py-0.5 text-[10px] font-bold bg-white/10 backdrop-blur-md rounded-full text-white border border-white/15 font-mono">
            TGP
          </span>
          <span class="text-xs font-semibold text-white/90">
            {slide.tagLabel}
          </span>
          <span class="text-white/30 text-[10px]">·</span>
          <span class="text-[10px] font-mono text-zinc-400 font-medium">
            Investigación Abierta
          </span>
        </div>

        {/* SINOPSIS EDITORIAL (H2 STYLED) */}
        <p class={`showcase-subtitle text-xs sm:text-sm text-zinc-300 leading-relaxed mb-4 font-normal max-w-md drop-shadow-sm ${slide.fontH2}`}>
          {slide.subtitle}
        </p>

        {/* ESPECIFICACIONES TÉCNICAS (BADGES APPLE TV) */}
        <div class="flex flex-wrap items-center gap-1.5 text-[9.5px] font-mono text-zinc-400 mb-6">
          <span class="font-bold text-white/70">2026 ·</span>
          {slide.techSpecs.map(spec => (
            <span class="px-1.5 py-0.5 rounded bg-white/10 backdrop-blur-sm border border-white/15 text-white/80 font-bold">
              {spec}
            </span>
          ))}
        </div>

        {/* BOTONERA APPLE TV+ DE 3 ACCIONES */}
        <div class="flex items-center gap-3 flex-wrap">
          {/* Botón Blanco de Lectura Principal */}
          <a 
            href={slide.ctaHref} 
            class="showcase-cta group inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-3 bg-white text-zinc-950 rounded-full font-bold text-xs sm:text-sm hover:bg-zinc-200 transition-all duration-200 shadow-xl pointer-events-auto cursor-pointer relative z-30 hover:scale-[1.03] active:scale-[0.98]"
          >
            <svg class="w-3.5 h-3.5 fill-current transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
            <span>{slide.ctaText}</span>
          </a>

          {/* Botón Cristal Secundario ("Modo Cine") */}
          <a 
            href={slide.ctaHref} 
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-white/15 hover:bg-white/25 text-white font-semibold text-xs sm:text-sm backdrop-blur-md border border-white/20 transition-all duration-200 hover:scale-[1.03] active:scale-[0.98] pointer-events-auto cursor-pointer shadow-md"
          >
            <span>Modo Cine</span>
          </a>

          {/* Botón Circular Guardar (+) */}
          <button 
            type="button"
            aria-label="Guardar dossier"
            class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center backdrop-blur-md border border-white/20 transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer pointer-events-auto"
            title="Guardar en biblioteca"
          >
            <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </button>
        </div>
      </div>
    ))}
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════
       4. INDICADORES INFERIORES DINÁMICOS
       ═══════════════════════════════════════════════════════════════════ -->
  {allSlides.length > 1 && (
    <div class="triptych-indicators absolute bottom-5 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/15">
      {allSlides.map((_, i) => (
        <button 
          type="button" 
          class={`triptych-dot transition-all duration-300 rounded-full cursor-pointer ${i === 0 ? 'w-6 h-2 bg-amber-400 shadow-[0_0_12px_rgba(245,158,11,0.8)]' : 'w-2 h-2 bg-white/35 hover:bg-white/60'}`}
          data-dot-index={i}
          aria-label={`Ir al trío de posts ${i + 1}`}
        ></button>
      ))}
    </div>
  )}

</section>

<!-- ═══════════════════════════════════════════════════════════════════
     5. SCRIPT GSAP: TRANSICIÓN ATÓMICA Y CONTROL DE LIFECYCLE
     ═══════════════════════════════════════════════════════════════════ -->
<script>
  import { gsap } from 'gsap';

  function initShowcaseMotion() {
    const container = document.querySelector('.tgp-hero-triptych-container') as HTMLElement | null;
    if (!container || container.dataset.showcaseInit === 'true') return;
    container.dataset.showcaseInit = 'true';

    const bgSlides = Array.from(container.querySelectorAll<HTMLElement>('.triptych-bg-slide'));
    const cardsSlides = Array.from(container.querySelectorAll<HTMLElement>('.triptych-cards-slide'));
    const contents = Array.from(container.querySelectorAll<HTMLElement>('.triptych-content'));
    const dots = Array.from(container.querySelectorAll<HTMLButtonElement>('.triptych-dot'));
    if (contents.length <= 1) return;

    let currentIndex = 0;
    let isAnimating = false;
    let loopCall: gsap.core.Tween | null = null;
    let isHovered = false;

    function updateDots(index: number) {
      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.className = 'triptych-dot transition-all duration-300 rounded-full cursor-pointer w-6 h-2 bg-amber-400 shadow-[0_0_12px_rgba(245,158,11,0.8)]';
        } else {
          dot.className = 'triptych-dot transition-all duration-300 rounded-full cursor-pointer w-2 h-2 bg-white/35 hover:bg-white/60';
        }
      });
    }

    function goToSlide(nextIndex: number) {
      if (nextIndex === currentIndex || isAnimating) return;
      isAnimating = true;

      const currentBg = bgSlides[currentIndex];
      const nextBg = bgSlides[nextIndex];
      const currentCards = cardsSlides[currentIndex];
      const nextCards = cardsSlides[nextIndex];
      const currentContent = contents[currentIndex];
      const nextContent = contents[nextIndex];

      const tl = gsap.timeline({
        onComplete: () => {
          isAnimating = false;
        }
      });

      // 1. Ocultar capa actual
      tl.to(
        currentContent,
        {
          opacity: 0,
          y: -12,
          duration: 0.45,
          ease: 'power2.in',
          onComplete: () => {
            currentContent.style.display = 'none';
            currentContent.style.zIndex = '0';
            currentContent.style.pointerEvents = 'none';
          }
        },
        0
      );

      tl.to(
        currentCards,
        {
          opacity: 0,
          scale: 0.98,
          duration: 0.6,
          ease: 'power3.inOut',
          onComplete: () => {
            currentCards.style.display = 'none';
            currentCards.style.zIndex = '0';
            currentCards.style.pointerEvents = 'none';
          }
        },
        0
      );

      tl.to(
        currentBg,
        {
          opacity: 0,
          duration: 0.6,
          ease: 'power2.inOut',
          onComplete: () => {
            currentBg.style.display = 'none';
            currentBg.style.zIndex = '0';
          }
        },
        0
      );

      // 2. Encender nuevo fondo y tarjetas
      tl.set(nextBg, { display: 'block', zIndex: '10' }, 0.2);
      tl.fromTo(
        nextBg,
        { opacity: 0 },
        { opacity: 1, duration: 0.75, ease: 'power2.out' },
        0.2
      );

      tl.set(nextCards, { display: 'flex', zIndex: '10', pointerEvents: 'auto' }, 0.2);
      tl.fromTo(
        nextCards,
        { opacity: 0, scale: 1.03 },
        { opacity: 1, scale: 1, duration: 0.75, ease: 'power3.out' },
        0.2
      );

      // 3. Encender nuevo contenido editorial
      tl.set(nextContent, { display: 'flex', zIndex: '30', pointerEvents: 'auto' }, 0.3);
      tl.fromTo(
        nextContent,
        { opacity: 0, y: 16 },
        { opacity: 1, y: 0, duration: 0.65, ease: 'power2.out' },
        0.3
      );

      currentIndex = nextIndex;
      updateDots(currentIndex);
    }

    function scheduleNext() {
      if (loopCall) loopCall.kill();
      loopCall = gsap.delayedCall(5.0, () => {
        if (!isHovered) {
          const next = (currentIndex + 1) % contents.length;
          goToSlide(next);
          scheduleNext();
        }
      });
    }

    function pauseLoop() {
      isHovered = true;
      if (loopCall) loopCall.pause();
    }

    function resumeLoop() {
      isHovered = false;
      if (loopCall) {
        loopCall.resume();
      } else {
        scheduleNext();
      }
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        goToSlide(idx);
        scheduleNext();
      });
    });

    container.addEventListener('mouseenter', pauseLoop);
    container.addEventListener('mouseleave', resumeLoop);
    container.addEventListener('touchstart', pauseLoop, { passive: true });
    container.addEventListener('touchend', resumeLoop, { passive: true });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        pauseLoop();
      } else {
        resumeLoop();
      }
    });

    scheduleNext();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShowcaseMotion);
  } else {
    initShowcaseMotion();
  }
  document.addEventListener('astro:page-load', initShowcaseMotion);
</script>
