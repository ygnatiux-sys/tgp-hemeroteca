---
/**
 * src/components/TgpHeroTriptych.astro
 *
 * Showcase Cinemático estilo Apple TV+.
 * Muestra 3 posts en formato cuadrado por diapositiva y avanza en secuencias de 3 en 3.
 * Transición fluida con GSAP, indicadores dinámicos, soporte para interacción táctil y pausa en hover.
 */
import { sanitizeImageUrl, isValidImageSrc } from '../lib/content-filter';

export interface TriptychPost {
  title: string;
  excerpt?: string;
  category?: string;
  img: string;
  href: string;
  date?: string;
}

export interface Panel {
  image: string;
  alt: string;
  title?: string;
  href?: string;
  category?: string;
  objectPosition?: string;
}

export interface SlideItem {
  kicker: string;
  title: string;
  tagLabel: string;
  subtitle: string;
  ctaText: string;
  ctaHref: string;
  panels: [Panel, Panel, Panel];
}

interface Props {
  posts?: TriptychPost[];
  slides?: SlideItem[];
  kicker?: string;
  title?: string;
  tagLabel?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  panels?: [Panel, Panel, Panel];
}

const {
  posts,
  slides,
  kicker,
  title,
  tagLabel,
  subtitle,
  ctaText,
  ctaHref,
  panels
} = Astro.props;

// Construcción dinámica de Slides a partir de Posts Reales en bloques de 3 en 3
let computedSlides: SlideItem[] = [];

if (posts && posts.length >= 3) {
  for (let i = 0; i < posts.length; i += 3) {
    const chunk = posts.slice(i, i + 3);
    if (chunk.length < 3) break;
    const p1 = chunk[0];
    const p2 = chunk[1];
    const p3 = chunk[2];
    const slideNumber = String(Math.floor(i / 3) + 1).padStart(2, '0');

    computedSlides.push({
      kicker: `${(p1.category || 'ARCHIVO TGP').toUpperCase()} // DOSSIER ${slideNumber}`,
      title: p1.title,
      tagLabel: p1.category || 'Investigación',
      subtitle: p1.excerpt ? p1.excerpt.replace(/[#*_`]/g, '').slice(0, 150) + '…' : 'Investigación profunda y análisis documental del acervo.',
      ctaText: 'Ver investigación',
      ctaHref: p1.href,
      panels: [
        {
          image: p1.img,
          alt: p1.title,
          title: p1.title,
          href: p1.href,
          category: p1.category,
          objectPosition: 'center 20%'
        },
        {
          image: p2.img,
          alt: p2.title,
          title: p2.title,
          href: p2.href,
          category: p2.category,
          objectPosition: 'center 25%'
        },
        {
          image: p3.img,
          alt: p3.title,
          title: p3.title,
          href: p3.href,
          category: p3.category,
          objectPosition: 'center 20%'
        }
      ]
    });
  }
}

// Fallback de respaldo con imágenes temáticas de historia/arqueología si no se pasan posts ni slides
const defaultSlides: SlideItem[] = [
  {
    kicker: "ARCHAEOSEMIOTICS // DOSSIER 01",
    title: "LA ARQUITECTURA DEL TIEMPO",
    tagLabel: "Memoria Material",
    subtitle: "Estratos líticos y signos rituales donde la civilización humana codificó el tiempo antes de la escritura.",
    ctaText: "Ver investigación",
    ctaHref: "/archivo/",
    panels: [
      {
        image: "/src/assets/remotas/stepped-pyramid-of-djoser-at-saqqara.webp",
        alt: "Pirámide Escalonada de Saqqara",
        title: "Pirámide de Saqqara",
        category: "Arqueosemiótica",
        objectPosition: "center 20%"
      },
      {
        image: "https://storage.thegreatpuzzleproject.com/wikimedia/1790166100412-8c88f7a9.webp",
        alt: "La Pirámide Roja en Dahshur",
        title: "Pirámide Roja",
        category: "Ensayos Cinemáticos",
        objectPosition: "center 25%"
      },
      {
        image: "https://storage.thegreatpuzzleproject.com/wikimedia/1791676137832-aca96ac9.webp",
        alt: "Terrazas Megalíticas de Gunung Padang",
        title: "Gunung Padang",
        category: "Prehistoria",
        objectPosition: "center 20%"
      }
    ]
  }
];

const allSlides: SlideItem[] = computedSlides.length > 0
  ? computedSlides
  : (slides && slides.length > 0 
      ? slides 
      : (title && panels 
          ? [{
              kicker: kicker || defaultSlides[0].kicker,
              title: title,
              tagLabel: tagLabel || defaultSlides[0].tagLabel,
              subtitle: subtitle || defaultSlides[0].subtitle,
              ctaText: ctaText || defaultSlides[0].ctaText,
              ctaHref: ctaHref || defaultSlides[0].ctaHref,
              panels: panels
            }]
          : defaultSlides));
---

<section class="tgp-hero-triptych-container relative w-full h-[76vh] min-h-135 max-h-195 bg-[#08090c] text-white overflow-hidden rounded-2xl md:rounded-3xl select-none shadow-[0_30px_70px_-15px_rgba(0,0,0,0.95)] border border-white/10">
  
  <!-- CONTENEDOR DE SLIDES SUPERPUESTOS CON 3 POSTS EN FORMATO CUADRADO -->
  <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
    {allSlides.map((slide, sIdx) => (
      <div 
        class={`showcase-slide absolute inset-0 w-full h-full flex items-center justify-between px-6 sm:px-10 md:px-14 lg:px-16 ${sIdx === 0 ? 'opacity-100 z-10 pointer-events-auto' : 'opacity-0 z-0 pointer-events-none'}`}
        data-slide-index={sIdx}
      >
        <!-- FONDO ATMOSFÉRICO EXPANDIDO (BOKEH CINEMÁTICO SUAVE DEL POST PRINCIPAL) -->
        <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
          <img 
            src={slide.panels[0].image} 
            alt="" 
            aria-hidden="true"
            class="w-full h-full object-cover scale-125 blur-3xl opacity-30 brightness-75 saturate-125"
          />
          <div class="absolute inset-0 bg-linear-to-r from-[#08090c] via-[#08090c]/85 via-50% to-transparent z-1"></div>
        </div>

        <!-- ESPACIO IZQUIERDO RESERVADO PARA EL BLOQUE EDITORIAL (SHOWCASE-CONTENT) -->
        <div class="w-full md:w-[44%] lg:w-[40%] h-full shrink-0"></div>

        <!-- CONTENEDOR DERECHO: 3 POSTS EN FORMATO CUADRADO PROPORCIONADO -->
        <div class="relative z-10 w-full md:w-[56%] lg:w-[60%] flex items-center justify-end gap-3 sm:gap-4 md:gap-5 overflow-hidden py-6">
          {slide.panels.map((panel, pIdx) => {
            const isMainPanel = pIdx === 0;
            return (
              <a
                href={panel.href || slide.ctaHref}
                class={`group/card relative block aspect-square rounded-2xl overflow-hidden border border-white/15 bg-black/60 shadow-2xl transition-all duration-500 hover:border-amber-400/60 hover:scale-[1.03] hover:shadow-[0_15px_35px_rgba(217,119,6,0.25)] ${
                  isMainPanel
                    ? 'w-[42%] sm:w-[38%] md:w-[36%] z-20'
                    : pIdx === 1
                      ? 'w-[34%] sm:w-[32%] md:w-[32%] z-15'
                      : 'hidden sm:block sm:w-[28%] md:w-[28%] z-10'
                }`}
              >
                <!-- Imagen en formato cuadrado -->
                <img
                  src={panel.image}
                  alt={panel.alt || panel.title || ''}
                  loading={sIdx === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover/card:scale-105"
                  style={`object-position: ${panel.objectPosition || 'center 25%'};`}
                />

                <!-- Scrim inferior con opacidad controlada para rotulado -->
                <div class="absolute inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-black/75 via-black/25 to-transparent pointer-events-none"></div>

                <!-- Rotulado del post -->
                <div class="absolute inset-x-0 bottom-0 p-3 sm:p-4 flex flex-col gap-1 pointer-events-none">
                  {panel.category && (
                    <span class="text-[8px] sm:text-[9px] uppercase tracking-[0.2em] font-mono text-amber-300/90 font-bold line-clamp-1">
                      {panel.category}
                    </span>
                  )}
                  {panel.title && (
                    <h3 class="font-sans font-bold text-xs sm:text-sm text-white line-clamp-2 leading-tight drop-shadow-md group-hover/card:text-amber-200 transition-colors">
                      {panel.title}
                    </h3>
                  )}
                </div>

                <!-- Badge de orden sutil -->
                <div class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-full bg-black/55 backdrop-blur-md border border-white/10 text-[9px] font-mono text-white/70">
                  0{pIdx + 1}
                </div>
              </a>
            );
          })}
        </div>

      </div>
    ))}
  </div>

  <!-- VIÑETA LATERAL IZQUIERDA PARA EL TEXTO -->
  <div class="absolute bottom-0 left-0 w-full md:w-[46%] h-full bg-linear-to-r from-[#08090c] via-[#08090c]/80 to-transparent z-15 pointer-events-none"></div>

  <!-- BLOQUE EDITORIAL SUPERPUESTO (FÍSICA APPLE TV+) -->
  <div class="relative z-20 w-full h-full flex flex-col justify-center items-start p-7 md:p-14 lg:p-16 pointer-events-none">
    {allSlides.map((slide, sIdx) => (
      <div 
        class={`showcase-content absolute inset-y-0 left-7 md:left-14 lg:left-16 flex flex-col justify-center items-start max-w-sm sm:max-w-md md:max-w-lg font-sans ${sIdx === 0 ? 'opacity-100 pointer-events-auto z-30' : 'opacity-0 pointer-events-none z-0'}`}
        data-content-index={sIdx}
      >
        <span class="block text-[10px] sm:text-[11px] font-mono uppercase tracking-[0.25em] text-amber-300/90 mb-2 font-bold">
          {slide.kicker}
        </span>

        <h2 class="font-sans text-2xl sm:text-3xl md:text-[34px] font-black tracking-tight uppercase leading-[1.08] text-white mb-3">
          {slide.title}
        </h2>

        <div class="flex items-center gap-2 mb-3">
          <span class="px-2 py-0.5 text-[10px] font-bold bg-white/10 backdrop-blur-md rounded-full text-white border border-white/15 font-mono">
            TGP
          </span>
          <span class="text-xs font-semibold text-white/90">
            {slide.tagLabel}
          </span>
        </div>

        <p class="text-xs sm:text-sm text-white/75 leading-relaxed mb-6 font-normal max-w-md">
          {slide.subtitle}
        </p>

        <a 
          href={slide.ctaHref} 
          class="showcase-cta group inline-flex items-center justify-center gap-2.5 px-7 py-3 bg-white text-zinc-950 rounded-full font-semibold text-xs sm:text-sm hover:bg-zinc-200 transition-all duration-200 shadow-xl pointer-events-auto cursor-pointer relative z-30 hover:scale-[1.03] active:scale-[0.98]"
        >
          <svg class="w-3.5 h-3.5 fill-current transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
          <span>{slide.ctaText}</span>
        </a>
      </div>
    ))}
  </div>

  <!-- INDICADORES INFERIORES CENTRALES DINÁMICOS -->
  {allSlides.length > 1 && (
    <div class="showcase-indicators absolute bottom-4 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/55 backdrop-blur-md border border-white/15">
      {allSlides.map((_, i) => (
        <button 
          type="button" 
          class={`showcase-dot transition-all duration-300 rounded-full cursor-pointer ${i === 0 ? 'w-5 h-2 bg-amber-400 shadow-[0_0_10px_rgba(245,158,11,0.7)]' : 'w-2 h-2 bg-white/35 hover:bg-white/60'}`}
          data-dot-index={i}
          aria-label={`Ir al trío de posts ${i + 1}`}
        ></button>
      ))}
    </div>
  )}

</section>

<script>
  import { gsap } from 'gsap';

  function initShowcaseMotion() {
    const container = document.querySelector('.tgp-hero-triptych-container') as HTMLElement | null;
    if (!container || container.dataset.showcaseInit === 'true') return;
    container.dataset.showcaseInit = 'true';

    const slides = gsap.utils.toArray<HTMLElement>('.showcase-slide');
    const contents = gsap.utils.toArray<HTMLElement>('.showcase-content');
    const dots = gsap.utils.toArray<HTMLButtonElement>('.showcase-dot');
    if (slides.length <= 1) return;

    let currentIndex = 0;
    let isAnimating = false;
    let loopCall: gsap.core.Tween | null = null;
    let isHovered = false;

    function updateDots(index: number) {
      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.className = 'showcase-dot transition-all duration-300 rounded-full cursor-pointer w-5 h-2 bg-amber-400 shadow-[0_0_10px_rgba(245,158,11,0.7)]';
        } else {
          dot.className = 'showcase-dot transition-all duration-300 rounded-full cursor-pointer w-2 h-2 bg-white/35 hover:bg-white/60';
        }
      });
    }

    function goToSlide(nextIndex: number) {
      if (nextIndex === currentIndex || isAnimating) return;
      isAnimating = true;

      const currentSlide = slides[currentIndex];
      const nextSlide = slides[nextIndex];
      const currentContent = contents[currentIndex];
      const nextContent = contents[nextIndex];

      const tl = gsap.timeline({
        onComplete: () => {
          isAnimating = false;
        }
      });

      tl.to(
        currentSlide,
        {
          opacity: 0,
          scale: 0.98,
          duration: 0.7,
          ease: 'power3.inOut',
          onComplete: () => {
            currentSlide.style.zIndex = '0';
            currentSlide.style.pointerEvents = 'none';
          }
        },
        0
      );

      tl.to(
        currentContent,
        {
          opacity: 0,
          y: -12,
          duration: 0.5,
          ease: 'power2.in',
          onComplete: () => {
            currentContent.style.zIndex = '0';
            currentContent.style.pointerEvents = 'none';
          }
        },
        0
      );

      tl.fromTo(
        nextSlide,
        { opacity: 0, scale: 1.02 },
        {
          opacity: 1,
          scale: 1,
          duration: 0.8,
          ease: 'power3.out',
          onStart: () => {
            nextSlide.style.zIndex = '10';
            nextSlide.style.pointerEvents = 'auto';
          }
        },
        0.15
      );

      tl.fromTo(
        nextContent,
        { opacity: 0, y: 15 },
        {
          opacity: 1,
          y: 0,
          duration: 0.65,
          ease: 'power2.out',
          onStart: () => {
            nextContent.style.zIndex = '30';
            nextContent.style.pointerEvents = 'auto';
          }
        },
        0.2
      );

      currentIndex = nextIndex;
      updateDots(currentIndex);
    }

    function scheduleNext() {
      if (loopCall) loopCall.kill();
      loopCall = gsap.delayedCall(4.5, () => {
        if (!isHovered) {
          const next = (currentIndex + 1) % slides.length;
          goToSlide(next);
          scheduleNext();
        }
      });
    }

    function pauseLoop() {
      isHovered = true;
      if (loopCall) loopCall.pause();
    }

    function resumeLoop() {
      isHovered = false;
      if (loopCall) {
        loopCall.resume();
      } else {
        scheduleNext();
      }
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        goToSlide(idx);
        scheduleNext();
      });
    });

    container.addEventListener('mouseenter', pauseLoop);
    container.addEventListener('mouseleave', resumeLoop);
    container.addEventListener('touchstart', pauseLoop, { passive: true });
    container.addEventListener('touchend', resumeLoop, { passive: true });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        pauseLoop();
      } else {
        resumeLoop();
      }
    });

    scheduleNext();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShowcaseMotion);
  } else {
    initShowcaseMotion();
  }
  document.addEventListener('astro:page-load', initShowcaseMotion);
</script>
