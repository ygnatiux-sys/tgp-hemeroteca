                  <div class="w-5 h-5 md:w-6 md:h-6 rounded-full border-0 bg-white/5 flex items-center justify-center transition-all shrink-0 relative overflow-hidden">
                    <img
                      src="/images/favicon.TGP.webp"
                      alt="TGP Logo"
                      class="w-full h-full object-cover scale-[1.05] animate-soft-pulse group-hover:scale-[1.10] transition-transform duration-500"
                    />
