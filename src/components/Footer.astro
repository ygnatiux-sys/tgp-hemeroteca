        {/* ─── SELLO + NOMBRE PRINCIPAL ─── */}
        <a
          href="/"
          class="flex items-center gap-4 shrink-0 hover:opacity-90 transition-opacity"
          title="The Great Puzzle Project"
        >
          <div class="relative flex items-center justify-center w-10 h-10">
            <svg
              viewBox="0 0 100 100"
              class="absolute inset-0 w-full h-full animate-[spin_40s_linear_infinite] opacity-50"
            >
              <path
                id="tgp-seal-curve-min"
                d="M 50,50 m -42,0 a 42,42 0 1,1 84,0 a 42,42 0 1,1 -84,0"
                fill="transparent"
              />
              <text>
                <textPath href="#tgp-seal-curve-min" startOffset="0%">
                  <tspan font-family="monospace" font-size="8" fill="#EFEBE3">
                    TGP • ARCHIVO • TGP • ARCHIVO • TGP • ARCHIVO •{" "}
                  </tspan>
