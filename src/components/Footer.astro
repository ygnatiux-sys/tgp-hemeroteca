---
// Componente Footer Editorial Cinemático — Variante Completa y Variante Minimalista (Interiores)
interface Props {
  variant?: "full" | "minimal";
}

const { variant = "full" } = Astro.props;
const { pathname } = Astro.url;

const isActive = (href: string) => {
  if (href === "/") {
    return pathname === "/" || pathname === "";
  }
  return pathname.startsWith(href);
};
---

{
  variant === "minimal" ? (
    /* =========================================================================
     VARIANTE MINIMALISTA (Interiores de Post / Ensayos)
     ========================================================================= */
    <footer class="w-full bg-(--bg-main) text-[#E0E0E0] border-t border-white/5 py-8 md:py-10 px-6 md:px-12 lg:px-16 mt-20 relative z-40 transition-colors duration-500 overflow-hidden">
      <div class="max-w-400 mx-auto flex flex-col md:flex-row items-center justify-between gap-6 relative z-10">
        {/* ─── SELLO + NOMBRE PRINCIPAL ─── */}
        <a
          href="/"
          class="group flex items-center gap-4 shrink-0"
          title="The Great Puzzle Project"
        >
          <div class="relative flex items-center justify-center w-10 h-10">
            <div class="w-5 h-5 md:w-6 md:h-6 rounded-full overflow-hidden flex items-center justify-center relative border-0 bg-white/5">
              <img
                src="/images/favicon.TGP.webp"
                alt="TGP Logo"
                class="w-full h-full object-cover scale-[1.05] animate-soft-pulse"
              />
            </div>
          </div>
          <div class="flex flex-col text-left">
            <span class="font-['Gloock'] font-black text-base md:text-lg tracking-wide leading-tight gradient-steel-brand">
              THE GREAT PUZZLE PROJECT
            </span>
            <a
              href="https://gravatar.com/xavierbeniteztgp"
              target="_blank"
              rel="noopener noreferrer"
              class="xavier-benitez-link uppercase tracking-[0.2em] mt-0.5"
            >
              Dir. Xavier Benítez
            </a>
          </div>
        </a>

        {/* ─── NAV CENTRAL ─── */}
        <nav class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 font-['Gloock'] text-xs md:text-sm">
          <a href="/" class:list={["footer-nav-link", isActive("/") && "is-active"]}>
            Inicio
          </a>
          <span class="opacity-20">·</span>
          <a href="/colecciones/" class:list={["footer-nav-link", isActive("/colecciones/") && "is-active"]}>
            Colecciones
          </a>
          <span class="opacity-20">·</span>
          <a href="/archivo/" class:list={["footer-nav-link", isActive("/archivo/") && "is-active"]}>
            Archivo
          </a>
          <span class="opacity-20">·</span>
          <a href="/about/" class:list={["footer-nav-link", isActive("/about/") && "is-active"]}>
            About
          </a>
          <span class="opacity-20">·</span>
          <a
            href="https://ediciones.thegreatpuzzleproject.com"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-nav-link font-bold"
            title="Editorial TGP — Archivo editorial completo"
          >
            Editorial ↗
          </a>
        </nav>

        {/* ─── ACCIONES + COPYRIGHT ─── */}
        <div class="flex flex-wrap justify-center items-center gap-2 sm:gap-4 font-metadata text-[9px] uppercase tracking-[0.2em] text-white/70 shrink-0 mt-4 md:mt-0">
          <button
            id="tgp-share-btn-min"
            type="button"
            class="lantern-hover cursor-pointer flex items-center gap-1.5"
          >
            <svg
              class="w-3 h-3 fill-none stroke-current"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <>
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
                <polyline points="16 6 12 2 8 6" />
                <line x1="12" y1="2" x2="12" y2="15" />
              </>
            </svg>
            Compartir
          </button>
          <span class="opacity-20 hidden sm:inline">·</span>
          <span><a href="https://alternative.thegreatpuzzleproject.com/" target="_blank" rel="noopener noreferrer" style="color:inherit;text-decoration:none;cursor:default;pointer-events:auto;">©</a> 2026 TGP</span>
          <span class="opacity-20 hidden sm:inline">·</span>
          <a
            href="https://about.thegreatpuzzleproject.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="lantern-hover font-bold w-full sm:w-auto text-center mt-2 sm:mt-0"
          >
            ABOUT ME
          </a>
        </div>
      </div>
    </footer>
  ) : (
