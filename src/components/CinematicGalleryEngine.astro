---
import Image from './SafeImage.astro';
import { sanitizeImageUrl } from "../lib/content-filter";

/**
 * CinematicGalleryEngine.astro
 * ──────────────────────────────────────────────────────────────────────────────
 * Motor cinemático adaptado para funcionar como Galería Inmersiva dentro de posts.
 */

export interface GallerySlideData {
  id: string;
  title: string;
  subtitle?: string;
  author?: string;
  license?: string;
  image: any;
  imagePosition?: string;
  category?: string;
  year?: string;
  link?: string;
}

interface Props {
  slides: GallerySlideData[];
  heightClass?: string;
  maxSlides?: number;
}

const { slides = [], heightClass = "h-[85vh] md:h-dvh", maxSlides = 15 } = Astro.props;
const safeSlides = (slides.length > 0 ? slides : []).slice(0, maxSlides);
---

{
  safeSlides.length > 0 && (
    <section
      class={`cge-root relative w-full ${heightClass} overflow-hidden bg-[#0a0a0a] rounded-2xl md:rounded-3xl select-none md:shadow-2xl border border-white/10 [contain-intrinsic-size:auto_85vh] group/cge`}
      aria-label="Galería Cinemática"
    >
      {/* ── SLIDES ── */}
      <div class="cge-slides absolute inset-0">
        {safeSlides.map((slide, i) => {
          const safeSrc = sanitizeImageUrl(slide.image);
          return (
            <article
              class={`cge-slide absolute inset-0 flex items-end justify-start p-6 sm:p-10 md:p-14 [content-visibility:auto] contain-content ${i === 0 ? "z-20" : "z-10 opacity-0 pointer-events-none"}`}
              data-index={i}
              {...(i !== 0 ? { "aria-hidden": "true" } : {})}
            >
              {/* Fondo: Imagen nítida con Ken Burns y object-cover para impacto total */}
              <div class="cge-bg-wrap absolute inset-0 overflow-hidden bg-[#0a0a0a]">
                {safeSrc ? (
                  <Image
                    src={safeSrc}
                    alt={slide.title}
                    class="cge-bg-img absolute inset-0 w-full h-full object-cover scale-100"
                    style={`object-position: ${slide.imagePosition || "center center"};`}
                    inferSize={true}
                    format="webp"
                    widths={[600, 1024, 1600, 2400]}
                    sizes="(max-width: 768px) 100vw, (max-width: 1400px) 90vw, 1600px"
                    loading={i < 2 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : undefined}
                    decoding="async"
                  />
                ) : (
                  <div class="fallback-background absolute inset-0 bg-stone-900 pointer-events-none -z-10" />
                )}
                {/* Scrim cinematográfico inferior para contraste óptimo */}
                <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/45 via-45% to-transparent pointer-events-none z-10" />
              </div>

              {/* Contenido Editorial Alineado a la Izquierda (Estilo Img 2) */}
              <div class="cge-content relative z-20 w-full max-w-4xl flex flex-col items-start text-left gap-2 sm:gap-3 transition-opacity duration-700">
                {/* Título Monumental en Cinzel Extrabold con Steel Gradient */}
                {slide.link ? (
                  <a href={slide.link} class="group/title block">
                    <h2 class="cge-title font-cinzel font-extrabold text-2xl sm:text-4xl md:text-5xl lg:text-[3.25rem] leading-[1.08] tracking-tight gradient-acero-ios drop-shadow-[0_4px_24px_rgba(0,0,0,0.9)] group-hover/title:brightness-110 transition-all duration-300">
                      {slide.title}
                    </h2>
                  </a>
                ) : (
                  <h2 class="cge-title font-cinzel font-extrabold text-2xl sm:text-4xl md:text-5xl lg:text-[3.25rem] leading-[1.08] tracking-tight gradient-acero-ios drop-shadow-[0_4px_24px_rgba(0,0,0,0.9)]">
                    {slide.title}
                  </h2>
                )}

                {/* Subtítulo / Dek si existe */}
                {slide.subtitle && (
                  <p class="cge-subtitle font-serif font-light text-white/80 text-xs sm:text-sm md:text-base max-w-2xl leading-relaxed line-clamp-2 drop-shadow-md">
                    "{slide.subtitle}"
                  </p>
                )}

                {/* Categoría y Año en Mono Limpio (Estilo Img 2: CATEGORIA · AÑO) */}
                {(slide.category || slide.year) && (
                  <div class="cge-meta flex items-center gap-2 font-mono text-[10px] md:text-[11px] uppercase tracking-[0.3em] text-rust-orange font-bold mt-1">
                    {slide.category && <span>{slide.category}</span>}
                    {slide.category && slide.year && <span class="text-white/40">·</span>}
                    {slide.year && <span class="text-white/50">{slide.year}</span>}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>

      {/* ── BOTONES DE NAVEGACIÓN EN CÁPSULA (ESTILO ROWNETFLIX) ── */}
      {safeSlides.length > 1 && (
        <>
          {/* Flecha Anterior (Izquierda) */}
          <button
            type="button"
            class="cge-arrow cge-prev absolute left-2 sm:left-4 md:left-6 top-1/2 -translate-y-1/2 z-40 w-8 md:w-9 h-14 md:h-16 rounded-full bg-black/65 hover:bg-black/95 text-white/70 hover:text-white border border-white/15 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-75 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl pointer-events-auto"
            aria-label="Slide anterior"
          >
            <svg class="w-4 h-4 md:w-4.5 md:h-4.5 -translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </button>

          {/* Flecha Siguiente (Derecha) */}
          <button
            type="button"
            class="cge-arrow cge-next absolute right-2 sm:right-4 md:right-6 top-1/2 -translate-y-1/2 z-40 w-8 md:w-9 h-14 md:h-16 rounded-full bg-black/65 hover:bg-black/95 text-white/70 hover:text-white border border-white/15 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-75 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl pointer-events-auto"
            aria-label="Slide siguiente"
          >
            <svg class="w-4 h-4 md:w-4.5 md:h-4.5 translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>

          {/* Dots de paginación inferiores centrados */}
          <nav
            class="cge-dots absolute bottom-4 md:bottom-6 left-1/2 -translate-x-1/2 flex flex-wrap justify-center items-center gap-1.5 md:gap-2 max-w-[92vw] px-3.5 py-1.5 rounded-full bg-black/45 backdrop-blur-md border border-white/10 pointer-events-auto shadow-xl z-40"
            aria-label="Indicadores de slide"
          >
            {safeSlides.map((_, i) => (
              <button
                type="button"
                class={`cge-dot h-1 rounded-full transition-all duration-500 cursor-pointer border-0 p-0 ${i === 0 ? 'w-5 md:w-7 bg-[#EFEBE3]' : 'w-1 md:w-1.5 bg-white/30 hover:bg-white/60'}`}
                data-dot={i}
                aria-label={`Ir al slide ${i + 1}`}
              />
            ))}
          </nav>
        </>
      )}
      
      {/* Barra de progreso — Línea punteada estática */}
      <div class="absolute bottom-0 left-0 w-full h-0.5 border-b border-dotted border-[#EFEBE3]/25 cge-progress z-30"></div>
    </section>
  )
}

<script>
  import gsap from "gsap";

  const SLIDE_DURATION = 8000; // ms por slide
  const AUTO_RESUME = 10000; // ms de inactividad → retoma auto
  const KB_SCALE = 1.05; // Ken Burns scale destino
  const FADE_DUR = 1.2; // s para cross-fade entre slides
  const SWIPE_THRESHOLD = 50; // px mínimos para contar como swipe

  function initCGE() {
    const roots = Array.from(
      document.querySelectorAll<HTMLElement>(".cge-root"),
    );
    if (roots.length === 0) return;

    roots.forEach((root) => {
      if (root.dataset.cgeInitialized === "true") return;
      root.dataset.cgeInitialized = "true";

      const slideEls = Array.from(
        root.querySelectorAll<HTMLElement>(".cge-slide"),
      );
      const dotEls = Array.from(root.querySelectorAll<HTMLElement>(".cge-dot"));
      const progress = root.querySelector<HTMLElement>(".cge-progress");
      const prevBtn = root.querySelector<HTMLElement>(".cge-prev");
      const nextBtn = root.querySelector<HTMLElement>(".cge-next");
      const total = slideEls.length;

      if (total === 0) return;

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      let current = 0;
      let isAnimating = false;
      let autoTimer: ReturnType<typeof setTimeout> | undefined;
      let resumeTimer: ReturnType<typeof setTimeout> | undefined;
      let progressTween: gsap.core.Tween | undefined;
      let metaPulseTween: gsap.core.Tween | undefined;

      /* Los controles de navegación están siempre accesibles de forma interactiva */

      /* ── Entrada de slide ── */
      function slideIn(slide: HTMLElement, done: (() => void) | null) {
        const bg = slide.querySelector<HTMLElement>(".cge-bg-img");
        const metaEl = slide.querySelector<HTMLElement>(".cge-meta");
        const titleEl = slide.querySelector<HTMLElement>(".cge-title");
        const subEl = slide.querySelector<HTMLElement>(".cge-subtitle");
        const dot = slide.querySelector<HTMLElement>(".cge-meta-dot");

        slide.classList.remove("pointer-events-none");
        slide.setAttribute("aria-hidden", "false");
        slide.style.zIndex = "20";

        if (reduceMotion) {
          gsap.set(slide, { opacity: 1 });
          done?.();
          return;
        }

        const tl = gsap.timeline();

        /* Slide fade-in */
        tl.fromTo(
          slide,
          { opacity: 0 },
          { 
            opacity: 1, 
            duration: 0.85, 
            ease: "power2.inOut",
            onComplete: () => done?.()
          },
          0,
        );

        /* Ken Burns: escala milimétrica */
        if (bg) {
          gsap.set(bg, { scale: 1 });
          gsap.to(bg, {
            scale: KB_SCALE,
            duration: SLIDE_DURATION / 1000 + FADE_DUR,
            ease: "none",
          });
        }

        /* Textos: stagger desde abajo */
        const textEls = [metaEl, titleEl, subEl].filter(
          Boolean,
        ) as HTMLElement[];
        if (textEls.length > 0) {
          tl.fromTo(
            textEls,
            { opacity: 0, y: 15 },
            {
              opacity: 1,
              y: 0,
              duration: 0.65,
              stagger: 0.15,
              ease: "power3.out",
              clearProps: "transform",
            },
            0.35,
          );
        }

        /* Pulso del dot: yoyo opacidad */
        if (dot) {
          metaPulseTween?.kill();
          metaPulseTween = gsap.to(dot, {
            opacity: 0.35,
            duration: 1.4,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 0.8,
          });
        }
      }

      /* ── Salida de slide ── */
      function slideOut(slide: HTMLElement, done: (() => void) | null) {
        if (reduceMotion) {
          gsap.set(slide, { opacity: 0 });
          slide.classList.add("pointer-events-none");
          slide.setAttribute("aria-hidden", "true");
          slide.style.zIndex = "10";
          done?.();
          return;
        }
        gsap.to(slide, {
          opacity: 0,
          duration: FADE_DUR * 0.85,
          ease: "power2.inOut",
          onComplete: () => {
            slide.classList.add("pointer-events-none");
            slide.setAttribute("aria-hidden", "true");
            slide.style.zIndex = "10";
            done?.();
          },
        });
      }

      /* ── Dots ── */
      function updateDots(idx: number) {
        dotEls.forEach((d, i) => {
          const active = i === idx;
          d.classList.toggle("w-6", active);
          d.classList.toggle("md:w-8", active);
          d.classList.toggle("bg-[#EFEBE3]", active);
          d.classList.toggle("w-1.5", !active);
          d.classList.toggle("md:w-2", !active);
          d.classList.toggle("bg-white/30", !active);
        });
      }

      /* ── Barra de progreso ── */
      function startProgress() {
        progressTween?.kill();
        // Dejar línea punteada estática
      }

      /* ── Ir al slide idx ── */
      function goTo(idx: number) {
        if (isAnimating || idx === current) return;
        isAnimating = true;

        const prevIdx = current;
        const nextIdx = ((idx % total) + total) % total;
        current = nextIdx;
        updateDots(current);
        startProgress();

        slideEls[nextIdx].style.zIndex = "20";
        slideEls[prevIdx].style.zIndex = "15";

        /* Cross-fade */
        slideOut(slideEls[prevIdx], null);
        slideIn(slideEls[nextIdx], () => {
          isAnimating = false;
        });
      }

      /* ── Auto-avance ── */
      function scheduleNext() {
        clearTimeout(autoTimer);
        autoTimer = setTimeout(() => {
          goTo((current + 1) % total);
          scheduleNext();
        }, SLIDE_DURATION);
      }

      function pauseAuto() {
        clearTimeout(autoTimer);
        clearTimeout(resumeTimer);
        progressTween?.pause();
      }

      function resumeAuto() {
        clearTimeout(resumeTimer);
        resumeTimer = setTimeout(() => {
          progressTween?.play();
          scheduleNext();
        }, AUTO_RESUME);
      }

      /* ── Botones ── */
      prevBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        pauseAuto();
        goTo((current - 1 + total) % total);
        resumeAuto();
      });
      nextBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        pauseAuto();
        goTo((current + 1) % total);
        resumeAuto();
      });

      /* ── Dots click ── */
      dotEls.forEach((d) => {
        d.addEventListener("click", (e) => {
          e.stopPropagation();
          const idx = Number(d.dataset["dot"]);
          if (idx === current) return;
          pauseAuto();
          goTo(idx);
          resumeAuto();
        });
      });

      /* ── Swipe / drag (respetando clicks en enlaces/botones) ── */
      let dragStartX = 0;
      let isDragging = false;

      root.addEventListener("pointerdown", (e: PointerEvent) => {
        const target = e.target as HTMLElement | null;
        if (target?.closest("a, button, nav, input, select")) {
          return;
        }
        dragStartX = e.clientX;
        isDragging = true;
        pauseAuto();
        (root as HTMLElement).setPointerCapture(e.pointerId);
      });

      root.addEventListener("pointerup", (e: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        const delta = e.clientX - dragStartX;
        if (Math.abs(delta) > SWIPE_THRESHOLD) {
          goTo(
            delta < 0 ? (current + 1) % total : (current - 1 + total) % total,
          );
        }
        resumeAuto();
      });

      /* ── Clic para abrir en Modo Viewport ── */
      root.addEventListener("click", (e: MouseEvent) => {
        const target = e.target as HTMLElement | null;
        if (target?.closest("button, nav, a, input, select")) return;
        const currentImg = slideEls[current]?.querySelector(".cge-bg-img") as HTMLImageElement;
        if (currentImg && (window as any).tgpOpenLightboxForSrc) {
          (window as any).tgpOpenLightboxForSrc(currentImg.src);
        }
      });

      root.addEventListener("pointercancel", () => {
        isDragging = false;
        resumeAuto();
      });

      /* ── Arranque ── */
      gsap.set(slideEls[0], { opacity: 1 });
      slideEls[0].classList.remove("pointer-events-none");
      slideEls[0].removeAttribute("aria-hidden");
      if (!reduceMotion) slideIn(slideEls[0], null);

      updateDots(0);
      startProgress();
      if (total > 1) scheduleNext();

      /* ── Cleanup ── */
      document.addEventListener(
        "astro:before-swap",
        () => {
          clearTimeout(autoTimer);
          clearTimeout(resumeTimer);
          progressTween?.kill();
          metaPulseTween?.kill();
          gsap.killTweensOf(slideEls);
          gsap.killTweensOf(Array.from(root.querySelectorAll(".cge-bg-img")));
        },
        { once: true },
      );
    });
  }

  document.addEventListener("DOMContentLoaded", initCGE);
  document.addEventListener("astro:page-load", initCGE);
</script>

<style>
  /* Evita drag de imagen nativo */
  .cge-root img {
    user-drag: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* Cursor grab en desktop y pointer en enlaces/botones */
  @media (pointer: fine) {
    .cge-root {
      cursor: grab;
    }
    .cge-root:active {
      cursor: grabbing;
    }

    .cge-root a,
    .cge-root button,
    .cge-root [role="button"],
    .cge-arrow,
    .cge-dot {
      cursor: pointer !important;
    }
  }

  /* GPU layers — backface-hidden estabiliza Z sin forzar preserve-3d en hijos GSAP */
  .cge-slide {
    will-change: opacity;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    /* NO preserve-3d aquí: conflicto con GSAP transforms en hijos */
    isolation: isolate;
  }
  .cge-bg-wrap {
    transform: translateZ(0);
    isolation: isolate;
  }
  .cge-bg-img {
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Dots: transición de ancho fluida */
  .cge-dot {
    transition:
      width 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.4s ease;
  }
</style>
