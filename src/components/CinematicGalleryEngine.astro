---
/**
 * CinematicGalleryEngine.astro
 * ──────────────────────────────────────────────────────────────────────────────
 * Motor cinemático adaptado para funcionar como Galería Inmersiva dentro de posts.
 */

export interface GallerySlideData {
  id: string;
  title: string;
  subtitle?: string;
  author?: string;
  license?: string;
  image: any;
  imagePosition?: string;
}

interface Props {
  slides: GallerySlideData[];
  heightClass?: string;
}

const { slides = [], heightClass = "h-[85vh] md:h-dvh" } = Astro.props;
const safeSlides = slides.length > 0 ? slides : [];
---

{
  safeSlides.length > 0 && (
    <section
      class={`cge-root relative w-full ${heightClass} overflow-hidden bg-[#0a0a0a] rounded-2xl select-none my-12 shadow-2xl border border-white/5`}
      aria-label="Galería Cinemática"
    >
      {/* ── SLIDES ── */}
      <div class="cge-slides absolute inset-0">
        {safeSlides.map((slide, i) => (
          <article
            class={`cge-slide absolute inset-0 flex items-end justify-start pb-20 md:pb-24 ${i === 0 ? "z-20" : "z-10 opacity-0 pointer-events-none"}`}
            data-index={i}
            {...(i !== 0 ? { "aria-hidden": "true" } : {})}
          >
            {/* Fondo: Ken Burns */}
            <div class="cge-bg-wrap absolute inset-0 overflow-hidden bg-black/80">
              <img
                src={
                  typeof slide.image === "string"
                    ? slide.image
                    : slide.image?.src || ""
                }
                alt={slide.title}
                class="cge-bg-img absolute inset-0 w-full h-full object-contain scale-100 opacity-95"
                style={`object-position: ${slide.imagePosition || "center center"};`}
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
              />
              {/* Gradiente editorial: oscurece base */}
              <div class="absolute inset-0 bg-linear-to-t from-[#0a0a0a] via-[#0a0a0a]/30 to-transparent pointer-events-none" />
            </div>

            {/* Contenido Editorial */}
            <div class="cge-content relative z-10 w-full max-w-5xl mx-auto px-6 md:px-12 flex flex-col items-start gap-2.5">
              {/* Metadatos superiores: Pulso suave GSAP */}
              <div class="cge-meta flex items-center gap-3">
                <span class="inline-flex items-center gap-2 font-mono text-[9px] md:text-[10px] uppercase tracking-[0.4em] text-[#C8A98B]">
                  <span class="cge-meta-dot w-1.5 h-1.5 rounded-full bg-[#C8A98B] inline-block shadow-[0_0_6px_rgba(200,169,139,0.8)]" />
                  LÁMINA {String(i + 1).padStart(2, '0')} / {String(safeSlides.length).padStart(2, '0')}
                </span>
                {slide.author && (
                  <span class="font-mono text-[8.5px] uppercase tracking-[0.3em] text-white/40 border-l border-white/20 pl-3">
                    {slide.author}
                  </span>
                )}
                {slide.license && (
                  <>
                    <span class="text-white/20 text-xs">·</span>
                    <span class="font-mono text-[8.5px] uppercase tracking-[0.25em] text-[#C8A98B]/60">
                      {slide.license}
                    </span>
                  </>
                )}
              </div>

              {/* Título estático */}
              <h3 class="cge-title font-serif font-bold text-xl md:text-3xl leading-snug tracking-tight text-stone-100 max-w-3xl drop-shadow-xl mt-1">
                {slide.title}
              </h3>

              {/* Subtítulo / excerpt */}
              {slide.subtitle && (
                <p class="cge-subtitle font-serif italic text-stone-300 text-sm md:text-base max-w-2xl leading-relaxed drop-shadow-md border-l-2 border-[#C8A98B]/50 pl-4 mt-2">
                  "{slide.subtitle}"
                </p>
              )}
            </div>
          </article>
        ))}
      </div>

      {/* ── TOOLBAR / CONTROLES AUTO-HIDE (dots, flechas) ── */}
      {safeSlides.length > 1 && (
        <div
          class="cge-toolbar absolute inset-0 w-full z-30 pointer-events-none opacity-0 transition-opacity duration-500"
        >
          {/* Dots de paginación */}
          <nav
            class="cge-dots absolute bottom-6 md:bottom-8 left-1/2 -translate-x-1/2 flex flex-wrap justify-center items-center gap-1.5 md:gap-2 max-w-[92vw] px-4 py-2 rounded-full bg-black/45 backdrop-blur-md border border-white/10 pointer-events-auto shadow-xl z-50"
            aria-label="Indicadores de slide"
          >
            {safeSlides.map((_, i) => (
              <button
                class={`cge-dot h-1.5 rounded-full transition-all duration-500 cursor-pointer border-0 p-0 ${i === 0 ? 'w-6 md:w-8 bg-[#C8A98B]' : 'w-1.5 md:w-2 bg-white/30 hover:bg-white/60'}`}
                data-dot={i}
                aria-label={`Ir al slide ${i + 1}`}
              />
            ))}
          </nav>

          {/* Flecha Anterior (Izquierda) */}
          <button
            class="cge-arrow cge-prev absolute left-4 md:left-8 top-1/2 -translate-y-1/2 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-full bg-black/45 backdrop-blur-sm border border-white/15 text-white/70 hover:bg-black/75 hover:border-[#C8A98B] hover:text-[#C8A98B] transition-all duration-300 active:scale-90 pointer-events-auto shadow-lg z-50"
            aria-label="Slide anterior"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>

          {/* Flecha Siguiente (Derecha) */}
          <button
            class="cge-arrow cge-next absolute right-4 md:right-8 top-1/2 -translate-y-1/2 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-full bg-black/45 backdrop-blur-sm border border-white/15 text-white/70 hover:bg-black/75 hover:border-[#C8A98B] hover:text-[#C8A98B] transition-all duration-300 active:scale-90 pointer-events-auto shadow-lg z-50"
            aria-label="Slide siguiente"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      )}
      
      {/* Barra de progreso */}
      <div class="absolute bottom-0 left-0 h-0.75 bg-[#C8A98B]/60 cge-progress z-30 shadow-[0_0_10px_rgba(200,169,139,0.5)]" style="width: 0%"></div>
    </section>
  )
}

<script>
  import gsap from "gsap";

  const SLIDE_DURATION = 8000; // ms por slide
  const AUTO_RESUME = 10000; // ms de inactividad → retoma auto
  const KB_SCALE = 1.05; // Ken Burns scale destino
  const FADE_DUR = 1.2; // s para cross-fade entre slides
  const SWIPE_THRESHOLD = 50; // px mínimos para contar como swipe

  function initCGE() {
    const roots = Array.from(
      document.querySelectorAll<HTMLElement>(".cge-root"),
    );
    if (roots.length === 0) return;

    roots.forEach((root) => {
      if (root.dataset.cgeInitialized === "true") return;
      root.dataset.cgeInitialized = "true";

      const slideEls = Array.from(
        root.querySelectorAll<HTMLElement>(".cge-slide"),
      );
      const dotEls = Array.from(root.querySelectorAll<HTMLElement>(".cge-dot"));
      const progress = root.querySelector<HTMLElement>(".cge-progress");
      const prevBtn = root.querySelector<HTMLElement>(".cge-prev");
      const nextBtn = root.querySelector<HTMLElement>(".cge-next");
      const toolbar = root.querySelector<HTMLElement>(".cge-toolbar");
      const total = slideEls.length;

      if (total === 0) return;

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      let current = 0;
      let isAnimating = false;
      let autoTimer: ReturnType<typeof setTimeout> | undefined;
      let resumeTimer: ReturnType<typeof setTimeout> | undefined;
      let toolbarTimer: ReturnType<typeof setTimeout> | undefined;
      let progressTween: gsap.core.Tween | undefined;
      let metaPulseTween: gsap.core.Tween | undefined;

      /* ── Auto-hide de Toolbar en movimiento / hover ── */
      function showToolbar() {
        if (!toolbar) return;
        toolbar.classList.remove("opacity-0");
        toolbar.classList.add("opacity-100");
      }

      function hideToolbar() {
        if (!toolbar) return;
        toolbar.classList.remove("opacity-100");
        toolbar.classList.add("opacity-0");
      }

      function resetToolbarTimer() {
        showToolbar();
        clearTimeout(toolbarTimer);
        toolbarTimer = setTimeout(() => {
          hideToolbar();
        }, 2800);
      }

      root.addEventListener("mousemove", resetToolbarTimer);
      root.addEventListener("mouseenter", resetToolbarTimer);
      root.addEventListener("touchstart", resetToolbarTimer, { passive: true });
      root.addEventListener("mouseleave", () => {
        clearTimeout(toolbarTimer);
        hideToolbar();
      });

      /* ── Entrada de slide ── */
      function slideIn(slide: HTMLElement, done: (() => void) | null) {
        const bg = slide.querySelector<HTMLElement>(".cge-bg-img");
        const metaEl = slide.querySelector<HTMLElement>(".cge-meta");
        const titleEl = slide.querySelector<HTMLElement>(".cge-title");
        const subEl = slide.querySelector<HTMLElement>(".cge-subtitle");
        const dot = slide.querySelector<HTMLElement>(".cge-meta-dot");

        slide.classList.remove("pointer-events-none");
        slide.setAttribute("aria-hidden", "false");
        slide.style.zIndex = "20";

        if (reduceMotion) {
          gsap.set(slide, { opacity: 1 });
          done?.();
          return;
        }

        const tl = gsap.timeline();

        /* Slide fade-in */
        tl.fromTo(
          slide,
          { opacity: 0 },
          { 
            opacity: 1, 
            duration: 0.85, 
            ease: "power2.inOut",
            onComplete: () => done?.()
          },
          0,
        );

        /* Ken Burns: escala milimétrica */
        if (bg) {
          gsap.set(bg, { scale: 1 });
          gsap.to(bg, {
            scale: KB_SCALE,
            duration: SLIDE_DURATION / 1000 + FADE_DUR,
            ease: "none",
          });
        }

        /* Textos: stagger desde abajo */
        const textEls = [metaEl, titleEl, subEl].filter(
          Boolean,
        ) as HTMLElement[];
        if (textEls.length > 0) {
          tl.fromTo(
            textEls,
            { opacity: 0, y: 15 },
            {
              opacity: 1,
              y: 0,
              duration: 0.65,
              stagger: 0.15,
              ease: "power3.out",
              clearProps: "transform",
            },
            0.35,
          );
        }

        /* Pulso del dot: yoyo opacidad */
        if (dot) {
          metaPulseTween?.kill();
          metaPulseTween = gsap.to(dot, {
            opacity: 0.35,
            duration: 1.4,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 0.8,
          });
        }
      }

      /* ── Salida de slide ── */
      function slideOut(slide: HTMLElement, done: (() => void) | null) {
        if (reduceMotion) {
          gsap.set(slide, { opacity: 0 });
          slide.classList.add("pointer-events-none");
          slide.setAttribute("aria-hidden", "true");
          slide.style.zIndex = "10";
          done?.();
          return;
        }
        gsap.to(slide, {
          opacity: 0,
          duration: FADE_DUR * 0.85,
          ease: "power2.inOut",
          onComplete: () => {
            slide.classList.add("pointer-events-none");
            slide.setAttribute("aria-hidden", "true");
            slide.style.zIndex = "10";
            done?.();
          },
        });
      }

      /* ── Dots ── */
      function updateDots(idx: number) {
        dotEls.forEach((d, i) => {
          const active = i === idx;
          d.classList.toggle("w-6", active);
          d.classList.toggle("md:w-8", active);
          d.classList.toggle("bg-[#C8A98B]", active);
          d.classList.toggle("w-1.5", !active);
          d.classList.toggle("md:w-2", !active);
          d.classList.toggle("bg-white/30", !active);
        });
      }

      /* ── Barra de progreso ── */
      function startProgress() {
        progressTween?.kill();
        if (!progress) return;
        gsap.set(progress, { width: "0%" });
        progressTween = gsap.to(progress, {
          width: "100%",
          duration: SLIDE_DURATION / 1000,
          ease: "none",
        });
      }

      /* ── Ir al slide idx ── */
      function goTo(idx: number) {
        if (isAnimating || idx === current) return;
        isAnimating = true;

        const prevIdx = current;
        const nextIdx = ((idx % total) + total) % total;
        current = nextIdx;
        updateDots(current);
        startProgress();

        slideEls[nextIdx].style.zIndex = "20";
        slideEls[prevIdx].style.zIndex = "15";

        /* Cross-fade */
        slideOut(slideEls[prevIdx], null);
        slideIn(slideEls[nextIdx], () => {
          isAnimating = false;
        });
      }

      /* ── Auto-avance ── */
      function scheduleNext() {
        clearTimeout(autoTimer);
        autoTimer = setTimeout(() => {
          goTo((current + 1) % total);
          scheduleNext();
        }, SLIDE_DURATION);
      }

      function pauseAuto() {
        clearTimeout(autoTimer);
        clearTimeout(resumeTimer);
        progressTween?.pause();
      }

      function resumeAuto() {
        clearTimeout(resumeTimer);
        resumeTimer = setTimeout(() => {
          progressTween?.play();
          scheduleNext();
        }, AUTO_RESUME);
      }

      /* ── Botones ── */
      prevBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        pauseAuto();
        goTo((current - 1 + total) % total);
        resumeAuto();
      });
      nextBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        pauseAuto();
        goTo((current + 1) % total);
        resumeAuto();
      });

      /* ── Dots click ── */
      dotEls.forEach((d) => {
        d.addEventListener("click", (e) => {
          e.stopPropagation();
          const idx = Number(d.dataset["dot"]);
          if (idx === current) return;
          pauseAuto();
          goTo(idx);
          resumeAuto();
        });
      });

      /* ── Swipe / drag (respetando clicks en enlaces/botones) ── */
      let dragStartX = 0;
      let isDragging = false;

      root.addEventListener("pointerdown", (e: PointerEvent) => {
        const target = e.target as HTMLElement | null;
        if (target?.closest("a, button, nav, input, select")) {
          return;
        }
        dragStartX = e.clientX;
        isDragging = true;
        pauseAuto();
        (root as HTMLElement).setPointerCapture(e.pointerId);
      });

      root.addEventListener("pointerup", (e: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        const delta = e.clientX - dragStartX;
        if (Math.abs(delta) > SWIPE_THRESHOLD) {
          goTo(
            delta < 0 ? (current + 1) % total : (current - 1 + total) % total,
          );
        }
        resumeAuto();
      });

      root.addEventListener("pointercancel", () => {
        isDragging = false;
        resumeAuto();
      });

      /* ── Arranque ── */
      gsap.set(slideEls[0], { opacity: 1 });
      slideEls[0].classList.remove("pointer-events-none");
      slideEls[0].removeAttribute("aria-hidden");
      if (!reduceMotion) slideIn(slideEls[0], null);

      updateDots(0);
      startProgress();
      resetToolbarTimer();
      if (total > 1) scheduleNext();

      /* ── Cleanup ── */
      document.addEventListener(
        "astro:before-swap",
        () => {
          clearTimeout(autoTimer);
          clearTimeout(resumeTimer);
          clearTimeout(toolbarTimer);
          progressTween?.kill();
          metaPulseTween?.kill();
          gsap.killTweensOf(slideEls);
          gsap.killTweensOf(Array.from(root.querySelectorAll(".cge-bg-img")));
        },
        { once: true },
      );
    });
  }

  document.addEventListener("DOMContentLoaded", initCGE);
  document.addEventListener("astro:page-load", initCGE);
</script>

<style>
  /* Evita drag de imagen nativo */
  .cge-root img {
    user-drag: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* Cursor grab en desktop y pointer en enlaces/botones */
  @media (pointer: fine) {
    .cge-root {
      cursor: grab;
    }
    .cge-root:active {
      cursor: grabbing;
    }

    .cge-root a,
    .cge-root button,
    .cge-root [role="button"],
    .cge-arrow,
    .cge-dot {
      cursor: pointer !important;
    }
  }

  /* GPU layers para fluidez */
  .cge-slide {
    will-change: opacity;
  }
  .cge-bg-img {
    will-change: transform;
  }

  /* Dots: transición de ancho fluida */
  .cge-dot {
    transition:
      width 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.4s ease;
  }
</style>
