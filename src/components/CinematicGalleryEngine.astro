---
import Image from './SafeImage.astro';
import { sanitizeImageUrl } from "../lib/content-filter";

/**
 * CinematicGalleryEngine.astro
 * ──────────────────────────────────────────────────────────────────────────────
 * Motor cinemático adaptado para funcionar como Galería Inmersiva dentro de posts.
 */

export interface GallerySlideData {
  id: string;
  title: string;
  subtitle?: string;
  author?: string;
  license?: string;
  image: any;
  imagePosition?: string;
}

interface Props {
  slides: GallerySlideData[];
  heightClass?: string;
  maxSlides?: number;
}

const { slides = [], heightClass = "h-[85vh] md:h-dvh", maxSlides = 15 } = Astro.props;
const safeSlides = (slides.length > 0 ? slides : []).slice(0, maxSlides);
---

{
  safeSlides.length > 0 && (
    <section
      class={`cge-root relative w-full ${heightClass} overflow-hidden bg-[#0a0a0a] rounded-2xl select-none my-12 md:shadow-2xl border border-white/5 cursor-zoom-in [contain-intrinsic-size:auto_85vh]`}
      aria-label="Galería Cinemática"
    >
      {/* ── SLIDES ── */}
      <div class="cge-slides absolute inset-0">
        {safeSlides.map((slide, i) => {
          const safeSrc = sanitizeImageUrl(slide.image);
          return (
            <article
              class={`cge-slide absolute inset-0 flex items-end justify-start pb-20 md:pb-24 [content-visibility:auto] contain-content ${i === 0 ? "z-20" : "z-10 opacity-0 pointer-events-none"}`}
              data-index={i}
              {...(i !== 0 ? { "aria-hidden": "true" } : {})}
            >
              {/* Fondo: Ken Burns */}
              <div class="cge-bg-wrap absolute inset-0 overflow-hidden bg-[#0a0a0a]">
                {safeSrc ? (
                  <Image
                    src={safeSrc}
                    alt={slide.title}
                    class="cge-bg-img absolute inset-0 w-full h-full object-contain scale-100"
                    style={`object-position: ${slide.imagePosition || "center center"};`}
                    inferSize={true}
                    format="webp"
                    widths={[400, 768, 1200, 1920]}
                    sizes="(max-width: 768px) 400px, (max-width: 1200px) 768px, 1200px"
                    loading={i < 2 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : undefined}
                    decoding="async"
                  />
                ) : (
                  <div class="fallback-background absolute inset-0 bg-stone-900 pointer-events-none -z-10" />
                )}
                {/* Gradiente editorial mínimo: solo oscurece la zona inferior donde va el texto */}
                <div class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-[#0a0a0a]/80 to-transparent pointer-events-none" />
              </div>

              {/* Contenido Editorial Minimalista & Thin */}
              <div class="cge-content relative z-10 w-full max-w-4xl mx-auto px-6 md:px-12 flex flex-col items-center text-center gap-2 transition-opacity duration-700 pointer-events-none">
                {/* Metadatos superiores Thin */}
                <div class="cge-meta flex items-center justify-center gap-3 font-metadata font-light text-[8px] md:text-[9px] uppercase tracking-[0.35em] text-[#EFEBE3]/45">
                  <span class="inline-flex items-center gap-2">
                    <span class="cge-meta-dot w-1 h-1 rounded-full bg-[#EFEBE3]/60 inline-block" />
                    LÁMINA {String(i + 1).padStart(2, '0')} / {String(safeSlides.length).padStart(2, '0')}
                  </span>
                  {slide.author && (
                    <>
                      <span class="opacity-25">·</span>
                      <span class="text-white/40">{slide.author}</span>
                    </>
                  )}
                  {slide.license && (
                    <>
                      <span class="opacity-25">·</span>
                      <span class="text-[#EFEBE3]/40">{slide.license}</span>
                    </>
                  )}
                </div>

                {/* Título estático Thin / Minimal */}
                <h3 class="cge-title font-cinzel font-light text-lg md:text-2xl leading-snug tracking-wider text-[#EFEBE3]/90 max-w-2xl drop-shadow-md">
                  {slide.title}
                </h3>

                {/* Subtítulo / excerpt minimalista */}
                {slide.subtitle && (
                  <p class="cge-subtitle font-serif font-light italic text-[#EFEBE3]/60 text-xs md:text-sm max-w-xl leading-relaxed">
                    "{slide.subtitle}"
                  </p>
                )}
              </div>
            </article>
          );
        })}
      </div>

      {/* ── TOOLBAR / CONTROLES AUTO-HIDE (dots, flechas) ── */}
      {safeSlides.length > 1 && (
        <div
          class="cge-toolbar absolute inset-0 w-full z-30 pointer-events-none opacity-0 transition-opacity duration-500"
        >
          {/* Dots de paginación */}
          <nav
            class="cge-dots absolute bottom-5 md:bottom-6 left-1/2 -translate-x-1/2 flex flex-wrap justify-center items-center gap-1.5 md:gap-2 max-w-[92vw] px-3.5 py-1.5 rounded-full bg-black/45 backdrop-blur-md border border-white/10 pointer-events-auto shadow-xl z-50"
            aria-label="Indicadores de slide"
          >
            {safeSlides.map((_, i) => (
              <button
                class={`cge-dot h-1 rounded-full transition-all duration-500 cursor-pointer border-0 p-0 ${i === 0 ? 'w-5 md:w-7 bg-[#EFEBE3]' : 'w-1 md:w-1.5 bg-white/30 hover:bg-white/60'}`}
                data-dot={i}
                aria-label={`Ir al slide ${i + 1}`}
              />
            ))}
          </nav>

          {/* Flecha Anterior (Izquierda) */}
          <button
            class="cge-arrow cge-prev absolute left-4 md:left-8 top-1/2 -translate-y-1/2 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-full bg-black/45 backdrop-blur-sm border border-white/15 text-white/70 hover:bg-black/75 hover:border-[#EFEBE3] hover:text-[#EFEBE3] transition-all duration-300 active:scale-90 pointer-events-auto shadow-lg z-50"
            aria-label="Slide anterior"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>

          {/* Flecha Siguiente (Derecha) */}
          <button
            class="cge-arrow cge-next absolute right-4 md:right-8 top-1/2 -translate-y-1/2 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-full bg-black/45 backdrop-blur-sm border border-white/15 text-white/70 hover:bg-black/75 hover:border-[#EFEBE3] hover:text-[#EFEBE3] transition-all duration-300 active:scale-90 pointer-events-auto shadow-lg z-50"
            aria-label="Slide siguiente"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      )}
      
      {/* Barra de progreso — Línea punteada estática */}
      <div class="absolute bottom-0 left-0 w-full h-0.5 border-b border-dotted border-[#EFEBE3]/25 cge-progress z-30"></div>
    </section>
  )
}

<script>
  import gsap from "gsap";

  const SLIDE_DURATION = 8000; // ms por slide
  const AUTO_RESUME = 10000; // ms de inactividad → retoma auto
  const KB_SCALE = 1.05; // Ken Burns scale destino
  const FADE_DUR = 1.2; // s para cross-fade entre slides
  const SWIPE_THRESHOLD = 50; // px mínimos para contar como swipe

  function initCGE() {
    const roots = Array.from(
      document.querySelectorAll<HTMLElement>(".cge-root"),
    );
    if (roots.length === 0) return;

    roots.forEach((root) => {
      if (root.dataset.cgeInitialized === "true") return;
      root.dataset.cgeInitialized = "true";

      const slideEls = Array.from(
        root.querySelectorAll<HTMLElement>(".cge-slide"),
      );
      const dotEls = Array.from(root.querySelectorAll<HTMLElement>(".cge-dot"));
      const progress = root.querySelector<HTMLElement>(".cge-progress");
      const prevBtn = root.querySelector<HTMLElement>(".cge-prev");
      const nextBtn = root.querySelector<HTMLElement>(".cge-next");
      const toolbar = root.querySelector<HTMLElement>(".cge-toolbar");
      const total = slideEls.length;

      if (total === 0) return;

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      let current = 0;
      let isAnimating = false;
      let autoTimer: ReturnType<typeof setTimeout> | undefined;
      let resumeTimer: ReturnType<typeof setTimeout> | undefined;
      let toolbarTimer: ReturnType<typeof setTimeout> | undefined;
      let progressTween: gsap.core.Tween | undefined;
      let metaPulseTween: gsap.core.Tween | undefined;

      /* ── Auto-hide de Toolbar en movimiento / hover ── */
      function showToolbar() {
        if (!toolbar) return;
        toolbar.classList.remove("opacity-0");
        toolbar.classList.add("opacity-100");
      }

      function hideToolbar() {
        if (!toolbar) return;
        toolbar.classList.remove("opacity-100");
        toolbar.classList.add("opacity-0");
      }

      function resetToolbarTimer() {
        showToolbar();
        clearTimeout(toolbarTimer);
        toolbarTimer = setTimeout(() => {
          hideToolbar();
        }, 2800);
      }

      root.addEventListener("mousemove", resetToolbarTimer);
      root.addEventListener("mouseenter", resetToolbarTimer);
      root.addEventListener("touchstart", resetToolbarTimer, { passive: true });
      root.addEventListener("mouseleave", () => {
        clearTimeout(toolbarTimer);
        hideToolbar();
      });

      /* ── Entrada de slide ── */
      function slideIn(slide: HTMLElement, done: (() => void) | null) {
        const bg = slide.querySelector<HTMLElement>(".cge-bg-img");
        const metaEl = slide.querySelector<HTMLElement>(".cge-meta");
        const titleEl = slide.querySelector<HTMLElement>(".cge-title");
        const subEl = slide.querySelector<HTMLElement>(".cge-subtitle");
        const dot = slide.querySelector<HTMLElement>(".cge-meta-dot");

        slide.classList.remove("pointer-events-none");
        slide.setAttribute("aria-hidden", "false");
        slide.style.zIndex = "20";

        if (reduceMotion) {
          gsap.set(slide, { opacity: 1 });
          done?.();
          return;
        }

        const tl = gsap.timeline();

        /* Slide fade-in */
        tl.fromTo(
          slide,
          { opacity: 0 },
          { 
            opacity: 1, 
            duration: 0.85, 
            ease: "power2.inOut",
            onComplete: () => done?.()
          },
          0,
        );

        /* Ken Burns: escala milimétrica */
        if (bg) {
          gsap.set(bg, { scale: 1 });
          gsap.to(bg, {
            scale: KB_SCALE,
            duration: SLIDE_DURATION / 1000 + FADE_DUR,
            ease: "none",
          });
        }

        /* Textos: stagger desde abajo */
        const textEls = [metaEl, titleEl, subEl].filter(
          Boolean,
        ) as HTMLElement[];
        if (textEls.length > 0) {
          tl.fromTo(
            textEls,
            { opacity: 0, y: 15 },
            {
              opacity: 1,
              y: 0,
              duration: 0.65,
              stagger: 0.15,
              ease: "power3.out",
              clearProps: "transform",
            },
            0.35,
          );
        }

        /* Pulso del dot: yoyo opacidad */
        if (dot) {
          metaPulseTween?.kill();
          metaPulseTween = gsap.to(dot, {
            opacity: 0.35,
            duration: 1.4,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 0.8,
          });
        }
      }

      /* ── Salida de slide ── */
      function slideOut(slide: HTMLElement, done: (() => void) | null) {
        if (reduceMotion) {
          gsap.set(slide, { opacity: 0 });
          slide.classList.add("pointer-events-none");
          slide.setAttribute("aria-hidden", "true");
          slide.style.zIndex = "10";
          done?.();
          return;
        }
        gsap.to(slide, {
          opacity: 0,
          duration: FADE_DUR * 0.85,
          ease: "power2.inOut",
          onComplete: () => {
            slide.classList.add("pointer-events-none");
            slide.setAttribute("aria-hidden", "true");
            slide.style.zIndex = "10";
            done?.();
          },
        });
      }

      /* ── Dots ── */
      function updateDots(idx: number) {
        dotEls.forEach((d, i) => {
          const active = i === idx;
          d.classList.toggle("w-6", active);
          d.classList.toggle("md:w-8", active);
          d.classList.toggle("bg-[#EFEBE3]", active);
          d.classList.toggle("w-1.5", !active);
          d.classList.toggle("md:w-2", !active);
          d.classList.toggle("bg-white/30", !active);
        });
      }

      /* ── Barra de progreso ── */
      function startProgress() {
        progressTween?.kill();
        // Dejar línea punteada estática
      }

      /* ── Ir al slide idx ── */
      function goTo(idx: number) {
        if (isAnimating || idx === current) return;
        isAnimating = true;

        const prevIdx = current;
        const nextIdx = ((idx % total) + total) % total;
        current = nextIdx;
        updateDots(current);
        startProgress();

        slideEls[nextIdx].style.zIndex = "20";
        slideEls[prevIdx].style.zIndex = "15";

        /* Cross-fade */
        slideOut(slideEls[prevIdx], null);
        slideIn(slideEls[nextIdx], () => {
          isAnimating = false;
        });
      }

      /* ── Auto-avance ── */
      function scheduleNext() {
        clearTimeout(autoTimer);
        autoTimer = setTimeout(() => {
          goTo((current + 1) % total);
          scheduleNext();
        }, SLIDE_DURATION);
      }

      function pauseAuto() {
        clearTimeout(autoTimer);
        clearTimeout(resumeTimer);
        progressTween?.pause();
      }

      function resumeAuto() {
        clearTimeout(resumeTimer);
        resumeTimer = setTimeout(() => {
          progressTween?.play();
          scheduleNext();
        }, AUTO_RESUME);
      }

      /* ── Botones ── */
      prevBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        pauseAuto();
        goTo((current - 1 + total) % total);
        resumeAuto();
      });
      nextBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        pauseAuto();
        goTo((current + 1) % total);
        resumeAuto();
      });

      /* ── Dots click ── */
      dotEls.forEach((d) => {
        d.addEventListener("click", (e) => {
          e.stopPropagation();
          const idx = Number(d.dataset["dot"]);
          if (idx === current) return;
          pauseAuto();
          goTo(idx);
          resumeAuto();
        });
      });

      /* ── Swipe / drag (respetando clicks en enlaces/botones) ── */
      let dragStartX = 0;
      let isDragging = false;

      root.addEventListener("pointerdown", (e: PointerEvent) => {
        const target = e.target as HTMLElement | null;
        if (target?.closest("a, button, nav, input, select")) {
          return;
        }
        dragStartX = e.clientX;
        isDragging = true;
        pauseAuto();
        (root as HTMLElement).setPointerCapture(e.pointerId);
      });

      root.addEventListener("pointerup", (e: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        const delta = e.clientX - dragStartX;
        if (Math.abs(delta) > SWIPE_THRESHOLD) {
          goTo(
            delta < 0 ? (current + 1) % total : (current - 1 + total) % total,
          );
        }
        resumeAuto();
      });

      /* ── Clic para abrir en Modo Viewport ── */
      root.addEventListener("click", (e: MouseEvent) => {
        const target = e.target as HTMLElement | null;
        if (target?.closest("button, nav, a, input, select")) return;
        const currentImg = slideEls[current]?.querySelector(".cge-bg-img") as HTMLImageElement;
        if (currentImg && (window as any).tgpOpenLightboxForSrc) {
          (window as any).tgpOpenLightboxForSrc(currentImg.src);
        }
      });

      root.addEventListener("pointercancel", () => {
        isDragging = false;
        resumeAuto();
      });

      /* ── Arranque ── */
      gsap.set(slideEls[0], { opacity: 1 });
      slideEls[0].classList.remove("pointer-events-none");
      slideEls[0].removeAttribute("aria-hidden");
      if (!reduceMotion) slideIn(slideEls[0], null);

      updateDots(0);
      startProgress();
      resetToolbarTimer();
      if (total > 1) scheduleNext();

      /* ── Cleanup ── */
      document.addEventListener(
        "astro:before-swap",
        () => {
          clearTimeout(autoTimer);
          clearTimeout(resumeTimer);
          clearTimeout(toolbarTimer);
          progressTween?.kill();
          metaPulseTween?.kill();
          gsap.killTweensOf(slideEls);
          gsap.killTweensOf(Array.from(root.querySelectorAll(".cge-bg-img")));
        },
        { once: true },
      );
    });
  }

  document.addEventListener("DOMContentLoaded", initCGE);
  document.addEventListener("astro:page-load", initCGE);
</script>

<style>
  /* Evita drag de imagen nativo */
  .cge-root img {
    user-drag: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* Cursor grab en desktop y pointer en enlaces/botones */
  @media (pointer: fine) {
    .cge-root {
      cursor: grab;
    }
    .cge-root:active {
      cursor: grabbing;
    }

    .cge-root a,
    .cge-root button,
    .cge-root [role="button"],
    .cge-arrow,
    .cge-dot {
      cursor: pointer !important;
    }
  }

  /* GPU layers — backface-hidden estabiliza Z sin forzar preserve-3d en hijos GSAP */
  .cge-slide {
    will-change: opacity;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    /* NO preserve-3d aquí: conflicto con GSAP transforms en hijos */
    isolation: isolate;
  }
  .cge-bg-wrap {
    transform: translateZ(0);
    isolation: isolate;
  }
  .cge-bg-img {
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Dots: transición de ancho fluida */
  .cge-dot {
    transition:
      width 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.4s ease;
  }
</style>
