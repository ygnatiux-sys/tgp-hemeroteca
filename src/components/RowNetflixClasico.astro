---
import { resolveMultivisionClass } from "../lib/multivision";
/**
 * RowNetflixClasico.astro
 * Componente de Carrusel Netflix Clásico Vertical (Sibling Push + Hover Delay + Paginación)
 * 4 Columnas visibles en Desktop con soporte para colecciones de TGP.
 */
import Image from './SafeImage.astro';
import ExpandableModal from './ExpandableModal.astro';
import { resolveEssayImage, sanitizeImageUrl, formatCategory, formatDate } from "../lib/content-filter";

interface Props {
  title?: string;
  eyebrow?: string;
  items?: Array<{
    title?: string;
    titulo?: string;
    subtitle?: string;
    excerpt?: string;
    image?: string | any;
    img?: string | any;
    link?: string;
    slug?: string;
    collectionLabel?: string;
    category?: string;
    date?: string;
    entry?: any;
  }>;
  max?: number;
  actionText?: string;
  actionHref?: string;
  cardAspect?: "vertical" | "horizontal";
}

const { 
  title = "También podrían gustarte",
  eyebrow = "Colecciones",
  items = [],
  max = 15,
  actionText,
  actionHref,
  cardAspect = "vertical"
} = Astro.props;

// Normalizamos los items
let displayItems = items.slice(0, max).map((item) => {
  const rawImg = item.img || item.image || resolveEssayImage(item.entry || item, item.slug);
  const image = sanitizeImageUrl(typeof rawImg === 'object' && rawImg?.src ? rawImg.src : (typeof rawImg === 'string' ? rawImg : '')) || 'https://images.unsplash.com/photo-1547036967-23d11aacaee0?q=80&w=1200&auto=format&fit=crop';
  
  if (import.meta.env.DEV) {
    if (image.includes('hero-') || image.includes('pano-') || image.includes('cover-')) {
      console.warn(`[TGP Vision] Advertencia: Se inyectó una imagen panorámica (${image.split('/').pop()}) en un contenedor vertical. Aplicando fallback cinemático.`);
    }
  }

  const t = item.title || item.titulo || item.entry?.title || "Sin título";
  const cat = item.collectionLabel || formatCategory(item.category || item.entry?.category) || "Ensayo";
  const isCinematic = (item as any)?.isCinematicGSAP || (item.entry as any)?.isCinematicGSAP;
  const link = item.link || (item.slug ? (isCinematic ? `/ensayos-cinematicos/${item.slug}` : `/hemeroteca/${item.slug}/`) : '#');
  const d = item.date || item.entry?.date ? formatDate(item.date || item.entry?.date) : '';

  const entry = item.entry || (item as any);
  const font = (entry?.font || '').toLowerCase();
  const themeColor = (entry?.themeColor || '').toLowerCase();
  const isGloock = font === 'gloock';

  let customColorClass = '';
  if (themeColor === 'bordeaux') customColorClass = 'text-[#df7a7e]';
  else if (themeColor === 'british-green') customColorClass = 'text-[#68b68f]';
  else if (themeColor === 'old-navy') customColorClass = 'text-[#8ab7e0]';
  else if (themeColor === 'vintage-yellow') customColorClass = 'text-[#f0e2a8]';
  else if (themeColor === 'rust-orange') customColorClass = 'text-[#e07a5f]';
  else if (themeColor === 'bus-red') customColorClass = 'text-[#e55353]';

  return {
    title: t,
    subtitle: item.subtitle || item.excerpt || item.entry?.excerpt || item.entry?.dek || item.entry?.volanta || '',
    image,
    link,
    collectionLabel: cat,
    date: d,
    isGloock,
    customColorClass,
  };
});

// Sanitización segura de caracteres
displayItems = displayItems.map(item => ({
  ...item,
  title: item.title || '',
}));

const uid = `row-${Math.random().toString(36).substring(2, 8)}`;
---

<section 
  id={uid} 
  class="netflix-row-root w-full py-6 md:py-10 relative group/section"
  style="overflow-x: clip; overflow-y: visible;"
  data-aspect={cardAspect}
  aria-label={title}
>
  <!-- Encabezado de la fila -->
  {title && (
    <div class="mb-4 px-2 md:px-4 z-20 relative flex items-end justify-between gap-4">
      <div>
        {eyebrow && (
          <span class="text-[8.5px] md:text-[9px] tracking-[0.4em] uppercase font-metadata text-rust-orange/90 font-bold block mb-1">
            {eyebrow}
          </span>
        )}
        <h3 class="text-white text-xl md:text-2xl font-cinzel font-bold tracking-tight leading-tight">
          {title}
        </h3>
      </div>
      
      <div class="flex items-center gap-4">
        <span class="text-[8.5px] font-metadata tracking-[0.25em] text-white/30 uppercase hidden sm:inline-block">
          {displayItems.length} Artículos
        </span>
        {actionText && actionHref && (
          <a href={actionHref} class="font-metadata text-[10px] uppercase tracking-[0.3em] text-white/50 hover:text-rust-orange hover:drop-shadow-[0_0_8px_rgba(239,235,227,0.5)] transition-all">
            {actionText}
          </a>
        )}
      </div>
    </div>
  )}

  <!-- Contenedor Maestro -->
  <div class="relative w-full px-2 md:px-4">
    
    <!-- Botón Anterior Flotante en Cápsula -->
    <button 
      class="nav-btn prev-btn absolute left-0 md:left-1 top-1/2 -translate-y-1/2 z-40 w-9 md:w-10 h-16 md:h-20 rounded-full bg-black/40 hover:bg-black/85 text-[#E3DDD3]/40 hover:text-[#EFEBE3] border border-[#E3DDD3]/10 hover:border-[#E3DDD3]/30 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-70 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none disabled:opacity-0 disabled:pointer-events-none"
      aria-label="Anterior"
    >
      <svg class="w-5 h-5 -translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>

    <!-- Botón Siguiente Flotante en Cápsula -->
    <button 
      class="nav-btn next-btn absolute right-0 md:right-1 top-1/2 -translate-y-1/2 z-40 w-9 md:w-10 h-16 md:h-20 rounded-full bg-black/40 hover:bg-black/85 text-[#E3DDD3]/40 hover:text-[#EFEBE3] border border-[#E3DDD3]/10 hover:border-[#E3DDD3]/30 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-70 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none disabled:opacity-0 disabled:pointer-events-none"
      aria-label="Siguiente"
    >
      <svg class="w-5 h-5 translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>

    <!-- Pista de Deslizamiento (Modo Tray Circular Plano) -->
    <div class="gallery-tray-wrapper">
      <!-- Fade masks laterales -->
      <div class="gallery-fade-left" aria-hidden="true"></div>
      <div class="gallery-fade-right" aria-hidden="true"></div>
      <div class="gallery-tray">
        
        {displayItems.map((item, index) => {
          const cardId = `${uid}-${index}`;
          return (
          <article 
            class="gallery-card" 
            data-card-index={index}
            data-flip-id={`card-container-${cardId}`}
          >
            <a href={item.link} 
               class="absolute inset-0 w-full h-full gallery-card-link block" 
               aria-label={`Ver: ${item.title}`}
               data-card-id={cardId}
               data-title={item.title}
               data-eyebrow={item.collectionLabel}
               data-eyebrow-class={item.customColorClass || 'text-rust-orange'}
               data-excerpt={item.subtitle}
               data-image={item.image}
               data-link={item.link}>
              
              {/* Imagen Base Pura al 100% sin overlay global */}
              <div class="absolute inset-0 w-full h-full overflow-hidden bg-[#0a0c0f] pointer-events-none">
                <Image 
                  src={item.image} 
                  alt={item.title} 
                  inferSize={true}
                  format="webp"
                  widths={[400, 768, 1200]}
                  sizes="(max-width: 768px) 360px, 480px"
                  class="gallery-card-img absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
                  loading="lazy"
                  decoding="async"
                  data-flip-id={`card-image-${cardId}`}
                />
              </div>

              {/* Scrim Localizado (Franja inferior para contraste sobre imagen cover) */}
              <div class="absolute bottom-0 inset-x-0 w-full h-[55%] sm:h-[50%] bg-linear-to-t from-black/95 via-black/70 to-transparent pointer-events-none z-0"></div>

              {/* Contenedor del Texto (Z-Index) */}
              <div class="absolute bottom-0 left-0 p-4 sm:p-5 flex flex-col justify-end gap-1.5 z-10 w-full md:w-[90%] pointer-events-auto select-text cursor-text">
                <span class="uppercase font-metadata font-bold block line-clamp-1 text-[11px] sm:text-xs tracking-[0.3em] text-rust-orange/90 select-text">
                  {item.collectionLabel}
                </span>

                <h4 class:list={[
                  "gallery-card-title line-clamp-2 leading-tight transition-all duration-300 tracking-wide sm:tracking-wider gradient-general-h2 select-text",
                  item.isGloock
                    ? "font-gloock font-bold text-[18px] sm:text-[20px]"
                    : "font-alegreya font-extrabold text-[18px] sm:text-[20px] md:text-[22px]"
                ]} data-flip-id={`card-title-${cardId}`}>
                  {item.title}
                </h4>

                {item.subtitle && (
                  <p class="font-proza font-light text-[14px] sm:text-[15px] text-white/70 line-clamp-2 leading-tight mt-1 select-text">
                    {item.subtitle}
                  </p>
                )}
              </div>
            </a>
          </article>
        )})}
      </div>
    </div><!-- /gallery-tray-wrapper -->
  </div>

</section>

<style>
  /* ── WRAPPER: define la altura base, pero permite overflow vertical para no cortar las cards ── */
  .gallery-tray-wrapper {
    position: relative;
    width: 100%;
    height: 75vh;
    min-height: 480px;
    max-height: 660px;
    overflow-x: clip;
    overflow-y: visible;
    margin: 1.5rem 0;
  }
  @media (min-width: 768px) {
    .gallery-tray-wrapper {
      height: 75vh;
      min-height: 520px;
      max-height: 720px;
    }
  }

  /* Fade masks: difuminan el borde para que las tarjetas laterales se vean cortadas elegantemente */
  .gallery-fade-left,
  .gallery-fade-right {
    pointer-events: none;
    position: absolute;
    top: 0; bottom: 0;
    width: 12%;
    z-index: 30;
  }
  .gallery-fade-left  { left:  0; background: linear-gradient(to right, var(--bg-main, #0f1110) 5%, transparent); }
  .gallery-fade-right { right: 0; background: linear-gradient(to left,  var(--bg-main, #0f1110) 5%, transparent); }

  /* ── TRAY: contenedor de posición absoluta ── */
  .gallery-tray {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* ── CARD: dimensionada por ancho para asegurar la cinta. Aspect ratio más cuadrado para dar espacio al texto ── */
  .gallery-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 68%;
    height: auto;
    aspect-ratio: 10 / 14.5; /* Más larga hacia abajo en móvil */
    max-width: none;
    cursor: pointer;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    background: #0a0c0f;

    /* Estado pasante por defecto */
    transform: translate(-50%, -50%) scale(0.85);
    opacity: 0.45;
    filter: brightness(0.55);

    will-change: transform, left, opacity, filter;
    transition:
      transform      580ms cubic-bezier(0.25, 1, 0.5, 1),
      left           580ms cubic-bezier(0.25, 1, 0.5, 1),
      opacity        580ms ease,
      filter         580ms ease,
      border-color   300ms ease;
  }

  @media (min-width: 640px) {
    .gallery-card {
      width: 52%;
      aspect-ratio: 10 / 12.5; /* Más larga hacia abajo en tablet */
      border-radius: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery-card {
      width: 42%;
      aspect-ratio: 10 / 11.5; /* 15% más larga hacia abajo que un cuadrado (1:1) */
      border-radius: 1.5rem;
    }
  }

  /* Estado activo (centro) */
  .gallery-card.is-active {
    opacity: 1;
    filter: brightness(1);
    border-color: rgba(255,255,255,0.2);
    z-index: 20;
    pointer-events: auto;
  }

  .gallery-card-link {
    display: block;
    height: 100%;
    width: 100%;
  }

  .gallery-card-img {
    filter: brightness(0.9) contrast(1.04);
    transition: filter 340ms ease;
  }
  .gallery-card.is-active .gallery-card-img {
    filter: brightness(1) contrast(1.04);
  }
  .gallery-card:hover { border-color: rgba(255,255,255,0.25); }
</style>

<script>
  function initGalleryRows() {
    const rows = document.querySelectorAll<HTMLElement>('.netflix-row-root');

    rows.forEach(row => {
      if (row.hasAttribute('data-init-gallery')) return;
      row.setAttribute('data-init-gallery', 'true');

      const wrapper = row.querySelector<HTMLElement>('.gallery-tray-wrapper');
      const cards   = Array.from(row.querySelectorAll<HTMLElement>('.gallery-card'));
      const prevBtn = row.querySelector<HTMLButtonElement>('.prev-btn');
      const nextBtn = row.querySelector<HTMLButtonElement>('.next-btn');

      if (!wrapper || cards.length === 0) return;

      const total = cards.length;
      let currentIndex = 0;

      function updateCards() {
        // Separación horizontal según viewport (% del wrapper) calibrada para 3 cards con gap elegante
        const w = window.innerWidth;
        const isMobile = w < 640;
        const isTablet = w >= 640 && w < 1024;
        const step = isMobile ? 60 : (isTablet ? 45 : 42); // %

        cards.forEach((card, idx) => {
          let diff = idx - currentIndex;

          // Envoltura circular seamless
          if (diff >  total / 2) diff -= total;
          if (diff < -total / 2) diff += total;

          if (diff === 0) {
            // ── CENTRO: dominante, grande, brillante ──
            card.style.left      = '50%';
            card.style.transform = 'translate(-50%, -50%) scale(1.06)';
            card.style.opacity   = '1';
            card.style.filter    = 'brightness(1)';
            card.style.zIndex    = '20';
            card.style.pointerEvents = 'auto';
            card.classList.add('is-active');

          } else if (Math.abs(diff) === 1) {
            // ── LATERALES: en sombra, con padding y escala reducida ──
            card.style.left      = `calc(50% + ${diff * step}%)`;
            card.style.transform = 'translate(-50%, -50%) scale(0.82)';
            card.style.opacity   = '0.48';
            card.style.filter    = 'brightness(0.55)';
            card.style.zIndex    = '10';
            card.style.pointerEvents = 'auto';
            card.classList.remove('is-active');

          } else {
            // ── OCULTAS: teletransportadas silenciosamente al otro flanco ──
            const dir = diff < 0 ? -1 : 1;
            card.style.left      = `calc(50% + ${dir * 130}%)`;
            card.style.transform = 'translate(-50%, -50%) scale(0.70)';
            card.style.opacity   = '0';
            card.style.filter    = 'brightness(0.2)';
            card.style.zIndex    = '0';
            card.style.pointerEvents = 'none';
            card.classList.remove('is-active');
          }
        });
      }

      function goTo(index: number) {
        currentIndex = (index + total) % total;
        updateCards();
      }

      if (nextBtn) nextBtn.addEventListener('click', e => { e.preventDefault(); goTo(currentIndex + 1); });
      if (prevBtn) prevBtn.addEventListener('click', e => { e.preventDefault(); goTo(currentIndex - 1); });

      // Click en tarjeta lateral la trae al centro
      cards.forEach((card, idx) => {
        card.addEventListener('click', e => {
          if (idx !== currentIndex) {
            e.preventDefault();
            goTo(idx);
          }
        });
      });

      // Swipe touch
      let touchStartX = 0;
      wrapper.addEventListener('touchstart', (e: TouchEvent) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });
      wrapper.addEventListener('touchend', (e: TouchEvent) => {
        const diff = touchStartX - e.changedTouches[0].screenX;
        if (Math.abs(diff) > 40) diff > 0 ? goTo(currentIndex + 1) : goTo(currentIndex - 1);
      }, { passive: true });

      // Wheel horizontal
      wrapper.addEventListener('wheel', (e: WheelEvent) => {
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
          e.preventDefault();
          if (e.deltaX > 30) goTo(currentIndex + 1);
          else if (e.deltaX < -30) goTo(currentIndex - 1);
        }
      }, { passive: false });

      window.addEventListener('resize', updateCards);
      // Inicializar posiciones tras render
      requestAnimationFrame(() => requestAnimationFrame(updateCards));
    });
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGalleryRows);
    } else {
      initGalleryRows();
    }
    document.addEventListener('astro:page-load', initGalleryRows);
  }
</script>
