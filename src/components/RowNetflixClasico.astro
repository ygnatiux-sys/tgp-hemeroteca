---
/**
 * RowNetflixClasico.astro
 * Componente de Carrusel Netflix Clásico Vertical (Sibling Push + Hover Delay + Paginación)
 * 4 Columnas visibles en Desktop con soporte para colecciones de TGP.
 */
import Image from './SafeImage.astro';
import ExpandableModal from './ExpandableModal.astro';
import { resolveEssayImage, sanitizeImageUrl, formatCategory, formatDate } from "../lib/content-filter";

interface Props {
  title?: string;
  eyebrow?: string;
  items?: Array<{
    title?: string;
    titulo?: string;
    subtitle?: string;
    excerpt?: string;
    image?: string | any;
    img?: string | any;
    link?: string;
    slug?: string;
    collectionLabel?: string;
    category?: string;
    date?: string;
    entry?: any;
  }>;
  max?: number;
  actionText?: string;
  actionHref?: string;
  cardAspect?: "vertical" | "horizontal";
}

const { 
  title = "También podrían gustarte",
  eyebrow = "Colecciones",
  items = [],
  max = 15,
  actionText,
  actionHref,
  cardAspect = "vertical"
} = Astro.props;

// Normalizamos los items
let displayItems = items.slice(0, max).map((item) => {
  const t = item.title || item.titulo || item.entry?.title || "Sin título";
  const cat = item.collectionLabel || formatCategory(item.category || item.entry?.category) || "Ensayo";
  const rawImg = item.img || item.image || resolveEssayImage(item.entry || item, item.slug);
  const image = sanitizeImageUrl(typeof rawImg === 'object' && rawImg?.src ? rawImg.src : (typeof rawImg === 'string' ? rawImg : '')) || 'https://images.unsplash.com/photo-1547036967-23d11aacaee0?q=80&w=1200&auto=format&fit=crop';
  const isCinematic = (item as any)?.isCinematicGSAP || (item.entry as any)?.isCinematicGSAP;
  const link = item.link || (item.slug ? (isCinematic ? `/ensayos-cinematicos/${item.slug}` : `/hemeroteca/${item.slug}/`) : '#');
  const d = item.date || item.entry?.date ? formatDate(item.date || item.entry?.date) : '';

  const entry = item.entry || (item as any);
  const font = (entry?.font || '').toLowerCase();
  const themeColor = (entry?.themeColor || '').toLowerCase();
  const isGloock = font === 'gloock';

  let customColorClass = '';
  if (themeColor === 'bordeaux') customColorClass = 'text-[#df7a7e]';
  else if (themeColor === 'british-green') customColorClass = 'text-[#68b68f]';
  else if (themeColor === 'old-navy') customColorClass = 'text-[#8ab7e0]';
  else if (themeColor === 'vintage-yellow') customColorClass = 'text-[#f0e2a8]';
  else if (themeColor === 'rust-orange') customColorClass = 'text-[#e07a5f]';
  else if (themeColor === 'bus-red') customColorClass = 'text-[#e55353]';

  return {
    title: t,
    subtitle: item.subtitle || item.excerpt || item.entry?.excerpt || item.entry?.dek || item.entry?.volanta || '',
    image,
    link,
    collectionLabel: cat,
    date: d,
    isGloock,
    customColorClass,
  };
});

// Sanitización segura de caracteres
displayItems = displayItems.map(item => ({
  ...item,
  title: item.title || '',
}));

const uid = `row-${Math.random().toString(36).substring(2, 8)}`;
---

<section 
  id={uid} 
  class="netflix-row-root w-full py-6 md:py-10 overflow-hidden relative select-none group/section"
  data-aspect={cardAspect}
  aria-label={title}
>
  <!-- Encabezado de la fila -->
  <div class="mb-4 px-2 md:px-4 z-20 relative flex items-end justify-between gap-4">
    <div>
      {eyebrow && (
        <span class="text-[8.5px] md:text-[9px] tracking-[0.4em] uppercase font-metadata text-rust-orange/90 font-bold block mb-1">
          {eyebrow}
        </span>
      )}
      <h3 class="text-white text-xl md:text-2xl font-cinzel font-bold tracking-tight leading-tight">
        {title}
      </h3>
    </div>
    
    <div class="flex items-center gap-4">
      <span class="text-[8.5px] font-metadata tracking-[0.25em] text-white/30 uppercase hidden sm:inline-block">
        {displayItems.length} Artículos
      </span>
      {actionText && actionHref && (
        <a href={actionHref} class="font-metadata text-[10px] uppercase tracking-[0.3em] text-white/50 hover:text-rust-orange hover:drop-shadow-[0_0_8px_rgba(239,235,227,0.5)] transition-all">
          {actionText}
        </a>
      )}
    </div>
  </div>

  <!-- Contenedor Maestro -->
  <div class="relative w-full px-2 md:px-4" style="min-height: 280px;">
    
    <!-- Botón Anterior Flotante en Cápsula -->
    <button 
      class="nav-btn prev-btn absolute left-0 md:left-1 top-1/2 -translate-y-1/2 z-40 w-9 md:w-10 h-16 md:h-20 rounded-full bg-black/60 hover:bg-black/90 text-white/70 hover:text-white border border-white/15 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-70 hover:opacity-100 hover:scale-105 active:scale-95 disabled:opacity-0 disabled:pointer-events-none cursor-pointer shadow-xl"
      aria-label="Anterior"
    >
      <svg class="w-5 h-5 -translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>

    <!-- Botón Siguiente Flotante en Cápsula -->
    <button 
      class="nav-btn next-btn absolute right-0 md:right-1 top-1/2 -translate-y-1/2 z-40 w-9 md:w-10 h-16 md:h-20 rounded-full bg-black/60 hover:bg-black/90 text-white/70 hover:text-white border border-white/15 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-70 hover:opacity-100 hover:scale-105 active:scale-95 disabled:opacity-0 disabled:pointer-events-none cursor-pointer shadow-xl"
      aria-label="Siguiente"
    >
      <svg class="w-5 h-5 translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>

    <!-- Pista de Deslizamiento -->
    <div class="track-wrapper overflow-visible py-4">
      <div class="netflix-track flex gap-3 md:gap-4 transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]">
        
        {displayItems.map((item, index) => {
          const cardId = `${uid}-${index}`;
          const isHorizontal = cardAspect === "horizontal";
          return (
          <article 
            class:list={[
              "netflix-card relative flex-none cursor-pointer rounded-xl md:rounded-2xl overflow-hidden",
              isHorizontal ? "netflix-card-natgeo flex flex-col" : "flex flex-col"
            ]} 
            data-flip-id={`card-container-${cardId}`}
          >
            <a href={item.link} 
               class="flex flex-col w-full h-full netflix-card-link group/card" 
               aria-label={`Ver: ${item.title}`}
               data-card-id={cardId}
               data-title={item.title}
               data-eyebrow={item.collectionLabel}
               data-excerpt={item.subtitle}
               data-image={item.image}
               data-link={item.link}>
              
              {/* ── 80% ZONA DE IMAGEN (Estricto en galería vertical) ── */}
              <div class:list={[
                "w-full overflow-hidden relative transition-all duration-500 bg-[#0a0c0f]",
                isHorizontal 
                  ? "aspect-4/3 md:aspect-16/10 rounded-xl md:rounded-2xl border border-white/10 group-hover/card:border-white/30 shadow-xl shrink-0" 
                  : "basis-[80%] h-[80%] shrink-0"
              ]}>
                <Image 
                  src={item.image} 
                  alt={item.title} 
                  inferSize={true}
                  format="webp"
                  widths={[400, 768, 1200]}
                  sizes="(max-width: 768px) 360px, 480px"
                  class:list={[
                    "netflix-card-img object-cover object-center transition-transform duration-700 ease-out group-hover/card:scale-105",
                    isHorizontal ? "w-full h-full" : "absolute inset-0 w-full h-full"
                  ]}
                  loading="lazy"
                  decoding="async"
                  data-flip-id={`card-image-${cardId}`}
                />
                
                {/* Franja de Scrim local en el 20% vertical de transición */}
                {!isHorizontal && (
                  <div class="absolute inset-x-0 bottom-0 h-16 bg-linear-to-t from-[#0a0c0f] via-[#0a0c0f]/75 to-transparent pointer-events-none z-10" />
                )}
              </div>

              {/* ── 20% ZONA EDITORIAL (METADATA + TÍTULO + SUBTÍTULO) ── */}
              <div class:list={[
                "card-info",
                isHorizontal 
                  ? "pt-3.5 pb-1 px-1 flex flex-col gap-1.5 flex-1"
                  : "basis-[20%] h-[20%] w-full bg-[#0a0c0f] px-3.5 py-1.5 sm:px-4 sm:py-2 flex flex-col justify-center gap-0.5 z-10 border-t border-white/6 relative"
              ]}>
                <span class:list={[
                  "uppercase font-metadata font-bold block line-clamp-1",
                  isHorizontal 
                    ? "text-[8.5px] md:text-[9.5px] tracking-[0.35em] text-rust-orange" 
                    : "text-[7.5px] sm:text-[8px] tracking-[0.28em] text-rust-orange/90"
                ]}>
                  {item.collectionLabel}
                </span>

                <h4 class:list={[
                  "netflix-card-title line-clamp-1 leading-tight transition-all duration-300",
                  isHorizontal
                    ? "text-base md:text-lg font-bold text-white/95 group-hover/card:text-rust-orange font-cinzel"
                    : (item.isGloock
                        ? `font-gloock font-bold text-[14px] sm:text-[15.5px] ${item.customColorClass || 'text-white/95'}`
                        : "font-cinzel font-extrabold text-[14px] sm:text-[15.5px] md:text-[16.5px] tracking-tight gradient-acero-ios drop-shadow-md")
                ]} data-flip-id={`card-title-${cardId}`}>
                  {item.title}
                </h4>

                {!isHorizontal && item.subtitle && (
                  <p class="font-serif font-light text-[10px] sm:text-[10.5px] md:text-[11px] text-white/55 line-clamp-1 leading-tight tracking-normal">
                    {item.subtitle}
                  </p>
                )}
              </div>
            </a>
          </article>
        )})}

      </div>
    </div>
  </div>

  <ExpandableModal />
</section>

<style>
  /* ── 1. DIMENSIONES BASE Y CONFIGURACIÓN ── */
  .track-wrapper {
    width: 100%;
  }

  .netflix-track {
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  /* Tarjeta en Reposo (General) */
  .netflix-card {
    width: calc(48% - 6px);
    opacity: 0.65;
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.4);
    
    transform: translate3d(0, 0, 0) scale(1);
    transform-origin: center center;
    transition: 
      transform 340ms cubic-bezier(0.25, 1, 0.5, 1), 
      opacity 340ms ease,
      box-shadow 340ms ease, 
      border-color 340ms ease;
    will-change: transform, opacity;
  }

  /* Aspecto Vertical (Modo clásico póster 2:3 con proporción 80/20 estricta) */
  .netflix-row-root[data-aspect="vertical"] .netflix-card {
    aspect-ratio: 2 / 3;
  }

  .netflix-row-root[data-aspect="vertical"] .netflix-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
  }

  .netflix-row-root[data-aspect="vertical"] .netflix-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.88) contrast(1.04);
    transition: filter 340ms ease, transform 500ms ease;
  }

  .netflix-row-root[data-aspect="vertical"] .netflix-card-title {
    opacity: 0.92;
    transition: opacity 300ms ease, filter 300ms ease;
  }

  @media (min-width: 640px) {
    .netflix-row-root[data-aspect="vertical"] .netflix-card {
      width: calc(33.333% - 10px); /* 3 cols tablet */
    }
  }

  @media (min-width: 1024px) {
    .netflix-row-root[data-aspect="vertical"] .netflix-card {
      width: calc(25% - 12px); /* 4 columnas visibles exactas en desktop */
    }
  }

  /* ── 2. EFECTO HOVER PARA ASPECTO VERTICAL (ZOOM 1.18 + SIBLING PUSH) ── */
  .netflix-row-root[data-aspect="vertical"] .netflix-card:hover {
    transform: translate3d(0, 0, 0) scale(1.18);
    z-index: 30;
    opacity: 1;
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 
      0 18px 38px -10px rgba(0, 0, 0, 0.75),
      0 0 0 1px rgba(255, 255, 255, 0.15);
    transition-delay: 260ms; 
  }

  .netflix-row-root[data-aspect="vertical"] .netflix-card:hover .netflix-card-img {
    filter: brightness(0.98) contrast(1.04);
    transition-delay: 260ms;
  }

  .netflix-row-root[data-aspect="vertical"] .netflix-card:hover .netflix-card-title {
    opacity: 1;
    filter: brightness(1.2);
    transition-delay: 260ms;
  }

  .netflix-row-root[data-aspect="vertical"] .netflix-track:has(.netflix-card:hover) .netflix-card:not(:hover):has(~ .netflix-card:hover) {
    transform: translate3d(-10%, 0, 0);
    transition-delay: 260ms;
  }

  .netflix-row-root[data-aspect="vertical"] .netflix-card:hover ~ .netflix-card {
    transform: translate3d(10%, 0, 0);
    transition-delay: 260ms;
  }

  .netflix-row-root[data-aspect="vertical"] .netflix-track:not(:hover) .netflix-card {
    transition-delay: 0ms;
  }

  /* ── 3. ASPECTO HORIZONTAL / EDITORIAL (ESTILO NAT GEO — TAMAÑO AMPLIO VISIBLE) ── */
  .netflix-row-root[data-aspect="horizontal"] .netflix-card {
    width: calc(82% - 10px); /* Mobile: 1 card grande + peek siguiente */
    opacity: 0.95;
    background-color: transparent;
    border: none;
    box-shadow: none;
  }

  .netflix-row-root[data-aspect="horizontal"] .netflix-card .netflix-card-img {
    filter: brightness(0.92) contrast(1.02);
  }

  .netflix-row-root[data-aspect="horizontal"] .netflix-card:hover {
    opacity: 1;
    transform: translate3d(0, -6px, 0);
    transition-delay: 0ms;
    z-index: 20;
  }

  .netflix-row-root[data-aspect="horizontal"] .netflix-card:hover .netflix-card-img {
    filter: brightness(1.03) contrast(1.04);
    transition-delay: 0ms;
  }

  /* Desactivar sibling push lateral en horizontal para no desplazar el texto apilado */
  .netflix-row-root[data-aspect="horizontal"] .netflix-track:has(.netflix-card:hover) .netflix-card:not(:hover):has(~ .netflix-card:hover),
  .netflix-row-root[data-aspect="horizontal"] .netflix-card:hover ~ .netflix-card {
    transform: translate3d(0, 0, 0);
    transition-delay: 0ms;
  }

  @media (min-width: 640px) {
    .netflix-row-root[data-aspect="horizontal"] .netflix-card {
      width: calc(46% - 12px); /* Tablet: 2 cards grandes + peek */
    }
  }

  @media (min-width: 1024px) {
    .netflix-row-root[data-aspect="horizontal"] .netflix-card {
      width: calc(30.8% - 14px); /* Desktop: 3 cards grandes + peek en bordes (exacto como sample Nat Geo) */
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { Flip } from "gsap/Flip";

  gsap.registerPlugin(Flip);

  function initNetflixRows() {
    const rows = document.querySelectorAll<HTMLElement>('.netflix-row-root');

    rows.forEach(row => {
      if (row.hasAttribute('data-init')) return;
      row.setAttribute('data-init', 'true');

      const track = row.querySelector('.netflix-track') as HTMLElement | null;
      const prevBtn = row.querySelector('.prev-btn') as HTMLButtonElement | null;
      const nextBtn = row.querySelector('.next-btn') as HTMLButtonElement | null;
      
      if (!track || !prevBtn || !nextBtn || !track.parentElement) return;

      const trackEl: HTMLElement = track;
      const parentEl: HTMLElement = track.parentElement;
      const prevBtnEl: HTMLButtonElement = prevBtn;
      const nextBtnEl: HTMLButtonElement = nextBtn;

      let currentTransform = 0;

      function updateButtons() {
        const trackWidth = trackEl.scrollWidth;
        const containerWidth = parentEl.offsetWidth;
        
        prevBtnEl.disabled = currentTransform >= 0;
        nextBtnEl.disabled = Math.abs(currentTransform) + containerWidth >= trackWidth - 10;
      }

      function slide(direction: 'next' | 'prev') {
        const containerWidth = parentEl.offsetWidth;
        const moveAmount = containerWidth * 0.90; 

        if (direction === 'next') {
          currentTransform -= moveAmount;
        } else {
          currentTransform += moveAmount;
        }

        const maxScroll = -(trackEl.scrollWidth - containerWidth);
        
        if (currentTransform > 0) currentTransform = 0;
        if (currentTransform < maxScroll) currentTransform = maxScroll;

        trackEl.style.transform = `translate3d(${currentTransform}px, 0, 0)`;
        updateButtons();
      }

      nextBtnEl.addEventListener('click', () => slide('next'));
      prevBtnEl.addEventListener('click', () => slide('prev'));

      window.addEventListener('resize', () => {
        currentTransform = 0;
        trackEl.style.transform = `translate3d(0px, 0, 0)`;
        updateButtons();
      });

      updateButtons();

      // GSAP FLIP Interception
      const cards = row.querySelectorAll('.netflix-card-link');
      const modal = row.querySelector('.expandable-modal') as HTMLDialogElement;
      const closeBtn = row.querySelector('.close-modal-btn');
      
      const mContainer = row.querySelector('.modal-container') as HTMLElement;
      const mImage = row.querySelector('.modal-image') as HTMLImageElement;
      const mTitle = row.querySelector('.modal-title') as HTMLElement;
      const mEyebrow = row.querySelector('.modal-eyebrow') as HTMLElement;
      const mExcerpt = row.querySelector('.modal-excerpt') as HTMLElement;
      const mCta = row.querySelector('.modal-cta') as HTMLAnchorElement;

      if (!modal || !mContainer || !mImage || !mTitle) return;

      let currentFlipTween: gsap.core.Timeline | null = null;
      let activeArticle: HTMLElement | null = null;
      let activeImg: HTMLElement | null = null;
      let activeTitle: HTMLElement | null = null;

      cards.forEach(card => {
        card.addEventListener('click', (e) => {
          e.preventDefault();
          
          const a = e.currentTarget as HTMLElement;
          const article = a.closest('.netflix-card') as HTMLElement;
          const img = article.querySelector('.netflix-card-img') as HTMLElement;
          const title = article.querySelector('.netflix-card-title') as HTMLElement;
          
          activeArticle = article;
          activeImg = img;
          activeTitle = title;

          const cardId = a.dataset.cardId;
          
          // Inject data into modal
          mImage.src = a.dataset.image || '';
          mTitle.innerHTML = a.dataset.title || '';
          if (mEyebrow) {
             mEyebrow.innerHTML = a.dataset.eyebrow || '';
             mEyebrow.style.display = a.dataset.eyebrow ? 'block' : 'none';
          }
          if (mExcerpt) mExcerpt.innerHTML = a.dataset.excerpt || '';
          if (mCta) mCta.href = a.dataset.link || '#';
          
          const extraContent = mContainer.querySelectorAll('.modal-excerpt, .modal-cta, .close-modal-btn, .modal-eyebrow');
          gsap.set(extraContent, { clearProps: "all" });
          gsap.set([mContainer, mImage, mTitle], { clearProps: "all" });

          // Match Flip IDs
          mContainer.dataset.flipId = `card-container-${cardId}`;
          mImage.dataset.flipId = `card-image-${cardId}`;
          mTitle.dataset.flipId = `card-title-${cardId}`;

          // Get state of card elements
          const state = Flip.getState([article, img, title]);
          
          // Show modal
          modal.showModal();
          
          currentFlipTween = Flip.from(state, {
            targets: [mContainer, mImage, mTitle],
            duration: 0.5,
            ease: "power3.inOut",
            absolute: true,
          });
        });
      });

      const closeModal = () => {
        if (!modal.open) return;

        const extraContent = mContainer.querySelectorAll('.modal-excerpt, .modal-cta, .close-modal-btn, .modal-eyebrow');
        gsap.to(extraContent, { opacity: 0, duration: 0.15 });

        if (currentFlipTween) {
          currentFlipTween.timeScale(1.3).reverse();
          currentFlipTween.eventCallback("onReverseComplete", () => {
            modal.close();
            gsap.set([mContainer, mImage, mTitle, ...Array.from(extraContent)], { clearProps: "all" });
            currentFlipTween = null;
            activeArticle = null;
            activeImg = null;
            activeTitle = null;
          });
        } else {
          modal.close();
        }
      };

      if (closeBtn) {
        closeBtn.addEventListener('click', closeModal);
      }

      modal.addEventListener('cancel', (e) => {
        e.preventDefault();
        closeModal();
      });

      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    });
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNetflixRows);
    } else {
      initNetflixRows();
    }
    document.addEventListener('astro:page-load', initNetflixRows);
  }
</script>
