---
/**
 * AppleDualBentoMuseum.astro
 * Prototipo Arquitectónico: Dual Bento Showcase Vertical (Apple TV 4K Master Reference).
 * Proporción calibrada: Portrait 4:5 (min-h-[560px] md:min-h-[620px]).
 * Anclaje lítico estricto en la base inferior con sombreado de contacto tridimensional.
 * Rotación asíncrona desacoplada entre ambas tarjetas con cross-fade suave y pausa en hover.
 * Integrado de forma nativa sobre el lienzo principal (--bg-main).
 */

interface Artifact {
  id: string;
  kickerIconSvg: string;
  kicker: string;
  titleLine1: string;
  titleLine2: string;
  logline: string;
  era: string;
  imageWebp: string;
  imagePng: string;
  alt: string;
  ctaText: string;
  ctaLink: string;
  accentColor: string;
}

// 🏛️ GRUPO 1 (IZQUIERDA): Canon Helénico, Dinámica y Proporción Clásica
const bentoLeftArtifacts: Artifact[] = [
  {
    id: "hermes",
    kickerIconSvg: `<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="8" r="5"/><path d="M12 13v8M9 16h6M9 5a3 3 0 016 0"/></svg>`,
