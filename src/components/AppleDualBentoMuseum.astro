---
/**
 * AppleDualBentoMuseum.astro
 * Prototipo Arquitectónico: Dual Bento Showcase Vertical (Apple TV 4K Master Reference).
 * Proporción calibrada: Portrait 4:5 independiente sin colisión ni encimado de tarjetas.
 * Anclaje lático estricto en la base inferior con sombreado de contacto tridimensional.
 * Rotación asíncrona desacoplada entre ambas tarjetas con cross-fade suave y pausa en hover.
 */

interface Artifact {
  id: string;
  kickerIcon: string;
  kicker: string;
  titleLine1: string;
  titleLine2: string;
  logline: string;
  era: string;
  imageWebp: string;
  imagePng: string;
  alt: string;
  ctaText: string;
  ctaLink: string;
}

const bentoLeftArtifacts: Artifact[] = [
  {
    id: "hermes",
    kickerIcon: "mercury",
    kicker: "HERMES · EL PSICOPOMPO",
    titleLine1: "El Dios de las Encrucijadas.",
    titleLine2: "Hermes y lo Liminal.",
    logline: "La frontera no se custodia: se constituye. Autopsia conceptual y arqueológica sobre el psicopompo y el kerykeion en el Mediterráneo antiguo.",
    era: "Vulci / Louvre G264 · c. 480 a.C.",
    imageWebp: "/images/museum/statue-hermes.webp",
    imagePng: "/images/museum/statue-hermes.png",
    alt: "Estatua clásica de mármol de Hermes con caduceo",
    ctaText: "Explorar ensayo",
    ctaLink: "/ensayos/mercurio-hermes-arquetipo-liminal"
  },
  {
    id: "nike",
    kickerIcon: "wings",
    kicker: "SAMOTRACIA · DINÁMICA HELÉNICA",
    titleLine1: "La Victoria sin Rostro.",
    titleLine2: "El Vuelo en la Piedra.",
    logline: "El viento marino esculpido en el mármol de Paros. La proa de guerra que desafió el olvido del Mediterráneo.",
    era: "Pariano Helénico · c. 190 a.C.",
    imageWebp: "https://storage.thegreatpuzzleproject.com/vault-media/1792977775310-08f70d8d.webp",
    imagePng: "https://storage.thegreatpuzzleproject.com/vault-media/1792977775310-08f70d8d.webp",
    alt: "Estatua helenística de la Victoria Alada de Samotracia",
    ctaText: "Explorar ensayo",
    ctaLink: "/ensayos/amnesia-programada"
  }
];

const bentoRightArtifacts: Artifact[] = [
  {
    id: "jupiter",
    kickerIcon: "lightning",
    kicker: "JÚPITER · SOBERANÍA LÍTICA",
    titleLine1: "El Orden Arquetípico.",
    titleLine2: "La Potestad del Rayo.",
    logline: "El trono soberano de la cosmología clásica. La precesión astronómica y el equilibrio celeste labrado en el canon monumental.",
    era: "Mármol Pentélico · Siglo I d.C.",
    imageWebp: "https://storage.thegreatpuzzleproject.com/vault-media/1792977771856-9e9bf8d2.webp",
    imagePng: "https://storage.thegreatpuzzleproject.com/vault-media/1792977771856-9e9bf8d2.webp",
    alt: "Estatua romana de Júpiter entronizado con águila y rayo",
    ctaText: "Explorar ensayo",
    ctaLink: "/ensayos/pumapunku-la-geometria-del-silencio"
  },
  {
    id: "athena",
    kickerIcon: "shield",
    kicker: "ATENEA · LA INTELIGENCIA TÉCNICA",
    titleLine1: "La Razón Vigilante.",
    titleLine2: "Memoria de la Pólis.",
    logline: "El escudo con el rostro de la Gorgona y la mirada serena: la técnica y el logos preservados frente al cataclismo civilizatorio.",
    era: "Ático Clásico · c. 460 a.C.",
    imageWebp: "https://storage.thegreatpuzzleproject.com/vault-media/1792977773642-b069c3e0.webp",
    imagePng: "https://storage.thegreatpuzzleproject.com/vault-media/1792977773642-b069c3e0.webp",
    alt: "Estatua clásica de Atenea con yelmo, égida y lanza",
    ctaText: "Explorar ensayo",
    ctaLink: "/ensayos/la-geometria-petrea-de-pumapunku-andesita-tiempo-y-cosmos-3332"
  }
];

interface Props {
  showHeader?: boolean;
}

const { showHeader = true } = Astro.props;
---

<section class={`apple-dual-bento-section w-full px-4 sm:px-6 relative z-10 ${showHeader ? 'py-20' : 'pb-16'}`} id="showcase-dual-bento">
  <!-- ENCABEZADO DE SECCIÓN EDITORIAL -->
  {showHeader && (
    <div class="max-w-4xl mx-auto text-center mb-14 md:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/6 border border-white/10 text-white/70 text-[11px] font-mono tracking-widest uppercase mb-4 backdrop-blur-md">
        <span class="w-1.5 h-1.5 rounded-full bg-vault-accent animate-pulse"></span>
        Apple TV Format · Dual Bento Showcase
      </div>
      <h2 class="font-gloock text-3xl sm:text-4xl md:text-5xl text-white tracking-tight mb-4">
        Arquetipos & Morfología Clásica
      </h2>
      <p class="font-inter text-sm sm:text-base text-white/60 max-w-2xl mx-auto leading-relaxed font-light">
        Morfología vertical 4:5 inspirada en el centro de home de Apple: tarjetas autónomas ultra-limpias, anclaje lático sin recorte de miembros y rotación asíncrona de piezas de museo.
      </p>
    </div>
  )}

  <!-- CONTENEDOR GRID DUAL CENTRADO (HOME CENTER) -->
  <div class="max-w-5xl mx-auto w-full grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 items-stretch justify-items-center">

    <!-- ═══════════════════════════════════════════════════════
         TARJETA BENTO 1: HERMES & SAMOTRACIA (IZQUIERDA)
         ═══════════════════════════════════════════════════════ -->
    <div 
      class="bento-card-root group/bento relative w-full max-w-115 rounded-4xl overflow-hidden bg-[#fbfbfd] text-[#1d1d1f] shadow-[0_20px_45px_rgba(0,0,0,0.3)] ring-1 ring-black/6 flex flex-col justify-between aspect-4/5 min-h-130 md:min-h-145 select-none transition-all duration-500 hover:shadow-[0_28px_60px_rgba(0,0,0,0.4)] hover:-translate-y-1"
      id="bento-card-left"
      data-card-id="left"
    >
      <!-- HEADER EDITORIAL SUPERIOR (FIDELIDAD APPLE TV) -->
      <div class="pt-8 sm:pt-10 px-8 pb-2 text-center flex flex-col items-center z-20 relative">
        <!-- ICONO + KICKER APPLE STYLE -->
        <div class="inline-flex items-center gap-2 text-[10px] sm:text-[11px] font-mono tracking-[0.22em] uppercase text-[#86868b] mb-3">
          <span class="bento-icon-wrapper flex items-center justify-center w-5 h-5 rounded-full bg-black/4 text-vault-accent">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="12" cy="8" r="5"/>
              <path d="M12 13v8M9 16h6M9 5a3 3 0 016 0"/>
            </svg>
          </span>
          <span class="bento-kicker-text transition-opacity duration-500">{bentoLeftArtifacts[0].kicker}</span>
        </div>

        <!-- H3 PRINCIPAL EN DOS LÍNEAS -->
        <h3 class="bento-title-text font-inter font-bold text-2xl sm:text-[28px] lg:text-[32px] text-[#1d1d1f] tracking-tight leading-[1.15] transition-opacity duration-500">
          <span class="line-1 block">{bentoLeftArtifacts[0].titleLine1}</span>
          <span class="line-2 block font-medium text-[#48484a]">{bentoLeftArtifacts[0].titleLine2}</span>
        </h3>

        <!-- LOGLINE CONCISO Y FILOSÓFICO -->
        <p class="bento-logline-text font-inter text-xs sm:text-[13px] text-[#6e6e73] font-normal leading-relaxed max-w-xs mt-2.5 transition-opacity duration-500">
          {bentoLeftArtifacts[0].logline}
        </p>

        <!-- ENLACE ACCIÓN APPLE CON CHEVRON -->
        <a 
          href={bentoLeftArtifacts[0].ctaLink} 
          class="bento-cta-link inline-flex items-center gap-1 text-xs sm:text-sm font-normal text-[#0066cc] hover:text-[#0077ed] mt-3 group/link transition-colors"
        >
          <span class="bento-cta-text">{bentoLeftArtifacts[0].ctaText}</span>
          <svg class="w-3.5 h-3.5 transform transition-transform group-hover/link:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </a>

        <!-- PILL CONTEXTUAL DE ÉPOCA Y MATERIAL -->
        <div class="mt-2.5 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-black/4 text-[10px] font-mono text-[#86868b] tracking-wider uppercase">
          <span class="w-1 h-1 rounded-full bg-vault-accent"></span>
          <span class="bento-era-text">{bentoLeftArtifacts[0].era}</span>
        </div>
      </div>

      <!-- STAGE: ESCENARIO INFERIOR CON RECORTES TRIDIMENSIONALES -->
      <div class="bento-stage mt-auto w-full relative grow flex justify-center items-end px-6 pb-4 sm:pb-6 overflow-hidden min-h-72.5 md:min-h-85 z-10">
        <!-- SOMBRA DE CONTACTO BASE -->
        <div class="absolute bottom-3 sm:bottom-5 left-1/2 -translate-x-1/2 w-48 sm:w-60 h-6 bg-black/12 rounded-full blur-md pointer-events-none transform scale-y-50"></div>

        <!-- ARRAY DE IMÁGENES RECORTADAS SUPERPUESTAS -->
        {bentoLeftArtifacts.map((art, idx) => (
          <div
            class={`bento-artifact-wrapper absolute bottom-4 sm:bottom-6 left-1/2 -translate-x-1/2 w-full h-[90%] md:h-[94%] flex justify-center items-end transition-all duration-700 ease-out pointer-events-none ${
              idx === 0 
                ? "opacity-100 translate-y-0 scale-100 z-10" 
                : "opacity-0 translate-y-5 scale-[0.98] z-0 invisible"
            }`}
            data-index={idx}
          >
            <picture class="h-full w-auto flex justify-center items-end">
              <source srcset={art.imageWebp} type="image/webp" />
              <img 
                src={art.imageWebp} 
                alt={art.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-auto max-w-[85%] object-contain object-bottom bento-statue-shadow transition-transform duration-700 group-hover/bento:scale-[1.03]"
              />
            </picture>
          </div>
        ))}
      </div>

      <!-- PAGINACIÓN POR PUNTOS SUTILES -->
      <div class="absolute top-5 right-6 z-30 flex items-center gap-1.5 bg-black/4 px-2 py-1 rounded-full backdrop-blur-xs">
        {bentoLeftArtifacts.map((_, idx) => (
          <button 
            type="button"
            class={`bento-dot rounded-full transition-all duration-500 cursor-pointer ${
              idx === 0 ? "bg-[#1d1d1f] w-3.5 h-1.5" : "bg-black/25 w-1.5 h-1.5 hover:bg-black/50"
            }`}
            data-target-idx={idx}
            aria-label={`Ver artefacto ${idx + 1}`}
          />
        ))}
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         TARJETA BENTO 2: JÚPITER & ATENEA (DERECHA)
         ═══════════════════════════════════════════════════════ -->
    <div 
      class="bento-card-root group/bento relative w-full max-w-115 rounded-4xl overflow-hidden bg-[#fbfbfd] text-[#1d1d1f] shadow-[0_20px_45px_rgba(0,0,0,0.3)] ring-1 ring-black/6 flex flex-col justify-between aspect-4/5 min-h-130 md:min-h-145 select-none transition-all duration-500 hover:shadow-[0_28px_60px_rgba(0,0,0,0.4)] hover:-translate-y-1"
      id="bento-card-right"
      data-card-id="right"
    >
      <!-- HEADER EDITORIAL SUPERIOR (FIDELIDAD APPLE TV) -->
      <div class="pt-8 sm:pt-10 px-8 pb-2 text-center flex flex-col items-center z-20 relative">
        <!-- ICONO + KICKER APPLE STYLE -->
        <div class="inline-flex items-center gap-2 text-[10px] sm:text-[11px] font-mono tracking-[0.22em] uppercase text-[#86868b] mb-3">
          <span class="bento-icon-wrapper flex items-center justify-center w-5 h-5 rounded-full bg-black/4 text-[#e58e4a]">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
            </svg>
          </span>
          <span class="bento-kicker-text transition-opacity duration-500">{bentoRightArtifacts[0].kicker}</span>
        </div>

        <!-- H3 PRINCIPAL EN DOS LÍNEAS -->
        <h3 class="bento-title-text font-inter font-bold text-2xl sm:text-[28px] lg:text-[32px] text-[#1d1d1f] tracking-tight leading-[1.15] transition-opacity duration-500">
          <span class="line-1 block">{bentoRightArtifacts[0].titleLine1}</span>
          <span class="line-2 block font-medium text-[#48484a]">{bentoRightArtifacts[0].titleLine2}</span>
        </h3>

        <!-- LOGLINE CONCISO Y FILOSÓFICO -->
        <p class="bento-logline-text font-inter text-xs sm:text-[13px] text-[#6e6e73] font-normal leading-relaxed max-w-xs mt-2.5 transition-opacity duration-500">
          {bentoRightArtifacts[0].logline}
        </p>

        <!-- ENLACE ACCIÓN APPLE CON CHEVRON -->
        <a 
          href={bentoRightArtifacts[0].ctaLink} 
          class="bento-cta-link inline-flex items-center gap-1 text-xs sm:text-sm font-normal text-[#0066cc] hover:text-[#0077ed] mt-3 group/link transition-colors"
        >
          <span class="bento-cta-text">{bentoRightArtifacts[0].ctaText}</span>
          <svg class="w-3.5 h-3.5 transform transition-transform group-hover/link:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </a>

        <!-- PILL CONTEXTUAL DE ÉPOCA Y MATERIAL -->
        <div class="mt-2.5 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-black/4 text-[10px] font-mono text-[#86868b] tracking-wider uppercase">
          <span class="w-1 h-1 rounded-full bg-[#e58e4a]"></span>
          <span class="bento-era-text">{bentoRightArtifacts[0].era}</span>
        </div>
      </div>

      <!-- STAGE: ESCENARIO INFERIOR CON RECORTES TRIDIMENSIONALES -->
      <div class="bento-stage mt-auto w-full relative grow flex justify-center items-end px-6 pb-4 sm:pb-6 overflow-hidden min-h-72.5 md:min-h-85 z-10">
        <!-- SOMBRA DE CONTACTO BASE -->
        <div class="absolute bottom-3 sm:bottom-5 left-1/2 -translate-x-1/2 w-48 sm:w-60 h-6 bg-black/12 rounded-full blur-md pointer-events-none transform scale-y-50"></div>

        <!-- ARRAY DE IMÁGENES RECORTADAS SUPERPUESTAS -->
        {bentoRightArtifacts.map((art, idx) => (
          <div
            class={`bento-artifact-wrapper absolute bottom-4 sm:bottom-6 left-1/2 -translate-x-1/2 w-full h-[90%] md:h-[94%] flex justify-center items-end transition-all duration-700 ease-out pointer-events-none ${
              idx === 0 
                ? "opacity-100 translate-y-0 scale-100 z-10" 
                : "opacity-0 translate-y-5 scale-[0.98] z-0 invisible"
            }`}
            data-index={idx}
          >
            <picture class="h-full w-auto flex justify-center items-end">
              <source srcset={art.imageWebp} type="image/webp" />
              <img 
                src={art.imageWebp} 
                alt={art.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-auto max-w-[85%] object-contain object-bottom bento-statue-shadow transition-transform duration-700 group-hover/bento:scale-[1.03]"
              />
            </picture>
          </div>
        ))}
      </div>

      <!-- PAGINACIÓN POR PUNTOS SUTILES -->
      <div class="absolute top-5 right-6 z-30 flex items-center gap-1.5 bg-black/4 px-2 py-1 rounded-full backdrop-blur-xs">
        {bentoRightArtifacts.map((_, idx) => (
          <button 
            type="button"
            class={`bento-dot rounded-full transition-all duration-500 cursor-pointer ${
              idx === 0 ? "bg-[#1d1d1f] w-3.5 h-1.5" : "bg-black/25 w-1.5 h-1.5 hover:bg-black/50"
            }`}
            data-target-idx={idx}
            aria-label={`Ver artefacto ${idx + 1}`}
          />
        ))}
      </div>
    </div>

  </div>
</section>

<!-- SCRIPT DE ORQUESTACIÓN ASÍNCRONA DESACOPLADA -->
<script define:vars={{ bentoLeftArtifacts, bentoRightArtifacts }}>
  document.addEventListener("DOMContentLoaded", () => {
    function setupBentoCard(cardElement, artifacts, intervalMs, initialDelayMs) {
      if (!cardElement) return;

      const wrappers = cardElement.querySelectorAll(".bento-artifact-wrapper");
      const kickerEl = cardElement.querySelector(".bento-kicker-text");
      const line1El = cardElement.querySelector(".bento-title-text .line-1");
      const line2El = cardElement.querySelector(".bento-title-text .line-2");
      const loglineEl = cardElement.querySelector(".bento-logline-text");
      const ctaLinkEl = cardElement.querySelector(".bento-cta-link");
      const ctaTextEl = cardElement.querySelector(".bento-cta-text");
      const eraTextEl = cardElement.querySelector(".bento-era-text");
      const dots = cardElement.querySelectorAll(".bento-dot");

      let currentIndex = 0;
      let timer = null;
      let isPaused = false;

      function goToIndex(nextIndex) {
        if (nextIndex === currentIndex) return;

        // Transición de imágenes (Cross-fade limpio)
        wrappers.forEach((w, i) => {
          if (i === nextIndex) {
            w.classList.remove("opacity-0", "translate-y-5", "scale-[0.98]", "z-0", "invisible");
            w.classList.add("opacity-100", "translate-y-0", "scale-100", "z-10");
          } else {
            w.classList.remove("opacity-100", "translate-y-0", "scale-100", "z-10");
            w.classList.add("opacity-0", "translate-y-5", "scale-[0.98]", "z-0");
            setTimeout(() => {
              if (i !== currentIndex) {
                w.classList.add("invisible");
              }
            }, 700);
          }
        });

        // Actualizar textos
        const data = artifacts[nextIndex];
        if (data) {
          if (kickerEl) kickerEl.textContent = data.kicker;
          if (line1El) line1El.textContent = data.titleLine1;
          if (line2El) line2El.textContent = data.titleLine2;
          if (loglineEl) loglineEl.textContent = data.logline;
          if (ctaTextEl) ctaTextEl.textContent = data.ctaText;
          if (ctaLinkEl) ctaLinkEl.setAttribute("href", data.ctaLink);
          if (eraTextEl) eraTextEl.textContent = data.era;
        }

        // Actualizar dots
        dots.forEach((dot, i) => {
          if (i === nextIndex) {
            dot.classList.add("bg-[#1d1d1f]", "w-3.5");
            dot.classList.remove("bg-black/25", "w-1.5");
          } else {
            dot.classList.remove("bg-[#1d1d1f]", "w-3.5");
            dot.classList.add("bg-black/25", "w-1.5");
          }
        });

        currentIndex = nextIndex;
      }

      function next() {
        const nextIdx = (currentIndex + 1) % artifacts.length;
        goToIndex(nextIdx);
      }

      function startLoop() {
        stopLoop();
        timer = setInterval(() => {
          if (!isPaused) {
            next();
          }
        }, intervalMs);
      }

      function stopLoop() {
        if (timer) clearInterval(timer);
      }

      // Iniciar con desfase asíncrono
      setTimeout(() => {
        startLoop();
      }, initialDelayMs);

      // Pausa en hover
      cardElement.addEventListener("mouseenter", () => {
        isPaused = true;
      });
      cardElement.addEventListener("mouseleave", () => {
        isPaused = false;
      });

      // Click manual en dots
      dots.forEach((dot) => {
        dot.addEventListener("click", (e) => {
          e.stopPropagation();
          const target = parseInt(dot.getAttribute("data-target-idx") || "0", 10);
          goToIndex(target);
          startLoop();
        });
      });
    }

    // Desfase asíncrono desacoplado:
    // Tarjeta 1: Cada 6500ms, arranque a los 400ms
    // Tarjeta 2: Cada 6500ms, arranque a los 3650ms (desfase exacto de medio ciclo)
    const cardLeft = document.getElementById("bento-card-left");
    const cardRight = document.getElementById("bento-card-right");

    setupBentoCard(cardLeft, bentoLeftArtifacts, 6500, 400);
    setupBentoCard(cardRight, bentoRightArtifacts, 6500, 3650);
  });
</script>

<style>
  .apple-dual-bento-section {
    contain: layout style;
  }

  .bento-card-root {
    will-change: transform, box-shadow;
  }

  /* Sombra de contacto volumétrica estratificada para estatuas */
  .bento-statue-shadow {
    filter: drop-shadow(0 20px 25px rgba(0, 0, 0, 0.22)) drop-shadow(0 8px 10px rgba(0, 0, 0, 0.12));
  }

  /* Evitar layout shift */
  .bento-stage picture img {
    max-height: 100%;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
