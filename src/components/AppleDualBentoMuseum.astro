          <span class="line-1 block">{bentoLeftArtifacts[0].titleLine1}</span>
          <span class="line-2 block font-medium text-[#48484a]">{bentoLeftArtifacts[0].titleLine2}</span>
        </h3>

        <!-- LOGLINE CONCISO Y FILOSÓFICO -->
        <p class="bento-logline-text font-inter text-xs sm:text-[13px] text-[#6e6e73] font-normal leading-relaxed max-w-xs mt-2.5 transition-opacity duration-500">
          {bentoLeftArtifacts[0].logline}
        </p>

        <!-- ENLACE ACCIÓN APPLE CON CHEVRON -->
        <a 
          href={bentoLeftArtifacts[0].ctaLink} 
          class="bento-cta-link inline-flex items-center gap-1 text-xs sm:text-sm font-normal text-[#0066cc] hover:text-[#0077ed] mt-3 group/link transition-colors"
        >
          <span class="bento-cta-text">{bentoLeftArtifacts[0].ctaText}</span>
