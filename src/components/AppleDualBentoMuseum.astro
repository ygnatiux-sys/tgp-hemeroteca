</section>

<!-- SCRIPT DE ORQUESTACIÓN ASÍNCRONA DESACOPLADA (COMPATIBLE DOMContentLoaded + ASTRO VIEW TRANSITIONS) -->
<script define:vars={{ bentoLeftArtifacts, bentoRightArtifacts }}>
  function initDualBento() {
    function setupBentoCard(cardElement, artifacts, intervalMs, initialDelayMs) {
      if (!cardElement) return;

      const wrappers = cardElement.querySelectorAll(".bento-artifact-wrapper");
      const iconWrapper = cardElement.querySelector(".bento-icon-wrapper");
      const kickerEl = cardElement.querySelector(".bento-kicker-text");
      const line1El = cardElement.querySelector(".bento-title-text .line-1");
      const line2El = cardElement.querySelector(".bento-title-text .line-2");
      const loglineEl = cardElement.querySelector(".bento-logline-text");
      const ctaLinkEl = cardElement.querySelector(".bento-cta-link");
      const ctaTextEl = cardElement.querySelector(".bento-cta-text");
      const eraDotEl = cardElement.querySelector(".bento-era-dot");
      const eraTextEl = cardElement.querySelector(".bento-era-text");
      const dots = cardElement.querySelectorAll(".bento-dot");

      let currentIndex = 0;
      let timer = null;
      let isPaused = false;

      function goToIndex(nextIndex) {
        if (nextIndex === currentIndex) return;

        // Transición de imágenes (Cross-fade limpio)
        wrappers.forEach((w, i) => {
          if (i === nextIndex) {
            w.classList.remove("opacity-0", "translate-y-5", "scale-[0.98]", "z-0", "invisible");
            w.classList.add("opacity-100", "translate-y-0", "scale-100", "z-10");
          } else {
            w.classList.remove("opacity-100", "translate-y-0", "scale-100", "z-10");
            w.classList.add("opacity-0", "translate-y-5", "scale-[0.98]", "z-0");
            setTimeout(() => {
              if (i !== currentIndex) {
                w.classList.add("invisible");
              }
            }, 700);
          }
        });

        // Actualizar textos e iconos con micro-fade
        const data = artifacts[nextIndex];
        if (data) {
          if (iconWrapper && data.kickerIconSvg) {
            iconWrapper.innerHTML = data.kickerIconSvg;
            if (data.accentColor) iconWrapper.style.color = data.accentColor;
          }
          if (kickerEl) kickerEl.textContent = data.kicker;
          if (line1El) line1El.textContent = data.titleLine1;
          if (line2El) line2El.textContent = data.titleLine2;
          if (loglineEl) loglineEl.textContent = data.logline;
          if (ctaTextEl) ctaTextEl.textContent = data.ctaText;
          if (ctaLinkEl) ctaLinkEl.setAttribute("href", data.ctaLink);
          if (eraTextEl) eraTextEl.textContent = data.era;
          if (eraDotEl && data.accentColor) eraDotEl.style.backgroundColor = data.accentColor;
        }

        // Actualizar dots
        dots.forEach((dot, i) => {
          if (i === nextIndex) {
            dot.classList.add("bg-[#1d1d1f]", "w-3.5");
            dot.classList.remove("bg-black/25", "w-1.5");
          } else {
            dot.classList.remove("bg-[#1d1d1f]", "w-3.5");
            dot.classList.add("bg-black/25", "w-1.5");
          }
        });

        currentIndex = nextIndex;
      }

      function next() {
        const nextIdx = (currentIndex + 1) % artifacts.length;
        goToIndex(nextIdx);
      }

      function startLoop() {
        stopLoop();
        timer = setInterval(() => {
          if (!isPaused) {
            next();
          }
        }, intervalMs);
      }

      function stopLoop() {
        if (timer) clearInterval(timer);
      }

      // Iniciar con desfase asíncrono
      setTimeout(() => {
        startLoop();
      }, initialDelayMs);

      // Pausa en hover
      cardElement.addEventListener("mouseenter", () => {
        isPaused = true;
      });
      cardElement.addEventListener("mouseleave", () => {
        isPaused = false;
      });

      // Click manual en dots
      dots.forEach((dot) => {
        dot.addEventListener("click", (e) => {
          e.stopPropagation();
          const target = parseInt(dot.getAttribute("data-target-idx") || "0", 10);
          goToIndex(target);
          startLoop();
        });
      });
    }

    // Desfase asíncrono desacoplado:
    // Tarjeta 1 (Izquierda): Cada 6500ms, arranque a los 400ms
    // Tarjeta 2 (Derecha): Cada 6500ms, arranque a los 3650ms (desfase exacto de medio ciclo)
    const cardLeft = document.getElementById("bento-card-left");
    const cardRight = document.getElementById("bento-card-right");

    if (cardLeft) setupBentoCard(cardLeft, bentoLeftArtifacts, 6500, 400);
    if (cardRight) setupBentoCard(cardRight, bentoRightArtifacts, 6500, 3650);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDualBento);
  } else {
    initDualBento();
  }
  document.addEventListener("astro:page-load", initDualBento);
</script>

