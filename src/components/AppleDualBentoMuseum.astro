---

<section class="apple-dual-bento-section w-full py-16 md:py-24 px-4 sm:px-6 relative z-10" id="showcase-dual-bento">
  <!-- ENCABEZADO DE SECCIÓN EDITORIAL (FUSIÓN PERFECTA CON EL FONDO TGP) -->
  <div class="max-w-4xl mx-auto text-center mb-12 md:mb-16">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/6 border border-white/10 text-white/70 text-[11px] font-mono tracking-widest uppercase mb-4 backdrop-blur-md">
      <span class="w-1.5 h-1.5 rounded-full bg-[#c9a96e] animate-pulse"></span>
      Fondo Documental · Dual Bento Showcase
    </div>
    <h2 class="font-gloock text-3xl sm:text-4xl md:text-5xl text-white tracking-tight mb-4">
      Arquetipos & Morfología Clásica
    </h2>
    <p class="font-inter text-sm sm:text-base text-white/60 max-w-2xl mx-auto leading-relaxed font-light">
      Morfología vertical 4:5 inspirada en el centro de home de Apple: tarjetas autónomas ultra-limpias, anclaje lítico sin recorte de miembros y rotación asíncrona de piezas de museo.
    </p>
  </div>

  <!-- CONTENEDOR GRID DUAL CENTRADO (HOME CENTER) -->
  <div class="max-w-5xl mx-auto w-full grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 items-stretch justify-center">

    <!-- ═══════════════════════════════════════════════════════
         TARJETA BENTO 1: CANON HELÉNICO (IZQUIERDA)
         ═══════════════════════════════════════════════════════ -->
    <div 
      class="bento-card-root group/bento relative rounded-4xl overflow-hidden bg-[#fbfbfd] text-[#1d1d1f] shadow-[0_20px_45px_rgba(0,0,0,0.3)] ring-1 ring-black/6 flex flex-col justify-between aspect-4/5 min-h-140 md:min-h-155 select-none transition-all duration-500 hover:shadow-[0_28px_60px_rgba(0,0,0,0.4)] hover:-translate-y-1"
      id="bento-card-left"
      data-card-id="left"
