---
/**
 * Hero Cinematográfico 100vh (Viewport Hero) para TGP.
 * Imagen full-bleed con fade-to-black profundo y revelación GSAP escalonada.
 */
import { Image } from "astro:assets";

interface Props {
  title: string;
  image?: ImageMetadata | null;
  imageAlt?: string;
  imagePosition?: string;
  eyebrow?: string;
  subtitle?: string;
  titleClass?: string;
}

const {
  title,
  image = null,
  imageAlt,
  imagePosition = "center center",
  eyebrow,
  subtitle,
  titleClass = "text-[clamp(2.5rem,6vw,5.5rem)] font-cinzel font-extrabold tracking-tight leading-[0.95] gradient-acero-ios drop-shadow-2xl",
} = Astro.props;
---

<header
  class="interior-hero relative w-full h-svh min-h-screen flex flex-col justify-end overflow-hidden bg-theme-dark text-white"
>
  {/* 1. Canvas Visual: Imagen Absoluta + Fade to Black */}
  <div class="absolute inset-0 z-0 overflow-hidden bg-black">
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt || title}
          class="interior-hero-image w-full h-full object-cover opacity-80"
          style={`object-position: ${imagePosition};`}
        />
      ) : (
        <div
          class="interior-hero-image w-full h-full bg-stone-900"
          aria-hidden="true"
        />
      )
    }

    {/* Gradiente de fusión profunda (Fade to Black) */}
    <div
      class="absolute inset-0 bg-linear-to-t from-theme-dark via-theme-dark/50 to-transparent/10 z-10"
    >
    </div>
    <div
      class="absolute inset-0 bg-linear-to-r from-theme-dark/70 via-transparent to-transparent z-10"
    >
    </div>
  </div>

  {/* 2. Escenario Tipográfico (Flotando sobre la imagen) */}
  <div
    class="relative z-20 w-full max-w-4xl mx-auto px-6 md:px-12 pb-24 md:pb-32 flex flex-col gap-5 text-left"
  >
    <slot name="breadcrumb" />

    {
      eyebrow && (
        <span class="interior-hero-reveal font-mono text-[10px] md:text-xs uppercase tracking-[0.4em] text-[#C8A98B] font-bold drop-shadow-md">
          {eyebrow}
        </span>
      )
    }

    <h1 class:list={["interior-hero-reveal", titleClass]}>
      {title}
    </h1>

    {
      subtitle && (
        <p class="interior-hero-reveal font-serif text-xl md:text-2xl text-stone-300 leading-relaxed italic max-w-3xl border-l-2 border-[#C8A98B] pl-5 mt-2 drop-shadow-lg">
          {subtitle}
        </p>
      )
    }

    <div class="interior-hero-reveal flex flex-col gap-4 mt-4">
      <slot name="meta" />
      <slot />
    </div>
  </div>
</header>

<script>
  import gsap from "gsap";

  const setupInteriorHeroReveal = () => {
    const hero = document.querySelector(".interior-hero");
    if (!hero || hero.hasAttribute("data-reveal-done")) return;
    hero.setAttribute("data-reveal-done", "true");

    const image = hero.querySelector(".interior-hero-image");
    const reveals = hero.querySelectorAll(".interior-hero-reveal");
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion) {
      if (image) gsap.set(image, { clearProps: "all" });
      gsap.set(reveals, { clearProps: "all" });
      return;
    }

    // Efecto Júpiter: Zoom out lento y majestuoso en la imagen
    if (image) {
      gsap.fromTo(
        image,
        { scale: 1.15, filter: "blur(4px)" },
        { scale: 1, filter: "blur(0px)", duration: 3.5, ease: "power2.out" },
      );
    }

    // Aparición tipográfica diacrónica (escalonada)
    if (reveals.length > 0) {
      gsap.fromTo(
        reveals,
        { y: 40, opacity: 0, filter: "blur(5px)" },
        {
          y: 0,
          opacity: 1,
          filter: "blur(0px)",
          duration: 1.2,
          delay: 0.3,
          stagger: 0.15,
          ease: "expo.out",
        },
      );
    }
  };

  document.addEventListener("DOMContentLoaded", setupInteriorHeroReveal);
  document.addEventListener("astro:page-load", setupInteriorHeroReveal);
</script>

<style>
  .interior-hero-image {
    will-change: transform, filter;
  }
  .interior-hero-reveal {
    opacity: 0;
    will-change: transform, opacity, filter;
  }
</style>
