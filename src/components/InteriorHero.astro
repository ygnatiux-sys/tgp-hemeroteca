---
/**
 * Hero Cinematográfico 100vh (Viewport Hero) para TGP.
 * Imagen full-bleed con fade-to-black profundo y revelación GSAP escalonada.
 */
import { Image } from "astro:assets";

interface Props {
  title: string;
  image?: ImageMetadata | null;
  imageAlt?: string;
  imagePosition?: string;
  eyebrow?: string;
  subtitle?: string;
  titleClass?: string;
}

const {
  title,
  image = null,
  imageAlt,
  imagePosition = "center center",
  eyebrow,
  subtitle,
  titleClass = "font-cinzel text-5xl md:text-7xl lg:text-8xl font-extrabold leading-tight tracking-tight bg-linear-to-r from-white via-[#E2E8F0] to-[#94A3B8] bg-clip-text text-transparent drop-shadow-[0_15px_50px_rgba(0,0,0,0.95)]",
} = Astro.props;
---

<header
  class="interior-hero relative w-full h-svh min-h-screen flex flex-col justify-end overflow-hidden bg-theme-dark text-white"
>
  {/* 1. Canvas Visual: Imagen Absoluta + Fade to Black */}
  <div class="absolute inset-0 z-0 overflow-hidden bg-black">
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt || title}
          class="interior-hero-image w-full h-full object-cover opacity-80"
          style={`object-position: ${imagePosition};`}
        />
      ) : (
        <div
          class="interior-hero-image w-full h-full bg-stone-900"
          aria-hidden="true"
        />
      )
    }

    {/* Gradiente de fusión profunda (Fade to Black) */}
    <div
      class="absolute inset-0 bg-linear-to-t from-theme-dark via-theme-dark/50 to-transparent/10 z-10"
    >
    </div>
    <div
      class="absolute inset-0 bg-linear-to-r from-theme-dark/70 via-transparent to-transparent z-10"
    >
    </div>
  </div>

  {/* 2. Escenario Tipográfico (Flotando sobre la imagen) */}
  <div
    class="relative z-20 w-full max-w-5xl mx-auto px-6 md:px-12 pb-24 md:pb-32 flex flex-col gap-5 text-left"
  >
    <slot name="breadcrumb" />

    {
      eyebrow && (
        <h2 class="interior-hero-reveal interior-hero-h2 font-mono text-xs md:text-sm uppercase tracking-[0.4em] text-[#EFEBE3] font-semibold drop-shadow-md pb-2">
          {eyebrow}
        </h2>
      )
    }

    <h1 class:list={["interior-hero-reveal", "interior-hero-h1", titleClass]}>
      {title}
    </h1>

    {
      subtitle && (
        <p class="interior-hero-reveal interior-hero-subtitle font-serif text-xl md:text-2xl text-stone-300 leading-relaxed italic max-w-3xl border-l-2 border-[#EFEBE3] pl-5 mt-2 drop-shadow-lg opacity-0">
          {subtitle}
        </p>
      )
    }

    <div class="interior-hero-reveal interior-hero-meta flex flex-col gap-4 -mt-1 opacity-0">
      <slot name="meta" />
      <slot />
    </div>
  </div>
</header>

<script>
  import gsap from "gsap";

  const setupInteriorHeroReveal = () => {
    const hero = document.querySelector(".interior-hero");
    if (!hero || hero.hasAttribute("data-reveal-done")) return;
    hero.setAttribute("data-reveal-done", "true");

    const image = hero.querySelector(".interior-hero-image");
    const h1 = hero.querySelector(".interior-hero-h1") as HTMLElement;
    const h2 = hero.querySelector(".interior-hero-h2") as HTMLElement;
    const subtitle = hero.querySelector(".interior-hero-subtitle") as HTMLElement;
    const metaContainer = hero.querySelector(".interior-hero-meta") as HTMLElement;
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion) {
      if (image) gsap.set(image, { clearProps: "all" });
      gsap.set(hero.querySelectorAll(".interior-hero-reveal"), { clearProps: "all" });
      if (h1) h1.classList.add("is-permanently-iridescent");
      return;
    }

    // Zoom out majestuoso de la imagen de fondo
    if (image) {
      gsap.fromTo(
        image,
        { scale: 1.12 },
        { scale: 1, duration: 4.5, ease: "power2.out" },
      );
    }

    const titleText = h1?.textContent?.trim() || "";
    const isSingleWord = titleText.length > 0 && titleText.split(/\s+/).length === 1;

    const tl = gsap.timeline();

    // RITMO 1: H2 (Eyebrow / Registro) entra descolgándose desde arriba y FADE OUT COMPLETO (opacity: 0)
    if (h2) {
      tl.fromTo(
        h2,
        { y: -15, opacity: 0 },
        { y: 0, opacity: 1, duration: 1.2, ease: "power2.out" },
        0.3
      )
      .to({}, { duration: 1.2 })
      .to(h2, { opacity: 0, y: -10, duration: 0.8, ease: "power2.in" });
    }

    // RITMO 2: H1 (Título Titanio)
    // PALABRAS DE UNA SOLA PALABRA (Tikal, Bonampak, Mercurio...): Ir al centro, crecer a ~1/3 de pantalla, iridiscer y continuar
    if (h1) {
      if (isSingleWord) {
        // Configurar para centrado exacto en pantalla completa
        gsap.set(h1, {
          position: "absolute",
          top: "50%",
          left: "50%",
          xPercent: -50,
          yPercent: -50,
          width: "100%",
          textAlign: "center",
          zIndex: 50,
          pointerEvents: "none"
        });

        tl.fromTo(
          h1,
          { scale: 0.85, opacity: 0 },
          {
            scale: 1.45, // Crece a cerca de 1/3 de pantalla
            opacity: 1,
            duration: 2.8,
            ease: "power3.out",
            onStart: () => {
              h1.classList.add("is-permanently-iridescent");
            }
          },
          "+=0.2"
        )
        // Tiempo a que iridiscen en el centro de pantalla
        .to({}, { duration: 2.5 })
        .to(h1, { opacity: 0, scale: 1.55, duration: 1.2, ease: "power2.inOut" });
      } else {
        // Títulos de múltiples palabras (comportamiento estándar)
        tl.fromTo(
          h1,
          { y: 25, scale: 0.94, opacity: 0 },
          { y: 0, scale: 1.04, opacity: 1, duration: 2.2, ease: "power2.out" },
          "+=0.2"
        )
        .to({}, { duration: 1.8 })
        .to(h1, { opacity: 0, scale: 1.08, duration: 1.0, ease: "power2.inOut" });
      }
    }

    // RITMO 3: Subtítulo entra, permite tiempo humano de lectura (~4.5s) y FADE OUT COMPLETO (opacity: 0)
    if (subtitle) {
      tl.fromTo(
        subtitle,
        { y: 20, opacity: 0 },
        { y: 0, opacity: 1, duration: 1.4, ease: "power2.out" },
        "+=0.2"
      )
      .to({}, { duration: 4.5 })
      .to(subtitle, { opacity: 0, y: -10, duration: 1.0, ease: "power2.inOut" });
    }

    // RITMO 4: Metadatos entran, tintinean (sparkle glint) y FADE OUT COMPLETO (opacity: 0) — salvo si hay hover
    if (metaContainer) {
      tl.fromTo(
        metaContainer,
        { opacity: 0, y: 15 },
        { opacity: 1, y: 0, duration: 1.0, ease: "power2.out" },
        "+=0.2"
      )
      .to(metaContainer, { filter: "brightness(1.8)", duration: 0.3, yoyo: true, repeat: 2 })
      .to(metaContainer, { opacity: 0, duration: 1.0, ease: "power2.inOut" }, "+=1.0");

      metaContainer.addEventListener("mouseenter", () => {
        gsap.to(metaContainer, { opacity: 1, filter: "brightness(1.3)", duration: 0.4 });
      });
      metaContainer.addEventListener("mouseleave", () => {
        gsap.to(metaContainer, { opacity: 0, filter: "brightness(1)", duration: 0.6 });
      });
    }

    // RITMO 5 (FINAL): H1 REAPARECE Y QUEDA PERMANENTE IRIDISCENTE CON FLARES DORADOS
    if (h1) {
      if (isSingleWord) {
        // Restaurar posición original del layout (al costado)
        tl.set(h1, { clearProps: "position,top,left,xPercent,yPercent,width,textAlign,zIndex,pointerEvents" });
      }

      const finalScale = isSingleWord ? 1.35 : 1.0;
      tl.fromTo(
        h1,
        { opacity: 0, scale: finalScale * 0.92, y: 15 },
        {
          opacity: 1,
          scale: finalScale,
          y: 0,
          duration: 2.2,
          ease: "power2.out",
          onComplete: () => {
            h1.classList.add("is-permanently-iridescent");
            // Habilitamos las transiciones CSS SOLO cuando GSAP termina
            h1.classList.add("is-interactive-ready"); 
          }
        },
        "+=0.3"
      );

      // Traer de vuelta los metadatos e íconos para que queden permanentemente debajo del título
      if (metaContainer) {
        tl.to(metaContainer, { opacity: 1, duration: 1.5, ease: "power2.out" }, "<");
      }
    }
  };

  document.addEventListener("DOMContentLoaded", setupInteriorHeroReveal);
  document.addEventListener("astro:page-load", setupInteriorHeroReveal);
</script>

<style>
  .interior-hero-image {
    will-change: transform;
  }
  .interior-hero-reveal {
    opacity: 0;
    will-change: transform, opacity;
  }

  /* El H1 base NO tiene transition de transform para no pelear con GSAP */
  .interior-hero-h1 {
    /* Mantenemos solo el clip-text base */
  }

  /* Esta clase se añade vía JS cuando termina la timeline */
  .interior-hero-h1.is-interactive-ready {
    transition: letter-spacing 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.6s ease;
  }

  .interior-hero-h1.is-permanently-iridescent {
    background-image: linear-gradient(
      115deg,
      #ffffff 0%,
      #e2e8f0 18%,
      #fde047 38%,
      #ffffff 50%,
      #EFEBE3 62%,
      #94a3b8 80%,
      #ffffff 100%
    );
    background-size: 220% auto;
    animation: shineGoldTitanium 4.0s linear infinite;
    /* Optimización GPU obligatoria para evitar glitches de repintado */
    transform: translateZ(0);
    will-change: filter, background-position;
    filter: drop-shadow(0 0 25px rgba(253, 224, 71, 0.35)) drop-shadow(0 15px 50px rgba(0,0,0,0.95));
  }

  .interior-hero-h1.is-interactive-ready:hover {
    letter-spacing: 0.04em;
    transform: scaleX(1.03) translateZ(0);
    filter: drop-shadow(0 0 45px rgba(253, 224, 71, 0.6)) drop-shadow(0 15px 50px rgba(0,0,0,0.95));
  }

  @keyframes shineGoldTitanium {
    0% {
      background-position: 0% center;
    }
    100% {
      background-position: 220% center;
    }
  }
</style>
