---
import { resolveMultivisionClass } from "../lib/multivision";
/**
 * Hero Cinematográfico 100vh (Viewport Hero) para TGP.
 * Imagen full-bleed con fade-to-black profundo y revelación GSAP escalonada.
 */
import Image from './SafeImage.astro';
import { sanitizeImageUrl } from "../lib/content-filter";

interface Props {
  title: string;
  image?: ImageMetadata | string | null;
  imageAlt?: string;
  imagePosition?: string;
  eyebrow?: string;
  subtitle?: string;
  titleClass?: string;
  enableBladeWipe?: boolean;
}

const {
  title,
  image = null,
  imageAlt,
  imagePosition = "center center",
  eyebrow,
  subtitle,
  titleClass = "font-cinzel text-5xl md:text-7xl lg:text-8xl font-extrabold leading-tight tracking-tight bg-linear-to-r from-white via-[#E2E8F0] to-[#94A3B8] bg-clip-text text-transparent drop-shadow-[0_15px_50px_rgba(0,0,0,0.95)]",
  enableBladeWipe = false,
} = Astro.props;

const safeImageUrl = sanitizeImageUrl(image);
---

<header
  class="interior-hero relative w-full h-svh min-h-screen flex flex-col justify-end overflow-hidden bg-theme-dark text-white select-none md:select-auto"
  data-blade-wipe={enableBladeWipe ? "true" : "false"}
>
  {/* 1. Canvas Visual: Imagen Absoluta + Fade to Black */}
  <div
    id="interior-hero-canvas"
    class="absolute inset-0 z-0 overflow-hidden bg-black will-change-[clip-path]"
    style={enableBladeWipe ? "clip-path: url(#interior-blade-clip); -webkit-clip-path: url(#interior-blade-clip);" : undefined}
  >
    {
      safeImageUrl ? (
        <Image
          src={safeImageUrl}
          alt={imageAlt || title}
          inferSize={true}
          format="webp"
          class={`interior-hero-image opacity-100 absolute inset-0 w-full h-full ${resolveMultivisionClass(image)}`}
          style={`object-position: ${imagePosition};`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      ) : (
        <div
          class="interior-hero-image w-full h-full bg-stone-900"
          aria-hidden="true"
        />
      )
    }

    {/* Gradiente de fusión profunda (Fade to Black) */}
    <div
      class="absolute inset-0 bg-linear-to-t from-theme-dark via-theme-dark/50 to-transparent/10 z-10"
    >
    </div>
    <div
      class="absolute inset-0 bg-linear-to-r from-theme-dark/70 via-transparent to-transparent z-10"
    >
    </div>
  </div>

  {/* Motor SVG geométrico para The Blade Wipe sincronizado */}
  {enableBladeWipe && (
    <svg
      id="interior-blade-svg"
      class="absolute inset-0 w-full h-full pointer-events-none z-30 overflow-visible"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <clipPath id="interior-blade-clip" clipPathUnits="userSpaceOnUse">
          <polygon id="interior-blade-poly" points="0 0, 0 0, 0 0" />
        </clipPath>
        <filter id="interior-ray-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="2" result="blur1" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="6" result="blur2" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="16" result="blur3" />
          <feMerge>
            <feMergeNode in="blur3" />
            <feMergeNode in="blur2" />
            <feMergeNode in="blur1" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <line
        id="interior-ray-aura"
        x1="0" y1="0" x2="0" y2="0"
        stroke="#d4af37"
        stroke-width="9"
        stroke-linecap="round"
        filter="url(#interior-ray-glow)"
        opacity="0"
      />
      <line
        id="interior-ray-core"
        x1="0" y1="0" x2="0" y2="0"
        stroke="#ffffff"
        stroke-width="2.5"
        stroke-linecap="round"
        filter="url(#interior-ray-glow)"
        opacity="0"
      />
      <circle id="interior-spark-a" cx="0" cy="0" r="5" fill="#ffffff" filter="url(#interior-ray-glow)" opacity="0" />
      <circle id="interior-spark-b" cx="0" cy="0" r="5" fill="#ffffff" filter="url(#interior-ray-glow)" opacity="0" />
    </svg>
  )}

  {/* 2. Escenario Tipográfico (Centrado dinámico sobre la imagen) */}
  <div
    class="relative z-20 w-full max-w-5xl mx-auto px-6 md:px-12 pb-20 md:pb-28 flex flex-col items-center justify-end text-center gap-4 md:gap-5"
  >
    <slot name="breadcrumb" />

    {
      eyebrow && (
        <h2 class="interior-hero-reveal interior-hero-h2 font-metadata text-xs md:text-sm uppercase tracking-[0.4em] text-[#EFEBE3]/50 font-medium drop-shadow-md pb-1 text-center">
          {eyebrow}
        </h2>
      )
    }

    <h1 class:list={["interior-hero-reveal", "interior-hero-h1", "text-center", titleClass]}>
      {title}
    </h1>

    {
      subtitle && (
        <p class="interior-hero-reveal interior-hero-subtitle font-serif text-lg md:text-2xl text-stone-300/80 leading-relaxed max-w-3xl text-center mx-auto mt-1 drop-shadow-lg opacity-0 tracking-wide">
          "{subtitle}"
        </p>
      )
    }

    <div class="interior-hero-reveal interior-hero-meta flex flex-col items-center justify-center gap-4 -mt-1 opacity-0 w-full">
      <slot name="meta" />
      <slot />
    </div>
  </div>
</header>

<script>
  import gsap from "gsap";

  const setupInteriorHeroReveal = () => {
    const hero = document.querySelector(".interior-hero");
    if (!hero || hero.hasAttribute("data-reveal-done")) return;
    hero.setAttribute("data-reveal-done", "true");

    const header = document.getElementById("site-header");
    const image = hero.querySelector(".interior-hero-image");
    const h1 = hero.querySelector(".interior-hero-h1") as HTMLElement;
    const h2 = hero.querySelector(".interior-hero-h2") as HTMLElement;
    const subtitle = hero.querySelector(".interior-hero-subtitle") as HTMLElement;
    const metaContainer = hero.querySelector(".interior-hero-meta") as HTMLElement;
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion) {
      if (image) gsap.set(image, { clearProps: "all" });
      gsap.set(hero.querySelectorAll(".interior-hero-reveal"), { clearProps: "all" });
      if (h1) h1.classList.add("is-permanently-iridescent");
      if (header) gsap.set(header, { opacity: 1, y: 0, pointerEvents: "auto" });
      return;
    }

    // ── Ocultar menubar inicialmente en el hero interior con desbloqueo interactivo ──
    if (header) {
      gsap.set(header, { opacity: 0, y: -25, pointerEvents: "none" });
    }

    // Función de revelación y desbloqueo inmediato para permitir salir en cualquier momento
    const unlockNavigation = () => {
      if (header) {
        gsap.to(header, {
          opacity: 1,
          y: 0,
          pointerEvents: "auto",
          duration: 0.4,
          overwrite: "auto",
          ease: "power2.out"
        });
      }
      const backBtn = document.getElementById('back-slide-btn');
      if (backBtn) {
        backBtn.classList.add('is-visible');
      }
    };

    // Desbloquear navegación al pasar el cursor por arriba (hover) o por el lateral
    const onPointerMove = (e: MouseEvent | TouchEvent) => {
      const clientY = 'clientY' in e ? e.clientY : (e.touches[0]?.clientY ?? 999);
      const clientX = 'clientX' in e ? e.clientX : (e.touches[0]?.clientX ?? 999);
      if (clientY < 110 || clientX < 90) {
        unlockNavigation();
      }
    };

    window.addEventListener("mousemove", onPointerMove, { passive: true });
    window.addEventListener("touchstart", onPointerMove, { passive: true });
    
    // Desbloquear al hacer clic en cualquier parte
    hero.addEventListener("click", unlockNavigation);
    window.addEventListener("click", unlockNavigation);

    // Desbloquear en scroll
    window.addEventListener("scroll", unlockNavigation, { passive: true, once: true });

    const isBladeWipe = hero.getAttribute("data-blade-wipe") === "true";
    const canvas = hero.querySelector("#interior-hero-canvas") as HTMLElement;
    const cutterWrap = hero.querySelector(".blade-cutter-wrap") as HTMLElement;
    const slashLine = hero.querySelector(".blade-slash-line") as HTMLElement;

    // Zoom out majestuoso de la imagen de fondo
    if (image) {
      gsap.fromTo(
        image,
        { scale: 1.12 },
        { scale: 1, duration: 5.5, ease: "power2.out" },
      );
    }

    const tl = gsap.timeline({
      onComplete: () => {
        // Garantizar que el menubar quede 100% interactivo al terminar
        unlockNavigation();
      }
    });

    // CORTE DIAGONAL ANIME: THE BLADE WIPE SINCRONIZADO
    if (isBladeWipe) {
      const updateInteriorBlade = (progress: number) => {
        const poly = hero.querySelector("#interior-blade-poly");
        const rayAura = hero.querySelector("#interior-ray-aura");
        const rayCore = hero.querySelector("#interior-ray-core");
        const sparkA = hero.querySelector("#interior-spark-a");
        const sparkB = hero.querySelector("#interior-spark-b");
        if (!poly || !rayAura || !rayCore) return;

        const W = window.innerWidth;
        const H = window.innerHeight;
        const Lsq = W * W + H * H;

        if (progress <= 0) {
          poly.setAttribute("points", `0 ${H}, 0 ${H}, 0 ${H}`);
          rayAura.setAttribute("opacity", "0");
          rayCore.setAttribute("opacity", "0");
          if (sparkA) sparkA.setAttribute("opacity", "0");
          if (sparkB) sparkB.setAttribute("opacity", "0");
          return;
        }

        if (progress >= 1) {
          poly.setAttribute("points", `0 0, ${W} 0, ${W} ${H}, 0 ${H}`);
          rayAura.setAttribute("opacity", "0");
          rayCore.setAttribute("opacity", "0");
          if (sparkA) sparkA.setAttribute("opacity", "0");
          if (sparkB) sparkB.setAttribute("opacity", "0");
          return;
        }

        const yL = H - progress * (Lsq / H);
        const xB = progress * (Lsq / W);
        const xT = W - (1 - progress) * (Lsq / W);
        const yR = (1 - progress) * (Lsq / H);

        const intersections: { x: number; y: number }[] = [];
        if (yL >= 0 && yL <= H) intersections.push({ x: 0, y: yL });
        if (xB >= 0 && xB <= W) intersections.push({ x: xB, y: H });
        if (xT >= 0 && xT <= W) intersections.push({ x: xT, y: 0 });
        if (yR >= 0 && yR <= H) intersections.push({ x: W, y: yR });

        if (intersections.length >= 2) {
          const p1 = intersections[0];
          const p2 = intersections[1];

          rayAura.setAttribute("x1", `${p1.x}`);
          rayAura.setAttribute("y1", `${p1.y}`);
          rayAura.setAttribute("x2", `${p2.x}`);
          rayAura.setAttribute("y2", `${p2.y}`);
          rayAura.setAttribute("opacity", "0.9");

          rayCore.setAttribute("x1", `${p1.x}`);
          rayCore.setAttribute("y1", `${p1.y}`);
          rayCore.setAttribute("x2", `${p2.x}`);
          rayCore.setAttribute("y2", `${p2.y}`);
          rayCore.setAttribute("opacity", "1");

          if (sparkA) {
            sparkA.setAttribute("cx", `${p1.x}`);
            sparkA.setAttribute("cy", `${p1.y}`);
            sparkA.setAttribute("opacity", "1");
          }
          if (sparkB) {
            sparkB.setAttribute("cx", `${p2.x}`);
            sparkB.setAttribute("cy", `${p2.y}`);
            sparkB.setAttribute("opacity", "1");
          }

          const pts: { x: number; y: number }[] = [{ x: 0, y: H }];
          if (yL < 0) pts.push({ x: 0, y: 0 });
          if (xT >= 0 && xT <= W) pts.push({ x: xT, y: 0 });
          if (yR >= 0 && yR <= H) pts.push({ x: W, y: yR });
          if (xB > W) pts.push({ x: W, y: H });
          if (xB >= 0 && xB <= W) pts.push({ x: xB, y: H });
          if (yL >= 0 && yL <= H) pts.push({ x: 0, y: yL });

          poly.setAttribute("points", pts.map(pt => `${Math.round(pt.x)} ${Math.round(pt.y)}`).join(", "));
        }
      };

      updateInteriorBlade(0);
      const progressTracker = { val: 0 };

      tl.to(progressTracker, {
        val: 1,
        duration: 1.5,
        ease: "power3.out",
        onUpdate: () => {
          updateInteriorBlade(progressTracker.val);
        }
      }, 0.1);

      // Micro-impacto Camera Shake sutil durante el paso del filo
      tl.to(hero, { x: 3, y: -2, duration: 0.05, ease: "power4.inOut" }, 0.3)
        .to(hero, { x: -2, y: 1.5, duration: 0.05, ease: "power4.inOut" })
        .to(hero, { x: 0, y: 0, duration: 0.08, ease: "power2.out" });
    }

    // RITMO 1: Colección / Categoría entra apagada y suave (opacity: 0.55), luego FADE OUT
    if (h2) {
      tl.fromTo(
        h2,
        { y: -12, opacity: 0 },
        { y: 0, opacity: 0.55, duration: 1.4, ease: "power2.out" },
        0.3
      )
      .to({}, { duration: 1.4 })
      .to(h2, { opacity: 0, y: -8, duration: 0.8, ease: "power2.in" });
    }

    // RITMO 2: H1 (Scale Up Ampliado) + imagen fija nítida
    if (h1) {
      gsap.set(h1, { transformOrigin: "center center" });

      // Ajuste sutil de brillo sin desenfoque
      if (image) {
        tl.to(
          image,
          { opacity: 0.75, duration: 2.0, ease: "power2.inOut" },
          "+=0.1"
        );
      }

      tl.fromTo(
        h1,
        { scale: 0.88, opacity: 0, y: 15 },
        {
          scale: 1.18,
          opacity: 1,
          y: 0,
          duration: 3.8,
          ease: "power2.out",
          onStart: () => {
            h1.classList.add("is-permanently-iridescent");
          }
        },
        "<"
      )
      // Contemplación del titanio cepillado
      .to({}, { duration: 3.0 })
      // Título hace scale-up fade out, imagen recupera opacidad plena
      .to(h1, { opacity: 0, scale: 1.50, duration: 1.4, ease: "power2.inOut" });

      // Imagen vuelve a opacidad completa nítida
      if (image) {
        tl.to(
          image,
          { opacity: 1.0, duration: 2.2, ease: "power3.out" },
          "<0.6"
        );
      }
    }

    // RITMO 3: Subtítulo entra centrado, permite lectura y FADE OUT
    if (subtitle) {
      tl.fromTo(
        subtitle,
        { y: 12, opacity: 0 },
        { y: 0, opacity: 0.85, duration: 1.4, ease: "power2.out" },
        "+=0.2"
      )
      .to({}, { duration: 4.0 })
      .to(subtitle, { opacity: 0, y: -8, duration: 1.0, ease: "power2.inOut" });
    }

    // RITMO 4: Metadatos entran apagados por defecto (opacity: 0.6) y FADE OUT
    if (metaContainer) {
      tl.fromTo(
        metaContainer,
        { opacity: 0 },
        { opacity: 0.6, duration: 1.2, ease: "power2.out" },
        "+=0.2"
      )
      .to({}, { duration: 1.4 })
      .to(metaContainer, { opacity: 0, duration: 1.0, ease: "power2.inOut" });
    }

    // RITMO 5 (FINAL): H1 Y METADATOS REAPARECEN ESTABLES EN EL CENTRO
    if (h1) {
      tl.fromTo(
        h1,
        { opacity: 0, scale: 0.95 },
        {
          opacity: 1,
          scale: 1.0,
          duration: 2.0,
          ease: "power2.out",
          onComplete: () => {
            h1.classList.add("is-permanently-iridescent");
            h1.classList.add("is-interactive-ready");
          }
        },
        "+=0.2"
      );

      if (metaContainer) {
        tl.to(metaContainer, { opacity: 0.65, duration: 1.6, ease: "power2.out" }, "<");
      }
    }

    // ── REAPARICIÓN DEL MENUBAR AL FINAL DEL TIMELINE GSAP ──
    if (header) {
      tl.to(
        header,
        {
          opacity: 1,
          y: 0,
          pointerEvents: "auto",
          duration: 1.4,
          ease: "power2.out",
        },
        "-=0.8"
      );
    }
  };

  document.addEventListener("astro:before-swap", () => {
    const header = document.getElementById("site-header");
    if (header) {
      gsap.set(header, { opacity: 1, y: 0, pointerEvents: "auto" });
    }
  });

  document.addEventListener("DOMContentLoaded", setupInteriorHeroReveal);
  document.addEventListener("astro:page-load", setupInteriorHeroReveal);
</script>

<style>
  .interior-hero-image {
    will-change: transform;
  }
  .interior-hero-reveal {
    opacity: 0;
    will-change: transform, opacity;
  }

  /* El H1 base NO tiene transition de transform para no pelear con GSAP */
  .interior-hero-h1 {
    /* Mantenemos solo el clip-text base */
  }

  /* Esta clase se añade vía JS cuando termina la timeline */
  .interior-hero-h1.is-interactive-ready {
    transition: letter-spacing 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.6s ease;
  }

  .interior-hero-h1.is-permanently-iridescent {
    background-image: linear-gradient(
      110deg,
      #718096 0%,
      #94A3B8 22%,
      #64748B 45%,
      #475569 68%,
      #334155 88%,
      #718096 100%
    );
    background-size: 220% 100%;
    animation: titaniumMetallicSweep 16s ease-in-out infinite;
    /* Optimización GPU obligatoria para evitar glitches de repintado */
    transform: translateZ(0);
    will-change: filter, background-position;
    filter: drop-shadow(0 15px 50px rgba(0, 0, 0, 0.95));
  }

  .interior-hero-h1.is-interactive-ready:hover {
    letter-spacing: 0.03em;
    transform: scale(1.02) translateZ(0);
    filter: drop-shadow(0 0 30px rgba(239, 235, 227, 0.35)) drop-shadow(0 15px 50px rgba(0, 0, 0, 0.95));
  }
</style>
