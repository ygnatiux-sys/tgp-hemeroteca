---
/**
 * src/components/AsiaSecretsNarrative.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * COLECCIÓN DESTACADA: 'ASIA SECRETS' (TIMELINE UNIFICADA EN LOOP CONTINUO)
 *
 * Secuencia cinematográfica integral en un solo lienzo:
 * 1. Intro Colección: Ambient Glow Púrpura/Negro → ASIA (3D Z) → SECRETS (Púrpura).
 * 2. Transición fluida a GUNUNG PADANG: Fotografía brillante + Excavación Estratigráfica
 *    en 5 estratos desde el vacío + choque tectónico + escáner GPR + subtítulo.
 * 3. Loop infinito continuo (repite suavemente el ciclo cinematográfico).
 * 4. Cero metadata innecesaria: experiencia de puro cine arqueológico.
 */
import imgGunung from "../assets/alternativa/gunung-padang.jpg";

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

// 5 Estratos geológicos continuos para Gunung Padang
const strataClips = [
  "polygon(0 0, 100% 0, 100% 21%, 91% 22.5%, 82% 19.5%, 71% 22%, 58% 19%, 43% 22%, 30% 19.5%, 16% 22%, 0 20%)",
  "polygon(0 20%, 16% 22%, 30% 19.5%, 43% 22%, 58% 19%, 71% 22%, 82% 19.5%, 91% 22.5%, 100% 21%, 100% 41%, 92% 42.5%, 80% 39%, 67% 42.5%, 52% 39%, 36% 42.5%, 21% 39.5%, 0 41%)",
  "polygon(0 41%, 21% 39.5%, 36% 42.5%, 52% 39%, 67% 42.5%, 80% 39%, 92% 42.5%, 100% 41%, 100% 62%, 88% 63.5%, 76% 60%, 62% 63.5%, 48% 60%, 33% 63.5%, 17% 60.5%, 0 62%)",
  "polygon(0 62%, 17% 60.5%, 33% 63.5%, 48% 60%, 62% 63.5%, 76% 60%, 88% 63.5%, 100% 62%, 100% 82%, 93% 83.5%, 81% 80.5%, 69% 83%, 55% 80.5%, 41% 83%, 26% 80.5%, 12% 83%, 0 81%)",
  "polygon(0 81%, 12% 83%, 26% 80.5%, 41% 83%, 55% 80.5%, 69% 83%, 81% 80.5%, 93% 83.5%, 100% 82%, 100% 100%, 0 100%)",
];
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://api.fontshare.com" />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,900,0,1&display=swap"
/>
<link
  rel="stylesheet"
  href="https://api.fontshare.com/v2/css?f[]=clash-grotesk@700&display=swap"
/>

<section
  id="asia-secrets"
  class={`asia-unified-stage relative w-full h-svh min-h-145 bg-[#040206] text-[#f5f3f7] select-none overflow-hidden ${className}`}
  aria-label="Colección Destacada: Asia Secrets"
>
  <!-- ════════════════════════════════════════════════════════════════════════
       CAPA 1: APERTURA ASIA SECRETS (AMBIENT GLOW PÚRPURA A NEGRO — SIN FOTO)
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="asia-layer-intro absolute inset-0 z-20 flex items-center justify-center overflow-hidden bg-[#040206]">
    <!-- Ambient Glow: destello de color suave en la esquina superior derecha -->
    <div class="absolute -top-[15%] -right-[10%] w-[75vw] h-[75vw] max-w-225 max-h-225 rounded-full bg-[radial-gradient(circle_at_center,rgba(147,51,234,0.38)_0%,rgba(107,33,168,0.18)_35%,rgba(67,15,112,0.06)_60%,transparent_75%)] blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-[20%] -left-[15%] w-[60vw] h-[60vw] max-w-175 max-h-175 rounded-full bg-[radial-gradient(circle_at_center,rgba(126,34,206,0.22)_0%,rgba(88,28,135,0.08)_40%,transparent_70%)] blur-3xl pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_35%,rgba(4,2,6,0.75)_70%,#040206_100%)] pointer-events-none"></div>
    <div class="asia-grain absolute inset-0 opacity-20 pointer-events-none mix-blend-overlay"></div>
    <div class="asia-spores absolute inset-0 pointer-events-none z-10" aria-hidden="true"></div>

    <!-- Cámara 3D (Perspectiva Derinkuyu Z) -->
    <div class="asia-3d-viewport absolute inset-0 flex items-center justify-center pointer-events-none z-20 px-4">
      <div class="asia-chamber relative flex flex-col items-center justify-center text-center w-full max-w-6xl">
        
        <!-- TÍTULO: ASIA (Entra masivo frontal y cae en perspectiva Z) -->
        <h1 class="asia-title-word font-fraunces font-black uppercase text-[clamp(4.8rem,18vw,17.5rem)] leading-[0.84] tracking-[-0.035em] whitespace-nowrap text-transparent opacity-0">
          ASIA
        </h1>

        <!-- SECRETS: Emerge nítido al caer ASIA -->
        <div class="asia-secrets-wrap absolute top-1/2 -translate-y-1/2 flex flex-col items-center justify-center text-center opacity-0 pointer-events-none">
          <h2 class="asia-secrets-word font-mono font-bold uppercase text-[clamp(1.6rem,5.5vw,4.5rem)] tracking-[0.38em] text-[#c084fc] drop-shadow-[0_0_35px_rgba(192,132,252,0.5)]">
            SECRETS
          </h2>
        </div>

      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════════════
       CAPA 2: REVELACIÓN GUNUNG PADANG (FOTOGRAFÍA ORIGINAL Y EXCAVACIÓN)
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="asia-layer-gp absolute inset-0 z-10 flex items-center justify-center overflow-hidden opacity-0 bg-[#060a08]">
    <!-- Fotografía original luminosa sin oscurecedores agresivos -->
    <div class="absolute inset-0 overflow-hidden">
      <img
        src={imgGunung.src}
        alt="Columnas de basalto en Gunung Padang"
        class="gp-bg-img absolute inset-0 w-full h-full object-cover object-[center_35%] filter brightness-105 contrast-102 will-change-transform"
        loading="eager"
        decoding="async"
      />
    </div>

    <!-- Sutil degradado únicamente en los bordes para lectura -->
    <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_center,transparent_42%,rgba(6,10,8,0.32)_78%,rgba(6,10,8,0.88)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-36 bg-linear-to-t from-[#060a08] to-transparent pointer-events-none"></div>

    <!-- Título Estratigráfico Central -->
    <div class="absolute inset-0 flex flex-col items-center justify-center p-4 z-20 pointer-events-none">
      <div class="gp-shake-box relative flex flex-col items-center will-change-transform">
        <h2 class="gp-h2 relative m-0 font-['Clash_Grotesk'] font-bold text-[clamp(3.2rem,10.5vw,11.5rem)] leading-[0.9] tracking-[-0.02em] uppercase text-center whitespace-nowrap">
          <span class="gp-sizer block invisible px-1 py-0.5">GUNUNG PADANG</span>

          <!-- 5 Estratos Geológicos con Textura Lítica Ósea y Fósforo Natural -->
          {strataClips.map((clip, i) => (
            <span
              class="gp-slice gp-bone-lithic absolute inset-0 block px-1 py-0.5 opacity-0 will-change-transform pointer-events-none"
              style={`clip-path: ${clip};`}
              data-index={i}
            >
              GUNUNG PADANG
            </span>
          ))}

          <!-- Haz de Escáner Georradar (GPR) con Fosforescencia Mineral -->
          <span class="gp-gpr-scan absolute -inset-x-[10%] -inset-y-[15%] z-10 pointer-events-none opacity-0 -translate-y-[120%] will-change-transform"></span>
        </h2>

        <!-- Subtítulo que emerge con máscara -->
        <div class="gp-sub-wrap relative w-full mt-3 overflow-hidden pt-1 pb-2 mask-[linear-gradient(to_bottom,transparent_0%,black_22%,black_100%)]">
          <p class="gp-sub m-0 font-['Clash_Grotesk'] font-medium text-[clamp(0.78rem,1.2vw,1.4rem)] tracking-[0.28em] uppercase text-center text-[#a95a3f] drop-shadow-[0_4px_20px_rgba(6,10,8,0.95)] opacity-0 translate-y-[120%] will-change-transform">
            La pirámide que fractura el Holoceno
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* CÁMARA 3D DERINKUYU */
  .asia-3d-viewport {
    perspective: 1100px;
    perspective-origin: 50% 48%;
  }

  .asia-chamber {
    transform-style: preserve-3d;
  }

  /* TÍTULO ASIA EN OFF-WHITE CON GLOW PÚRPURA */
  .asia-title-word {
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      #ede9fe 45%,
      #d8b4fe 80%,
      #a855f7 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 20px 45px rgba(0, 0, 0, 0.98))
      drop-shadow(0 0 45px rgba(168, 85, 247, 0.38));
    will-change: transform, opacity, filter;
  }

  /* Grano analógico */
  .asia-grain {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  .asia-spores :global(span) {
    position: absolute;
    border-radius: 50%;
    background: #c084fc;
    pointer-events: none;
  }

  .gp-bg-img {
    animation: gp-drift 32s ease-in-out infinite alternate;
  }
  @keyframes gp-drift {
    0% { transform: scale(1); }
    100% { transform: scale(1.045); }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     GUNUNG PADANG: GRANULADO LÍTICO TIPO ÓSEO & GRADIENTES NATURALES FOSFÓREOS
  ═══════════════════════════════════════════════════════════════════════════ */
  .gp-h2 {
    filter: drop-shadow(0 20px 48px rgba(0, 0, 0, 0.98))
      drop-shadow(0 0 35px rgba(126, 231, 166, 0.35))
      drop-shadow(0 0 12px rgba(74, 222, 128, 0.22));
  }

  .gp-slice {
    position: absolute;
    inset: 0;
    /* Gradiente natural fosfóreo: marfil/hueso antiguo mineralizado a fósforo verde-jade */
    background: linear-gradient(
      180deg,
      #fefcf6 0%,
      #f2ede0 22%,
      #d4f7dc 46%,
      #86efac 72%,
      #3bb86a 90%,
      #144226 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* Micro-granulado lítico tipo óseo (caliza fosilizada / apatita porosa) */
  .gp-slice::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.36;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='bone'><feTurbulence type='fractalNoise' baseFrequency='0.88' numOctaves='4' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23bone)'/></svg>");
  }

  /* Haz de Escáner Georradar (GPR) con destello fosfóreo mineral */
  .gp-gpr-scan {
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(212, 247, 220, 0.08) 25%,
      rgba(255, 255, 255, 0.5) 48%,
      rgba(134, 239, 172, 0.75) 52%,
      rgba(74, 222, 128, 0.25) 75%,
      transparent 100%
    );
    mix-blend-mode: overlay;
  }
</style>

<script>
  import gsap from "gsap";

  const initUnifiedAsiaTimeline = () => {
    const stage = document.querySelector<HTMLElement>(".asia-unified-stage");
    if (!stage || stage.dataset.ready === "true") return;
    stage.dataset.ready = "true";

    // Capa 1: Intro Colección
    const layerIntro = stage.querySelector<HTMLElement>(".asia-layer-intro");
    const titleAsia = stage.querySelector<HTMLElement>(".asia-title-word");
    const wrapSecrets = stage.querySelector<HTMLElement>(".asia-secrets-wrap");
    const spores = stage.querySelector<HTMLElement>(".asia-spores");

    // Capa 2: Gunung Padang
    const layerGp = stage.querySelector<HTMLElement>(".asia-layer-gp");
    const gpShakeBox = stage.querySelector<HTMLElement>(".gp-shake-box");
    const gpSlices = stage.querySelectorAll<HTMLElement>(".gp-slice");
    const gpScan = stage.querySelector<HTMLElement>(".gp-gpr-scan");
    const gpSub = stage.querySelector<HTMLElement>(".gp-sub");

    if (!layerIntro || !titleAsia || !wrapSecrets || !layerGp || !gpShakeBox || gpSlices.length === 0 || !gpScan || !gpSub) return;

    let masterTl: gsap.core.Timeline | null = null;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Esporas ambientales flotantes
    const spawnSpores = () => {
      if (!spores) return;
      spores.innerHTML = "";
      const count = 24;
      const w = stage.offsetWidth;
      const h = stage.offsetHeight;

      for (let i = 0; i < count; i++) {
        const dot = document.createElement("span");
        const s = 1.2 + Math.random() * 2.5;
        dot.style.width = `${s}px`;
        dot.style.height = `${s}px`;
        dot.style.left = `${Math.random() * w}px`;
        dot.style.top = `${h * 0.2 + Math.random() * (h * 0.7)}px`;
        dot.style.opacity = "0";
        spores.appendChild(dot);

        gsap.to(dot, {
          opacity: 0.2 + Math.random() * 0.5,
          y: -(30 + Math.random() * 80),
          x: (Math.random() - 0.5) * 40,
          duration: 3 + Math.random() * 3,
          ease: "sine.inOut",
          repeat: -1,
          yoyo: true,
          delay: Math.random() * 2,
        });
      }
    };

    const resetElements = () => {
      gsap.set(layerIntro, { opacity: 1, display: "flex" });
      gsap.set(titleAsia, { opacity: 0, scale: 1.08, z: 0, y: 0, filter: "blur(0px)" });
      gsap.set(wrapSecrets, { opacity: 0, scale: 0.9, y: 0 });

      gsap.set(layerGp, { opacity: 0 });
      gsap.set(gpShakeBox, { x: 0, y: 0 });
      gpSlices.forEach((slice, idx) => {
        const dir = idx % 2 === 0 ? -140 : 140;
        gsap.set(slice, { x: 0, xPercent: dir, opacity: 0, scale: 1.02 });
      });
      gsap.set(gpScan, { yPercent: -130, opacity: 0 });
      gsap.set(gpSub, { yPercent: 120, opacity: 0 });
    };

    const buildTimeline = async () => {
      if (document.fonts?.ready) await document.fonts.ready;
      masterTl?.kill();
      resetElements();

      if (reduceMotion) {
        gsap.set(layerIntro, { opacity: 1 });
        gsap.set(titleAsia, { opacity: 1, scale: 1 });
        return;
      }

      // TIMELINE UNIFICADA EN LOOP CONTINUO
      masterTl = gsap.timeline({
        repeat: -1,
        repeatDelay: 1.2,
      });

      // ─────────────────────────────────────────────────────────────
      // FASE 1: APERTURA ASIA SECRETS (AMBIENT GLOW PÚRPURA / NEGRO)
      // ─────────────────────────────────────────────────────────────
      // 1. ASIA aparece en primer plano frontal
      masterTl.to(titleAsia, {
        opacity: 1,
        scale: 1,
        duration: 1.4,
        ease: "power2.out",
      }, 0.3)
        // 2. Contemplación de ASIA
        .to({}, { duration: 0.7 })

        // 3. PARALAJE Z (Derinkuyu): ASIA cae hacia el fondo tridimensional
        .to(titleAsia, {
          scale: 0.46,
          z: -520,
          y: 28,
          opacity: 0.15,
          filter: "blur(9px)",
          duration: 2.2,
          ease: "power3.inOut",
        }, "asiaFall")

        // 4. SECRETS entra al centro con gran nitidez
        .to(wrapSecrets, {
          opacity: 1,
          scale: 1,
          duration: 1.5,
          ease: "power2.out",
        }, "asiaFall+=0.7")

        // 5. Contemplación del título completo
        .to({}, { duration: 1.2 });

      // ─────────────────────────────────────────────────────────────
      // FASE 2: TRANSICIÓN FLUIDA A GUNUNG PADANG
      // ─────────────────────────────────────────────────────────────
      masterTl.to(layerIntro, {
        opacity: 0,
        duration: 1.3,
        ease: "power2.inOut",
      }, "gpTransition")
        .to(layerGp, {
          opacity: 1,
          duration: 1.3,
          ease: "power2.inOut",
        }, "gpTransition");

      // ─────────────────────────────────────────────────────────────
      // FASE 3: EXCAVACIÓN ESTRATIGRÁFICA DE GUNUNG PADANG
      // ─────────────────────────────────────────────────────────────
      // 6. Los 5 estratos emergen desde el vacío exterior hacia el centro
      masterTl.to(gpSlices, {
        opacity: 1,
        duration: 1.1,
        stagger: 0.08,
        ease: "power2.in",
      }, "gpExcavate")
        .to(gpSlices, {
          xPercent: 0,
          scale: 1,
          duration: 2.1,
          stagger: 0.08,
          ease: "power4.out",
        }, "gpExcavate");

      // 7. Colisión e impacto monolítico en el centro (Camera Shake 2.5px)
      masterTl.to(gpShakeBox, {
        x: -2.5,
        y: 1.5,
        duration: 0.045,
        repeat: 7,
        yoyo: true,
        ease: "none",
      }, "gpImpact")
        .set(gpShakeBox, { x: 0, y: 0 }, "gpImpact+=0.35");

      // 8. Escáner Georradar (GPR Scanline) barre verticalmente la palabra
      masterTl.to(gpScan, {
        opacity: 0.9,
        duration: 0.2,
        ease: "power1.in",
      }, "gpGpr")
        .to(gpScan, {
          yPercent: 140,
          duration: 1.3,
          ease: "power2.inOut",
        }, "gpGpr")
        .to(gpScan, {
          opacity: 0,
          duration: 0.3,
          ease: "power1.out",
        }, "gpGpr+=1.1");

      // 9. Subtítulo emerge de la base con máscara
      masterTl.to(gpSub, {
        yPercent: 0,
        opacity: 1,
        duration: 1.6,
        ease: "power3.out",
      }, "gpGpr+=0.3");

      // 10. Contemplación final de Gunung Padang
      masterTl.to({}, { duration: 3.5 });

      // ─────────────────────────────────────────────────────────────
      // FASE 4: DISOLUCIÓN DE VUELTA AL INICIO DEL LOOP
      // ─────────────────────────────────────────────────────────────
      masterTl.to(layerGp, {
        opacity: 0,
        duration: 1.4,
        ease: "power2.inOut",
      });
    };

    spawnSpores();
    buildTimeline();
  };

  document.addEventListener("astro:page-load", initUnifiedAsiaTimeline);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initUnifiedAsiaTimeline);
  } else {
    initUnifiedAsiaTimeline();
  }
</script>
