---
/**
 * src/components/AsiaSecretsNarrative.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * COLECCIÓN DESTACADA: 'ASIA SECRETS'
 *
 * 1. Pre-Hero Title sobre pantalla dark (estilo apertura Derinkuyu):
 *    - ASIA (H1 destacado monumental con Fraunces)
 *    - Secrets (H2 pequeño al lado, tono Núcleo Ferroso #a95a3f)
 * 2. Revelación inmersiva de Gunung Padang con brillo natural preservado.
 * 3. Excavación Estratigráfica GSAP: 5 estratos con Clash Grotesk Bold,
 *    impacto tectónico, escáner GPR y emersión del subtítulo.
 */
import StratigraphicTitle from "./StratigraphicTitle.astro";
import imgGunung from "../assets/alternativa/gunung-padang.jpg";

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://api.fontshare.com" />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,900,0,1&display=swap"
/>
<link
  rel="stylesheet"
  href="https://api.fontshare.com/v2/css?f[]=clash-grotesk@700&display=swap"
/>

<section
  id="asia-secrets"
  class={`relative w-full min-h-screen bg-[#060a08] text-[#e0e3e1] select-none overflow-hidden ${className}`}
  aria-label="Colección Destacada: Asia Secrets"
>
  <!-- ════════════════════════════════════════════════════════════════════════
       1. PANTALLA PREVIA CINEMÁTICA DARK (PRE-HERO TITLE ESTILO DERINKUYU)
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="asia-prehero relative w-full pt-20 pb-14 px-6 md:px-12 flex flex-col items-center justify-center text-center bg-[#060a08] border-t border-b border-white/5">
    <!-- Aura de niebla verde y magma subterráneo muy sutil -->
    <div class="absolute inset-0 pointer-events-none opacity-40 bg-[radial-gradient(circle_at_50%_40%,rgba(169,90,63,0.12)_0%,rgba(6,10,8,0.85)_65%)]" aria-hidden="true"></div>

    <div class="relative z-10 flex flex-col items-center max-w-5xl mx-auto">
      <!-- Badge de Colección -->
      <span class="asia-badge inline-flex items-center gap-2 mb-4 font-mono text-[9px] sm:text-[10.5px] tracking-[0.35em] uppercase text-[#e0e3e1]/75 py-1 px-4 rounded-full border border-white/10 bg-white/5 backdrop-blur-md">
        <span class="w-1.5 h-1.5 rounded-full bg-[#a95a3f] shadow-[0_0_8px_#a95a3f]"></span>
        Colección Destacada · Archivo Megalítico
      </span>

      <!-- Título: ASIA (H1 gigante Fraunces) + Secrets (H2 pequeño al lado) -->
      <div class="flex flex-wrap items-baseline justify-center gap-x-4 gap-y-1 my-2">
        <h1 class="asia-h1 font-fraunces font-black uppercase text-[clamp(2.8rem,8.5vw,8rem)] leading-[0.88] tracking-[-0.02em] text-[#e0e3e1]">
          ASIA
        </h1>
        <h2 class="asia-h2 font-mono font-bold uppercase text-[clamp(1.1rem,2.8vw,2.4rem)] tracking-[0.32em] text-[#a95a3f]">
          SECRETS
        </h2>
      </div>

      <!-- Subtítulo de bajada telúrica -->
      <p class="asia-dek mt-4 font-mono text-[10px] sm:text-[12px] tracking-[0.28em] uppercase text-[#e0e3e1]/65 max-w-2xl">
        Estratos de basalto · Georradar y la anomalía prediluviana de Java
      </p>

      <!-- Pestaña de navegación / enlace a la colección -->
      <div class="mt-8 flex items-center gap-4">
        <a
          href="/colecciones/asia-secrets/"
          class="inline-flex items-center gap-2 px-6 py-2 rounded-full border border-[#a95a3f]/40 hover:border-[#a95a3f] bg-[#a95a3f]/10 hover:bg-[#a95a3f]/25 text-[#e0e3e1] font-mono text-[10.5px] uppercase tracking-[0.25em] transition-all duration-300"
        >
          <span>Explorar Expediente de Colección</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════════════
       2. ESCENARIO INMERSIVO HERO: GUNUNG PADANG (BRILLO ORIGINAL PRESERVADO)
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="relative w-full h-[90svh] min-h-145 overflow-hidden">
    <!-- Imagen de archivo sin filtros oscurecedores -->
    <div class="absolute inset-0 overflow-hidden">
      <img
        src={imgGunung.src}
        alt="Arqueólogo documentando columnas de basalto en Gunung Padang"
        class="asia-img absolute inset-0 w-full h-full object-cover object-[center_35%] filter brightness-105 contrast-102"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Viñeta sutilísima en bordes para garantizar legibilidad -->
    <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_center,transparent_40%,rgba(6,10,8,0.3)_75%,rgba(6,10,8,0.85)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-linear-to-t from-[#060a08] to-transparent pointer-events-none"></div>

    <!-- Título Estratigráfico Central -->
    <div class="absolute inset-0 flex flex-col items-center justify-center p-4 z-20 pointer-events-none">
      <div class="pointer-events-auto">
        <StratigraphicTitle
          word="GUNUNG PADANG"
          subtitle="La pirámide que fractura el Holoceno"
          fontHref="https://api.fontshare.com/v2/css?f[]=clash-grotesk@700&display=swap"
          fontFamily="'Clash Grotesk', system-ui, -apple-system, sans-serif"
          fontWeight={700}
          textColor="#e0e3e1"
          accentColor="#a95a3f"
          speed={1}
          align="center"
          size="clamp(3.2rem, 10vw, 11rem)"
        />
      </div>
    </div>

    <!-- Botón discreto para reiniciar animación -->
    <div class="absolute bottom-5 right-5 z-30">
      <button
        type="button"
        class="asia-replay-btn inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-[#060a08]/80 hover:bg-[#a95a3f] text-[#e0e3e1] hover:text-white border border-white/10 font-mono text-[10px] uppercase tracking-wider backdrop-blur-md transition-all duration-300 cursor-pointer"
        aria-label="Repetir Excavación Estratigráfica"
      >
        <span>↻</span>
        <span>Repetir Estratos</span>
      </button>
    </div>
  </div>
</section>

<style>
  .asia-h1 {
    text-shadow: 0 4px 30px rgba(6, 10, 8, 0.95);
  }

  .asia-img {
    animation: asia-drift 28s ease-in-out infinite alternate;
  }
  @keyframes asia-drift {
    0% { transform: scale(1); }
    100% { transform: scale(1.04); }
  }
</style>

<script>
  const setupAsiaSecrets = () => {
    const replayBtns = document.querySelectorAll(".asia-replay-btn");
    replayBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("strata:replay"));
      });
    });
  };

  document.addEventListener("astro:page-load", setupAsiaSecrets);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupAsiaSecrets);
  } else {
    setupAsiaSecrets();
  }
</script>
