---
// src/components/A24StaggeredGallery.astro
/**
 * A24StaggeredGallery.astro
 * Arquitectura Editorial Sincronizada:
 * 1. Franja Bento Ultra (Superior): Formato ultra-panorámico (max-w-[1520px], no full-bleed) que rota
 *    automáticamente entre las colecciones temáticas reales del sitio con ambient glow, epígrafe poético y CTAs.
 * 2. Array de 3 Posts Coherentes (Inferior): Ubicado DEBAJO de la franja. Las 3 tarjetas tienen tamaño uniforme
 *    amplio y nivelado (sin recortes ni desniveles), y aparecen secuencialmente "uno después de otro" con stagger.
 * 3. Sanitización Estricta: Se limpian nombres de archivo con hashes, prefijos multimodales y caracteres Markdown crudos.
 * 4. Control de Usuario: Pausa inmediata en hover/touch y reanudación exacta al salir.
 */

import { resolveEssayImage, sanitizeImageUrl, formatCategory } from "../lib/content-filter";

interface Item {
  title?: string;
  titulo?: string;
  subtitle?: string;
  excerpt?: string;
  image?: string | any;
  img?: string | any;
  link?: string;
  href?: string;
  slug?: string;
  collectionLabel?: string;
  category?: string;
  date?: string;
  entry?: any;
}

interface CollectionInput {
  key: string;
  label: string;
  count?: number;
  coverEssay?: any;
  essays?: any[];
}

interface Props {
  title?: string;
  eyebrow?: string;
  items?: Item[];
  collections?: CollectionInput[];
  max?: number;
  actionText?: string;
  actionHref?: string;
}

const {
  title = "Ensayos Recientes & Colecciones",
  eyebrow = "Archivo de Ensayos",
  items = [],
  collections = [],
  max = 12,
  actionText = "Ver Catálogo Completo →",
  actionHref = "/archivo/",
} = Astro.props;

// Limpiador estricto de símbolos Markdown (#, ##, *, -, >)
const cleanMarkdown = (text?: string) => {
  if (!text) return "";
  return text.replace(/^[#*\->\s]+/gm, '').replace(/[*_`]/g, '').trim();
};

// Sanitizador de títulos editoriales para eliminar prefijos de escaneo y hashes
const sanitizeTitle = (rawTitle?: string) => {
  if (!rawTitle) return "Investigación Editorial";
  let t = rawTitle;
  t = t.replace(/^Captura\s+(?:Hermenéutica|Puesto de Mando|Multimodal)\s*[—–·-]\s*/i, "");
  t = t.replace(/^ensayosCinematicos\s*[—–·-]\s*/i, "");
  t = t.replace(/_[a-f0-9]{8,}(?:_[a-f0-9]+)*\.(?:webp|jpg|jpeg|png)$/i, "");
  t = t.replace(/\.(?:webp|jpg|jpeg|png)$/i, "");
  if (/confucio/i.test(t)) {
    return "Confucio y la Armonía Celeste";
  }
  if (/consulta-manual/i.test(t)) {
    return "La Lepra en el Oriente Próximo: ¿Enfermedad Sagrada?";
  }
  t = t.replace(/_+/g, " ").trim();
  return cleanMarkdown(t);
};

// Normalizador unificado de posts
const normalizePost = (item: any, fallbackBadge: string = "ENSAYO") => {
  const rawImg = item.img || item.image || item.entry?.coverImage || resolveEssayImage(item.entry || item, item.slug);
  const image = sanitizeImageUrl(typeof rawImg === 'object' && rawImg?.src ? rawImg.src : (typeof rawImg === 'string' ? rawImg : '')) 
    || 'https://images.unsplash.com/photo-1547036967-23d11aacaee0?q=80&w=1200&auto=format&fit=crop';
  
  const rawTitle = item.title || item.titulo || item.entry?.title || "Investigación Editorial";
  const cleanedTitle = sanitizeTitle(rawTitle);

  const rawExcerpt = item.excerpt || item.entry?.excerpt || item.entry?.dek || item.subtitle || "";
  const cleanedExcerpt = cleanMarkdown(rawExcerpt);

  const href = item.link || item.href || (item.slug ? ((item as any).isCinematicGSAP ? `/ensayos-cinematicos/${item.slug}/` : `/hemeroteca/${item.slug}/`) : '#');
  const badge = item.collectionLabel || formatCategory(item.category || item.entry?.category || fallbackBadge);

  return {
    title: cleanedTitle,
    excerpt: cleanedExcerpt,
    image,
    href,
    badge
  };
};

// Mapa oficial de epígrafes poéticos por colección temática (extraídos de colecciones/index.astro)
const epigraphMap: Record<string, string> = {
  "arqueosemiotica": "Los signos sobreviven a los imperios. Cada glifo, un mensaje lanzado a la eternidad sin destinatario conocido.",
  "filosofia": "El pensamiento como territorio. Las ideas no mueren: se transforman, se heredan, se contradicen.",
  "historia": "El tiempo no es lineal. Es una red de causas que la memoria humana teje y desteje sin cesar.",
  "mitologia": "Antes del dato, existió el mito. El relato que une cielo y tierra antes de que la ciencia los separara.",
  "ensayos-cinematicos": "Imágenes que piensan. El cine como forma de conocimiento antes de que el conocimiento fuera escrito.",
  "arquetipos": "Figuras que reaparecen en cada cultura. Los arquetipos son la gramática secreta del ser humano.",
};

// ─── COLECCIONES REALES SANITIZADAS (SOLO LAS EXISTENTES) ────────────────────
const allItemsNormalized = items.map(i => normalizePost(i));

interface ActiveCollection {
  key: string;
  label: string;
  count: number;
  epigraph: string;
  image: string;
  href: string;
  posts: ReturnType<typeof normalizePost>[];
}

const realCollectionsMap: Record<string, { label: string; image: string }> = {
  "arqueosemiotica": {
    label: "Arqueosemiótica",
    image: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=1600&auto=format&fit=crop"
  },
  "filosofia": {
    label: "Filosofía",
    image: "https://images.unsplash.com/photo-1547036967-23d11aacaee0?q=80&w=1600&auto=format&fit=crop"
  },
  "historia": {
    label: "Historia",
    image: "https://images.unsplash.com/photo-1507842229451-7f01be8610ce?q=80&w=1600&auto=format&fit=crop"
  },
  "mitologia": {
    label: "Mitología",
    image: "https://images.unsplash.com/photo-1461360370896-922624d12aa1?q=80&w=1600&auto=format&fit=crop"
  },
  "ensayos-cinematicos": {
    label: "Ensayos Cinemáticos",
    image: "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=1600&auto=format&fit=crop"
  }
};

// Extraer o estructurar solo las colecciones que existen en el catálogo
const activeCollections: ActiveCollection[] = Object.entries(realCollectionsMap).map(([key, info]) => {
  // Buscar si la colección vino en las props
  const propCol = collections.find(c => c.key === key || c.label.toLowerCase() === info.label.toLowerCase());
  
  let colPosts: ReturnType<typeof normalizePost>[] = [];
  if (propCol && Array.isArray(propCol.essays) && propCol.essays.length > 0) {
    colPosts = propCol.essays.slice(0, 3).map(e => normalizePost(e, info.label));
  } else {
    // Filtrar de items generales por coincidencia temática
    colPosts = allItemsNormalized.filter(p => {
      const match = (p.badge + ' ' + p.title + ' ' + p.excerpt).toLowerCase();
      if (key === "arqueosemiotica") return /arqueo|semiot|gunung|diquis|aramu|litic|megalit|piramide/i.test(match);
      if (key === "filosofia") return /filosof|buda|nichiren|confucio|krishnamurti|sadhguru|oriente|deseo/i.test(match);
      if (key === "historia") return /histor|umbral|borges|catedral|escolastica|archivo|tacito|romano/i.test(match);
      if (key === "mitologia") return /mito|argonauta|demeter|dios|sagrad|kheper/i.test(match);
      if (key === "ensayos-cinematicos") return /cinematic|caligula|dahshur|alejandro|sombra/i.test(match);
      return false;
    }).slice(0, 3);
  }

  // Si tiene menos de 3, completar con posts seguros para mantener siempre la tríada
  if (colPosts.length < 3) {
    const needed = 3 - colPosts.length;
    const fillers = allItemsNormalized.filter(f => !colPosts.some(p => p.title === f.title)).slice(0, needed);
    colPosts = [...colPosts, ...fillers];
  }

  const rawCover = propCol?.coverEssay?.img || propCol?.coverEssay?.image;
  const coverUrl = sanitizeImageUrl(typeof rawCover === 'object' && rawCover?.src ? rawCover.src : (typeof rawCover === 'string' ? rawCover : '')) || info.image;

  return {
    key,
    label: info.label,
    count: propCol?.count || colPosts.length || 4,
    epigraph: epigraphMap[key] || "Corpus documental y memoria material en el acervo de la hemeroteca.",
    image: coverUrl,
    href: `/colecciones/${key}/`,
    posts: colPosts
  };
});
---

<section id="sec-ensayos-recientes" class="a24-root w-full relative">
  
  <!-- ── CABECERA EDITORIAL ── -->
  <header class="flex items-end justify-between gap-4 pb-6 border-b border-white/10 mb-8 md:mb-10 w-full max-w-[94vw] xl:max-w-380 2xl:max-w-390 mx-auto">
    <div>
      {eyebrow && (
        <span class="block text-[10px] font-mono tracking-[0.4em] uppercase text-amber-500 font-bold mb-1.5">
          {eyebrow}
        </span>
      )}
      <h2 class="font-cinzel text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-transparent bg-clip-text bg-linear-to-b from-slate-100 to-slate-400 m-0 leading-tight">
        {title}
      </h2>
    </div>

    <div class="flex items-center gap-4">
      <!-- Indicador dinámico de colección activa -->
      <div class="hidden sm:flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/60 border border-white/10 backdrop-blur-md">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="text-xs font-mono text-zinc-300 tracking-wider">
          COLECCIÓN <span class="a24-cur-idx text-white font-bold">01</span> / {String(activeCollections.length).padStart(2, "0")}
        </span>
      </div>

      {actionHref && actionText && (
        <a 
          href={actionHref}
          class="group hidden sm:inline-flex items-center gap-2 text-xs font-mono tracking-widest text-zinc-400 hover:text-amber-400 transition-colors uppercase"
        >
          <span>{actionText}</span>
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      )}
    </div>
  </header>

  <!-- ── 1. FRANJA BENTO ULTRA (SUPERIOR, PANORÁMICA, NO FULL BLEED) ── -->
  <div class="w-full max-w-[94vw] xl:max-w-380 2xl:max-w-390 mx-auto mb-10 md:mb-14">
    <div 
      class="a24-bento-stage relative w-full h-85 sm:h-95 md:h-105 rounded-[28px] overflow-hidden bg-black border border-white/10 shadow-[0_24px_70px_rgba(0,0,0,0.92)] select-none group/bento"
      data-total-collections={activeCollections.length}
    >
      
      {/* Flechas de Navegación Manual Flotantes */}
      <button 
        type="button" 
        class="a24-bento-prev absolute left-3 md:left-5 top-1/2 -translate-y-1/2 z-40 w-11 h-11 rounded-full bg-black/60 hover:bg-black/90 text-white border border-white/20 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-0 group-hover/bento:opacity-100 hover:scale-110 active:scale-95 cursor-pointer shadow-xl pointer-events-auto"
        aria-label="Colección anterior"
      >
        <svg class="w-5 h-5 -translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      </button>

      <button 
        type="button" 
        class="a24-bento-next absolute right-3 md:right-5 top-1/2 -translate-y-1/2 z-40 w-11 h-11 rounded-full bg-black/60 hover:bg-black/90 text-white border border-white/20 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-0 group-hover/bento:opacity-100 hover:scale-110 active:scale-95 cursor-pointer shadow-xl pointer-events-auto"
        aria-label="Colección siguiente"
      >
        <svg class="w-5 h-5 translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </button>

      {/* Diapositivas de la Franja Bento Ultra */}
      <div class="relative w-full h-full">
        {activeCollections.map((col, cIdx) => (
          <div 
            class={`a24-bento-slide absolute inset-0 w-full h-full ${cIdx === 0 ? 'opacity-100 z-10 pointer-events-auto' : 'opacity-0 z-0 pointer-events-none'}`}
            data-collection-index={cIdx}
          >
            <!-- Imagen Panorámica Derecha de la Colección -->
            <div class="absolute right-0 top-0 w-[72%] sm:w-[68%] md:w-[64%] h-full overflow-hidden">
              <img 
                src={col.image} 
                alt={col.label}
                class="w-full h-full object-cover object-center transform scale-100 transition-transform duration-1000 ease-out pointer-events-none"
                loading="eager" 
                decoding="async" 
              />
            </div>

            <!-- Máscara de Fusión Apple TV + Ambient Glow Cobrizo -->
            <div class="pointer-events-none absolute inset-0 z-10 bg-[linear-gradient(90deg,#000000_0%,#000000_36%,rgba(0,0,0,0.85)_50%,rgba(0,0,0,0)_72%)]"></div>
            <div class="pointer-events-none absolute inset-0 z-10 bg-[radial-gradient(circle_at_0%_0%,rgba(190,90,55,0.42)_0%,transparent_50%)]"></div>

            <!-- Bloque Editorial Izquierdo -->
            <div class="absolute inset-y-0 left-0 z-20 w-full md:w-[54%] lg:w-[48%] pl-6 sm:pl-10 md:pl-14 pr-6 flex flex-col justify-center">
              
              <div class="flex items-center gap-2 mb-2.5">
                <span class="text-xs uppercase tracking-[0.25em] text-amber-500 font-bold block font-mono">
                  COLECCIÓN TEMÁTICA // {col.count} INVESTIGACIONES
                </span>
              </div>

              <h3 class="text-3xl sm:text-4xl md:text-5xl font-black font-cinzel text-white leading-[1.08] tracking-tight mb-3 uppercase">
                {col.label}
              </h3>

              <p class="text-xs sm:text-sm text-zinc-300/90 mb-6 leading-relaxed line-clamp-3 font-sans max-w-lg">
                {col.epigraph}
              </p>

              <!-- Botones CTA 100% Funcionales -->
              <div class="flex items-center gap-3 flex-wrap pointer-events-auto">
                <a 
                  href={col.href}
                  class="px-6 py-2.5 rounded-full bg-white hover:bg-zinc-200 text-zinc-950 text-xs font-semibold tracking-wide transition shadow-lg hover:scale-[1.02] active:scale-[0.98] pointer-events-auto cursor-pointer"
                >
                  Explorar {col.label}
                </a>
                <a 
                  href="/archivo/"
                  class="px-5 py-2.5 rounded-full bg-white/5 hover:bg-white/10 border border-white/20 text-[#E3DDD3] text-xs font-medium backdrop-blur-md transition hover:scale-[1.02] active:scale-[0.98] pointer-events-auto cursor-pointer"
                >
                  Ver Catálogo General
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

      <!-- Indicadores de Puntos Centrales Inferiores -->
      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2 px-4 py-2 rounded-full bg-black/60 backdrop-blur-md border border-white/10 pointer-events-auto">
        {activeCollections.map((_, dotIdx) => (
          <button 
            type="button" 
            class={`a24-bento-dot transition-all duration-300 rounded-full cursor-pointer ${dotIdx === 0 ? 'w-5 h-2 bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.8)]' : 'w-2 h-2 bg-white/30 hover:bg-white/60'}`}
            data-bento-dot={dotIdx}
            aria-label={`Ir a colección ${dotIdx + 1}`}
          ></button>
        ))}
      </div>

    </div>
  </div>

  <!-- ── 2. ARRAY DE 3 POSTS (DEBAJO DE LA FRANJA, TAMAÑO UNIFORME, AMPLIO Y VISIBLE) ── -->
  <div class="w-full max-w-[94vw] xl:max-w-380 2xl:max-w-390 mx-auto">
    
    <!-- Subtítulo / Encabezado dinámico de los 3 posts -->
    <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-6">
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span class="text-xs font-mono uppercase tracking-[0.25em] text-zinc-300 font-bold">
          INVESTIGACIONES EN <span class="a24-posts-col-name text-amber-300">{activeCollections[0].label.toUpperCase()}</span>
        </span>
      </div>
      <a 
        href={activeCollections[0].href} 
        class="a24-posts-col-link text-[11px] font-mono uppercase tracking-widest text-amber-400 hover:text-amber-300 transition pointer-events-auto cursor-pointer"
      >
        Ver Colección Completa →
      </a>
    </div>

    <!-- Contenedor del Stage de Posts (Sincronizado con la franja superior) -->
    <div class="a24-posts-stage relative w-full">
      {activeCollections.map((col, cIdx) => (
        <div 
          class={`a24-posts-group ${cIdx === 0 ? 'active opacity-100 relative pointer-events-auto z-10' : 'opacity-0 absolute inset-0 pointer-events-none z-0'}`}
          data-group-index={cIdx}
        >
          <!-- Grilla de 3 Posts con TAMAÑO UNIFORME AMPLIO Y VISIBLE -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch w-full">
            {col.posts.map((post, pIdx) => (
              <a 
                href={post.href}
                class="a24-post-card group/card relative flex flex-col w-full text-white no-underline transition-all duration-300 pointer-events-auto cursor-pointer"
                data-card-idx={pIdx}
              >
                <!-- Tarjeta Nivelada y Amplia (Altura homogénea h-120 a h-150 sin desniveles) -->
                <div class="relative w-full h-120 sm:h-135 md:h-145 rounded-2xl overflow-hidden bg-neutral-900 border border-white/10 shadow-2xl transition-all duration-500 group-hover/card:border-amber-500/40 group-hover/card:shadow-[0_24px_50px_rgba(0,0,0,0.85)] group-hover/card:-translate-y-1.5">
                  
                  <!-- Capa de Bokeh de fondo -->
                  <img 
                    src={post.image} 
                    alt="" 
                    aria-hidden="true"
                    class="absolute inset-0 w-full h-full object-cover scale-150 blur-3xl brightness-75 saturate-150 pointer-events-none"
                  />

                  <!-- Imagen principal -->
                  <img 
                    src={post.image} 
                    alt={post.title} 
                    loading="lazy" 
                    decoding="async" 
                    class="relative z-10 w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover/card:scale-105 pointer-events-none"
                  />

                  <!-- Scrim degradado inferior -->
                  <div class="absolute inset-0 z-15 bg-linear-to-t from-black/95 via-black/45 to-transparent pointer-events-none"></div>

                  <!-- Badge Superior Flotante -->
                  <div class="absolute top-3.5 left-3.5 z-20 flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/75 backdrop-blur-md border border-white/15 pointer-events-none">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    <span class="text-[10px] md:text-[11px] font-mono tracking-wider text-zinc-300 uppercase">
                      {post.badge}
                    </span>
                  </div>

                  <!-- Bloque Editorial al Pie -->
                  <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6 lg:p-7 z-20 flex flex-col gap-1.5 pointer-events-none">
                    <h3 class="font-cinzel text-xl sm:text-2xl font-bold uppercase tracking-tight text-white drop-shadow leading-snug transition-colors duration-300 group-hover/card:text-amber-200 line-clamp-2">
                      {post.title}
                    </h3>

                    {post.excerpt && (
                      <p class="font-sans text-xs sm:text-sm text-zinc-300/85 line-clamp-2 leading-relaxed font-normal mt-0.5">
                        {post.excerpt}
                      </p>
                    )}
                  </div>

                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>

  <!-- Botón móvil ver catálogo -->
  {actionHref && actionText && (
    <div class="sm:hidden text-center mt-8">
      <a 
        href={actionHref}
        class="inline-flex items-center gap-2 text-xs font-mono tracking-widest text-amber-400 uppercase py-3 px-6 rounded-full bg-white/5 border border-white/10"
      >
        <span>{actionText}</span>
        <span>→</span>
      </a>
    </div>
  )}

</section>

<script>
import gsap from "gsap";

function initA24SyncedStage() {
  const root = document.querySelector<HTMLElement>(".a24-root");
  if (!root || root.dataset.syncedInit === "1") return;
  root.dataset.syncedInit = "1";

  const bentoSlides = root.querySelectorAll<HTMLElement>(".a24-bento-slide");
  const bentoDots = root.querySelectorAll<HTMLButtonElement>(".a24-bento-dot");
  const postGroups = root.querySelectorAll<HTMLElement>(".a24-posts-group");
  const curIdxSpan = root.querySelector<HTMLElement>(".a24-cur-idx");
  const colNameSpan = root.querySelector<HTMLElement>(".a24-posts-col-name");
  const colLinkAnchor = root.querySelector<HTMLAnchorElement>(".a24-posts-col-link");
  const prevBtn = root.querySelector<HTMLButtonElement>(".a24-bento-prev");
  const nextBtn = root.querySelector<HTMLButtonElement>(".a24-bento-next");

  const total = bentoSlides.length;
  if (total <= 1) return;

  let currentIndex = 0;
  let isTransitioning = false;
  let loopTimer: gsap.core.Tween | null = null;
  let isHovered = false;

  function updateIndicators(activeIdx: number) {
    bentoDots.forEach((dot, idx) => {
      if (idx === activeIdx) {
        dot.className = "a24-bento-dot transition-all duration-300 rounded-full cursor-pointer w-5 h-2 bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.8)]";
      } else {
        dot.className = "a24-bento-dot transition-all duration-300 rounded-full cursor-pointer w-2 h-2 bg-white/30 hover:bg-white/60";
      }
    });

    if (curIdxSpan) {
      curIdxSpan.textContent = String(activeIdx + 1).padStart(2, "0");
    }

    // Actualizar nombre y link de la colección en el encabezado de los posts
    const activeBentoTitle = bentoSlides[activeIdx]?.querySelector("h3")?.textContent?.trim();
    const activeBentoLink = bentoSlides[activeIdx]?.querySelector<HTMLAnchorElement>("a")?.getAttribute("href");
    if (colNameSpan && activeBentoTitle) {
      colNameSpan.textContent = activeBentoTitle;
    }
    if (colLinkAnchor && activeBentoLink) {
      colLinkAnchor.setAttribute("href", activeBentoLink);
    }
  }

  function goToSlide(nextIndex: number) {
    if (nextIndex === currentIndex || isTransitioning) return;
    isTransitioning = true;

    // 1. Elementos Bento superiores
    const currentBento = bentoSlides[currentIndex];
    const nextBento = bentoSlides[nextIndex];

    // 2. Elementos de Posts inferiores
    const currentGroup = postGroups[currentIndex];
    const nextGroup = postGroups[nextIndex];
    const nextCards = nextGroup?.querySelectorAll<HTMLElement>(".a24-post-card");

    const tl = gsap.timeline({
      defaults: { ease: "expo.out" },
      onComplete: () => {
        currentIndex = nextIndex;
        isTransitioning = false;
      }
    });

    // ─── A. TRANSICIÓN DE LA FRANJA BENTO SUPERIOR ───
    if (currentBento) {
      tl.to(currentBento, {
        opacity: 0,
        x: -25,
        scale: 0.98,
        duration: 0.32,
        ease: "power2.in",
        onComplete: () => {
          gsap.set(currentBento, { pointerEvents: "none", zIndex: 0 });
        }
      }, 0);
    }

    if (nextBento) {
      gsap.set(nextBento, { zIndex: 10, pointerEvents: "auto" });
      tl.fromTo(nextBento,
        { opacity: 0, scale: 1.03, x: 30 },
        { opacity: 1, scale: 1, x: 0, duration: 0.55 },
        0.1
      );
    }

    // ─── B. TRANSICIÓN DEL ARRAY DE 3 POSTS INFERIOR (UNO DESPUÉS DE OTRO) ───
    if (currentGroup) {
      tl.to(currentGroup, {
        opacity: 0,
        y: -10,
        duration: 0.25,
        ease: "power2.in",
        onComplete: () => {
          currentGroup.classList.remove("active", "relative");
          currentGroup.classList.add("absolute", "pointer-events-none");
          gsap.set(currentGroup, { zIndex: 0 });
        }
      }, 0);
    }

    if (nextGroup && nextCards) {
      nextGroup.classList.remove("absolute", "pointer-events-none");
      nextGroup.classList.add("active", "relative", "pointer-events-auto");
      gsap.set(nextGroup, { zIndex: 10, opacity: 1 });

      // Stagger secuencial para que las 3 tarjetas aparezcan "una después de otra"
      gsap.set(nextCards, { opacity: 0, y: 24, scale: 1.02 });
      tl.to(nextCards, {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.52,
        stagger: 0.08,
        ease: "expo.out"
      }, 0.15);
    }

    updateIndicators(nextIndex);
  }

  // Programación continua con gsap.delayedCall (pausa y reanudación exacta)
  function scheduleNext() {
    if (loopTimer) loopTimer.kill();
    loopTimer = gsap.delayedCall(5.5, () => {
      if (!isHovered) {
        const next = (currentIndex + 1) % total;
        goToSlide(next);
        scheduleNext();
      }
    });
  }

  function pauseLoop() {
    isHovered = true;
    if (loopTimer) loopTimer.pause();
  }

  function resumeLoop() {
    isHovered = false;
    if (loopTimer) {
      loopTimer.resume();
    } else {
      scheduleNext();
    }
  }

  // Interacción manual por puntos
  bentoDots.forEach((dot, idx) => {
    dot.addEventListener("click", (e) => {
      e.stopPropagation();
      goToSlide(idx);
      scheduleNext();
    });
  });

  // Flechas Anterior / Siguiente
  if (prevBtn) {
    prevBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const prev = (currentIndex - 1 + total) % total;
      goToSlide(prev);
      scheduleNext();
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const next = (currentIndex + 1) % total;
      goToSlide(next);
      scheduleNext();
    });
  }

  // Pausa por hover o touch en cualquier parte del componente (franja o tarjetas)
  root.addEventListener("mouseenter", pauseLoop);
  root.addEventListener("mouseleave", resumeLoop);
  root.addEventListener("touchstart", pauseLoop, { passive: true });
  root.addEventListener("touchend", resumeLoop, { passive: true });

  // Control de visibilidad de pestaña
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) pauseLoop();
    else resumeLoop();
  });

  scheduleNext();
}

document.addEventListener("astro:page-load", initA24SyncedStage);
if (document.readyState !== "loading") initA24SyncedStage();
else document.addEventListener("DOMContentLoaded", initA24SyncedStage);
</script>
