---
// src/components/CinematicGrid.astro
// Vertical Cinematic Grid — Pinned Scroll con GSAP ScrollTrigger
// Estética: Dark UI "Obsidian Void" heredada del sistema TGP

interface CinematicItem {
  title: string;
  excerpt: string;
  img: string;
  link: string;
}

interface Props {
  items?: CinematicItem[];
  title?: string;
  eyebrow?: string;
}

const { items, title = "Ensayos Cinemáticos", eyebrow = "Colección Exclusiva" } = Astro.props;

// Dummy data de fallback (9 items = 3 filas de 3)
const defaultItems: CinematicItem[] = Array.from({ length: 9 }).map((_, i) => ({
  title: `Ensayo Cinemático ${i + 1}`,
  excerpt: `Explorando las profundidades del plano secuencia y la semiótica visual en la obra ${i + 1}.`,
  img: `https://picsum.photos/seed/cine${i + 10}/800/600`,
  link: "#",
}));

const displayItems = items && items.length > 0 ? items : defaultItems;

// Agrupar en filas de 3 (rellenando con items vacíos si la última fila queda incompleta)
const rows: CinematicItem[][] = [];
for (let i = 0; i < displayItems.length; i += 3) {
  rows.push(displayItems.slice(i, i + 3));
}

const totalRows = rows.length;
const paddedTotal = totalRows < 10 ? `0${totalRows}` : `${totalRows}`;
---

<!-- 
  IMPORTANTE: Esta sección debe estar fuera del flujo del grid de la página.
  El section ocupa `h-screen` + el pin de GSAP crea el espacio de scroll extra.
  El overflow:hidden en el section es CRÍTICO para que el track vertical no se vea fuera.
-->
<section
  id="cg-section"
  class="cg-section relative w-full bg-[#080808] text-white"
  style={`height: 100svh;`}
>

  <!-- ── Header Flotante Sticky ─────────────────────────────────── -->
  <div class="absolute top-0 left-0 w-full z-20 px-8 pt-8 pb-4 flex justify-between items-start pointer-events-none bg-linear-to-b from-black/80 to-transparent">
    <div>
      <!-- Eyebrow — igual que en todos los bloques del index -->
      <span class="font-metadata text-[10px] uppercase tracking-[0.4em] text-[#EFEBE3]/60 block mb-2">
        {eyebrow}
      </span>
      <!-- H2 con gradiente Cinzel heredado del sistema (from-white via-[#8E8E93] to-[#1C1C1E]) -->
      <h2 class="text-3xl md:text-5xl font-cinzel font-extrabold tracking-tight bg-linear-to-b from-[#FFFFFF] via-[#8E8E93] to-[#1C1C1E] bg-clip-text text-transparent drop-shadow-md">
        {title}
      </h2>
    </div>

    <!-- Contador de Filas (actualizado via JS) -->
    <div
      id="cg-progress"
      class="font-mono text-[11px] tracking-[0.15em] text-white/30 tabular-nums self-center"
      aria-live="polite"
    >
      01&thinsp;/&thinsp;{paddedTotal}
    </div>
  </div>

  <!-- ── Overflow Clip: limita el track a h-screen ──────────────── -->
  <div class="absolute inset-0 overflow-hidden">

    <!-- ── Track: stack vertical de filas ────────────────────────── -->
    <div id="cg-track" class="flex flex-col w-full" style={`height: ${totalRows * 100}svh;`}>

      {rows.map((row, rowIndex) => (
        <div
          class="cg-row shrink-0 w-full grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 p-6 md:p-8 items-center"
          style="height: 100svh;"
          data-row-index={rowIndex}
        >
          {row.map((item) => (
            <a
              href={item.link}
              class="group cg-card relative flex flex-col bg-zinc-900 border border-zinc-800/80 rounded-xl overflow-hidden transition-all duration-500 ease-out hover:border-white/20 hover:shadow-[0_8px_40px_-8px_rgba(0,0,0,0.8)] h-[36vh] md:h-[72vh]"
            >
              <!-- Imagen de fondo -->
              <div class="absolute inset-0 overflow-hidden">
                <img
                  src={item.img}
                  alt={item.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover opacity-90 transition-all duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:opacity-100 group-hover:scale-[1.025]"
                />
              </div>

              <!-- Scrim inferior (Solo cubre el texto para contraste WCAG, resto 0% oscuro) -->
              <div class="absolute inset-x-0 bottom-0 h-[65%] bg-linear-to-t from-black/95 via-black/70 to-transparent pointer-events-none"></div>

              <!-- Borde superior sutil (detalle de cristal) -->
              <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-white/10 to-transparent"></div>

              <!-- Contenido textual — base de la tarjeta -->
              <div class="absolute bottom-0 left-0 w-full p-5 md:p-6 flex flex-col justify-end gap-2">
                <!-- Título: Proza Libre, gradiente Acero/TGP en hover -->
                <h3 class="font-proza font-extrabold tracking-tight text-xl md:text-[26px] leading-tight transition-all duration-300 drop-shadow-md line-clamp-2 uppercase opacity-90 group-hover:opacity-100 group-hover:drop-shadow-[0_0_12px_rgba(255,255,255,0.2)]" style="background-image: linear-gradient(180deg, #CBD5E1 0%, #334155 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">
                  {item.title}
                </h3>

                <!-- Excerpt: Newsreader/Gloock, aireado y legible sobre fondo oscuro -->
                <p class="font-proza text-[16px] md:text-[17.5px] leading-relaxed tracking-[0.01em] text-white/50 group-hover:text-white/70 transition-colors line-clamp-3">
                  {item.excerpt}
                </p>

                <!-- CTA discreta -->
                <span class="font-metadata text-xs md:text-sm uppercase tracking-[0.3em] text-white/25 group-hover:text-[#EFEBE3]/60 transition-colors mt-1">
                  Leer ensayo →
                </span>
              </div>
            </a>
          ))}
        </div>
      ))}

    </div><!-- /#cg-track -->
  </div><!-- /overflow-hidden -->

</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let cgCtx: ReturnType<typeof gsap.context> | null = null;

  const initCinematicGrid = () => {
    // Limpiar instancia previa si existe (View Transitions o HMR)
    if (cgCtx) cgCtx.revert();

    const section = document.getElementById("cg-section") as HTMLElement;
    const track   = document.getElementById("cg-track")   as HTMLElement;
    const rows    = section?.querySelectorAll(".cg-row");
    const progress = document.getElementById("cg-progress");

    if (!section || !track || !rows || rows.length <= 1) return;

    const totalRows = rows.length;

    cgCtx = gsap.context(() => {

      // El track mide totalRows * 100svh.
      // Para mover la fila 0→N-1 necesitamos desplazar -(N-1) * 100svh.
      // Con yPercent (relativo al height propio del track que es N*100svh):
      //   -(N-1)*100svh / (N*100svh) * 100  =  -(N-1)/N * 100
      // Pero es más limpio y robusto usar `y` con cálculo en px en onUpdate,
      // o simplemente fijar translateY por filas. Usamos yPercent correcto:
      const yPercentEnd = -100 * (totalRows - 1) / totalRows;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          // ScrollSmoother requiere pinnedContainer para sincronizar el pin
          // con el contenedor suavizado (#smooth-content)
          pinnedContainer: document.getElementById("smooth-content") ?? undefined,
          pin: true,
          scrub: 1,
          snap: {
            snapTo: 1 / (totalRows - 1),
            duration: { min: 0.3, max: 0.6 },
            ease: "power2.inOut",
          },
          start: "top top",
          end: `+=${totalRows * 700}`, // ~700px de scroll por fila para suavidad óptima con ScrollSmoother
          onUpdate: (self) => {
            if (!progress) return;
            const current = Math.round(self.progress * (totalRows - 1)) + 1;
            const padded  = current < 10 ? `0${current}` : `${current}`;
            const padTotal = totalRows < 10 ? `0${totalRows}` : `${totalRows}`;
            progress.innerHTML = `${padded}&thinsp;/&thinsp;${padTotal}`;
          },
        },
      });

      tl.to(track, {
        yPercent: yPercentEnd,
        ease: "none", // CRÍTICO: movimiento lineal para que scrub sea perfecto
      });

    }, section);
  };

  // Limpieza para Astro View Transitions
  document.addEventListener("astro:before-swap", () => {
    if (cgCtx) {
      cgCtx.revert();
      cgCtx = null;
    }
  });

  document.addEventListener("DOMContentLoaded", initCinematicGrid);
  document.addEventListener("astro:page-load", initCinematicGrid);
</script>
