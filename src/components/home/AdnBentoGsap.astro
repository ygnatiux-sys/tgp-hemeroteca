</style>

<section
  id={instanceId}
  class={`cinematic-excerpt-rest relative w-full bg-(--bg-main) overflow-hidden select-none py-16 sm:py-24 md:py-32 flex flex-col justify-center items-center ${className}`}
  style="background-color: var(--bg-main, #121413);"
  data-adn-excerpt-root
>
  <!-- Lienzo de partículas de polvo dorado en suspensión -->
  <canvas class="excerpt-dust-canvas absolute inset-0 z-0 pointer-events-none" id={`${instanceId}-canvas`}></canvas>

  <!-- Contenedor central amplio para tipografía monumental -->
  <div class="excerpt-content relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 md:px-8 text-center">
    <div class="adn-stage-container">
      {parsedBatches.map((batch, idx) => (
        <div
          class="adn-slide-item"
          data-slide-index={idx}
          style="opacity: 1; visibility: visible;"
        >
          {idx === 2 ? (
            <div class="conecta-fx-group absolute inset-0 flex items-center justify-center select-none pointer-events-auto">
              <div class="conecta-cnc-wrap relative inline-block">
                <span class="conecta-ghost block text-[clamp(4.5rem,16.5vw,15rem)] leading-[0.92] tracking-[-0.03em] font-['Gloock',serif] font-black text-white/5 select-none" aria-hidden="true">
                  {batch.leadWord}
                </span>
                <div
                  class="conecta-revealed conecta-3d-text absolute inset-0 flex items-center justify-center text-center text-[clamp(4.5rem,16.5vw,15rem)] leading-[0.92] tracking-[-0.03em]"
                  style="clip-path: polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%);"
                >
                  {batch.leadWord}
                </div>
                <div class="conecta-laser-beam" aria-hidden="true">
                  <span class="conecta-laser-spark"></span>
                </div>
              </div>
            </div>
          ) : (
            <div class="relative w-full h-full flex items-center justify-center select-none pointer-events-auto">
              {idx === 1 && <span class="investiga-shockwave" aria-hidden="true"></span>}
              <div class="adn-lead-purple absolute inset-0 flex items-center justify-center text-center text-[clamp(4.5rem,16.5vw,15rem)]">
                {batch.leadWord}
              </div>
            </div>
          )}

          <!-- Discurso secundario oculto en esta instancia según directiva -->
          <div class="adn-phrase-block hidden" aria-hidden="true">
            <h2 class="excerpt-phrase-text glow-metallic-gloock">
              {batch.wordsData.map((wd) => (
                <span class="excerpt-word-wrapper">
                  <span
                    class:list={[
                      "excerpt-word",
                      wd.type === "glow" ? "word-glow" : "",
                      wd.type === "accent" ? "word-accent" : "word-normal",
                    ]}
                  >
                    {wd.word}
                  </span>
                  <span class="excerpt-space" aria-hidden="true">&nbsp;</span>
                </span>
              ))}
            </h2>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Script de Polvo Dorado y GSAP Timeline Suave -->
<script>
  import { gsap } from "gsap";

  // ─── CANVAS DE POLVO DORADO IDÉNTICO A CINEMATICEXCERPTREST ───────────────
  class DustMotesEffect {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private motes: Array<{
      x: number;
      y: number;
      radius: number;
      opacity: number;
      speedX: number;
      speedY: number;
      angle: number;
      angleSpeed: number;
      osc: number;
      flickPhase: number;
      flickSpeed: number;
    }> = [];
    private animationFrameId: number | null = null;
    private isRunning: boolean = false;
    private boundResize: () => void;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext("2d")!;
      this.boundResize = this.resize.bind(this);
      this.resize();
      window.addEventListener("resize", this.boundResize);
    }

    public resize() {
      const parent = this.canvas.parentElement;
      const rect = parent ? parent.getBoundingClientRect() : null;
      this.canvas.width = rect && rect.width > 0 ? rect.width : window.innerWidth;
      this.canvas.height = rect && rect.height > 0 ? rect.height : (window.innerHeight * 0.85);
    }

    private spawnMote(fromLeft = false) {
      const w = this.canvas.width;
      const h = this.canvas.height;
      return {
        x: fromLeft ? -10 : Math.random() * w,
        y: Math.random() * h,
        radius: 0.8 + Math.random() * 2.4,
        opacity: 0.12 + Math.random() * 0.50,
        speedX: 0.20 + Math.random() * 0.55,
        speedY: (Math.random() - 0.5) * 0.13,
        angle: Math.random() * Math.PI * 2,
        angleSpeed: 0.004 + Math.random() * 0.015,
        osc: 0.06 + Math.random() * 0.11,
        flickPhase: Math.random() * Math.PI * 2,
        flickSpeed: 0.010 + Math.random() * 0.028,
      };
    }

    public start() {
      if (this.isRunning) return;
      this.isRunning = true;
      this.motes = Array.from({ length: 55 }, () => this.spawnMote(false));
      this.loop();
    }

    public stop() {
      this.isRunning = false;
      if (this.animationFrameId) {
        cancelAnimationFrame(this.animationFrameId);
        this.animationFrameId = null;
      }
    }

    public destroy() {
      this.stop();
      window.removeEventListener("resize", this.boundResize);
    }

    private loop() {
      if (!this.isRunning) return;
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

      this.motes.forEach(m => {
        m.x += m.speedX;
        m.y += m.speedY + Math.sin(m.angle) * m.osc;
        m.angle += m.angleSpeed;
        m.flickPhase += m.flickSpeed;

        if (m.x > this.canvas.width + 14) {
          Object.assign(m, this.spawnMote(true));
        }

        const flick = 1 + 0.16 * Math.sin(m.flickPhase);
        const finalOp = Math.min(1, m.opacity * flick);
        const grad = this.ctx.createRadialGradient(m.x, m.y, 0, m.x, m.y, m.radius * 2.6);
        grad.addColorStop(0, `rgba(201, 168, 108, ${finalOp})`);
        grad.addColorStop(0.4, `rgba(223, 202, 157, ${(finalOp * 0.6).toFixed(3)})`);
        grad.addColorStop(1, 'rgba(201, 168, 108, 0)');

        this.ctx.beginPath();
        this.ctx.fillStyle = grad;
        this.ctx.arc(m.x, m.y, m.radius * 2.6, 0, Math.PI * 2);
        this.ctx.fill();
      });

      this.animationFrameId = requestAnimationFrame(this.loop.bind(this));
    }
  }

  // ─── CONTROLADOR GSAP SECUENCIAL CON TRANSICIÓN SUAVE ──────────────────────
  function initAdnExcerptInstances() {
    const roots = document.querySelectorAll<HTMLElement>("[data-adn-excerpt-root]");
    if (roots.length === 0) return;

    roots.forEach((root) => {
      if (root.dataset.adnInit === "true") return;
      root.dataset.adnInit = "true";

      const canvas = root.querySelector<HTMLCanvasElement>(".excerpt-dust-canvas");
      let dustEffect: DustMotesEffect | null = null;
      if (canvas) {
        dustEffect = new DustMotesEffect(canvas);
      }

      const slides = gsap.utils.toArray<HTMLElement>(root.querySelectorAll<HTMLElement>(".adn-slide-item"));
      const count = slides.length;

      if (count < 2) {
        dustEffect?.start();
        return;
      }

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion) {
        dustEffect?.start();
        return;
      }

      const ctx = gsap.context(() => {
        const dudaEl = slides[0]?.querySelector<HTMLElement>(".adn-lead-purple");
        const investigaEl = slides[1]?.querySelector<HTMLElement>(".adn-lead-purple");
        const shockwave = slides[1]?.querySelector<HTMLElement>(".investiga-shockwave");
        const conectaWrap = slides[2]?.querySelector<HTMLElement>(".conecta-cnc-wrap");
        const conectaRevealed = slides[2]?.querySelector<HTMLElement>(".conecta-revealed");
        const conectaLaser = slides[2]?.querySelector<HTMLElement>(".conecta-laser-beam");
        const stageBox = root.querySelector<HTMLElement>(".adn-stage-container");

        const resetAll = () => {
          slides.forEach((s) => gsap.set(s, { autoAlpha: 1 }));
          if (dudaEl) gsap.set(dudaEl, { autoAlpha: 0, scale: 1.06, scaleX: 1, filter: "blur(10px)", y: 8 });
          if (investigaEl) gsap.set(investigaEl, { autoAlpha: 0, y: -260, scale: 1.35, filter: "blur(3px)" });
          if (shockwave) gsap.set(shockwave, { opacity: 0, scale: 0.2 });
          if (conectaWrap) gsap.set(conectaWrap, { autoAlpha: 0 });
          if (conectaRevealed) gsap.set(conectaRevealed, { clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)", x: 0, filter: "blur(0px)" });
          if (conectaLaser) gsap.set(conectaLaser, { left: "0%", opacity: 0 });
          if (stageBox) gsap.set(stageBox, { x: 0, y: 0, rotation: 0 });
        };

        resetAll();

        const tl = gsap.timeline({ repeat: -1, paused: true });

        // ── 1. DUDA. → entrada monumental + RÁPIDO FADE OUT CON DESINTEGRACIÓN ──
        if (dudaEl) {
          tl.to(dudaEl, { autoAlpha: 1, scale: 1, filter: "blur(0px)", y: 0, duration: 0.42, ease: "power2.out" })
            .to({}, { duration: 0.85 })
            .to(dudaEl, { autoAlpha: 0, scaleX: 1.24, scaleY: 0.92, filter: "blur(18px)", duration: 0.18, ease: "power3.in" })
            .set(dudaEl, { scale: 1.06, scaleX: 1, scaleY: 1, filter: "blur(10px)", y: 8 });
        }

        tl.to({}, { duration: 0.14 });

        // ── 2. INVESTIGA. → CAE COMO GRANITO CATASTRÓFICO + ONDA EXPANSIVA + TEMBLOR ──
        if (investigaEl) {
          tl.set(investigaEl, { autoAlpha: 1, y: -260, scale: 1.35, filter: "blur(3px)" })
            .to(investigaEl, { y: 0, scale: 1, filter: "blur(0px)", duration: 0.34, ease: "power4.in" }, "graniteDrop");

          if (shockwave) {
            tl.set(shockwave, { opacity: 0.95, scale: 0.25 }, "graniteHit")
              .to(shockwave, { opacity: 0, scale: 4.2, duration: 0.65, ease: "expo.out" }, "graniteHit");
          }

          if (stageBox) {
            tl.to(stageBox, { y: 14, x: -6, rotation: -0.7, duration: 0.04, ease: "power4.out" }, "graniteHit")
              .to(stageBox, { y: -9, x: 5, rotation: 0.6, duration: 0.05, ease: "power2.inOut" })
              .to(stageBox, { y: 6, x: -3, rotation: -0.3, duration: 0.05, ease: "power2.inOut" })
              .to(stageBox, { y: -3, x: 2, rotation: 0.15, duration: 0.05, ease: "power2.inOut" })
              .to(stageBox, { y: 0, x: 0, rotation: 0, duration: 0.09, ease: "power2.out" });
          }

          tl.to({}, { duration: 1.3 })
            .to(investigaEl, { autoAlpha: 0, y: 20, filter: "blur(6px)", duration: 0.28, ease: "power2.in" })
            .set(investigaEl, { y: -260, scale: 1.35, filter: "blur(3px)" });
        }

        tl.to({}, { duration: 0.18 });

        // ── 3. CONECTA. → ESCRITURA LÁSER CNC (ESTILO PUMA PUNKU) + ENCASTRE 3D ──
        if (conectaWrap && conectaRevealed && conectaLaser) {
          const cutProgress = { val: 0 };
          tl.set(conectaWrap, { autoAlpha: 1 })
            .set(conectaRevealed, { clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)", x: 0 })
            .set(conectaLaser, { left: "0%", opacity: 1 })
            .set(cutProgress, { val: 0 })
            .to(cutProgress, {
              val: 100,
              duration: 1.35,
              ease: "none",
              onUpdate: () => {
                const p = cutProgress.val;
                conectaRevealed.style.clipPath = `polygon(0% 0%, ${p}% 0%, ${p}% 100%, 0% 100%)`;
                conectaLaser.style.left = `${p}%`;
              },
            })
            .to(conectaLaser, { opacity: 0, duration: 0.15 }, "cncLock")
            .fromTo(conectaRevealed, { x: -4 }, { x: 0, duration: 0.12, ease: "power4.inOut" }, "cncLock")
            .to({}, { duration: 1.75 })
            .to(conectaWrap, { autoAlpha: 0, duration: 0.4, ease: "power2.in" })
            .set(conectaRevealed, { clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)", x: 0 })
            .set(conectaLaser, { left: "0%", opacity: 0 });
        }

        tl.to({}, { duration: 0.25 });

        // Pausa al posar el mouse para permitir lectura reflexiva
        const handleMouseEnter = () => tl.pause();
        const handleMouseLeave = () => tl.resume();
        root.addEventListener("mouseenter", handleMouseEnter);
        root.addEventListener("mouseleave", handleMouseLeave);

        // Activación inmediata por scroll con IntersectionObserver:
        // Apenas el usuario scrollea y asoma la sección, arranca en t=0 con "Duda."
        let hasStarted = false;
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              dustEffect?.start();
              if (!hasStarted) {
                hasStarted = true;
                tl.restart(); // Arranca exactamente en t=0 con fade in de Duda
              } else {
                tl.play();
              }
            } else {
              dustEffect?.stop();
              tl.pause();
            }
          });
        }, { threshold: 0.15 });

        observer.observe(root);

        // Limpieza para View Transitions
        document.addEventListener("astro:before-swap", () => {
          observer.disconnect();
          root.removeEventListener("mouseenter", handleMouseEnter);
          root.removeEventListener("mouseleave", handleMouseLeave);
          dustEffect?.destroy();
          ctx.revert();
        }, { once: true });
      }, root);
    });
  }

  document.addEventListener("astro:page-load", initAdnExcerptInstances);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAdnExcerptInstances);
  } else {
    initAdnExcerptInstances();
  }
</script>
