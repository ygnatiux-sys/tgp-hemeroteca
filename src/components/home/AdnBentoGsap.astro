---
/**
 * AdnBentoGsap.astro — Stream Cinemático ADN Zenital TGP
 * "Duda. Investiga. Conecta. — Historia de la producción humana de sentido"
 *
 * Arquitectura Técnica Robusta:
 * - Grid Stacking en CSS (col-start-1 row-start-1) para evitar colapsos de altura y desbordes.
 * - Gestión estricta de z-index y autoAlpha en GSAP para erradicar cualquier z-fight o parpadeo.
 * - Sin transiciones CSS conflictivas en elementos animados por GSAP (cero micro-stutter).
 * - Canvas de polvo dorado cinemático suspendido automáticamente fuera del viewport (IntersectionObserver).
 * - Full bleed con máscara vertical suave que se integra en --bg-main.
 */

export interface AdnBatch {
  kicker: string;
  main: string;
  highlight: string;
  reflection: string;
  image: string;
  imageLabel: string;
  tag: string;
}

interface Props {
  instanceId?: string;
  batches?: AdnBatch[];
  className?: string;
}

const defaultBatches: AdnBatch[] = [
  {
    kicker: "01 · DUDA METÓDICA",
    main: "Duda de los datos sueltos.",
    highlight: "La historia no es solo lo que nos pasó; es cómo aprendimos a darle sentido.",
    reflection: "Conectamos fragmentos materiales, piedras y relatos para comprender cómo la humanidad transforma el caos en significado.",
    image: "https://storage.thegreatpuzzleproject.com/wikimedia/1791676137832-aca96ac9.webp",
    imageLabel: "GUNUNG PADANG · TERRAZAS MEGALÍTICAS",
    tag: "ANOMALÍA ESTRATIGRÁFICA"
  },
  {
    kicker: "02 · LA HUELLA EN LA MATERIA",
    main: "Investiga la huella en la materia.",
    highlight: "Tallamos la piedra y el relato para no disolvernos en la incertidumbre del olvido.",
    reflection: "Templos, mitos, lenguajes y máquinas leídos como palimpsestos de significado que se conservan, se disputan y reaparecen.",
    image: "https://storage.thegreatpuzzleproject.com/portadas/piramide-del-adivino-de-uxmal/1792584099533-53cd17a4.webp",
    imageLabel: "UXMAL · PIRÁMIDE DEL ADIVINO",
    tag: "ARQUEOSEMIÓTICA MAYA"
  },
  {
    kicker: "03 · LA RED DE SÍMBOLOS",
    main: "Conecta símbolos con rigor crítico.",
    highlight: "Diez dominios epistémicos para desentrañar cómo construimos los mundos en los que creemos.",
    reflection: "Exploramos conexiones profundas entre épocas sin confundir analogías con pruebas ni hipótesis con dogmas.",
    image: "https://storage.thegreatpuzzleproject.com/vault-media/1792290262796-a9133c37.webp",
    imageLabel: "HESÍODO · LA TEOGONÍA",
    tag: "COSMOGONÍA Y ARCHIVO"
  }
];

const {
  instanceId = 'tgp-adn-stream',
  batches = defaultBatches,
  className = '',
} = Astro.props;
---

<style>
  @import url('https://fonts.googleapis.com/css2?family=Gloock&display=swap');
  @import url('https://fonts.googleapis.com/css2?family=Proza+Libre:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap');

  /* Sombras y reflejos metálicos optimizados para aceleración GPU */
  .adn-title-glow {
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.95), 0 0 24px rgba(212, 175, 55, 0.22);
  }

  .adn-highlight-glow {
    text-shadow: 0 0 28px rgba(234, 179, 8, 0.35);
  }

  /* Grid Stack: todos los hijos comparten la misma celda sin absolute colapsado */
  .adn-stack-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    align-items: center;
  }

  .adn-stack-cell {
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    will-change: opacity, transform;
  }
</style>

<section
  id={instanceId}
  data-adn-stream-root
  data-adn-instance={instanceId}
  aria-label="Manifiesto Cinemático TGP — Duda, Investiga, Conecta"
  class={`adn-stream-section relative w-full overflow-hidden select-none isolate py-20 sm:py-28 md:py-36 bg-[#060707] ${className}`}
  style="mask-image: linear-gradient(to bottom, transparent 0%, black 8%, black 92%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 8%, black 92%, transparent 100%);"
>
  <!-- Canvas de partículas vivas de polvo dorado -->
  <canvas
    id={`${instanceId}-dust-canvas`}
    class="adn-dust-canvas absolute inset-0 w-full h-full pointer-events-none z-0"
    aria-hidden="true"
  ></canvas>

  <!-- Luz ambiental cálida de fondo -->
  <div class="pointer-events-none absolute top-1/2 left-1/3 -translate-x-1/2 -translate-y-1/2 w-96 sm:w-lg md:w-2xl h-96 sm:h-128 md:h-168 rounded-full bg-amber-500/8 blur-[110px]" aria-hidden="true"></div>

  <!-- Contenedor maestro 60 / 40 -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8 md:px-12 relative z-10">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-16 xl:gap-20">
      
      <!-- ═══════════════════════════════════════════════════════════════════
           LADO TEXTO (60%): Stage de Frases Monumentales en Grid Stack
      ═══════════════════════════════════════════════════════════════════ -->
      <div class="w-full lg:w-[58%] xl:w-[60%] adn-stack-grid relative">
        {batches.map((batch, idx) => (
          <div
            class={`adn-text-slide adn-stack-cell flex flex-col justify-center py-4 ${idx === 0 ? 'visible z-10' : 'invisible z-0'}`}
            data-slide-index={idx}
            style={idx === 0 ? "opacity: 1;" : "opacity: 0; pointer-events: none;"}
          >
            <!-- Kicker con aura ámbar pulsante -->
            <div class="flex items-center gap-3 text-xs sm:text-[13px] uppercase tracking-[0.32em] text-[#d4af37] font-metadata font-bold mb-4 sm:mb-6">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse shadow-[0_0_12px_#f59e0b]"></span>
              <span>{batch.kicker}</span>
            </div>

            <!-- Título Monumental Gloock + Cursiva Dorada TGP -->
            <h2 class="font-['Gloock'] text-3xl sm:text-4xl md:text-[2.75rem] lg:text-[3.25rem] leading-[1.12] tracking-tight text-[#EDEDE8] adn-title-glow">
              {batch.main} <br/>
              <span class="text-[#d4af37] font-serif italic font-normal adn-highlight-glow">
                {batch.highlight}
              </span>
            </h2>

            <!-- Bajada reflexiva en Proza Libre -->
            <p class="font-['Proza_Libre'] text-base sm:text-lg md:text-xl text-[#D8D2C2]/85 leading-relaxed mt-6 sm:mt-8 max-w-2xl drop-shadow-md">
              {batch.reflection}
            </p>

            <!-- Línea de reposo sutil sin bordes invasivos -->
            <div class="flex items-center gap-4 pt-6 mt-6 border-t border-white/5 font-metadata text-[11px] sm:text-xs tracking-[0.26em] uppercase text-zinc-500">
              <span class="text-amber-400/80 font-bold">TGP</span>
              <span class="opacity-40">•</span>
              <span>HISTORIA DE LA PRODUCCIÓN HUMANA DE SENTIDO</span>
            </div>
          </div>
        ))}
      </div>

      <!-- ═══════════════════════════════════════════════════════════════════
           LADO VISUAL (40%): Portada Arqueológica con Ambient Glow
      ═══════════════════════════════════════════════════════════════════ -->
      <div class="w-full lg:w-[42%] xl:w-[40%] flex justify-center items-center relative">
        <!-- Resplandor ambiental hacia la imagen que elimina cortes duros -->
        <div class="pointer-events-none absolute -inset-8 bg-linear-to-tr from-amber-500/25 via-amber-400/12 to-transparent blur-3xl rounded-3xl opacity-80" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-10 -left-10 w-60 h-60 bg-amber-600/15 blur-[80px] rounded-full" aria-hidden="true"></div>

        <!-- Marco cinemático con difuminado interno y bordes suaves -->
        <div class="relative w-full aspect-4/3 sm:aspect-16/10 lg:aspect-4/3 max-w-lg rounded-3xl overflow-hidden border border-white/10 shadow-[0_24px_70px_rgba(0,0,0,0.95)] bg-black/60 adn-stack-grid isolate">
          <!-- Viñeta perimetral interior para fundir bordes a la penumbra -->
          <div class="pointer-events-none absolute inset-0 z-20 shadow-[inset_0_0_60px_rgba(0,0,0,0.95)] rounded-3xl" aria-hidden="true"></div>

          {batches.map((batch, idx) => (
            <div
              class={`adn-img-slide adn-stack-cell w-full h-full overflow-hidden ${idx === 0 ? 'visible z-10' : 'invisible z-0'}`}
              data-img-index={idx}
              style={idx === 0 ? "opacity: 1;" : "opacity: 0;"}
            >
              <img
                src={batch.image}
                alt={batch.imageLabel}
                class="w-full h-full object-cover filter brightness-[0.88] contrast-[1.08]"
                loading={idx === 0 ? "eager" : "lazy"}
                decoding="async"
              />
              <!-- Gradiente sutil inferior para legibilidad de cartela -->
              <div class="absolute inset-0 z-10 bg-linear-to-t from-black/85 via-black/25 to-transparent"></div>

              <!-- Cartela informativa sutil -->
              <div class="absolute bottom-4 left-4 right-4 z-30 flex items-center justify-between text-[11px] font-metadata tracking-[0.22em] uppercase text-white/75">
                <span class="text-[#d4af37] font-bold drop-shadow">{batch.imageLabel}</span>
                <span class="px-2.5 py-1 rounded-full bg-black/65 backdrop-blur-md border border-white/10 text-white/60 text-[10px]">{batch.tag}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Script GSAP Puro & Canvas Control -->
<script>
  import { gsap } from "gsap";

  // ─── CANVAS DE POLVO DORADO (Control de ciclos limpios) ────────────────────
  class DustMotesStream {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private motes: Array<{
      x: number;
      y: number;
      radius: number;
      opacity: number;
      speedX: number;
      speedY: number;
      angle: number;
      angleSpeed: number;
      osc: number;
      flickPhase: number;
      flickSpeed: number;
    }> = [];
    private animationFrameId: number | null = null;
    private isRunning: boolean = false;
    private boundResize: () => void;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext("2d")!;
      this.boundResize = this.resize.bind(this);
      this.resize();
      window.addEventListener("resize", this.boundResize);
    }

    public resize() {
      const parent = this.canvas.parentElement;
      const rect = parent ? parent.getBoundingClientRect() : null;
      this.canvas.width = rect && rect.width > 0 ? rect.width : window.innerWidth;
      this.canvas.height = rect && rect.height > 0 ? rect.height : (window.innerHeight * 0.8);
    }

    private spawnMote(fromLeft = false) {
      const w = this.canvas.width;
      const h = this.canvas.height;
      return {
        x: fromLeft ? -10 : Math.random() * w,
        y: Math.random() * h,
        radius: 0.7 + Math.random() * 2.2,
        opacity: 0.15 + Math.random() * 0.45,
        speedX: 0.22 + Math.random() * 0.45,
        speedY: (Math.random() - 0.5) * 0.12,
        angle: Math.random() * Math.PI * 2,
        angleSpeed: 0.005 + Math.random() * 0.012,
        osc: 0.05 + Math.random() * 0.10,
        flickPhase: Math.random() * Math.PI * 2,
        flickSpeed: 0.012 + Math.random() * 0.025,
      };
    }

    public start() {
      if (this.isRunning) return;
      this.isRunning = true;
      const count = Math.min(50, Math.max(20, Math.floor(this.canvas.width / 26)));
      if (this.motes.length === 0) {
        this.motes = Array.from({ length: count }, () => this.spawnMote(false));
      }
      this.loop();
    }

    public stop() {
      this.isRunning = false;
      if (this.animationFrameId) {
        cancelAnimationFrame(this.animationFrameId);
        this.animationFrameId = null;
      }
    }

    public destroy() {
      this.stop();
      window.removeEventListener("resize", this.boundResize);
    }

    private loop() {
      if (!this.isRunning) return;
      const ctx = this.ctx;
      const w = this.canvas.width;
      const h = this.canvas.height;
      ctx.clearRect(0, 0, w, h);

      for (let i = 0; i < this.motes.length; i++) {
        const m = this.motes[i];
        m.angle += m.angleSpeed;
        m.flickPhase += m.flickSpeed;
        m.x += m.speedX;
        m.y += m.speedY + Math.sin(m.angle) * m.osc;

        if (m.x > w + 12 || m.y < -12 || m.y > h + 12) {
          this.motes[i] = this.spawnMote(true);
          continue;
        }

        const flicker = 0.75 + Math.sin(m.flickPhase) * 0.25;
        const alpha = Math.max(0, Math.min(1, m.opacity * flicker));

        ctx.beginPath();
        ctx.arc(m.x, m.y, m.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(201, 168, 108, ${alpha})`;
        ctx.shadowColor = "rgba(212, 175, 55, 0.4)";
        ctx.shadowBlur = 6;
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      this.animationFrameId = requestAnimationFrame(this.loop.bind(this));
    }
  }

  // ─── CONTROLADOR GSAP TIMELINE EN 3 ETAPAS (Sin Z-fights) ───────────────────
  function initAdnStreamInstances() {
    const roots = document.querySelectorAll<HTMLElement>("[data-adn-stream-root]");
    if (roots.length === 0) return;

    roots.forEach((root) => {
      if (root.dataset.adnInitialized === "true") return;
      root.dataset.adnInitialized = "true";

      // 1. Instanciar Dust Canvas
      let dustEffect: DustMotesStream | null = null;
      const canvas = root.querySelector<HTMLCanvasElement>(".adn-dust-canvas");
      if (canvas) {
        dustEffect = new DustMotesStream(canvas);
      }

      const textSlides = gsap.utils.toArray<HTMLElement>(root.querySelectorAll<HTMLElement>(".adn-text-slide"));
      const imgSlides = gsap.utils.toArray<HTMLElement>(root.querySelectorAll<HTMLElement>(".adn-img-slide"));
      const count = textSlides.length;

      if (count < 2) {
        dustEffect?.start();
        return;
      }

      // Accesibilidad
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion) {
        dustEffect?.start();
        return;
      }

      const ctx = gsap.context(() => {
        // Inicializar capas: solo slide 0 visible en z-index 10
        gsap.set(textSlides[0], { autoAlpha: 1, y: 0, zIndex: 10 });
        gsap.set(imgSlides[0], { autoAlpha: 1, scale: 1, zIndex: 10 });

        for (let j = 1; j < count; j++) {
          gsap.set(textSlides[j], { autoAlpha: 0, y: 18, zIndex: 1 });
          gsap.set(imgSlides[j], { autoAlpha: 0, scale: 1.05, zIndex: 1 });
        }

        // Timeline suave, semi-slow y robusto
        const tl = gsap.timeline({ repeat: -1 });
        const pauseDuration = 4.8;
        const transitionDuration = 1.35;

        for (let i = 0; i < count; i++) {
          const next = (i + 1) % count;
          const currentText = textSlides[i];
          const currentImg = imgSlides[i];
          const nextText = textSlides[next];
          const nextImg = imgSlides[next];

          // 1. Pausa de lectura
          tl.to({}, { duration: pauseDuration });

          // 2. Transición sincronizada
          // Elevar z-index de la que entra para que cubra a la que sale sin z-fighting
          tl.set(nextText, { zIndex: 10, y: 18 }, `step-${i}`)
            .set(nextImg, { zIndex: 10, scale: 1.05 }, `step-${i}`)
            .set(currentText, { zIndex: 5 }, `step-${i}`)
            .set(currentImg, { zIndex: 5 }, `step-${i}`)

            // Salida de la actual
            .to(currentText, {
              autoAlpha: 0,
              y: -18,
              duration: transitionDuration,
              ease: "power2.inOut",
            }, `step-${i}`)
            .to(currentImg, {
              autoAlpha: 0,
              scale: 0.98,
              duration: transitionDuration,
              ease: "power2.inOut",
            }, `step-${i}`)

            // Entrada de la siguiente (ligero desfase armónico de 0.1s)
            .to(nextText, {
              autoAlpha: 1,
              y: 0,
              duration: transitionDuration,
              ease: "power2.out",
            }, `step-${i}+=0.1`)
            .to(nextImg, {
              autoAlpha: 1,
              scale: 1.0,
              duration: transitionDuration * 1.05,
              ease: "power2.out",
            }, `step-${i}+=0.1`)

            // Limpieza: tras salir, volver la capa anterior a z-index base y reposicionar
            .set(currentText, { zIndex: 1, y: 18 })
            .set(currentImg, { zIndex: 1, scale: 1.05 });
        }

        // Pausa interactiva al posar el mouse
        const handleMouseEnter = () => tl.pause();
        const handleMouseLeave = () => tl.resume();
        root.addEventListener("mouseenter", handleMouseEnter);
        root.addEventListener("mouseleave", handleMouseLeave);

        // Optimización de recursos con IntersectionObserver
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              dustEffect?.start();
              tl.play();
            } else {
              dustEffect?.stop();
              tl.pause();
            }
          });
        }, { threshold: 0.15 });

        observer.observe(root);

        // Limpieza de ciclo de vida de Astro View Transitions
        document.addEventListener("astro:before-swap", () => {
          observer.disconnect();
          root.removeEventListener("mouseenter", handleMouseEnter);
          root.removeEventListener("mouseleave", handleMouseLeave);
          dustEffect?.destroy();
          ctx.revert();
        }, { once: true });
      }, root);
    });
  }

  document.addEventListener("astro:page-load", initAdnStreamInstances);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAdnStreamInstances);
  } else {
    initAdnStreamInstances();
  }
</script>
