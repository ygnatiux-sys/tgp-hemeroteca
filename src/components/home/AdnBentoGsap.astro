---
/**
 * AdnBentoGsap.astro — Respiro Editorial ADN Zenital TGP
 * "Duda. Investiga. Conecta. — Historia de la producción humana de sentido"
 *
 * Características:
 * 1. Palabra rectora destacada (CamelCase) en púrpura amatista luminoso monumental (extra bold, extra grande).
 * 2. Frase heredada centrada con tipografía Gloock y gradientes metálicos idénticos a About (CinematicExcerptRest).
 * 3. Altura de contenedor bloqueada (Zero Layout Shift) para erradicar el salto arriba/abajo entre frases.
 * 4. Canvas de polvo dorado en tiempo real con física suave de brisa.
 * 5. GSAP Timeline con fade in suave, paso de tiempo normal y sin cortes en el DOM.
 */

interface Props {
  instanceId?: string;
  className?: string;
}

const {
  instanceId = "tgp-adn-respiro",
  className = "",
} = Astro.props;

interface AdnItem {
  leadWord: string;
  restText: string;
}

const rawBatches: AdnItem[] = [
  {
    leadWord: "Duda.",
    restText: "de los **datos sueltos.** La historia no es solo lo que nos pasó; es cómo aprendimos a [[darle sentido]]."
  },
  {
    leadWord: "Investiga.",
    restText: "la **huella en la materia.** Tallamos la piedra y el relato para no disolvernos en la [[incertidumbre del olvido]]."
  },
  {
    leadWord: "Conecta.",
    restText: "símbolos con **rigor crítico.** Diez dominios epistémicos para desentrañar cómo construimos los [[mundos en los que creemos]]."
  }
];

// Tokenizador de palabras para la frase secundaria con soporte para ** (glow blanco) y [[ ]] (dorado TGP)
const parsedBatches = rawBatches.map((item, bIdx) => {
  const rawWords = item.restText.trim().split(/\s+/);
  let currentMode: 'normal' | 'glow' | 'accent' = 'normal';

  const wordsData = rawWords.map((rawWord, wordIdx) => {
    let word = rawWord;
    let type: 'normal' | 'glow' | 'accent' = currentMode;

    if (word.startsWith('**')) {
      currentMode = 'glow';
      type = 'glow';
      word = word.slice(2);
    } else if (word.startsWith('[[')) {
      currentMode = 'accent';
      type = 'accent';
      word = word.slice(2);
    }

    let endsGlow = false;
    let endsAccent = false;

    if (word.endsWith('**')) {
      endsGlow = true;
      word = word.slice(0, -2);
    } else if (word.includes('**')) {
      word = word.replace(/\*\*/g, '');
      endsGlow = true;
    }

    if (word.endsWith(']]') || word.includes(']].') || word.includes(']],') || word.includes(']]:') || word.includes(']];')) {
      endsAccent = true;
      word = word.replace(/\]\]/g, '');
    } else if (word.includes(']]')) {
      word = word.replace(/\]\]/g, '');
      endsAccent = true;
    }

    const cleanWord = word.replace(/\[\[/g, '').replace(/\]\]/g, '').replace(/\*\*/g, '');

    if (endsGlow || endsAccent) {
      currentMode = 'normal';
    }

    return {
      word: cleanWord,
      type,
      index: wordIdx
    };
  });

  return {
    bIdx,
    leadWord: item.leadWord,
    wordsData
  };
});
---

<!-- Import de fuente Gloock idéntica a CinematicExcerptRest -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Gloock&display=swap');

  /* ── Palabra rectora Cinemax H1 Monumental ── */
  .adn-lead-purple {
    font-family: 'Gloock', serif;
    font-weight: 900;
    background-image: linear-gradient(135deg, #ffffff 0%, #f5e8ff 18%, #e9d5ff 36%, #c084fc 62%, #a855f7 82%, #7e22ce 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 35px rgba(192, 132, 252, 0.55)) drop-shadow(0 0 75px rgba(147, 51, 234, 0.35)) drop-shadow(0 8px 24px rgba(0, 0, 0, 0.95));
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    line-height: 0.95;
    letter-spacing: -0.03em;
    will-change: transform, opacity, filter;
  }

  /* ── Tipografía Gloock de la frase heredada en escala Cine Premier ── */
  .excerpt-phrase-text {
    font-family: 'Gloock', serif;
    font-size: clamp(1.5rem, 2.8vw, 2.3rem);
    font-weight: 800;
    line-height: 1.28;
    letter-spacing: -0.015em;
    max-width: 38ch;
    margin-left: auto;
    margin-right: auto;
    text-wrap: balance;
    padding: 0;
    will-change: transform, opacity, filter;
  }

  .excerpt-word-wrapper {
    display: inline-block;
    white-space: nowrap;
  }

  .excerpt-space {
    display: inline-block;
  }

  .excerpt-word {
    display: inline-block;
  }

  /* ── Degradados metálicos idénticos a About (CinematicExcerptRest) ── */
  .word-normal {
    background-image: linear-gradient(to bottom, #EFEBE3 0%, #D8D2C2 50%, rgba(200, 192, 175, 0.7) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 800;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .word-glow {
    background-image: linear-gradient(to bottom, #FFFFFF 0%, #F5F0E6 50%, #E3DDD3 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 900;
    filter: drop-shadow(0 0 18px rgba(255, 255, 255, 0.42));
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .word-accent {
    background-image: linear-gradient(to bottom, #FFF3D1 0%, #E8CA82 45%, #C29B4F 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 900;
    filter: drop-shadow(0 0 18px rgba(234, 179, 8, 0.42));
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .glow-metallic-gloock {
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 22px rgba(227, 221, 211, 0.2));
  }

  /* ── Contenedor de Altura Bloqueada: Elimina 100% el salto del DOM ── */
  .adn-stage-container {
    height: 320px;
    position: relative;
    width: 100%;
    contain: layout size;
    overflow-anchor: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .adn-stage-container {
      height: 350px;
    }
  }

  @media (min-width: 1024px) {
    .adn-stage-container {
      height: 380px;
    }
  }

  .adn-slide-item {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
    will-change: opacity, transform, filter;
  }
</style>

<section
  id={instanceId}
  class={`cinematic-excerpt-rest relative w-full bg-(--bg-main) overflow-hidden select-none py-16 sm:py-24 md:py-32 flex flex-col justify-center items-center ${className}`}
  style="background-color: var(--bg-main, #121413);"
  data-adn-excerpt-root
>
  <!-- Lienzo de partículas de polvo dorado en suspensión -->
  <canvas class="excerpt-dust-canvas absolute inset-0 z-0 pointer-events-none" id={`${instanceId}-canvas`}></canvas>

  <!-- Contenedor central con altura bloqueada (Zero Layout Shift) -->
  <div class="excerpt-content relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 md:px-8 text-center">
    <div class="adn-stage-container">
      {parsedBatches.map((batch, idx) => (
        <div
          class="adn-slide-item"
          data-slide-index={idx}
          style="opacity: 1; visibility: visible;"
        >
          <!-- 1. Palabra rectora destacada en púrpura monumental Cinemax H1 (centrada absoluta) -->
          <div class="adn-lead-purple absolute inset-0 flex items-center justify-center text-center text-6xl sm:text-7xl md:text-8xl lg:text-[7.5rem] xl:text-[8.5rem] select-none pointer-events-auto">
            {batch.leadWord}
          </div>

          <!-- 2. Frase heredada centrada Gloock metálica (centrada absoluta) -->
          <div class="adn-phrase-block absolute inset-0 flex items-center justify-center text-center px-4 pointer-events-auto">
            <h2 class="excerpt-phrase-text glow-metallic-gloock">
              {batch.wordsData.map((wd) => (
                <span class="excerpt-word-wrapper">
                  <span
                    class:list={[
                      "excerpt-word",
                      wd.type === "glow" ? "word-glow" : "",
                      wd.type === "accent" ? "word-accent" : "word-normal",
                    ]}
                  >
                    {wd.word}
                  </span>
                  <span class="excerpt-space" aria-hidden="true">&nbsp;</span>
                </span>
              ))}
            </h2>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Script de Polvo Dorado y GSAP Timeline Suave -->
<script>
  import { gsap } from "gsap";

  // ─── CANVAS DE POLVO DORADO IDÉNTICO A CINEMATICEXCERPTREST ───────────────
  class DustMotesEffect {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private motes: Array<{
      x: number;
      y: number;
      radius: number;
      opacity: number;
      speedX: number;
      speedY: number;
      angle: number;
      angleSpeed: number;
      osc: number;
      flickPhase: number;
      flickSpeed: number;
    }> = [];
    private animationFrameId: number | null = null;
    private isRunning: boolean = false;
    private boundResize: () => void;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext("2d")!;
      this.boundResize = this.resize.bind(this);
      this.resize();
      window.addEventListener("resize", this.boundResize);
    }

    public resize() {
      const parent = this.canvas.parentElement;
      const rect = parent ? parent.getBoundingClientRect() : null;
      this.canvas.width = rect && rect.width > 0 ? rect.width : window.innerWidth;
      this.canvas.height = rect && rect.height > 0 ? rect.height : (window.innerHeight * 0.85);
    }

    private spawnMote(fromLeft = false) {
      const w = this.canvas.width;
      const h = this.canvas.height;
      return {
        x: fromLeft ? -10 : Math.random() * w,
        y: Math.random() * h,
        radius: 0.8 + Math.random() * 2.4,
        opacity: 0.12 + Math.random() * 0.50,
        speedX: 0.20 + Math.random() * 0.55,
        speedY: (Math.random() - 0.5) * 0.13,
        angle: Math.random() * Math.PI * 2,
        angleSpeed: 0.004 + Math.random() * 0.015,
        osc: 0.06 + Math.random() * 0.11,
        flickPhase: Math.random() * Math.PI * 2,
        flickSpeed: 0.010 + Math.random() * 0.028,
      };
    }

    public start() {
      if (this.isRunning) return;
      this.isRunning = true;
      this.motes = Array.from({ length: 55 }, () => this.spawnMote(false));
      this.loop();
    }

    public stop() {
      this.isRunning = false;
      if (this.animationFrameId) {
        cancelAnimationFrame(this.animationFrameId);
        this.animationFrameId = null;
      }
    }

    public destroy() {
      this.stop();
      window.removeEventListener("resize", this.boundResize);
    }

    private loop() {
      if (!this.isRunning) return;
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

      this.motes.forEach(m => {
        m.x += m.speedX;
        m.y += m.speedY + Math.sin(m.angle) * m.osc;
        m.angle += m.angleSpeed;
        m.flickPhase += m.flickSpeed;

        if (m.x > this.canvas.width + 14) {
          Object.assign(m, this.spawnMote(true));
        }

        const flick = 1 + 0.16 * Math.sin(m.flickPhase);
        const finalOp = Math.min(1, m.opacity * flick);
        const grad = this.ctx.createRadialGradient(m.x, m.y, 0, m.x, m.y, m.radius * 2.6);
        grad.addColorStop(0, `rgba(201, 168, 108, ${finalOp})`);
        grad.addColorStop(0.4, `rgba(223, 202, 157, ${(finalOp * 0.6).toFixed(3)})`);
        grad.addColorStop(1, 'rgba(201, 168, 108, 0)');

        this.ctx.beginPath();
        this.ctx.fillStyle = grad;
        this.ctx.arc(m.x, m.y, m.radius * 2.6, 0, Math.PI * 2);
        this.ctx.fill();
      });

      this.animationFrameId = requestAnimationFrame(this.loop.bind(this));
    }
  }

  // ─── CONTROLADOR GSAP SECUENCIAL CON TRANSICIÓN SUAVE ──────────────────────
  function initAdnExcerptInstances() {
    const roots = document.querySelectorAll<HTMLElement>("[data-adn-excerpt-root]");
    if (roots.length === 0) return;

    roots.forEach((root) => {
      if (root.dataset.adnInit === "true") return;
      root.dataset.adnInit = "true";

      const canvas = root.querySelector<HTMLCanvasElement>(".excerpt-dust-canvas");
      let dustEffect: DustMotesEffect | null = null;
      if (canvas) {
        dustEffect = new DustMotesEffect(canvas);
      }

      const slides = gsap.utils.toArray<HTMLElement>(root.querySelectorAll<HTMLElement>(".adn-slide-item"));
      const count = slides.length;

      if (count < 2) {
        dustEffect?.start();
        return;
      }

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion) {
        dustEffect?.start();
        return;
      }

      const ctx = gsap.context(() => {
        const slidesData = slides.map((slide) => ({
          slide,
          lead: slide.querySelector<HTMLElement>(".adn-lead-purple"),
          phrase: slide.querySelector<HTMLElement>(".adn-phrase-block"),
        }));

        // Reset inicial de capas (todas ocultas para comenzar limpias en t=0 al scrollear)
        slidesData.forEach((item) => {
          gsap.set(item.slide, { autoAlpha: 1 });
          if (item.lead) {
            gsap.set(item.lead, {
              autoAlpha: 0,
              scale: 0.93,
              filter: "blur(14px)",
              y: 12,
            });
          }
          if (item.phrase) {
            gsap.set(item.phrase, {
              autoAlpha: 0,
              y: 14,
              filter: "blur(8px)",
            });
          }
        });

        const tl = gsap.timeline({ repeat: -1, paused: true });
        const wordInTime = 0.85;       // Aparición majestuosa de la palabra rectora
        const wordDwellTime = 1.6;     // Pausa de impacto de la palabra
        const wordOutTime = 0.55;      // Desvanecimiento completo de la palabra
        const breathTime = 0.2;        // Silencio dramático
        const phraseInTime = 0.95;     // Aparición suave de la frase centrada
        const phraseDwellTime = 4.2;   // Lectura profunda de la frase
        const phraseOutTime = 0.65;    // Desvanecimiento suave de la frase

        for (let i = 0; i < count; i++) {
          const current = slidesData[i];

          // 1. La palabra rectora (Duda. / Investiga. / Conecta.) aparece en el centro exacto
          if (current.lead) {
            tl.to(current.lead, {
              autoAlpha: 1,
              scale: 1,
              filter: "blur(0px)",
              y: 0,
              duration: wordInTime,
              ease: "power3.out",
            });
            // Pausa para leer la palabra con peso visual
            tl.to({}, { duration: wordDwellTime });
            // La palabra desaparece completamente antes de que entre la frase
            tl.to(current.lead, {
              autoAlpha: 0,
              y: -12,
              scale: 0.96,
              filter: "blur(10px)",
              duration: wordOutTime,
              ease: "power2.in",
            });
            // Reset off-screen para el próximo ciclo
            tl.set(current.lead, { y: 12, scale: 0.93, filter: "blur(14px)" });
          }

          // Silencio / respiración
          tl.to({}, { duration: breathTime });

          // 2. La frase entra en el centro exacto del visor
          if (current.phrase) {
            tl.to(current.phrase, {
              autoAlpha: 1,
              y: 0,
              filter: "blur(0px)",
              duration: phraseInTime,
              ease: "power2.out",
            });
            // Tiempo de lectura reflexiva
            tl.to({}, { duration: phraseDwellTime });
            // La frase desaparece por completo
            tl.to(current.phrase, {
              autoAlpha: 0,
              y: -14,
              filter: "blur(10px)",
              duration: phraseOutTime,
              ease: "power2.in",
            });
            // Reset off-screen para el próximo ciclo
            tl.set(current.phrase, { y: 14, filter: "blur(8px)" });
          }

          // Silencio antes de la próxima palabra
          tl.to({}, { duration: breathTime });
        }

        // Pausa al posar el mouse para permitir lectura reflexiva
        const handleMouseEnter = () => tl.pause();
        const handleMouseLeave = () => tl.resume();
        root.addEventListener("mouseenter", handleMouseEnter);
        root.addEventListener("mouseleave", handleMouseLeave);

        // Activación inmediata por scroll con IntersectionObserver:
        // Apenas el usuario scrollea y asoma la sección, arranca en t=0 con "Duda."
        let hasStarted = false;
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              dustEffect?.start();
              if (!hasStarted) {
                hasStarted = true;
                tl.restart(); // Arranca exactamente en t=0 con fade in de Duda
              } else {
                tl.play();
              }
            } else {
              dustEffect?.stop();
              tl.pause();
            }
          });
        }, { threshold: 0.15 });

        observer.observe(root);

        // Limpieza para View Transitions
        document.addEventListener("astro:before-swap", () => {
          observer.disconnect();
          root.removeEventListener("mouseenter", handleMouseEnter);
          root.removeEventListener("mouseleave", handleMouseLeave);
          dustEffect?.destroy();
          ctx.revert();
        }, { once: true });
      }, root);
    });
  }

  document.addEventListener("astro:page-load", initAdnExcerptInstances);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAdnExcerptInstances);
  } else {
    initAdnExcerptInstances();
  }
</script>
