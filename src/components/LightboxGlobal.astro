---
// Componente de Lightbox Inmersivo Global para Astro (Soporte Táctil y Teclado)
import SpotifyIcon from './icons/Spotify.astro';
import YouTubeIcon from './icons/YouTube.astro';
---

<div
  id="tgp-lightbox"
  class="fixed inset-0 z-99999 bg-black/95 backdrop-blur-md hidden items-center justify-center transition-opacity duration-300 touch-none"
>
  <!-- Botón cerrar (Oculto por defecto, brilla al inicio y en hover) -->
  <button
    id="tgp-lightbox-close"
    class="absolute top-4 right-4 md:top-6 md:right-8 w-14 h-14 rounded-full flex items-center justify-center text-transparent hover:text-[#EFEBE3] bg-transparent hover:bg-black/30 hover:backdrop-blur-md opacity-0 hover:opacity-100 z-100000 transition-all duration-700 tgp-ui-control"
    aria-label="Cerrar visor"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  </button>

  <!-- Flecha Anterior -->
  <button
    id="tgp-lightbox-prev"
    class="absolute left-0 inset-y-0 w-20 md:w-32 flex items-center justify-center text-transparent hover:text-[#EFEBE3] bg-transparent hover:bg-linear-to-r hover:from-black/50 hover:to-transparent text-5xl md:text-7xl font-light z-100000 transition-all duration-700 select-none opacity-0 hover:opacity-100 tgp-ui-control"
    aria-label="Imagen anterior"
  >
    <span class="drop-shadow-2xl">❮</span>
  </button>

  <!-- Contenedor de la Imagen Fullscreen -->
  <!-- touch-action-none previene el scroll vertical del navegador al hacer swipe -->
  <!-- Agregamos 'isolate' para crear un nuevo contexto de apilamiento seguro -->
  <div
    id="tgp-lightbox-img-container"
    class="relative w-full h-full flex items-center justify-center overflow-hidden touch-none isolate"
  >
    <div class="absolute inset-4 md:inset-8 overflow-hidden rounded-3xl md:rounded-[2.5rem] shadow-2xl bg-black transform-gpu">
      <img
        id="tgp-lightbox-img"
        src=""
        alt=""
        class="w-full h-full object-cover select-none transition-all duration-1000 pointer-events-none scale-100 transform-gpu"
      />
      <!-- Viñeta oscura pura: sin mix-blend-mode para evitar glitches en la GPU -->
      <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl md:rounded-[2.5rem] shadow-[inset_0_0_180px_20px_rgba(0,0,0,1)]"></div>
    </div>
  </div>

  <!-- Flecha Siguiente -->
  <button
    id="tgp-lightbox-next"
    class="absolute right-0 inset-y-0 w-20 md:w-32 flex items-center justify-center text-transparent hover:text-[#EFEBE3] bg-transparent hover:bg-linear-to-l hover:from-black/50 hover:to-transparent text-5xl md:text-7xl font-light z-100000 transition-all duration-700 select-none opacity-0 hover:opacity-100 tgp-ui-control"
    aria-label="Siguiente imagen"
  >
    <span class="drop-shadow-2xl">❯</span>
  </button>

  <!-- Indicador visual sutil en móviles (opcional) -->
  <div
    id="tgp-lightbox-counter"
    class="md:hidden absolute bottom-4 text-white/40 text-xs font-mono tracking-widest z-100000 select-none"
  >
    <!-- Se llena vía JS -->
  </div>
  <!-- Pantalla de Intro Cinemática en Tandas (al abrir) -->
  <div id="tgp-lightbox-intro" class="absolute inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-xs opacity-0 pointer-events-none">
    {/* EFECTO TV CRT INICIAL (1ms después sobre la foto hero/inicial) */}
    <div id="tgp-lightbox-intro-tv" class="absolute inset-0 flex flex-col items-center justify-center opacity-0 pointer-events-none z-20">
      <div id="tgp-lightbox-intro-tv-brand" class="flex flex-col items-center justify-center">
        <div class="font-cinzel text-4xl md:text-6xl text-[#EFEBE3] font-bold drop-shadow-[0_0_40px_rgba(239, 235, 227,0.9)] tracking-wider text-center px-6">
          The Great Puzzle
        </div>
        <div class="font-mono text-xs md:text-sm tracking-[0.6em] text-white/70 mt-3 uppercase">
          — project —
        </div>
      </div>
    </div>

    {/* TANDA 1: Marca & Presenta (Sobre fondo negro) */}
    <div id="tgp-lightbox-intro-stage1" class="absolute inset-0 flex flex-col items-center justify-center opacity-0 z-10">
      <div class="font-cinzel text-4xl md:text-6xl text-[#EFEBE3] font-bold drop-shadow-[0_0_35px_rgba(239, 235, 227,0.7)] tracking-wider text-center px-6">
        The Great Puzzle
      </div>
      <div class="font-mono text-xs md:text-sm tracking-[0.6em] text-white/50 mt-4 uppercase">
        — project —
      </div>
      <div class="font-serif italic text-base md:text-lg text-white/70 tracking-widest mt-8">
        presenta
      </div>
    </div>

    {/* TANDA 2: Título Extra Bold Titanio Documental + Registro Visual Completo + Meta Socials */}
    <div id="tgp-lightbox-intro-stage2" class="absolute inset-0 flex items-center justify-center opacity-0 z-10">
      <div class="text-center px-6 max-w-6xl flex flex-col items-center">
        <h1 id="tgp-lightbox-intro-title" class="font-cinzel text-5xl md:text-7xl lg:text-8xl font-extrabold leading-tight tracking-tight mb-6 bg-linear-to-r from-white via-[#E2E8F0] to-[#94A3B8] bg-clip-text text-transparent drop-shadow-[0_15px_50px_rgba(0,0,0,0.95)]"></h1>
        <h2 id="tgp-lightbox-intro-h2" class="font-mono text-xs md:text-sm uppercase tracking-[0.4em] text-[#EFEBE3] font-semibold pb-2 inline-block opacity-0">
          REGISTRO VISUAL COMPLETO
        </h2>
        {/* METADATOS CON ÍCONOS SPOTIFY Y YOUTUBE */}
        <div id="tgp-lightbox-intro-meta" class="flex items-center justify-center gap-6 mt-6 transition-opacity duration-700 hover:opacity-100!">
          <a
            href="https://open.spotify.com"
            target="_blank"
            rel="noopener noreferrer"
            class="tgp-lb-meta-item group/sp flex items-center gap-2 font-mono text-[9px] uppercase tracking-[0.3em] text-white/60 hover:text-[#1DB954] transition-all duration-500 opacity-0"
          >
            <div class="p-2 rounded-full border border-white/20 group-hover/sp:border-[#1DB954] group-hover/sp:bg-[#1DB954]/15 transition-all duration-500">
              <SpotifyIcon class="w-4 h-4 text-white/70 group-hover/sp:text-[#1DB954] transition-all duration-500" />
            </div>
            <span>SPOTIFY</span>
          </a>

          <a
            href="https://youtube.com/@thegreatpuzzleproject"
            target="_blank"
            rel="noopener noreferrer"
            class="tgp-lb-meta-item group/yt flex items-center gap-2 font-mono text-[9px] uppercase tracking-[0.3em] text-white/60 hover:text-[#E52D27] transition-all duration-500 opacity-0"
          >
            <div class="p-2 rounded-full border border-white/20 group-hover/yt:border-[#E52D27] group-hover/yt:bg-[#E52D27]/15 transition-all duration-500">
              <YouTubeIcon class="w-4 h-4 text-white/70 group-hover/yt:text-[#E52D27] transition-all duration-500" />
            </div>
            <span>YOUTUBE</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Pantalla de Outro (al llegar al final) -->
  <div id="tgp-lightbox-outro" class="absolute inset-0 z-50 flex flex-col items-center justify-center bg-black opacity-0 pointer-events-none">
    {/* 1. Título del Post - idéntico en tamaño y efectos al Intro */}
    <h2 id="tgp-lightbox-outro-title" class="font-cinzel text-5xl md:text-7xl lg:text-8xl font-extrabold opacity-0 text-center px-8 max-w-6xl tracking-tight leading-tight bg-linear-to-r from-white via-[#E2E8F0] to-[#94A3B8] bg-clip-text text-transparent drop-shadow-[0_15px_50px_rgba(0,0,0,0.95)]"></h2>
    
    {/* 2. Brand unido para efecto TV CRT */}
    <div id="tgp-lightbox-outro-tv" class="absolute inset-0 flex flex-col items-center justify-center opacity-0 pointer-events-none z-20">
      <div id="tgp-lightbox-outro-tv-brand" class="flex flex-col items-center justify-center">
        <div class="font-cinzel text-4xl md:text-6xl text-[#EFEBE3] font-bold drop-shadow-[0_0_40px_rgba(239, 235, 227,0.9)] tracking-wider text-center px-6">
          The Great Puzzle
        </div>
        <div class="font-mono text-xs md:text-sm tracking-[0.6em] text-white/70 mt-3 uppercase">
          — project —
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let images: HTMLImageElement[] = [];
  let currentIndex = 0;
  let isOutroPlaying = false;
  let postTitle = ''; // Se rellena al abrir por primera vez

  const lightbox = document.getElementById("tgp-lightbox");
  const lightboxImg = document.getElementById(
    "tgp-lightbox-img",
  ) as HTMLImageElement;
  const container = document.getElementById("tgp-lightbox-img-container");
  const closeBtn = document.getElementById("tgp-lightbox-close");
  const prevBtn = document.getElementById("tgp-lightbox-prev");
  const nextBtn = document.getElementById("tgp-lightbox-next");
  const counter = document.getElementById("tgp-lightbox-counter");

  // Variables para gestos táctiles (Swipe)
  let touchStartX = 0;
  let touchEndX = 0;
  const minSwipeDistance = 50; // Distancia mínima para considerar un swipe válido

  let autoplayInterval: ReturnType<typeof setInterval>;
  let isPaused = false;

  function updateCounter() {
    if (counter && images.length > 1) {
      counter.textContent = `${currentIndex + 1} / ${images.length}`;
    } else if (counter) {
      counter.textContent = "";
    }
  }

  function startAutoplay() {
    clearInterval(autoplayInterval);
    autoplayInterval = setInterval(() => {
      if (!isPaused && !lightbox?.classList.contains("hidden")) {
        showNext(true);
      }
    }, 3000);
  }

  function stopAutoplay() {
    clearInterval(autoplayInterval);
  }

  function openLightbox(index: number) {
    if (!lightbox || !lightboxImg || images.length === 0) return;
    currentIndex = index;
    lightboxImg.src = images[currentIndex].src;
    lightboxImg.style.opacity = "1";
    lightboxImg.style.transform = "scale(1)";
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
    updateCounter();
    startAutoplay();

    // Trigger flash presence for UI controls
    const controls = document.querySelectorAll('.tgp-ui-control');
    controls.forEach(c => {
      c.classList.remove('flash-presence');
      void (c as HTMLElement).offsetWidth;
      c.classList.add('flash-presence');
    });
    
    // Solo lanzar intro en la primera apertura (index 0)
    if (index === 0) playIntroSequence();
  }

  function closeLightbox() {
    if (!lightbox) return;
    isOutroPlaying = false;
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
    stopAutoplay();
    // Ocultar pantallas de outro/intro si están visibles
    const intro = document.getElementById('tgp-lightbox-intro');
    const outro = document.getElementById('tgp-lightbox-outro');
    if (intro) intro.style.opacity = '0';
    if (outro) outro.style.opacity = '0';
  }

  function showNext(auto = false) {
    if (images.length <= 1) return;
    if (isOutroPlaying) return;
    if (!auto) stopAutoplay(); 
    
    // Si estamos en la última imagen, lanzar outro en vez de hacer loop
    if (currentIndex === images.length - 1 && !auto) {
      playOutroSequence();
      return;
    }
    
    // Efecto Fade to Black + Shrink pausado
    if (lightboxImg) {
      lightboxImg.style.opacity = "0";
      lightboxImg.style.transform = "scale(0.985) translateX(-1%)";
    }
    
    setTimeout(() => {
      currentIndex = (currentIndex + 1) % images.length;
      if (lightboxImg) {
        lightboxImg.src = images[currentIndex].src;
        lightboxImg.style.transform = "scale(1.015) translateX(1%)";
        void lightboxImg.offsetWidth;
        lightboxImg.style.opacity = "1";
        lightboxImg.style.transform = "scale(1) translateX(0)";
      }
      updateCounter();
      if (!auto) startAutoplay(); 
    }, 1200);
  }

  function showPrev(auto = false) {
    if (images.length <= 1) return;
    if (!auto) stopAutoplay();
    
    // Efecto Fade to Black + Shrink pausado
    if (lightboxImg) {
      lightboxImg.style.opacity = "0";
      lightboxImg.style.transform = "scale(0.985) translateX(1%)";
    }
    
    setTimeout(() => {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      if (lightboxImg) {
        lightboxImg.src = images[currentIndex].src;
        lightboxImg.style.transform = "scale(1.015) translateX(-1%)";
        
        void lightboxImg.offsetWidth;
        
        lightboxImg.style.opacity = "1";
        lightboxImg.style.transform = "scale(1) translateX(0)";
      }
      updateCounter();
      if (!auto) startAutoplay();
    }, 1200);
  }

  // Secuencia de Intro Cinemática en Tandas con Efecto TV CRT (al abrir la galería)
  function playIntroSequence() {
    const intro = document.getElementById('tgp-lightbox-intro') as HTMLElement;
    const tvStage = document.getElementById('tgp-lightbox-intro-tv') as HTMLElement;
    const tvBrand = document.getElementById('tgp-lightbox-intro-tv-brand') as HTMLElement;
    const stage1 = document.getElementById('tgp-lightbox-intro-stage1') as HTMLElement;
    const stage2 = document.getElementById('tgp-lightbox-intro-stage2') as HTMLElement;
    const introTitle = document.getElementById('tgp-lightbox-intro-title') as HTMLElement;
    if (!intro || !tvStage || !tvBrand || !stage1 || !stage2 || !introTitle) return;

    introTitle.textContent = postTitle || document.querySelector('h1')?.textContent || 'Registro Visual';

    // Audio cinemático Submarine Ping / Dark Braam para el Intro
    try {
      const audio = new Audio('/intro.cinematic.wav');
      audio.volume = 0.85;
      audio.play().catch(() => {});
    } catch (e) {}
    
    // Forzar primera imagen (Hero / index 0)
    currentIndex = 0;
    if (lightboxImg && images[0]) {
      lightboxImg.src = images[0].src;
      lightboxImg.style.opacity = '1';
      lightboxImg.style.transform = 'scale(1.05)';
    }

    // Iniciar con la foto inicial visible detrás (overlay semitransparente)
    intro.style.backgroundColor = 'rgba(0, 0, 0, 0.5)';
    intro.style.transition = 'opacity 0.3s ease';
    intro.style.opacity = '1';
    intro.style.pointerEvents = 'auto';

    tvStage.style.opacity = '1';
    tvBrand.style.transition = 'transform 0.3s cubic-bezier(0.1, 0.9, 0.2, 1), opacity 0.3s ease, filter 0.3s ease';
    tvBrand.style.transform = 'scaleX(0) scaleY(0.003)';
    tvBrand.style.opacity = '1';
    tvBrand.style.filter = 'brightness(3)';

    stage1.style.opacity = '0';
    stage2.style.opacity = '0';
    stage2.style.transform = 'scale(0.96)';
    stage2.style.filter = 'none';

    // 1ms después: Encendido TV sobre la foto hero
    setTimeout(() => {
      tvBrand.style.transform = 'scaleX(1) scaleY(0.003)';
      tvBrand.style.filter = 'brightness(2.5)';
      setTimeout(() => {
        tvBrand.style.transform = 'scaleX(1) scaleY(1)';
        tvBrand.style.filter = 'brightness(1)';
      }, 250);
    }, 1);

    // Apagado TV estilo analógico (tras 1.5 segundos de exhibición)
    setTimeout(() => {
      tvBrand.style.transform = 'scaleX(1) scaleY(0.003)';
      tvBrand.style.filter = 'brightness(3)';
      setTimeout(() => {
        tvBrand.style.transform = 'scaleX(0) scaleY(0.003)';
        tvBrand.style.opacity = '0';
      }, 200);
    }, 1800);

    // Pantalla negra total y Tanda "The Great Puzzle presenta" (después de 1.5s de pausa)
    setTimeout(() => {
      intro.style.backgroundColor = 'rgba(0, 0, 0, 1)';
      stage1.style.transition = 'opacity 1s ease, transform 1s ease';
      stage1.style.opacity = '1';
      stage1.style.transform = 'translateY(0)';
    }, 3300);

    // Fade out Tanda 1
    setTimeout(() => {
      stage1.style.opacity = '0';
      stage1.style.transform = 'translateY(-15px)';
    }, 5500);

    // TANDA 2: Presentación cinemática rítmica (H2 primero a 7000ms, H1 a 7600ms, Meta lento a 8400ms)
    const introH2 = document.getElementById('tgp-lightbox-intro-h2') as HTMLElement;
    const metaItems = document.querySelectorAll('.tgp-lb-meta-item');
    setTimeout(() => {
      stage2.style.opacity = '1';
      if (introH2) {
        introH2.style.transition = 'opacity 1.4s ease, transform 1.4s ease';
        introH2.style.opacity = '1';
        introH2.style.transform = 'translateY(0)';
      }
    }, 7000);

    setTimeout(() => {
      const introTitle = document.getElementById('tgp-lightbox-intro-title') as HTMLElement;
      if (introTitle) {
        const titleText = introTitle.textContent?.trim() || "";
        const isSingleWord = titleText.length > 0 && titleText.split(/\s+/).length === 1;
        const targetScale = isSingleWord ? 'scale(1.45)' : 'scale(1.04)';
        if (isSingleWord) introTitle.classList.add('is-permanently-iridescent');

        introTitle.style.transition = 'opacity 2.2s ease, transform 2.8s cubic-bezier(0.2, 0.8, 0.2, 1)';
        introTitle.style.opacity = '1';
        introTitle.style.transform = targetScale;
      }
    }, 7600);

    // Presentación muy lenta uno a uno de íconos de metadatos (Spotify/YouTube)
    setTimeout(() => {
      metaItems.forEach((el, idx) => {
        setTimeout(() => {
          (el as HTMLElement).style.transition = 'opacity 1.5s ease, transform 1.5s ease';
          (el as HTMLElement).style.opacity = '1';
          (el as HTMLElement).style.transform = 'translateY(0)';
        }, idx * 500);
      });
    }, 8400);

    // PROLONGADO Y SUAVE DESVANECIMIENTO A BLACK (3.2s duration)
    setTimeout(() => {
      stage2.style.transition = 'opacity 3.2s ease-in-out, transform 3.2s ease-in-out';
      stage2.style.opacity = '0';
      stage2.style.transform = 'scale(1.09)';
    }, 11000);

    // Revelar la imagen totalmente
    setTimeout(() => {
      intro.style.transition = 'opacity 1.8s ease-in-out';
      intro.style.opacity = '0';
      setTimeout(() => {
        intro.style.pointerEvents = 'none';
        if (lightboxImg) {
          lightboxImg.style.transform = 'scale(1)';
        }
      }, 1800);
    }, 13700);
  }

  // Secuencia de Outro Documental (al pasar de la última foto)
  function playOutroSequence() {
    isOutroPlaying = true;
    stopAutoplay();

    // Audio cinemático Deep Sucker Punch / Tail Out para el Outro
    try {
      const audio = new Audio('/outro.cinematic.wav');
      audio.volume = 0.85;
      audio.play().catch(() => {});
    } catch (e) {}
    
    const outro = document.getElementById('tgp-lightbox-outro') as HTMLElement;
    const outroTitle = document.getElementById('tgp-lightbox-outro-title') as HTMLElement;
    const outroTv = document.getElementById('tgp-lightbox-outro-tv') as HTMLElement;
    const outroTvBrand = document.getElementById('tgp-lightbox-outro-tv-brand') as HTMLElement;
    if (!outro || !outroTitle || !outroTv || !outroTvBrand) return;
    
    outroTitle.textContent = postTitle || document.querySelector('h1')?.textContent || 'Registro Visual';
    
    // Init states
    outro.style.transition = 'opacity 1.2s ease';
    outro.style.opacity = '1';
    outro.style.pointerEvents = 'auto';

    outroTitle.style.transition = 'opacity 1.5s ease, transform 2.5s cubic-bezier(0.2, 0.8, 0.2, 1)';
    outroTitle.style.opacity = '0';
    outroTitle.style.transform = 'scale(0.96)';

    outroTv.style.opacity = '0';
    outroTvBrand.style.transition = 'transform 0.35s cubic-bezier(0.1, 0.9, 0.2, 1), opacity 0.35s ease, filter 0.35s ease';
    outroTvBrand.style.transform = 'scaleX(0) scaleY(0.003)';
    outroTvBrand.style.opacity = '0';
    outroTvBrand.style.filter = 'brightness(3)';

    // 1ª TANDA: Título del post con zoom suave Titanio Documental y 3.5s visibilidad
    setTimeout(() => {
      outroTitle.style.opacity = '1';
      outroTitle.style.transform = 'scale(1.04)';
    }, 500);

    // PROLONGADO Y SUAVE DESVANECIMIENTO A BLACK (3.2s duration)
    setTimeout(() => {
      outroTitle.style.transition = 'opacity 3.2s ease-in-out, transform 3.2s ease-in-out';
      outroTitle.style.opacity = '0';
      outroTitle.style.transform = 'scale(1.09)';
    }, 4000);

    // 2ª TANDA: EFECTO TV CRT del brand unido (duración total 2.7s)
    setTimeout(() => {
      outroTv.style.opacity = '1';
      outroTvBrand.style.opacity = '1';
      
      // TV Turn ON (0.6s)
      outroTvBrand.style.transform = 'scaleX(1) scaleY(0.003)';
      outroTvBrand.style.filter = 'brightness(2.5)';
      setTimeout(() => {
        outroTvBrand.style.transform = 'scaleX(1) scaleY(1)';
        outroTvBrand.style.filter = 'brightness(1)';
      }, 300);

      // TV Turn OFF (0.6s) -> 0.6 + 1.8 + 0.6 = 3.0s total!
      setTimeout(() => {
        outroTvBrand.style.transform = 'scaleX(1) scaleY(0.003)';
        outroTvBrand.style.filter = 'brightness(3)';
        setTimeout(() => {
          outroTvBrand.style.transform = 'scaleX(0) scaleY(0.003)';
          outroTvBrand.style.opacity = '0';
        }, 250);
      }, 2100);

    }, 7400);

    // Pausa extendida de 2.0s tras el apagado antes de unir al Loop de inicio
    setTimeout(() => {
      outro.style.opacity = '0';
      outro.style.pointerEvents = 'none';
      isOutroPlaying = false;
      currentIndex = 0;
      if (lightboxImg && images[0]) {
        lightboxImg.src = images[0].src;
        lightboxImg.style.opacity = '1';
        lightboxImg.style.transform = 'scale(1) translateX(0)';
      }
      updateCounter();

      // Loop de unión a la Intro dramática en tandas
      playIntroSequence();
    }, 12500);
  }

  // Pausar autoplay al hacer hover
  lightbox?.addEventListener("mouseenter", () => isPaused = true);
  lightbox?.addEventListener("mouseleave", () => isPaused = false);
  lightbox?.addEventListener("touchstart", () => isPaused = true, { passive: true });
  lightbox?.addEventListener("touchend", () => {
    setTimeout(() => isPaused = false, 2000);
  });

  // --- LÓGICA DE SWIPE TÁCTIL ---
  function handleTouchStart(e: TouchEvent) {
    touchStartX = e.changedTouches[0].screenX;
  }

  function handleTouchEnd(e: TouchEvent) {
    touchEndX = e.changedTouches[0].screenX;
    handleSwipeGesture();
  }

  function handleSwipeGesture() {
    if (images.length <= 1) return;

    const swipeDistance = touchEndX - touchStartX;

    if (Math.abs(swipeDistance) > minSwipeDistance) {
      if (swipeDistance > 0) {
        // Swipe de izquierda a derecha -> Anterior
        showPrev();
      } else {
        // Swipe de derecha a izquierda -> Siguiente
        showNext();
      }
    }
  }

  function initLightbox() {
    // Capturar título del post para el intro/outro
    postTitle = document.querySelector('h1')?.textContent?.trim() || '';
    
    // Detecta todas las imágenes relevantes dentro del contenido, adaptado para Wiki y artículos normales
    images = Array.from(
      document.querySelectorAll(
        ".prose img, article img, main img, #wiki-article-body img",
      ),
    ) as HTMLImageElement[];

    images.forEach((img, idx) => {
      img.style.cursor = "pointer";
      // Remover event listeners previos si existen clonando el nodo o previniendo múltiples bindeos (Astro ViewTransitions)
      img.onclick = (e) => {
        e.preventDefault();
        openLightbox(idx);
      };
    });
  }

  // Event Listeners de Cierre y Navegación
  closeBtn?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (e) => {
    // Cierra solo si haces clic fuera de la imagen (en el fondo)
    if (e.target === lightbox || e.target === container) {
      closeLightbox();
    }
  });
  nextBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    showNext();
  });
  prevBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    showPrev();
  });

  // Event Listeners para Teclado
  window.addEventListener("keydown", (e) => {
    if (lightbox && !lightbox.classList.contains("hidden")) {
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowRight") showNext();
      if (e.key === "ArrowLeft") showPrev();
    }
  });

  // Event Listeners para Swipe (solo en el contenedor de la imagen)
  container?.addEventListener("touchstart", handleTouchStart, {
    passive: true,
  });
  container?.addEventListener("touchend", handleTouchEnd, { passive: true });

  // Inicializar al cargar la página (Soporte para Astro ViewTransitions)
  document.addEventListener("astro:page-load", initLightbox);
  // Inicialización de respaldo
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initLightbox();
  } else {
    document.addEventListener("DOMContentLoaded", initLightbox);
  }
</script>

<style>
  /* Suaviza la transición de opacidad y escala al cambiar de foto, mucho más lento y cinemático */
  #tgp-lightbox-img {
    transition: opacity 1.8s ease-in-out, transform 2.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Animación para que los controles brillen al inicio y luego se apaguen */
  @keyframes presenceFlash {
    0% { opacity: 0; color: transparent; }
    20% { opacity: 1; color: #EFEBE3; }
    70% { opacity: 1; color: #EFEBE3; }
    100% { opacity: 0; color: transparent; }
  }
  
  .flash-presence {
    animation: presenceFlash 2.5s ease-in-out forwards;
  }
</style>
