---
import { Image } from "astro:assets";
import {
  getRelatedCategories,
  formatYear,
  normalizeCategory,
  splitTitleKeyword,
} from "../lib/content-filter";

interface Props {
  slug: string;
  entry: any;
  img?: ImageMetadata | string | null;
  variant?: "hero" | "duo-60" | "duo-40" | "standard";
  enableCinemagraph?: boolean;
  isEager?: boolean;
}

const {
  slug,
  entry,
  img,
  variant = "standard",
  enableCinemagraph = false,
  isEager = false,
} = Astro.props;

const sitio = entry.sitioGeohistorico || null;
const relatedTags = getRelatedCategories(entry.category, sitio, entry.title);
const year = formatYear(entry.date);
const excerpt = entry.excerpt || "";
const href = `/hemeroteca/${slug}`;

// Lógica de ruteo y CTA limpia
let secondaryLabel = "VER REGISTRO";
let secondaryHref = href;
let isExternal = false;

if (entry.youtubeLink) {
  secondaryLabel = "WATCH TRAILER";
  secondaryHref = entry.youtubeLink;
  isExternal = true;
} else if (entry.spotifyLink) {
  secondaryLabel = "AUDIO PODCAST";
  secondaryHref = entry.spotifyLink;
  isExternal = true;
} else if (sitio) {
  secondaryLabel = sitio.toUpperCase();
  secondaryHref = href;
}

// Configuración visual por variante
const isHero = variant === "hero";
const isDuo40 = variant === "duo-40";

const minHeightClass = isHero
  ? "min-h-[460px] sm:min-h-[520px] md:min-h-[560px] lg:min-h-[600px]"
  : isDuo40
    ? "min-h-[380px] sm:min-h-[420px] md:min-h-[450px]"
    : "min-h-[400px] sm:min-h-[440px] md:min-h-[480px]";

const paddingClass = isHero
  ? "p-6 sm:p-8 md:p-12 lg:p-14"
  : isDuo40
    ? "p-5 sm:p-6 md:p-7"
    : "p-5 sm:p-7 md:p-8";

const titleClass = isHero
  ? "text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black leading-[1.12]"
  : isDuo40
    ? "text-lg sm:text-xl md:text-2xl font-extrabold leading-[1.2]"
    : "text-xl sm:text-2xl md:text-3xl font-extrabold leading-[1.16]";

const excerptClass = isHero
  ? "text-xs sm:text-sm md:text-base text-white/80 line-clamp-2 max-w-3xl font-light"
  : isDuo40
    ? "text-[11px] sm:text-xs text-white/70 line-clamp-1 max-w-xl font-light"
    : "text-xs sm:text-sm text-white/75 line-clamp-2 max-w-2xl font-light";

const { prefix: titlePrefix, keyword: titleKeyword } = splitTitleKeyword(
  entry.title || "",
);

const cardGradientClass = isHero ? "gradient-acero-ios" : "gradient-metal-steel-card";
---

<article
  class={`cinematic-archive-card cinematic-card-lantern card-hover-cinematic group relative overflow-hidden rounded-2xl md:rounded-3xl border border-white/5 bg-theme-dark/80 shadow-2xl flex flex-col justify-end w-full transform-gpu isolate ${minHeightClass}`}
  data-category={normalizeCategory(entry.category)}
  data-year={year}
>
  {/* 1. Imagen de fondo */}
  {
    img ? (
      typeof img === 'object' ? (
        <Image
          src={img}
          alt={entry.title || "Dossier del Archivo"}
          format="webp"
          loading={isEager ? "eager" : "lazy"}
          decoding="async"
          quality={80}
          class={`absolute inset-0 w-full h-full object-cover object-center brightness-90 contrast-[1.03] pointer-events-none -z-10 ${
            enableCinemagraph
              ? "cinemagraph-ken-burns"
              : "group-hover:scale-[1.018] group-hover:brightness-95 transition-transform duration-700 delay-75 ease-out"
          }`}
        />
      ) : (
        <img
          src={img as string}
          alt={entry.title || "Dossier del Archivo"}
          loading={isEager ? "eager" : "lazy"}
          decoding="async"
          class={`absolute inset-0 w-full h-full object-cover object-center brightness-90 contrast-[1.03] pointer-events-none -z-10 ${
            enableCinemagraph
              ? "cinemagraph-ken-burns"
              : "group-hover:scale-[1.018] group-hover:brightness-95 transition-transform duration-700 delay-75 ease-out"
          }`}
        />
      )
    ) : (
      <div class="fallback-background absolute inset-0 bg-stone-900 pointer-events-none -z-10" />
    )
  }

  {/* 2. Efecto Dynamis (Solo si está habilitado) */}
  {
    enableCinemagraph && (
      <div class="absolute inset-0 pointer-events-none cinemagraph-dynamis z-0" />
    )
  }

  {/* 3. Gradiente inferior nítido sin desenfoque */}
  <div
    class={`absolute inset-0 bg-linear-to-t from-black/90 via-black/50 via-45% to-transparent pointer-events-none z-10 ${
      enableCinemagraph ? "cinemagraph-museum-fade" : ""
    }`}
  >
  </div>

  {/* 4. Contenido Editorial con z-index superior */}
  <div class={`relative z-20 ${paddingClass} w-full max-w-7xl`}>
    <div class="flex flex-col w-full h-full justify-end">
      
      {/* Excerpt (Arriba de H1, centrado) */}
      {excerpt && (
        <p class={`font-sans leading-relaxed text-center max-w-[66ch] tracking-wider mx-auto mb-4 line-clamp-2 ch-excerpt-container ${excerptClass}`}>
          {excerpt.split(' ').filter((w: string) => w.trim() !== '').map((word: string, i: number) => {
            const isAmber = word.startsWith('**') && word.endsWith('**');
            const cleanWord = isAmber ? word.replace(/\*\*/g, '') : word;
            return (
              <>
                <span class={`ch-excerpt-word ${isAmber ? 'amber-neon' : ''}`} style={`--word-delay: ${3.0 + i * 0.65}s`}>{cleanWord}</span>{" "}
              </>
            );
          })}
        </p>
      )}

      {/* Fila Central: H1 (izq) y CTA (der) */}
      <div class="flex flex-row justify-between items-end w-full border-b border-transparent pb-3 relative z-30 ch-h1-cta">
        <h2 class={`font-cinzel tracking-tight drop-shadow-lg transition-all duration-300 max-w-3xl ch-h1-container ${titleClass}`}>
          <a href={href} class:list={[cardGradientClass, "hover:opacity-90 transition-opacity block"]}>
            {titlePrefix}<span class="title-keyword-shine-fade">{titleKeyword}</span>
          </a>
        </h2>
        
        <div class="relative min-h-10 flex items-center shrink-0 ml-4 pb-1 ch-cta-container">
          <a
            href={secondaryHref}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
            class="ch-cta-btn inline-flex items-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 bg-[#151718]/90 md:backdrop-blur-sm border border-white/10 text-[#E0E0E0]/75 font-metadata font-medium text-xs tracking-widest uppercase rounded-lg hover:bg-white/10 hover:border-white/30 hover:text-white transition-all duration-400 active:translate-y-0.5"
          >
            <span>{secondaryLabel}</span>
            <span class="text-[10px] opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-300">▸</span>
          </a>
        </div>
      </div>

      {/* Tags de Categorías Relacionadas (Debajo del H1/CTA) */}
      {/* F2: text-xs (12px WCAG) + text-white/70. F6: siempre visible, sin hover-reveal */}
      <div class="flex flex-wrap items-center gap-6 mt-3 font-metadata text-xs uppercase tracking-[0.4em] text-white/70 w-full justify-start">
        {relatedTags.map((tag, idx) => (
          <>
            <span class="ch-tag">{tag}</span>
            {idx < relatedTags.length - 1 && (
              <span class="font-bold opacity-50 ch-tag">•</span>
            )}
          </>
        ))}
        {year && (
          <>
            {relatedTags.length > 0 && <span class="font-bold opacity-50 ch-tag">•</span>}
            <span class="ch-tag text-xs text-white/50">{year}</span>
          </>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  /* Se conservan las animaciones intactas */
  @keyframes kenBurnsAscent {
    0% {
      transform: scale(1.02) translateY(2.5%) translateZ(0);
    }
    50% {
      transform: scale(1.08) translateY(0%) translateZ(0);
    }
    100% {
      transform: scale(1.14) translateY(-3%) translateZ(0);
    }
  }

  @keyframes museumFade {
    0% {
      opacity: 0.7;
    }
    50% {
      opacity: 0.9;
    }
    100% {
      opacity: 0.65;
    }
  }

  @keyframes dynamisLoop {
    0% {
      opacity: 0.18;
      transform: scale(1) translateZ(0);
      filter: brightness(1) saturate(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(1.04) translateZ(0);
      filter: brightness(1.12) saturate(1.18);
    }
    100% {
      opacity: 0.22;
      transform: scale(1.01) translateZ(0);
      filter: brightness(1.02) saturate(1.05);
    }
  }

  .cinemagraph-ken-burns {
    animation: kenBurnsAscent 24s cubic-bezier(0.4, 0, 0.6, 1) infinite
      alternate;
    will-change: transform;
    transform-origin: center center;
    /* Ancla esta capa en GPU para evitar Z-fighting con el texto animado */
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .cinemagraph-museum-fade {
    animation: museumFade 14s ease-in-out infinite alternate;
  }

  .cinemagraph-dynamis {
    background: radial-gradient(
      circle at 45% 45%,
      rgba(239, 235, 227, 0.25) 0%,
      rgba(74, 59, 50, 0.12) 45%,
      transparent 70%
    );
    mix-blend-mode: screen;
    animation: dynamisLoop 16s ease-in-out infinite alternate;
    will-change: transform, opacity, filter;
    /* Ancla el dynamis en su propia capa para que no compita con el texto */
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .cinemagraph-ken-burns,
    .cinemagraph-museum-fade,
    .cinemagraph-dynamis {
      animation: none !important;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const runCardSequence = (card: HTMLElement): Promise<void> => {
    return new Promise((resolve) => {
      if (card.dataset.choreographyDone === "true") {
        resolve();
        return;
      }
      card.dataset.choreographyDone = "true";
      card.classList.add("choreography-active");

      const h1Container = card.querySelector<HTMLElement>(".ch-h1-container");
      const ctaBtn = card.querySelector<HTMLElement>(".ch-cta-btn");
      const excerptContainer = card.querySelector<HTMLElement>(".ch-excerpt-container");
      const words = Array.from(card.querySelectorAll<HTMLElement>(".ch-excerpt-word"));
      const tags = Array.from(card.querySelectorAll<HTMLElement>(".ch-tag"));

      const tl = gsap.timeline({
        onComplete: () => {
          // Reactivar el sweep del gradiente (pausado por CSS) ahora que
          // la tarjeta está estable — evita Z-fighting durante la animación
          card.classList.add('card-settled');
          resolve();
        },
      });

      // ── 1. Pase 1 del Metal Sweep (Inicio Rápido) + Tags pulse ──
      if (ctaBtn) {
        ctaBtn.classList.remove("sweep-fast", "sweep-slow");
        void ctaBtn.offsetWidth;
        ctaBtn.classList.add("sweep-fast");
      }

      if (tags.length) {
        tl.fromTo(
          tags,
          { opacity: 0, filter: "blur(2px)" },
          { opacity: 1, filter: "blur(0px)", duration: 0.8, stagger: 0.04, ease: "power2.out" },
          0
        ).to(tags, { opacity: 0.7, duration: 0.6 }, 0.8);
      }

      // ── 2. H1 zoom-out para ceder el escenario al excerpt ──
      if (h1Container) {
        tl.to(
          h1Container,
          {
            scale: 1.10,
            y: -4,
            filter: "blur(10px)",
            opacity: 0,
            duration: 1.2,
            ease: "power2.inOut",
            force3D: true, // GPU path para evitar parpadeos en mobile
          },
          0.5
        );
      }

      // ── 3. Excerpt escribe palabra por palabra con TypeMagic ──
      if (excerptContainer && words.length) {
        tl.set(excerptContainer, { opacity: 1 }, 1.6);
        tl.set(words, { opacity: 0, filter: "blur(14px)", y: 6 });

        // Cada palabra emerge pausadamente con su gradiente y desenfoque
        tl.to(
          words,
          {
            opacity: 1,
            filter: "blur(0px)",
            y: 0,
            duration: 0.7,
            stagger: 0.45,
            ease: "power2.out",
          },
          1.8
        );

        // ── 4. Pausa de lectura completa tras aparecer la ÚLTIMA palabra ──
        tl.to({}, { duration: 3.5 });

        // ── 5. Disolución fluida del excerpt completo (gota en medio denso) ──
        tl.to(words, {
          opacity: 0,
          filter: "blur(10px)",
          scale: 0.95,
          y: -6,
          duration: 1.4,
          ease: "power2.inOut",
        });
      }

      // ── 6. ¡SOLO CUANDO EL EXCERPT TERMINÓ Y SE DISOLVIÓ! ──
      // Re-escritura y materialización líquida TypeMagic del H1
      if (h1Container) {
        tl.fromTo(
          h1Container,
          { opacity: 0, filter: "blur(16px)", scale: 0.97, y: 8 },
          { opacity: 1, filter: "blur(0px)", scale: 1, y: 0, duration: 1.8, ease: "power3.out", force3D: true } // GPU path
        );
      }

      // ── 7. Pase 2 del Metal Sweep (ULTRA LENTO) en el CTA ──
      if (ctaBtn) {
        tl.add(() => {
          ctaBtn.classList.remove("sweep-fast", "sweep-slow");
          void ctaBtn.offsetWidth;
          ctaBtn.classList.add("sweep-slow");
        }, "-=0.8");
      }

      // Margen final de reposo antes de dar paso a la siguiente tarjeta
      tl.to({}, { duration: 3.2 });
    });
  };

  const initChoreography = () => {
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".cinematic-archive-card"));

    // Hover manual directo
    cards.forEach((card) => {
      card.addEventListener(
        "mouseenter",
        () => {
          if (card.dataset.choreographyDone !== "true") {
            runCardSequence(card);
          }
        },
        { once: true }
      );
    });

    // Observer secuencial: una por una, esperando a que termine cada tarjeta
    const queue: HTMLElement[] = [];
    let isRunning = false;

    const processNext = async () => {
      if (isRunning || queue.length === 0) return;
      isRunning = true;
      const nextCard = queue.shift();
      if (nextCard && nextCard.dataset.choreographyDone !== "true") {
        await runCardSequence(nextCard);
      }
      isRunning = false;
      processNext();
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const card = entry.target as HTMLElement;
            if (card.dataset.choreographyDone !== "true" && !queue.includes(card)) {
              queue.push(card);
              processNext();
            }
            observer.unobserve(card);
          }
        });
      },
      { threshold: 0.3 }
    );

    cards.forEach((card) => {
      if (card.dataset.choreographyDone !== "true") {
        observer.observe(card);
      }
    });
  };

  document.addEventListener("astro:page-load", initChoreography);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initChoreography();
  } else {
    document.addEventListener("DOMContentLoaded", initChoreography);
  }
</script>
