---
import Image from './SafeImage.astro';
import {
  getRelatedCategories,
  formatYear,
  normalizeCategory,
  splitTitleKeyword,
  sanitizeImageUrl,
} from "../lib/content-filter";

interface Props {
  slug: string;
  entry: any;
  img?: ImageMetadata | string | null;
  variant?: "hero" | "duo-60" | "duo-40" | "standard";
  enableCinemagraph?: boolean;
  isEager?: boolean;
  href?: string;
  isCinematicGSAP?: boolean;
}

const {
  slug,
  entry,
  img,
  variant = "standard",
  enableCinemagraph = false,
  isEager = false,
  href: customHref,
  isCinematicGSAP = false,
} = Astro.props;

const safeImg = sanitizeImageUrl(img);
const sitio = entry.sitioGeohistorico || null;
const relatedTags = getRelatedCategories(entry.category, sitio, entry.title);
const year = formatYear(entry.date);
const dek = entry.dek || entry.excerpt || null;
const cleanExcerpt = (entry.excerpt || entry.dek || "").replace(/\*\*/g, "").trim();

const isCinematic = isCinematicGSAP || (entry as any)?.isCinematicGSAP || entry.category === 'Ensayos Cinemáticos' || entry.category === 'ensayos-cinematicos' || normalizeCategory(entry.category) === 'ensayos-cinematicos';
const href = customHref || (isCinematic ? `/ensayos-cinematicos/${slug}/` : `/hemeroteca/${slug}/`);

// Lógica de ruteo y CTA limpia
let secondaryLabel = "VER REGISTRO";
let secondaryHref = href;
let isExternal = false;

if (entry.youtubeLink) {
  secondaryLabel = "WATCH TRAILER";
  secondaryHref = entry.youtubeLink;
  isExternal = true;
} else if (entry.spotifyLink) {
  secondaryLabel = "AUDIO PODCAST";
  secondaryHref = entry.spotifyLink;
  isExternal = true;
} else if (sitio) {
  secondaryLabel = sitio.toUpperCase();
  secondaryHref = href;
}

// Configuración visual por variante
const isHero = variant === "hero";
const isDuo40 = variant === "duo-40";

// Relación de aspecto de la imagen según variante
const imageAspectClass = isHero
  ? "aspect-video sm:aspect-21/9"
  : isDuo40
    ? "aspect-[4/3] sm:aspect-16/10"
    : "aspect-[4/3] sm:aspect-video";

// Tamaño tipográfico del H1 interior (+1px global para máxima presencia)
const titleClass = isHero
  ? "text-[1.65rem] sm:text-3xl md:text-4xl lg:text-[3.25rem] font-black leading-[1.12]"
  : isDuo40
    ? "text-[1.2rem] sm:text-[1.4rem] md:text-[1.65rem] font-extrabold leading-[1.2]"
    : "text-[1.35rem] sm:text-[1.65rem] md:text-[2rem] font-extrabold leading-[1.16]";

const excerptClass = isHero
  ? "text-xs sm:text-sm md:text-base text-white/90 line-clamp-2 max-w-3xl font-light"
  : isDuo40
    ? "text-[11px] sm:text-xs text-white/80 line-clamp-1 max-w-xl font-light"
    : "text-xs sm:text-sm text-white/85 line-clamp-2 max-w-2xl font-light";

const { prefix: titlePrefix, keyword: titleKeyword } = splitTitleKeyword(
  entry.title || "",
);

// Mapeo dinámico de acento según categoría / themeColor heredado
const categoryAccentClass = (() => {
  const t = (entry.themeColor || '').toLowerCase();
  const c = (entry.category || '').toLowerCase();
  if (t === 'bordeaux' || c.includes('mitolog') || c.includes('simbol')) return 'text-[#df7a7e]';
  if (t === 'british-green' || c.includes('historia antigua') || c.includes('prehistoria')) return 'text-[#68b68f]';
  if (t === 'old-navy' || c.includes('filosof') || c.includes('gnos')) return 'text-[#8ab7e0]';
  if (t === 'vintage-yellow' || c.includes('arte') || c.includes('arquitectura')) return 'text-[#f0e2a8]';
  if (t === 'rust-orange' || c.includes('arquetip') || c.includes('arqueosemi') || c.includes('georref')) return 'text-rust-orange';
  return 'text-rust-orange';
})();

const cardGradientClass = isHero ? "gradient-acero-ios" : "gradient-metal-steel-card";
---

<article
  class={`cinematic-archive-card flex flex-col gap-4 group w-full h-full`}
  data-category={normalizeCategory(entry.category)}
  data-year={year}
>
  {/* 1. IMAGEN SUPERIOR CON H1 INTERIOR (CON CINZEL STEEL GRADIENT + GSAP FADE IN) */}
  <a
    href={href}
    class={`relative w-full ${imageAspectClass} rounded-xl md:rounded-2xl overflow-hidden block bg-stone-900/60 border border-white/10 shadow-xl shrink-0`}
  >
    {
      safeImg ? (
        <Image
          src={safeImg}
          alt={entry.title || "Dossier del Archivo"}
          inferSize={true}
          format="webp"
          widths={[400, 768, 1200, 1920]}
          sizes="(max-width: 768px) 400px, (max-width: 1200px) 768px, 1200px"
          loading={isEager ? "eager" : "lazy"}
          fetchpriority={isEager ? "high" : undefined}
          decoding="async"
          class={`w-full h-full object-cover object-center brightness-90 group-hover:brightness-100 transition-transform duration-700 ease-out group-hover:scale-[1.04] ${
            enableCinemagraph ? "cinemagraph-ken-burns" : ""
          }`}
        />
      ) : (
        <div class="w-full h-full bg-stone-900 flex items-center justify-center text-stone-600 font-metadata text-xs uppercase tracking-widest">
          Sin imagen
        </div>
      )
    }

    {/* Dynamis overlay sutil */}
    {
      enableCinemagraph && (
        <div class="absolute inset-0 pointer-events-none cinemagraph-dynamis z-0" />
      )
    }

    {/* Scrim gradiente inferior suave para contraste óptimo */}
    <div
      class="absolute inset-0 pointer-events-none z-10"
      style="background: linear-gradient(to top, rgba(12,10,9,0.92) 0%, rgba(12,10,9,0.45) 45%, transparent 100%);"
    >
    </div>

    {/* ✦ H1 INTERIOR DENTRO DE LA CARD (Con Cinzel Steel Gradient + GSAP Fade In) */}
    <div class="absolute inset-0 z-20 flex flex-col justify-end p-4 sm:p-6 md:p-8 pointer-events-none">
      {cleanExcerpt && (
        <p class={`font-sans leading-relaxed text-left max-w-[66ch] tracking-wider mb-2 line-clamp-2 ch-excerpt-container opacity-0 ${excerptClass}`}>
          <span class="ch-excerpt-line inline-block">{cleanExcerpt}</span>
        </p>
      )}

      <h2 class={`font-cinzel tracking-tight drop-shadow-xl transition-all duration-300 ch-h1-container ${titleClass}`}>
        <span class:list={[cardGradientClass, "block"]}>
          {titlePrefix}<span class="title-keyword-shine-fade">{titleKeyword}</span>
        </span>
      </h2>
    </div>
  </a>

  {/* 2. BLOQUE DE TEXTO EDITORIAL EXTERIOR (ESTILO NAUTILUS) */}
  <div class="flex flex-col w-full grow pt-1">
    {/* Categoría y Tags con Color Heredado */}
    <div class="flex flex-wrap items-center gap-2 mb-2 font-metadata text-[10px] md:text-[11px] uppercase tracking-[0.25em] text-stone-400">
      <span class={`${categoryAccentClass} font-semibold`}>
        {entry.category ? entry.category.toUpperCase() : 'ARCHIVO'}
      </span>
      {sitio && (
        <>
          <span class="opacity-40">•</span>
          <span class="text-stone-400">{sitio}</span>
        </>
      )}
      {year && (
        <>
          <span class="opacity-40">•</span>
          <span class="text-stone-500">{year}</span>
        </>
      )}
    </div>

    {/* Fila: Título Exterior con Steel Gradient Heredado y CTA */}
    <div class="flex flex-row justify-between items-start gap-4 mb-2 ch-h1-cta">
      <a href={href} class="hover:opacity-80 transition-opacity block flex-1">
        <h3 class={`font-cinzel font-bold text-lg sm:text-xl md:text-2xl tracking-tight leading-snug ${cardGradientClass}`}>
          {titlePrefix}<span class="title-keyword-shine-fade">{titleKeyword}</span>
        </h3>
      </a>

      <div class="relative flex items-center shrink-0 ch-cta-container">
        <a
          href={secondaryHref}
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener noreferrer" : undefined}
          class="ch-cta-btn inline-flex items-center gap-2 px-3 sm:px-4 py-2 bg-white/5 border border-white/15 text-stone-300 font-metadata font-medium text-xs tracking-wider uppercase rounded-lg hover:bg-white/15 hover:border-white/30 hover:text-white transition-all duration-300 active:translate-y-0.5 whitespace-nowrap"
        >
          <span>{secondaryLabel}</span>
          <span class="text-[10px] opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-300">&#9656;</span>
        </a>
      </div>
    </div>

    {dek && (
      <p class="card-dek ch-dek-container font-serif text-xs md:text-sm text-stone-300 leading-relaxed tracking-wide line-clamp-2 md:line-clamp-3 mb-2 max-w-[56ch]">
        {dek}
      </p>
    )}

    {/* Tags de Categorías Relacionadas */}
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-1 font-metadata text-[10px] uppercase tracking-[0.3em] text-white/50 w-full justify-start">
      {relatedTags.map((tag, idx) => (
        <>
          <span class="ch-tag">{tag}</span>
          {idx < relatedTags.length - 1 && (
            <span class="font-bold opacity-40 ch-tag">•</span>
          )}
        </>
      ))}
      {year && (
        <>
          {relatedTags.length > 0 && <span class="font-bold opacity-40 ch-tag">•</span>}
          <span class="ch-tag text-[10px] text-white/40">{year}</span>
        </>
      )}
    </div>
  </div>
</article>

<style>
  /* ─────────────────────────────────────────────────────────────
   * DEK — Bajada Editorial
   * ───────────────────────────────────────────────────────────── */
  .card-dek {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 300ms ease-out, transform 300ms ease-out;
  }

  /* Ken Burns para la imagen interna */
  @keyframes kenBurnsAscent {
    0% {
      transform: scale(1.02) translateY(2.5%) translateZ(0);
    }
    50% {
      transform: scale(1.08) translateY(0%) translateZ(0);
    }
    100% {
      transform: scale(1.14) translateY(-3%) translateZ(0);
    }
  }

  @keyframes dynamisLoop {
    0% {
      opacity: 0.18;
      transform: scale(1) translateZ(0);
      filter: brightness(1) saturate(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(1.04) translateZ(0);
      filter: brightness(1.12) saturate(1.18);
    }
    100% {
      opacity: 0.22;
      transform: scale(1.01) translateZ(0);
      filter: brightness(1.02) saturate(1.05);
    }
  }

  .cinemagraph-ken-burns {
    animation: kenBurnsAscent 24s cubic-bezier(0.4, 0, 0.6, 1) infinite alternate;
    will-change: transform;
    transform-origin: center center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .cinemagraph-dynamis {
    background: radial-gradient(
      circle at 45% 45%,
      rgba(239, 235, 227, 0.25) 0%,
      rgba(74, 59, 50, 0.12) 45%,
      transparent 70%
    );
    mix-blend-mode: screen;
    animation: dynamisLoop 16s ease-in-out infinite alternate;
    will-change: transform, opacity, filter;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .cinemagraph-ken-burns,
    .cinemagraph-dynamis {
      animation: none !important;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const runCardSequence = (card: HTMLElement): Promise<void> => {
    return new Promise((resolve) => {
      if (card.dataset.choreographyDone === "true") {
        resolve();
        return;
      }
      card.dataset.choreographyDone = "true";
      card.classList.add("choreography-active");

      const h1Container = card.querySelector<HTMLElement>(".ch-h1-container");
      const ctaBtn = card.querySelector<HTMLElement>(".ch-cta-btn");
      const excerptContainer = card.querySelector<HTMLElement>(".ch-excerpt-container");
      const dekContainer = card.querySelector<HTMLElement>(".ch-dek-container");
      const tags = Array.from(card.querySelectorAll<HTMLElement>(".ch-tag"));

      const tl = gsap.timeline({
        onComplete: () => {
          card.classList.add('card-settled');
          resolve();
        },
      });

      // ── 1. Pase 1 del Metal Sweep (Inicio Rápido) + Tags pulse ──
      if (ctaBtn) {
        ctaBtn.classList.remove("sweep-fast", "sweep-slow");
        void ctaBtn.offsetWidth;
        ctaBtn.classList.add("sweep-fast");
      }

      if (tags.length) {
        tl.fromTo(
          tags,
          { opacity: 0, filter: "blur(2px)" },
          { opacity: 1, filter: "blur(0px)", duration: 0.6, stagger: 0.03, ease: "power2.out" },
          0
        ).to(tags, { opacity: 0.7, duration: 0.4 }, 0.6);
      }

      // ── 2. H1 zoom-out para ceder el escenario al excerpt ──
      if (h1Container && excerptContainer) {
        tl.to(
          h1Container,
          {
            scale: 1.06,
            y: -4,
            filter: "blur(8px)",
            opacity: 0,
            duration: 0.9,
            ease: "power2.inOut",
            force3D: true,
          },
          0.3
        );
      }

      // ── 3. Excerpt escribe toda la línea a la vez (Línea por línea rápida y fluida) ──
      if (excerptContainer) {
        tl.fromTo(
          excerptContainer,
          { opacity: 0, filter: "blur(12px)", y: 8 },
          {
            opacity: 1,
            filter: "blur(0px)",
            y: 0,
            duration: 0.8,
            ease: "power3.out",
          },
          0.8
        );

        // ── 4. Pausa de lectura completa ──
        tl.to({}, { duration: 2.8 });

        // ── 5. Disolución fluida del excerpt ──
        tl.to(excerptContainer, {
          opacity: 0,
          filter: "blur(10px)",
          scale: 0.98,
          y: -4,
          duration: 0.8,
          ease: "power2.inOut",
        });
      }

      // ── 6. Re-materialización líquida del H1 ──
      if (h1Container) {
        tl.fromTo(
          h1Container,
          { opacity: 0, filter: "blur(14px)", scale: 0.98, y: 6 },
          { opacity: 1, filter: "blur(0px)", scale: 1, y: 0, duration: 1.2, ease: "power3.out", force3D: true },
          excerptContainer ? "-=0.2" : "0"
        );
      }

      // ── 7. Dek exterior: revelado suave y presencia visual ──
      if (dekContainer) {
        tl.fromTo(
          dekContainer,
          { opacity: 0.7, y: 2 },
          { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
          0.4
        );
      }

      // ── 8. Pase 2 del Metal Sweep (ULTRA LENTO) en el CTA ──
      if (ctaBtn) {
        tl.add(() => {
          ctaBtn.classList.remove("sweep-fast", "sweep-slow");
          void ctaBtn.offsetWidth;
          ctaBtn.classList.add("sweep-slow");
        }, "-=0.6");
      }

      // Margen final de reposo
      tl.to({}, { duration: 2.5 });
    });
  };

  const initChoreography = () => {
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".cinematic-archive-card"));
    if (cards.length === 0) return;

    /* ── Aislamiento de GSAP con matchMedia (Solo Desktop: min-width: 768px) ── */
    const mm = gsap.matchMedia();

    mm.add("(min-width: 768px)", () => {
      // Hover manual directo
      cards.forEach((card) => {
        card.addEventListener(
          "mouseenter",
          () => {
            if (card.dataset.choreographyDone !== "true") {
              runCardSequence(card);
            }
          },
          { once: true }
        );
      });

      // Observer secuencial
      const queue: HTMLElement[] = [];
      let isRunning = false;

      const processNext = async () => {
        if (isRunning || queue.length === 0) return;
        isRunning = true;
        const nextCard = queue.shift();
        if (nextCard && nextCard.dataset.choreographyDone !== "true") {
          await runCardSequence(nextCard);
        }
        isRunning = false;
        processNext();
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const card = entry.target as HTMLElement;
              if (card.dataset.choreographyDone !== "true" && !queue.includes(card)) {
                queue.push(card);
                processNext();
              }
              observer.unobserve(card);
            }
          });
        },
        { threshold: 0.3 }
      );

      cards.forEach((card) => {
        if (card.dataset.choreographyDone !== "true") {
          observer.observe(card);
        }
      });

      return () => {
        observer.disconnect();
      };
    });
  };

  document.addEventListener("astro:page-load", initChoreography);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initChoreography();
  } else {
    document.addEventListener("DOMContentLoaded", initChoreography);
  }
</script>
