---
import Image from './SafeImage.astro';
import ExpandableModal from './ExpandableModal.astro';
import {
  getRelatedCategories,
  formatYear,
  normalizeCategory,
  splitTitleKeyword,
  sanitizeImageUrl,
} from "../lib/content-filter";

interface Props {
  slug: string;
  entry: any;
  img?: ImageMetadata | string | null;
  variant?: "hero" | "duo-60" | "duo-40" | "standard";
  enableCinemagraph?: boolean;
  isEager?: boolean;
  href?: string;
  isCinematicGSAP?: boolean;
  hideExteriorTitle?: boolean;
  centerCtaBelow?: boolean;
  ctaLabel?: string;
}

const {
  slug,
  entry,
  img,
  variant = "standard",
  enableCinemagraph = false,
  isEager = false,
  href: customHref,
  isCinematicGSAP = false,
  hideExteriorTitle = false,
  centerCtaBelow = false,
  ctaLabel,
} = Astro.props;

const safeImg = sanitizeImageUrl(img);
const sitio = entry.sitioGeohistorico || null;
const relatedTags = getRelatedCategories(entry.category, sitio, entry.title);
const year = formatYear(entry.date);
const dek = entry.dek || entry.excerpt || null;
const cleanExcerpt = (entry.excerpt || entry.dek || "").replace(/\*\*/g, "").trim();

const isCinematic = isCinematicGSAP || (entry as any)?.isCinematicGSAP || entry.category === 'Ensayos Cinemáticos' || entry.category === 'ensayos-cinematicos' || normalizeCategory(entry.category) === 'ensayos-cinematicos';
const href = customHref || (isCinematic ? `/ensayos-cinematicos/${slug}/` : `/hemeroteca/${slug}/`);

// Lógica de ruteo y CTA limpia
let secondaryLabel = "VER REGISTRO";
let secondaryHref = href;
let isExternal = false;

if (entry.youtubeLink) {
  secondaryLabel = "WATCH TRAILER";
  secondaryHref = entry.youtubeLink;
  isExternal = true;
} else if (entry.spotifyLink) {
  secondaryLabel = "AUDIO PODCAST";
  secondaryHref = entry.spotifyLink;
  isExternal = true;
} else if (sitio) {
  secondaryLabel = sitio.toUpperCase();
  secondaryHref = href;
}

// Configuración visual por variante
const isHero = variant === "hero";
const isDuo40 = variant === "duo-40";

// Relación de aspecto de la imagen según variante
const imageAspectClass = isHero
  ? "aspect-[4/3] sm:aspect-[16/10] md:aspect-video lg:aspect-[16/7]"
  : isDuo40
    ? "aspect-[4/3] sm:aspect-16/10"
    : "aspect-[4/3] sm:aspect-video";

// Tamaño tipográfico del H1 interior (+1px global para máxima presencia)
const titleClass = isHero
  ? "text-[1.65rem] sm:text-3xl md:text-4xl lg:text-[3.25rem] font-black leading-[1.12]"
  : isDuo40
    ? "text-[1.2rem] sm:text-[1.4rem] md:text-[1.65rem] font-extrabold leading-[1.2]"
    : "text-[1.35rem] sm:text-[1.65rem] md:text-[2rem] font-extrabold leading-[1.16]";

const excerptClass = isHero
  ? "text-xs sm:text-sm md:text-base text-white/90 line-clamp-2 max-w-3xl font-light"
  : isDuo40
    ? "text-[11px] sm:text-xs text-white/80 line-clamp-1 max-w-xl font-light"
    : "text-xs sm:text-sm text-white/85 line-clamp-2 max-w-2xl font-light";

const { prefix: titlePrefix, keyword: titleKeyword } = splitTitleKeyword(
  entry.title || "",
);

// Mapeo dinámico de acento según categoría / themeColor heredado
const categoryAccentClass = (() => {
  const t = (entry.themeColor || '').toLowerCase();
  const c = (entry.category || '').toLowerCase();
  if (t === 'bordeaux' || c.includes('mitolog') || c.includes('simbol')) return 'text-[#df7a7e]';
  if (t === 'british-green' || c.includes('historia antigua') || c.includes('prehistoria')) return 'text-[#68b68f]';
  if (t === 'old-navy' || c.includes('filosof') || c.includes('gnos')) return 'text-[#8ab7e0]';
  if (t === 'vintage-yellow' || c.includes('arte') || c.includes('arquitectura')) return 'text-[#f0e2a8]';
  if (t === 'rust-orange' || c.includes('arquetip') || c.includes('arqueosemi') || c.includes('georref')) return 'text-rust-orange';
  return 'text-rust-orange';
})();

const cardGradientClass = isHero ? "gradient-acero-ios" : "gradient-metal-steel-card";
const cardId = `cac-${slug || 'item'}-${Math.random().toString(36).substring(2, 7)}`;
const imgUrl = safeImg || '';
---

<article
  class={`cinematic-archive-card flex flex-col gap-4 group w-full h-full`}
  data-category={normalizeCategory(entry.category)}
  data-year={year}
  data-card-id={cardId}
  data-title={entry.title || ''}
  data-eyebrow={entry.category ? entry.category.toUpperCase() : 'ARCHIVO'}
  data-excerpt={cleanExcerpt || dek || ''}
  data-image={imgUrl}
  data-link={href}
  data-flip-id={`card-container-${cardId}`}
>
  {/* 1. IMAGEN SUPERIOR CON H1 INTERIOR (CON CINZEL STEEL GRADIENT + GSAP FADE IN) */}
  <a
    href={href}
    class={`relative w-full ${imageAspectClass} rounded-xl md:rounded-2xl overflow-hidden block bg-stone-900/60 border border-white/10 shadow-xl shrink-0 cac-modal-trigger`}
  >
    {
      safeImg ? (
        <Image
          src={safeImg}
          alt={entry.title || "Dossier del Archivo"}
          inferSize={true}
          format="webp"
          widths={[400, 768, 1200, 1920]}
          sizes="(max-width: 768px) 400px, (max-width: 1200px) 768px, 1200px"
          loading={isEager ? "eager" : "lazy"}
          fetchpriority={isEager ? "high" : undefined}
          decoding="async"
          class={`w-full h-full object-cover object-center brightness-90 group-hover:brightness-100 transition-transform duration-700 ease-out group-hover:scale-[1.04] cac-card-img ${
            enableCinemagraph ? "cinemagraph-ken-burns" : ""
          }`}
          data-flip-id={`card-image-${cardId}`}
        />
      ) : (
        <div class="w-full h-full bg-stone-900 flex items-center justify-center text-stone-600 font-metadata text-xs uppercase tracking-widest">
          Sin imagen
        </div>
      )
    }

    {/* Dynamis overlay sutil */}
    {
      enableCinemagraph && (
        <div class="absolute inset-0 pointer-events-none cinemagraph-dynamis z-0" />
      )
    }

    {/* Scrim gradiente inferior suave para contraste óptimo */}
    <div
      class="absolute inset-0 pointer-events-none z-10"
      style="background: linear-gradient(to top, rgba(12,10,9,0.92) 0%, rgba(12,10,9,0.45) 45%, transparent 100%);"
    >
    </div>

    {/* ✦ H1 INTERIOR DENTRO DE LA CARD (Con Cinzel Steel Gradient + GSAP Fade In) */}
    <div class={`absolute inset-0 z-20 flex flex-col justify-end p-4 sm:p-6 md:p-8 pointer-events-none ${hideExteriorTitle ? 'items-center text-center pb-8 sm:pb-12' : 'items-start text-left'}`}>
      {cleanExcerpt && (
        <p class={`font-sans leading-relaxed max-w-[66ch] tracking-wider mb-2 line-clamp-2 ch-excerpt-container opacity-0 ${hideExteriorTitle ? 'text-center mx-auto' : 'text-left'} ${excerptClass}`}>
          <span class="ch-excerpt-line inline-block">{cleanExcerpt}</span>
        </p>
      )}

      <h2 class={`font-cinzel tracking-tight drop-shadow-xl transition-all duration-300 ch-h1-container cac-card-title ${hideExteriorTitle ? 'text-center w-full mx-auto' : ''} ${titleClass}`} data-flip-id={`card-title-${cardId}`}>
        <span class:list={[cardGradientClass, "block", hideExteriorTitle ? "text-center mx-auto" : ""]}>
          {titlePrefix}<span class="title-keyword-shine-fade">{titleKeyword}</span>
        </span>
      </h2>
    </div>
  </a>

  {/* 2. BLOQUE DE TEXTO EDITORIAL EXTERIOR (ESTILO NAUTILUS / EDITORIAL COVER) */}
  <div class={`flex flex-col w-full grow ${hideExteriorTitle ? 'pt-6 sm:pt-8 items-center text-center' : 'pt-1'}`}>
    {/* En modo normal: Categoría y Tags arriba */}
    {!hideExteriorTitle && (
      <div class="flex flex-wrap items-center gap-2 mb-2 font-metadata text-[10px] md:text-[11px] uppercase tracking-[0.25em] text-stone-400">
        <span class={`${categoryAccentClass} font-semibold`}>
          {entry.category ? entry.category.toUpperCase() : 'ARCHIVO'}
        </span>
        {sitio && (
          <>
            <span class="opacity-40">•</span>
            <span class="text-stone-400">{sitio}</span>
          </>
        )}
        {year && (
          <>
            <span class="opacity-40">•</span>
            <span class="text-stone-500">{year}</span>
          </>
        )}
      </div>
    )}

    {/* Fila: Título Exterior con Steel Gradient Heredado y CTA (Oculto si hideExteriorTitle) */}
    {!hideExteriorTitle && (
      <div class="flex flex-row justify-between items-start gap-4 mb-2 ch-h1-cta">
        <a href={href} class="hover:opacity-80 transition-opacity block flex-1 cac-modal-trigger">
          <h3 class={`font-cinzel font-extrabold text-lg sm:text-xl md:text-2xl tracking-tighter leading-snug cac-card-title ${cardGradientClass}`}>
            {titlePrefix}<span class="title-keyword-shine-fade">{titleKeyword}</span>
          </h3>
        </a>

        <div class="relative flex items-center shrink-0 ch-cta-container">
          <a
            href={secondaryHref}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
            class={`ch-cta-btn inline-flex items-center gap-2 px-3 sm:px-4 py-2 bg-white/5 border border-white/15 text-stone-300 font-metadata font-medium text-xs tracking-wider uppercase rounded-lg hover:bg-white/15 hover:border-white/30 hover:text-white transition-all duration-300 active:translate-y-0.5 whitespace-nowrap ${!isExternal ? 'cac-modal-trigger' : ''}`}
          >
            <span>{secondaryLabel}</span>
            <span class="text-[10px] opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-300">&#9656;</span>
          </a>
        </div>
      </div>
    )}

    {/* Excerpt con estilo Cartelera de Cine */}
    {dek && (
      <p class={`card-dek ch-dek-container ${hideExteriorTitle ? 'font-serif text-lg sm:text-xl md:text-2xl text-[#EFEBE3]/95 leading-relaxed tracking-wide max-w-4xl text-center mb-10 sm:mb-14 mx-auto drop-shadow-lg' : 'font-sans text-xs sm:text-sm md:text-base text-[#E3DDD3]/85 leading-relaxed tracking-normal mb-4 sm:mb-5 max-w-[56ch]'}`}>
        {dek}
      </p>
    )}

    {/* Tags de Categorías y Metadatos en color default — separación limpia respecto al excerpt en modo cinemático */}
    <div class={`flex flex-wrap items-center gap-x-4 gap-y-1.5 font-metadata text-[10px] sm:text-[11px] uppercase tracking-[0.25em] text-white/50 w-full ${hideExteriorTitle ? 'justify-center pt-6 sm:pt-8 border-t border-white/10 mx-auto max-w-xl' : 'justify-start'}`}>
      {entry.category && (
        <span class="ch-tag">{entry.category.toUpperCase()}</span>
      )}
      {sitio && (
        <>
          <span class="font-bold opacity-40 ch-tag">•</span>
          <span class="ch-tag">{sitio}</span>
        </>
      )}
      {relatedTags.map((tag) => (
        <>
          <span class="font-bold opacity-40 ch-tag">•</span>
          <span class="ch-tag">{tag}</span>
        </>
      ))}
      {year && (
        <>
          <span class="font-bold opacity-40 ch-tag">•</span>
          <span class="ch-tag text-white/40">{year}</span>
        </>
      )}
    </div>

    {/* Botón CTA Grande Centrado "VER REGISTRO" / "VER MÁS" con amplio aire */}
    {centerCtaBelow && (
      <div class="flex justify-center mt-14 sm:mt-20 md:mt-24 mb-16 sm:mb-24 md:mb-28">
        <a
          href={secondaryHref}
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener noreferrer" : undefined}
          class={`group relative inline-flex items-center justify-center gap-4 px-10 sm:px-14 py-4 sm:py-5 rounded-full bg-transparent border border-[#E3DDD3]/25 text-[#EFEBE3] font-metadata font-bold text-[10.5px] sm:text-xs uppercase tracking-[0.35em] backdrop-blur-md shadow-[0_0_30px_-5px_rgba(255,255,255,0.05)] hover:bg-[#EFEBE3]/10 hover:border-[#EFEBE3]/50 hover:shadow-[0_0_40px_-5px_rgba(227,221,211,0.2)] hover:scale-[1.02] active:scale-95 transition-all duration-500 overflow-hidden ${!isExternal ? 'cac-modal-trigger' : ''}`}
        >
          {/* Brillo interno cinematico */}
          <div class="absolute inset-0 bg-linear-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:animate-[shimmer_1.5s_infinite] pointer-events-none" />
          <span class="relative z-10">{ctaLabel || secondaryLabel}</span>
          <span class="relative z-10 text-[10px] sm:text-xs transition-transform duration-500 group-hover:translate-x-1.5">&#9656;</span>
        </a>
      </div>
    )}
  </div>
  <ExpandableModal />
</article>

<style>
  /* ─────────────────────────────────────────────────────────────
   * DEK — Bajada Editorial
   * ───────────────────────────────────────────────────────────── */
  .card-dek {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 300ms ease-out, transform 300ms ease-out;
  }

  /* Shimmer sweep para el brillo del CTA cinemático */
  @keyframes shimmer {
    0%   { transform: translateX(-120%); }
    100% { transform: translateX(120%); }
  }

  /* Ken Burns para la imagen interna */
  @keyframes kenBurnsAscent {
    0% {
      transform: scale(1.02) translateY(2.5%) translateZ(0);
    }
    50% {
      transform: scale(1.08) translateY(0%) translateZ(0);
    }
    100% {
      transform: scale(1.14) translateY(-3%) translateZ(0);
    }
  }

  @keyframes dynamisLoop {
    0% {
      opacity: 0.18;
      transform: scale(1) translateZ(0);
      filter: brightness(1) saturate(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(1.04) translateZ(0);
      filter: brightness(1.12) saturate(1.18);
    }
    100% {
      opacity: 0.22;
      transform: scale(1.01) translateZ(0);
      filter: brightness(1.02) saturate(1.05);
    }
  }

  .cinemagraph-ken-burns {
    animation: kenBurnsAscent 24s cubic-bezier(0.4, 0, 0.6, 1) infinite alternate;
    will-change: transform;
    transform-origin: center center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .cinemagraph-dynamis {
    background: radial-gradient(
      circle at 45% 45%,
      rgba(239, 235, 227, 0.25) 0%,
      rgba(74, 59, 50, 0.12) 45%,
      transparent 70%
    );
    mix-blend-mode: screen;
    animation: dynamisLoop 16s ease-in-out infinite alternate;
    will-change: transform, opacity, filter;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .cinemagraph-ken-burns,
    .cinemagraph-dynamis {
      animation: none !important;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { Flip } from "gsap/Flip";

  gsap.registerPlugin(Flip);

  const runCardSequence = (card: HTMLElement): Promise<void> => {
    return new Promise((resolve) => {
      if (card.dataset.choreographyDone === "true") {
        resolve();
        return;
      }
      card.dataset.choreographyDone = "true";
      card.classList.add("choreography-active");

      const h1Container = card.querySelector<HTMLElement>(".ch-h1-container");
      const ctaBtn = card.querySelector<HTMLElement>(".ch-cta-btn");
      const excerptContainer = card.querySelector<HTMLElement>(".ch-excerpt-container");
      const dekContainer = card.querySelector<HTMLElement>(".ch-dek-container");
      const tags = Array.from(card.querySelectorAll<HTMLElement>(".ch-tag"));

      const tl = gsap.timeline({
        onComplete: () => {
          card.classList.add('card-settled');
          resolve();
        },
      });

      // ── 1. Pase 1 del Metal Sweep (Inicio Rápido) + Tags pulse ──
      if (ctaBtn) {
        ctaBtn.classList.remove("sweep-fast", "sweep-slow");
        void ctaBtn.offsetWidth;
        ctaBtn.classList.add("sweep-fast");
      }

      if (tags.length) {
        tl.fromTo(
          tags,
          { opacity: 0, filter: "blur(2px)" },
          { opacity: 1, filter: "blur(0px)", duration: 0.6, stagger: 0.03, ease: "power2.out" },
          0
        ).to(tags, { opacity: 0.7, duration: 0.4 }, 0.6);
      }

      // ── 2. H1 zoom-out para ceder el escenario al excerpt ──
      if (h1Container && excerptContainer) {
        tl.to(
          h1Container,
          {
            scale: 1.06,
            y: -4,
            filter: "blur(8px)",
            opacity: 0,
            duration: 0.9,
            ease: "power2.inOut",
            force3D: true,
          },
          0.3
        );
      }

      // ── 3. Excerpt escribe toda la línea a la vez (Línea por línea rápida y fluida) ──
      if (excerptContainer) {
        tl.fromTo(
          excerptContainer,
          { opacity: 0, filter: "blur(12px)", y: 8 },
          {
            opacity: 1,
            filter: "blur(0px)",
            y: 0,
            duration: 0.8,
            ease: "power3.out",
          },
          0.8
        );

        // ── 4. Pausa de lectura completa ──
        tl.to({}, { duration: 2.8 });

        // ── 5. Disolución fluida del excerpt ──
        tl.to(excerptContainer, {
          opacity: 0,
          filter: "blur(10px)",
          scale: 0.98,
          y: -4,
          duration: 0.8,
          ease: "power2.inOut",
        });
      }

      // ── 6. Re-materialización líquida del H1 ──
      if (h1Container) {
        tl.fromTo(
          h1Container,
          { opacity: 0, filter: "blur(14px)", scale: 0.98, y: 6 },
          { opacity: 1, filter: "blur(0px)", scale: 1, y: 0, duration: 1.2, ease: "power3.out", force3D: true },
          excerptContainer ? "-=0.2" : "0"
        );
      }

      // ── 7. Dek exterior: revelado suave y presencia visual ──
      if (dekContainer) {
        tl.fromTo(
          dekContainer,
          { opacity: 0.7, y: 2 },
          { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
          0.4
        );
      }

      // ── 8. Pase 2 del Metal Sweep (ULTRA LENTO) en el CTA ──
      if (ctaBtn) {
        tl.add(() => {
          ctaBtn.classList.remove("sweep-fast", "sweep-slow");
          void ctaBtn.offsetWidth;
          ctaBtn.classList.add("sweep-slow");
        }, "-=0.6");
      }

      // Margen final de reposo
      tl.to({}, { duration: 2.5 });
    });
  };

  const initChoreography = () => {
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".cinematic-archive-card"));
    if (cards.length === 0) return;

    /* ── Aislamiento de GSAP con matchMedia (Solo Desktop: min-width: 768px) ── */
    const mm = gsap.matchMedia();

    mm.add("(min-width: 768px)", () => {
      // Hover manual directo
      cards.forEach((card) => {
        card.addEventListener(
          "mouseenter",
          () => {
            if (card.dataset.choreographyDone !== "true") {
              runCardSequence(card);
            }
          },
          { once: true }
        );
      });

      // Observer secuencial
      const queue: HTMLElement[] = [];
      let isRunning = false;

      const processNext = async () => {
        if (isRunning || queue.length === 0) return;
        isRunning = true;
        const nextCard = queue.shift();
        if (nextCard && nextCard.dataset.choreographyDone !== "true") {
          await runCardSequence(nextCard);
        }
        isRunning = false;
        processNext();
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const card = entry.target as HTMLElement;
              if (card.dataset.choreographyDone !== "true" && !queue.includes(card)) {
                queue.push(card);
                processNext();
              }
              observer.unobserve(card);
            }
          });
        },
        { threshold: 0.3 }
      );

      cards.forEach((card) => {
        if (card.dataset.choreographyDone !== "true") {
          observer.observe(card);
        }
      });

      return () => {
        observer.disconnect();
      };
    });
  };

  const initCardModals = () => {
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".cinematic-archive-card"));

    cards.forEach((card) => {
      if (card.dataset.modalInit === "true") return;
      card.dataset.modalInit = "true";

      const triggers = card.querySelectorAll<HTMLAnchorElement>(".cac-modal-trigger");
      const modal = card.querySelector<HTMLDialogElement>(".expandable-modal");
      if (!modal) return;

      const closeBtn = modal.querySelector<HTMLButtonElement>(".close-modal-btn");
      const mContainer = modal.querySelector<HTMLElement>(".modal-container");
      const mImage = modal.querySelector<HTMLImageElement>(".modal-image");
      const mTitle = modal.querySelector<HTMLElement>(".modal-title");
      const mEyebrow = modal.querySelector<HTMLElement>(".modal-eyebrow");
      const mExcerpt = modal.querySelector<HTMLElement>(".modal-excerpt");
      const mCta = modal.querySelector<HTMLAnchorElement>(".modal-cta");

      if (!mContainer || !mImage || !mTitle) return;

      let currentFlipTween: gsap.core.Timeline | null = null;
      let activeCard: HTMLElement | null = null;
      let activeImg: HTMLElement | null = null;
      let activeTitle: HTMLElement | null = null;

      triggers.forEach((trigger) => {
        trigger.addEventListener("click", (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
          if (trigger.getAttribute("target") === "_blank") return;

          e.preventDefault();

          const cardId = card.dataset.cardId || "";
          const img = card.querySelector<HTMLElement>(".cac-card-img");
          const title = card.querySelector<HTMLElement>(".cac-card-title");

          activeCard = card;
          activeImg = img;
          activeTitle = title;

          mImage.src = card.dataset.image || "";
          mTitle.innerHTML = card.dataset.title || "";
          if (mEyebrow) {
            mEyebrow.innerHTML = card.dataset.eyebrow || "";
            mEyebrow.style.display = card.dataset.eyebrow ? "block" : "none";
          }
          if (mExcerpt) mExcerpt.innerHTML = card.dataset.excerpt || "";
          if (mCta) mCta.href = card.dataset.link || "#";

          const extraContent = mContainer.querySelectorAll(".modal-excerpt, .modal-cta, .close-modal-btn, .modal-eyebrow");
          gsap.set(extraContent, { clearProps: "all" });
          gsap.set([mContainer, mImage, mTitle], { clearProps: "all" });

          mContainer.dataset.flipId = `card-container-${cardId}`;
          mImage.dataset.flipId = `card-image-${cardId}`;
          mTitle.dataset.flipId = `card-title-${cardId}`;

          const targetsToFlip = [card, img, title].filter((el): el is HTMLElement => el !== null);
          const state = Flip.getState(targetsToFlip);

          modal.showModal();

          currentFlipTween = Flip.from(state, {
            targets: [mContainer, mImage, mTitle],
            duration: 0.5,
            ease: "power3.inOut",
            absolute: true,
          });
        });
      });

      const closeModal = () => {
        if (!modal.open) return;

        const extraContent = mContainer.querySelectorAll(".modal-excerpt, .modal-cta, .close-modal-btn, .modal-eyebrow");
        gsap.to(extraContent, { opacity: 0, duration: 0.15 });

        if (currentFlipTween) {
          currentFlipTween.timeScale(1.3).reverse();
          currentFlipTween.eventCallback("onReverseComplete", () => {
            modal.close();
            gsap.set([mContainer, mImage, mTitle, ...Array.from(extraContent)], { clearProps: "all" });
            currentFlipTween = null;
            activeCard = null;
            activeImg = null;
            activeTitle = null;
          });
        } else {
          modal.close();
        }
      };

      if (closeBtn) {
        closeBtn.addEventListener("click", closeModal);
      }

      modal.addEventListener("cancel", (e) => {
        e.preventDefault();
        closeModal();
      });

      modal.addEventListener("click", (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    });
  };

  const initAll = () => {
    initChoreography();
    initCardModals();
  };

  document.addEventListener("astro:page-load", initAll);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAll();
  } else {
    document.addEventListener("DOMContentLoaded", initAll);
  }
</script>
