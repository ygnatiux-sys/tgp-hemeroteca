---
/**
 * src/components/KineticBentoAsiaSecrets.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * KINETIC BENTO & DYNAMIC TYPOGRAPHY: 'ASIA SECRETS' (Apple 2026 / MUBI Style)
 *
 * Características:
 * 1. Tipografía Cinematográfica Tridimensional:
 *    - "ASIA": Serif señorial (Fraunces Black 900) con degradado marfil a orquídea pálido,
 *      fringe de aberración óptica cromática y movimiento hacia adelante.
 *    - "SECRETS": Sans geométrica (Clash Grotesk 700) en violeta vibrante iluminado,
 *      superpuesta con tracking expansivo (0.2em -> 0.5em) y destello óptico intenso.
 *    - Badges técnicos: "A CINEMATIC JOURNEY" y "01 / CHAPTER" con clip-path reveal.
 * 2. Acordeón Vertical "Bento Snap":
 *    - Cápsulas panorámicas ultra-redondeadas (border-radius: 24px) con glassmorphism
 *      y resplandor exterior interactivo según color de la imagen.
 *    - El panel central (Gunung Padang en la niebla) se expande al 55% con expo.out
 *      mientras su imagen interna realiza un contra-zoom sincronizado (1.15 -> 1.0).
 *    - Los paneles secundarios se comprimen al 15% y se oscurecen (brightness: 0.4).
 * 3. The Exit Snap (Eyección rápida al fondo):
 *    - El panel extremo se eyecta con Z-axis negativo, desvanecimiento y chispas
 *      de fricción simulando un flujo cinemático vivo continuo.
 * 4. Atmósfera "Partial Glow":
 *    - Fondo negro profundo #050508 con ambient glow violeta/ámbar/azul oscuro,
 *      destello anamórfico horizontal y partículas flotantes en suspensión.
 * 5. Interacción Hover / Parallax Total:
 *    - Al pasar el cursor por un panel comprimido se expande al 55% y el anterior
 *      se comprime con contra-zoom suave.
 */

import imgGunung from "../assets/alternativa/gunung-padang.jpg";
import imgNanMadol from "../assets/alternativa/nan-madol.jpg";
import imgBarabar from "../assets/alternativa/barabar.jpg";

export interface BentoPanelItem {
  id: string;
  tag: string;
  title: string;
  subtitle: string;
  location: string;
  src: string;
  glowColor: string;
  href?: string;
}

interface Props {
  className?: string;
  panels?: BentoPanelItem[];
}

const { className = "", panels } = Astro.props;

const defaultPanels: BentoPanelItem[] = [
  {
    id: "panel-nan-madol",
    tag: "01 / ARCHIPIÉLAGO",
    title: "Nan Madol",
    subtitle: "Megalitos de basalto sobre el arrecife",
    location: "Micronesia · Pohnpei",
    src: imgNanMadol.src,
    glowColor: "rgba(168, 85, 247, 0.45)",
    href: "/test-nan-madol",
  },
  {
    id: "panel-gunung-padang",
    tag: "02 / MEGALITO EN LA NIEBLA",
    title: "Gunung Padang",
    subtitle: "La colina escalonada que fractura el Holoceno",
    location: "Java · Indonesia",
    src: imgGunung.src,
    glowColor: "rgba(234, 179, 8, 0.5)",
    href: "/colecciones/asia-secrets/gunung-padang/",
  },
  {
    id: "panel-barabar",
    tag: "03 / CÁMARAS ACÚSTICAS",
    title: "Cuevas de Barabar",
    subtitle: "Bóvedas de granito espejo y resonancia pura",
    location: "Bihar · India",
    src: imgBarabar.src,
    glowColor: "rgba(217, 70, 239, 0.45)",
    href: "/test-barabar",
  },
  {
    id: "panel-yonaguni",
    tag: "04 / ESTRUCTURA SUMERGIDA",
    title: "Yonaguni",
    subtitle: "Monolitos submarinos y terrazas ciclópeas",
    location: "Okinawa · Japón",
    src: "https://storage.thegreatpuzzleproject.com/alternativa/moai.jpg",
    glowColor: "rgba(59, 130, 246, 0.45)",
    href: "/colecciones/asia-secrets/",
  },
];

const activePanels = panels && panels.length > 0 ? panels : defaultPanels;
---

<!-- TIPOGRAFÍAS DE ÉLITE: Fraunces 900 + Clash Grotesk 700 + Space Mono -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://api.fontshare.com" />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,900,0,1&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
/>
<link
  rel="stylesheet"
  href="https://api.fontshare.com/v2/css?f[]=clash-grotesk@700&display=swap"
/>

<section
  id="kinetic-bento-asia"
  class={`relative isolate w-full min-h-screen md:min-h-svh flex flex-col justify-between py-6 sm:py-8 md:py-10 px-4 sm:px-6 md:px-10 overflow-hidden bg-[#050508] text-[#f5f3f7] select-none ${className}`}
  aria-label="Asia Secrets: Kinetic Bento Experience"
>
  {/* ══════════════════════════════════════════════════════════════════════════
      1. ATMÓSFERA CINEMATOGRÁFICA "PARTIAL GLOW" & LENS FLARES
  ══════════════════════════════════════════════════════════════════════════ */}
  <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
    {/* Resplandor ambiental superior en violeta y orquídea */}
    <div
      class="asia-ambient-glow-top absolute -top-[20%] left-1/2 -translate-x-1/2 w-[90vw] max-w-260 h-[70vh] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(168,85,247,0.22)_0%,rgba(107,33,168,0.12)_40%,transparent_75%)] blur-3xl"
    />
    {/* Resplandor cálido ámbar/volcánico inferior */}
    <div
      class="asia-ambient-glow-bottom absolute -bottom-[15%] right-[5%] w-[65vw] max-w-200 h-[55vh] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(217,119,6,0.18)_0%,rgba(146,64,14,0.08)_45%,transparent_70%)] blur-3xl"
    />
    {/* Destello abisal azul en esquina izquierda */}
    <div
      class="absolute bottom-[10%] -left-[10%] w-[50vw] max-w-160 h-[45vh] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(37,99,235,0.14)_0%,transparent_65%)] blur-3xl"
    />

    {/* Destello Anamórfico Horizontal (Lens Flare de cine) */}
    <div class="asia-lens-flare absolute top-[36%] left-0 right-0 h-0.5 opacity-75 flex items-center justify-center pointer-events-none">
      <div class="w-full h-px bg-[linear-gradient(90deg,transparent_0%,rgba(192,132,252,0.15)_25%,rgba(255,255,255,0.7)_50%,rgba(192,132,252,0.15)_75%,transparent_100%)] blur-[0.5px]" />
      <div class="absolute w-44 h-12 bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.6)_0%,rgba(168,85,247,0.35)_40%,transparent_75%)] blur-md" />
    </div>

    {/* Micro-Grano Analógico 35mm */}
    <div class="asia-film-grain absolute inset-0 opacity-[0.16] mix-blend-overlay" />

    {/* Partículas de polvo en suspensión */}
    <div class="asia-dust-spores absolute inset-0" aria-hidden="true">
      <span class="spore-dot absolute top-[18%] left-[12%] w-1.5 h-1.5 rounded-full bg-purple-300/40 blur-[0.8px] animate-pulse" />
      <span class="spore-dot absolute top-[32%] right-[18%] w-2 h-2 rounded-full bg-amber-200/35 blur-[1px] animate-pulse" style="animation-delay: 1.2s;" />
      <span class="spore-dot absolute bottom-[22%] left-[28%] w-1.5 h-1.5 rounded-full bg-purple-400/40 blur-[0.8px] animate-pulse" style="animation-delay: 2.1s;" />
      <span class="spore-dot absolute top-[68%] right-[32%] w-1 h-1 rounded-full bg-white/30 blur-[0.5px] animate-pulse" style="animation-delay: 0.8s;" />
    </div>

    {/* Chispas de velocidad en el borde derecho durante la eyección rápida */}
    <div
      class="asia-speed-sparks absolute top-0 bottom-0 right-0 w-28 pointer-events-none opacity-0 z-30 overflow-hidden"
    >
      <div class="spark-line absolute top-[25%] right-2 w-16 h-0.5 bg-linear-to-r from-transparent to-purple-400 blur-[0.5px] -rotate-12" />
      <div class="spark-line absolute top-[48%] right-4 w-24 h-0.5 bg-linear-to-r from-transparent to-amber-300 blur-[0.5px] -rotate-6" />
      <div class="spark-line absolute top-[70%] right-3 w-20 h-0.5 bg-linear-to-r from-transparent to-white blur-[0.5px] -rotate-15" />
    </div>
  </div>

  {/* ══════════════════════════════════════════════════════════════════════════
      2. HEADER & TIPOGRAFÍA DINÁMICA TRIDIMENSIONAL
  ══════════════════════════════════════════════════════════════════════════ */}
  <header class="asia-header-wrap relative z-20 w-full max-w-7xl mx-auto flex flex-col items-center text-center mt-1 sm:mt-2 will-change-transform">
    
    {/* Micro-detalle técnico superior con clip-path */}
    <div class="asia-meta-top overflow-hidden mb-1.5 sm:mb-2">
      <span class="inline-flex items-center gap-2.5 font-['Space_Mono'] text-[9px] sm:text-[10px] uppercase tracking-[0.42em] text-white/70">
        <span class="w-1.5 h-1.5 rounded-full bg-purple-400 shadow-[0_0_8px_#c084fc] inline-block animate-ping" />
        A Cinematic Journey · Season 2026
        <span class="w-1.5 h-1.5 rounded-full bg-purple-400 shadow-[0_0_8px_#c084fc] inline-block animate-ping" style="animation-delay: 0.5s;" />
      </span>
    </div>

    {/* Contenedor Tipográfico "ASIA" + "SECRETS" Superpuesto */}
    <div class="asia-typo-stage relative flex flex-col items-center justify-center will-change-transform">
      
      {/* TÍTULO PRINCIPAL: ASIA (Serif señorial con fringe cromático y degradado) */}
      <h1
        class="asia-word font-['Fraunces'] font-black uppercase text-[clamp(3.6rem,11.5vw,9.8rem)] leading-[0.82] tracking-[-0.03em] whitespace-nowrap will-change-transform"
      >
        ASIA
      </h1>

      {/* PALABRA SUPERPUESTA: SECRETS (Sans geométrica violeta con destello expansivo) */}
      <h2
        class="secrets-word font-['Clash_Grotesk'] font-bold uppercase text-[clamp(1.2rem,3.4vw,3.2rem)] tracking-[0.2em] leading-none will-change-transform -mt-2 sm:-mt-4 md:-mt-6 z-10"
      >
        SECRETS
      </h2>
    </div>

    {/* Micro-detalle técnico inferior */}
    <div class="asia-meta-bottom overflow-hidden mt-2 sm:mt-3">
      <p class="font-['Space_Mono'] text-[9px] sm:text-[10px] uppercase tracking-[0.32em] text-white/55 m-0">
        01 / CHAPTER · MEGALITOS DEL PACÍFICO & ARQUEOLOGÍA SUBTERRÁNEA
      </p>
    </div>
  </header>

  {/* ══════════════════════════════════════════════════════════════════════════
      3. ACORDEÓN VERTICAL "KINETIC BENTO" (Cápsulas Snapshot 55% vs 15%)
  ══════════════════════════════════════════════════════════════════════════ */}
  <main class="asia-main-stage relative z-20 w-full max-w-7xl mx-auto my-3 sm:my-5 md:my-6 flex-1 flex flex-col justify-center will-change-transform">
    <div
      id="asia-bento-strip"
      class="relative flex items-stretch gap-2.5 sm:gap-4 md:gap-5 w-full h-77.5 sm:h-87.5 md:h-97.5 lg:h-106.25 p-2 sm:p-2.5 rounded-[28px] bg-white/2 border border-white/10 backdrop-blur-xl shadow-[0_30px_90px_-20px_rgba(0,0,0,0.95)] overflow-hidden"
    >
      {activePanels.map((panel, index) => {
        const isCenterDefault = index === 1; // Gunung Padang inicia expandido al 55%
        return (
          <a
            href={panel.href || "#"}
            id={panel.id}
            data-index={index}
            class={`bento-capsule group/capsule relative h-full rounded-[22px] sm:rounded-3xl overflow-hidden border border-white/15 transition-shadow duration-500 will-change-[width,transform] ${
              isCenterDefault
                ? "w-[55%] ring-1 ring-white/30 shadow-[0_0_40px_rgba(234,179,8,0.3)]"
                : "w-[15%] brightness-50 hover:brightness-90"
            }`}
            style={`--panel-glow: ${panel.glowColor};`}
          >
            {/* Imagen Interna con Contra-Zoom Dinámico */}
            <img
              src={panel.src}
              alt={panel.title}
              loading="eager"
              decoding="async"
              class="capsule-img absolute inset-0 w-full h-full object-cover object-center will-change-transform transition-transform duration-700 group-hover/capsule:scale-105"
            />

            {/* Sombra de viñeta cinematográfica para contraste del texto */}
            <div class="capsule-vignette absolute inset-0 bg-[linear-gradient(180deg,rgba(5,5,8,0.15)_0%,transparent_40%,rgba(5,5,8,0.85)_82%,#050508_100%)] pointer-events-none" />

            {/* Resplandor de aura interna */}
            <div
              class="capsule-glow absolute inset-0 opacity-0 group-hover/capsule:opacity-100 transition-opacity duration-500 pointer-events-none"
              style={`box-shadow: inset 0 0 45px ${panel.glowColor};`}
            />

            {/* Badge Superior: Tag Técnico */}
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between z-10 pointer-events-none">
              <span class="font-['Space_Mono'] text-[9px] sm:text-[10px] uppercase tracking-[0.25em] px-2.5 py-1 rounded-full bg-black/55 text-white/80 border border-white/15 backdrop-blur-md">
                {panel.tag}
              </span>
              <span class="opacity-0 group-hover/capsule:opacity-100 transition-opacity font-['Space_Mono'] text-[10px] text-amber-300">
                EXPLORAR →
              </span>
            </div>

            {/* Bloque Inferior: Título, Subtítulo y Ubicación */}
            <div class="capsule-caption absolute inset-x-0 bottom-0 p-4 sm:p-6 z-10 flex flex-col justify-end pointer-events-none transition-all duration-300">
              <span class="font-['Space_Mono'] text-[10px] sm:text-[11px] uppercase tracking-[0.2em] text-purple-300/85 mb-1">
                {panel.location}
              </span>
              <h3 class="font-['Clash_Grotesk'] font-bold text-xl sm:text-2xl md:text-3xl text-white tracking-tight leading-tight m-0 drop-shadow-md">
                {panel.title}
              </h3>
              <p class="capsule-sub font-sans text-xs sm:text-sm text-stone-300/80 mt-1 line-clamp-2 max-w-md transition-opacity duration-300">
                {panel.subtitle}
              </p>
            </div>
          </a>
        );
      })}
    </div>
  </main>

  {/* ══════════════════════════════════════════════════════════════════════════
      4. FOOTER CONTROLS & STATUS BAR
  ══════════════════════════════════════════════════════════════════════════ */}
  <footer class="relative z-20 w-full max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-white/50 border-t border-white/10 pt-4 text-xs font-['Space_Mono']">
    <div class="flex items-center gap-3">
      <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block animate-pulse" />
      <span>AUTOPLAY / HOVER SNAP INTERACTIVO</span>
      <button
        id="asia-replay-btn"
        type="button"
        class="ml-3 px-2.5 py-0.5 rounded-full bg-white/10 hover:bg-white/20 text-purple-300 hover:text-white border border-white/15 cursor-pointer transition-colors"
      >
        ↻ REPLAY SECUENCIA
      </button>
    </div>
    <div class="flex items-center gap-4 text-[11px] tracking-widest uppercase">
      <span>FÍSICA: EXPO.OUT 0.9S</span>
      <span class="text-white/20">|</span>
      <span>4 ESTACIONES MEGALÍTICAS</span>
    </div>
  </footer>
</section>

{/* ══════════════════════════════════════════════════════════════════════════
    5. ESTILOS VISUALES AVANZADOS (Fringe Óptico, Grano, Tipografía)
══════════════════════════════════════════════════════════════════════════ */}
<style>
  /* Tipografía ASIA: Blanco puro a orquídea pálido con Fringe Cromático */
  .asia-word {
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      #f8f4ff 35%,
      #e9d5ff 70%,
      #c084fc 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(-1.5px 0 0 rgba(244, 114, 182, 0.35))
      drop-shadow(1.5px 0 0 rgba(56, 189, 248, 0.35))
      drop-shadow(0 20px 45px rgba(0, 0, 0, 0.95))
      drop-shadow(0 0 50px rgba(168, 85, 247, 0.35));
  }

  /* Tipografía SECRETS: Violeta Eléctrico con Aura de Neón */
  .secrets-word {
    color: #e9d5ff;
    text-shadow:
      0 0 25px rgba(192, 132, 252, 0.9),
      0 0 50px rgba(168, 85, 247, 0.55),
      0 4px 15px rgba(0, 0, 0, 0.9);
  }

  /* Grano Fílmico Analógico de 35mm */
  .asia-film-grain {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23g)'/></svg>");
  }

  /* Clip-path reveal base para textos técnicos */
  .asia-meta-top span,
  .asia-meta-bottom p {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }

  /* Efecto de compresión y expansión fluido */
  .bento-capsule {
    transition: width 0.75s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.5s ease,
                box-shadow 0.5s ease;
  }
</style>

{/* ══════════════════════════════════════════════════════════════════════════
    6. MOTOR GSAP: TIMELINE DE RESORTE RÁPIDO & EYECCIÓN INTERACTIVA
══════════════════════════════════════════════════════════════════════════ */}
<script>
  import gsap from "gsap";

  let activeTimeline: gsap.core.Timeline | null = null;
  let isHovering = false;

  function initKineticBentoAsia() {
    const stage = document.getElementById("kinetic-bento-asia");
    const strip = document.getElementById("asia-bento-strip");
    if (!stage || !strip) return;

    if (activeTimeline) {
      activeTimeline.kill();
      activeTimeline = null;
    }

    const header = stage.querySelector<HTMLElement>(".asia-header-wrap");
    const mainStage = stage.querySelector<HTMLElement>(".asia-main-stage");
    const titleAsia = stage.querySelector<HTMLElement>(".asia-word");
    const titleSecrets = stage.querySelector<HTMLElement>(".secrets-word");
    const metaTop = stage.querySelector<HTMLElement>(".asia-meta-top span");
    const metaBottom = stage.querySelector<HTMLElement>(".asia-meta-bottom p");
    const flare = stage.querySelector<HTMLElement>(".asia-lens-flare");
    const sparks = stage.querySelector<HTMLElement>(".asia-speed-sparks");
    const replayBtn = document.getElementById("asia-replay-btn");
    const capsules = Array.from(strip.querySelectorAll<HTMLElement>(".bento-capsule"));

    if (!header || !mainStage || !titleAsia || !titleSecrets || capsules.length === 0) return;

    // Estado inicial absoluto: Título centrado en el medio de la pantalla, bento oculto
    gsap.set(header, { y: "20vh", scale: 1.15 });
    gsap.set(mainStage, { opacity: 0, y: 70 });
    gsap.set(capsules, { opacity: 0 });
    gsap.set(flare, { opacity: 0.15, scaleX: 0.2 });

    const tl = gsap.timeline({
      repeat: -1,
      repeatDelay: 5.0,
      onRepeat: () => {
        if (isHovering) {
          tl.pause();
        }
      },
    });
    activeTimeline = tl;

    // ─────────────────────────────────────────────────────────────────────────
    // PASO 01: LA REVELACIÓN (0.0s - 1.2s)
    // Aire y misterio absolutos. Solo el gran título sobre el vacío y el glow.
    // ─────────────────────────────────────────────────────────────────────────
    tl.fromTo(
      titleAsia,
      { scale: 0.92, opacity: 0, filter: "blur(20px)" },
      {
        scale: 1.05,
        opacity: 1,
        filter: "blur(0px)",
        duration: 0.7,
        ease: "expo.out",
      },
      0
    )
    .fromTo(
      titleSecrets,
      {
        scale: 0.72,
        opacity: 0,
        letterSpacing: "0.2em",
        filter: "drop-shadow(0 0 25px rgba(186,104,200,0.95))",
      },
      {
        scale: 1,
        opacity: 1,
        letterSpacing: "0.45em",
        filter: "drop-shadow(0 0 10px rgba(186,104,200,0.65))",
        duration: 0.65,
        ease: "back.out(1.8)",
      },
      0.18
    )
    .fromTo(
      metaTop,
      { clipPath: "polygon(0 0, 0 0, 0 100%, 0 100%)", opacity: 0 },
      {
        clipPath: "polygon(0 0, 100% 0, 100% 100%, 0 100%)",
        opacity: 1,
        duration: 0.55,
        ease: "power2.out",
      },
      0.12
    )
    .fromTo(
      metaBottom,
      { clipPath: "polygon(0 0, 0 0, 0 100%, 0 100%)", opacity: 0 },
      {
        clipPath: "polygon(0 0, 100% 0, 100% 100%, 0 100%)",
        opacity: 1,
        duration: 0.55,
        ease: "power2.out",
      },
      0.22
    );

    // ─────────────────────────────────────────────────────────────────────────
    // PASO 02: LA TRANSICIÓN (1.2s - 1.8s)
    // El título se achica y sube para dejarle espacio a la primera cápsula,
    // que entra con velocidad y desvanecimiento desde el fondo/derecha.
    // ─────────────────────────────────────────────────────────────────────────
    tl.to(
      header,
      {
        y: 0,
        scale: 1.0,
        duration: 0.65,
        ease: "power3.inOut",
      },
      1.2
    )
    .to(
      mainStage,
      {
        opacity: 1,
        y: 0,
        duration: 0.55,
        ease: "power2.out",
      },
      1.25
    );

    // Entrada veloz de la primera cápsula (Nan Madol) desde el fondo/derecha
    const firstCapsule = capsules[0];
    if (firstCapsule) {
      tl.fromTo(
        firstCapsule,
        {
          x: 260,
          y: 140,
          rotation: 8,
          scale: 0.52,
          opacity: 0,
          width: "36%",
          filter: "blur(14px)",
        },
        {
          x: 0,
          y: 0,
          rotation: 0,
          scale: 1,
          opacity: 1,
          width: "36%",
          filter: "blur(0px)",
          duration: 0.75,
          ease: "expo.out",
        },
        1.3
      );
    }

    if (sparks) {
      tl.fromTo(
        sparks,
        { opacity: 0, x: 25 },
        { opacity: 1, x: 0, duration: 0.35, ease: "power2.out" },
        1.35
      ).to(sparks, { opacity: 0, duration: 0.25 }, 1.7);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PASO 03: LA SECUENCIA ACORDEÓN (1.9s - 3.2s+)
    // Las tarjetas van encajando una tras otra en forma de acordeón,
    // solapándose con físicas de resorte. Gunung Padang se expande al 55%.
    // ─────────────────────────────────────────────────────────────────────────
    const centerPanel = capsules[1] || capsules[0];
    const otherPanels = capsules.slice(2);
    const centerImg = centerPanel?.querySelector<HTMLElement>(".capsule-img");

    // Primera cápsula se comprime hacia el carril izquierdo
    if (firstCapsule) {
      tl.to(
        firstCapsule,
        {
          width: "15%",
          filter: "brightness(0.42)",
          duration: 0.7,
          ease: "expo.out",
        },
        1.95
      );
    }

    // Tarjeta central (Gunung Padang) entra y hace el snap majestuoso al 55%
    if (centerPanel) {
      tl.fromTo(
        centerPanel,
        {
          x: 90,
          scale: 0.88,
          opacity: 0,
          width: "25%",
        },
        {
          x: 0,
          scale: 1,
          opacity: 1,
          width: "55%",
          filter: "brightness(1)",
          duration: 0.85,
          ease: "expo.out",
        },
        2.0
      );

      if (centerImg) {
        tl.fromTo(
          centerImg,
          { scale: 1.15 },
          { scale: 1.0, duration: 0.85, ease: "expo.out" },
          2.0
        );
      }
    }

    // Tarjetas restantes (Barabar, Yonaguni) encajan en el acordeón a la derecha
    if (otherPanels.length > 0) {
      tl.fromTo(
        otherPanels,
        {
          x: 120,
          opacity: 0,
          scale: 0.85,
          width: "15%",
        },
        {
          x: 0,
          opacity: 1,
          scale: 1,
          width: "15%",
          filter: "brightness(0.42)",
          duration: 0.75,
          stagger: 0.12,
          ease: "back.out(1.5)",
        },
        2.15
      );
    }

    // Destello de lente anamórfico recorre el ancho
    if (flare) {
      tl.fromTo(
        flare,
        { scaleX: 0.2, opacity: 0.1 },
        { scaleX: 1.15, opacity: 0.85, duration: 0.8, ease: "expo.out" },
        2.1
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 4. INTERACCIÓN HOVER: ACORDEÓN PARALLAX REACTIVO
    // ─────────────────────────────────────────────────────────────────────────
    capsules.forEach((capsule, idx) => {
      capsule.addEventListener("mouseenter", () => {
        isHovering = true;
        tl.pause();

        // Expandir el panel señalado al 55%
        gsap.to(capsule, {
          width: "55%",
          filter: "brightness(1.05)",
          duration: 0.55,
          ease: "expo.out",
          overwrite: "auto",
        });

        const img = capsule.querySelector<HTMLElement>(".capsule-img");
        if (img) {
          gsap.to(img, {
            scale: 1.08,
            duration: 0.6,
            ease: "expo.out",
            overwrite: "auto",
          });
        }

        // Comprimir el resto al 15%
        capsules.forEach((other, otherIdx) => {
          if (otherIdx !== idx) {
            gsap.to(other, {
              width: "15%",
              filter: "brightness(0.38)",
              duration: 0.55,
              ease: "expo.out",
              overwrite: "auto",
            });
            const otherImg = other.querySelector<HTMLElement>(".capsule-img");
            if (otherImg) {
              gsap.to(otherImg, {
                scale: 1.0,
                duration: 0.55,
                ease: "expo.out",
                overwrite: "auto",
              });
            }
          }
        });
      });
    });

    strip.addEventListener("mouseleave", () => {
      isHovering = false;
      // Restaurar estado del centro al 55%
      capsules.forEach((c, i) => {
        gsap.to(c, {
          width: i === 1 ? "55%" : "15%",
          filter: i === 1 ? "brightness(1)" : "brightness(0.42)",
          duration: 0.6,
          ease: "expo.out",
          overwrite: "auto",
        });
      });
      tl.play();
    });

    // Control de Replay manual
    if (replayBtn) {
      replayBtn.addEventListener("click", () => {
        isHovering = false;
        tl.restart();
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initKineticBentoAsia);
  } else {
    initKineticBentoAsia();
  }
  document.addEventListener("astro:page-load", initKineticBentoAsia);
</script>
