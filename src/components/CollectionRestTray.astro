---
/**
 * CollectionRestTray.astro
 * Bandeja Horizontal Focal 3D para el Resto de la Colección.
 * Diseñada para ubicarse inmediatamente debajo del Post Cover de cada colección.
 *
 * Características:
 *  - Aspect ratio 4:3 (más cuadrada, mayor presencia vertical hacia arriba).
 *  - Efecto de perspectiva 3D: Tarjeta central escala 1.05x (focal, nítida, dominante).
 *  - Tarjetas laterales escala 0.84x (visiblemente más compactas y oscurecidas).
 *  - Chevrons Row Netflix disimulados en cápsula con hover delay.
 *  - Máscaras de fundido laterales sutiles (fade suave que no tapa el texto de las laterales).
 *  - Sin metadata superior (sin "resto de la colección", sin conteo de dossiers).
 *  - Tipografía en Gloock con gradient-general-h1 y glow-metallic-gloock idéntica al título de la colección.
 *  - Subtítulo en papiro suave #E3DDD3 y CTA "VER POST" estilo sample.
 */
import { sanitizeImageUrl, formatYear, normalizeCategory } from '../lib/content-filter';

export interface RestEssayItem {
  slug: string;
  entry: any;
  img?: any;
}

interface Props {
  essays: RestEssayItem[];
  categoryKey?: string;
  categoryLabel?: string;
}

const {
  essays = [],
  categoryKey = 'coleccion',
  categoryLabel = 'Colección'
} = Astro.props;

// Identificador único por instancia
const uid = `rest-tray-${categoryKey}-${Math.random().toString(36).substring(2, 8)}`;
---

{essays.length > 0 && (
  <div id={uid} class="collection-rest-tray-root w-full my-6 sm:my-10 select-none relative overflow-x-clip overflow-y-visible" data-count={essays.length}>
    {/* ── ESCENARIO CINEMÁTICO DEL TRAY EN PERSPECTIVA CON AMPLIO AIRE ── */}
    <div class="relative w-full overflow-x-clip overflow-y-visible py-8 sm:py-14 md:py-18">

      {/* ── PISTA DE TARJETAS CON PROPORCIÓN 4:3 ── */}
      <div class="tray-viewport relative w-full flex items-center justify-center overflow-x-clip overflow-y-visible">
        
        {/* ── MÁSCARAS DE FUNDIDO LATERAL SUTILES (ALINEADAS A LA ALTURA DE LAS TARJETAS) ── */}
        <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-16 sm:w-24 md:w-32 lg:w-44 bg-linear-to-r from-(--bg-current,var(--bg-main,#121413)) via-(--bg-current,var(--bg-main,#121413))/60 via-35% to-transparent z-35" />
        <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-16 sm:w-24 md:w-32 lg:w-44 bg-linear-to-l from-(--bg-current,var(--bg-main,#121413)) via-(--bg-current,var(--bg-main,#121413))/60 via-35% to-transparent z-35" />

        {/* ── BOTÓN ANTERIOR (<) EN CÁPSULA ROW NETFLIX A LOS LADOS DE LAS IMÁGENES LATERALES ── */}
        {essays.length > 1 && (
          <button
            type="button"
            class="tray-btn prev-btn group absolute left-3 sm:left-5 md:left-8 lg:left-10 top-[38%] sm:top-[40%] -translate-y-1/2 z-40 w-9 sm:w-10 md:w-11 h-16 sm:h-20 rounded-full bg-black/60 hover:bg-black/85 text-white/80 hover:text-white border border-white/20 hover:border-white/50 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-85 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none"
            aria-label="Post anterior"
          >
            <svg class="w-4 h-4 md:w-5 md:h-5 -translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </button>
        )}

        {/* ── BOTÓN SIGUIENTE (>) EN CÁPSULA ROW NETFLIX A LOS LADOS DE LAS IMÁGENES LATERALES ── */}
        {essays.length > 1 && (
          <button
            type="button"
            class="tray-btn next-btn group absolute right-3 sm:right-5 md:right-8 lg:right-10 top-[38%] sm:top-[40%] -translate-y-1/2 z-40 w-9 sm:w-10 md:w-11 h-16 sm:h-20 rounded-full bg-black/60 hover:bg-black/85 text-white/80 hover:text-white border border-white/20 hover:border-white/50 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-85 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none"
            aria-label="Siguiente post"
          >
            <svg class="w-4 h-4 md:w-5 md:h-5 translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        )}

        {essays.map((item, idx) => {
          const entry = item.entry || {};
          const title = entry.title || 'Dossier';
          const dek = entry.dek || entry.excerpt || '';
          const cleanExcerpt = dek.replace(/\*\*/g, '').trim();
          const year = entry.date ? formatYear(entry.date) : '';
          const rawImg = item.img || entry.coverImage;
          const imgUrl = sanitizeImageUrl(typeof rawImg === 'object' && rawImg?.src ? rawImg.src : (typeof rawImg === 'string' ? rawImg : '')) || 'https://images.unsplash.com/photo-1547036967-23d11aacaee0?q=80&w=1200&auto=format&fit=crop';
          const isCinematic = entry.category === 'Ensayos Cinemáticos' || entry.category === 'ensayos-cinematicos' || normalizeCategory(entry.category) === 'ensayos-cinematicos';
          const href = isCinematic ? `/ensayos-cinematicos/${item.slug}/` : `/hemeroteca/${item.slug}/`;

          return (
            <div
              class="rest-tray-card absolute top-1/2 -translate-y-1/2 w-[82%] sm:w-[68%] md:w-[56%] lg:w-[48%] max-w-160 aspect-4/3 rounded-2xl md:rounded-3xl overflow-hidden border border-white/10 bg-stone-950 shadow-2xl transition-all duration-600 ease-[cubic-bezier(0.25,1,0.5,1)] flex flex-col justify-end"
              data-card-index={idx}
              data-slug={item.slug}
            >
              {/* Imagen panorámica de fondo con relación 4:3 */}
              <img
                src={imgUrl}
                alt={title}
                class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none brightness-90 contrast-[1.03] transition-transform duration-700 ease-out z-0"
                loading="lazy"
                decoding="async"
              />

              {/* Scrim degradado inferior profundo idéntico al sample */}
              <div 
                class="absolute inset-0 pointer-events-none z-10"
                style="background: linear-gradient(to top, rgba(0,0,0,0.96) 0%, rgba(0,0,0,0.7) 48%, rgba(0,0,0,0.2) 75%, transparent 100%);"
              />

              {/* Capa de atenuación para tarjetas secundarias en perspectiva */}
              <div class="card-side-dimmer absolute inset-0 bg-black/45 pointer-events-none transition-opacity duration-500 z-15" />

              {/* Badge Centrado Superior Estilo Sample */}
              <div class="absolute top-3.5 sm:top-5 inset-x-0 flex justify-center z-20 pointer-events-none">
                <span class="px-3.5 py-1 rounded-full text-[8.5px] sm:text-[9.5px] tracking-[0.25em] uppercase font-mono bg-black/60 backdrop-blur-md text-white/80 border border-white/15 font-semibold shadow-lg">
                  {entry.category ? entry.category.toUpperCase() : categoryLabel.toUpperCase()}
                </span>
              </div>

              {/* Bloque Editorial Centrado al Pie Estilo Presentación de Colección */}
              <div class="relative z-20 p-5 sm:p-7 md:p-8 flex flex-col items-center justify-end text-center w-full pointer-events-none">
                {year && (
                  <span class="font-mono text-[9px] sm:text-[10px] uppercase tracking-[0.3em] text-rust-orange font-bold mb-1.5 block">
                    {year}
                  </span>
                )}

                {/* Título en Gloock con gradient-general-h1 y glow-metallic-gloock */}
                <h3 class="font-serif font-black text-2xl sm:text-3xl md:text-4xl lg:text-[2.5rem] tracking-tight leading-[1.08] mb-2 gradient-general-h1 glow-metallic-gloock uppercase line-clamp-2 max-w-xl drop-shadow-xl">
                  {title}
                </h3>

                {cleanExcerpt && (
                  <p class="font-sans text-xs sm:text-sm text-[#E3DDD3]/80 line-clamp-2 max-w-lg mb-4 leading-relaxed font-light hidden sm:block">
                    {cleanExcerpt}
                  </p>
                )}

                {/* Botón Call to Action Centrado Estilo Sample con fondo translúcido que hereda el background */}
                <div class="mt-1 w-full max-w-64 flex justify-center">
                  <a
                    href={href}
                    class="card-cta-btn inline-flex items-center justify-center gap-2.5 w-full py-2.5 sm:py-3 px-6 rounded-lg bg-black/35 hover:bg-black/60 text-[#EFEBE3] hover:text-white border border-white/20 hover:border-white/40 backdrop-blur-md font-mono font-semibold text-[9.5px] sm:text-xs uppercase tracking-[0.25em] transition-all duration-300 shadow-xl shadow-black/60 hover:scale-105 active:scale-95 cursor-pointer"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                    <span>VER POST</span>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      {/* ── INDICADORES DE PUNTOS INFERIORES ── */}
      {essays.length > 1 && (
        <div class="flex justify-center items-center gap-2 mt-4 sm:mt-6">
          {essays.map((_, idx) => (
            <button
              type="button"
              class="tray-dot transition-all duration-300 rounded-full cursor-pointer h-1.5 focus:outline-none"
              data-dot-index={idx}
              aria-label={`Ir a publicación ${idx + 1}`}
            />
          ))}
        </div>
      )}
    </div>
  </div>
)}

<style>
  /* Estados de perspectiva 3D */
  .rest-tray-card {
    will-change: transform, opacity, left;
  }

  .rest-tray-card.is-active {
    box-shadow: 0 35px 90px -15px rgba(0, 0, 0, 0.98), 0 0 30px rgba(227, 221, 211, 0.1);
    border-color: rgba(227, 221, 211, 0.3);
  }

  .rest-tray-card.is-active .card-side-dimmer {
    opacity: 0;
  }

  .rest-tray-card.is-active .card-cta-btn {
    pointer-events: auto;
    background-color: #EFEBE3;
    color: #121413;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.8), 0 0 15px rgba(227, 221, 211, 0.2);
  }

  .rest-tray-card:not(.is-active) {
    cursor: pointer;
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.85);
  }

  .rest-tray-card:not(.is-active) .card-side-dimmer {
    opacity: 0.55;
  }

  .rest-tray-card:not(.is-active) .card-cta-btn {
    pointer-events: none;
    background-color: rgba(30, 31, 30, 0.85);
    color: rgba(227, 221, 211, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
</style>

<script>
  function initCollectionRestTrays() {
    const roots = document.querySelectorAll<HTMLElement>('.collection-rest-tray-root');

    roots.forEach(root => {
      if (root.dataset.init === 'true') return;
      root.dataset.init = 'true';

      const cards = Array.from(root.querySelectorAll<HTMLElement>('.rest-tray-card'));
      const dots = Array.from(root.querySelectorAll<HTMLElement>('.tray-dot'));
      const prevBtn = root.querySelector<HTMLButtonElement>('.prev-btn');
      const nextBtn = root.querySelector<HTMLButtonElement>('.next-btn');
      const total = cards.length;

      if (total === 0) return;

      let currentIndex = 0;

      function updateLayout() {
        const isMobile = window.innerWidth < 640;
        const isTablet = window.innerWidth >= 640 && window.innerWidth < 1024;

        // Separación horizontal para el abanico de perspectiva
        const step1 = isMobile ? 54 : (isTablet ? 46 : 42); // Flancos inmediatos (diff 1, -1)
        const step2 = isMobile ? 96 : (isTablet ? 84 : 78); // Tarjetas en penumbra (diff 2, -2)

        cards.forEach((card, idx) => {
          let diff = idx - currentIndex;

          // Envoltura circular
          if (diff > total / 2) diff -= total;
          if (diff < -total / 2) diff += total;

          // 1. Tarjeta Central (Activa) — Escala 1.05, dominante, z-30
          if (diff === 0) {
            card.classList.add('is-active');
            card.style.left = '50%';
            card.style.transform = 'translate3d(-50%, -50%, 0) scale(1.05)';
            card.style.opacity = '1';
            card.style.filter = 'brightness(1)';
            card.style.zIndex = '30';
            card.style.pointerEvents = 'auto';
          }
          // 2. Lateral Izquierda Inmediata (diff -1) — Escala 0.84, z-20, oscurecida
          else if (diff === -1 || (total === 2 && diff === 1 && currentIndex === 1)) {
            card.classList.remove('is-active');
            card.style.left = `calc(50% - ${step1}%)`;
            card.style.transform = 'translate3d(-50%, -50%, 0) scale(0.84)';
            card.style.opacity = '0.85';
            card.style.filter = 'brightness(0.65)';
            card.style.zIndex = '20';
            card.style.pointerEvents = 'auto';
          }
          // 3. Lateral Derecha Inmediata (diff 1) — Escala 0.84, z-20, oscurecida
          else if (diff === 1) {
            card.classList.remove('is-active');
            card.style.left = `calc(50% + ${step1}%)`;
            card.style.transform = 'translate3d(-50%, -50%, 0) scale(0.84)';
            card.style.opacity = '0.85';
            card.style.filter = 'brightness(0.65)';
            card.style.zIndex = '20';
            card.style.pointerEvents = 'auto';
          }
          // 4. Tarjeta Fondo Izquierda (diff -2) — Sugiere más contenido, escala 0.70, z-10, en penumbra
          else if (diff === -2) {
            card.classList.remove('is-active');
            card.style.left = `calc(50% - ${step2}%)`;
            card.style.transform = 'translate3d(-50%, -50%, 0) scale(0.70)';
            card.style.opacity = '0.40';
            card.style.filter = 'brightness(0.35)';
            card.style.zIndex = '10';
            card.style.pointerEvents = 'auto';
          }
          // 5. Tarjeta Fondo Derecha (diff 2) — Sugiere más contenido, escala 0.70, z-10, en penumbra
          else if (diff === 2) {
            card.classList.remove('is-active');
            card.style.left = `calc(50% + ${step2}%)`;
            card.style.transform = 'translate3d(-50%, -50%, 0) scale(0.70)';
            card.style.opacity = '0.40';
            card.style.filter = 'brightness(0.35)';
            card.style.zIndex = '10';
            card.style.pointerEvents = 'auto';
          }
          // 6. Fuera de vista
          else {
            card.classList.remove('is-active');
            const direction = diff < 0 ? -1 : 1;
            card.style.left = `calc(50% + ${direction * 130}%)`;
            card.style.transform = 'translate3d(-50%, -50%, 0) scale(0.60)';
            card.style.opacity = '0';
            card.style.filter = 'brightness(0.2)';
            card.style.zIndex = '0';
            card.style.pointerEvents = 'none';
          }
        });

        // Actualizar dots
        dots.forEach((dot, dotIdx) => {
          if (dotIdx === currentIndex) {
            dot.className = 'tray-dot transition-all duration-300 rounded-full cursor-pointer h-1.5 focus:outline-none w-8 bg-rust-orange shadow-[0_0_8px_rgba(234,88,12,0.7)]';
          } else {
            dot.className = 'tray-dot transition-all duration-300 rounded-full cursor-pointer h-1.5 focus:outline-none w-1.5 bg-white/20 hover:bg-white/50';
          }
        });
      }

      function goTo(index: number) {
        currentIndex = (index + total) % total;
        updateLayout();
      }

      function next() {
        goTo(currentIndex + 1);
      }

      function prev() {
        goTo(currentIndex - 1);
      }

      // Event listeners para botones
      if (nextBtn) nextBtn.addEventListener('click', (e) => { e.stopPropagation(); next(); });
      if (prevBtn) prevBtn.addEventListener('click', (e) => { e.stopPropagation(); prev(); });

      // Click directo en tarjetas laterales para traerlas al centro
      cards.forEach((card, idx) => {
        card.addEventListener('click', () => {
          if (idx !== currentIndex) {
            goTo(idx);
          }
        });
      });

      // Click en dots
      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => goTo(idx));
      });

      // Resize
      window.addEventListener('resize', updateLayout);

      // Soporte Touch / Swipe
      let touchStartX = 0;
      let touchEndX = 0;
      const viewport = root.querySelector('.tray-viewport');

      if (viewport) {
        viewport.addEventListener('touchstart', (e: any) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        viewport.addEventListener('touchend', (e: any) => {
          touchEndX = e.changedTouches[0].screenX;
          const diff = touchStartX - touchEndX;
          if (Math.abs(diff) > 40) {
            if (diff > 0) next();
            else prev();
          }
        }, { passive: true });
      }

      // Inicializar
      updateLayout();
    });
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCollectionRestTrays);
    } else {
      initCollectionRestTrays();
    }
    document.addEventListener('astro:page-load', initCollectionRestTrays);
  }
</script>

<style>
  .tray-viewport {
    height: 380px;
  }
  @media (min-width: 480px) {
    .tray-viewport {
      height: 420px;
    }
  }
  @media (min-width: 640px) {
    .tray-viewport {
      height: 470px;
    }
  }
  @media (min-width: 768px) {
    .tray-viewport {
      height: 520px;
    }
  }
  @media (min-width: 1024px) {
    .tray-viewport {
      height: 560px;
    }
  }
</style>
