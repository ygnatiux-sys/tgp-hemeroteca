---
/**
 * src/components/SafeImage.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Componente de Imagen Seguro y Resiliente para Astro.
 * 
 * Intenta optimizar la imagen remota a WebP mediante `getImage()` con `inferSize`,
 * `widths` y `sizes`. Si la imagen remota falla, realiza un fallback silencioso
 * a la etiqueta <img> nativa sin interrumpir el build de Astro.
 */
import { getImage } from 'astro:assets';

interface Props {
  src: string;
  alt?: string;
  class?: string;
  style?: string;
  id?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "sync" | "auto";
  format?: "webp" | "avif" | "png" | "jpeg";
  inferSize?: boolean;
  widths?: number[];
  sizes?: string;
  'class:list'?: any;
}

const {
  src,
  alt = "",
  class: className = "",
  'class:list': classList,
  style = "",
  id,
  loading = "lazy",
  fetchpriority,
  decoding = "async",
  format = "webp",
  inferSize = true,
  widths,
  sizes,
} = Astro.props;

const rawSrc = typeof src === 'object' && src !== null && 'src' in src ? (src as any).src : src;
let finalSrc = typeof rawSrc === 'string' ? rawSrc : '';
let finalSrcSet: string | undefined = undefined;
let finalWidth: number | undefined = typeof src === 'object' && src?.width ? src.width : undefined;
let finalHeight: number | undefined = typeof src === 'object' && src?.height ? src.height : undefined;

if (finalSrc && (finalSrc.startsWith('http://') || finalSrc.startsWith('https://'))) {
  try {
    const opt = await getImage({ 
      src: finalSrc, 
      inferSize, 
      format,
      ...(widths && widths.length > 0 ? { widths } : {}),
      ...(sizes ? { sizes } : {}),
    });
    if (opt?.src) {
      finalSrc = opt.src;
      finalSrcSet = opt.srcSet?.attribute || opt.attributes?.srcset;
      finalWidth = opt.attributes?.width ? Number(opt.attributes.width) : undefined;
      finalHeight = opt.attributes?.height ? Number(opt.attributes.height) : undefined;
    }
  } catch (_err) {
    // Fallback silencioso a la URL original sin romper el build
    finalSrc = typeof rawSrc === 'string' ? rawSrc : '';
  }
}
---

{
  finalSrc ? (
    <img
      src={finalSrc}
      srcset={finalSrcSet}
      sizes={sizes}
      alt={alt}
      class:list={[className, classList]}
      style={style}
      id={id}
      width={finalWidth}
      height={finalHeight}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
    />
  ) : null
}
