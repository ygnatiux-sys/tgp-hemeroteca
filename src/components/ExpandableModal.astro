---
import { resolveMultivisionClass } from "../lib/multivision";
/**
 * ExpandableModal.astro
 * Modal estilo Netflix preparado para GSAP FLIP.
 */
---

<dialog class="expandable-modal max-w-none max-h-none m-0 p-0 bg-transparent border-0 overflow-visible backdrop:bg-black/80 backdrop:backdrop-blur-sm z-50">
  
  <!-- Contenedor Base para FLIP -->
  <div class="modal-container w-full max-w-5xl border border-white/10 rounded-xl overflow-hidden bg-black text-white shadow-2xl flex flex-col relative mx-4" data-flip-id="">
    
    <!-- Botón de Cerrar Flotante -->
    <button class="close-modal-btn absolute top-4 right-4 z-50 w-10 h-10 rounded-full bg-black/50 hover:bg-black/90 flex items-center justify-center text-white/70 hover:text-white transition-all backdrop-blur-md cursor-pointer" aria-label="Cerrar modal">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    
    <!-- Imagen Limpia (Top) -->
    <div class="relative w-full h-[60vh] min-h-100">
      <img class="modal-image absolute inset-0 img-nativa" src="" alt="Modal Hero" data-flip-id="" />
      
      <!-- Suave transición hacia la zona de lectura -->
      <div class="absolute bottom-0 w-full h-24 bg-linear-to-t from-black to-transparent pointer-events-none"></div>
    </div>

    <!-- Zona de Lectura y "Scroll Invisible" -->
    <div class="px-8 pt-2 pb-8 bg-black flex-1 relative z-20 flex flex-col items-center text-center">
      
      <!-- Título y Volanta (Movidos a la base oscura) -->
      <div class="flex flex-col items-center text-center gap-1.5 mb-8">
        <span class="modal-eyebrow text-[10px] tracking-[0.3em] uppercase text-rust-orange font-metadata font-bold hidden"></span>
        <h2 class="modal-title font-cinzel text-4xl md:text-6xl font-extrabold leading-[1.05] tracking-tight drop-shadow-2xl gradient-steel-titanium" data-flip-id="">
          <!-- Título dinámico -->
        </h2>
      </div>

      <div class="flex items-center gap-4 mb-8">
        <a class="modal-cta inline-flex items-center gap-2 px-5 py-2.5 bg-white text-black font-metadata font-bold text-[10px] tracking-[0.2em] uppercase rounded hover:bg-gray-200 transition-colors shadow-lg" href="#">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
          Leer Ensayo
        </a>
      </div>

      <div class="max-h-64 overflow-y-auto hide-scrollbar text-white/80 leading-loose text-[19px] md:text-[21px] pr-4 tracking-wide font-light py-2" style="font-family: 'Proza Libre', serif;">
        <p class="modal-excerpt">
          <!-- Segundo extracto dinámico para legibilidad -->
        </p>
      </div>
    </div>
  </div>
</dialog>

<style>
  .expandable-modal:not([open]) {
    display: none !important;
    pointer-events: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
  }
  
  .expandable-modal[open] {
    display: flex !important;
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    align-items: center !important;
    justify-content: center !important;
    pointer-events: auto !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .expandable-modal::backdrop {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .expandable-modal[open]::backdrop {
    opacity: 1;
  }

  .hide-scrollbar {
    -ms-overflow-style: none;  /* IE y Edge */
    scrollbar-width: none;     /* Firefox */
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none; /* Chrome, Safari y Opera */
  }
</style>
