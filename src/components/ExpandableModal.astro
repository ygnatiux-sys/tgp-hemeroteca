---
/**
 * ExpandableModal.astro
 * Modal estilo Netflix preparado para GSAP FLIP.
 */
---

<dialog class="expandable-modal max-w-none max-h-none m-0 p-0 bg-transparent border-0 overflow-visible backdrop:bg-black/80 backdrop:backdrop-blur-sm z-50">
  
  <!-- Contenedor Base para FLIP -->
  <div class="modal-container w-full max-w-4xl border border-white/10 rounded-xl overflow-hidden bg-black text-white shadow-2xl flex flex-col relative mx-4" data-flip-id="">
    
    <!-- Botón de Cerrar Flotante -->
    <button class="close-modal-btn absolute top-4 right-4 z-50 w-10 h-10 rounded-full bg-black/50 hover:bg-black/90 flex items-center justify-center text-white/70 hover:text-white transition-all backdrop-blur-md cursor-pointer" aria-label="Cerrar modal">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    
    <!-- Imagen Limpia (Top) -->
    <div class="relative w-full h-[50vh] min-h-87.5">
      <img class="modal-image absolute inset-0 w-full h-full object-cover" src="" alt="Modal Hero" data-flip-id="" />
      
      <!-- Bottom Scrim Limitado para legibilidad del título -->
      <div class="absolute bottom-0 w-full h-1/2 bg-linear-to-t from-black via-black/80 to-transparent pointer-events-none"></div>
      
      <!-- Información súper impuesta (Opcional, si queremos el título sobre la imagen) -->
      <div class="absolute bottom-0 inset-x-0 p-8 pt-0 pointer-events-none z-10 flex flex-col gap-2">
        <span class="modal-eyebrow text-[10px] tracking-[0.3em] uppercase text-rust-orange font-metadata font-bold hidden"></span>
        <h2 class="modal-title font-cinzel text-3xl md:text-5xl font-bold leading-tight drop-shadow-lg text-white" data-flip-id="">
          <!-- Título dinámico -->
        </h2>
      </div>
    </div>

    <!-- Zona de Lectura y "Scroll Invisible" -->
    <div class="px-8 pt-6 pb-8 bg-black flex-1 relative z-20">
      
      <div class="flex items-center gap-4 mb-6">
        <a class="modal-cta inline-flex items-center gap-2 px-5 py-2.5 bg-white text-black font-metadata font-bold text-[10px] tracking-[0.2em] uppercase rounded hover:bg-gray-200 transition-colors" href="#">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
          Leer Ensayo
        </a>
      </div>

      <div class="max-h-64 overflow-y-auto hide-scrollbar text-white/70 font-serif leading-relaxed text-sm md:text-base pr-4">
        <p class="modal-excerpt mb-4">
          <!-- Extracto dinámico -->
        </p>
      </div>
    </div>
  </div>
</dialog>

<style>
  .expandable-modal:not([open]) {
    display: none !important;
    pointer-events: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
  }
  
  .expandable-modal[open] {
    display: flex !important;
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    align-items: center !important;
    justify-content: center !important;
    pointer-events: auto !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .expandable-modal::backdrop {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .expandable-modal[open]::backdrop {
    opacity: 1;
  }

  .hide-scrollbar {
    -ms-overflow-style: none;  /* IE y Edge */
    scrollbar-width: none;     /* Firefox */
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none; /* Chrome, Safari y Opera */
  }
</style>
