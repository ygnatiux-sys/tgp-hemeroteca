---
// src/components/WikiDeveloperLightbox.astro
import type { WikiHeroImage } from './WikiCinematicHero.astro';

interface Props {
  initialQuery?: string;
  initialBatch?: WikiHeroImage[];
  cloudRunEndpoint?: string; // URL de tu servicio Cloud Run para comprimir WebP/PDF y mandar a Drive
}

const { 
  initialQuery = "Saqqara pyramid", 
  initialBatch = [],
  cloudRunEndpoint = "/api/cloudrun-magazine-export"
} = Astro.props;
---

<section 
  id="tgp-dev-workbench" 
  data-cloudrun-url={cloudRunEndpoint}
  class="w-full max-w-7xl mx-auto my-10 bg-zinc-950 border border-zinc-800 rounded-2xl shadow-2xl overflow-hidden text-zinc-100 font-sans"
>
  <!-- 1. BARRA DE CONTROL EDITORIAL APPLE TV: Buscador y Acciones -->
  <div class="p-4 sm:p-5 bg-zinc-950 border-b border-zinc-850 flex flex-col lg:flex-row gap-3 items-stretch lg:items-center justify-between">
    
    <!-- Buscador Minimalista con Botón Blanco Apple TV -->
    <div class="flex-1 flex items-center gap-2">
      <div class="relative flex-1">
        <input 
          id="wb-search-input"
          type="text" 
          value={initialQuery}
          placeholder="Buscar acervo (ej: Pirámide Acodada Dahshur, Moais, Tikal...)"
          class="w-full bg-zinc-900/90 border border-white/10 focus:border-white/30 rounded-xl pl-4 pr-24 py-2.5 text-xs sm:text-sm text-white placeholder-zinc-500 outline-none transition"
        />
        <span id="wb-translated-pill" class="hidden sm:inline-block absolute right-3 top-1/2 -translate-y-1/2 px-2 py-0.5 text-[10px] font-mono bg-white/5 text-zinc-400 border border-white/10 rounded">
          EN: Auto-Commons
        </span>
      </div>

      <button 
        id="wb-btn-new-search"
        type="button"
        class="px-4 py-2.5 rounded-xl bg-white hover:bg-zinc-200 text-black font-semibold text-xs tracking-wide transition shrink-0 cursor-pointer shadow-sm active:scale-95"
      >
        Buscar (40)
      </button>

      <button 
        id="wb-btn-clean-search"
        type="button"
        title="Limpiar búsqueda"
        class="px-3 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-zinc-400 hover:text-white border border-white/10 text-xs font-mono transition shrink-0 cursor-pointer"
      >
        Limpiar
      </button>
    </div>

    <!-- Acciones de Selección Editorial Monocromáticas -->
    <div class="flex items-center gap-1.5 text-xs font-mono">
      <button id="wb-select-top12" type="button" class="px-3 py-2 rounded-lg bg-white/10 hover:bg-white/20 border border-white/15 text-white font-medium cursor-pointer transition">
        Top 12 Revista
      </button>
      <button id="wb-select-all" type="button" class="px-3 py-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-zinc-300 hover:text-white cursor-pointer transition">
        Todas (40)
      </button>
      <button id="wb-deselect-all" type="button" class="px-3 py-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-zinc-400 hover:text-white cursor-pointer transition">
        Desmarcar
      </button>
    </div>
  </div>

  <!-- 2. BARRA DE FILTROS Y PIPELINE DE EXPORTACIÓN (Estética Apple TV) -->
  <div class="px-4 sm:px-5 py-2.5 bg-zinc-900/40 border-b border-zinc-850 flex flex-wrap items-center justify-between gap-3 text-xs">
    
    <!-- Filtros Rápidos Segmentados -->
    <div class="inline-flex items-center p-1 rounded-xl bg-black/60 border border-white/10 text-xs font-mono">
      <button data-filter="all" class="wb-filter-pill px-3 py-1 rounded-lg bg-white text-black font-semibold cursor-pointer transition">
        Todas (<span id="count-all">{initialBatch.length}</span>)
      </button>
      <button data-filter="cc0" class="wb-filter-pill px-3 py-1 rounded-lg text-zinc-400 hover:text-white font-medium cursor-pointer transition">
        Solo CC0
      </button>
      <button data-filter="landscape" class="wb-filter-pill px-3 py-1 rounded-lg text-zinc-400 hover:text-white font-medium cursor-pointer transition">
        Panorámicas (≥16:10)
      </button>
    </div>

    <!-- Indicador de Selección y Acciones -->
    <div class="flex items-center gap-3">
      <div class="font-mono text-xs text-zinc-400">
        <span class="text-zinc-500">Selección:</span> <strong id="wb-selected-count" class="text-white">0</strong>
        <span id="wb-weight-estimator" class="ml-1 text-[11px] text-zinc-400">
          (~0 MB)
        </span>
      </div>

      <!-- Enviar a Hero Cinemax (Blanco Apple TV) -->
      <button 
        id="wb-btn-push-hero"
        type="button"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-white hover:bg-zinc-200 text-black font-semibold text-xs transition cursor-pointer shadow-sm active:scale-95"
      >
        <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <span>Enviar a Hero</span>
      </button>

      <!-- Guardar Array en Nodo / Flecha D1 -->
      <button 
        id="wb-btn-save-d1"
        type="button"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-sky-500/20 hover:bg-sky-500/30 text-sky-300 border border-sky-400/40 font-semibold text-xs transition cursor-pointer shadow-sm active:scale-95"
        title="Guardar imágenes seleccionadas en formato array JSON para nodos o flechas D1"
      >
        <span>🧩 Guardar Array en Nodo / Flecha D1</span>
      </button>

      <!-- Menú Desplegable de Exportación en Vidrio Ahumado -->
      <div class="relative">
        <button 
          id="wb-export-dropdown-btn"
          type="button"
          class="px-3.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 border border-white/15 text-zinc-200 hover:text-white font-medium flex items-center gap-1.5 cursor-pointer transition"
        >
          <span>Exportar</span>
          <span class="text-[10px] text-zinc-400">▼</span>
        </button>

        <div 
          id="wb-export-drawer"
          class="hidden absolute right-0 mt-2 w-80 bg-zinc-950/95 border border-zinc-800 rounded-xl shadow-2xl p-2 z-50 text-xs backdrop-blur-xl"
        >
          <div class="px-3 py-1.5 text-[10px] font-mono uppercase tracking-wider text-zinc-500 border-b border-zinc-800/80">
            Exportación Editorial Cloud Run
          </div>

          <button 
            data-action="zip-desktop-dual"
            class="wb-cloud-action w-full text-left px-3 py-2.5 hover:bg-zinc-900 rounded-lg flex items-start gap-2.5 transition cursor-pointer"
          >
            <span class="text-zinc-300">📦</span>
            <div>
              <div class="font-medium text-white">Descargar .ZIP a mi Escritorio</div>
              <div class="text-[11px] text-zinc-400">WebP ultraligero + Hoja de contacto PDF con licencias.</div>
            </div>
          </button>

          <button 
            data-action="drive-magazine-folder"
            class="wb-cloud-action w-full text-left px-3 py-2.5 hover:bg-zinc-900 rounded-lg flex items-start gap-2.5 transition cursor-pointer"
          >
            <span class="text-zinc-300">📁</span>
            <div>
              <div class="font-medium text-white">Enviar a Google Drive (Asset Magazine)</div>
              <div class="text-[11px] text-zinc-400">Guarda lote .WebP + PDF en carpeta Drive de la revista.</div>
            </div>
          </button>

          <div class="my-1 border-t border-zinc-800/80"></div>

          <button 
            data-action="copy-mdx-manifest"
            class="wb-cloud-action w-full text-left px-3 py-2 hover:bg-zinc-900 rounded-lg flex items-center justify-between text-zinc-300 font-mono cursor-pointer transition"
          >
            <span>📋 Copiar Array JSON / MDX</span>
            <span class="text-[10px] px-1.5 py-0.5 bg-zinc-800 text-zinc-400 rounded">Local</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. VIEWPORT DE 12 FOTOS VISIBLES CON SCROLLBAR HASTA LAS 40 -->
  <!-- 4 columnas x 3 filas visibles (~690px de alto) con scroll suave hacia abajo para ver las 40 -->
  <div 
    id="wb-grid-viewport"
    class="p-5 max-h-175 overflow-y-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 scroll-smooth"
  >
    {initialBatch.map((img, idx) => {
      const isCC0 = /cc0|public domain|pd/i.test(img.license || '') || Boolean(img.isCC0OrPublicDomain);
      const ratio = (img.width && img.height) ? (img.width / img.height).toFixed(2) : '1.50';
      // Ritmo editorial por fila: Fila 0, 2 (pares) = 3:4, Fila 1, 3 (impares) = 4:5
      const aspectClass = Math.floor(idx / 4) % 2 === 0 ? 'aspect-3/4' : 'aspect-4/5';
      return (
        <article 
          class="wb-card group relative bg-zinc-900 border border-zinc-800 hover:border-amber-400/60 rounded-xl overflow-hidden flex flex-col transition"
          data-id={img.id}
          data-index={idx}
          data-cc0={isCC0 ? 'true' : 'false'}
          data-landscape={Number(ratio) >= 1.3 ? 'true' : 'false'}
          data-json={JSON.stringify(img)}
        >
          <!-- Miniatura con Ritmo Editorial + Checkbox individual + Botón Zoom Lightbox -->
          <div class={`relative ${aspectClass} w-full bg-black overflow-hidden`}>
            <img 
              src={img.thumbUrl || img.url} 
              alt={img.title}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
            />
            
            <!-- Número de orden (#01 a #40) -->
            <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-black/75 text-[10px] font-mono text-zinc-300">
              #{String(idx + 1).padStart(2, '0')}
            </span>

            <!-- Checkbox de Selección Individual -->
            <label class="absolute top-2 right-2 z-10 flex items-center justify-center w-7 h-7 rounded-lg bg-black/80 border border-white/20 cursor-pointer hover:border-amber-400">
              <input 
                type="checkbox" 
                class="wb-card-checkbox w-4 h-4 accent-amber-400 cursor-pointer"
                checked={idx < 12}
              />
            </label>

            <!-- Botón central para abrir el Lightbox de Inspección -->
            <button 
              type="button"
              class="wb-open-lightbox opacity-0 group-hover:opacity-100 absolute inset-0 bg-black/45 flex items-center justify-center transition cursor-pointer"
            >
              <span class="px-3 py-1.5 rounded-full bg-black/85 border border-white/20 text-xs font-mono text-white">
                🔍 Inspeccionar HD
              </span>
            </button>
          </div>

          <!-- PILL VISOR INFERIOR: Créditos CC0 / CC-BY y Dimensiones -->
          <div class="p-2.5 flex flex-col gap-1.5 justify-between flex-1 bg-zinc-900">
            <div class="text-xs font-medium text-zinc-200 truncate" title={img.title}>
              {img.cleanTitle || img.title.replace(/^File:/i, '')}
            </div>

            <div class="flex items-center justify-between gap-1 text-[10px] font-mono">
              <!-- Pill de Licencia con color semántico -->
              <span class={`px-2 py-0.5 rounded-full font-semibold truncate ${
                isCC0 
                  ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30' 
                  : 'bg-sky-500/15 text-sky-300 border border-sky-500/30'
              }`}>
                {img.licenseShortName || img.license || 'CC-BY-SA'}
              </span>

              <span class="text-zinc-400 shrink-0">
                {img.width}×{img.height}
              </span>
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <!-- 4. MODAL LIGHTBOX / VISOR CENTRADO DE ALTA FIDELIDAD (75/25 Protagonismo Visual) -->
  <dialog 
    id="wb-lightbox-modal" 
    class="backdrop:bg-black/95 backdrop:backdrop-blur-md bg-transparent text-white border-none max-w-[98vw] w-[98vw] max-h-[97vh] h-[97vh] p-0 overflow-hidden shadow-2xl focus:outline-none"
  >
    <div class="relative w-full h-[97vh] max-h-[97vh] bg-zinc-950/95 border border-zinc-800 rounded-2xl flex flex-col lg:flex-row overflow-hidden shadow-[0_0_80px_rgba(0,0,0,0.9)]">
      
      <!-- Zona Principal de Imagen (76% ancho, 93vh máx, object-contain, zonas de clic y scroll) -->
      <div id="lb-modal-stage" class="relative flex-1 lg:w-[76%] xl:w-[78%] bg-black flex items-center justify-center p-1 sm:p-2 select-none overflow-hidden group/modal-stage">
        <img 
          id="lb-modal-img" 
          src="" 
          alt="" 
          class="max-h-[93vh] max-w-full w-auto h-auto object-contain rounded-md shadow-2xl transition-opacity duration-300" 
        />

        <!-- Zona de Clic Izquierda (Foto Anterior) -->
        <div 
          id="lb-nav-prev" 
          class="absolute inset-y-0 left-0 w-1/2 cursor-w-resize flex items-center justify-start pl-4 group/prev z-10"
          title="Foto anterior (o flecha izquierda / scroll arriba)"
        >
          <div class="w-10 h-10 rounded-full bg-black/60 border border-white/20 text-white flex items-center justify-center opacity-0 group-hover/prev:opacity-100 transition shadow-lg backdrop-blur-sm pointer-events-none text-xl font-bold">
            ‹
          </div>
        </div>

        <!-- Zona de Clic Derecha (Foto Siguiente) -->
        <div 
          id="lb-nav-next" 
          class="absolute inset-y-0 right-0 w-1/2 cursor-e-resize flex items-center justify-end pr-4 group/next z-10"
          title="Foto siguiente (o flecha derecha / scroll abajo)"
        >
          <div class="w-10 h-10 rounded-full bg-black/60 border border-white/20 text-white flex items-center justify-center opacity-0 group-hover/next:opacity-100 transition shadow-lg backdrop-blur-sm pointer-events-none text-xl font-bold">
            ›
          </div>
        </div>

        <!-- Toolbar Superior en el Visor: Contador + Control de Pase Automático -->
        <div class="absolute top-3 left-3 z-20 flex items-center gap-2">
          <div class="px-3 py-1 rounded-full bg-black/75 border border-white/15 text-[11px] font-mono text-zinc-300 backdrop-blur-sm">
            <span id="lb-modal-counter">01 / 40</span>
          </div>
          <button 
            id="lb-modal-autoplay" 
            type="button" 
            class="px-3 py-1 rounded-full bg-black/75 hover:bg-zinc-800 border border-white/15 hover:border-amber-400 text-[11px] font-mono text-zinc-300 hover:text-white backdrop-blur-sm transition flex items-center gap-1.5 cursor-pointer shadow-lg active:scale-95"
            title="Iniciar / Pausar pase automático (4.5s)"
          >
            <span id="lb-autoplay-icon" class="w-2 h-2 rounded-full bg-zinc-500"></span>
            <span id="lb-autoplay-label">▶ Auto (4.5s)</span>
          </button>
        </div>
      </div>

      <!-- Panel Lateral de Metadatos y Selección (22-24% Ancho) -->
      <div class="w-full lg:w-[24%] xl:w-[22%] min-w-65 max-w-85 p-4 sm:p-5 flex flex-col justify-between bg-zinc-950/95 border-t lg:border-t-0 lg:border-l border-zinc-800/80 shrink-0">
        <div class="space-y-4 overflow-y-auto pr-1">
          <div class="flex items-center justify-between">
            <span id="lb-modal-license" class="px-2.5 py-1 rounded-full text-xs font-mono bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
              CC0
            </span>
            <button id="lb-modal-close" class="px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white font-mono text-xs cursor-pointer border border-zinc-700 transition">
              ✕ Cerrar (ESC)
            </button>
          </div>
          <h3 id="lb-modal-title" class="font-bold text-base sm:text-lg text-white wrap-break-word leading-snug"></h3>
          <p id="lb-modal-desc" class="text-xs text-zinc-400 leading-relaxed max-h-36 overflow-y-auto"></p>
          <div class="p-3 rounded-xl bg-zinc-900 border border-zinc-800 font-mono text-xs space-y-1.5 text-zinc-300">
            <div>Autor: <strong id="lb-modal-author" class="text-white"></strong></div>
            <div>Resolución: <strong id="lb-modal-dims" class="text-amber-300"></strong></div>
            <div class="text-[11px] text-zinc-500 pt-1 border-t border-zinc-800/80">Rueda del ratón (scroll), clic o flechas ← →</div>
          </div>
        </div>

        <div class="pt-4 border-t border-zinc-800 flex flex-col gap-2">
          <button id="lb-modal-toggle-select" type="button" class="w-full py-2.5 rounded-xl bg-white hover:bg-zinc-200 text-black font-semibold text-xs cursor-pointer transition shadow-sm active:scale-95">
            + Incluir en Revista
          </button>
        </div>
      </div>

    </div>
  </dialog>
  <!-- 5. DIALOG / MODAL DE EXPORTACIÓN Y CONFIRMACIÓN A CLOUDFLARE D1 -->
  <dialog 
    id="wb-d1-modal" 
    class="backdrop:bg-black/85 backdrop:backdrop-blur-md bg-transparent text-white border-none max-w-2xl w-[92vw] p-0 overflow-hidden shadow-2xl focus:outline-none"
  >
    <div class="relative bg-zinc-950 border border-sky-500/40 rounded-2xl p-5 sm:p-6 shadow-[0_0_50px_rgba(56,189,248,0.2)] flex flex-col gap-4">
      <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">🧩</span>
          <h3 class="font-bold text-sm sm:text-base text-sky-300 font-mono">
            Array JSON para Cloudflare D1
          </h3>
        </div>
        <button id="wb-d1-close-btn" type="button" class="px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-mono text-xs cursor-pointer border border-zinc-700 transition">
          ✕ Cerrar
        </button>
      </div>

      <div class="flex items-center justify-between gap-3 text-xs font-mono text-zinc-300">
        <div>
          Imágenes marcadas: <strong id="wb-d1-items-count" class="text-white">0</strong>
        </div>
        <div class="flex items-center gap-2">
          <label class="flex items-center gap-1.5 cursor-pointer text-sky-200">
            <input type="radio" name="d1-target-mode" value="node" checked class="accent-sky-400 cursor-pointer" />
            <span>images_array_json (Nodo)</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer text-amber-200">
            <input type="radio" name="d1-target-mode" value="edge" class="accent-amber-400 cursor-pointer" />
            <span>edge_images_array_json (Flecha)</span>
          </label>
        </div>
      </div>

      <div class="relative">
        <textarea 
          id="wb-d1-json-preview" 
          readonly 
          rows="10" 
          class="w-full bg-zinc-900/90 border border-zinc-800 rounded-xl p-3 text-xs font-mono text-zinc-200 selection:bg-sky-500 selection:text-black outline-none resize-none"
        ></textarea>
        <span id="wb-d1-copied-badge" class="hidden absolute top-3 right-3 px-2 py-1 rounded bg-emerald-500 text-black font-mono font-bold text-[10px] shadow">
          ✓ ¡COPIADO AL PORTAPAPELES!
        </span>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2 border-t border-zinc-800">
        <span class="text-[11px] text-zinc-500 font-mono">
          Listo para inyectar vía scripts/db-tools/query_d1.js o /api/cypher-extract
        </span>
        <button 
          id="wb-d1-copy-btn" 
          type="button" 
          class="w-full sm:w-auto px-4 py-2 rounded-xl bg-sky-400 hover:bg-sky-300 text-black font-semibold text-xs font-mono cursor-pointer transition shadow-sm active:scale-95"
        >
          📋 Copiar JSON al Portapapeles
        </button>
      </div>
    </div>
  </dialog>
</section>

<style>
  /* Scrollbar oscura refinada */
  #wb-grid-viewport::-webkit-scrollbar {
    width: 6px;
  }
  #wb-grid-viewport::-webkit-scrollbar-track {
    background: rgba(24, 24, 27, 0.6);
    border-radius: 9999px;
  }
  #wb-grid-viewport::-webkit-scrollbar-thumb {
    background: rgba(245, 158, 11, 0.35);
    border-radius: 9999px;
  }
  #wb-grid-viewport::-webkit-scrollbar-thumb:hover {
    background: rgba(245, 158, 11, 0.7);
  }
</style>

<script>
  function initWorkbench() {
    const root = document.getElementById("tgp-dev-workbench");
    if (!root) return;

    const cloudRunUrl = root.getAttribute("data-cloudrun-url") || "/api/cloudrun-magazine-export";
    const cards = () => Array.from(root.querySelectorAll<HTMLElement>(".wb-card"));
    const checkboxes = () => Array.from(root.querySelectorAll<HTMLInputElement>(".wb-card-checkbox"));

    const selectedCountEl = document.getElementById("wb-selected-count");
    const weightEstimatorEl = document.getElementById("wb-weight-estimator");

    function getSelectedItems() {
      const selected: any[] = [];
      cards().forEach((card) => {
        const cb = card.querySelector<HTMLInputElement>(".wb-card-checkbox");
        if (cb && cb.checked && card.style.display !== "none") {
          const raw = card.getAttribute("data-json");
          if (raw) selected.push(JSON.parse(raw));
        }
      });
      return selected;
    }

    function updateCounters() {
      const items = getSelectedItems();
      if (selectedCountEl) selectedCountEl.textContent = String(items.length);
      // Estimación: ~180 KB por imagen optimizada a WebP en Cloud Run vs ~3.5 MB original
      const webpMb = (items.length * 0.18).toFixed(1);
      if (weightEstimatorEl) weightEstimatorEl.textContent = `(~${webpMb} MB en .WebP comprimido)`;

      const countAllEl = document.getElementById("count-all");
      if (countAllEl) countAllEl.textContent = String(cards().length);
    }

    // Eventos de checkboxes individuales
    root.addEventListener("change", (e) => {
      if ((e.target as HTMLElement).classList.contains("wb-card-checkbox")) {
        updateCounters();
      }
    });

    // Select All / Top 12 / Deselect All
    document.getElementById("wb-select-all")?.addEventListener("click", () => {
      cards().forEach((c) => {
        if (c.style.display !== "none") {
          const cb = c.querySelector<HTMLInputElement>(".wb-card-checkbox");
          if (cb) cb.checked = true;
        }
      });
      updateCounters();
    });

    document.getElementById("wb-select-top12")?.addEventListener("click", () => {
      let count = 0;
      cards().forEach((c) => {
        const cb = c.querySelector<HTMLInputElement>(".wb-card-checkbox");
        if (!cb) return;
        if (c.style.display !== "none" && count < 12) {
          cb.checked = true;
          count++;
        } else {
          cb.checked = false;
        }
      });
      updateCounters();
    });

    document.getElementById("wb-deselect-all")?.addEventListener("click", () => {
      checkboxes().forEach((cb) => (cb.checked = false));
      updateCounters();
    });

    // Clean Search
    document.getElementById("wb-btn-clean-search")?.addEventListener("click", () => {
      const input = document.getElementById("wb-search-input") as HTMLInputElement;
      if (input) {
        input.value = "";
        input.focus();
      }
      checkboxes().forEach((cb) => (cb.checked = false));
      updateCounters();
    });

    // ─────────────────────────────────────────────────────────────────────────
    // NEW SEARCH (40): LLAMADA DINÁMICA AL MOTOR PRE-FETCH CON CIRRUSSEARCH
    // ─────────────────────────────────────────────────────────────────────────
    document.getElementById("wb-btn-new-search")?.addEventListener("click", async () => {
      const input = document.getElementById("wb-search-input") as HTMLInputElement;
      const btn = document.getElementById("wb-btn-new-search") as HTMLButtonElement;
      const query = input?.value.trim();
      if (!query) return;

      const originalBtnText = btn.innerHTML;
      btn.innerHTML = `<span class="inline-block animate-spin mr-1">↻</span> Buscando 40...`;
      btn.disabled = true;

      try {
        const res = await fetch(`/api/wiki-curator-search?query=${encodeURIComponent(query)}&limit=40`);
        if (!res.ok) throw new Error("Error en el motor pre-fetch");
        const data = await res.json();

        if (Array.isArray(data.images) && data.images.length > 0) {
          // Actualizar píldora de traducción en inglés de Commons
          const pill = document.getElementById("wb-translated-pill");
          if (pill && data.searchTermEnglish) {
            pill.textContent = `EN: ${data.searchTermEnglish}`;
            pill.classList.remove("hidden");
          }

          // Re-renderizar las tarjetas en la grilla con ritmo editorial 3:4 y 4:5
          const grid = document.getElementById("wb-grid-viewport");
          if (grid) {
            grid.innerHTML = data.images.map((img: any, idx: number) => {
              const isCC0 = /cc0|public domain|pd/i.test(img.licenseShortName || img.license || '') || Boolean(img.isCC0OrPublicDomain);
              const ratio = (img.width && img.height) ? (img.width / img.height).toFixed(2) : '1.50';
              const aspectClass = Math.floor(idx / 4) % 2 === 0 ? 'aspect-3/4' : 'aspect-4/5';
              return `
                <article 
                  class="wb-card group relative bg-zinc-900 border border-zinc-800 hover:border-amber-400/60 rounded-xl overflow-hidden flex flex-col transition"
                  data-id="${img.id}"
                  data-index="${idx}"
                  data-cc0="${isCC0 ? 'true' : 'false'}"
                  data-landscape="${Number(ratio) >= 1.3 ? 'true' : 'false'}"
                  data-json='${JSON.stringify(img).replace(/'/g, "&apos;")}'
                >
                  <div class="relative ${aspectClass} w-full bg-black overflow-hidden">
                    <img 
                      src="${img.thumbUrl || img.url}" 
                      alt="${img.cleanTitle || img.title}"
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                    />
                    <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-black/75 text-[10px] font-mono text-zinc-300">
                      #${String(idx + 1).padStart(2, '0')}
                    </span>
                    <label class="absolute top-2 right-2 z-10 flex items-center justify-center w-7 h-7 rounded-lg bg-black/80 border border-white/20 cursor-pointer hover:border-amber-400">
                      <input 
                        type="checkbox" 
                        class="wb-card-checkbox w-4 h-4 accent-amber-400 cursor-pointer"
                        ${idx < 12 ? 'checked' : ''}
                      />
                    </label>
                    <button 
                      type="button"
                      class="wb-open-lightbox opacity-0 group-hover:opacity-100 absolute inset-0 bg-black/45 flex items-center justify-center transition cursor-pointer"
                    >
                      <span class="px-3 py-1.5 rounded-full bg-black/85 border border-white/20 text-xs font-mono text-white">
                        🔍 Inspeccionar HD
                      </span>
                    </button>
                  </div>
                  <div class="p-2.5 flex flex-col gap-1.5 justify-between flex-1 bg-zinc-900">
                    <div class="text-xs font-medium text-zinc-200 truncate" title="${img.cleanTitle || img.title}">
                      ${img.cleanTitle || img.title.replace(/^File:/i, '')}
                    </div>
                    <div class="flex items-center justify-between gap-1 text-[10px] font-mono">
                      <span class="px-2 py-0.5 rounded-full font-semibold truncate ${
                        isCC0 
                          ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30' 
                          : 'bg-sky-500/15 text-sky-300 border border-sky-500/30'
                      }">
                        ${img.licenseShortName || img.license || 'CC-BY-SA'}
                      </span>
                      <span class="text-zinc-400 shrink-0">
                        ${img.width}×${img.height}
                      </span>
                    </div>
                  </div>
                </article>
              `;
            }).join('');

            bindCardEvents();
            updateCounters();

            // Auto-probar en Hero los Top 12 del nuevo lote
            const top12 = data.images.slice(0, 12);
            window.dispatchEvent(
              new CustomEvent("tgp:preview-batch", {
                detail: { images: top12, queryTitle: query }
              })
            );
          }
        }
      } catch (err) {
        console.error("Error en búsqueda:", err);
      } finally {
        btn.innerHTML = originalBtnText;
        btn.disabled = false;
      }
    });

    // Filtros rápidos (Todas / CC0 / Horizontal)
    root.querySelectorAll<HTMLElement>(".wb-filter-pill").forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter");
        cards().forEach((card) => {
          const isCC0 = card.getAttribute("data-cc0") === "true";
          const isLandscape = card.getAttribute("data-landscape") === "true";
          const show =
            filter === "all" ||
            (filter === "cc0" && isCC0) ||
            (filter === "landscape" && isLandscape);
          card.style.display = show ? "flex" : "none";
        });

        // Estilos activos (Segmented Apple TV)
        root.querySelectorAll<HTMLElement>(".wb-filter-pill").forEach(p => {
          p.className = "wb-filter-pill px-3 py-1 rounded-lg text-zinc-400 hover:text-white font-medium cursor-pointer transition text-xs font-mono";
        });
        btn.className = "wb-filter-pill px-3 py-1 rounded-lg bg-white text-black font-semibold cursor-pointer transition text-xs font-mono shadow-xs";

        updateCounters();
      });
    });

    // Sincronizar con el Hero Cinemax de arriba
    document.getElementById("wb-btn-push-hero")?.addEventListener("click", () => {
      const selected = getSelectedItems();
      const input = document.getElementById("wb-search-input") as HTMLInputElement;
      if (selected.length === 0) return alert("Seleccioná al menos 1 imagen para enviarla al Hero.");
      window.dispatchEvent(
        new CustomEvent("tgp:preview-batch", {
          detail: { images: selected, queryTitle: input?.value || "Colección Curada" }
        })
      );
      document.getElementById("wiki-cinematic-hero")?.scrollIntoView({ behavior: "smooth" });
    });

    // ─────────────────────────────────────────────────────────────────────────
    // GUARDAR ARRAY EN NODO / FLECHA CLOUDFLARE D1
    // ─────────────────────────────────────────────────────────────────────────
    const d1Modal = document.getElementById("wb-d1-modal") as HTMLDialogElement | null;
    const d1Textarea = document.getElementById("wb-d1-json-preview") as HTMLTextAreaElement | null;
    const d1Count = document.getElementById("wb-d1-items-count");
    const d1CopyBtn = document.getElementById("wb-d1-copy-btn");
    const d1CloseBtn = document.getElementById("wb-d1-close-btn");
    const d1CopiedBadge = document.getElementById("wb-d1-copied-badge");
    const d1RadioModes = Array.from(root.querySelectorAll<HTMLInputElement>("input[name='d1-target-mode']"));

    function formatD1ArrayPayload(targetMode: string = "node") {
      const selected = getSelectedItems();
      const cleanArray = selected.map((img) => ({
        url: img.url,
        thumbUrl: img.thumbUrl || img.url,
        title: img.cleanTitle || img.title?.replace(/^File:/i, "") || "Imagen D1",
        author: img.author || "Wikimedia Commons",
        license: img.licenseShortName || img.license || "CC0",
        aspectRatio: (img.width && img.height) ? Number((img.width / img.height).toFixed(2)) : 1.5,
        width: img.width || 1200,
        height: img.height || 800,
        role: targetMode === "edge" ? "edge_illustration" : "node_gallery"
      }));

      const fieldName = targetMode === "edge" ? "edge_images_array_json" : "images_array_json";
      return {
        fieldName,
        count: cleanArray.length,
        jsonString: JSON.stringify(cleanArray, null, 2),
        rawArray: cleanArray
      };
    }

    function refreshD1Preview() {
      if (!d1Modal?.open) return;
      const selectedMode = d1RadioModes.find((r) => r.checked)?.value || "node";
      const payload = formatD1ArrayPayload(selectedMode);
      if (d1Count) d1Count.textContent = `${payload.count} (${payload.fieldName})`;
      if (d1Textarea) d1Textarea.value = payload.jsonString;
    }

    d1RadioModes.forEach((radio) => {
      radio.addEventListener("change", refreshD1Preview);
    });

    document.getElementById("wb-btn-save-d1")?.addEventListener("click", async () => {
      const selected = getSelectedItems();
      if (selected.length === 0) {
        return alert("Seleccioná al menos 1 imagen con el checkbox para guardar en D1.");
      }

      const selectedMode = d1RadioModes.find((r) => r.checked)?.value || "node";
      const payload = formatD1ArrayPayload(selectedMode);

      if (d1Count) d1Count.textContent = `${payload.count} (${payload.fieldName})`;
      if (d1Textarea) d1Textarea.value = payload.jsonString;

      // Copiar automáticamente al portapapeles
      try {
        await navigator.clipboard.writeText(payload.jsonString);
        if (d1CopiedBadge) {
          d1CopiedBadge.classList.remove("hidden");
          setTimeout(() => d1CopiedBadge?.classList.add("hidden"), 3000);
        }
      } catch (e) {
        console.warn("No se pudo copiar automáticamente:", e);
      }

      // Disparar evento global para componentes de grafo / Scriptorium
      window.dispatchEvent(
        new CustomEvent("tgp:save-d1-array", {
          detail: {
            target: selectedMode,
            fieldName: payload.fieldName,
            images: payload.rawArray
          }
        })
      );

      d1Modal?.showModal();
    });

    d1CopyBtn?.addEventListener("click", async () => {
      if (d1Textarea) {
        await navigator.clipboard.writeText(d1Textarea.value);
        if (d1CopiedBadge) {
          d1CopiedBadge.classList.remove("hidden");
          setTimeout(() => d1CopiedBadge?.classList.add("hidden"), 2500);
        }
      }
    });

    d1CloseBtn?.addEventListener("click", () => d1Modal?.close());
    d1Modal?.addEventListener("click", (e) => {
      if (e.target === d1Modal) d1Modal.close();
    });

    // Botonera desplegable Cloud Run
    const dropdownBtn = document.getElementById("wb-export-dropdown-btn");
    const drawer = document.getElementById("wb-export-drawer");
    dropdownBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      drawer?.classList.toggle("hidden");
    });

    document.addEventListener("click", (e) => {
      if (!dropdownBtn?.contains(e.target as Node) && !drawer?.contains(e.target as Node)) {
        drawer?.classList.add("hidden");
      }
    });

    // Acciones del Drawer (ZIP 2 vías, Drive Magazine Folder, Copy MDX)
    root.querySelectorAll<HTMLElement>(".wb-cloud-action").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const action = btn.getAttribute("data-action");
        const selected = getSelectedItems();
        const query = (document.getElementById("wb-search-input") as HTMLInputElement)?.value || "tgp-batch";

        if (selected.length === 0) return alert("Seleccioná al menos una imagen primero.");

        if (action === "copy-mdx-manifest") {
          const mdxSnippet = `---
title: "Galería Curada ${query}"
galeriaTgp:
${selected.map(img => `  - url: "${img.url}"\n    titulo: "${(img.cleanTitle || img.title).replace(/"/g, '\\"')}"\n    autor: "${(img.author || 'Wikimedia').replace(/"/g, '\\"')}"\n    licencia: "${img.licenseShortName || img.license || 'PD'}"\n    aspectRatio: ${(img.width && img.height) ? (img.width / img.height).toFixed(2) : 1.5}`).join('\n')}
---`;
          await navigator.clipboard.writeText(mdxSnippet);
          drawer?.classList.add("hidden");
          return alert(`Copiadas ${selected.length} imágenes en formato MDX / Frontmatter.`);
        }

        // Llamada al servicio en Cloud Run para comprimir a WebP + PDF o subir a Drive
        try {
          btn.style.opacity = "0.5";
          const res = await fetch(cloudRunUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              action, // 'zip-desktop-dual' | 'drive-magazine-folder'
              collectionName: query,
              formats: ["webp", "pdf-contact-sheet"],
              webpQuality: 82,
              images: selected
            })
          });

          if (action === "zip-desktop-dual" && res.ok) {
            const blob = await res.blob();
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = `${query.toLowerCase().replace(/\s+/g, "-")}-webp-and-pdf.zip`;
            a.click();
            URL.revokeObjectURL(url);
          } else if (action === "drive-magazine-folder" && res.ok) {
            const data = await res.json();
            alert(`Lote enviado a tu carpeta Asset Magazine en Google Drive: ${data.data?.targetFolder || "OK"}`);
          } else {
            const errData = await res.json().catch(() => ({}));
            alert(`Error: ${errData.error || "No se pudo completar la acción"}`);
          }
        } catch (err) {
          console.error("Error comunicando con Cloud Run:", err);
          alert("Error comunicando con el servicio Cloud Run.");
        } finally {
          btn.style.opacity = "1";
          drawer?.classList.add("hidden");
        }
      });
    });

    // Lightbox Modal de Inspección Secuencial (Máxima Fidelidad + Clics en Mitades + Autoplay + Wheel)
    const modal = document.getElementById("wb-lightbox-modal") as HTMLDialogElement;
    let activeCardCheckbox: HTMLInputElement | null = null;
    let currentModalIndex = 0;
    let autoplayTimer: any = null;
    let isAutoplayActive = true;
    const AUTOPLAY_INTERVAL = 4500; // 4.5s velocidad normal agradable

    function updateAutoplayUI() {
      const icon = document.getElementById("lb-autoplay-icon");
      const label = document.getElementById("lb-autoplay-label");
      const btn = document.getElementById("lb-modal-autoplay");
      if (!icon || !label || !btn) return;

      if (isAutoplayActive) {
        icon.className = "w-2 h-2 rounded-full bg-emerald-400 animate-pulse";
        label.textContent = "⏸ Pausar";
        btn.classList.add("border-emerald-500/50", "text-emerald-300");
      } else {
        icon.className = "w-2 h-2 rounded-full bg-zinc-500";
        label.textContent = "▶ Auto (4.5s)";
        btn.classList.remove("border-emerald-500/50", "text-emerald-300");
      }
    }

    function startAutoplay() {
      isAutoplayActive = true;
      updateAutoplayUI();
      resetAutoplayTimer();
    }

    function stopAutoplay() {
      isAutoplayActive = false;
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
      updateAutoplayUI();
    }

    function resetAutoplayTimer() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
      if (!isAutoplayActive || !modal?.open) return;
      autoplayTimer = setInterval(() => {
        if (modal?.open) {
          renderModalSlide(currentModalIndex + 1);
        } else {
          stopAutoplay();
        }
      }, AUTOPLAY_INTERVAL);
    }

    function getVisibleCardsData() {
      const visibleCards = cards().filter((c) => c.style.display !== "none");
      return visibleCards.map((card) => {
        const raw = card.getAttribute("data-json");
        return {
          card,
          data: raw ? JSON.parse(raw) : {}
        };
      });
    }

    function renderModalSlide(index: number) {
      const list = getVisibleCardsData();
      if (!list.length) return;
      currentModalIndex = (index + list.length) % list.length;
      const { card, data } = list[currentModalIndex];
      activeCardCheckbox = card.querySelector<HTMLInputElement>(".wb-card-checkbox");

      const imgEl = document.getElementById("lb-modal-img") as HTMLImageElement;
      if (imgEl) {
        imgEl.style.opacity = "0.2";
        imgEl.src = data.url || data.thumbUrl;
        imgEl.onload = () => { imgEl.style.opacity = "1"; };
      }

      const counterEl = document.getElementById("lb-modal-counter");
      if (counterEl) {
        counterEl.textContent = `${String(currentModalIndex + 1).padStart(2, '0')} / ${String(list.length).padStart(2, '0')}`;
      }

      const titleEl = document.getElementById("lb-modal-title");
      if (titleEl) titleEl.textContent = data.cleanTitle || data.title?.replace(/^File:/i, "") || "";

      const descEl = document.getElementById("lb-modal-desc");
      if (descEl) descEl.textContent = data.description || "Sin descripción adicional.";

      const authorEl = document.getElementById("lb-modal-author");
      if (authorEl) authorEl.textContent = data.author || "Wikimedia Commons";

      const dimsEl = document.getElementById("lb-modal-dims");
      if (dimsEl) dimsEl.textContent = `${data.width} × ${data.height} px`;

      const licenseEl = document.getElementById("lb-modal-license");
      if (licenseEl) {
        licenseEl.textContent = data.licenseShortName || data.license || "CC";
      }

      const toggleBtn = document.getElementById("lb-modal-toggle-select");
      if (toggleBtn && activeCardCheckbox) {
        toggleBtn.textContent = activeCardCheckbox.checked ? "✓ Incluida en Revista" : "+ Incluir en Revista";
        toggleBtn.className = activeCardCheckbox.checked
          ? "w-full py-2.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-medium text-xs border border-white/20 cursor-pointer transition shadow-sm"
          : "w-full py-2.5 rounded-xl bg-white hover:bg-zinc-200 text-black font-semibold text-xs cursor-pointer transition shadow-sm active:scale-95";
      }
    }

    function bindCardEvents() {
      root?.querySelectorAll<HTMLElement>(".wb-open-lightbox").forEach((btn) => {
        btn.onclick = (e) => {
          const card = (e.currentTarget as HTMLElement).closest(".wb-card") as HTMLElement;
          if (!card || !modal) return;
          const list = getVisibleCardsData();
          const foundIdx = list.findIndex(item => item.card === card);
          renderModalSlide(foundIdx >= 0 ? foundIdx : 0);
          modal.showModal();
          startAutoplay();
        };
      });
    }

    bindCardEvents();

    // Botón de Toggle Autoplay
    document.getElementById("lb-modal-autoplay")?.addEventListener("click", (e) => {
      e.stopPropagation();
      if (isAutoplayActive) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    });

    // Navegación por mitades clicables
    document.getElementById("lb-nav-prev")?.addEventListener("click", (e) => {
      e.stopPropagation();
      renderModalSlide(currentModalIndex - 1);
      resetAutoplayTimer();
    });

    document.getElementById("lb-nav-next")?.addEventListener("click", (e) => {
      e.stopPropagation();
      renderModalSlide(currentModalIndex + 1);
      resetAutoplayTimer();
    });

    // Navegación fluida por Rueda del Mouse (Wheel / Scroll)
    let wheelThrottle = false;
    modal?.addEventListener("wheel", (e) => {
      if (!modal?.open) return;
      const isDesc = (e.target as HTMLElement)?.closest("#lb-modal-desc");
      if (isDesc) return;

      e.preventDefault();
      if (wheelThrottle) return;
      wheelThrottle = true;
      setTimeout(() => { wheelThrottle = false; }, 320);

      if (e.deltaY > 0 || e.deltaX > 0) {
        renderModalSlide(currentModalIndex + 1);
        resetAutoplayTimer();
      } else if (e.deltaY < 0 || e.deltaX < 0) {
        renderModalSlide(currentModalIndex - 1);
        resetAutoplayTimer();
      }
    }, { passive: false });

    // Navegación por teclado (Flechas ← → y Escape)
    window.addEventListener("keydown", (e) => {
      if (!modal?.open) return;
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        renderModalSlide(currentModalIndex - 1);
        resetAutoplayTimer();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        renderModalSlide(currentModalIndex + 1);
        resetAutoplayTimer();
      }
    });

    document.getElementById("lb-modal-close")?.addEventListener("click", () => modal?.close());
    document.getElementById("lb-modal-toggle-select")?.addEventListener("click", () => {
      if (activeCardCheckbox) {
        activeCardCheckbox.checked = !activeCardCheckbox.checked;
        updateCounters();
        renderModalSlide(currentModalIndex);
      }
    });

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });

    modal?.addEventListener("close", () => {
      stopAutoplay();
    });

    updateCounters();
  }

  document.addEventListener("astro:page-load", initWorkbench);
  if (document.readyState !== "loading") initWorkbench();
</script>
