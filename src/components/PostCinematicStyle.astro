---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={`post-cinematic-root w-full ${className}`}>
  <slot />
</div>

<style is:global>
  .post-cinematic-root {
    position: relative;
    width: 100%;
  }

  /* ── 1. Visor Central y Respiro entre Bloques ── */
  .post-cinematic-root .cinematic-block {
    min-height: 65vh !important;
    margin-top: 6vh !important;
    margin-bottom: 6vh !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    padding: 2.5rem 1.5rem !important;
    position: relative !important;
    box-sizing: border-box !important;
  }

  @media (min-width: 768px) {
    .post-cinematic-root .cinematic-block {
      min-height: 70vh !important;
      margin-top: 8vh !important;
      margin-bottom: 8vh !important;
      padding: 3rem 2rem !important;
    }
  }

  /* ── 2. Títulos con Tipografía Gloock / Cinzel y Gradiente Heredado ── */
  .post-cinematic-root .cinematic-block h1,
  .post-cinematic-root .cinematic-block h2 {
    font-family: "Gloock", serif !important;
    font-size: clamp(2.3125rem, 5vw, 3.8125rem) !important;
    line-height: 1.08 !important;
    letter-spacing: -0.025em !important;
    font-weight: 900 !important;
    text-align: center !important;
    max-width: 56rem !important;
    margin-top: 2rem !important;
    margin-bottom: 1.5rem !important;
    background: linear-gradient(180deg, #FFFFFF 0%, #E2E8F0 40%, #DFCA9D 70%, #94A3B8 100%) !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    color: transparent !important;
    filter: drop-shadow(0 4px 25px rgba(0, 0, 0, 0.9)) !important;
    transition: filter 0.4s ease, transform 0.4s ease !important;
  }

  .post-cinematic-root .cinematic-block h3 {
    font-family: "Cinzel", serif !important;
    font-size: clamp(1.8125rem, 3.5vw, 2.5625rem) !important;
    line-height: 1.15 !important;
    letter-spacing: 0.015em !important;
    font-weight: 800 !important;
    text-align: center !important;
    max-width: 48rem !important;
    margin-top: 1.5rem !important;
    margin-bottom: 1rem !important;
    background: linear-gradient(180deg, #F5F4F0 0%, #DFCA9D 45%, #C9A86C 75%, #94A3B8 100%) !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    color: transparent !important;
    filter: drop-shadow(0 2px 15px rgba(0, 0, 0, 0.8)) !important;
  }

  /* ── 3. Citas y Respiro Cinemático TGP (+1px) ── */
  .post-cinematic-root .cinematic-block blockquote {
    font-family: "Newsreader", "Gloock", serif !important;
    font-size: clamp(1.3125rem, 2.25vw, 1.625rem) !important;
    line-height: 1.8 !important;
    font-style: italic !important;
    color: rgba(245, 244, 240, 0.95) !important;
    text-align: center !important;
  }

  /* ── 4. Párrafos de Cuerpo Cinemático (+1px: clamp 1.3125rem a 1.5625rem) ── */
  .post-cinematic-root .cinematic-block p {
    font-family: "Newsreader", serif !important;
    font-size: clamp(1.3125rem, 2.05vw, 1.5625rem) !important;
    line-height: 1.85 !important;
    letter-spacing: 0.008em !important;
    color: rgba(239, 235, 227, 0.92) !important;
    max-width: 88ch !important;
    width: 100% !important;
    text-align: center !important;
    text-wrap: pretty !important;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7) !important;
  }

  /* ── Efecto de Palabras Tipeadas / Condensación ── */
  .post-cinematic-root .tm-word {
    display: inline;
    will-change: opacity, filter;
  }

  /* ── 5. Color de Selección Global y Títulos Seleccionados ── */
  .post-cinematic-root ::selection {
    background: rgba(217, 119, 54, 0.4) !important;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }

  .post-cinematic-root .cinematic-block h1::selection,
  .post-cinematic-root .cinematic-block h2::selection,
  .post-cinematic-root .cinematic-block h3::selection {
    background: #d97736 !important;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    text-shadow: 0 0 20px rgba(217, 119, 54, 0.8) !important;
  }
</style>

