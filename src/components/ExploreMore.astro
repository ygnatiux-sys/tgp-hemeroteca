---
import { getCollection } from "astro:content";
import { resolveEssayImage } from "../lib/content-filter";
import CinematicArchiveCard from "./CinematicArchiveCard.astro";

interface Props {
  currentSlug: string;
  category?: string;
}

const { currentSlug, category } = Astro.props;

const allEssays = await getCollection("ensayos");

// Preferir ensayos de la misma categoría si están disponibles, y completar con otros ensayos
let candidateEssays = allEssays.filter(essay => essay.id.replace(/\/index$/, "") !== currentSlug);

if (category) {
  const sameCat = candidateEssays.filter(e => e.data.category === category);
  const diffCat = candidateEssays.filter(e => e.data.category !== category);
  candidateEssays = [...sameCat, ...diffCat];
}

const exploreEssays = candidateEssays.slice(0, 3);
---

<section class="max-w-7xl mx-auto px-6 py-24 md:py-32 border-t border-white/5">
  <div class="flex flex-col gap-10 md:gap-12">
    <div class="flex justify-between items-end">
      <div>
        <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#C8A98B] font-bold">[ SIGUE EXPLORANDO ]</span>
        <h3 class="text-3xl md:text-4xl font-cinzel text-white/95 mt-2 font-extrabold tracking-tight">Continuar la lectura</h3>
      </div>
      <a href="/archivo" class="hidden md:block font-mono text-[10px] uppercase tracking-widest text-white/50 hover:text-[#C8A98B] transition-colors border-b border-white/10 pb-1">Ver todo el archivo →</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {exploreEssays.map((essay) => {
        const slug = essay.id.replace(/\/index$/, "");
        const optimizedImg = resolveEssayImage(essay.data.coverImage, slug);

        return (
          <CinematicArchiveCard
            slug={slug}
            entry={essay.data}
            img={optimizedImg}
            variant="standard"
            enableCinemagraph={true}
          />
        );
      })}
    </div>
  </div>
</section>

