---
import { Image } from 'astro:assets';
import { getCollection } from "astro:content";
import { resolveEssayImage, formatCategory, formatDate, sanitizeImageUrl } from "../lib/content-filter";
import RowNetflixClasico from "./RowNetflixClasico.astro";

interface Props {
  currentSlug: string;
  category?: string;
}

const { currentSlug, category } = Astro.props;

// ── Carga Multicolección ──────────────────────────────────────────
const allEssaysRaw = await getCollection("ensayos").catch(() => []);
const allCinematicosRaw = await getCollection("ensayosCinematicos").catch(() => []);
const allArquetiposRaw = await getCollection("arquetiposGlobales").catch(() => []);
const allGeorefsRaw = await getCollection("georreferencias").catch(() => []);

const normalizePost = (item: any, defaultCat: string, isCine = false) => {
  const slug = item.id.replace(/\/index$/, "");
  return {
    slug,
    title: item.data?.title || "Sin Título",
    subtitle: item.data?.excerpt || item.data?.volanta || "",
    category: item.data?.category || defaultCat,
    img: resolveEssayImage(item.data, slug),
    date: item.data?.date ? String(item.data.date) : "",
    link: isCine ? `/ensayos-cinematicos/${slug}/` : `/hemeroteca/${slug}/`,
    isCinematic: isCine,
    entry: item.data,
  };
};

const allPool = [
  ...allCinematicosRaw.filter((p: any) => !p.data?.draft).map((p: any) => normalizePost(p, "Ensayos Cinemáticos", true)),
  ...allEssaysRaw.filter((p: any) => !p.data?.draft).map((p: any) => normalizePost(p, "Ensayo")),
  ...allArquetiposRaw.filter((p: any) => !p.data?.draft).map((p: any) => normalizePost(p, "Arquetipos Globales")),
  ...allGeorefsRaw.filter((p: any) => !p.data?.draft).map((p: any) => normalizePost(p, "Georreferencias")),
];

// Ordenar por fecha más reciente
allPool.sort((a, b) => {
  const dateA = a.date ? new Date(a.date).getTime() : 0;
  const dateB = b.date ? new Date(b.date).getTime() : 0;
  if (dateA && dateB && dateA !== dateB) return dateB - dateA;
  return b.slug.localeCompare(a.slug);
});

// Filtrar el post actual
let candidates = allPool.filter(p => p.slug !== currentSlug);

// Si hay categoría, priorizarla
if (category) {
  const sameCat = candidates.filter(e => e.category === category);
  const diffCat = candidates.filter(e => e.category !== category);
  candidates = [...sameCat, ...diffCat];
}

// Tríptico: 1 Hero Principal arriba + Fila Netflix debajo
const lead = candidates[0] ?? null;
const rowItems = candidates.slice(1, 16);
---

<section class="w-full border-t border-white/5 pt-16 pb-12 mt-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-10 flex flex-col gap-10">

    {/* ── ENCABEZADO ── */}
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
      <div>
        <span class="font-metadata text-[9px] uppercase tracking-[0.45em] text-rust-orange block mb-1">
          [ Sigue Explorando ]
        </span>
        <h3 class="font-cinzel font-extrabold text-2xl sm:text-3xl md:text-4xl tracking-tight bg-linear-to-r from-white via-[#E2E8F0] to-[#94A3B8] bg-clip-text text-transparent">
          Continuar la Lectura
        </h3>
      </div>
      <a 
        href="/archivo/" 
        class="font-metadata text-[9px] uppercase tracking-[0.3em] text-white/40 hover:text-rust-orange transition-colors shrink-0 pb-1"
      >
        Ver todo el Archivo →
      </a>
    </div>

    {/* ── 1. CARD HERO PROTAGONISTA (Arriba) ── */}
    {lead && (
      <article class="group w-full relative overflow-hidden rounded-2xl md:rounded-3xl border border-white/8 bg-white/2 hover:border-rust-orange/30 transition-all duration-700 shadow-2xl">
        <div class="flex flex-col lg:flex-row items-stretch">
          
          {/* Imagen lateral / superior */}
          {lead.img ? (
            <div class="relative overflow-hidden lg:w-[48%] shrink-0 aspect-video lg:aspect-auto max-h-72 lg:max-h-96 bg-black">
              <Image
                src={sanitizeImageUrl(lead.img)}
                alt={lead.title}
                inferSize={true}
                format="webp"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.03] brightness-75"
              />
              <div class="absolute inset-0 shadow-[inset_0_0_80px_rgba(0,0,0,0.85)] pointer-events-none" />
              <div class="absolute inset-0 bg-linear-to-r from-transparent via-transparent to-(--bg-main) hidden lg:block pointer-events-none" />
              <div class="absolute inset-0 bg-linear-to-t from-(--bg-main)/85 via-transparent to-transparent lg:hidden pointer-events-none" />
            </div>
          ) : (
            <div class="relative overflow-hidden lg:w-[40%] shrink-0 bg-linear-to-br from-rust-orange/15 via-[#242424] to-[#151718] flex items-center justify-center p-8 border-b lg:border-b-0 lg:border-r border-white/5 min-h-48 lg:min-h-0">
              <div class="font-metadata text-[9px] uppercase tracking-[0.4em] text-rust-orange/50 text-center">
                [ TGP Archivo ]
              </div>
            </div>
          )}

          {/* Información Editorial */}
          <div class="flex flex-col justify-between p-6 md:p-8 lg:p-10 flex-1 min-w-0">
            <div class="flex flex-col gap-3 md:gap-4">
              <div class="flex items-center gap-3">
                <span class="font-metadata text-[8.5px] uppercase tracking-[0.3em] text-rust-orange/80 font-bold">
                  {formatCategory(lead.category)}
                </span>
                {lead.date && (
                  <span class="font-metadata text-[8px] uppercase tracking-[0.2em] text-white/30">
                    · {formatDate(lead.date)}
                  </span>
                )}
              </div>

              <h4 class="font-cinzel font-bold text-xl sm:text-2xl md:text-3xl leading-tight group-hover:text-rust-orange/90 transition-colors duration-300">
                <a href={lead.link}>{lead.title}</a>
              </h4>

              {lead.subtitle && (
                <p class="font-serif italic text-[#E0E0E0]/60 text-sm md:text-base leading-relaxed line-clamp-2 max-w-prose">
                  "{lead.subtitle}"
                </p>
              )}
            </div>

            <div class="mt-6 pt-4 border-t border-white/5 flex items-center flex-wrap gap-3">
              <a
                href={lead.link}
                class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#151718]/90 backdrop-blur-sm border border-white/15 text-[#E0E0E0]/90 font-metadata font-bold text-[8.5px] tracking-[0.2em] uppercase rounded-lg hover:bg-rust-orange/15 hover:border-rust-orange/50 hover:text-rust-orange transition-all duration-300"
              >
                <span>Leer Artículo</span>
                <span class="opacity-50 group-hover:translate-x-0.5 transition-transform">▸</span>
              </a>
              
              <a
                href={`/papers/${lead.slug}/`}
                class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-transparent border border-white/10 text-[#E0E0E0]/50 font-metadata font-bold text-[8.5px] tracking-[0.2em] uppercase rounded-lg hover:bg-white/5 hover:border-rust-orange/30 hover:text-rust-orange transition-all duration-300"
              >
                <span>Ver Dossier Paper</span>
                <span class="opacity-40 group-hover:translate-x-0.5 transition-transform">▸</span>
              </a>
            </div>
          </div>
        </div>
      </article>
    )}

    {/* ── 2. ROW NETFLIX CLÁSICO (Debajo — 4 Columnas Visibles) ── */}
    {rowItems.length > 0 && (
      <div class="w-full pt-2">
        <RowNetflixClasico
          items={rowItems}
          title="Dossiers y Arquetipos Recientes"
          eyebrow="Archivo Epistémico"
          max={15}
        />
      </div>
    )}

  </div>
</section>
