---
import { resolveMultivisionClass } from "../lib/multivision";
import { getCollection } from "astro:content";
import {
  getPublishableEssays,
  groupByCategory,
  formatCategory,
  resolveEssayImage,
  sanitizeImageUrl,
} from "../lib/content-filter";

const allEssaysRaw = await getCollection('ensayos').catch(() => []);
const allArquetiposRaw = await getCollection('arquetiposGlobales').catch(() => []);
const allCinematicosRaw = await getCollection('ensayosCinematicos').catch(() => []);
const allGeorefsRaw = await getCollection('georreferencias').catch(() => []);

const publishableCinematicos = allCinematicosRaw.map(item => ({
  slug: item.id.replace(/\/index$/, ''),
  isCinematicGSAP: true,
  entry: {
    title: item.data.title || 'Dossier Cinemático',
    category: 'Ensayos Cinemáticos',
    coverImage: item.data.coverImage || (Array.isArray(item.data.gallery) && item.data.gallery.length > 0 ? item.data.gallery[0] : null),
    excerpt: 'Experiencia inmersiva GSAP a pantalla completa.',
    date: new Date().toISOString(),
    themeColor: 'obsidiana',
    isCinematicGSAP: true,
  }
}));

const publishable = [
  ...publishableCinematicos,
  ...getPublishableEssays(allEssaysRaw),
  ...getPublishableEssays(allArquetiposRaw),
  ...getPublishableEssays(allGeorefsRaw)
];

// Agrupamos todas las colecciones con al menos 1 artículo
const categoryGroups = groupByCategory(publishable, 1);
const collections = Array.from(categoryGroups.entries())
  .map(([key, essays]) => {
    const resolved = essays.map(e => ({
      ...e,
      img: resolveEssayImage(e.entry, e.slug),
    }));
    const coverEssay = resolved.find(e => e.img) || resolved[0];
    return {
      key,
      label: formatCategory(essays[0].entry.category || key),
      count: essays.length,
      coverEssay,
    };
  })
  .sort((a, b) => b.count - a.count);
  
const resolvedCollections = collections.map(c => ({
  ...c,
  img: sanitizeImageUrl(c.coverEssay?.img ? ((c.coverEssay.img as any)?.src ?? c.coverEssay.img) : ''),
}));
---

{resolvedCollections.length > 0 && (
  <section class="py-12 md:py-16 overflow-hidden border-t border-white/5 relative bg-white/1">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6 md:mb-8">
      <div class="flex items-end justify-between gap-4">
        <div>
          <span class="font-metadata text-[10px] uppercase tracking-[0.4em] text-rust-orange block mb-1">Explorar Archivo</span>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-cinzel font-bold tracking-tight text-white/90">
            Colecciones Destacadas
          </h2>
        </div>
        <a href="/archivo/" class="font-metadata text-[9px] sm:text-[10px] uppercase tracking-[0.3em] text-white/50 hover:text-rust-orange transition-colors shrink-0">
          Ver todas <span class="hidden sm:inline">las categorías</span>
        </a>
      </div>
    </div>
    
    {/* Contenedor principal del marquee con máscara de desvanecimiento a los lados */}
    <div class="marquee-container w-full overflow-hidden flex relative group">
      
      {/* Botón Anterior Flotante en Cápsula con tokens heredados */}
      <button 
        type="button"
        class="marquee-nav-btn prev-btn absolute left-1 sm:left-2 md:left-4 top-1/2 -translate-y-1/2 z-40 w-9 md:w-11 h-20 md:h-24 rounded-full bg-black/40 hover:bg-black/85 text-[#E3DDD3]/40 hover:text-[#EFEBE3] border border-[#E3DDD3]/10 hover:border-[#E3DDD3]/30 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-70 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none"
        aria-label="Colecciones anteriores"
      >
        <svg class="w-5 h-5 md:w-6 md:h-6 -translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      </button>

      {/* Botón Siguiente Flotante en Cápsula con tokens heredados */}
      <button 
        type="button"
        class="marquee-nav-btn next-btn absolute right-1 sm:right-2 md:right-4 top-1/2 -translate-y-1/2 z-40 w-9 md:w-11 h-20 md:h-24 rounded-full bg-black/40 hover:bg-black/85 text-[#E3DDD3]/40 hover:text-[#EFEBE3] border border-[#E3DDD3]/10 hover:border-[#E3DDD3]/30 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-70 hover:opacity-100 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl focus:outline-none"
        aria-label="Siguientes colecciones"
      >
        <svg class="w-4 h-4 md:w-5 md:h-5 translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </button>

      {/* Track Scrolleable nativo con scroll constante sin efecto resorte */}
      <div class="marquee-scroller flex gap-4 md:gap-6 px-2 w-full overflow-x-auto no-scrollbar select-none" style="-ms-overflow-style: none; scrollbar-width: none; scroll-behavior: auto;">
        
        {/* Usamos el triple de elementos para dar ilusión de infinito con JS nativo */}
        {[...resolvedCollections, ...resolvedCollections, ...resolvedCollections].map(({ key, label, count, img }, idx) => (
          <a
            href={`/colecciones/${key}/`}
            class="group/card shrink-0 h-[62vh] aspect-[10/14.5] sm:aspect-[10/12.5] lg:aspect-[10/11.5] bg-[#0a0c0f] border border-white/10 rounded-xl overflow-hidden hover:border-white/25 transition-all duration-500 flex flex-col pointer-events-auto"
            draggable="false"
          >
            {img ? (
              <div class="overflow-hidden h-full relative">
                <img src={img} alt={label} draggable="false" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/card:scale-[1.025] opacity-70 group-hover/card:opacity-90 img-nativa" />
                <div class="absolute inset-0 bg-linear-to-t from-[#0a0c0f]/90 via-[#0a0c0f]/40 to-transparent" />
                <div class="absolute bottom-0 left-0 p-4 md:p-6 w-full">
                  <p class="font-metadata text-[10px] md:text-xs uppercase tracking-[0.3em] text-rust-orange mb-2 drop-shadow-md">{count} artículos</p>
                  <h3 class="font-cinzel font-bold text-lg md:text-xl lg:text-2xl leading-tight text-white group-hover/card:text-rust-orange transition-colors drop-shadow-lg">{label}</h3>
                </div>
              </div>
            ) : (
              <div class="p-5 flex flex-col justify-end gap-2 h-full">
                <p class="font-metadata text-[10px] md:text-xs uppercase tracking-[0.3em] text-rust-orange">{count} artículos</p>
                <h3 class="font-cinzel font-bold text-lg md:text-xl lg:text-2xl leading-tight text-white group-hover/card:text-rust-orange transition-colors">{label}</h3>
              </div>
            )}
          </a>
        ))}
      </div>
      
    </div>
  </section>
)}

<style>
  .marquee-container {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 5%,
      black 95%,
      transparent
    );
  }
  
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initNaturalMarquee() {
    const containers = document.querySelectorAll('.marquee-container');
    
    containers.forEach(container => {
      if (container.hasAttribute('data-init')) return;
      container.setAttribute('data-init', 'true');
      
      const scroller = container.querySelector('.marquee-scroller') as HTMLElement;
      const prevBtn = container.querySelector('.prev-btn') as HTMLButtonElement;
      const nextBtn = container.querySelector('.next-btn') as HTMLButtonElement;
      
      if (!scroller) return;

      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;
      let animationId = 0;
      let isPaused = false;
      let isDragging = false;
      const scrollSpeed = 0.5; // pixeles por frame constante

      // Asegurar que scroll-behavior sea siempre auto para evitar cualquier rebote o resorte
      scroller.style.scrollBehavior = 'auto';

      function normalizeLoop() {
        const scrollWidth = scroller.scrollWidth;
        const oneThird = scrollWidth / 3;
        if (oneThird <= 0) return;
        
        if (scroller.scrollLeft >= oneThird * 2) {
          scroller.scrollLeft -= oneThird;
        } else if (scroller.scrollLeft <= 0) {
          scroller.scrollLeft += oneThird;
        }
      }

      // Autoplay continuo e imperceptible
      function playMarquee() {
        if (!isPaused && !isDown) {
          scroller.scrollLeft += scrollSpeed;
          normalizeLoop();
        }
        animationId = requestAnimationFrame(playMarquee);
      }
      
      // Iniciar en el tercio central
      const initialThird = scroller.scrollWidth / 3;
      if (initialThird > 0) {
        scroller.scrollLeft = initialThird;
      }
      playMarquee();

      // Pausa suave al posar el mouse
      container.addEventListener('mouseenter', () => isPaused = true);
      container.addEventListener('mouseleave', () => isPaused = false);
      
      // Navegación por botones sin conflicto de resorte
      function stepScroll(amount: number) {
        isPaused = true;
        scroller.scrollBy({ left: amount, behavior: 'smooth' });
        setTimeout(() => {
          scroller.style.scrollBehavior = 'auto';
          normalizeLoop();
          isPaused = false;
        }, 450);
      }

      if (prevBtn) prevBtn.addEventListener('click', () => stepScroll(-450));
      if (nextBtn) nextBtn.addEventListener('click', () => stepScroll(450));

      // Drag to scroll 1:1 natural (sin aceleración x2 ni resorte en mouseup)
      scroller.addEventListener('mousedown', (e) => {
        isDown = true;
        isDragging = false;
        scroller.style.scrollBehavior = 'auto';
        startX = e.pageX - scroller.offsetLeft;
        scrollLeft = scroller.scrollLeft;
      });

      scroller.addEventListener('mouseleave', () => { 
        isDown = false; 
      });

      scroller.addEventListener('mouseup', () => { 
        isDown = false; 
        scroller.style.scrollBehavior = 'auto';
      });

      scroller.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        isDragging = true;
        e.preventDefault();
        const x = e.pageX - scroller.offsetLeft;
        const walk = x - startX;
        scroller.scrollLeft = scrollLeft - walk;

        const scrollWidth = scroller.scrollWidth;
        const oneThird = scrollWidth / 3;
        if (oneThird > 0) {
          if (scroller.scrollLeft >= oneThird * 2) {
            scroller.scrollLeft -= oneThird;
            scrollLeft -= oneThird;
          } else if (scroller.scrollLeft <= 0) {
            scroller.scrollLeft += oneThird;
            scrollLeft += oneThird;
          }
        }
      });

      // Evitar que el click active navegación si estábamos arrastrando
      scroller.addEventListener('click', (e) => {
        if (isDragging) {
          e.preventDefault();
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initNaturalMarquee);
  document.addEventListener('astro:page-load', initNaturalMarquee);
</script>
