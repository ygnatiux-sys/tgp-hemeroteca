---
/**
 * src/components/ImaxMax.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * COMPONENTE CANÓNICO: 'IMAX MAX'
 * Arquitectura Monumental Full-Scale (70mm IMAX Aspect Ratio ~16:10 / 1.43:1).
 *
 * Elimina la compresión horizontal del viejo formato Univisium (78vh / max-h-210)
 * y expande el marco hacia abajo hasta 92vh / max-h-260, otorgando amplitud total
 * a las bóvedas, esculturas y arquitectura subterránea sin perder el ancho actual.
 *
 * EFECTOS ORIGINALES MINIMALISTAS RESCATADOS (CERO LABS, CERO HUDS):
 * 1. INTRO: Shockwave ámbar y eclosión monumental de colección.
 * 2. DERINKUYU: Paralaje de Abismo en profundidad Z hacia el túnel (Clash Display).
 * 3. BARABAR: Resonancia Sónica con 4 ecos de contorno vibrantes + destello de espejo (Syne 900).
 * 4. DIQUÍS: Fractura lateral y desintegración en niebla (Fraunces).
 * 5. OLMECAS: Fractura tectónica geológica centrada con fisura de basalto/oro.
 *
 * Compatible para ser reutilizado en colecciones: 'alternative', 'africa', 'asia', 'america'.
 */
import imgDerinkuyu from "../assets/alternativa/derinkuyu.jpg";
import imgBarabar from "../assets/alternativa/barabar.jpg";
import imgDiquis from "../assets/alternativa/esfera-diquis.jpg";
import imgOlmeca from "../assets/alternativa/olmeca.jpg";

interface Props {
  collection?: "alternative" | "africa" | "asia" | "america";
  className?: string;
  autoplayDuration?: number; // ms por diapositiva (default: 6000)
}

const {
  collection = "alternative",
  className = "",
  autoplayDuration = 6000,
} = Astro.props;
---

<link rel="preconnect" href="https://api.fontshare.com" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&display=swap"
/>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,900,0,0&family=Syne:wght@800;900&display=swap"
/>

<section
  id="imax-max-narrative-container"
  class={`relative w-full h-[180vh] bg-transparent text-white select-none ${className}`}
  data-autoplay={autoplayDuration}
  data-collection={collection}
  aria-label="Colección Alternative — IMAX MAX"
>
  <!-- ══════════════════════════════════════════════════════════════════════════
       CONTENEDOR STICKY IMAX MAX (EXPANDIDO VERTICALMENTE HACIA ABAJO)
       De h-[78vh] a h-[88vh] sm:h-[90vh] md:h-[92vh]
       De min-h-140 (560px) a min-h-165 sm:min-h-185 md:min-h-210 lg:min-h-225 (900px)
       De max-h-210 (840px) a max-h-[94vh] 2xl:max-h-260 (1040px)
       Ancho 100% preservado sin alteración.
  ══════════════════════════════════════════════════════════════════════════ -->
  <div class="sticky top-3 sm:top-4 md:top-5 h-[88vh] sm:h-[90vh] md:h-[92vh] min-h-165 sm:min-h-185 md:min-h-210 lg:min-h-225 max-h-[94vh] 2xl:max-h-260 w-full overflow-hidden bg-[#0a0a0a] rounded-3xl sm:rounded-4xl border border-white/10 shadow-[0_24px_70px_rgba(0,0,0,0.92)] isolate">
    
    <!-- HEADER EDITORIAL DE LA COLECCIÓN (Minimalista y flotante) -->
    <header class="absolute top-5 sm:top-7 inset-x-0 z-30 flex items-center justify-between px-6 sm:px-10 pointer-events-none">
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-[#E69A46] shadow-[0_0_10px_#E69A46] animate-pulse"></span>
        <span class="font-mono text-[9px] sm:text-[10px] tracking-[0.35em] uppercase text-[#E69A46] font-bold">
          Colección · Alternative
        </span>
      </div>
    </header>

    <!-- ══════════════════════════════════════════════════════════════════════
         PASO 0: APERTURA COLECCIÓN ALTERNATIVE (AMBIENT GLOW ÁMBAR VOLCÁNICO)
    ══════════════════════════════════════════════════════════════════════ -->
    <div
      class="alt-layer alt-layer-intro absolute inset-0 w-full h-full opacity-100 pointer-events-auto z-20 flex items-center justify-center overflow-hidden bg-[#0a0a0a]"
      data-layer-index="0"
    >
      <!-- Resplandor ambiental cálido ámbar / magma -->
      <div class="alt-ambient-orb-1 absolute -top-[15%] -right-[10%] w-[75vw] h-[75vw] max-w-225 max-h-225 rounded-full bg-[radial-gradient(circle_at_center,rgba(230,154,70,0.32)_0%,rgba(212,86,50,0.15)_35%,rgba(74,13,6,0.06)_60%,transparent_75%)] blur-3xl pointer-events-none"></div>
      <div class="alt-ambient-orb-2 absolute -bottom-[20%] -left-[15%] w-[60vw] h-[60vw] max-w-175 max-h-175 rounded-full bg-[radial-gradient(circle_at_center,rgba(180,60,25,0.22)_0%,rgba(100,20,10,0.08)_40%,transparent_70%)] blur-3xl pointer-events-none"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_38%,rgba(10,10,10,0.75)_70%,#0a0a0a_100%)] pointer-events-none"></div>
      <div class="alt-grain absolute inset-0 pointer-events-none opacity-20 mix-blend-overlay"></div>
      <div class="alt-ash-intro absolute inset-0 pointer-events-none z-10" aria-hidden="true"></div>

      <!-- Onda de choque ámbar sutil -->
      <div class="alt-intro-shockwave absolute w-28 h-28 rounded-full border-2 border-[#E69A46] pointer-events-none opacity-0 scale-50 z-15 shadow-[0_0_60px_#d45632]"></div>

      <!-- Escenario Central: ALTERNATIVE (H1) + COLECCIÓN (H2) -->
      <div class="relative z-20 flex flex-col items-center justify-center text-center px-4 max-w-6xl w-full select-none">
        <div class="alt-intro-box relative flex flex-col items-center justify-center">
          <h1 class="alt-intro-title font-fraunces font-black uppercase text-[clamp(3.5rem,12vw,12rem)] leading-[0.84] tracking-[-0.035em] whitespace-nowrap text-transparent opacity-0 will-change-transform">
            ALTERNATIVE
          </h1>

          <div class="alt-intro-h2-wrap relative inline-block mt-3 overflow-visible">
            <h2 class="alt-intro-h2 font-mono font-bold uppercase text-[clamp(1.2rem,3.5vw,3rem)] tracking-[0.42em] text-[#E69A46] drop-shadow-[0_0_35px_rgba(230,154,70,0.55)] m-0 opacity-0 will-change-transform">
              COLECCIÓN
            </h2>
          </div>
        </div>

        <p class="alt-intro-sub mt-6 font-mono text-[10px] sm:text-[12px] tracking-[0.35em] uppercase text-stone-300 opacity-0">
          Historia profunda · El archivo no oficial
        </p>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════
         PASO 1: DERINKUYU — PARALAJE DE ABISMO (Profundidad Z)
    ══════════════════════════════════════════════════════════════════════ -->
    <div
      class="alt-layer absolute inset-0 w-full h-full opacity-0 pointer-events-none"
      data-layer-index="1"
    >
      <div class="alt-bg-wrap absolute inset-0 overflow-hidden">
        <img
          src={imgDerinkuyu.src}
          alt="Túnel y rueda de molino de Derinkuyu"
          class="alt-img absolute inset-0 w-full h-full object-cover object-center filter brightness-105 contrast-105 will-change-transform"
          loading="eager"
          decoding="async"
        />
      </div>

      {/* Scrim de opacidad controlada (luminosidad natural preservada) */}
      <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_50%_50%,transparent_45%,rgba(10,10,10,0.35)_75%,rgba(10,10,10,0.75)_100%)]"></div>
      <div class="absolute inset-0 pointer-events-none mix-blend-screen bg-[radial-gradient(circle_at_66%_72%,rgba(217,99,63,0.18)_0%,rgba(184,58,36,0.06)_28%,transparent_55%)]"></div>
      <div class="alt-grain absolute inset-0 pointer-events-none"></div>
      <div class="alt-ash absolute inset-0 pointer-events-none z-10" aria-hidden="true"></div>

      <div class="alt-3d-viewport absolute inset-0 flex items-center justify-center pointer-events-none z-20 px-4">
        <div class="alt-derinkuyu-chamber relative flex flex-col items-center justify-center text-center max-w-7xl">
          <span class="alt-badge inline-block mb-3 font-mono text-[9px] sm:text-[10px] tracking-[0.3em] uppercase text-[#E69A46] py-0.5 px-3 rounded-full border border-white/10 bg-white/5 backdrop-blur-md opacity-0 drop-shadow-md">
            Anatolia Subterránea · Refugio Primordial
          </span>
          <h2 class="alt-derin-h1 text-[clamp(3.8rem,15vw,15rem)] font-bold leading-[0.86] tracking-[-0.035em] uppercase whitespace-nowrap text-transparent opacity-0">
            Derinkuyu
          </h2>
          <p class="alt-derin-sub absolute top-1/2 -translate-y-1/2 font-sans text-[clamp(0.85rem,2.2vw,1.45rem)] tracking-[0.28em] uppercase text-[#f7ebe1] opacity-0 drop-shadow-[0_4px_24px_rgba(0,0,0,0.95)]">
            <span class="text-[#E69A46] mr-1.5">—</span> El último refugio de la humanidad
          </p>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════
         PASO 2: BARABAR — RESONANCIA SÓNICA & REFRACCIÓN ESPEJO (THE SONIC REFLECTION)
    ══════════════════════════════════════════════════════════════════════ -->
    <div
      class="alt-layer absolute inset-0 w-full h-full opacity-0 pointer-events-none"
      data-layer-index="2"
    >
      <div class="alt-bg-wrap absolute inset-0 overflow-hidden">
        <img
          src={imgBarabar.src}
          alt="Bóveda de granito pulido espejo de las Cuevas de Barabar"
          class="alt-img absolute inset-0 w-full h-full object-cover object-[center_50%] filter brightness-105 contrast-105 will-change-transform"
          loading="lazy"
          decoding="async"
        />
      </div>

      {/* Scrim translúcido: bóveda de granito y lámpara de aceite 100% visibles */}
      <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_50%_50%,transparent_50%,rgba(6,7,8,0.25)_75%,rgba(6,7,8,0.65)_100%)]"></div>
      <div class="absolute inset-0 pointer-events-none mix-blend-screen bg-[radial-gradient(circle_at_43%_72%,rgba(243,156,18,0.2)_0%,rgba(211,84,0,0.08)_22%,transparent_50%)]"></div>
      <div class="alt-grain absolute inset-0 pointer-events-none"></div>

      <div class="absolute inset-0 flex items-center justify-center z-20 pointer-events-none px-4">
        <div class="alt-barabar-chamber relative flex flex-col items-center text-center max-w-7xl">
          <span class="alt-badge inline-flex items-center gap-2 mb-4 font-mono text-[9px] sm:text-[10px] tracking-[0.3em] uppercase text-[#e5e5e5] py-1 px-3.5 rounded-full border border-white/10 bg-white/5 backdrop-blur-md opacity-0 drop-shadow-md">
            <span class="w-1.5 h-1.5 rounded-full bg-[#f39c12] shadow-[0_0_8px_#f39c12]"></span>
            Cámara Subterránea de Bihar · Acústica de Granito
          </span>

          <div class="alt-barabar-stack relative inline-block">
            {/* 4 Capas de Eco Acústico Originales */}
            <span class="alt-barabar-echo alt-echo-1 absolute inset-0 text-transparent font-black uppercase text-[clamp(3.6rem,15vw,14rem)] leading-[0.86] tracking-[-0.01em] opacity-0" aria-hidden="true">Barabar</span>
            <span class="alt-barabar-echo alt-echo-2 absolute inset-0 text-transparent font-black uppercase text-[clamp(3.6rem,15vw,14rem)] leading-[0.86] tracking-[-0.01em] opacity-0" aria-hidden="true">Barabar</span>
            <span class="alt-barabar-echo alt-echo-3 absolute inset-0 text-transparent font-black uppercase text-[clamp(3.6rem,15vw,14rem)] leading-[0.86] tracking-[-0.01em] opacity-0" aria-hidden="true">Barabar</span>
            <span class="alt-barabar-echo alt-echo-4 absolute inset-0 text-transparent font-black uppercase text-[clamp(3.6rem,15vw,14rem)] leading-[0.86] tracking-[-0.01em] opacity-0" aria-hidden="true">Barabar</span>

            {/* Palabra sólida central con glint de espejo */}
            <h2 class="alt-barabar-solid relative m-0 font-black uppercase whitespace-nowrap text-[clamp(3.6rem,15vw,14rem)] leading-[0.86] tracking-[-0.01em] text-transparent opacity-0 overflow-hidden">
              Barabar
              <span class="alt-barabar-glint absolute inset-0 pointer-events-none" aria-hidden="true"></span>
            </h2>
          </div>

          <p class="alt-barabar-sub mt-6 font-sans text-[clamp(0.85rem,2.2vw,1.35rem)] tracking-[0.24em] uppercase text-transparent opacity-0 drop-shadow-[0_4px_24px_rgba(0,0,0,0.95)]">
            <span class="inline-block w-6 h-[1.5px] bg-[#f39c12] mr-2 align-middle"></span>
            El reflejo imposible de una tecnología perdida
          </p>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════
         PASO 3: DIQUÍS — FRACTURA LATERAL & DESINTEGRACIÓN EN NIEBLA
    ══════════════════════════════════════════════════════════════════════ -->
    <div
      class="alt-layer absolute inset-0 w-full h-full opacity-0 pointer-events-none"
      data-layer-index="3"
    >
      <div class="alt-bg-wrap absolute inset-0 overflow-hidden">
        <img
          src={imgDiquis.src}
          alt="Esfera colosal de piedra en la selva de Diquís"
          class="alt-img absolute inset-0 w-full h-full object-cover object-right sm:object-center filter brightness-105 contrast-105 saturate-100 will-change-transform"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="absolute inset-0 pointer-events-none bg-linear-to-r from-black/65 via-black/20 to-transparent"></div>
      <div class="alt-grain absolute inset-0 pointer-events-none"></div>

      <div class="absolute inset-0 flex items-center justify-start z-20 pointer-events-none pl-6 sm:pl-14 md:pl-20 pr-6">
        <div class="alt-diquis-slot relative flex flex-col items-start text-left max-w-5xl">
          <span class="alt-badge inline-block mb-3 font-mono text-[9px] sm:text-[10px] tracking-[0.3em] uppercase text-[#FF4D55] py-0.5 px-3 rounded-full border border-white/10 bg-white/5 backdrop-blur-md opacity-0 drop-shadow-md">
            Costa Rica · Geometría Esférica Sagrada
          </span>

          <div class="alt-diquis-tectonic relative inline-block">
            <h2 class="alt-diquis-h1 relative m-0 font-serif font-black uppercase whitespace-nowrap text-[clamp(3.8rem,15vw,14rem)] leading-[0.88] tracking-[-0.02em] opacity-0">
              <span class="alt-sizer block opacity-0" aria-hidden="true">Diquís</span>
              <span class="alt-band absolute inset-x-0 top-1/2 h-0 -translate-y-1/2 pointer-events-none" aria-hidden="true"></span>
              <span class="alt-half alt-top absolute inset-0 block text-transparent" aria-hidden="true">Diquís</span>
              <span class="alt-half alt-bot absolute inset-0 block text-transparent" aria-hidden="true">Diquís</span>
            </h2>
            <p class="alt-diquis-sub absolute left-1 top-1/2 -translate-y-1/2 m-0 font-sans text-[clamp(0.8rem,1.8vw,1.3rem)] tracking-[0.28em] uppercase text-[#F5D0D2] opacity-0 drop-shadow-[0_4px_24px_rgba(0,0,0,0.95)]">
              El enigma lítico de la selva
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════
         PASO 4: OLMECAS — FRACTURA TECTÓNICA CENTRAL & ACCESO A COLECCIÓN
    ══════════════════════════════════════════════════════════════════════ -->
    <div
      class="alt-layer absolute inset-0 w-full h-full opacity-0 pointer-events-none"
      data-layer-index="4"
    >
      <div class="alt-bg-wrap absolute inset-0 overflow-hidden">
        <img
          src={imgOlmeca.src}
          alt="Cabeza colosal Olmeca"
          class="alt-img absolute inset-0 w-full h-full object-cover filter brightness-105 contrast-105 saturate-100 will-change-transform"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="absolute inset-x-0 bottom-0 h-36 sm:h-48 bg-linear-to-t from-black/75 via-black/25 to-transparent pointer-events-none"></div>
      <div class="alt-grain absolute inset-0 pointer-events-none"></div>

      <div class="absolute inset-0 flex items-center justify-center z-20 pointer-events-none px-4">
        <div class="alt-olmeca-slot relative flex flex-col items-center text-center max-w-6xl">
          <span class="alt-badge inline-block mb-3 font-mono text-[9px] sm:text-[10px] tracking-[0.3em] uppercase text-[#F0C284] py-0.5 px-3 rounded-full border border-white/10 bg-white/5 backdrop-blur-md opacity-0 drop-shadow-md">
            Mesoamérica · Escultura Colosal de Basalto
          </span>

          <div class="alt-olmeca-tectonic relative inline-block">
            <h2 class="alt-olmeca-h1 relative m-0 font-serif font-black uppercase whitespace-nowrap text-[clamp(3.8rem,15vw,14rem)] leading-[0.88] tracking-[-0.02em] opacity-0">
              <span class="alt-sizer block opacity-0" aria-hidden="true">Olmecas</span>
              <span class="alt-band absolute inset-x-0 top-1/2 h-0 -translate-y-1/2 pointer-events-none" aria-hidden="true"></span>
              <span class="alt-half alt-top absolute inset-0 block text-transparent" aria-hidden="true">Olmecas</span>
              <span class="alt-half alt-bot absolute inset-0 block text-transparent" aria-hidden="true">Olmecas</span>
            </h2>
            <p class="alt-olmeca-sub absolute left-1 top-1/2 -translate-y-1/2 m-0 font-sans text-[clamp(0.8rem,1.8vw,1.3rem)] tracking-[0.28em] uppercase text-[#FDE5CA] opacity-0 drop-shadow-[0_4px_24px_rgba(0,0,0,0.95)]">
              La fractura primigenia de Mesoamérica
            </p>
          </div>

          <!-- CTA de Entrada a Colección -->
          <div class="alt-cta-wrap mt-8 pointer-events-auto opacity-0">
            <a
              href="/colecciones/enigmas-subterraneos/"
              class="group inline-flex items-center gap-3 px-7 py-3.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-[#EFEBE3] hover:text-white backdrop-blur-md transition-all duration-300 shadow-2xl cursor-pointer"
            >
              <span class="font-metadata text-[10px] sm:text-[11px] uppercase tracking-[0.3em] font-bold">
                Explorar Colección Completa
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="group-hover:translate-x-1.5 transition-transform duration-300"
              >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════
         INDICADORES MINIMALISTAS AL PIE (Puntos de control discretos)
    ══════════════════════════════════════════════════════════════════════ -->
    <footer class="absolute bottom-4 sm:bottom-6 inset-x-0 z-30 flex items-center justify-between px-6 sm:px-10 pointer-events-none">
      <div class="flex items-center gap-2 pointer-events-auto">
        <span class="font-mono text-[8px] sm:text-[9px] uppercase tracking-[0.25em] text-white/40">Capítulos:</span>
        {[0, 1, 2, 3, 4].map((stepIdx) => (
          <button
            type="button"
            class:list={[
              "alt-step-btn w-6 sm:w-7 h-1.5 rounded-full transition-all duration-500 cursor-pointer focus:outline-none",
              stepIdx === 0 ? "bg-[#E69A46] w-9 sm:w-11 is-active" : "bg-white/20 hover:bg-white/40"
            ]}
            data-step={stepIdx}
            aria-label={`Ir al capítulo ${stepIdx}`}
          ></button>
        ))}
      </div>

      <div class="hidden sm:flex items-center gap-2 font-mono text-[8.5px] uppercase tracking-[0.3em] text-white/40">
        <span>IMAX MAX · TGP</span>
      </div>
    </footer>

  </div>
</section>

<style>
  /* ALTERNATIVE */
  .alt-intro-title {
    font-family: 'Fraunces', serif;
    font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
    background: linear-gradient(180deg, #FFFFFF 0%, #E69A46 45%, #8B2500 100%);
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 20px 45px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 60px rgba(230, 154, 70, 0.45));
  }

  /* DERINKUYU */
  .alt-3d-viewport {
    perspective: 1200px;
    perspective-origin: 50% 50%;
  }

  .alt-derinkuyu-chamber {
    transform-style: preserve-3d;
  }

  .alt-derin-h1 {
    font-family: 'Clash Display', sans-serif;
    background: linear-gradient(180deg, #ffffff 0%, #d45632 45%, #4a0d06 100%);
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 20px 45px rgba(0, 0, 0, 0.98)) drop-shadow(0 0 60px rgba(212, 86, 50, 0.45));
  }

  /* BARABAR */
  .alt-barabar-solid {
    font-family: 'Syne', sans-serif;
    background: linear-gradient(180deg, #ffffff 0%, #e5e5e5 32%, #85929e 70%, #2c3e50 100%);
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 20px 45px rgba(0, 0, 0, 0.98)) drop-shadow(0 0 45px rgba(229, 229, 229, 0.28));
  }

  .alt-echo-1 { -webkit-text-stroke: 1.5px rgba(243, 156, 18, 0.55); }
  .alt-echo-2 { -webkit-text-stroke: 1.5px rgba(229, 229, 229, 0.7); }
  .alt-echo-3 { -webkit-text-stroke: 1.5px rgba(176, 183, 189, 0.6); }
  .alt-echo-4 { -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.4); }

  .alt-barabar-glint {
    background: linear-gradient(
      110deg,
      transparent 18%,
      rgba(255, 255, 255, 0.95) 45%,
      rgba(243, 156, 18, 0.8) 50%,
      rgba(255, 255, 255, 0.95) 55%,
      transparent 82%
    );
    transform: translateX(-160%) skewX(-24deg);
    mix-blend-mode: color-dodge;
  }

  .alt-barabar-sub {
    background: linear-gradient(180deg, #fde3a7 0%, #f39c12 55%, #d35400 100%);
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 4px 18px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 25px rgba(243, 156, 18, 0.45));
  }

  /* DIQUÍS */
  .alt-diquis-h1 {
    font-family: 'Fraunces', serif;
    font-variation-settings: 'opsz' 9, 'SOFT' 0, 'WONK' 0;
  }

  .alt-diquis-tectonic .alt-half {
    background: linear-gradient(180deg, #ff4d55 0%, #e50914 42%, #9b0b11 78%, #4a0508 100%);
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 14px 38px rgba(0, 0, 0, 0.9)) drop-shadow(0 0 35px rgba(229, 9, 20, 0.4));
  }

  /* OLMECAS */
  .alt-olmeca-h1 {
    font-family: 'Fraunces', serif;
    font-variation-settings: 'opsz' 9, 'SOFT' 0, 'WONK' 0;
  }

  .alt-olmeca-tectonic .alt-half {
    background: linear-gradient(180deg, #f0c284 0%, #c98b4d 48%, #8a5328 100%);
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 14px 38px rgba(0, 0, 0, 0.9)) drop-shadow(0 0 32px rgba(201, 139, 77, 0.38));
  }

  /* Cortes dentados de falla tectónica */
  .alt-top {
    clip-path: polygon(
      0 0, 100% 0, 100% 50%, 93% 52.5%, 84% 48.5%, 73% 53%, 61% 49%,
      50% 52%, 38% 48%, 27% 53%, 15% 49.5%, 6% 52%, 0 50%
    );
  }

  .alt-bot {
    clip-path: polygon(
      0 50%, 6% 52%, 15% 49.5%, 27% 53%, 38% 48%, 50% 52%, 61% 49%,
      73% 53%, 84% 48.5%, 93% 52.5%, 100% 50%, 100% 100%, 0 100%
    );
  }

  /* Franja glassmórfica pura al 5% */
  .alt-band {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 0 25px rgba(0, 0, 0, 0.4);
  }

  /* Grano analógico A24 */
  .alt-grain {
    opacity: 0.18;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.92' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    animation: alt-grain-anim 0.8s steps(5) infinite;
  }

  @keyframes alt-grain-anim {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-2%, 1%); }
    50% { transform: translate(1%, -2%); }
    75% { transform: translate(-1%, 2%); }
    100% { transform: translate(0, 0); }
  }

  .alt-step-btn.is-active {
    background: #e69a46 !important;
    width: 2.5rem !important;
  }
</style>

<script>
  import { gsap } from "gsap";

  function setupImaxMaxNarrative() {
    const container = document.getElementById("imax-max-narrative-container");
    if (!container || container.dataset.ready === "true") return;
    container.dataset.ready = "true";

    const layers = container.querySelectorAll<HTMLElement>(".alt-layer");
    const stepBtns = container.querySelectorAll<HTMLButtonElement>(".alt-step-btn");
    const totalSteps = layers.length;
    if (totalSteps === 0) return;

    const autoDurationAttr = container.getAttribute("data-autoplay");
    const autoplayDuration = autoDurationAttr ? parseInt(autoDurationAttr, 10) : 6000;

    let currentIndex = 0;
    let autoTimer: any = null;
    let isVisible = false;
    let stepTimelines: Array<gsap.core.Timeline | null> = [null, null, null, null, null];

    // Partículas de ceniza para Derinkuyu
    const ashContainer = container.querySelector<HTMLElement>(".alt-ash");
    if (ashContainer) {
      ashContainer.innerHTML = "";
      const count = 28;
      const w = window.innerWidth;
      const h = window.innerHeight;
      for (let i = 0; i < count; i++) {
        const dot = document.createElement("span");
        const s = 1.2 + Math.random() * 2.6;
        dot.style.width = `${s}px`;
        dot.style.height = `${s}px`;
        dot.style.left = `${Math.random() * w}px`;
        dot.style.top = `${h * 0.4 + Math.random() * h * 0.5}px`;
        dot.style.opacity = "0";
        ashContainer.appendChild(dot);
        gsap.to(dot, {
          opacity: 0.15 + Math.random() * 0.5,
          y: -(30 + Math.random() * 100),
          x: (Math.random() - 0.5) * 50,
          duration: 3 + Math.random() * 3,
          ease: "sine.inOut",
          repeat: -1,
          yoyo: true,
          delay: Math.random() * 2,
        });
      }
    }

    // DISPARADORES CINEMÁTICOS PARTICULARES POR PASO
    function playStepAnimation(stepIndex: number) {
      stepTimelines[stepIndex]?.kill();
      const tl = gsap.timeline();
      stepTimelines[stepIndex] = tl;

      if (stepIndex === 0) {
        // ── PASO 0: APERTURA COLECCIÓN ALTERNATIVE ──
        const layer = layers[0];
        const title = layer.querySelector<HTMLElement>(".alt-intro-title");
        const h2 = layer.querySelector<HTMLElement>(".alt-intro-h2");
        const sub = layer.querySelector<HTMLElement>(".alt-intro-sub");
        const box = layer.querySelector<HTMLElement>(".alt-intro-box");
        const shockwave = layer.querySelector<HTMLElement>(".alt-intro-shockwave");
        const orb1 = layer.querySelector<HTMLElement>(".alt-ambient-orb-1");
        const orb2 = layer.querySelector<HTMLElement>(".alt-ambient-orb-2");
        if (!title || !h2 || !sub) return;

        gsap.set([title, h2], { opacity: 0 });
        gsap.set(sub, { opacity: 0, y: 18 });
        if (shockwave) gsap.set(shockwave, { scale: 0.2, opacity: 0 });

        tl.fromTo([orb1, orb2], { scale: 0.9, opacity: 0.5 }, { scale: 1.05, opacity: 1, duration: 0.8, ease: "power1.inOut" });

        tl.addLabel("beatAlternative");
        tl.fromTo(title, { opacity: 0, scale: 2.1, filter: "blur(20px)" }, { opacity: 1, scale: 1, filter: "blur(0px)", duration: 0.7, ease: "power4.out" }, "beatAlternative");

        if (shockwave) {
          tl.fromTo(shockwave, { scale: 0.2, opacity: 1 }, { scale: 7.5, opacity: 0, duration: 0.95, ease: "power2.out" }, "beatAlternative");
        }
        if (box) {
          tl.fromTo(box, { x: -4, y: 3 }, { x: 3, y: -2, duration: 0.04, repeat: 4, yoyo: true, ease: "none" }, "beatAlternative").to(box, { x: 0, y: 0, duration: 0.1 });
        }

        tl.addLabel("beatH2", "beatAlternative+=0.3");
        tl.fromTo(h2, { opacity: 0, scale: 1.35, y: 15, filter: "blur(8px)" }, { opacity: 1, scale: 1, y: 0, filter: "blur(0px)", duration: 0.5, ease: "power3.out" }, "beatH2");

        tl.to(sub, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" }, "beatH2+=0.25");
        tl.to(title, { scale: 1.02, duration: 0.6, yoyo: true, repeat: 1, ease: "sine.inOut" }, "beatH2+=0.5");

      } else if (stepIndex === 1) {
        // ── PASO 1: DERINKUYU (Paralaje Z) ──
        const layer = layers[1];
        const h1 = layer.querySelector<HTMLElement>(".alt-derin-h1");
        const sub = layer.querySelector<HTMLElement>(".alt-derin-sub");
        const badge = layer.querySelector<HTMLElement>(".alt-badge");
        const img = layer.querySelector<HTMLElement>(".alt-img");
        if (!h1 || !sub || !badge || !img) return;

        gsap.set(h1, { opacity: 0, scale: 1.06, z: 0, y: 0, filter: "blur(0px)" });
        gsap.set(sub, { opacity: 0, y: 35, filter: "blur(12px)" });
        gsap.set(badge, { opacity: 0, y: -15 });
        gsap.set(img, { scale: 1 });

        tl.to(badge, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" })
          .to(h1, { opacity: 1, scale: 1, duration: 1.2, ease: "power2.out" }, "-=0.4")
          .to({}, { duration: 0.7 })
          .addLabel("drop")
          .to(h1, { scale: 0.46, z: -480, y: 30, opacity: 0.14, filter: "blur(9px)", duration: 2.6, ease: "power3.inOut" }, "drop")
          .to(img, { scale: 1.07, duration: 3.0, ease: "power2.out" }, "drop")
          .to(sub, { opacity: 1, y: 0, filter: "blur(0px)", duration: 1.8, ease: "power2.out" }, "drop+=0.8");

      } else if (stepIndex === 2) {
        // ── PASO 2: BARABAR (Resonancia Sónica y Glint de Espejo) ──
        const layer = layers[2];
        const badge = layer.querySelector<HTMLElement>(".alt-badge");
        const solid = layer.querySelector<HTMLElement>(".alt-barabar-solid");
        const glint = layer.querySelector<HTMLElement>(".alt-barabar-glint");
        const sub = layer.querySelector<HTMLElement>(".alt-barabar-sub");
        const echoes = layer.querySelectorAll<HTMLElement>(".alt-barabar-echo");
        if (!badge || !solid || !glint || !sub || echoes.length === 0) return;

        gsap.set(badge, { opacity: 0, y: -15 });
        gsap.set(solid, { opacity: 0, scale: 0.98 });
        gsap.set(glint, { xPercent: -180 });
        gsap.set(sub, { opacity: 0, y: 35, filter: "blur(14px)" });
        echoes.forEach((echo) => {
          gsap.set(echo, { opacity: 0, scale: 1, x: 0, y: 0 });
        });

        tl.to(badge, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" });
        tl.addLabel("resonance");

        echoes.forEach((echo, idx) => {
          const spread = (idx + 1) * 16;
          tl.fromTo(
            echo,
            { opacity: 0, scale: 1 + (idx + 1) * 0.04, x: (idx % 2 === 0 ? -1 : 1) * spread },
            { opacity: 0.85 - idx * 0.15, duration: 0.45, ease: "power2.out" },
            "resonance"
          ).to(
            echo,
            { x: (idx % 2 === 0 ? 1 : -1) * (spread * 0.7), duration: 0.08, repeat: 6, yoyo: true, ease: "sine.inOut" },
            "resonance+=0.2"
          );
        });

        tl.addLabel("collapse", "resonance+=0.8");

        echoes.forEach((echo) => {
          tl.to(echo, { x: 0, scale: 1, opacity: 0, duration: 0.5, ease: "power3.in" }, "collapse");
        });

        tl.to(solid, { opacity: 1, scale: 1, duration: 0.75, ease: "power3.out" }, "collapse+=0.15")
          .to(glint, { xPercent: 180, duration: 1.1, ease: "power2.inOut" }, "collapse+=0.75")
          .to(sub, { opacity: 1, y: 0, filter: "blur(0px)", duration: 1.5, ease: "power3.out" }, "collapse+=0.95");

      } else if (stepIndex === 3) {
        // ── PASO 3: DIQUÍS (Fractura Lateral con Desintegración) ──
        const layer = layers[3];
        const tectonic = layer.querySelector<HTMLElement>(".alt-diquis-tectonic");
        const h1 = layer.querySelector<HTMLElement>(".alt-diquis-h1");
        const top = layer.querySelector<HTMLElement>(".alt-top");
        const bot = layer.querySelector<HTMLElement>(".alt-bot");
        const band = layer.querySelector<HTMLElement>(".alt-band");
        const sub = layer.querySelector<HTMLElement>(".alt-diquis-sub");
        const badge = layer.querySelector<HTMLElement>(".alt-badge");
        if (!tectonic || !h1 || !top || !bot || !band || !sub || !badge) return;

        const w = h1.offsetWidth;
        const h = h1.offsetHeight;
        const gap = Math.max(h * 0.36, 42);
        const shift = Math.max(12, w * 0.025);
        band.style.height = `${gap}px`;

        gsap.set(tectonic, { x: 0 });
        gsap.set([top, bot], { x: 0, y: 0, opacity: 1, filter: "none", scale: 1 });
        gsap.set(band, { scaleY: 0, opacity: 1, filter: "none" });
        gsap.set(sub, { opacity: 0, filter: "blur(12px)", y: 0 });
        gsap.set(h1, { opacity: 0, scale: 1.04 });
        gsap.set(badge, { opacity: 0, y: -15 });

        tl.to(badge, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" })
          .to(h1, { opacity: 1, scale: 1, duration: 1.1, ease: "power2.out" }, "-=0.4")
          .to({}, { duration: 0.6 })
          .fromTo(tectonic, { x: -2.5 }, { x: 2.5, duration: 0.04, repeat: 10, yoyo: true, ease: "none" })
          .set(tectonic, { x: 0 })
          .addLabel("fracture")
          .to(top, { x: -shift, y: -gap / 2, duration: 1.4, ease: "power4.inOut" }, "fracture")
          .to(bot, { x: shift, y: gap / 2, duration: 1.4, ease: "power4.inOut" }, "fracture")
          .to(band, { scaleY: 1, duration: 1.4, ease: "power4.inOut" }, "fracture")
          .to(sub, { opacity: 1, filter: "blur(0px)", duration: 1.4, ease: "power2.out" }, "fracture+=0.7")
          .to([top, bot, band], { opacity: 0, filter: "blur(18px)", scale: 1.05, duration: 2.0, ease: "power2.out" }, "fracture+=1.3");

      } else if (stepIndex === 4) {
        // ── PASO 4: OLMECAS (Fractura Tectónica Central + CTA) ──
        const layer = layers[4];
        const tectonic = layer.querySelector<HTMLElement>(".alt-olmeca-tectonic");
        const h1 = layer.querySelector<HTMLElement>(".alt-olmeca-h1");
        const top = layer.querySelector<HTMLElement>(".alt-top");
        const bot = layer.querySelector<HTMLElement>(".alt-bot");
        const band = layer.querySelector<HTMLElement>(".alt-band");
        const sub = layer.querySelector<HTMLElement>(".alt-olmeca-sub");
        const badge = layer.querySelector<HTMLElement>(".alt-badge");
        const cta = layer.querySelector<HTMLElement>(".alt-cta-wrap");
        if (!tectonic || !h1 || !top || !bot || !band || !sub || !badge || !cta) return;

        const w = h1.offsetWidth;
        const h = h1.offsetHeight;
        const gap = Math.max(h * 0.42, 52);
        const shift = Math.max(16, w * 0.032);
        band.style.height = `${gap}px`;

        gsap.set(tectonic, { x: 0 });
        gsap.set([top, bot], { x: 0, y: 0, opacity: 1 });
        gsap.set(band, { scaleY: 0 });
        gsap.set(sub, { opacity: 0, filter: "blur(12px)", y: 0 });
        gsap.set(h1, { opacity: 0, scale: 1.06 });
        gsap.set(badge, { opacity: 0, y: -15 });
        gsap.set(cta, { opacity: 0, y: 20 });

        tl.to(badge, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" })
          .to(h1, { opacity: 1, scale: 1, duration: 1.2, ease: "power2.out" }, "-=0.4")
          .to({}, { duration: 0.7 })
          .fromTo(tectonic, { x: -3 }, { x: 3, duration: 0.04, repeat: 12, yoyo: true, ease: "none" })
          .set(tectonic, { x: 0 })
          .addLabel("fracture")
          .to(top, { x: -shift, y: -gap / 2, duration: 1.5, ease: "power4.inOut" }, "fracture")
          .to(bot, { x: shift, y: gap / 2, duration: 1.5, ease: "power4.inOut" }, "fracture")
          .to(band, { scaleY: 1, duration: 1.5, ease: "power4.inOut" }, "fracture")
          .to(sub, { opacity: 1, filter: "blur(0px)", duration: 1.5, ease: "power2.out" }, "fracture+=0.8")
          .to(cta, { opacity: 1, y: 0, duration: 1.1, ease: "power3.out" }, "fracture+=1.2");
      }
    }

    function goToStep(targetIndex: number) {
      if (targetIndex < 0 || targetIndex >= totalSteps) return;
      if (targetIndex === currentIndex && layers[targetIndex].classList.contains("opacity-100")) return;

      const prevIndex = currentIndex;
      currentIndex = targetIndex;

      const prevLayer = layers[prevIndex];
      const nextLayer = layers[targetIndex];

      // Actualizar botones de paso
      stepBtns.forEach((btn, bIdx) => {
        if (bIdx === currentIndex) {
          btn.classList.add("is-active", "bg-[#E69A46]");
          btn.classList.remove("bg-white/20");
        } else {
          btn.classList.remove("is-active", "bg-[#E69A46]");
          btn.classList.add("bg-white/20");
        }
      });

      if (prevLayer && prevLayer !== nextLayer) {
        stepTimelines[prevIndex]?.kill();
        gsap.to(prevLayer, {
          opacity: 0,
          duration: 0.65,
          ease: "power2.inOut",
          onComplete: () => {
            prevLayer.classList.remove("pointer-events-auto");
            prevLayer.classList.add("pointer-events-none");
          },
        });
      }

      if (nextLayer) {
        nextLayer.classList.remove("pointer-events-none");
        nextLayer.classList.add("pointer-events-auto");

        gsap.to(nextLayer, {
          opacity: 1,
          duration: 0.7,
          ease: "power2.out",
          onStart: () => {
            playStepAnimation(targetIndex);
          },
        });
      }
    }

    function startAutoTimer() {
      stopAutoTimer();
      autoTimer = setInterval(() => {
        if (isVisible) {
          const next = (currentIndex + 1) % totalSteps;
          goToStep(next);
        }
      }, autoplayDuration);
    }

    function stopAutoTimer() {
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    function resetAutoTimer() {
      startAutoTimer();
    }

    // Interacción manual en botones de paso
    stepBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = parseInt(btn.dataset.step || "0", 10);
        goToStep(target);
        resetAutoTimer();
      });
    });

    let ticking = false;
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          ticking = false;
          if (!container) return;
          const rect = container.getBoundingClientRect();
          const scrollableDistance = rect.height - window.innerHeight;
          if (scrollableDistance <= 0) return;

          if (rect.top <= 0 && rect.bottom >= window.innerHeight) {
            const rawProgress = -rect.top / scrollableDistance;
            const progress = Math.min(Math.max(rawProgress, 0), 1);
            const slice = 1 / totalSteps;
            const target = Math.min(Math.floor(progress / slice), totalSteps - 1);
            if (target !== currentIndex) {
              goToStep(target);
              resetAutoTimer();
            }
          }
        });
        ticking = true;
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            startAutoTimer();
            playStepAnimation(currentIndex);
          } else {
            stopAutoTimer();
          }
        });
      },
      { threshold: 0.15 }
    );
    observer.observe(container);

    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupImaxMaxNarrative);
  } else {
    setupImaxMaxNarrative();
  }
  document.addEventListener("astro:page-load", setupImaxMaxNarrative);
</script>
