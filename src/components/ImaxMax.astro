<script>
  import gsap from "gsap";

  function setupSingleImaxMax(container: HTMLElement) {
    if (container.dataset.ready === "true") return;
    container.dataset.ready = "true";

    const isAmerica = container.dataset.collection === "america";
    const autoplayDuration = parseInt(container.dataset.autoplay || "6500", 10);
    const layers = container.querySelectorAll<HTMLElement>(".imax-layer");
    const stepBtns = container.querySelectorAll<HTMLElement>(".imax-step-btn");
    const totalSteps = layers.length;
    if (totalSteps === 0) return;

    let currentIndex = 0;
    let autoTimer: any = null;
    let isVisible = false;
    const stepTimelines: { [key: number]: gsap.core.Timeline } = {};

    function playStepAnimation(stepIndex: number) {
      stepTimelines[stepIndex]?.kill();
      const tl = gsap.timeline();
      stepTimelines[stepIndex] = tl;

      if (isAmerica) {
        // ═══════════════════════════════════════════════════════════════
        // DISPARADORES AMÉRICA SECRETS
        // ═══════════════════════════════════════════════════════════════
        if (stepIndex === 0) {
          // PASO 0: INTRO AMÉRICA SECRETS
          const layer = layers[0];
          const title = layer.querySelector<HTMLElement>(".am-intro-title");
          const secretsWord = layer.querySelector<HTMLElement>(".am-secrets-word");
          const laserLine = layer.querySelector<HTMLElement>(".am-laser-line");
          const sub = layer.querySelector<HTMLElement>(".am-intro-sub");
          if (!title || !secretsWord || !laserLine || !sub) return;

          gsap.set(title, { opacity: 0, scale: 1.08 });
          gsap.set(secretsWord, { clipPath: "inset(0 100% 0 0)" });
          gsap.set(laserLine, { left: "0%", opacity: 0 });
          gsap.set(sub, { opacity: 0, y: 15 });

          tl.to(title, { opacity: 1, scale: 1, duration: 1.2, ease: "power2.out" })
            .to({}, { duration: 0.4 })
            .to(laserLine, { opacity: 1, duration: 0.15, ease: "none" }, "laserCut")
            .to(laserLine, { left: "100%", duration: 1.6, ease: "power1.inOut" }, "laserCut")
            .to(secretsWord, { clipPath: "inset(0 0% 0 0)", duration: 1.6, ease: "power1.inOut" }, "laserCut")
            .to(laserLine, { opacity: 0, duration: 0.2, ease: "none" }, "laserCut+=1.6")
            .to(sub, { opacity: 1, y: 0, duration: 0.9, ease: "power2.out" }, "laserCut+=1.2");

        } else if (stepIndex === 1) {
          // PASO 1: PUMAPUNKU (Corte CNC Andesita)
          const layer = layers[1];
          const badge = layer.querySelector<HTMLElement>(".imax-badge");
          const title = layer.querySelector<HTMLElement>(".am-pp-title");
          const laser = layer.querySelector<HTMLElement>(".am-pp-laser");
          const sub = layer.querySelector<HTMLElement>(".am-pp-sub");
          const img = layer.querySelector<HTMLElement>(".imax-img");
          if (!badge || !title || !laser || !sub || !img) return;

          gsap.set(badge, { opacity: 0, y: -15 });
          gsap.set(title, { opacity: 0, scale: 1.06, clipPath: "inset(0 100% 0 0)" });
          gsap.set(laser, { left: "0%", opacity: 0 });
          gsap.set(sub, { opacity: 0, y: 20 });
          gsap.set(img, { scale: 1 });

          tl.to(badge, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" })
            .to(laser, { opacity: 1, duration: 0.15, ease: "none" }, "cut")
            .to(title, { opacity: 1, duration: 0.2 }, "cut")
            .to(laser, { left: "100%", duration: 1.8, ease: "power1.inOut" }, "cut")
            .to(title, { clipPath: "inset(0 0% 0 0)", duration: 1.8, ease: "power1.inOut" }, "cut")
            .to(laser, { opacity: 0, duration: 0.2 }, "cut+=1.8")
            .to(title, { scale: 1, duration: 0.4, ease: "power4.out" }, "cut+=1.8")
            .to(img, { scale: 1.05, duration: 3.5, ease: "power2.out" }, "cut")
            .to(sub, { opacity: 1, y: 0, duration: 1.2, ease: "power2.out" }, "cut+=1.4");

        } else if (stepIndex === 2) {
          // PASO 2: OLMECAS (Fractura Tectónica de Basalto)
          const layer = layers[2];
          const tectonic = layer.querySelector<HTMLElement>(".am-olmeca-tectonic");
          const h1 = layer.querySelector<HTMLElement>(".am-olmeca-h1");
          const top = layer.querySelector<HTMLElement>(".am-top");
          const bot = layer.querySelector<HTMLElement>(".am-bot");
          const band = layer.querySelector<HTMLElement>(".am-band");
          const sub = layer.querySelector<HTMLElement>(".am-olmeca-sub");
          const badge = layer.querySelector<HTMLElement>(".imax-badge");
          if (!tectonic || !h1 || !top || !bot || !band || !sub || !badge) return;

          const w = h1.offsetWidth;
          const h = h1.offsetHeight;
          const gap = Math.max(h * 0.42, 52);
          const shift = Math.max(16, w * 0.032);
          band.style.height = `${gap}px`;

          gsap.set(tectonic, { x: 0 });
          gsap.set([top, bot], { x: 0, y: 0, opacity: 1 });
          gsap.set(band, { scaleY: 0 });
          gsap.set(sub, { opacity: 0, filter: "blur(12px)", y: 0 });
          gsap.set(h1, { opacity: 0, scale: 1.06 });
          gsap.set(badge, { opacity: 0, y: -15 });

          tl.to(badge, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" })
            .to(h1, { opacity: 1, scale: 1, duration: 1.2, ease: "power2.out" }, "-=0.4")
            .to({}, { duration: 0.6 })
            .fromTo(tectonic, { x: -3 }, { x: 3, duration: 0.04, repeat: 10, yoyo: true, ease: "none" })
            .set(tectonic, { x: 0 })
            .addLabel("fracture")
            .to(top, { x: -shift, y: -gap / 2, duration: 1.5, ease: "power4.inOut" }, "fracture")
            .to(bot, { x: shift, y: gap / 2, duration: 1.5, ease: "power4.inOut" }, "fracture")
            .to(band, { scaleY: 1, duration: 1.5, ease: "power4.inOut" }, "fracture")
            .to(sub, { opacity: 1, filter: "blur(0px)", duration: 1.5, ease: "power2.out" }, "fracture+=0.8");

        } else if (stepIndex === 3) {
          // PASO 3: DIQUÍS (Fractura Lateral y Niebla)
          const layer = layers[3];
          const tectonic = layer.querySelector<HTMLElement>(".am-diquis-tectonic");
          const h1 = layer.querySelector<HTMLElement>(".am-diquis-h1");
          const top = layer.querySelector<HTMLElement>(".am-top");
          const bot = layer.querySelector<HTMLElement>(".am-bot");
          const band = layer.querySelector<HTMLElement>(".am-band");
          const sub = layer.querySelector<HTMLElement>(".am-diquis-sub");
          const badge = layer.querySelector<HTMLElement>(".imax-badge");
          if (!tectonic || !h1 || !top || !bot || !band || !sub || !badge) return;

          const w = h1.offsetWidth;
          const h = h1.offsetHeight;
          const gap = Math.max(h * 0.36, 42);
          const shift = Math.max(12, w * 0.025);
          band.style.height = `${gap}px`;

          gsap.set(tectonic, { x: 0 });
          gsap.set([top, bot], { x: 0, y: 0, opacity: 1, filter: "none", scale: 1 });
          gsap.set(band, { scaleY: 0, opacity: 1 });
          gsap.set(sub, { opacity: 0, filter: "blur(12px)", y: 0 });
          gsap.set(h1, { opacity: 0, scale: 1.04 });
          gsap.set(badge, { opacity: 0, y: -15 });

          tl.to(badge, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" })
            .to(h1, { opacity: 1, scale: 1, duration: 1.1, ease: "power2.out" }, "-=0.4")
            .to({}, { duration: 0.6 })
            .fromTo(tectonic, { x: -2.5 }, { x: 2.5, duration: 0.04, repeat: 8, yoyo: true, ease: "none" })
            .set(tectonic, { x: 0 })
            .addLabel("fracture")
            .to(top, { x: -shift, y: -gap / 2, duration: 1.4, ease: "power4.inOut" }, "fracture")
            .to(bot, { x: shift, y: gap / 2, duration: 1.4, ease: "power4.inOut" }, "fracture")
            .to(band, { scaleY: 1, duration: 1.4, ease: "power4.inOut" }, "fracture")
            .to(sub, { opacity: 1, filter: "blur(0px)", duration: 1.4, ease: "power2.out" }, "fracture+=0.7")
            .to([top, bot, band], { opacity: 0, filter: "blur(18px)", scale: 1.05, duration: 2.0, ease: "power2.out" }, "fracture+=1.3");

        } else if (stepIndex === 4) {
          // PASO 4: MOAIS DE RAPA NUI + CTA
          const layer = layers[4];
          const badge = layer.querySelector<HTMLElement>(".imax-badge");
          const h1 = layer.querySelector<HTMLElement>(".am-moai-h1");
          const sub = layer.querySelector<HTMLElement>(".am-moai-sub");
          const cta = layer.querySelector<HTMLElement>(".imax-cta-wrap");
          const img = layer.querySelector<HTMLElement>(".imax-img");
          if (!badge || !h1 || !sub || !cta || !img) return;

          gsap.set(badge, { opacity: 0, y: -15 });
          gsap.set(h1, { opacity: 0, scale: 1.08 });
          gsap.set(sub, { opacity: 0, y: 20 });
          gsap.set(cta, { opacity: 0, y: 20 });
          gsap.set(img, { scale: 1 });

          tl.to(badge, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" })
            .to(h1, { opacity: 1, scale: 1, duration: 1.3, ease: "power3.out" }, "-=0.4")
            .to(img, { scale: 1.06, duration: 3.5, ease: "power2.out" }, 0)
            .to(sub, { opacity: 1, y: 0, duration: 1.1, ease: "power2.out" }, "-=0.6")
            .to(cta, { opacity: 1, y: 0, duration: 1.0, ease: "power3.out" }, "-=0.4");
        }

      } else {
        // ═══════════════════════════════════════════════════════════════
        // DISPARADORES ALTERNATIVE (SUBTERRÁNEA)
        // ═══════════════════════════════════════════════════════════════
        if (stepIndex === 0) {
          const layer = layers[0];
          const title = layer.querySelector<HTMLElement>(".alt-intro-title");
          const h2 = layer.querySelector<HTMLElement>(".alt-intro-h2");
          const sub = layer.querySelector<HTMLElement>(".alt-intro-sub");
          const box = layer.querySelector<HTMLElement>(".alt-intro-box");
          const shockwave = layer.querySelector<HTMLElement>(".alt-intro-shockwave");
          const orb1 = layer.querySelector<HTMLElement>(".alt-ambient-orb-1");
          const orb2 = layer.querySelector<HTMLElement>(".alt-ambient-orb-2");
          if (!title || !h2 || !sub) return;

          gsap.set([title, h2], { opacity: 0 });
          gsap.set(sub, { opacity: 0, y: 18 });
          if (shockwave) gsap.set(shockwave, { scale: 0.2, opacity: 0 });

          tl.fromTo([orb1, orb2], { scale: 0.9, opacity: 0.5 }, { scale: 1.05, opacity: 1, duration: 0.8, ease: "power1.inOut" });
          tl.addLabel("beatAlternative");
          tl.fromTo(title, { opacity: 0, scale: 2.1, filter: "blur(20px)" }, { opacity: 1, scale: 1, filter: "blur(0px)", duration: 0.7, ease: "power4.out" }, "beatAlternative");

          if (shockwave) {
            tl.fromTo(shockwave, { scale: 0.2, opacity: 1 }, { scale: 7.5, opacity: 0, duration: 0.95, ease: "power2.out" }, "beatAlternative");
          }
          if (box) {
            tl.fromTo(box, { x: -4, y: 3 }, { x: 3, y: -2, duration: 0.04, repeat: 4, yoyo: true, ease: "none" }, "beatAlternative").to(box, { x: 0, y: 0, duration: 0.1 });
          }

          tl.addLabel("beatH2", "beatAlternative+=0.3");
          tl.fromTo(h2, { opacity: 0, scale: 1.35, y: 15, filter: "blur(8px)" }, { opacity: 1, scale: 1, y: 0, filter: "blur(0px)", duration: 0.5, ease: "power3.out" }, "beatH2");
          tl.to(sub, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" }, "beatH2+=0.25");

        } else if (stepIndex === 1) {
          const layer = layers[1];
          const h1 = layer.querySelector<HTMLElement>(".alt-derin-h1");
          const sub = layer.querySelector<HTMLElement>(".alt-derin-sub");
          const badge = layer.querySelector<HTMLElement>(".imax-badge");
          const img = layer.querySelector<HTMLElement>(".imax-img");
          if (!h1 || !sub || !badge || !img) return;

          gsap.set(h1, { opacity: 0, scale: 1.06, z: 0, y: 0, filter: "blur(0px)" });
          gsap.set(sub, { opacity: 0, y: 35, filter: "blur(12px)" });
          gsap.set(badge, { opacity: 0, y: -15 });
          gsap.set(img, { scale: 1 });

          tl.to(badge, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" })
            .to(h1, { opacity: 1, scale: 1, duration: 1.2, ease: "power2.out" }, "-=0.4")
            .to({}, { duration: 0.7 })
            .addLabel("drop")
            .to(h1, { scale: 0.46, z: -480, y: 30, opacity: 0.14, filter: "blur(9px)", duration: 2.6, ease: "power3.inOut" }, "drop")
            .to(img, { scale: 1.07, duration: 3.0, ease: "power2.out" }, "drop")
            .to(sub, { opacity: 1, y: 0, filter: "blur(0px)", duration: 1.8, ease: "power2.out" }, "drop+=0.8");

        } else if (stepIndex === 2) {
          const layer = layers[2];
          const badge = layer.querySelector<HTMLElement>(".imax-badge");
          const solid = layer.querySelector<HTMLElement>(".alt-barabar-solid");
          const glint = layer.querySelector<HTMLElement>(".alt-barabar-glint");
          const sub = layer.querySelector<HTMLElement>(".alt-barabar-sub");
          const echoes = layer.querySelectorAll<HTMLElement>(".alt-barabar-echo");
          if (!badge || !solid || !glint || !sub || echoes.length === 0) return;

          gsap.set(badge, { opacity: 0, y: -15 });
          gsap.set(solid, { opacity: 0, scale: 0.98 });
          gsap.set(glint, { xPercent: -180 });
          gsap.set(sub, { opacity: 0, y: 35, filter: "blur(14px)" });
          echoes.forEach((echo) => {
            gsap.set(echo, { opacity: 0, scale: 1, x: 0, y: 0 });
          });

          tl.to(badge, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" });
          tl.addLabel("resonance");

          echoes.forEach((echo, idx) => {
            const spread = (idx + 1) * 16;
            tl.fromTo(
              echo,
              { opacity: 0, scale: 1 + (idx + 1) * 0.04, x: (idx % 2 === 0 ? -1 : 1) * spread },
              { opacity: 0.85 - idx * 0.15, duration: 0.45, ease: "power2.out" },
              "resonance"
            ).to(
              echo,
              { x: (idx % 2 === 0 ? 1 : -1) * (spread * 0.7), duration: 0.08, repeat: 6, yoyo: true, ease: "sine.inOut" },
              "resonance+=0.2"
            );
          });

          tl.addLabel("collapse", "resonance+=0.8");
          echoes.forEach((echo) => {
            tl.to(echo, { x: 0, scale: 1, opacity: 0, duration: 0.5, ease: "power3.in" }, "collapse");
          });

          tl.to(solid, { opacity: 1, scale: 1, duration: 0.75, ease: "power3.out" }, "collapse+=0.15")
            .to(glint, { xPercent: 180, duration: 1.1, ease: "power2.inOut" }, "collapse+=0.75")
            .to(sub, { opacity: 1, y: 0, filter: "blur(0px)", duration: 1.5, ease: "power3.out" }, "collapse+=0.95");

        } else if (stepIndex === 3) {
          const layer = layers[3];
          const tectonic = layer.querySelector<HTMLElement>(".alt-diquis-tectonic");
          const h1 = layer.querySelector<HTMLElement>(".alt-diquis-h1");
          const top = layer.querySelector<HTMLElement>(".alt-top");
          const bot = layer.querySelector<HTMLElement>(".alt-bot");
          const band = layer.querySelector<HTMLElement>(".alt-band");
          const sub = layer.querySelector<HTMLElement>(".alt-diquis-sub");
          const badge = layer.querySelector<HTMLElement>(".imax-badge");
          if (!tectonic || !h1 || !top || !bot || !band || !sub || !badge) return;

          const w = h1.offsetWidth;
          const h = h1.offsetHeight;
          const gap = Math.max(h * 0.36, 42);
          const shift = Math.max(12, w * 0.025);
          band.style.height = `${gap}px`;

          gsap.set(tectonic, { x: 0 });
          gsap.set([top, bot], { x: 0, y: 0, opacity: 1, filter: "none", scale: 1 });
          gsap.set(band, { scaleY: 0, opacity: 1 });
          gsap.set(sub, { opacity: 0, filter: "blur(12px)", y: 0 });
          gsap.set(h1, { opacity: 0, scale: 1.04 });
          gsap.set(badge, { opacity: 0, y: -15 });

          tl.to(badge, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" })
            .to(h1, { opacity: 1, scale: 1, duration: 1.1, ease: "power2.out" }, "-=0.4")
            .to({}, { duration: 0.6 })
            .fromTo(tectonic, { x: -2.5 }, { x: 2.5, duration: 0.04, repeat: 10, yoyo: true, ease: "none" })
            .set(tectonic, { x: 0 })
            .addLabel("fracture")
            .to(top, { x: -shift, y: -gap / 2, duration: 1.4, ease: "power4.inOut" }, "fracture")
            .to(bot, { x: shift, y: gap / 2, duration: 1.4, ease: "power4.inOut" }, "fracture")
            .to(band, { scaleY: 1, duration: 1.4, ease: "power4.inOut" }, "fracture")
            .to(sub, { opacity: 1, filter: "blur(0px)", duration: 1.4, ease: "power2.out" }, "fracture+=0.7")
            .to([top, bot, band], { opacity: 0, filter: "blur(18px)", scale: 1.05, duration: 2.0, ease: "power2.out" }, "fracture+=1.3");

        } else if (stepIndex === 4) {
          const layer = layers[4];
          const tectonic = layer.querySelector<HTMLElement>(".alt-olmeca-tectonic");
          const h1 = layer.querySelector<HTMLElement>(".alt-olmeca-h1");
          const top = layer.querySelector<HTMLElement>(".alt-top");
          const bot = layer.querySelector<HTMLElement>(".alt-bot");
          const band = layer.querySelector<HTMLElement>(".alt-band");
          const sub = layer.querySelector<HTMLElement>(".alt-olmeca-sub");
          const badge = layer.querySelector<HTMLElement>(".imax-badge");
          const cta = layer.querySelector<HTMLElement>(".imax-cta-wrap");
          if (!tectonic || !h1 || !top || !bot || !band || !sub || !badge || !cta) return;

          const w = h1.offsetWidth;
          const h = h1.offsetHeight;
          const gap = Math.max(h * 0.42, 52);
          const shift = Math.max(16, w * 0.032);
          band.style.height = `${gap}px`;

          gsap.set(tectonic, { x: 0 });
          gsap.set([top, bot], { x: 0, y: 0, opacity: 1 });
          gsap.set(band, { scaleY: 0 });
          gsap.set(sub, { opacity: 0, filter: "blur(12px)", y: 0 });
          gsap.set(h1, { opacity: 0, scale: 1.06 });
          gsap.set(badge, { opacity: 0, y: -15 });
          gsap.set(cta, { opacity: 0, y: 20 });

          tl.to(badge, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" })
            .to(h1, { opacity: 1, scale: 1, duration: 1.2, ease: "power2.out" }, "-=0.4")
            .to({}, { duration: 0.7 })
            .fromTo(tectonic, { x: -3 }, { x: 3, duration: 0.04, repeat: 12, yoyo: true, ease: "none" })
            .set(tectonic, { x: 0 })
            .addLabel("fracture")
            .to(top, { x: -shift, y: -gap / 2, duration: 1.5, ease: "power4.inOut" }, "fracture")
            .to(bot, { x: shift, y: gap / 2, duration: 1.5, ease: "power4.inOut" }, "fracture")
            .to(band, { scaleY: 1, duration: 1.5, ease: "power4.inOut" }, "fracture")
            .to(sub, { opacity: 1, filter: "blur(0px)", duration: 1.5, ease: "power2.out" }, "fracture+=0.8")
            .to(cta, { opacity: 1, y: 0, duration: 1.1, ease: "power3.out" }, "fracture+=1.2");
        }
      }
    }

    const activeColor = isAmerica ? "bg-[#4ef2d2]" : "bg-[#E69A46]";

    function goToStep(targetIndex: number) {
      if (targetIndex < 0 || targetIndex >= totalSteps) return;
      if (targetIndex === currentIndex && layers[targetIndex].classList.contains("opacity-100")) return;

      const prevIndex = currentIndex;
      currentIndex = targetIndex;

      const prevLayer = layers[prevIndex];
      const nextLayer = layers[targetIndex];

      stepBtns.forEach((btn, bIdx) => {
        if (bIdx === currentIndex) {
          btn.classList.add("is-active", activeColor);
          btn.classList.remove("bg-white/20");
        } else {
          btn.classList.remove("is-active", activeColor);
          btn.classList.add("bg-white/20");
        }
      });

      if (prevLayer && prevLayer !== nextLayer) {
        stepTimelines[prevIndex]?.kill();
        gsap.to(prevLayer, {
          opacity: 0,
          duration: 0.65,
          ease: "power2.inOut",
          onComplete: () => {
            prevLayer.classList.remove("pointer-events-auto");
            prevLayer.classList.add("pointer-events-none");
          },
        });
      }

      if (nextLayer) {
        nextLayer.classList.remove("pointer-events-none");
        nextLayer.classList.add("pointer-events-auto");

        gsap.to(nextLayer, {
          opacity: 1,
          duration: 0.7,
          ease: "power2.out",
          onStart: () => {
            playStepAnimation(targetIndex);
          },
        });
      }
    }

    function startAutoTimer() {
      stopAutoTimer();
      autoTimer = setInterval(() => {
        if (isVisible) {
          const next = (currentIndex + 1) % totalSteps;
          goToStep(next);
        }
      }, autoplayDuration);
    }

    function stopAutoTimer() {
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    function resetAutoTimer() {
      startAutoTimer();
    }

    stepBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = parseInt(btn.dataset.step || "0", 10);
        goToStep(target);
        resetAutoTimer();
      });
    });

    let ticking = false;
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          ticking = false;
          if (!container) return;
          const rect = container.getBoundingClientRect();
          const scrollableDistance = rect.height - window.innerHeight;
          if (scrollableDistance <= 0) return;

          if (rect.top <= 0 && rect.bottom >= window.innerHeight) {
            const rawProgress = -rect.top / scrollableDistance;
            const progress = Math.min(Math.max(rawProgress, 0), 1);
            const slice = 1 / totalSteps;
            const target = Math.min(Math.floor(progress / slice), totalSteps - 1);
            if (target !== currentIndex) {
              goToStep(target);
              resetAutoTimer();
            }
          }
        });
        ticking = true;
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            startAutoTimer();
            playStepAnimation(currentIndex);
          } else {
            stopAutoTimer();
          }
        });
      },
      { threshold: 0.15 }
    );
    observer.observe(container);

    window.addEventListener("scroll", onScroll, { passive: true });
  }

  function initAllImaxMaxNarratives() {
    const containers = document.querySelectorAll<HTMLElement>(".imax-max-narrative-container");
    containers.forEach(setupSingleImaxMax);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAllImaxMaxNarratives);
  } else {
    initAllImaxMaxNarratives();
  }
  document.addEventListener("astro:page-load", initAllImaxMaxNarratives);
</script>
