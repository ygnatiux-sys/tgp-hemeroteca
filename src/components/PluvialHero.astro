---
/**
 * src/components/PluvialHero.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * LA CICATRIZ DEL AGUA (Esfinge de Giza) — "Erosión Pluvial" (Cascada Vertical)
 *
 * 1. Paleta: Ocre Atardecer / Polvo de Caliza (#D4B886) + Sombra de Piedra (#141210).
 * 2. Tipografía: Corte a cincel angular y lapidario (GT Sectra / Cinzel Black 900).
 * 3. Animación GSAP:
 *    - El Diluvio: 14 franjas verticales caen en cascada a velocidades aleatorias.
 *    - El Impacto: Micro-vibración en Y y estallido de polvo de caliza al colapsar.
 *    - La Revelación en la Sombra: Subtítulo emerge en la grieta oscura con fade-in solar.
 */
interface Props {
  image: ImageMetadata;
  word?: string;
  subtitle?: string;
  speed?: number;
  showHud?: boolean;
  hudLabel?: string;
}

const {
  image,
  word = "LA CICATRIZ DEL AGUA",
  subtitle = "La geología que reescribe la cronología humana",
  speed = 0.6,
  showHud = true,
  hudLabel = "Erosión Pluvial · Giza",
} = Astro.props;

// Generar 14 estratos verticales (slices) de corte milimétrico
const sliceCount = 14;
const slices = Array.from({ length: sliceCount }, (_, i) => {
  const start = (i / sliceCount) * 100;
  const end = ((i + 1) / sliceCount) * 100 + 0.15; // micro-overlap para evitar grietas visuales
  return {
    index: i,
    clip: `polygon(${start}% 0%, ${end}% 0%, ${end}% 100%, ${start}% 100%)`,
  };
});
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cinzel:wght@800;900&family=Fraunces:opsz,wght,SOFT,WONK@9..144,900,0,1&display=swap"
/>

<section class="pluvial-stage" aria-label={word} data-initial-speed={speed}>
  <!-- Fondo cinemático de la roca erosionada por agua al atardecer -->
  <div class="pluvial-bg-wrap">
    <img
      src={image.src}
      alt="Recinto de la Esfinge de Giza con fisuras verticales de erosión pluvial"
      class="pluvial-img"
      loading="eager"
      decoding="async"
    />
  </div>

  <!-- Iluminación: Sombra de piedra orgánica (#141210) + Resplandor Solar Egipcio -->
  <div class="pluvial-vignette"></div>
  <div class="pluvial-sunlight"></div>
  <div class="pluvial-grain"></div>
  <div class="pluvial-dust-layer" aria-hidden="true"></div>

  <!-- Escenario Tipográfico -->
  <div class="pluvial-slot">
    <div class="pluvial-chamber">

      <!-- Badge Arqueogeológico -->
      <span class="pluvial-badge">
        <span class="pluvial-badge-dot"></span>
        Giza · Recinto de la Esfinge · Edad de Hielo
      </span>

      <!-- Bloque de Cascada Vertical (Estratos Pluviales) -->
      <div class="pluvial-cascade-wrap">
        <!-- Texto maestro sólido de reserva para dimensiones -->
        <h1 class="pluvial-master" aria-label={word}>
          {word}
        </h1>

        <!-- Contenedor de las 14 franjas verticales en caída -->
        <div class="pluvial-slices-box" aria-hidden="true">
          {
            slices.map((slice) => (
              <span
                class="pluvial-slice"
                data-slice-index={slice.index}
                style={`clip-path: ${slice.clip};`}
              >
                {word}
              </span>
            ))
          }
        </div>
      </div>

      <!-- H2/H3: Revelación en la penumbra de la grieta -->
      <h2 class="pluvial-sub">
        <span class="pluvial-sub-dash">—</span>
        {subtitle}
      </h2>
    </div>
  </div>

  {
    showHud ? (
      <div class="pluvial-hud">
        <div class="pluvial-hud-head">
          <span class="pluvial-hud-dot" />
          <span>{hudLabel}</span>
        </div>
        <button type="button" id="pluvial-replay" class="pluvial-hud-btn">
          Desatar Diluvio (Espacio)
        </button>
        <div class="pluvial-hud-speeds">
          <button type="button" class="pluvial-speed" data-speed="1.5">Rápido</button>
          <button type="button" class="pluvial-speed" data-speed="1">Torrencial</button>
          <button type="button" class="pluvial-speed is-active" data-speed="0.6">Lento</button>
        </div>
      </div>
    ) : (
      <button type="button" id="pluvial-replay" class="pluvial-replay" aria-label="Repetir diluvio">
        ↻
      </button>
    )
  }
</section>

<noscript>
  <style>
    .pluvial-master,
    .pluvial-sub,
    .pluvial-badge {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
    .pluvial-slices-box {
      display: none !important;
    }
  </style>
</noscript>

<style>
  .pluvial-stage {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 580px;
    overflow: hidden;
    background: #141210;
    color: #fff;
    user-select: none;
  }

  .pluvial-bg-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .pluvial-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 18% 30%;
    filter: brightness(0.88) contrast(1.18) saturate(1.05);
    will-change: transform;
    animation: pluvial-drift 32s ease-in-out infinite alternate;
  }

  @keyframes pluvial-drift {
    from { transform: scale(1.02); }
    to { transform: scale(1.07); }
  }

  /* Sombra de piedra (#141210) orgánica y densa */
  .pluvial-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 50% 50%,
      rgba(20, 18, 16, 0.15) 0%,
      rgba(20, 18, 16, 0.65) 60%,
      rgba(20, 18, 16, 0.96) 96%
    );
    pointer-events: none;
  }

  /* Luz dorada rasante del atardecer sobre la pirámide y las crestas de caliza */
  .pluvial-sunlight {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 18% 28%,
      rgba(240, 220, 184, 0.28) 0%,
      rgba(212, 184, 134, 0.14) 28%,
      transparent 62%
    );
    mix-blend-mode: screen;
    pointer-events: none;
  }

  /* Grano analógico A24 */
  .pluvial-grain {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    pointer-events: none;
    animation: pluvial-grain-anim 0.8s steps(5) infinite;
  }

  @keyframes pluvial-grain-anim {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-2%, 1%); }
    50% { transform: translate(1%, -2%); }
    75% { transform: translate(-1%, 2%); }
    100% { transform: translate(0, 0); }
  }

  .pluvial-dust-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }

  .pluvial-dust-layer :global(span) {
    position: absolute;
    border-radius: 50%;
    background: #d4b886;
    pointer-events: none;
  }

  .pluvial-slot {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    pointer-events: none;
    padding: 2rem 4vw;
  }

  .pluvial-chamber {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 1400px;
    width: 100%;
  }

  .pluvial-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(0.6rem, 1vw, 0.72rem);
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #d4b886;
    padding: 0.35rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(212, 184, 134, 0.25);
    background: rgba(20, 18, 16, 0.55);
    backdrop-filter: blur(12px);
    margin-bottom: 1.6rem;
    opacity: 0;
  }

  .pluvial-badge-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: #d4b886;
    box-shadow: 0 0 10px #d4b886;
  }

  .pluvial-cascade-wrap {
    position: relative;
    display: inline-block;
  }

  /* TIPOGRAFÍA: Corte de Cincel Angular (Cinzel 900 / GT Sectra style) */
  .pluvial-master,
  .pluvial-slice {
    font-family: 'Cinzel', serif;
    font-weight: 900;
    font-size: clamp(1.5rem, 4.4vw, 4.5rem);
    line-height: 0.96;
    letter-spacing: 0.03em;
    word-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    margin: 0;
    padding: 0.04em 0.08em;
    background: linear-gradient(
      180deg,
      #f7ebd6 0%,
      #e8d1a7 30%,
      #d4b886 65%,
      #8e7040 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter: drop-shadow(0 18px 45px rgba(0, 0, 0, 0.98))
      drop-shadow(0 0 40px rgba(212, 184, 134, 0.32));
  }

  .pluvial-master {
    opacity: 0;
    visibility: hidden;
  }

  .pluvial-slices-box {
    position: absolute;
    inset: 0;
  }

  .pluvial-slice {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(-140%);
    will-change: transform, opacity;
  }

  /* SUBTÍTULO: Revelación en la sombra de la grieta */
  .pluvial-sub {
    margin: 1.8rem 0 0;
    font-family: 'Fraunces', serif;
    font-size: clamp(0.85rem, 2vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #ead5b3;
    opacity: 0;
    text-shadow: 0 4px 22px rgba(0, 0, 0, 0.95), 0 0 25px rgba(212, 184, 134, 0.35);
    will-change: transform, opacity, filter;
  }

  .pluvial-sub-dash {
    color: #d4b886;
    margin-right: 0.4rem;
  }

  /* HUD */
  .pluvial-hud {
    position: absolute;
    top: 5.5rem;
    right: 1.5rem;
    z-index: 30;
    width: 16rem;
    padding: 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-radius: 1rem;
    background: rgba(20, 18, 16, 0.88);
    border: 1px solid rgba(212, 184, 134, 0.24);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(16px);
    font-family: 'Inter', system-ui, sans-serif;
  }

  .pluvial-hud-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #d4b886;
    font-weight: 700;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pluvial-hud-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #d4b886;
    box-shadow: 0 0 8px #d4b886;
  }

  .pluvial-hud-btn {
    padding: 0.75rem;
    border-radius: 0.7rem;
    border: 0;
    cursor: pointer;
    background: linear-gradient(90deg, #d4b886, #ead5b3);
    color: #141210;
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .pluvial-hud-btn:hover {
    filter: brightness(1.1);
  }

  .pluvial-hud-btn:active {
    transform: scale(0.96);
  }

  .pluvial-hud-speeds {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 0.6rem;
    background: rgba(255, 255, 255, 0.05);
  }

  .pluvial-speed {
    padding: 0.4rem 0;
    border: 0;
    border-radius: 0.4rem;
    cursor: pointer;
    background: transparent;
    color: #b8aba0;
    font-size: 0.62rem;
  }

  .pluvial-speed.is-active {
    background: #d4b886;
    color: #141210;
    font-weight: 700;
  }

  .pluvial-replay {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 20;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(20, 18, 16, 0.6);
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.1rem;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all 0.25s ease;
  }

  .pluvial-replay:hover {
    color: #fff;
    border-color: #d4b886;
    transform: rotate(-90deg);
  }
</style>

<script>
  import gsap from "gsap";

  const setupPluvial = () => {
    const stage = document.querySelector<HTMLElement>(".pluvial-stage");
    if (!stage || stage.dataset.ready === "true") return;
    stage.dataset.ready = "true";

    const badge = stage.querySelector<HTMLElement>(".pluvial-badge");
    const cascadeWrap = stage.querySelector<HTMLElement>(".pluvial-cascade-wrap");
    const slices = stage.querySelectorAll<HTMLElement>(".pluvial-slice");
    const sub = stage.querySelector<HTMLElement>(".pluvial-sub");
    const dustLayer = stage.querySelector<HTMLElement>(".pluvial-dust-layer");
    const replayBtn = document.getElementById("pluvial-replay");
    const speedBtns = document.querySelectorAll<HTMLElement>(".pluvial-speed");

    if (!badge || !cascadeWrap || slices.length === 0 || !sub || !dustLayer) return;

    let speed = parseFloat(stage.dataset.initialSpeed || "0.6");
    let tl: gsap.core.Timeline | null = null;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Generar partículas de polvo de caliza tras el impacto
    const spawnLimestoneDust = () => {
      dustLayer.innerHTML = "";
      const count = 30;
      const rect = cascadeWrap.getBoundingClientRect();
      const stageRect = stage.getBoundingClientRect();
      const originX = rect.left - stageRect.left;
      const originY = rect.top - stageRect.top + rect.height * 0.5;

      for (let i = 0; i < count; i++) {
        const dot = document.createElement("span");
        const s = 1.2 + Math.random() * 2.8;
        dot.style.width = `${s}px`;
        dot.style.height = `${s}px`;
        dot.style.left = `${originX + Math.random() * rect.width}px`;
        dot.style.top = `${originY}px`;
        dot.style.opacity = "0";
        dustLayer.appendChild(dot);

        gsap.fromTo(
          dot,
          { opacity: 0, y: 0, scale: 0.6 },
          {
            opacity: 0.35 + Math.random() * 0.55,
            y: (Math.random() - 0.5) * 80 + 30,
            x: (Math.random() - 0.5) * 70,
            scale: 1.4,
            duration: 1.8 + Math.random() * 1.5,
            ease: "power2.out",
            onComplete: () => {
              gsap.to(dot, { opacity: 0, duration: 0.8, onComplete: () => dot.remove() });
            },
          }
        );
      }
    };

    const reset = () => {
      tl?.kill();
      tl = null;
      dustLayer.innerHTML = "";

      gsap.set(badge, { opacity: 0, y: -16 });
      gsap.set(sub, { opacity: 0, y: 35, filter: "blur(14px)" });
      gsap.set(cascadeWrap, { y: 0, filter: "none" });

      slices.forEach((slice) => {
        gsap.set(slice, {
          yPercent: -140,
          opacity: 0,
          scaleY: 1, // caída limpia sin solapamientos entre franjas
        });
      });
    };

    const play = async () => {
      if (document.fonts?.ready) await document.fonts.ready;
      reset();

      if (reduceMotion) {
        gsap.set([badge, sub], { opacity: 1, y: 0, filter: "none" });
        slices.forEach((s) => gsap.set(s, { yPercent: 0, opacity: 1, scaleY: 1 }));
        return;
      }

      tl = gsap.timeline();

      // FASE 0: Badge Geológico
      tl.to(badge, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" });

      // FASE 1: EL DILUVIO — Las 14 franjas verticales caen en cascada desfasada
      tl.addLabel("flood");

      // Orden desfasado natural (emulando hilos de lluvia torrencial)
      slices.forEach((slice, idx) => {
        const randomDelay = (idx % 3) * 0.08 + Math.sin(idx * 0.8) * 0.12 + 0.1;
        const duration = 1.1 + (idx % 4) * 0.08;

        tl.to(
          slice,
          {
            yPercent: 0,
            opacity: 1,
            scaleY: 1,
            duration: duration,
            ease: "power4.in",
          },
          `flood+=${randomDelay}`
        );
      });

      // FASE 2: EL IMPACTO (GOLPE DE AGUA Y POLVO DE CALIZA)
      // En el momento en que las últimas franjas impactan:
      tl.addLabel("impact", "flood+=1.35");
      tl.add(() => spawnLimestoneDust(), "impact");

      // Micro-temblor vertical y desenfoque por polvo
      tl.fromTo(
        cascadeWrap,
        { y: -3, filter: "blur(3.5px)" },
        { y: 3, filter: "blur(1.5px)", duration: 0.05, repeat: 5, yoyo: true, ease: "none" },
        "impact"
      )
      .to(cascadeWrap, { y: 0, filter: "blur(0px)", duration: 0.4, ease: "power2.out" });

      // FASE 3: LA REVELACIÓN EN LA SOMBRA (H2 en la grieta calcárea)
      tl.to(
        sub,
        {
          opacity: 1,
          y: 0,
          filter: "blur(0px)",
          duration: 1.8,
          ease: "power3.out",
        },
        "impact+=0.5"
      );

      tl.timeScale(speed);
    };

    reset();
    setTimeout(play, 450);

    replayBtn?.addEventListener("click", play);

    speedBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        speedBtns.forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        speed = parseFloat(btn.dataset.speed || "1");
        play();
      });
    });

    window.addEventListener("keydown", (e) => {
      if (e.code === "Space" && (e.target as HTMLElement)?.tagName !== "INPUT") {
        e.preventDefault();
        play();
      }
    });
  };

  document.addEventListener("astro:page-load", setupPluvial);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupPluvial);
  } else {
    setupPluvial();
  }
</script>
