---
/**
 * CinematicExcerptRest
 *
 * Franja negra de respiro visual con texto cinemático carácter a carácter.
 * Desarrollado con timeline puro (sin GSAP), con tipografía Libre Bodoni/Antique Didone,
 * motas de polvo de fondo llevadas por el viento (canvas) y efecto disolución de agua al finalizar.
 *
 * Sintaxis del prop `text`:
 *   **palabra**   → blanco brillante (glow)
 *   [[letra]]     → dorado TGP (acento)
 *   texto normal  → blanco tenue
 */

interface Props {
  text?: string;
  id?: string;
}

const {
  text = "Un ecosistema documental en **constante expansión.** Cada [[dossier]], un nodo verificado.",
  id = "excerpt-" + Math.random().toString(36).substring(2, 9),
} = Astro.props;

// ─── Tokenizador por palabras con soporte multipalabra para ** y [[ ]] ───
const rawWords = text.trim().split(/\s+/);
let currentMode: 'normal' | 'glow' | 'accent' = 'normal';

const wordsData = rawWords.map((rawWord, wordIdx) => {
  let word = rawWord;
  let type: 'normal' | 'glow' | 'accent' = currentMode;

  if (word.startsWith('**')) {
    currentMode = 'glow';
    type = 'glow';
    word = word.slice(2);
  } else if (word.startsWith('[[')) {
    currentMode = 'accent';
    type = 'accent';
    word = word.slice(2);
  }

  let endsGlow = false;
  let endsAccent = false;

  if (word.endsWith('**')) {
    endsGlow = true;
    word = word.slice(0, -2);
  } else if (word.includes('**')) {
    word = word.replace(/\*\*/g, '');
    endsGlow = true;
  }

  if (word.endsWith(']]') || word.includes(']].') || word.includes(']],') || word.includes(']]:') || word.includes(']];')) {
    endsAccent = true;
    word = word.replace(/\]\]/g, '');
  } else if (word.includes(']]')) {
    word = word.replace(/\]\]/g, '');
    endsAccent = true;
  }

  const cleanWord = word.replace(/\[\[/g, '').replace(/\]\]/g, '').replace(/\*\*/g, '');

  if (endsGlow || endsAccent) {
    currentMode = 'normal';
  }

  // Desglosar en caracteres
  const chars = Array.from(cleanWord).map((ch, charIdx) => ({
    char: ch,
    globalIdx: `${wordIdx}-${charIdx}`
  }));

  return {
    chars,
    type,
    original: rawWord
  };
});
---

<!-- Import de fuente Libre Bodoni para el componente -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Libre+Bodoni:ital,wght@0,400..700;1,400..700&display=swap');
</style>

<section
  id={id}
  class="cinematic-excerpt-rest relative w-full bg-(--bg-main) overflow-hidden select-none min-h-[85vh] flex flex-col justify-center"
  style="background-color: var(--bg-main);"
  data-text={text}
>
  <!-- Lienzo de partículas de polvo en movimiento (viento) -->
  <canvas class="excerpt-dust-canvas absolute inset-0 z-0 pointer-events-none" id={`${id}-canvas`}></canvas>

  {/* Breathing room superior — doble scroll de aire y tracking */}
  <div class="h-[22vh] md:h-[30vh]" aria-hidden="true"></div>

  {/* Contenedor central de lectura */}
  <div class="excerpt-content relative z-10 max-w-3xl mx-auto px-6 md:px-16 text-center">
    <p class="excerpt-headline leading-[1.85] tracking-wide text-balance" id={`${id}-headline`}>
      {
        wordsData.map((wd) => (
          <span class="excerpt-word-wrapper">
            {wd.chars.map((c) => (
              <span
                class={[
                  "excerpt-char",
                  wd.type === "glow" ? "char-glow" : "",
                  wd.type === "accent" ? "char-accent" : "",
                ].filter(Boolean).join(" ")}
                data-char-id={c.globalIdx}
              >
                {c.char}
              </span>
            ))}
            {/* Espacio invisible después de cada palabra, mantenido dentro del flujo */}
            <span class="excerpt-space" aria-hidden="true">&nbsp;</span>
          </span>
        ))
      }
      {/* Cursor parpadeante minimalista */}
      <span class="excerpt-cursor" id={`${id}-cursor`} aria-hidden="true">|</span>
    </p>
  </div>

  {/* Breathing room inferior */}
  <div class="h-[22vh] md:h-[30vh]" aria-hidden="true"></div>
</section>

<style>
  /* ── Tipografía estilizada estilo Antique Didone / Libre Bodoni ── */
  .excerpt-headline {
    font-family: 'Libre Bodoni', 'Antique Didone', Georgia, serif;
    font-size: clamp(1.15rem, 2.3vw, 1.7rem);
    font-weight: 500;
    color: rgba(212, 201, 188, 0.48); /* Blanco hueso / papiro apagado */
    letter-spacing: 0.02em;
    position: relative;
    /* Transición suave global de disolución */
    transition: opacity 2.8s ease-in-out, filter 2.8s ease-in-out, transform 2.8s ease-in-out;
  }

  /* Evita que las palabras se corten a la mitad (ej. pro-yecto) */
  .excerpt-word-wrapper {
    display: inline-block;
    white-space: nowrap;
  }

  /* ── Caracteres individuales: ocultos y borrosos al inicio ── */
  .excerpt-char {
    display: inline-block;
    opacity: 0;
    filter: blur(10px);
    transform: translateY(2px);
    will-change: opacity, filter, transform;
    transition: opacity 0.5s ease-out, filter 0.5s ease-out, transform 0.5s ease-out;
  }

  /* ── Estilos de segmentos ── */
  .char-glow {
    color: rgba(255, 255, 255, 0.95);
    font-weight: 700;
    text-shadow: 0 0 16px rgba(255, 255, 255, 0.15);
  }

  .char-accent {
    color: #c9a86c; /* Dorado TGP */
    font-weight: 700;
  }

  /* Espacio separable */
  .excerpt-space {
    display: inline-block;
  }

  /* ── Cursor parpadeante ── */
  .excerpt-cursor {
    display: inline-block;
    font-weight: 100;
    color: rgba(201, 168, 108, 0.85);
    margin-left: 2px;
    animation: cursor-blink-rest 0.75s step-end infinite;
    will-change: opacity;
    transition: opacity 0.6s ease;
  }

  @keyframes cursor-blink-rest {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ── EFECTO AGUA: disolución suave en el medio líquido al finalizar ── */
  .excerpt-headline.c-dissolve {
    opacity: 0 !important;
    filter: blur(12px) !important;
    transform: scale(0.97) translateY(-3px) !important;
    pointer-events: none;
  }

  /* Fallback sin JS */
  @media (prefers-reduced-motion: reduce) {
    .excerpt-char {
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
    }
    .excerpt-cursor {
      display: none;
    }
  }
</style>

<script>
  // Clase de control de partículas de polvo llevadas por el viento
  class DustMotesEffect {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private motes: Array<{
      x: number;
      y: number;
      radius: number;
      opacity: number;
      speedX: number;
      speedY: number;
      angle: number;
      angleSpeed: number;
    }> = [];
    private animationFrameId: number | null = null;
    private isRunning: boolean = false;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d')!;
      this.resize();
      window.addEventListener('resize', this.resize.bind(this));
    }

    private resize() {
      const rect = this.canvas.parentElement?.getBoundingClientRect();
      this.canvas.width = rect?.width ?? window.innerWidth;
      this.canvas.height = rect?.height ?? 220;
    }

    public start() {
      if (this.isRunning) return;
      this.isRunning = true;
      this.motes = [];
      const count = 18; // Cantidad sobria de motas

      for (let i = 0; i < count; i++) {
        this.motes.push({
          x: Math.random() * this.canvas.width,
          y: Math.random() * this.canvas.height,
          radius: 0.6 + Math.random() * 1.5,
          opacity: 0.05 + Math.random() * 0.18,
          speedX: 0.15 + Math.random() * 0.35, // viento soplando a la derecha
          speedY: (Math.random() - 0.5) * 0.1,
          angle: Math.random() * Math.PI * 2,
          angleSpeed: 0.005 + Math.random() * 0.01
        });
      }

      this.loop();
    }

    public stop() {
      this.isRunning = false;
      if (this.animationFrameId) {
        cancelAnimationFrame(this.animationFrameId);
        this.animationFrameId = null;
      }
    }

    private loop() {
      if (!this.isRunning) return;

      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

      this.motes.forEach(m => {
        // Movimiento llevado por el viento
        m.x += m.speedX;
        m.y += m.speedY + Math.sin(m.angle) * 0.08;
        m.angle += m.angleSpeed;

        // Si se sale por la derecha, vuelve por la izquierda
        if (m.x > this.canvas.width + 10) {
          m.x = -10;
          m.y = Math.random() * this.canvas.height;
        }

        // Dibujar mota de polvo brillante sutil
        this.ctx.beginPath();
        const grad = this.ctx.createRadialGradient(m.x, m.y, 0, m.x, m.y, m.radius * 2);
        grad.addColorStop(0, `rgba(239, 235, 227, ${m.opacity})`);
        grad.addColorStop(1, 'rgba(239, 235, 227, 0)');
        this.ctx.fillStyle = grad;
        this.ctx.arc(m.x, m.y, m.radius * 2, 0, Math.PI * 2);
        this.ctx.fill();
      });

      this.animationFrameId = requestAnimationFrame(this.loop.bind(this));
    }
  }

  const setupSingleExcerpt = (section: HTMLElement) => {
    if (section.dataset.cerInit === 'true') return;
    section.dataset.cerInit = 'true';

    const canvas = section.querySelector<HTMLCanvasElement>('.excerpt-dust-canvas')!;
    const headline = section.querySelector<HTMLElement>('.excerpt-headline')!;
    const cursor = section.querySelector<HTMLElement>('.excerpt-cursor')!;
    const chars = Array.from(section.querySelectorAll<HTMLElement>('.excerpt-char'));

    const dustEffect = new DustMotesEffect(canvas);

    // Escribir carácter por carácter con retraso dinámico
    const typeCharacters = () => {
      let idx = 0;
      const type = () => {
        if (idx >= chars.length) {
          // Finaliza escritura: apaga cursor
          if (cursor) cursor.style.opacity = '0';

          // Espera 4.5 segundos de reposo contemplativo
          setTimeout(() => {
            // Disolver en agua
            headline.classList.add('c-dissolve');
            // Apagar partículas lentamente al final de la disolución
            setTimeout(() => dustEffect.stop(), 2800);
          }, 4500);
          return;
        }

        const ch = chars[idx];
        ch.style.opacity = '1';
        ch.style.filter = 'blur(0px)';
        ch.style.transform = 'translateY(0)';
        idx++;

        // Velocidad de escritura: entre 38ms y 55ms por carácter
        setTimeout(type, 38 + Math.random() * 17);
      };

      type();
    };

    // IntersectionObserver para iniciar la presentación al aparecer en pantalla
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          observer.unobserve(section);
          dustEffect.start();
          typeCharacters();
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  };

  const initExcerpts = () => {
    document.querySelectorAll<HTMLElement>('.cinematic-excerpt-rest').forEach(setupSingleExcerpt);
  };

  document.addEventListener('astro:page-load', initExcerpts);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initExcerpts();
  } else {
    document.addEventListener('DOMContentLoaded', initExcerpts);
  }
</script>
