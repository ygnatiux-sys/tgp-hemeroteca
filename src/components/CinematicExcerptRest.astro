---
/**
 * CinematicExcerptRest
 *
 * Franja cinemática de respiro visual con tipografía Proza Libre en tamaño H1.
 * Aparición suave desde el fondo con fade, de-blur y escala cinemática moderna.
 * Hereda los gradientes y resplandor de Gloock (#E3DDD3 a transparent / oro TGP).
 *
 * Sintaxis del prop `text`:
 *   **palabra**   → blanco brillante titanium/gloock glow
 *   [[letra]]     → dorado TGP (acento)
 *   texto normal  → gradiente metálico Gloock (#E3DDD3 / papiro suave)
 */

interface Props {
  text?: string;
  id?: string;
}

const {
  text = "Un ecosistema documental en **constante expansión.** Cada [[dossier]], un nodo verificado.",
  id = "excerpt-" + Math.random().toString(36).substring(2, 9),
} = Astro.props;

// ─── Tokenizador por palabras con soporte multipalabra para ** y [[ ]] ───
const rawWords = text.trim().split(/\s+/);
let currentMode: 'normal' | 'glow' | 'accent' = 'normal';

const wordsData = rawWords.map((rawWord, wordIdx) => {
  let word = rawWord;
  let type: 'normal' | 'glow' | 'accent' = currentMode;

  if (word.startsWith('**')) {
    currentMode = 'glow';
    type = 'glow';
    word = word.slice(2);
  } else if (word.startsWith('[[')) {
    currentMode = 'accent';
    type = 'accent';
    word = word.slice(2);
  }

  let endsGlow = false;
  let endsAccent = false;

  if (word.endsWith('**')) {
    endsGlow = true;
    word = word.slice(0, -2);
  } else if (word.includes('**')) {
    word = word.replace(/\*\*/g, '');
    endsGlow = true;
  }

  if (word.endsWith(']]') || word.includes(']].') || word.includes(']],') || word.includes(']]:') || word.includes(']];')) {
    endsAccent = true;
    word = word.replace(/\]\]/g, '');
  } else if (word.includes(']]')) {
    word = word.replace(/\]\]/g, '');
    endsAccent = true;
  }

  const cleanWord = word.replace(/\[\[/g, '').replace(/\]\]/g, '').replace(/\*\*/g, '');

  if (endsGlow || endsAccent) {
    currentMode = 'normal';
  }

  return {
    word: cleanWord,
    type,
    index: wordIdx
  };
});
---

<!-- Import de fuente Gloock -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Gloock&display=swap');
</style>

<section
  id={id}
  class="cinematic-excerpt-rest relative w-full bg-(--bg-main) overflow-hidden select-none py-12 sm:py-16 md:py-20 flex flex-col justify-center items-center"
  style="background-color: var(--bg-main);"
  data-text={text}
>
  <!-- Lienzo de partículas de polvo en movimiento (viento) -->
  <canvas class="excerpt-dust-canvas absolute inset-0 z-0 pointer-events-none" id={`${id}-canvas`}></canvas>

  {/* Contenedor central de lectura con max-w-[66ch] en tamaño H2 */}
  <div class="excerpt-content relative z-10 max-w-[66ch] mx-auto px-4 sm:px-6 md:px-8 text-center">
    <h2 class="excerpt-headline glow-metallic-gloock" id={`${id}-headline`}>
      {
        wordsData.map((wd, idx) => (
          <span class="excerpt-word-wrapper">
            <span
              class:list={[
                "excerpt-word",
                wd.type === "glow" ? "word-glow" : "",
                wd.type === "accent" ? "word-accent" : "word-normal",
              ]}
              style={`transition-delay: ${idx * 72}ms;`}
            >
              {wd.word}
            </span>
            <span class="excerpt-space" aria-hidden="true">&nbsp;</span>
          </span>
        ))
      }
    </h2>
  </div>
</section>

<style>
  /* ── Tipografía Gloock BOLD / BLACK en escala Cine Premier ── */
  .excerpt-headline {
    font-family: 'Gloock', serif;
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 800;
    line-height: 1.22;
    letter-spacing: -0.02em;
    max-width: 34ch;
    margin-left: auto;
    margin-right: auto;
    text-wrap: balance;
    padding: 0;
  }

  /* Evita que palabras se dividan de forma antinatural */
  .excerpt-word-wrapper {
    display: inline-block;
    white-space: nowrap;
  }

  /* Espaciado natural entre palabras */
  .excerpt-space {
    display: inline-block;
  }

  /* ── Aparición Cinemática estilo Cine Premier (Fade + Scale Out 1.20->1.0 + De-blur óptico) ── */
  .excerpt-word {
    display: inline-block;
    opacity: 0;
    filter: blur(18px);
    transform: translateY(24px) scale(1.20);
    will-change: opacity, filter, transform;
    transition: 
      opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1),
      filter 1.4s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Estado activo cuando entra en pantalla */
  .cinematic-excerpt-rest.is-revealed .excerpt-word {
    opacity: 1;
    filter: blur(0px);
    transform: translateY(0) scale(1);
  }

  /* ── Degradados heredados del estilo Gloock ── */
  .word-normal {
    background-image: linear-gradient(to bottom, #EFEBE3 0%, #D8D2C2 50%, rgba(200, 192, 175, 0.7) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 800;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .word-glow {
    background-image: linear-gradient(to bottom, #FFFFFF 0%, #F5F0E6 50%, #E3DDD3 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 900;
    filter: drop-shadow(0 0 18px rgba(255, 255, 255, 0.42));
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .word-accent {
    background-image: linear-gradient(to bottom, #FFF3D1 0%, #E8CA82 45%, #C29B4F 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 900;
    filter: drop-shadow(0 0 18px rgba(234, 179, 8, 0.42));
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* Resplandor metálico sutil Gloock */
  .glow-metallic-gloock {
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 22px rgba(227, 221, 211, 0.2));
  }

  /* Accesibilidad / Reducción de movimiento */
  @media (prefers-reduced-motion: reduce) {
    .excerpt-word {
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  // Clase de control de partículas de polvo llevadas por el viento
  class DustMotesEffect {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private motes: Array<{
      x: number;
      y: number;
      radius: number;
      opacity: number;
      speedX: number;
      speedY: number;
      angle: number;
      angleSpeed: number;
    }> = [];
    private animationFrameId: number | null = null;
    private isRunning: boolean = false;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d')!;
      this.resize();
      window.addEventListener('resize', this.resize.bind(this));
    }

    private resize() {
      const rect = this.canvas.parentElement?.getBoundingClientRect();
      this.canvas.width = rect?.width ?? window.innerWidth;
      this.canvas.height = rect?.height ?? 220;
    }

    public start() {
      if (this.isRunning) return;
      this.isRunning = true;
      this.motes = [];
      const count = 18;

      for (let i = 0; i < count; i++) {
        this.motes.push({
          x: Math.random() * this.canvas.width,
          y: Math.random() * this.canvas.height,
          radius: 0.6 + Math.random() * 1.5,
          opacity: 0.05 + Math.random() * 0.18,
          speedX: 0.15 + Math.random() * 0.35,
          speedY: (Math.random() - 0.5) * 0.1,
          angle: Math.random() * Math.PI * 2,
          angleSpeed: 0.005 + Math.random() * 0.01
        });
      }

      this.loop();
    }

    public stop() {
      this.isRunning = false;
      if (this.animationFrameId) {
        cancelAnimationFrame(this.animationFrameId);
        this.animationFrameId = null;
      }
    }

    private loop() {
      if (!this.isRunning) return;

      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

      this.motes.forEach(m => {
        m.x += m.speedX;
        m.y += m.speedY + Math.sin(m.angle) * 0.08;
        m.angle += m.angleSpeed;

        if (m.x > this.canvas.width + 10) {
          m.x = -10;
          m.y = Math.random() * this.canvas.height;
        }

        this.ctx.beginPath();
        const grad = this.ctx.createRadialGradient(m.x, m.y, 0, m.x, m.y, m.radius * 2);
        grad.addColorStop(0, `rgba(239, 235, 227, ${m.opacity})`);
        grad.addColorStop(1, 'rgba(239, 235, 227, 0)');
        this.ctx.fillStyle = grad;
        this.ctx.arc(m.x, m.y, m.radius * 2, 0, Math.PI * 2);
        this.ctx.fill();
      });

      this.animationFrameId = requestAnimationFrame(this.loop.bind(this));
    }
  }

  const setupSingleExcerpt = (section: HTMLElement) => {
    if (section.dataset.cerInit === 'true') return;
    section.dataset.cerInit = 'true';

    const canvas = section.querySelector<HTMLCanvasElement>('.excerpt-dust-canvas');
    let dustEffect: DustMotesEffect | null = null;
    if (canvas) {
      dustEffect = new DustMotesEffect(canvas);
    }

    // IntersectionObserver para activar la aparición cinemática (fade + de-blur)
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          observer.unobserve(section);
          if (dustEffect) dustEffect.start();
          section.classList.add('is-revealed');
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  };

  const initExcerpts = () => {
    document.querySelectorAll<HTMLElement>('.cinematic-excerpt-rest').forEach(setupSingleExcerpt);
  };

  document.addEventListener('astro:page-load', initExcerpts);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initExcerpts();
  } else {
    document.addEventListener('DOMContentLoaded', initExcerpts);
  }
</script>
